+func TestPiDiscardRefusesLegacyWireCollisionInEitherGoal(t *testing.T) {
+	s, prepared, receipt, _ := newPiDiscardFixture(t)
+	ctx := context.Background()
+	s.uploadStore.MinFreeBytes = 0
+	otherDraft, err := s.uploadStore.NewDraft(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	other := &uploads.Backend{Store: s.uploadStore, ScopeID: otherDraft.ID}
+	data := []byte("fixture input")
+	file, err := other.Create(ctx, conversation.UploadRequest{ClientID: preparationTestID(802), Name: "input.txt", Size: int64(len(data))})
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256(data)
+	if _, err = other.Append(ctx, file.ID, 0, hex.EncodeToString(digest[:]), bytes.NewReader(data)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = other.Complete(ctx, file.ID); err != nil {
+		t.Fatal(err)
+	}
+	// This is an actual persisted legacy initial submission, owned by a
+	// different draft/attempt. The stock wire starts with the attachment
+	// header when the other request contains only files.
+	wire, err := s.prepareCreationAttachments(ctx, "legacy-owner", otherDraft.ID, "", []string{file.ID})
+	if err != nil || !strings.HasPrefix(wire, "Attached local files") {
+		t.Fatal("could not prepare the legacy attachment wire", err)
+	}
+	catalogPath := filepath.Join(s.uploadStore.Directory, "catalog.json")
+	before, err := os.ReadFile(catalogPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	requestMatch, effectiveMatch := receipt, receipt
+	requestMatch.Request.Goal, effectiveMatch.Goal = wire, wire
+	if piDiscardHasNoAttachmentClaim(prepared, requestMatch) || piDiscardHasNoAttachmentClaim(prepared, effectiveMatch) {
+		t.Fatal("ambiguous wire did not refuse one of the collector's goal selectors")
+	}
+	// A positive header is refused even if it is only quoted plain text.
+	effectiveMatch.Goal = "Quote the label Attached local files in documentation."
+	if piDiscardHasNoAttachmentClaim(prepared, effectiveMatch) {
+		t.Fatal("ambiguous plain text was allowed")
+	}
+	withAttachments := prepared
+	snapshot := *prepared.Snapshot
+	snapshot.Input.Attachments = []string{file.ID}
+	withAttachments.Snapshot = &snapshot
+	if piDiscardHasNoAttachmentClaim(withAttachments, receipt) {
+		t.Fatal("nonempty attachment selection was allowed")
+	}
+	after, err := os.ReadFile(catalogPath)
+	if err != nil || !bytes.Equal(before, after) {
+		t.Fatal("the attachment check changed the catalog", err)
+	}
+}
