+	PiDiscardMarkerSuffix = ".pi-discard.json"
+	PiDiscardMarkerLimit  = 4096
+)
+
+var ErrPiDiscardPending = errors.New("a Pi request discard is pending")
+
+var piDiscardRequestID = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`)
+
+// PiDiscardMarker is the bridge-only live fence. The private audit holds the
+// original records and the intended terminal mapping, not this inventory.
+type PiDiscardMarker struct {
+	Schema             int    `json:"schema"`
+	WorkspaceSHA256    string `json:"workspace_sha256"`
+	Slug               string `json:"slug"`
+	RequestID          string `json:"request_id"`
+	ReceiptID          string `json:"receipt_id"`
+	PreparationAttempt int    `json:"preparation_attempt"`
+	CreationAttempt    int    `json:"creation_attempt"`
+	AuditSHA256        string `json:"audit_sha256"`
+}
+
+func (m PiDiscardMarker) Validate(workspace, slug string) error {
+	sum := sha256.Sum256([]byte(workspace))
+	if m.Schema != 1 || !backendCanonicalPath(workspace) || !ValidSlug(slug) || m.Slug != slug ||
+		m.WorkspaceSHA256 != hex.EncodeToString(sum[:]) || !piDiscardRequestID.MatchString(m.RequestID) ||
+		!isLowerHex(m.ReceiptID, 64) || !isLowerHex(m.AuditSHA256, 64) ||
+		m.PreparationAttempt < 1 || m.CreationAttempt < 1 {
+		return errors.New("invalid Pi discard marker identity")
+	}
+	return nil
+}
+
+func inspectPiDiscardDirectory(path string) (os.FileInfo, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || !info.IsDir() || stat.Uid != uint32(os.Geteuid()) || info.Mode().Perm()&0o022 != 0 {
+		return nil, errors.New("cannot trust Pi discard marker directory")
+	}
+	return info, nil
+}
+
+// Loose read-only stock lock directories may still be scanned. A marker is
+// admitted for recovery only in its private mode-0700 directory.
+func piDiscardLockDirectory(workspace string) (string, error) {
+	if !backendCanonicalPath(workspace) {
+		return "", errors.New("invalid Pi discard workspace")
+	}
+	root := filepath.Join(workspace, "worktrees")
+	if _, err := inspectPiDiscardDirectory(root); err != nil {
+		return "", err
+	}
+	directory := filepath.Join(root, ".locks")
+	if _, err := inspectPiDiscardDirectory(directory); err != nil {
+		return "", err
+	}
+	return directory, nil
+}
+
+// RequireNoPiDiscard is used under existing admission, after any lock waits.
+// Any kind of marker at the selected name fences effects, even if malformed.
+func RequireNoPiDiscard(workspace, slug string) error {
+	if !ValidSlug(slug) {
+		return errors.New("invalid Pi discard slug")
+	}
+	directory, err := piDiscardLockDirectory(workspace)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	_, err = os.Lstat(filepath.Join(directory, slug+PiDiscardMarkerSuffix))
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	return ErrPiDiscardPending
+}
+
+// ReadPiDiscardMarkers is an early reader for the selected bridge only. An
+// invalid or unassignable marker must never turn into an empty inventory.
+func ReadPiDiscardMarkers(workspace string) (map[string]PiDiscardMarker, error) {
+	markers := make(map[string]PiDiscardMarker)
+	directory, err := piDiscardLockDirectory(workspace)
+	if errors.Is(err, os.ErrNotExist) {
+		return markers, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	fd, err := unix.Open(directory, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), directory)
+	defer file.Close()
+	count := 0
+	for {
+		names, err := file.Readdirnames(128)
+		if err != nil && !errors.Is(err, io.EOF) {
+			return nil, err
+		}
+		count += len(names)
+		if count > 65536 {
+			return nil, errors.New("Pi discard marker inventory exceeds limit")
+		}
+		for _, name := range names {
+			slug, ok := strings.CutSuffix(name, PiDiscardMarkerSuffix)
+			if !ok {
+				continue
+			}
+			// The bridge supports one unfinished discard; an additional
+			// marker needs operator review, not a second pending owner.
+			if !ValidSlug(slug) || len(markers) != 0 {
+				return nil, errors.New("invalid Pi discard marker inventory")
+			}
+			data, err := readBackendRecord(directory, name)
+			if err != nil {
+				return nil, err
+			}
+			var marker PiDiscardMarker
+			if len(data) > PiDiscardMarkerLimit {
+				return nil, errors.New("Pi discard marker exceeds limit")
+			}
+			if err = decodeBackendRecord(data, &marker, []string{"schema", "workspace_sha256", "slug", "request_id", "receipt_id", "preparation_attempt", "creation_attempt", "audit_sha256"}); err != nil {
+				return nil, err
+			}
+			if err = marker.Validate(workspace, slug); err != nil {
+				return nil, err
+			}
+			markers[slug] = marker
+		}
+		if errors.Is(err, io.EOF) {
+			return markers, nil
+		}
+	}
+}
