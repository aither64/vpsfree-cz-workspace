diff --git a/portal/internal/web/pi_discard_startup_grant.go b/portal/internal/web/pi_discard_startup_grant.go
new file mode 100644
index 0000000000000000000000000000000000000000..c267b2ea9cd5a4756d5c4181fa9aac2b23972df0
--- /dev/null
+++ b/portal/internal/web/pi_discard_startup_grant.go
@@ -0,0 +1,271 @@
+package web
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"os/user"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/aither64/dev-workspace/portal/internal/session"
+	"golang.org/x/sys/unix"
+)
+
+const piDiscardStartupGrantPath = "/var/lib/dev-workspace-pi-discard/startup-grant.json"
+const piDiscardStartupGrantLimit = 8192
+
+// ErrPiDiscardStartupHeld stops this invocation from opening the portal or
+// attempting the same startup mutation again via Restart=on-failure.
+var ErrPiDiscardStartupHeld = errors.New("The portal could not confirm the authorized startup discard.")
+
+var piDiscardStorePath = regexp.MustCompile(`^/nix/store/[0-9abcdfghijklmnpqrsvwxyz]{32}-[A-Za-z0-9+._?=-]+$`)
+var piDiscardStartupName = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_-]*$`)
+
+// PiDiscardStartupAuthority is the read-only proof subset sent to the host
+// verifier. The strict codec requires an exported embedded wire structure.
+type PiDiscardStartupAuthority struct {
+	System        string `json:"system"`
+	Package       string `json:"package"`
+	ProfileToken  string `json:"profileToken"`
+	WorkspaceName string `json:"workspaceName"`
+	WorkspaceRoot string `json:"workspaceRoot"`
+	Service       string `json:"service"`
+	Owner         struct {
+		ID   string `json:"id"`
+		Slug string `json:"slug"`
+	} `json:"owner"`
+	Claim struct {
+		ID         string `json:"id"`
+		Repository string `json:"repository"`
+		Selector   string `json:"selector"`
+		Adapter    string `json:"adapter"`
+	} `json:"claim"`
+}
+
+type piDiscardStartupGrant struct {
+	Schema int `json:"schema"`
+	PiDiscardStartupAuthority
+	Target piDiscardStartupTarget `json:"target"`
+}
+
+type piDiscardStartupTarget struct {
+	RequestID          string `json:"requestId"`
+	ReceiptID          string `json:"receiptId"`
+	PreparationAttempt int    `json:"preparationAttempt"`
+	CreationAttempt    int    `json:"creationAttempt"`
+	Slug               string `json:"slug"`
+	Incarnation        string `json:"incarnation"`
+	Epoch              string `json:"epoch"`
+}
+
+func parsePiDiscardStartupGrant(data []byte) (*piDiscardStartupGrant, error) {
+	var grant piDiscardStartupGrant
+	if session.DecodePiCreationJSON(data, &grant, piDiscardStartupGrantLimit) != nil || grant.Schema != 1 ||
+		!piDiscardStorePath.MatchString(grant.System) || !piDiscardStorePath.MatchString(grant.Package) ||
+		!strings.HasPrefix(grant.ProfileToken, "pi-profile-v1:") || !messageDigestPattern.MatchString(strings.TrimPrefix(grant.ProfileToken, "pi-profile-v1:")) ||
+		!piDiscardStartupName.MatchString(grant.WorkspaceName) || !filepath.IsAbs(grant.WorkspaceRoot) || filepath.Clean(grant.WorkspaceRoot) != grant.WorkspaceRoot ||
+		strings.ContainsAny(grant.WorkspaceRoot, "\x00\uFFFD") ||
+		grant.Service != "workspace-portal@"+grant.WorkspaceName+".service" || !validPreparationID(grant.Owner.ID) || !session.ValidSlug(grant.Owner.Slug) ||
+		!validPreparationID(grant.Claim.ID) || !piDiscardStartupName.MatchString(grant.Claim.Repository) ||
+		!validCreationRequestText(grant.Claim.Selector, piDiscardStartupGrantLimit) || strings.ContainsRune(grant.Claim.Selector, '\uFFFD') || !piDiscardStartupName.MatchString(grant.Claim.Adapter) ||
+		!grant.Target.intent().valid(grant.Target.RequestID) || !session.ValidSlug(grant.Target.Slug) ||
+		!messageDigestPattern.MatchString(grant.Target.Incarnation) || !messageDigestPattern.MatchString(grant.Target.Epoch) {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	return &grant, nil
+}
+
+// The fixed grant is visible to every managed portal. Only proven separation
+// of both workspace selectors makes it inert; a partial match or alias is an
+// ambiguous target, not permission to start outside grant admission.
+func (g *piDiscardStartupGrant) targetsWorkspace(name, root string) (bool, error) {
+	if g == nil {
+		return false, nil
+	}
+	checkRoot := func(path string) (os.FileInfo, error) {
+		resolved, err := filepath.EvalSymlinks(path)
+		if err != nil || !filepath.IsAbs(path) || resolved != path {
+			return nil, ErrPiDiscardStartupHeld
+		}
+		info, err := os.Stat(path)
+		if err != nil || !info.IsDir() {
+			return nil, ErrPiDiscardStartupHeld
+		}
+		return info, nil
+	}
+	if !piDiscardStartupName.MatchString(name) {
+		return false, ErrPiDiscardStartupHeld
+	}
+	portalRoot, err := checkRoot(root)
+	if err != nil {
+		return false, err
+	}
+	grantRoot, err := checkRoot(g.WorkspaceRoot)
+	if err != nil {
+		return false, err
+	}
+	sameRoot := root == g.WorkspaceRoot
+	if (name == g.WorkspaceName) != sameRoot || os.SameFile(portalRoot, grantRoot) != sameRoot {
+		return false, ErrPiDiscardStartupHeld
+	}
+	return sameRoot, nil
+}
+
+func readPiDiscardStartupGrant() (*piDiscardStartupGrant, error) {
+	return readPiDiscardStartupGrantAt(filepath.Dir(piDiscardStartupGrantPath), filepath.Base(piDiscardStartupGrantPath))
+}
+
+// Root owns every directory. Descriptor-relative no-follow opens avoid
+// treating symlinks, inaccessible ancestors or malformed records as absence.
+func readPiDiscardStartupGrantAt(base, name string) (*piDiscardStartupGrant, error) {
+	if !filepath.IsAbs(base) || filepath.Clean(base) != base || filepath.Base(name) != name {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	flags := unix.O_RDONLY | unix.O_DIRECTORY | unix.O_NOFOLLOW | unix.O_CLOEXEC
+	fd, err := unix.Open("/", flags, 0)
+	if err != nil {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	defer func() { unix.Close(fd) }()
+	var stat unix.Stat_t
+	if unix.Fstat(fd, &stat) != nil || stat.Uid != 0 || stat.Mode&0022 != 0 {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	for _, component := range strings.Split(strings.TrimPrefix(base, "/"), "/") {
+		next, err := unix.Openat(fd, component, flags, 0)
+		if errors.Is(err, unix.ENOENT) {
+			return nil, nil
+		}
+		if err != nil {
+			return nil, ErrPiDiscardStartupHeld
+		}
+		unix.Close(fd)
+		fd = next
+		if unix.Fstat(fd, &stat) != nil || stat.Uid != 0 || stat.Mode&0022 != 0 {
+			return nil, ErrPiDiscardStartupHeld
+		}
+	}
+	if stat.Mode&07777 != 0750 {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	group, err := user.LookupGroup("workspace-portal-owner")
+	if err != nil {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	gid, err := strconv.ParseUint(group.Gid, 10, 32)
+	if err != nil || uint32(gid) != stat.Gid {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	return readPiDiscardStartupGrantFile(fd, name, 0, stat.Gid)
+}
+
+func readPiDiscardStartupGrantFile(fd int, name string, uid, gid uint32) (*piDiscardStartupGrant, error) {
+	grantFD, err := unix.Openat(fd, name, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_NONBLOCK|unix.O_CLOEXEC, 0)
+	if errors.Is(err, unix.ENOENT) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	file := os.NewFile(uintptr(grantFD), name)
+	defer file.Close()
+	var grantStat unix.Stat_t
+	if unix.Fstat(grantFD, &grantStat) != nil || grantStat.Mode != unix.S_IFREG|0440 || grantStat.Uid != uid ||
+		grantStat.Gid != gid || grantStat.Nlink != 1 || grantStat.Size < 1 || grantStat.Size > piDiscardStartupGrantLimit {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	data, err := io.ReadAll(io.LimitReader(file, piDiscardStartupGrantLimit+1))
+	if err != nil {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	return parsePiDiscardStartupGrant(data)
+}
+
+func (t piDiscardStartupTarget) intent() piDiscardIntent {
+	return piDiscardIntent{t.RequestID, t.ReceiptID, t.PreparationAttempt, t.CreationAttempt}
+}
+
+type piDiscardStartup struct {
+	target piDiscardStartupTarget
+	verify func(context.Context) error
+}
+
+func (startup *piDiscardStartup) authorized(ctx context.Context) bool {
+	return startup.verify(ctx) == nil
+}
+
+func (startup *piDiscardStartup) matches(audit piDiscardAudit) bool {
+	return startup.target.intent() == audit.Owner && startup.target.Slug == audit.Terminal.Slug &&
+		startup.target.Epoch == audit.Terminal.Epoch && startup.target.Incarnation == audit.Incarnation
+}
+
+func (s *Server) loadPiDiscardStartupReceipt(record sessionPreparation, target piDiscardStartupTarget) error {
+	data, err := readPiDiscardBytes(s.creationPath(record.Slug), maxCreationReceiptBytes, false)
+	var raw map[string]json.RawMessage
+	var receipt creationReceipt
+	if err != nil || rejectDuplicateCreationJSONKeys(data) != nil || json.Unmarshal(data, &raw) != nil ||
+		validateCreationReceiptShape(raw) != nil || json.Unmarshal(data, &receipt) != nil || receipt.Schema != 4 ||
+		receipt.State != "failed" || receipt.ReceiptID != target.ReceiptID || receipt.Attempt != target.CreationAttempt ||
+		receipt.Pi == nil || receipt.Pi.SessionIncarnation != target.Incarnation || !preparationReceiptMatches(record, receipt) {
+		return ErrPiDiscardStartupHeld
+	}
+	s.creations = map[string]creationReceipt{record.Slug: receipt}
+	return nil
+}
+
+// Called at most once by the serving constructor, before the ordinary
+// creation loader, upload retention, reconciliation or publication of HTTP.
+func (s *Server) runPiDiscardStartupGrant(ctx context.Context, grant *piDiscardStartupGrant, verify func(context.Context, PiDiscardStartupAuthority) error) error {
+	if grant == nil {
+		return nil
+	}
+	if verify == nil || grant.Package != s.config.PackageRoot || grant.ProfileToken != piProfileToken(s.hostProfile) ||
+		grant.WorkspaceName != s.config.WorkspaceName || grant.WorkspaceRoot != s.config.Workspace {
+		return ErrPiDiscardStartupHeld
+	}
+	ctx, cancel := context.WithTimeout(ctx, 75*time.Second)
+	defer cancel()
+	_, unlock, err := s.acquireTransitionContext(ctx, unix.LOCK_SH)
+	if err != nil {
+		return ErrPiDiscardStartupHeld
+	}
+	defer unlock()
+	_, err = s.executePiDiscard(ctx, piDiscardStartup{target: grant.Target, verify: func(ctx context.Context) error {
+		return verify(ctx, grant.PiDiscardStartupAuthority)
+	}})
+	if err != nil {
+		return ErrPiDiscardStartupHeld
+	}
+	return nil
+}
+
+func (s *Server) verifyPiDiscardStartupAuthority(ctx context.Context, authority PiDiscardStartupAuthority) error {
+	input, err := json.Marshal(authority)
+	if err != nil || len(input) > piDiscardStartupGrantLimit {
+		return ErrPiDiscardStartupHeld
+	}
+	command := exec.CommandContext(ctx, filepath.Join(s.config.PackageRoot, "bin/workspace-host"), "_verify-pi-discard-startup")
+	command.Stdin = bytes.NewReader(input)
+	// Use the existing registered host configuration and wrapper defaults.
+	// Keep caller-only claims, shell injection flags, and private payloads out
+	// of arguments, environment and diagnostics.
+	for _, key := range []string{"HOME", "PATH", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "DEV_WORKSPACES_CONFIG", "DEV_WORKSPACES_RUNTIME_DIR", "DEV_WORKSPACES_SYSTEM_CODEX"} {
+		if value, present := os.LookupEnv(key); present {
+			command.Env = append(command.Env, key+"="+value)
+		}
+	}
+	command.Env = append(command.Env, "DEV_WORKSPACES_STATE="+s.config.UserStateRoot, "DEV_WORKSPACES_PROFILE="+s.config.HostProfile)
+	output, err := command.Output()
+	if err != nil || string(output) != "{\"verified\":true}\n" {
+		return ErrPiDiscardStartupHeld
+	}
+	return nil
+}
