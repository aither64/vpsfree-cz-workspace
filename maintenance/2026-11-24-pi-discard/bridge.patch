+func TestPiDiscardStartupRefusesWrongOwnerBeforeEffects(t *testing.T) {
+	for _, reason := range []string{"generation", "workspace", "epoch", "incarnation", "attempt", "claim"} {
+		t.Run(reason, func(t *testing.T) {
+			s, preparation, receipt, native := newPiDiscardFixture(t)
+			grant := fixturePiDiscardStartupGrant(s, preparation, receipt)
+			calls := 0
+			switch reason {
+			case "generation":
+				grant.ProfileToken = "pi-profile-v1:" + strings.Repeat("0", 64)
+			case "workspace":
+				grant.WorkspaceRoot += "-other"
+			case "epoch":
+				grant.Target.Epoch = strings.Repeat("0", 64)
+			case "incarnation":
+				grant.Target.Incarnation = strings.Repeat("0", 64)
+			case "attempt":
+				grant.Target.CreationAttempt++
+			}
+			boot, err := openPiDiscardStartupFixture(t, s, &grant, nil, func(context.Context, PiDiscardStartupAuthority) error {
+				calls++
+				if reason == "claim" {
+					return errors.New("fixture foreign or released claim")
+				}
+				return nil
+			})
+			if boot != nil || !errors.Is(err, ErrPiDiscardStartupHeld) || native.ensures != 0 || native.creates != 0 || native.sends != 0 {
+				t.Fatal("foreign grant reached serving or effects", err)
+			}
+			if (reason == "claim" && calls != 1) || (reason == "generation" && calls != 0) {
+				t.Fatal("wrong claim-verification boundary", calls)
+			}
+			if err := requirePiDiscardAbsent(s.piDiscardDirectory(preparation.RequestID)); err != nil {
+				t.Fatal("refusal staged an audit", err)
+			}
+		})
+	}
+}
