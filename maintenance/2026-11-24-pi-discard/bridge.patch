+// Supply the synthetic grant and authority verifier only to the unexported
+// constructor seam. Production always reads the fixed root-owned input and
+// executes the private verifier from its selected immutable package.
+func openPiDiscardStartupFixture(t *testing.T, old *Server, grant *piDiscardStartupGrant, checkpoint func(string) error, verify func(context.Context, PiDiscardStartupAuthority) error) (*Server, error) {
+	t.Helper()
+	config := old.config
+	config.PackageRoot = ""
+	old.Close()
+	return newContext(context.Background(), config, func(s *Server, ctx context.Context) error {
+		if s.creations != nil || s.uploadStore != nil || s.conversation != nil {
+			t.Fatal("ordinary rehydration or serving started before the grant")
+		}
+		if grant != nil {
+			if _, pending := s.piDiscards[grant.Target.RequestID]; !pending {
+				if _, exists := s.preparations[grant.Target.RequestID]; !exists {
+					t.Fatal("grant ran before the read-only preparation cache load")
+				}
+			}
+			packageRoot, workspaceName := s.config.PackageRoot, s.config.WorkspaceName
+			s.config.PackageRoot, s.config.WorkspaceName = grant.Package, "fixture"
+			defer func() { s.config.PackageRoot, s.config.WorkspaceName = packageRoot, workspaceName }()
+		}
+		s.piCreationCheckpoint = checkpoint
+		return s.runPiDiscardStartupGrant(ctx, grant, func(ctx context.Context, authority PiDiscardStartupAuthority) error {
+			if grant == nil || authority != grant.PiDiscardStartupAuthority {
+				t.Fatal("wrong exact authority reached verifier")
+			}
+			if lock, err := session.LockCreation(s.config.AuthorityDir, grant.Target.Slug); err == nil {
+				lock.Close()
+				t.Fatal("writer did not retain the destination exclusion until revalidation")
+			}
+			return verify(ctx, authority)
+		})
+	})
+}
