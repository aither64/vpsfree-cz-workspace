+package session
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPiDiscardMarkerFencesWithoutAnyOtherSessionFiles(t *testing.T) {
+	workspace := t.TempDir()
+	slug := "pending-discard"
+	if err := RequireNoPiDiscard(workspace, slug); err != nil {
+		t.Fatal(err)
+	}
+	dir := filepath.Join(workspace, "worktrees", ".locks")
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256([]byte(workspace))
+	marker := PiDiscardMarker{
+		Schema: 1, WorkspaceSHA256: hex.EncodeToString(digest[:]), Slug: slug,
+		RequestID: "6a9711c1-ff69-400b-8c70-4bcd95fabea4", ReceiptID: strings.Repeat("a", 64),
+		PreparationAttempt: 1, CreationAttempt: 2, AuditSHA256: strings.Repeat("b", 64),
+	}
+	data, err := json.Marshal(marker)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, slug+PiDiscardMarkerSuffix)
+	if err = os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err = RequireNoPiDiscard(workspace, slug); !errors.Is(err, ErrPiDiscardPending) {
+		t.Fatal("sole marker failed to fence the target", err)
+	}
+	if err = RequireNoPiDiscard(workspace, "unrelated"); err != nil {
+		t.Fatal("unrelated target was blocked", err)
+	}
+	markers, err := ReadPiDiscardMarkers(workspace)
+	if err != nil || len(markers) != 1 || markers[slug] != marker {
+		t.Fatal("restart did not recover exact marker", err)
+	}
+	for _, tc := range []struct {
+		name string
+		data []byte
+	}{
+		{"duplicate", append([]byte(`{"schema":1,`), data[1:]...)},
+		{"foreign-workspace", []byte(strings.Replace(string(data), marker.WorkspaceSHA256, strings.Repeat("c", 64), 1))},
+		{"oversize", append(append([]byte(nil), data...), make([]byte, PiDiscardMarkerLimit)...)},
+		{"wrong-attempt", []byte(strings.Replace(string(data), `"creation_attempt":2`, `"creation_attempt":0`, 1))},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := os.WriteFile(path, tc.data, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := ReadPiDiscardMarkers(workspace); err == nil {
+				t.Fatal("invalid marker was admitted to recovery")
+			}
+			if err := RequireNoPiDiscard(workspace, slug); !errors.Is(err, ErrPiDiscardPending) {
+				t.Fatal("invalid marker did not fence the target", err)
+			}
+		})
+	}
+	if err = os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Symlink(filepath.Join(dir, "missing"), path); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = ReadPiDiscardMarkers(workspace); err == nil {
+		t.Fatal("symlink marker was accepted")
+	}
+	if err = RequireNoPiDiscard(workspace, slug); !errors.Is(err, ErrPiDiscardPending) {
+		t.Fatal("dangling marker did not fence the target", err)
+	}
+}
