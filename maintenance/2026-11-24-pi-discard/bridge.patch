+func TestPiDiscardStartupGrantDoesNotHoldAnUnrelatedPortal(t *testing.T) {
+	s, preparation, receipt, native := newPiDiscardFixture(t)
+	grant := fixturePiDiscardStartupGrant(s, preparation, receipt)
+	grant.WorkspaceRoot = t.TempDir()
+	config := s.config
+	config.WorkspaceName = "other-workspace"
+	config.CodexSocket = filepath.Join(t.TempDir(), "app-server.sock")
+	config.RegistrationMarker = filepath.Join(filepath.Dir(config.CodexSocket), "registration.json")
+	metadataDir := filepath.Join(config.PackageRoot, "share/dev-workspace")
+	if err := os.MkdirAll(metadataDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	metadata := `{"schema":1,"activationEnvironmentAliases":[],"routerSocket":"/fixture/router.sock","userNamespace":"fixture","agent_teams":{"managed":false}}`
+	if err := os.WriteFile(filepath.Join(metadataDir, "package.json"), []byte(metadata), 0600); err != nil {
+		t.Fatal(err)
+	}
+	parse := func(candidate piDiscardStartupGrant) *piDiscardStartupGrant {
+		t.Helper()
+		data, err := json.Marshal(candidate)
+		if err != nil {
+			t.Fatal(err)
+		}
+		checked, err := parsePiDiscardStartupGrant(data)
+		if err != nil {
+			t.Fatal("fixture grant is not structurally valid", err)
+		}
+		return checked
+	}
+	s.Close()
+	before, err := os.ReadFile(s.creationPath(preparation.Slug))
+	if err != nil {
+		t.Fatal(err)
+	}
+	boot, err := newContextWithPiDiscardStartupGrant(context.Background(), config, parse(grant))
+	if err != nil {
+		t.Fatal("grant for a positively different name and root blocked ordinary startup", err)
+	}
+	if boot.uploadStore == nil || boot.conversation == nil {
+		boot.Close()
+		t.Fatal("non-target did not finish normal startup")
+	}
+	boot.Close()
+
+	alias := filepath.Join(t.TempDir(), "workspace-alias")
+	if err := os.Symlink(config.Workspace, alias); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name, workspaceName, workspaceRoot, service string
+	}{
+		{"matching-name-only", config.WorkspaceName, grant.WorkspaceRoot, "workspace-portal@other-workspace.service"},
+		{"matching-root-only", grant.WorkspaceName, config.Workspace, grant.Service},
+		{"root-alias", grant.WorkspaceName, alias, grant.Service},
+		{"matching-target-wrong-generation", config.WorkspaceName, config.Workspace, "workspace-portal@other-workspace.service"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			candidate := grant
+			candidate.WorkspaceName, candidate.WorkspaceRoot, candidate.Service = tc.workspaceName, tc.workspaceRoot, tc.service
+			server, err := newContextWithPiDiscardStartupGrant(context.Background(), config, parse(candidate))
+			if server != nil {
+				server.Close()
+			}
+			if server != nil || !errors.Is(err, ErrPiDiscardStartupHeld) {
+				t.Fatal("ambiguous or superseded scope admitted", err)
+			}
+		})
+	}
+	after, err := os.ReadFile(s.creationPath(preparation.Slug))
+	if err != nil || !bytes.Equal(before, after) || native.ensures != 0 || native.creates != 0 || native.sends != 0 {
+		t.Fatal("non-target or refused startup changed the original request", err)
+	}
+	if err := requirePiDiscardAbsent(s.piDiscardDirectory(preparation.RequestID)); err != nil {
+		t.Fatal("non-target or refused startup staged an audit", err)
+	}
+	if err := session.RequireNoPiDiscard(s.config.Workspace, preparation.Slug); err != nil {
+		t.Fatal("non-target or refused startup published intent", err)
+	}
+}
