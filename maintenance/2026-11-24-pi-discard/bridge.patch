+	grant.Claim.ID, grant.Claim.Repository, grant.Claim.Selector, grant.Claim.Adapter = preparationTestID(878), "config", "test/machine", "confctl"
+	return grant
+}
+
+func TestPiDiscardStartupGrantStrictWire(t *testing.T) {
+	s, preparation, receipt, _ := newPiDiscardFixture(t)
+	grant := fixturePiDiscardStartupGrant(s, preparation, receipt)
+	data, err := json.Marshal(grant)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := parsePiDiscardStartupGrant(data)
+	if err != nil || *parsed != grant {
+		t.Fatal("shared root publisher envelope did not round-trip", err)
+	}
+	for _, input := range [][]byte{
+		append([]byte(`{"schema":1,`), data[1:]...),
+		bytes.Replace(data, []byte(`"workspaceRoot"`), []byte(`"workspaceroot"`), 1),
+		bytes.Replace(data, []byte(`"preparationAttempt":1`), []byte(`"preparationAttempt":null`), 1),
+		bytes.Replace(data, []byte(`"creationAttempt":2`), []byte(`"creationAttempt":"2"`), 1),
+		bytes.Replace(data, []byte(`"selector":"test/machine"`), []byte(`"selector":"test/\ud800"`), 1),
+		bytes.Replace(data, []byte(`"schema":1,`), nil, 1),
+		append(append([]byte(nil), data...), '{', '}'),
+		append(append([]byte(nil), data...), bytes.Repeat([]byte{' '}, piDiscardStartupGrantLimit)...),
+	} {
+		if _, err := parsePiDiscardStartupGrant(input); !errors.Is(err, ErrPiDiscardStartupHeld) {
+			t.Fatal("invalid root grant accepted", err)
+		}
+	}
+	// Nothing under the disposable user-writable temp tree can be trusted
+	// as root authority, irrespective of valid bytes or final file mode.
+	leaf := t.TempDir()
+	if err := os.Chmod(leaf, 0750); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(leaf, "startup-grant.json"), data, 0440); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := readPiDiscardStartupGrantAt(leaf, "startup-grant.json"); !errors.Is(err, ErrPiDiscardStartupHeld) {
+		t.Fatal("a writable ancestor conferred grant authority", err)
+	}
+	// Exercise sealed leaf validation against a private disposable directory.
+	// Site-shaped guest tests must prove the complete UID 0 ancestry + GID.
+	fd, err := unix.Open(leaf, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(fd)
+	var parent unix.Stat_t
+	if err := unix.Fstat(fd, &parent); err != nil {
+		t.Fatal(err)
+	}
+	read := func(name string) (*piDiscardStartupGrant, error) {
+		return readPiDiscardStartupGrantFile(fd, name, uint32(os.Geteuid()), parent.Gid)
+	}
+	if parsed, err := read("startup-grant.json"); err != nil || *parsed != grant {
+		t.Fatal("sealed fixture file did not validate", err)
+	}
+	if got, err := read("missing"); got != nil || err != nil {
+		t.Fatal("genuine absence is not no grant", err)
+	}
+	if err := os.Symlink("missing", filepath.Join(leaf, "link")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := read("link"); !errors.Is(err, ErrPiDiscardStartupHeld) {
+		t.Fatal("dangling symlink masqueraded as absence", err)
+	}
+	if err := os.Link(filepath.Join(leaf, "startup-grant.json"), filepath.Join(leaf, "alias")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := read("startup-grant.json"); !errors.Is(err, ErrPiDiscardStartupHeld) {
+		t.Fatal("multi-link grant accepted", err)
+	}
+}
