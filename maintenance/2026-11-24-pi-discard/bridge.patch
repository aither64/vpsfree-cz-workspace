diff --git a/portal/internal/web/pi_creation_discard.go b/portal/internal/web/pi_creation_discard.go
new file mode 100644
index 0000000000000000000000000000000000000000..9ce15de111e89d8aaa7c65bd373a72be7a2309da
--- /dev/null
+++ b/portal/internal/web/pi_creation_discard.go
@@ -0,0 +1,797 @@
+package web
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/aither64/dev-workspace/portal/internal/piruntime"
+	"github.com/aither64/dev-workspace/portal/internal/session"
+	"github.com/aither64/dev-workspace/portal/internal/userstate"
+	"golang.org/x/sys/unix"
+)
+
+var errPiDiscardOwner = errors.New("The portal could not verify that this failed request is safe to discard.")
+
+const piDiscardAuditLimit = 64 << 10
+
+// The authenticated startup grant supplies this immutable intent.
+type piDiscardIntent struct {
+	RequestID          string `json:"requestId"`
+	ReceiptID          string `json:"receiptId"`
+	PreparationAttempt int    `json:"preparationAttempt"`
+	CreationAttempt    int    `json:"creationAttempt"`
+}
+
+func (r piDiscardIntent) valid(id string) bool {
+	return validPreparationID(id) && r.RequestID == id && messageDigestPattern.MatchString(r.ReceiptID) &&
+		r.PreparationAttempt > 0 && r.CreationAttempt > 0
+}
+
+type piDiscardAudit struct {
+	Schema      int                `json:"schema"`
+	Owner       piDiscardIntent    `json:"owner"`
+	Incarnation string             `json:"incarnation"`
+	Terminal    sessionPreparation `json:"terminal"`
+	Original    [5]string          `json:"original"`
+}
+
+type piDiscardFile struct {
+	name, path string
+	limit      int
+}
+
+func piDiscardHash(data []byte) string {
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+func (s *Server) piDiscardDirectory(id string) string {
+	return filepath.Join(s.operationStore.directory, "pi-creation-discards", id)
+}
+
+func (s *Server) piDiscardMarkerPath(slug string) string {
+	return filepath.Join(s.config.Workspace, "worktrees", ".locks", slug+session.PiDiscardMarkerSuffix)
+}
+
+func (s *Server) piDiscardFiles(record sessionPreparation) [5]piDiscardFile {
+	receipt := creationReceipt{Request: creationRequest{Slug: record.Slug}, ReceiptID: record.ReceiptID}
+	binding := filepath.Join(s.config.UserStateRoot, "session-backends", piDiscardHash([]byte(s.config.Workspace)), record.Slug+".json")
+	return [5]piDiscardFile{
+		{"receipt", s.creationPath(record.Slug), maxCreationReceiptBytes},
+		{"companion", s.creationEvidencePath(receipt) + ".request", maxCreationReceiptBytes},
+		{"journal", piJournalPath(s.config.Workspace, record.Slug), maxCreationReceiptBytes},
+		{"binding", binding, 64 << 10},
+		{"preparation", s.preparationPath(record.RequestID, false), maxPreparationBytes},
+	}
+}
+
+// piDiscardHasNoAttachmentClaim is a conservative negative check, not a
+// decoder. Call only for the confirmed original tuple under creation/upload
+// exclusion and the supported stock writer lineage. Zero accepted file IDs
+// could not create a preparation claim (the writer returns before the store).
+// RetainCreations also keys on BOTH receipt goals, which could collide with a
+// different prepared initial submission. Every supported nonempty-file wire
+// contains this header, even when initial text is empty.
+func piDiscardHasNoAttachmentClaim(preparation sessionPreparation, receipt creationReceipt) bool {
+	const attachmentHeader = "Attached local files"
+	return preparation.Snapshot != nil && len(preparation.Snapshot.Input.Attachments) == 0 &&
+		!strings.Contains(receipt.Request.Goal, attachmentHeader) && !strings.Contains(receipt.Goal, attachmentHeader)
+}
+
+// Read exact bounded bytes without following a link, blocking on a FIFO, or
+// inferring genuine absence from an aliased parent.
+func readPiDiscardBytes(path string, limit int, durable bool) ([]byte, error) {
+	parent := filepath.Dir(path)
+	resolved, err := filepath.EvalSymlinks(parent)
+	if err != nil || resolved != parent {
+		if errors.Is(err, os.ErrNotExist) && requirePiDiscardAbsent(path) != nil {
+			return nil, errPiDiscardOwner
+		}
+		if err == nil {
+			err = errPiDiscardOwner
+		}
+		return nil, err
+	}
+	fd, err := unix.Open(path, unix.O_NOFOLLOW|unix.O_NONBLOCK|unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), path)
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return nil, err
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != uint32(os.Geteuid()) || !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Size() > int64(limit) {
+		return nil, errPiDiscardOwner
+	}
+	data, err := io.ReadAll(io.LimitReader(file, int64(limit)+1))
+	if err != nil || len(data) > limit {
+		return nil, errPiDiscardOwner
+	}
+	if durable {
+		if err = file.Sync(); err != nil {
+			return nil, err
+		}
+	}
+	return data, nil
+}
+
+// No old selector may move unless this atomic publication and containing
+// directory sync succeed. A lost acknowledgement keeps the published bytes.
+func writePiDiscardExclusive(path string, data []byte) error {
+	directory := filepath.Dir(path)
+	if err := privatePreparationDirectory(directory); err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(directory, ".pi-discard-*.tmp")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(file.Name())
+	if _, err = file.Write(data); err == nil {
+		err = file.Sync()
+	}
+	if closeErr := file.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	if err = unix.Renameat2(unix.AT_FDCWD, file.Name(), unix.AT_FDCWD, path, unix.RENAME_NOREPLACE); err != nil {
+		return err
+	}
+	return syncPreparationDirectory(directory)
+}
+
+func requirePiDiscardAbsent(path string) error {
+	// Check existing ancestors too; a missing target below a dangling link
+	// cannot prove absence. The workspace and state paths are trusted config.
+	for parent := filepath.Dir(path); parent != "/"; parent = filepath.Dir(parent) {
+		info, err := os.Lstat(parent)
+		if errors.Is(err, os.ErrNotExist) {
+			continue
+		}
+		if err != nil || !info.IsDir() {
+			return errPiDiscardOwner
+		}
+	}
+	if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		return errPiDiscardOwner
+	}
+	return nil
+}
+
+func (s *Server) readPiDiscardPreparation(id string, compact bool) (sessionPreparation, error) {
+	path := s.preparationPath(id, compact)
+	if _, err := readPiDiscardBytes(path, maxPreparationBytes, false); err != nil {
+		return sessionPreparation{}, err
+	}
+	return readPreparation(path, s.config.Workspace)
+}
+
+func piDiscardTerminal(record sessionPreparation, updatedAt string) sessionPreparation {
+	record.State, record.Terminal, record.Phase, record.UpdatedAt = "terminal", "cancelled", "initializing", updatedAt
+	record.Snapshot, record.Handoff = nil, nil
+	record.Base, record.SnapshotDigest, record.Error = "", "", ""
+	return record
+}
+
+// Admission runs before publishing any discard intent and after waiting for
+// every ordinary owner. Never use status helpers that can repair or publish.
+func (s *Server) provePiDiscard(ctx context.Context, req piDiscardIntent, record sessionPreparation) (piDiscardAudit, error) {
+	var audit piDiscardAudit
+	if record.Schema != 3 || record.State != "handed_off" || record.ReceiptID != req.ReceiptID || record.Attempt != req.PreparationAttempt ||
+		record.Snapshot == nil || record.Snapshot.Input.Sensitive || !session.ValidSlug(record.Slug) || s.preparationUnconfirmed[req.RequestID] != "" {
+		return audit, errPiDiscardOwner
+	}
+	if work, exists := s.preparationWork[req.RequestID]; exists && work.dispatched && !work.stopped {
+		return audit, errPiDiscardOwner
+	}
+	files := s.piDiscardFiles(record)
+	for i, file := range files {
+		data, err := readPiDiscardBytes(file.path, file.limit, true)
+		if err != nil {
+			return audit, err
+		}
+		audit.Original[i] = piDiscardHash(data)
+		if err := syncPreparationDirectory(filepath.Dir(file.path)); err != nil {
+			return audit, err
+		}
+	}
+	original, err := readPreparation(files[4].path, s.config.Workspace)
+	if err != nil || preparationDigest(original) != preparationDigest(record) {
+		return audit, errPiDiscardOwner
+	}
+	inventory, err := readPreparations(ctx, s.operationStore.directory, s.config.Workspace)
+	if err != nil {
+		return audit, err
+	}
+	for id, other := range inventory {
+		if id != req.RequestID && other.State != "terminal" && other.Slug == record.Slug {
+			return audit, errPiDiscardOwner
+		}
+	}
+	receiptBytes, err := readPiDiscardBytes(files[0].path, files[0].limit, true)
+	if err != nil {
+		return audit, err
+	}
+	var raw map[string]json.RawMessage
+	var receipt creationReceipt
+	if rejectDuplicateCreationJSONKeys(receiptBytes) != nil || json.Unmarshal(receiptBytes, &raw) != nil ||
+		validateCreationReceiptShape(raw) != nil || json.Unmarshal(receiptBytes, &receipt) != nil ||
+		receipt.Schema != 4 || receipt.State != "failed" || !receipt.Validated || receipt.Request.Kind != "new" || receipt.Attempt != req.CreationAttempt ||
+		!preparationReceiptMatches(original, receipt) || !piDiscardHasNoAttachmentClaim(original, receipt) {
+		return audit, errPiDiscardOwner
+	}
+	if cached, found := s.creations[record.Slug]; !found || preparationDigest(cached) != preparationDigest(receipt) {
+		return audit, errPiDiscardOwner
+	}
+	intent, err := receipt.piIntent()
+	if err != nil || intent.ValidateShape() != nil || intent.Sensitive || intent.Workspace != s.config.Workspace {
+		return audit, errPiDiscardOwner
+	}
+	companion, err := readPiCreationIntent(files[1].path)
+	if err != nil || !reflect.DeepEqual(companion, intent) {
+		return audit, errPiDiscardOwner
+	}
+	journal, err := readPiCreationJournal(files[2].path)
+	if err != nil || journal.State != "creating" || journal.NativeCreateStarted || journal.NativeGeneration != "" || journal.Native != nil ||
+		!reflect.DeepEqual(journal.PiCreationIntent, intent) {
+		return audit, errPiDiscardOwner
+	}
+	binding, err := (session.BackendBindingStore{Root: s.config.UserStateRoot, Workspace: intent.Workspace}).Load(intent.Slug)
+	if err != nil || !reflect.DeepEqual(binding, intent.Binding()) {
+		return audit, errPiDiscardOwner
+	}
+	if err = s.provePiDiscardNoEffects(ctx, receipt, intent); err != nil {
+		return audit, err
+	}
+	audit.Schema, audit.Owner, audit.Incarnation = 1, req, intent.SessionIncarnation
+	audit.Terminal = piDiscardTerminal(original, time.Now().UTC().Format(time.RFC3339Nano))
+	return audit, validatePreparation(audit.Terminal, s.config.Workspace)
+}
+
+func (s *Server) provePiDiscardNoEffects(ctx context.Context, receipt creationReceipt, intent session.PiCreationIntent) error {
+	workspace, slug := intent.Workspace, intent.Slug
+	roots := []string{
+		filepath.Join(workspace, "work", slug), filepath.Join(workspace, "archive", slug), filepath.Join(workspace, "worktrees", slug),
+		filepath.Join(s.config.AuthorityDir, slug+".json"), filepath.Join(s.config.AuthorityDir, slug+".start.json"),
+		filepath.Join(userstate.WorkspaceDirectory(s.config.UserStateRoot, "codex-teams", workspace), slug+".json"),
+		filepath.Join(userstate.WorkspaceDirectory(s.config.UserStateRoot, "session-services", workspace), slug+".json"),
+		s.creationEvidencePath(receipt),
+	}
+	for _, suffix := range []string{".fork.json", ".start.json", ".archive-cleanup.json", ".services-registration.json", ".services-cleanup.json"} {
+		roots = append(roots, filepath.Join(workspace, "worktrees", ".locks", slug+suffix))
+	}
+	for _, path := range roots {
+		if err := requirePiDiscardAbsent(path); err != nil {
+			return err
+		}
+	}
+	// Match the host's <provider>/clusters/<slug> state layout without
+	// loading extension code or invoking a provider to discover state.
+	clusterRoot := filepath.Join(workspace, ".dev-clusters")
+	info, err := os.Lstat(clusterRoot)
+	if err == nil {
+		if !info.IsDir() {
+			return errPiDiscardOwner
+		}
+		providers, err := os.ReadDir(clusterRoot)
+		if err != nil || len(providers) > 128 {
+			return errPiDiscardOwner
+		}
+		for _, provider := range providers {
+			if err := requirePiDiscardAbsent(filepath.Join(clusterRoot, provider.Name(), "clusters", slug)); err != nil {
+				return err
+			}
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if owner, err := session.PendingLifecycle(workspace, slug); err != nil || owner != "" {
+		return errPiDiscardOwner
+	}
+	// A previous incarnation's retained ownership is outside this bridge.
+	history, err := session.CompletedRemovalHistory(workspace, slug, s.config.UserStateRoot)
+	if err != nil || history != intent.DeletionHistorySHA256 || history != piDiscardHash(nil) {
+		return errPiDiscardOwner
+	}
+	if _, exists := s.operations[slug]; exists {
+		return errPiDiscardOwner
+	}
+	// Ensure reserves the exact scoped runtime under its own lock before any
+	// frozen requests or host launch. This is its retained absence classifier,
+	// not a PID test or a mutating runtime probe.
+	if _, err := piruntime.InspectRetainedCurrentRuntime(ctx, s.config.UserStateRoot, intent.SessionRef()); !errors.Is(err, os.ErrNotExist) {
+		return errPiDiscardOwner
+	}
+	return nil
+}
+
+func (s *Server) loadPiDiscardAudit(id string) (piDiscardAudit, string, error) {
+	var audit piDiscardAudit
+	directory := s.piDiscardDirectory(id)
+	if err := privatePreparationDirectory(directory); err != nil {
+		return audit, "", err
+	}
+	data, err := readPiDiscardBytes(filepath.Join(directory, "intent.json"), piDiscardAuditLimit, false)
+	if err != nil {
+		return audit, "", err
+	}
+	if session.DecodePiCreationJSON(data, &audit, piDiscardAuditLimit) != nil || audit.Schema != 1 || !audit.Owner.valid(id) || !messageDigestPattern.MatchString(audit.Incarnation) ||
+		validatePreparation(audit.Terminal, s.config.Workspace) != nil || audit.Terminal.Schema != 3 || audit.Terminal.State != "terminal" || audit.Terminal.Terminal != "cancelled" ||
+		audit.Terminal.RequestID != id || audit.Terminal.ReceiptID != audit.Owner.ReceiptID || audit.Terminal.Attempt != audit.Owner.PreparationAttempt || !session.ValidSlug(audit.Terminal.Slug) {
+		return audit, "", errPiDiscardOwner
+	}
+	for _, digest := range audit.Original {
+		if !messageDigestPattern.MatchString(digest) {
+			return audit, "", errPiDiscardOwner
+		}
+	}
+	return audit, piDiscardHash(data), nil
+}
+
+func (s *Server) stagePiDiscard(audit piDiscardAudit) (piDiscardAudit, string, error) {
+	directory := s.piDiscardDirectory(audit.Owner.RequestID)
+	if err := os.MkdirAll(directory, 0700); err != nil {
+		return audit, "", err
+	}
+	device := func(path string) (uint64, error) {
+		info, err := os.Lstat(path)
+		if err != nil {
+			return 0, err
+		}
+		stat, ok := info.Sys().(*syscall.Stat_t)
+		if !ok || !info.IsDir() || stat.Uid != uint32(os.Geteuid()) || info.Mode().Perm()&0022 != 0 {
+			return 0, errPiDiscardOwner
+		}
+		return uint64(stat.Dev), nil
+	}
+	destination, err := device(directory)
+	if err != nil {
+		return audit, "", err
+	}
+	for _, file := range s.piDiscardFiles(audit.Terminal) {
+		if source, err := device(filepath.Dir(file.path)); err != nil || source != destination {
+			return audit, "", errPiDiscardOwner
+		}
+		if err := requirePiDiscardAbsent(filepath.Join(directory, file.name+".json")); err != nil {
+			return audit, "", err
+		}
+	}
+	if err := requirePiDiscardAbsent(filepath.Join(directory, "complete")); err != nil {
+		return audit, "", err
+	}
+	if err := os.MkdirAll(s.preparationDirectory(true), 0700); err != nil {
+		return audit, "", err
+	}
+	if dest, err := device(s.preparationDirectory(true)); err != nil || dest != destination {
+		return audit, "", errPiDiscardOwner
+	}
+	for _, path := range []string{directory, filepath.Dir(directory), s.operationStore.directory, s.preparationDirectory(true), filepath.Dir(s.piDiscardMarkerPath(audit.Terminal.Slug))} {
+		if err := privatePreparationDirectory(path); err != nil {
+			return audit, "", err
+		}
+		if err := syncPreparationDirectory(path); err != nil {
+			return audit, "", err
+		}
+	}
+	data, err := json.Marshal(audit)
+	if err != nil {
+		return audit, "", err
+	}
+	if err := writePiDiscardExclusive(filepath.Join(directory, "intent.json"), data); err != nil && !errors.Is(err, os.ErrExist) {
+		return audit, "", err
+	}
+	staged, digest, err := s.loadPiDiscardAudit(audit.Owner.RequestID)
+	if err != nil {
+		return audit, "", err
+	}
+	audit.Terminal.UpdatedAt = staged.Terminal.UpdatedAt
+	if !reflect.DeepEqual(audit, staged) {
+		return audit, "", errPiDiscardOwner
+	}
+	if _, err := readPiDiscardBytes(filepath.Join(directory, "intent.json"), piDiscardAuditLimit, true); err != nil {
+		return audit, "", err
+	}
+	return audit, digest, syncPreparationDirectory(directory)
+}
+
+func (s *Server) piDiscardMarker(audit piDiscardAudit, digest string) session.PiDiscardMarker {
+	return session.PiDiscardMarker{Schema: 1, WorkspaceSHA256: piDiscardHash([]byte(s.config.Workspace)), Slug: audit.Terminal.Slug,
+		RequestID: audit.Owner.RequestID, ReceiptID: audit.Owner.ReceiptID, PreparationAttempt: audit.Owner.PreparationAttempt,
+		CreationAttempt: audit.Owner.CreationAttempt, AuditSHA256: digest}
+}
+
+func (s *Server) confirmPiDiscardComplete(audit piDiscardAudit, digest string) (bool, error) {
+	path := filepath.Join(s.piDiscardDirectory(audit.Owner.RequestID), "complete")
+	data, err := readPiDiscardBytes(path, 65, true)
+	if errors.Is(err, os.ErrNotExist) {
+		return false, nil
+	}
+	if err != nil || string(data) != digest+"\n" {
+		return false, errPiDiscardOwner
+	}
+	mapped, err := s.readPiDiscardPreparation(audit.Owner.RequestID, true)
+	if err != nil || preparationDigest(mapped) != preparationDigest(audit.Terminal) {
+		return false, errPiDiscardOwner
+	}
+	if err := requirePiDiscardAbsent(s.preparationPath(audit.Owner.RequestID, false)); err != nil {
+		return false, err
+	}
+	for i, file := range s.piDiscardFiles(audit.Terminal) {
+		data, err := readPiDiscardBytes(filepath.Join(filepath.Dir(path), file.name+".json"), file.limit, false)
+		if err != nil || piDiscardHash(data) != audit.Original[i] {
+			return false, errPiDiscardOwner
+		}
+	}
+	return true, syncPreparationDirectory(filepath.Dir(path))
+}
+
+func movePiDiscardOriginal(original piDiscardFile, destination, digest string, allowProjectedPreparation bool) error {
+	source, sourceErr := readPiDiscardBytes(original.path, original.limit, true)
+	retired, retiredErr := readPiDiscardBytes(destination, original.limit, true)
+	switch {
+	case sourceErr == nil && piDiscardHash(source) == digest && errors.Is(retiredErr, os.ErrNotExist):
+		if err := unix.Renameat2(unix.AT_FDCWD, original.path, unix.AT_FDCWD, destination, unix.RENAME_NOREPLACE); err != nil {
+			return err
+		}
+	case retiredErr == nil && piDiscardHash(retired) == digest && (errors.Is(sourceErr, os.ErrNotExist) || (sourceErr == nil && allowProjectedPreparation && piDiscardHash(source) != digest)):
+		// An exact audit-side selector is durable proof of an interrupted
+		// move. Only the exact checked terminal projection may coexist.
+	default:
+		return errPiDiscardOwner
+	}
+	if err := syncPreparationDirectory(filepath.Dir(destination)); err != nil {
+		return err
+	}
+	return syncPreparationDirectory(filepath.Dir(original.path))
+}
+
+func (s *Server) finishPiDiscard(ctx context.Context, audit piDiscardAudit, digest string) error {
+	id, slug := audit.Owner.RequestID, audit.Terminal.Slug
+	directory := s.piDiscardDirectory(id)
+	complete, err := s.confirmPiDiscardComplete(audit, digest)
+	if err != nil {
+		return err
+	}
+	if !complete {
+		// Confirm marker durability even after an uncertain publication reply.
+		if err := syncPreparationDirectory(filepath.Dir(s.piDiscardMarkerPath(slug))); err != nil {
+			return err
+		}
+		active, activeErr := s.readPiDiscardPreparation(id, false)
+		mapped, mappedErr := s.readPiDiscardPreparation(id, true)
+		projected := activeErr == nil && preparationDigest(active) == preparationDigest(audit.Terminal)
+		mapping := mappedErr == nil && preparationDigest(mapped) == preparationDigest(audit.Terminal)
+		if (mappedErr == nil && !mapping) || (mappedErr != nil && !errors.Is(mappedErr, os.ErrNotExist)) ||
+			(activeErr != nil && !errors.Is(activeErr, os.ErrNotExist)) || (mapping && activeErr == nil) {
+			return errPiDiscardOwner
+		}
+		for i, file := range s.piDiscardFiles(audit.Terminal) {
+			retire := func(path string) error {
+				if path != file.path {
+					return errPiDiscardOwner
+				}
+				return movePiDiscardOriginal(file, filepath.Join(directory, file.name+".json"), audit.Original[i], projected && file.name == "preparation")
+			}
+			if file.name == "binding" {
+				store := session.BackendBindingStore{Root: s.config.UserStateRoot, Workspace: s.config.Workspace}
+				err = store.WithPiDiscardBindingLock(ctx, slug, retire)
+			} else {
+				err = retire(file.path)
+			}
+			if err != nil {
+				return err
+			}
+			if err := s.piCreationPoint("discard_" + file.name); err != nil {
+				return err
+			}
+		}
+		if !mapping && !projected {
+			if err := s.savePreparation(audit.Terminal); err != nil {
+				return err
+			}
+		} else {
+			s.preparations[id] = audit.Terminal
+			publication := s.preparationPath(id, mapping)
+			s.preparationUnconfirmed[id] = publication
+			if err := s.confirmPreparationLocked(id); err != nil {
+				return err
+			}
+		}
+		if err := s.piCreationPoint("discard_mapping"); err != nil {
+			return err
+		}
+		if current, ok := s.creations[slug]; ok && current.ReceiptID != audit.Owner.ReceiptID {
+			return errPiDiscardOwner
+		}
+		delete(s.creations, slug)
+		delete(s.preparationWork, id)
+		if err := writePiDiscardExclusive(filepath.Join(directory, "complete"), []byte(digest+"\n")); err != nil {
+			return err
+		}
+	}
+	if err := s.piCreationPoint("discard_complete"); err != nil {
+		return err
+	}
+	return s.confirmPiDiscardCleanup(audit, digest, true)
+}
+
+// After completion, never inspect or retire live session selectors. A later
+// owner may legitimately have acquired the slug while the marker was absent.
+// Call only with the selected-generation and ordinary destination locks held,
+// and after proving the audit and compact mapping durable.
+func (s *Server) confirmPiDiscardCleanup(audit piDiscardAudit, digest string, allowUnlink bool) error {
+	path := s.piDiscardMarkerPath(audit.Terminal.Slug)
+	parent := filepath.Dir(path)
+	if err := privatePreparationDirectory(parent); err != nil {
+		return err
+	}
+	data, err := readPiDiscardBytes(path, session.PiDiscardMarkerLimit, false)
+	if err == nil {
+		var marker session.PiDiscardMarker
+		if session.DecodePiCreationJSON(data, &marker, session.PiDiscardMarkerLimit) != nil || marker != s.piDiscardMarker(audit, digest) {
+			return errPiDiscardOwner
+		}
+		if !allowUnlink {
+			return session.ErrPiDiscardPending
+		}
+		if err := os.Remove(path); err != nil {
+			return err
+		}
+		if err := s.piCreationPoint("discard_marker_unlink"); err != nil {
+			return err
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if err := s.piCreationPoint("discard_cleanup_sync"); err != nil {
+		return err
+	}
+	if err := syncPreparationDirectory(parent); err != nil {
+		return err
+	}
+	if err := requirePiDiscardAbsent(path); err != nil {
+		return err
+	}
+	delete(s.piDiscards, audit.Owner.RequestID)
+	s.preparations[audit.Owner.RequestID] = audit.Terminal
+	return nil
+}
+
+func (s *Server) lockPiDiscardDestination(slug string) (func(), error) {
+	creation, err := session.LockCreation(s.config.AuthorityDir, slug)
+	if err != nil {
+		return nil, err
+	}
+	runtime, err := session.LockRuntimeExclusive(s.config.AuthorityDir, slug)
+	if err != nil {
+		creation.Close()
+		return nil, err
+	}
+	unlock := func() { runtime.Close(); creation.Close() }
+	if err := s.requireCurrentHostProfile(); err != nil {
+		unlock()
+		return nil, err
+	}
+	return unlock, nil
+}
+
+// Preparation GET may confirm an already absent marker, but only an exact
+// confirmed POST may unlink a matching marker. The compact mapping alone is
+// not proof of cleanup, including just after restarting the bridge.
+func (s *Server) confirmPiDiscardStatusLocked(record sessionPreparation, id string) (*preparationStatus, error) {
+	pending, parked := s.piDiscards[id]
+	if !parked && (record.Schema != 3 || record.State != "terminal" || record.Terminal != "cancelled") {
+		return nil, nil
+	}
+	audit, digest, err := s.loadPiDiscardAudit(id)
+	if err != nil || (parked && !reflect.DeepEqual(audit, pending)) ||
+		(!parked && preparationDigest(audit.Terminal) != preparationDigest(record)) {
+		return nil, errPiDiscardOwner
+	}
+	unlock, err := s.lockPiDiscardDestination(audit.Terminal.Slug)
+	if err != nil {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	defer unlock()
+	complete, err := s.confirmPiDiscardComplete(audit, digest)
+	if err != nil {
+		return nil, ErrPiDiscardStartupHeld
+	}
+	status := piDiscardPendingStatus(audit)
+	if !complete {
+		if !parked {
+			return nil, errPiDiscardOwner
+		}
+		return &status, nil
+	}
+	if err := s.confirmPiDiscardCleanup(audit, digest, false); err != nil {
+		if errors.Is(err, errPiDiscardOwner) {
+			return nil, err
+		}
+		status.Detail = "The request was discarded. The portal has not confirmed cleanup."
+		return &status, nil
+	}
+	return nil, nil
+}
+
+// The grant-backed startup caller holds transition SH. There is no request
+// path that can execute the discard without revalidating the retained claim.
+func (s *Server) executePiDiscard(ctx context.Context, startup piDiscardStartup) (sessionPreparation, error) {
+	var zero sessionPreparation
+	request := startup.target.intent()
+	if startup.verify == nil || !request.valid(request.RequestID) {
+		return zero, errPiDiscardOwner
+	}
+	if err := s.uploadCreationMu.Lock(ctx); err != nil {
+		return zero, err
+	}
+	defer s.uploadCreationMu.Unlock()
+	s.operationMu.Lock()
+	defer s.operationMu.Unlock()
+	if s.closing {
+		return zero, errPiDiscardOwner
+	}
+	id := request.RequestID
+	record, active := s.preparations[id]
+	pending, inProgress := s.piDiscards[id]
+	if !active && !inProgress {
+		return zero, errPiDiscardOwner
+	}
+	if inProgress {
+		record = pending.Terminal
+	}
+	if request.ReceiptID != record.ReceiptID || request.PreparationAttempt != record.Attempt || !session.ValidSlug(record.Slug) {
+		return zero, errPiDiscardOwner
+	}
+	unlock, err := s.lockPiDiscardDestination(record.Slug)
+	if err != nil {
+		return zero, err
+	}
+	defer unlock()
+	if record.Slug != startup.target.Slug || record.Epoch != startup.target.Epoch {
+		return zero, errPiDiscardOwner
+	}
+	if record.State == "terminal" && !inProgress {
+		audit, digest, err := s.loadPiDiscardAudit(id)
+		if err != nil || audit.Owner != request || !startup.matches(audit) || preparationDigest(record) != preparationDigest(audit.Terminal) {
+			return zero, errPiDiscardOwner
+		}
+		if done, err := s.confirmPiDiscardComplete(audit, digest); err != nil || !done {
+			return zero, errPiDiscardOwner
+		}
+		if !startup.authorized(ctx) {
+			return zero, errPiDiscardOwner
+		}
+		return audit.Terminal, s.confirmPiDiscardCleanup(audit, digest, true)
+	}
+	var audit piDiscardAudit
+	var digest string
+	markers, err := session.ReadPiDiscardMarkers(s.config.Workspace)
+	if err != nil {
+		return zero, err
+	}
+	if marker, exists := markers[record.Slug]; exists || inProgress {
+		audit, digest, err = s.loadPiDiscardAudit(id)
+		if err != nil || audit.Owner != request || !startup.matches(audit) || (exists && marker != s.piDiscardMarker(audit, digest)) {
+			return zero, errPiDiscardOwner
+		}
+		if !exists {
+			if done, err := s.confirmPiDiscardComplete(audit, digest); err != nil || !done {
+				return zero, errPiDiscardOwner
+			}
+		}
+		if !startup.authorized(ctx) {
+			return zero, errPiDiscardOwner
+		}
+	} else {
+		if len(markers) != 0 {
+			return zero, session.ErrPiDiscardPending
+		}
+		// Startup has not run the ordinary creation loader (which can
+		// retire unrelated receipts). Read just this failed owner under
+		// the same locks as normal admission and confirm it below.
+		if err := s.loadPiDiscardStartupReceipt(record, startup.target); err != nil {
+			return zero, err
+		}
+		audit, err = s.provePiDiscard(ctx, request, record)
+		if err != nil {
+			return zero, err
+		}
+		if !startup.matches(audit) || !startup.authorized(ctx) {
+			return zero, errPiDiscardOwner
+		}
+		audit, digest, err = s.stagePiDiscard(audit)
+		if err != nil {
+			return zero, err
+		}
+		marker, err := json.Marshal(s.piDiscardMarker(audit, digest))
+		if err != nil {
+			return zero, err
+		}
+		path := s.piDiscardMarkerPath(record.Slug)
+		writeErr := writePiDiscardExclusive(path, marker)
+		if writeErr == nil || errors.Is(session.RequireNoPiDiscard(s.config.Workspace, record.Slug), session.ErrPiDiscardPending) {
+			s.parkPiDiscard(audit)
+		}
+		if writeErr != nil {
+			return zero, writeErr
+		}
+		if err := s.piCreationPoint("discard_intent"); err != nil {
+			return zero, err
+		}
+	}
+	if err := s.finishPiDiscard(ctx, audit, digest); err != nil {
+		return zero, err
+	}
+	return audit.Terminal, nil
+}
+
+func (s *Server) parkPiDiscard(audit piDiscardAudit) {
+	if s.piDiscards == nil {
+		s.piDiscards = make(map[string]piDiscardAudit)
+	}
+	id, slug := audit.Owner.RequestID, audit.Terminal.Slug
+	s.piDiscards[id] = audit
+	if receipt, ok := s.creations[slug]; ok && receipt.ReceiptID == audit.Owner.ReceiptID {
+		delete(s.creations, slug)
+	}
+	delete(s.preparations, id)
+	delete(s.preparationWork, id)
+}
+
+func (s *Server) loadPiDiscards() error {
+	markers, err := session.ReadPiDiscardMarkers(s.config.Workspace)
+	if err != nil {
+		return err
+	}
+	for _, marker := range markers {
+		audit, digest, err := s.loadPiDiscardAudit(marker.RequestID)
+		if err != nil || marker != s.piDiscardMarker(audit, digest) {
+			return errPiDiscardOwner
+		}
+		s.parkPiDiscard(audit)
+	}
+	return nil
+}
+
+// Call under operationMu (or before the server starts accepting requests).
+func (s *Server) requireNoPiDiscardLocked(slug string) error {
+	for _, audit := range s.piDiscards {
+		if audit.Terminal.Slug == slug {
+			return session.ErrPiDiscardPending
+		}
+	}
+	return session.RequireNoPiDiscard(s.config.Workspace, slug)
+}
+
+func (s *Server) pendingPiDiscardStatus(id string) (preparationStatus, bool) {
+	s.operationMu.Lock()
+	defer s.operationMu.Unlock()
+	audit, exists := s.piDiscards[id]
+	if !exists {
+		return preparationStatus{}, false
+	}
+	return piDiscardPendingStatus(audit), true
+}
+
+func piDiscardPendingStatus(audit piDiscardAudit) preparationStatus {
+	id := audit.Owner.RequestID
+	return preparationStatus{Backend: "pi", RequestID: id, ReceiptID: audit.Owner.ReceiptID, State: "discard_pending", Phase: "initializing",
+		Attempt: audit.Owner.CreationAttempt, PreparationAttempt: audit.Owner.PreparationAttempt, URL: "/creations/" + id + "/",
+		StartedAt: audit.Terminal.StartedAt, UpdatedAt: audit.Terminal.UpdatedAt}
+}
