+func TestPiDiscardExactOwnerAndReplay(t *testing.T) {
+	s, preparation, receipt, native := newPiDiscardFixture(t)
+	req := fixturePiDiscardStartupGrant(s, preparation, receipt).Target
+	for _, variant := range []struct {
+		name   string
+		change func(*piDiscardStartupTarget)
+	}{
+		{"wrong receipt", func(r *piDiscardStartupTarget) { r.ReceiptID = strings.Repeat("a", 64) }},
+		{"wrong preparation attempt", func(r *piDiscardStartupTarget) { r.PreparationAttempt++ }},
+		{"wrong creation attempt", func(r *piDiscardStartupTarget) { r.CreationAttempt-- }},
+		{"wrong request", func(r *piDiscardStartupTarget) { r.RequestID = preparationTestID(820) }},
+	} {
+		t.Run(variant.name, func(t *testing.T) {
+			wrong := req
+			variant.change(&wrong)
+			if err := executePiDiscardFixture(s, wrong); err == nil {
+				t.Fatal("wrong owner was accepted")
+			}
+			if err := session.RequireNoPiDiscard(s.config.Workspace, preparation.Slug); err != nil {
+				t.Fatal("refused request published a marker", err)
+			}
+		})
+	}
+	if err := executePiDiscardFixture(s, req); err != nil {
+		t.Fatal("exact discard did not complete", err)
+	}
+	assertPiDiscardCompleted(t, s, preparation, native)
+	// The path can later contain a different owner's work. Replay is bound to
+	// the old completed audit, not to any live slug lookup or retirement.
+	preset, err := teamruntime.ProjectPiPreset(*receipt.DirectTeam)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := receipt.Request
+	request.directTeam = &preset
+	accepted, err := s.acceptCreation(request)
+	if err != nil {
+		t.Fatal("ordinary admission refused the replacement", err)
+	}
+	replacement := awaitCreation(t, s, preparation.Slug)
+	if replacement.ReceiptID != accepted.ReceiptID || replacement.ReceiptID == receipt.ReceiptID || replacement.State != "failed" ||
+		native.ensures != 0 || native.creates != 0 || native.sends != 0 {
+		t.Fatal("replacement did not reach the separate synthetic pre-runtime failure")
+	}
+	before, err := os.ReadFile(s.creationPath(preparation.Slug))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := executePiDiscardFixture(s, req); err != nil {
+		t.Fatal("exact completed replay changed", err)
+	}
+	after, err := os.ReadFile(s.creationPath(preparation.Slug))
+	if err != nil || !bytes.Equal(before, after) {
+		t.Fatal("old replay touched replacement", err)
+	}
+	// Simulate a durable completed audit with the old reservation visible
+	// again after interruption. Boot must retain the newer live owner.
+	audit, digest, err := s.loadPiDiscardAudit(req.RequestID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	marker, err := json.Marshal(s.piDiscardMarker(audit, digest))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := writePiDiscardExclusive(s.piDiscardMarkerPath(preparation.Slug), marker); err != nil {
+		t.Fatal(err)
+	}
+	config := s.config
+	config.PackageRoot = ""
+	s.Close()
+	restarted, err := New(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer restarted.Close()
+	status := piDiscardHTTPStatus(t, restarted, req.RequestID)
+	if status.State != "discard_pending" || status.Detail == "" {
+		t.Fatal("status did not separate durable discard from confirmed cleanup")
+	}
+	if data, err := os.ReadFile(restarted.piDiscardMarkerPath(preparation.Slug)); err != nil || !bytes.Equal(marker, data) {
+		t.Fatal("status unlinked the restored marker without confirmation", err)
+	}
+	if err := executePiDiscardFixture(restarted, req); err != nil {
+		t.Fatal("old completed marker could not be acknowledged", err)
+	}
+	current, exists := restarted.currentCreation(preparation.Slug)
+	after, err = os.ReadFile(restarted.creationPath(preparation.Slug))
+	if !exists || current.ReceiptID != replacement.ReceiptID || err != nil || !bytes.Equal(before, after) {
+		t.Fatal("old completed marker changed replacement", err)
+	}
+	foreign := restarted.piDiscardMarker(audit, digest)
+	foreign.ReceiptID = replacement.ReceiptID
+	foreignBytes, err := json.Marshal(foreign)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := restarted.piDiscardMarkerPath(preparation.Slug)
+	if err := writePiDiscardExclusive(path, foreignBytes); err != nil {
+		t.Fatal(err)
+	}
+	if err := executePiDiscardFixture(restarted, req); !errors.Is(err, errPiDiscardOwner) {
+		t.Fatal("old grant accepted a foreign marker", err)
+	}
+	if data, err := os.ReadFile(path); err != nil || !bytes.Equal(data, foreignBytes) {
+		t.Fatal("old confirmation touched a foreign marker", err)
+	}
+}
