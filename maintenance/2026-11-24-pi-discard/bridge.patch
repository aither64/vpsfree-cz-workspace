+	}
+	if _, pending := s.pendingPiDiscardStatus(req.RequestID); !pending {
+		t.Fatal("missing pending status before confirming marker removal")
+	}
+	// The terminal mapping and audit already prove cancellation. Other
+	// processes can now see marker absence while cleanup is unconfirmed.
+	assertPiDiscardCompleted(t, s, preparation, native)
+	audit, digest, err := s.loadPiDiscardAudit(req.RequestID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if complete, err := s.confirmPiDiscardComplete(audit, digest); err != nil || !complete {
+		t.Fatal("unlink preceded durable discard", err)
+	}
+	config := s.config
+	config.PackageRoot = ""
+	s.Close()
+	restarted, err := New(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer restarted.Close()
+	if _, pending := restarted.pendingPiDiscardStatus(req.RequestID); pending {
+		t.Fatal("fresh portal unexpectedly had a cached pending entry")
+	}
+	barriers := 0
+	restarted.piCreationCheckpoint = func(step string) error {
+		if step == "discard_cleanup_sync" {
+			barriers++
+			return errors.New("fixture failed directory sync again")
+		}
+		if strings.HasPrefix(step, "discard_") {
+			t.Fatalf("completed replay reached %s", step)
+		}
+		return nil
+	}
+	if status := piDiscardHTTPStatus(t, restarted, req.RequestID); status.State != "discard_pending" || status.Detail == "" {
+		t.Fatal("fresh status mistaken for confirmed cleanup")
+	}
+	if err := executePiDiscardFixture(restarted, req); err == nil || barriers != 2 {
+		t.Fatal("fresh replay failed to honor the repeated barrier failure", err, barriers)
+	}
+	restarted.piCreationCheckpoint = func(step string) error {
+		if step == "discard_cleanup_sync" {
+			barriers++
+		}
+		return nil
+	}
+	if status := piDiscardHTTPStatus(t, restarted, req.RequestID); status.State != "cancelled" || barriers != 3 {
+		t.Fatal("successful status did not confirm cleanup", status.State, barriers)
+	}
+	if err := executePiDiscardFixture(restarted, req); err != nil || barriers != 4 {
+		t.Fatal("exact operation did not confirm final directory sync", err, barriers)
+	}
+	assertPiDiscardCompleted(t, restarted, preparation, native)
+}
+
+func TestPiDiscardFailsClosedBeforeIntent(t *testing.T) {
+	for _, blocked := range []string{"runtime reservation", "runtime artifact", "authority", "tracking", "service", "cluster", "companion", "newer attempt"} {
+		t.Run(blocked, func(t *testing.T) {
+			s, preparation, receipt, native := newPiDiscardFixture(t)
+			intent, err := receipt.piIntent()
+			if err != nil {
+				t.Fatal(err)
+			}
+			ref := intent.SessionRef()
+			var path string
+			switch blocked {
+			case "runtime reservation", "runtime artifact":
+				dir, err := piruntime.SessionStateDirectory(s.config.UserStateRoot, ref)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if blocked == "runtime artifact" {
+					path = filepath.Join(dir, "requests", "retained")
+				} else {
+					path = filepath.Join(dir, "runtime.json")
+				}
+			case "authority":
+				path = filepath.Join(s.config.AuthorityDir, ref.Slug+".json")
+			case "tracking":
+				path = filepath.Join(ref.Workspace, "work", ref.Slug, "plan.md")
+			case "service":
+				path = filepath.Join(ref.Workspace, "worktrees", ".locks", ref.Slug+".services-registration.json")
+			case "cluster":
+				path = filepath.Join(ref.Workspace, ".dev-clusters", "fixture", "clusters", ref.Slug, "state.json")
+			case "companion":
+				if err := os.Remove(s.creationEvidencePath(receipt) + ".request"); err != nil {
+					t.Fatal(err)
+				}
+			case "newer attempt":
+				newer := receipt
+				newer.Attempt++
+				if err := s.saveCreation(newer); err != nil {
+					t.Fatal(err)
+				}
+				s.creations[ref.Slug] = newer
+			}
+			if path != "" {
+				if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(path, []byte(`{"schema":1}`), 0o600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			before, err := os.ReadFile(s.creationPath(ref.Slug))
+			if err != nil {
+				t.Fatal(err)
+			}
+			req := fixturePiDiscardStartupGrant(s, preparation, receipt).Target
+			if err := executePiDiscardFixture(s, req); err == nil {
+				t.Fatal("ambiguous owner was allowed")
+			}
+			if err := requirePiDiscardAbsent(s.piDiscardDirectory(req.RequestID)); err != nil {
+				t.Fatal("refusal staged audit", err)
+			}
+			if err := session.RequireNoPiDiscard(ref.Workspace, ref.Slug); err != nil {
+				t.Fatal("refusal published intent", err)
+			}
+			after, err := os.ReadFile(s.creationPath(ref.Slug))
+			if err != nil || !bytes.Equal(before, after) || native.ensures != 0 || native.creates != 0 || native.sends != 0 {
+				t.Fatal("refusal changed owner or reached effects", err)
+			}
+		})
+	}
+}
+
+func TestPiDiscardSerializesRetryAndDuplicate(t *testing.T) {
+	s, preparation, receipt, native := newPiDiscardFixture(t)
+	req := fixturePiDiscardStartupGrant(s, preparation, receipt).Target
+	atIntent, proceed := make(chan struct{}), make(chan struct{})
+	var released bool
+	defer func() {
+		if !released {
+			close(proceed)
+		}
+	}()
+	s.piCreationCheckpoint = func(step string) error {
+		if step == "discard_intent" {
+			close(atIntent)
+			<-proceed
+		}
+		return nil
+	}
+	first, duplicate, retry := make(chan error, 1), make(chan error, 1), make(chan int, 1)
+	go func() { first <- executePiDiscardFixture(s, req) }()
+	select {
+	case <-atIntent:
+	case <-time.After(3 * time.Second):
+		t.Fatal("discard never held durable intent")
+	}
+	// Use the original creation's legacy retry endpoint here to exercise its
+	// downstream CAS, not only the preparation route's first check.
+	go func() {
+		data, _ := json.Marshal(map[string]any{"receiptId": req.ReceiptID, "attempt": req.CreationAttempt})
+		r := httptest.NewRequest(http.MethodPost, "/api/sessions/"+preparation.Slug+"/creation/retry", bytes.NewReader(data))
+		r.Header.Set("Origin", s.config.BaseURL)
+		r.Header.Set("Content-Type", "application/json")
+		w := httptest.NewRecorder()
+		s.Handler().ServeHTTP(w, r)
+		retry <- w.Code
+	}()
+	go func() { duplicate <- executePiDiscardFixture(s, req) }()
+	close(proceed)
+	released = true
+	for name, done := range map[string]<-chan error{"first": first, "duplicate": duplicate} {
+		select {
+		case err := <-done:
+			if err != nil {
+				t.Fatal("grant incorrectly refused", name, err)
+			}
+		case <-time.After(3 * time.Second):
+			t.Fatal("discard race stuck", name)
+		}
+	}
+	select {
+	case code := <-retry:
+		if code < 400 {
+			t.Fatal("ordinary retry escaped the writer exclusion", code)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("retry race stuck")
+	}
+	assertPiDiscardCompleted(t, s, preparation, native)
+}
