+		RequestID: preparation.RequestID, ReceiptID: receipt.ReceiptID, PreparationAttempt: preparation.Attempt,
+		CreationAttempt: receipt.Attempt, Slug: preparation.Slug, Incarnation: receipt.Pi.SessionIncarnation, Epoch: preparation.Epoch,
