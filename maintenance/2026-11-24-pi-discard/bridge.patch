+func TestPiDiscardStartupResumesExactInterruptedGrant(t *testing.T) {
+	for _, point := range []string{"discard_receipt", "discard_marker_unlink"} {
+		t.Run(point, func(t *testing.T) {
+			s, preparation, receipt, native := newPiDiscardFixture(t)
+			grant := fixturePiDiscardStartupGrant(s, preparation, receipt)
+			calls := 0
+			verify := func(context.Context, PiDiscardStartupAuthority) error { calls++; return nil }
+			boot, err := openPiDiscardStartupFixture(t, s, &grant, func(step string) error {
+				if step == point {
+					return errors.New("fixture interrupted startup publication")
+				}
+				return nil
+			}, verify)
+			if boot != nil || !errors.Is(err, ErrPiDiscardStartupHeld) || calls != 1 {
+				t.Fatal("interrupted startup became ready or retried", err, calls)
+			}
+			resumed, err := openPiDiscardStartupFixture(t, s, &grant, nil, verify)
+			if err != nil || calls != 2 {
+				t.Fatal("exact armed grant did not reconcile after revalidation", err, calls)
+			}
+			defer resumed.Close()
+			assertPiDiscardCompleted(t, resumed, preparation, native)
+		})
+	}
+}
