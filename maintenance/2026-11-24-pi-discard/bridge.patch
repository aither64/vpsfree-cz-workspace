+func TestPiDiscardStartupOneShotAndReplay(t *testing.T) {
+	s, preparation, receipt, native := newPiDiscardFixture(t)
+	grant := fixturePiDiscardStartupGrant(s, preparation, receipt)
+	calls := 0
+	verify := func(context.Context, PiDiscardStartupAuthority) error { calls++; return nil }
+	without, err := openPiDiscardStartupFixture(t, s, nil, nil, verify)
+	if err != nil || calls != 0 {
+		t.Fatal("no grant attempted an operation", err, calls)
+	}
+	defer without.Close()
+	if err := requirePiDiscardAbsent(without.piDiscardDirectory(preparation.RequestID)); err != nil {
+		t.Fatal("no grant staged an audit", err)
+	}
+	boot, err := openPiDiscardStartupFixture(t, without, &grant, nil, verify)
+	if err != nil || calls != 1 {
+		t.Fatal("exact root grant did not reach the same writer once", err, calls)
+	}
+	defer boot.Close()
+	assertPiDiscardCompleted(t, boot, preparation, native)
+	audit, digest, err := boot.loadPiDiscardAudit(preparation.RequestID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Stock typed reader accepts a wholly different later owner of the slug.
+	// The armed grant replay cannot stage a new audit or retire it again.
+	replacement := receipt
+	replacement.ReceiptID = strings.Repeat("c", 64)
+	if err := boot.saveCreation(replacement); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.ReadFile(boot.creationPath(preparation.Slug))
+	if err != nil {
+		t.Fatal(err)
+	}
+	replay, err := openPiDiscardStartupFixture(t, boot, &grant, func(step string) error {
+		if strings.HasPrefix(step, "discard_") && step != "discard_cleanup_sync" {
+			t.Fatal("completed grant resumed retirement", step)
+		}
+		return nil
+	}, verify)
+	if err != nil || calls != 2 {
+		t.Fatal("exact root grant replay failed revalidation", err, calls)
+	}
+	defer replay.Close()
+	after, err := os.ReadFile(replay.creationPath(preparation.Slug))
+	if err != nil || !bytes.Equal(before, after) || native.ensures != 0 || native.creates != 0 || native.sends != 0 {
+		t.Fatal("grant replay changed the later owner or invoked effects", err)
+	}
+	got, gotDigest, err := replay.loadPiDiscardAudit(preparation.RequestID)
+	if err != nil || !grant.Target.intent().valid(got.Owner.RequestID) || gotDigest != digest || got.Incarnation != audit.Incarnation {
+		t.Fatal("grant replay changed the immutable audit", err)
+	}
+}
