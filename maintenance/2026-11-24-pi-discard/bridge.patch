+// WithPiDiscardBindingLock serializes the bridge's exact retirement against
+// binding publication. The caller holds creation/runtime exclusion and must
+// compare the expected old or retired bytes; this does not grant ownership.
+func (s BackendBindingStore) WithPiDiscardBindingLock(ctx context.Context, slug string, retire func(string) error) error {
+	if !errors.Is(RequireNoPiDiscard(s.Workspace, slug), ErrPiDiscardPending) {
+		return agentbackend.ErrBindingConflict
+	}
+	directory, err := s.publicationDirectory(slug)
+	if err != nil {
+		return err
+	}
+	lock, err := lockRuntimeContext(ctx, directory, slug, ".binding.lock", unix.LOCK_EX)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+	if !errors.Is(RequireNoPiDiscard(s.Workspace, slug), ErrPiDiscardPending) {
+		return agentbackend.ErrBindingConflict
+	}
+	return retire(filepath.Join(directory, slug+".json"))
+}
