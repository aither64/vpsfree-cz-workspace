#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'optparse'
require 'pathname'

options = {}
OptionParser.new do |opts|
  opts.on('--plan FILE') { |value| options[:plan] = value }
  opts.on('--request FILE') { |value| options[:request] = value }
  opts.on('--prepare') { options[:prepare] = true }
end.parse!
abort 'use --plan FILE --request FILE [--prepare]' unless ARGV.empty? && options[:plan] && options[:request]
plan = JSON.parse(File.binread(options[:plan], 256 * 1024 + 1))
expected = {
  'workspace' => '/home/aither/workspace/ai/vpsfree.cz', 'workspaceName' => 'vpsfree-cz',
  'slug' => '2026-10-13-workspace-coordination', 'ownerId' => '55e83d75-cb96-417a-9308-11d3caf22dcd',
  'reservationId' => 'd114323d-806c-479f-b7a4-8c1a08afb45b'
}
abort 'plan is outside the dated installation scope' unless expected.all? { |key, value| plan[key] == value }
repos = %w[dev-workspace vpsfree-dev-workspace workspace vpsfree-cz-configuration]
abort 'plan repository/target scope changed' unless plan.fetch('repositories').keys.sort == repos.sort &&
  plan['repositories'].values.all? { |value| value.keys.sort == %w[head target] && value['target'] == 'refs/heads/master' && value['head'].match?(/\A[0-9a-f]{40}\z/) }
%w[DEV_WORKSPACES_CONFIG DEV_WORKSPACES_STATE DEV_WORKSPACES_RUNTIME_DIR DEV_WORKSPACES_PROFILE DEV_WORKSPACES_NAMESPACE DEV_WORKSPACES_SYSTEM_CODEX DEV_WORKSPACE_HOST_MODE XDG_STATE_HOME].each do |key|
  abort "environment override is outside the dated route: #{key}" if ENV.key?(key)
end
%w[DEV_SESSION_SLUG DEV_SESSION_WORKSPACE DEV_WORKSPACE_NAME].zip([plan['slug'], plan['workspace'], plan['workspaceName']]).each do |key, value|
  abort "invocation identity changed: #{key}" if ENV.key?(key) && ENV[key] != value
end
abort 'wrong operator home' unless ENV['HOME'] == '/home/aither'
profile = '/home/aither/.local/state/dev-workspaces/profile'
package = File.realpath(profile)
abort 'selected package changed' unless package == plan.fetch('selectedPackage') && package.start_with?('/nix/store/')
load File.join(package, 'libexec', '.workspace-host-wrapped')
require_relative '../lib/bootstrap_merge_2026_10_13'
WorkspaceCoordination.keys!(plan, %w[schema workspace workspaceName slug ownerId reservationId selectedPackage profileToken catalogDigest repositories evidence deploymentEvidence source])
abort 'invalid plan schema' unless plan['schema'] == 1
request = WorkspaceCoordination.parse(File.binread(options.fetch(:request), WorkspaceCoordination::MAX_REQUEST + 1))
begin
  result = BootstrapMerge20261013.new.operate(plan, request, prepare: options[:prepare] == true)
  puts JSON.generate(result)
rescue WorkspaceCoordination::Error => e
  warn "error: #{e.message}"
  exit e.code
rescue DevWorkspaceHost::Error => e
  warn "error: #{e.message}"
  exit 1
end
