fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

root_run() {
  "${ROOT_SSH[@]}" "$@"
}

require_stage() {
  local expected=$1
  test -f "$CUTOVER_STATE" || fail "cutover state is missing"
  test "$(jq -er '.stage' "$CUTOVER_STATE")" = "$expected" ||
    fail "cutover stage is not $expected"
}

current_stage() {
  test -f "$CUTOVER_STATE" || fail "cutover state is missing"
  jq -er '.stage | select(type == "string" and length > 0)' "$CUTOVER_STATE"
}

state_value() {
  jq -er --arg key "$1" '.[$key] | select(type == "string" and length > 0)' \
    "$CUTOVER_STATE"
}

write_state() {
  local stage=$1 old_system=$2 new_package=$3 compatibility_package=$4
  local workspace_commit=$5 credential_inventory=$6 temporary
  temporary="$CUTOVER_STATE.tmp"
  jq -n \
    --arg stage "$stage" \
    --arg oldSystem "$old_system" \
    --arg newPackage "$new_package" \
    --arg compatibilityPackage "$compatibility_package" \
    --arg workspaceCommit "$workspace_commit" \
    --arg credentialInventory "$credential_inventory" \
    '{schema: 1, stage: $stage, oldSystem: $oldSystem,
      newPackage: $newPackage, compatibilityPackage: $compatibilityPackage,
      workspaceCommit: $workspaceCommit,
      credentialInventory: $credentialInventory}' \
    >"$temporary"
  chmod 0600 "$temporary"
  mv -T "$temporary" "$CUTOVER_STATE"
  ruby -e '
    File.open(ARGV.fetch(0), "r")(&:fsync)
    File.open(File.dirname(ARGV.fetch(0)), "r")(&:fsync)
  ' "$CUTOVER_STATE"
}

authority_inventory() {
  local directory=$1
  test -d "$directory" || return 0
  find "$directory" -maxdepth 1 -type f -name '*.json' -printf '%f\n' |
    sed 's/\.json$//' | LC_ALL=C sort
}

expected_session_inventory() {
  printf '%s\n' "${AUDITED_AUTHORITIES[@]}" | LC_ALL=C sort
}

expected_recreated_inventory() {
  printf '%s\n' "${RECREATED_SESSIONS[@]}" | LC_ALL=C sort
}

expected_active_tracking_inventory() {
  printf '%s\n' "${RECREATED_SESSIONS[@]}" "${DORMANT_ACTIVE_TRACKING[@]}" | LC_ALL=C sort
}

active_tracking_inventory() {
  ruby -e '
    Dir.glob(File.join(ARGV.fetch(0), "work", "*", "state.md")).sort.each do |path|
      content = File.binread(path)
      match = content.match(/\A---\n(?:[^\n]*\n)*?lifecycle:[ \t]*(active|complete|abandoned)[ \t]*\n(?:[^\n]*\n)*?---\n/)
      puts File.basename(File.dirname(path)) if match && match[1] == "active"
    end
  ' "$WORKSPACE_ROOT"
}

assert_exact_authorities() {
  local directory=$1
  diff -u <(expected_session_inventory) <(authority_inventory "$directory") ||
    fail "session authority inventory changed: $directory"
}

assert_no_authorities() {
  local directory=$1
  test -z "$(authority_inventory "$directory")" ||
    fail "session authorities remain: $directory"
}

assert_ready_recreated_authorities() {
  local directory=$1 authority
  diff -u <(expected_recreated_inventory) <(authority_inventory "$directory") ||
    fail "recreated session authority inventory changed: $directory"
  for authority in "$directory"/*.json; do
    jq -e '.state == "ready" and
           (.tmux_identity | type == "string" and test("^[0-9a-f]{64}$"))' \
      "$authority" >/dev/null || fail "invalid ready authority: $authority"
  done
}

assert_recreated_authority_subset() {
  local actual expected unexpected
  actual=$(mktemp)
  expected=$(mktemp)
  authority_inventory "$NEW_AUTHORITY_DIR" >"$actual"
  expected_recreated_inventory >"$expected"
  unexpected=$(comm -23 "$actual" "$expected")
  rm -f "$actual" "$expected"
  test -z "$unexpected" || fail "unexpected recreated authorities: $unexpected"
}

force_stop_audited_authorities() {
  local slug authority session_id identity recorded_slug live_identity
  for slug in "${AUDITED_AUTHORITIES[@]}"; do
    authority="$OLD_AUTHORITY_DIR/$slug.json"
    test -e "$authority" || continue
    session_id=$(jq -er '.tmux_session_id' "$authority")
    if ! tmux -S "$OLD_TMUX_SOCKET" has-session -t "$session_id" 2>/dev/null; then
      rm -f -- "$authority"
      continue
    fi
    recorded_slug=$(tmux -S "$OLD_TMUX_SOCKET" show-option -qv -t "$session_id" \
      '@vpsfree_dev_session_slug')
    test "$recorded_slug" = "$slug" || fail "tmux session slug differs: $slug"
    identity=$(jq -r '.tmux_identity // empty' "$authority")
    if test -n "$identity"; then
      live_identity=$(tmux -S "$OLD_TMUX_SOCKET" show-environment -t "$session_id" \
        VPSFREE_DEV_SESSION_TMUX_IDENTITY)
      live_identity=${live_identity#*=}
      test "$live_identity" = "$identity" || fail "tmux session identity differs: $slug"
    fi
    tmux -S "$OLD_TMUX_SOCKET" kill-session -t "$session_id"
    ! tmux -S "$OLD_TMUX_SOCKET" has-session -t "$session_id" 2>/dev/null ||
      fail "tmux session remained after forced stop: $slug"
    rm -f -- "$authority"
  done
  assert_no_authorities "$OLD_AUTHORITY_DIR"
}

assert_stoppable_authorities() {
  local slug authority session_id recorded_slug identity live_identity
  for slug in "${AUDITED_AUTHORITIES[@]}"; do
    authority="$OLD_AUTHORITY_DIR/$slug.json"
    session_id=$(jq -er '.tmux_session_id' "$authority")
    tmux -S "$OLD_TMUX_SOCKET" has-session -t "$session_id" 2>/dev/null ||
      fail "audited tmux session is absent before mutation: $slug"
    recorded_slug=$(tmux -S "$OLD_TMUX_SOCKET" show-option -qv -t "$session_id" \
      '@vpsfree_dev_session_slug')
    test "$recorded_slug" = "$slug" || fail "tmux session slug differs: $slug"
    identity=$(jq -r '.tmux_identity // empty' "$authority")
    if test -n "$identity"; then
      live_identity=$(tmux -S "$OLD_TMUX_SOCKET" show-environment -t "$session_id" \
        VPSFREE_DEV_SESSION_TMUX_IDENTITY)
      live_identity=${live_identity#*=}
      test "$live_identity" = "$identity" || fail "tmux session identity differs: $slug"
    fi
  done
}

manifest_thread() {
  ruby -ryaml -e '
    manifest = YAML.safe_load(File.read(ARGV.fetch(0)))
    value = manifest.dig("codex", "thread_id")
    abort "missing manifest thread" unless value.is_a?(String) && !value.empty?
    puts value
  ' "$1"
}

assert_no_manifest_thread() {
  ruby -ryaml -e '
    manifest = YAML.safe_load(File.read(ARGV.fetch(0)))
    abort "unexpected manifest thread" unless manifest.dig("codex", "thread_id").nil?
  ' "$1"
}

assert_tracking_lifecycle() {
  ruby -e '
    content = File.binread(ARGV.fetch(0))
    match = content.match(/\A---\n(?:[^\n]*\n)*?lifecycle:[ \t]*(active|complete|abandoned)[ \t]*\n(?:[^\n]*\n)*?---\n/)
    abort "unexpected tracking lifecycle" unless match && match[1] == ARGV.fetch(1)
  ' "$1" "$2" || fail "unexpected tracking lifecycle: $1"
}

assert_manifest_phase() {
  ruby -ryaml -e '
    manifest = YAML.safe_load(File.read(ARGV.fetch(0)))
    abort "manifest creation is not ready" unless manifest.dig("creation", "state") == "ready"
    finalized = manifest["finalized_at"]
    if ARGV.fetch(1) == "active"
      abort "active manifest is finalized" unless finalized.nil?
    else
      abort "archived manifest is not finalized" unless finalized.is_a?(String) && !finalized.empty?
    end
  ' "$1" "$2" || fail "unexpected portal manifest phase: $1"
}

assert_no_pending_lifecycle() {
  local slug=$1 suffix journal
  for suffix in start fork archive delete revive; do
    journal="$WORKSPACE_ROOT/worktrees/.locks/$slug.$suffix.json"
    test ! -e "$journal" || fail "session lifecycle is unfinished: $journal"
  done
  journal="$WORKSPACE_ROOT/worktrees/.locks/$slug.creation.json"
  if test -e "$journal"; then
    jq -e '.state == "ready"' "$journal" >/dev/null ||
      fail "session creation is unfinished: $journal"
  fi
}

assert_session_contract() {
  local slug manifest_thread_id authority_thread_id
  for slug in "${CODEX_SESSIONS[@]}"; do
    test -f "$WORKSPACE_ROOT/work/$slug/portal.yml" ||
      fail "active Codex manifest is missing: $slug"
    test ! -e "$WORKSPACE_ROOT/archive/$slug" || fail "Codex session is also archived: $slug"
    assert_tracking_lifecycle "$WORKSPACE_ROOT/work/$slug/state.md" active
    assert_manifest_phase "$WORKSPACE_ROOT/work/$slug/portal.yml" active
    assert_no_pending_lifecycle "$slug"
    manifest_thread_id=$(manifest_thread "$WORKSPACE_ROOT/work/$slug/portal.yml")
    authority_thread_id=$(jq -er '.codex_thread_id' "$OLD_AUTHORITY_DIR/$slug.json")
    test "$manifest_thread_id" = "$authority_thread_id" ||
      fail "manifest and authority thread differ: $slug"
    "$OLD_PROFILE/bin/workspace-portal" thread require-materialized \
      --thread-id "$manifest_thread_id" \
      --cwd "$WORKSPACE_ROOT/work/$slug" \
      --socket "$XDG_RUNTIME_DIR/vpsfree-workspaces/vpsfree-cz/app-server.sock"
  done

  test -f "$WORKSPACE_ROOT/work/$SHELL_ONLY_SESSION/portal.yml" ||
    fail "shell-only manifest is missing"
  assert_no_manifest_thread "$WORKSPACE_ROOT/work/$SHELL_ONLY_SESSION/portal.yml"
  assert_tracking_lifecycle "$WORKSPACE_ROOT/work/$SHELL_ONLY_SESSION/state.md" active
  assert_manifest_phase "$WORKSPACE_ROOT/work/$SHELL_ONLY_SESSION/portal.yml" active
  assert_no_pending_lifecycle "$SHELL_ONLY_SESSION"
  jq -e 'has("codex_thread_id") | not' \
    "$OLD_AUTHORITY_DIR/$SHELL_ONLY_SESSION.json" >/dev/null ||
    fail "shell-only authority unexpectedly owns a Codex thread"

  test -f "$WORKSPACE_ROOT/archive/$ARCHIVED_AUTHORITY/portal.yml" ||
    fail "archived manifest is missing"
  test ! -e "$WORKSPACE_ROOT/work/$ARCHIVED_AUTHORITY" ||
    fail "archived session also has active tracking"
  assert_no_manifest_thread "$WORKSPACE_ROOT/archive/$ARCHIVED_AUTHORITY/portal.yml"
  assert_tracking_lifecycle "$WORKSPACE_ROOT/archive/$ARCHIVED_AUTHORITY/state.md" complete
  assert_manifest_phase "$WORKSPACE_ROOT/archive/$ARCHIVED_AUTHORITY/portal.yml" archived
  assert_no_pending_lifecycle "$ARCHIVED_AUTHORITY"
  jq -e 'has("codex_thread_id") | not' \
    "$OLD_AUTHORITY_DIR/$ARCHIVED_AUTHORITY.json" >/dev/null ||
    fail "archived authority unexpectedly owns a Codex thread"

  for slug in "${DORMANT_ACTIVE_TRACKING[@]}"; do
    assert_tracking_lifecycle "$WORKSPACE_ROOT/work/$slug/state.md" active
    test ! -e "$OLD_AUTHORITY_DIR/$slug.json" ||
      fail "dormant active tracking unexpectedly has a live authority: $slug"
    if test -e "$WORKSPACE_ROOT/work/$slug/portal.yml"; then
      assert_manifest_phase "$WORKSPACE_ROOT/work/$slug/portal.yml" active
      assert_no_manifest_thread "$WORKSPACE_ROOT/work/$slug/portal.yml"
      assert_no_pending_lifecycle "$slug"
    fi
  done
  diff -u <(expected_active_tracking_inventory) <(active_tracking_inventory) ||
    fail "active tracking inventory changed"
}

assert_recreated_session_contract() {
  local slug manifest_thread_id authority_thread_id
  for slug in "${CODEX_SESSIONS[@]}"; do
    manifest_thread_id=$(manifest_thread "$WORKSPACE_ROOT/work/$slug/portal.yml")
    authority_thread_id=$(jq -er '.codex_thread_id' "$NEW_AUTHORITY_DIR/$slug.json")
    test "$manifest_thread_id" = "$authority_thread_id" ||
      fail "recreated manifest and authority thread differ: $slug"
    "$NEW_STATE_ROOT/profile/bin/workspace-portal" thread require-materialized \
      --thread-id "$manifest_thread_id" \
      --cwd "$WORKSPACE_ROOT/work/$slug" \
      --socket "$XDG_RUNTIME_DIR/dev-workspaces/vpsfree-cz/app-server.sock"
  done
  jq -e 'has("codex_thread_id") | not' \
    "$NEW_AUTHORITY_DIR/$SHELL_ONLY_SESSION.json" >/dev/null ||
    fail "recreated shell-only authority unexpectedly owns a Codex thread"
  test ! -e "$NEW_AUTHORITY_DIR/$ARCHIVED_AUTHORITY.json" ||
    fail "archived authority was recreated"
  for slug in "${DORMANT_ACTIVE_TRACKING[@]}"; do
    test ! -e "$NEW_AUTHORITY_DIR/$slug.json" ||
      fail "dormant active tracking was unexpectedly started: $slug"
  done
}

credential_inventory() {
  local direction=$1 index path digest
  local -a roots
  case $direction in
    old) roots=("${OLD_CREDENTIAL_ROOTS[@]}") ;;
    new) roots=("${NEW_CREDENTIAL_ROOTS[@]}") ;;
    *) fail "invalid credential inventory direction: $direction" ;;
  esac
  for index in "${!roots[@]}"; do
    path=${roots[$index]}
    if root_run test -e "$path"; then
      digest=$(root_run tar --sort=name --numeric-owner --format=gnu -C "$path" -cf - . | sha256sum | cut -d' ' -f1)
      printf '%s=%s\n' "$index" "$digest"
    else
      printf '%s=absent\n' "$index"
    fi
  done
}

assert_no_legacy_process_environments() {
  local pid
  while IFS= read -r pid; do
    test -r "/proc/$pid/environ" || continue
    if tr '\0' '\n' <"/proc/$pid/environ" | \
       grep -Eq '^(VPSFREE_|[^=]+=.*/(vpsfree-workspaces|vpsfree-workspace-router)(/|$))'; then
      fail "legacy workspace environment remains in process $pid"
    fi
  done < <(pgrep -u "$(id -u)" || true)
}

assert_authenticated_portal() {
  local credentials status=0
  credentials=$(mktemp "$XDG_RUNTIME_DIR/aitherdev-workspace-netrc.XXXXXX")
  chmod 0600 "$credentials"
  printf 'machine %s login aither password %s\n' \
    "$PORTAL_HOST" "$(root_run cat /var/lib/dev-workspaces/password/password)" >"$credentials"
  curl --fail --silent --show-error \
    --cacert /var/lib/dev-workspaces/public/ca.pem \
    --netrc-file "$credentials" "https://$PORTAL_HOST/" >/dev/null || status=$?
  rm -f -- "$credentials"
  return "$status"
}

cluster_inventory() {
  local directory="$WORKSPACE_ROOT/.dev-clusters/vpsadmin/clusters"
  test -d "$directory" || return 0
  find "$directory" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | LC_ALL=C sort
}

expected_cluster_inventory() {
  printf '%s\n' "${EXPECTED_CLUSTERS[@]}" | LC_ALL=C sort
}

stop_user_services() {
  systemctl --user stop workspace-router.service
  systemctl --user stop "${USER_UNITS[@]}"
  ! systemctl --user is-active --quiet workspace-router.service ||
    fail "workspace router remained active"
  local unit
  for unit in "${USER_UNITS[@]}"; do
    ! systemctl --user is-active --quiet "$unit" || fail "user unit remained active: $unit"
  done
}

router_gate_close() {
  local expected temporary
  expected=$(printf '[Unit]\nConditionPathExists=%s\n' "$ROUTER_ADMISSION_FLAG")
  test ! -e "$ROUTER_ADMISSION_FLAG" || fail "router admission flag unexpectedly exists"
  if test -e "$ROUTER_GATE_FILE"; then
    test "$(cat "$ROUTER_GATE_FILE")" = "$expected" ||
      fail "router admission gate has unexpected content"
  else
    install -d -m 0700 "$ROUTER_GATE_DIR"
    temporary="$ROUTER_GATE_FILE.tmp"
    printf '%s\n' "$expected" >"$temporary"
    chmod 0600 "$temporary"
    mv -T "$temporary" "$ROUTER_GATE_FILE"
  fi
  systemctl --user daemon-reload
  systemctl --user stop workspace-router.service
  ! systemctl --user is-active --quiet workspace-router.service ||
    fail "workspace router remained active behind the admission gate"
}

assert_router_gated() {
  test -f "$ROUTER_GATE_FILE" || fail "router admission gate is absent"
  test ! -e "$ROUTER_ADMISSION_FLAG" || fail "router admission flag unexpectedly exists"
  ! systemctl --user is-active --quiet workspace-router.service ||
    fail "workspace router is active behind the admission gate"
}

router_gate_open() {
  assert_router_gated
  rm -f -- "$ROUTER_GATE_FILE"
  rmdir -- "$ROUTER_GATE_DIR" 2>/dev/null || true
  systemctl --user daemon-reload
  systemctl --user start workspace-router.service
  systemctl --user is-active --quiet workspace-router.service ||
    fail "final router did not start"
}

assert_tmux_stopped() {
  local socket=$1
  test ! -S "$socket" || fail "tmux socket remains: $socket"
}

certificate_writer_stop() {
  root_run systemctl mask --runtime workspace-portal-certificate-renewal.timer \
    workspace-portal-certificate-renewal.service
  root_run systemctl stop workspace-portal-certificate-renewal.timer \
    workspace-portal-certificate-renewal.service
  ! systemctl is-active --quiet workspace-portal-certificate-renewal.timer ||
    fail "certificate renewal timer remained active"
  ! systemctl is-active --quiet workspace-portal-certificate-renewal.service ||
    fail "certificate renewal service remained active"
  test "$(systemctl is-enabled workspace-portal-certificate-renewal.timer)" = masked-runtime ||
    fail "certificate renewal timer is not runtime-masked"
  test "$(systemctl is-enabled workspace-portal-certificate-renewal.service)" = masked-runtime ||
    fail "certificate renewal service is not runtime-masked"
  ! pgrep -af '[w]orkspace-portal-substrate-reconcile' ||
    fail "a privileged workspace reconciler is still running"
}

certificate_writer_start() {
  root_run systemctl unmask --runtime workspace-portal-certificate-renewal.timer \
    workspace-portal-certificate-renewal.service
  root_run systemctl start workspace-portal-certificate-renewal.timer
  systemctl is-active --quiet workspace-portal-certificate-renewal.timer ||
    fail "certificate renewal timer did not start"
}

recovery_inventory() {
  (
    cd "$1"
    find . -printf 'metadata\t%p\t%y\t%m\t%U\t%G\t%s\t%T@\t%l\n' |
      sed -e 's#\t\./#\t#' -e 's/\t$/\t-/'
    find . -type f -exec sha256sum -- '{}' \; |
      sed -e 's#  \./#\t#' -e 's/^/content\t/'
  ) | LC_ALL=C sort
}

assert_recovery_inventory() {
  local directory=$1 digest
  diff -u "$RECOVERY_MANIFEST" <(recovery_inventory "$directory") ||
    fail "test recovery inventory changed: $directory"
  digest=$(recovery_inventory "$directory" | sha256sum | cut -d' ' -f1)
  test "$digest" = "$RECOVERY_DIGEST" || fail "test recovery digest changed: $digest"
}

assert_exact_clean_checkout() {
  local checkout=$1 expected=$2
  test -d "$checkout" || fail "missing checkout: $checkout"
  test "$(git -C "$checkout" rev-parse HEAD)" = "$expected" ||
    fail "checkout does not match its reviewed commit: $checkout"
  test -z "$(git -C "$checkout" status --porcelain)" || fail "dirty checkout: $checkout"
}

assert_exact_workspace_checkout() {
  local expected=$1 unexpected
  test "$(git -C "$WORKSPACE_ROOT" rev-parse HEAD)" = "$expected" ||
    fail "registered workspace is not at the reviewed commit"
  git -C "$WORKSPACE_ROOT" diff --quiet "$expected" -- . \
    ':(exclude)work/**' ':(exclude)archive/**' ':(exclude)notes/**' \
    ':(exclude)tmp/**' ':(exclude)dev-clusters/**' ':(exclude).dev-clusters/**' ||
    fail "registered workspace code differs from the reviewed commit"
  unexpected=$(git -C "$WORKSPACE_ROOT" ls-files --others --exclude-standard -- \
    . ':(exclude)work/**' ':(exclude)archive/**' ':(exclude)notes/**' \
    ':(exclude)tmp/**' ':(exclude)dev-clusters/**' \
    ':(exclude).dev-clusters/**')
  test -z "$unexpected" || fail "unreviewed workspace source exists: $unexpected"
}

prepare() {
  local reviewed_workspace_commit=$1
  local stage old_system new_package compatibility_package credential_snapshot slug current_profile
  [[ "$reviewed_workspace_commit" =~ ^[0-9a-f]{40}$ ]] ||
    fail "invalid reviewed workspace commit"
  test "$reviewed_workspace_commit" = "$(git -C "$WORKSPACE_ROOT" rev-parse "$reviewed_workspace_commit^{commit}")" ||
    fail "invalid reviewed workspace commit"
  assert_exact_workspace_checkout "$reviewed_workspace_commit"
  assert_exact_clean_checkout "$CONFIGURATION_WORKTREE" "$CONFIGURATION_COMMIT"
  assert_exact_clean_checkout "$MIGRATION_SOURCE" "$ORGANIZATION_COMMIT"
  assert_exact_clean_checkout "$COMPATIBILITY_WORKTREE" "$COMPATIBILITY_COMMIT"

  if test -e "$CUTOVER_STATE"; then
    test "$(current_stage)" = preparing || fail "cutover is not in the preparing stage"
    test "$(state_value workspaceCommit)" = "$reviewed_workspace_commit" ||
      fail "prepare retry uses a different reviewed workspace commit"
    old_system=$(state_value oldSystem)
    new_package=$(state_value newPackage)
    compatibility_package=$(state_value compatibilityPackage)
    credential_snapshot=$(state_value credentialInventory)
  else
    test "$(readlink -f "$OLD_STATE_ROOT/profile")" = "$OLD_PROFILE" ||
      fail "installed workspace profile changed since audit"

    # These are the live-state admission checks and precede every mutation.
    assert_exact_authorities "$OLD_AUTHORITY_DIR"
    "$OLD_PROFILE/bin/dev-session" validate
    assert_session_contract
    assert_stoppable_authorities
    diff -u <(expected_cluster_inventory) <(cluster_inventory) ||
      fail "development-cluster inventory changed"

    old_system=$(readlink -f /run/current-system)
    new_package=$(nix build --no-link --print-out-paths "$WORKSPACE_ROOT#default")
    compatibility_package=$(nix build --no-link --print-out-paths "$COMPATIBILITY_WORKTREE#default")
    test -x "$new_package/libexec/vpsfree-dev-workspace-migrate" ||
      fail "final package lacks the migration helper"
    credential_snapshot=$(credential_inventory old)
    write_state preparing "$old_system" "$new_package" "$compatibility_package" \
      "$reviewed_workspace_commit" "$credential_snapshot"
  fi

  router_gate_close
  certificate_writer_stop
  credential_snapshot=$(credential_inventory old)
  write_state preparing "$old_system" "$new_package" "$compatibility_package" \
    "$reviewed_workspace_commit" "$credential_snapshot"

  for slug in "${EXPECTED_CLUSTERS[@]}"; do
    if test -d "$WORKSPACE_ROOT/.dev-clusters/vpsadmin/clusters/$slug"; then
      "$OLD_PROFILE/bin/vpsadmin-devcluster" reset "$slug"
    fi
    test ! -e "$WORKSPACE_ROOT/.dev-clusters/vpsadmin/clusters/$slug" ||
      fail "development cluster remains: $slug"
  done

  force_stop_audited_authorities
  stop_user_services
  assert_router_gated
  assert_tmux_stopped "$OLD_TMUX_SOCKET"

  current_profile=$(readlink -f "$OLD_STATE_ROOT/profile")
  if test "$current_profile" = "$OLD_PROFILE"; then
    "$OLD_PROFILE/bin/workspace-host" switch --source "$COMPATIBILITY_WORKTREE"
  elif test "$current_profile" != "$compatibility_package"; then
    fail "workspace profile is neither the original nor compatibility package"
  fi
  stop_user_services
  assert_router_gated
  assert_no_authorities "$OLD_AUTHORITY_DIR"
  assert_tmux_stopped "$OLD_TMUX_SOCKET"

  if test -e "$NEW_STATE_ROOT"; then
    assert_recovery_inventory "$NEW_STATE_ROOT"
    test ! -e "$RECOVERY_BACKUP" || fail "test recovery backup target already exists"
    mv -T "$NEW_STATE_ROOT" "$RECOVERY_BACKUP"
  else
    test -d "$RECOVERY_BACKUP" || fail "test recovery tree and backup are both absent"
  fi
  assert_recovery_inventory "$RECOVERY_BACKUP"

  "$new_package/libexec/vpsfree-dev-workspace-migrate" preflight \
    --direction forward --scope user --workspace-root "$WORKSPACE_ROOT"
  root_run "$new_package/libexec/vpsfree-dev-workspace-migrate" preflight \
    --direction forward --scope host

  write_state prepared "$old_system" "$new_package" "$compatibility_package" \
    "$reviewed_workspace_commit" "$credential_snapshot"
  printf 'prepared cutover; browser admission remains closed\n'
}

forward() {
  local stage old_system new_package compatibility_package workspace_commit credential_snapshot
  local current_profile slug
  local tmux_environment pane_pid pane_environment
  stage=$(current_stage)
  test "$stage" = prepared || test "$stage" = forwarding ||
    fail "cutover is not in the prepared or forwarding stage"
  old_system=$(state_value oldSystem)
  new_package=$(state_value newPackage)
  compatibility_package=$(state_value compatibilityPackage)
  workspace_commit=$(state_value workspaceCommit)
  credential_snapshot=$(state_value credentialInventory)
  assert_exact_workspace_checkout "$workspace_commit"
  assert_exact_clean_checkout "$CONFIGURATION_WORKTREE" "$CONFIGURATION_COMMIT"
  current_profile=$(readlink -f "$OLD_STATE_ROOT/profile" 2>/dev/null || \
    readlink -f "$NEW_STATE_ROOT/profile")
  test "$current_profile" = "$compatibility_package" || test "$current_profile" = "$new_package" ||
    fail "workspace profile is neither compatibility nor final package"
  if test "$stage" = prepared; then
    test "$(readlink -f /run/current-system)" = "$old_system" ||
      fail "system generation changed after preparation"
  fi
  assert_no_authorities "$OLD_AUTHORITY_DIR"
  assert_recreated_authority_subset
  assert_tmux_stopped "$OLD_TMUX_SOCKET"
  if test -z "$(authority_inventory "$NEW_AUTHORITY_DIR")"; then
    assert_tmux_stopped "$NEW_TMUX_SOCKET"
  fi
  stop_user_services
  router_gate_close
  certificate_writer_stop

  if test "$stage" = prepared; then
    "$new_package/libexec/vpsfree-dev-workspace-migrate" preflight \
      --direction forward --scope user --workspace-root "$WORKSPACE_ROOT"
    root_run "$new_package/libexec/vpsfree-dev-workspace-migrate" preflight \
      --direction forward --scope host
    write_state forwarding "$old_system" "$new_package" "$compatibility_package" \
      "$workspace_commit" "$credential_snapshot"
  fi
  "$new_package/libexec/vpsfree-dev-workspace-migrate" forward \
    --scope user --workspace-root "$WORKSPACE_ROOT" --yes
  root_run "$new_package/libexec/vpsfree-dev-workspace-migrate" forward --scope host --yes

  (
    cd "$CONFIGURATION_WORKTREE"
    nix develop -c confctl build -y "$CONFIGURATION_MACHINE"
    nix develop -c confctl deploy -y "$CONFIGURATION_MACHINE" switch
  )

  test "$(credential_inventory new)" = "$credential_snapshot" ||
    fail "credential, CA or TLS state changed during migration and activation"

  DEV_WORKSPACES_NAMESPACE=dev-workspaces \
  DEV_WORKSPACES_ROUTER_SOCKET="$NEW_ROUTER_SOCKET" \
    "$NEW_STATE_ROOT/profile/bin/workspace-host" switch --source "$WORKSPACE_ROOT"
  test "$(readlink -f "$NEW_STATE_ROOT/profile")" = "$new_package" ||
    fail "final workspace package was not selected"
  assert_router_gated

  for slug in "${CODEX_SESSIONS[@]}"; do
    if test ! -e "$NEW_AUTHORITY_DIR/$slug.json"; then
      "$NEW_STATE_ROOT/profile/bin/dev-session" start "$slug" --as-is --no-attach
    fi
  done
  if test ! -e "$NEW_AUTHORITY_DIR/$SHELL_ONLY_SESSION.json"; then
    "$NEW_STATE_ROOT/profile/bin/dev-session" start "$SHELL_ONLY_SESSION" \
      --as-is --no-attach --no-codex
  fi
  assert_ready_recreated_authorities "$NEW_AUTHORITY_DIR"
  assert_recreated_session_contract
  test -S "$NEW_TMUX_SOCKET" || fail "final tmux socket is absent"
  tmux_environment=$(tmux -S "$NEW_TMUX_SOCKET" show-environment -g)
  if grep -q '^VPSFREE_' <<<"$tmux_environment"; then
    fail "legacy variables remain in the tmux global environment"
  fi
  while IFS= read -r pane_pid; do
    test -r "/proc/$pane_pid/environ" || fail "cannot inspect tmux pane $pane_pid"
    pane_environment=$(tr '\0' '\n' <"/proc/$pane_pid/environ")
    if grep -q '^VPSFREE_' <<<"$pane_environment"; then
      fail "legacy variables remain in tmux pane $pane_pid"
    fi
  done < <(tmux -S "$NEW_TMUX_SOCKET" list-panes -a -F '#{pane_pid}')
  assert_no_legacy_process_environments
  write_state forwarded "$old_system" "$new_package" "$compatibility_package" \
    "$workspace_commit" "$credential_snapshot"
  printf 'forward cutover complete; browser admission and certificate renewal remain closed\n'
}

accept() {
  require_stage forwarded
  local credential_snapshot
  credential_snapshot=$(state_value credentialInventory)
  assert_exact_workspace_checkout "$(state_value workspaceCommit)"
  test "$(readlink -f "$NEW_STATE_ROOT/profile")" = "$(state_value newPackage)" ||
    fail "final package is not selected"
  assert_router_gated
  assert_ready_recreated_authorities "$NEW_AUTHORITY_DIR"
  assert_recreated_session_contract
  test -S "$NEW_TMUX_SOCKET" || fail "final tmux socket is absent"
  test ! -e "$OLD_ROUTER_SOCKET" || fail "legacy router socket still exists"
  test ! -e "$NEW_ROUTER_SOCKET" || fail "final router socket exists before admission"
  systemctl --user is-active --quiet workspace-portal@vpsfree-cz.service ||
    fail "final portal is not active"
  systemctl --user is-active --quiet workspace-codex@vpsfree-cz.service ||
    fail "final Codex App Server is not active"
  "$NEW_STATE_ROOT/profile/bin/dev-session" validate
  test -x "$NEW_STATE_ROOT/profile/bin/kb-page" || fail "kb-page is unavailable"
  test -x "$NEW_STATE_ROOT/profile/bin/vpsadmin-devcluster" ||
    fail "vpsAdmin provider is unavailable"
  test -x "$NEW_STATE_ROOT/profile/bin/vpsadminos-devcluster" ||
    fail "vpsAdminOS provider is unavailable"
  ! pgrep -af '[v]psfree-workspaces|[v]psfree-workspace-router' ||
    fail "a legacy workspace process is still running"
  assert_no_legacy_process_environments
  test "$(credential_inventory new)" = "$credential_snapshot" ||
    fail "credential, CA or TLS state changed before admission"

  router_gate_open
  test -S "$NEW_ROUTER_SOCKET" || {
    router_gate_close
    fail "final router socket is absent"
  }
  if ! openssl s_client -connect "$PORTAL_HOST:443" -servername "$PORTAL_HOST" \
       </dev/null 2>/dev/null | openssl x509 -noout -checkend 0 -ext subjectAltName | \
       grep -F "DNS:$PORTAL_HOST" >/dev/null; then
    router_gate_close
    fail "portal TLS identity check failed"
  fi
  if ! assert_authenticated_portal; then
    router_gate_close
    fail "authenticated portal check failed"
  fi
  certificate_writer_start
  write_state accepted "$(state_value oldSystem)" "$(state_value newPackage)" \
    "$(state_value compatibilityPackage)" "$(state_value workspaceCommit)" \
    "$credential_snapshot"
  printf 'accepted cutover\n'
}

usage() {
  printf 'usage: %s prepare REVIEWED_WORKSPACE_COMMIT | forward | accept\n' "$0" >&2
  exit 2
}

test "$#" -ge 1 || usage
case $1 in
  prepare)
    test "$#" = 2 || usage
    prepare "$2"
    ;;
  forward)
    test "$#" = 1 || usage
    forward
    ;;
  accept)
    test "$#" = 1 || usage
    accept
    ;;
  *) usage ;;
esac
