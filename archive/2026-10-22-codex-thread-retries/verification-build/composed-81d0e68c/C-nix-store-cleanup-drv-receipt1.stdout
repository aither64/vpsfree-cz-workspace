place-with \"vpush_type_size(pointed_type(&vtop[-1].type), &align); if (!(vtop[-1].type.t & VT_UNSIGNED)) gen_cast_s(VT_PTRDIFF_T);\"\n"},"inputs":{"drvs":{"d1simrxi41d15h88m043y00yd400fpd4-cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"tinycc-unstable-2025-12-03-source-builder","outputs":{"out":{"path":"630c9i2r20vxsscii93gj5mg7qc8vq3p-tinycc-unstable-2025-12-03-source-builder"}},"system":"x86_64-linux","version":4},"5qdc1kr8ljllm244bh0jy3bvmz462nv8-gnused-mes-get-version-4.0.9.drv":{"args":["-e","/nix/store/9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh"],"builder":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","env":{"PATH":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin:/nix/store/wb7pvclab1aaa7myi0jafbjc60d5yij5-bootstrap-coreutils-5.0/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","SHELL":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","buildCommand":"/nix/store/iqb819a47w7l0wls0sz47bcfgs0k9a1r-gnused-mes-4.0.9/bin/sed --version\nmkdir ${out}\n","builder":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","name":"gnused-mes-get-version-4.0.9","out":"/nix/store/8yq4waiy3jjaiq2p5mxvkpvrh39brfpc-gnused-mes-get-version-4.0.9","passAsFile":"buildCommand","system":"x86_64-linux"},"inputs":{"drvs":{"54jdq8vp944qn49b18harrbjw34dlxcp-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"9ms5jx08n6hdg7ji8fxln4lsfbzd92fa-gnused-mes-4.0.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"d9hngw468h7b7fpcyx284kqwdgcn3gzy-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},