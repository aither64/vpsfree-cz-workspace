wn-linux-gnu \\\n  --syslibdir=$out/lib \\\n  --enable-wrapper\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install\nsed -i 's|/bin/sh|/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash|' $out/bin/*\nln -s ../lib/libc.so $out/bin/ldd\nln -s $(ls -d /nix/store/jc3w03rwdbh577bkqb2drrwj6i9wvmv8-linux-headers-6.5.6/include/* | grep -v scsi\\$) $out/include/\n\n# Strip\n# Ignore failures, because strip may fail on non-elf files.\nfind $out/{bin,lib} -type f -exec strip --strip-debug {} + || true\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"musl-1.2.6","out":"/nix/store/dm63csbh1cvkv5hbskj5mlfpyzw49hcy-musl-1.2.6","passAsFile":"buildCommand","pname":"musl","system":"x86_64-linux","version":"1.2.6"},"inputs":{"drvs":{"1s96sa6kxf55hkdc362fl3xiy9mj0bjf-linux-headers-6.5.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"59pgig863abfc3p6lmz20vh8gjf2nsv1-musl-1.2.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b0xnqkbv7qnbbbc7zhqwahygjf7mc2i-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gsx86gz3hgynhcx7cxsif30zwq0qg80-gcc-15.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"bv4a5fw05q4ysq24wy0z06bd5jysq1p2-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"jm8c5a9ysfm3fckryllnl6pd3nm1hd17-bootstrap-coreutils-musl-9.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"l6a6rj0gy31gp6k7k80qzn4ni0yvyzgh-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"pshx4r5vypzz5cjy5ikscgjyzhv2s99x-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"s2g0la1392ys0bp34d0m38kmlzwi30v1-binutils-2.46.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a9pds57ms69gfi2ya-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"v8jl1cziqai2qqgn0axr9cv3masm5nb5-bash-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"xlhf3ibq6r6qy2myin330ay7qscfzi1g-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["70acbfgbz5cxsx4sqzcnj8qaqhb4i9ay-bash-builder.sh"]},"name":"musl-1.2.6","outputs":{"out":{"path":"dm63csbh1cvkv5hbskj5mlfpyzw49hcy-musl-1.2.6"}},"system":"x86_64-linux","version":4},"fz6vky5jh09qakfdzx2ygsfasldr6p0d-tinycc-bootstrappable-unstable-2024-07-07-source-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"tinycc-bootstrappable-unstable-2024-07-07-source-builder","out":"/nix/store/wh639gn1kfnxz9gz41jhcyh12gscvzjs-tinycc-bootstrappable-unstable-2024-07-07-source-builder","passAsFile":"text","system":"x86_64-linux","text":"ungz --file /nix/store/2kx2q1ph63s63dlq0g31sa7wk83w7m0z-tinycc-ea3900f6d5e71776c5cfabcabee317652e3a19ee.tar.gz --output tinycc.tar\nmkdir -p ${out}\ncd ${out}\nuntar --file ${NIX_BUILD_TOP}/tinycc.tar\n\n# Patch\ncd tinycc-ea3900f6d5e71776c5cfabcabee317652e3a19ee\n\ncp /nix/store/h5x1k0lv3jlh1ir8ry23lm59hizjx01z-mes-libc-0.27.1/lib/libtcc1.c lib/libtcc1.c\n\n# Static link by default\nreplace --file libtcc.c --output libtcc.c --match-on \"s->ms_extensions = 1;\" --replace-with \"s->ms_extensions = 1; s->static_link = 1;\"\n\n# TODO: may not need following patches for mes 0.28.\n# Or maybe we don't need tinycc-bootstrappable for mes 0.28?\n\n# mes-libc depends on max_align_t in stddef.h, which is not provided by tinycc-boot\nreplace --file include/stddef.h --output include/stddef.h --match-on \"void *alloca\" --replace-with \"\n  typedef union { long double ld; long long ll; } max_align_t;\n  void *alloca\n\"\n# VLA is broken in mescc 0.27.1. alloca is not available either. Let's just use malloc and leak on x86_64.\nreplace --file x86_64-gen.c --output x86_64-gen.c --match-on \"char _onstack[nb_args], *onstack = _onstack;\" --replace-with \"char *onstack = tcc_malloc(nb_args);\"\n\n# Abort is not provided by mescc\nreplace --file x86_64-gen.c --output x86_64-gen.c --match-on \"abort();\" --replace-with \"/* abort(); */\"\n\n# Work around bug in mescc.\nreplace --file x86_64-gen.c --output x86_64-gen.c --match-on \"g(vtop->c.i & (ll ? 63 : 31));\" --replace-with \"if (ll) g(vtop->c.i & 63); else g(vtop->c.i & 31);\"\n\n# Normally tinycc only performs relocations on the PLT when creating a dynamically-linked executable.\n# This is fine for most targets because a PLT is not generated. But on x86_64 we do generate a PLT and hence\n# we must assure plt->got references are appropriately relocated.\n# This patch is applied even if we aren't targeting x86_64. Because there's no PLT outside x86_64, it's basically a no-op.\nreplace --file tccelf.c --output tccelf.c --match-on \"fill_got(s1);\" --replace-with \"\n{\n  fill_got(s1);\n  relocate_plt(s1);\n}\n\"\n"},"inputs":{"drvs":{"bll3p7icr7ylyxprj5n60j2r8bkf5qa3-mes-libc-0.27.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"h699vzb1lagddixp8liilf9kihibax6x-tinycc-ea3900f6d5e71776c5cfabcabee317652e3a19ee.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"tinycc-bootstrappable-unstable-2024-07-07-source-builder","outputs":{"out":{"path":"wh639gn1kfnxz9gz41jhcyh12gscvzjs-tinycc-bootstrappable-unstable-2024-07-07-source-builder"}},"system":"x86_64-linux","version":4},"fz7m1s1j4v0gkiggw7s80c9yq0rqgj10-libc.a-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/sto