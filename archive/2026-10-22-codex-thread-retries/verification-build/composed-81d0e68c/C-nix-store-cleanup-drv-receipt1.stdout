lex_remove_wchar.patch\n\n\n# Build yacc\ncd yacc\nmake -f Makefile.mk \\\n  CC=\"tcc -B /nix/store/rayh0cq2ik1xyw2hclrkdn7c67lppg2r-tinycc-mes-libs-unstable-2025-12-03/lib\" \\\n  AR=\"tcc -ar\" \\\n  CFLAGS=\"-DMAXPATHLEN=4096 -DEILSEQ=84 -DMB_LEN_MAX=100\" \\\n  LDFLAGS=\"-lgetopt\" \\\n  RANLIB=true \\\n  LIBDIR=${out}/lib\n\n# Install yacc\ninstall -D yacc ${out}/bin/yacc\ninstall -Dm 444 liby.a ${out}/lib/liby.a\ninstall -Dm 444 yaccpar ${out}/lib/yaccpar\n\n# Make yacc available to lex\nPATH=\"${out}/bin:${PATH}\"\n\n# Build lex\ncd ../lex\nmake -f Makefile.mk \\\n  CC=\"tcc -B /nix/store/rayh0cq2ik1xyw2hclrkdn7c67lppg2r-tinycc-mes-libs-unstable-2025-12-03/lib\" \\\n  AR=\"tcc -ar\" \\\n  CFLAGS=\"-DEILSEQ=84 -DMB_LEN_MAX=100\" \\\n  LDFLAGS=\"-lgetopt\" \\\n  RANLIB=true \\\n  LIBDIR=${out}/lib\n\n# Install lex\ninstall -D lex ${out}/bin/lex\ninstall -Dm 444 ncform ${out}/lib/lex/ncform\ninstall -Dm 444 nceucform ${out}/lib/lex/nceucform\ninstall -Dm 444 nrform ${out}/lib/lex/nrform\ninstall -Dm 444 libl.a ${out}/lib/libl.a\n"},"inputs":{"drvs":{"0ibwnm5f9q4r7j2d6v3239wgk59yn0xx-heirloom-devtools-070527.tar.bz2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6c9czp98fd8gahfd13lkqhpq30ygckqm-lex_remove_wchar.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"m7qhh4k03ymh4myrj8nnanzgr2pcx5pp-yacc_remove_wchar.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"heirloom-devtools-070527-builder","outputs":{"out":{"path":"wn8dww255jjh5f1ldn9bgv08306zmzwi-heirloom-devtools-070527-builder"}},"system":"x86_64-linux","version":4},"bvzg0d622kybqjixak41y409cmwi6chp-attr-2.6.0.tar.gz.drv":{"args"