x/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/lib\"\n\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-native-system-header-dir=/include \\\n  --with-sysroot=/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6 \\\n  --enable-languages=c,c++ \\\n  --enable-checking=release \\\n  --disable-bootstrap \\\n  --disable-dependency-tracking \\\n  --disable-libsanitizer \\\n  --disable-libssp \\\n  --disable-libgomp \\\n  --disable-libquadmath \\\n  --disable-libitm \\\n  --disable-libvtv \\\n  --disable-libatomic \\\n  --disable-libstdcxx-pch \\\n  --disable-lto \\\n  --disable-multilib \\\n  --disable-nls \\\n  --disable-plugin\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n\n# libstdc++ gdb pretty-printers + man pages are unused downstream.\nrm -rf $out/share/gcc-*/python $out/share/man $out/share/info\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"gcc-15.3.0","out":"/nix/store/7syvsjbzhbdqhyj5b0ww10aa065563q2-gcc-15.3.0","passAsFile":"buildCommand","pname":"gcc","system":"x86_64-linux","version":"15.3.0"},"inputs":{"drvs":{"0q1fkyw9jc9fafyswh9gkv48wph52yzy-isl-0.24.tar.bz2.drv":{"dynamicOutputs":{},"outputs":["out"]},"1hgh3ynq1lsicaxr0r5pdbvkbbhb0vrr-gmp-6.3.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"2qaw4ssg53d563r5r3j5awpzf3qazpim-gcc-10.4.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"3298jfza8zv78425rrpr80xxcnnrbgr9-bzip2-1.0.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"3zhi7fn92ym1ds0n3yybmjyjvksypi39-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b0xnqkbv7qnbbbc7zhqwahygjf7mc2i-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"7phzalh1qn4zf6shvf2lna0c44a9h3b3-gcc-15.3.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gwpvw0ssr7xmfzvy97c6f493fhc2f7r-diffutils-3.8.drv"