gs":"","name":"gnum4-1.4.21","nativeBuildInputs":"","out":"/nix/store/kph9fi6qr2mjz98blzb4rzzzsfgvf4c8-gnum4-1.4.21","outputs":"out","patches":"","pname":"gnum4","postPatch":"substituteInPlace ./build-aux/config.guess --replace-fail /usr/bin/uname uname\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/yz0slq7s5s7x48xbnf3vkbfmwakqdz09-m4-1.4.21.tar.bz2","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"1.4.21"},"inputs":{"drvs":{"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"fsv057ds790hg118fr3f8y92w1878pqg-m4-1.4.21.tar.bz2.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"gnum4-1.4.21","outputs":{"out":{"path":"kph9fi6qr2mjz98blzb4rzzzsfgvf4c8-gnum4-1.4.21"}},"system":"x86_64-linux","version":4},"wsisnqqva71ba5k4x8dipsggdvcjb07x-xgcc-15.3.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash","env":{"checksum":"/nix/store/rmm33mq7jki9qj2fir9zz83hlmh74945-xgcc-15.3.0-checksum","info":"/nix/store/8g9wafcmmgi20g1zs60bab8slmqlg1n8-xgcc-15.3.0-info","lib":"/nix/store/ycpq9jikv510nsgv98cm6n1i7mr9lrjp-xgcc-15.3.0-lib","libgcc":"/nix/store/l1n6wi2lyzglvgzbwzw9n9w2pzkcj41i-xgcc-15.3.0-libgcc","man":"/nix/store/0lh1ymixj1b3cgrd92bqn5mkx8jmmz4p-xgcc-15.3.0-man","out":"/nix/store/7r693grdji6isxcvsfj7cq67i077451r-xgcc-15.3.0"},"inputs":{"drvs":{"15xi0li9a8gqhc23gjv98dwmjz03b8gr-libxcrypt-4.5.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"2jnr3bxzn3pbxnr63d46cypw6l9lsfzk-which-2.23.drv":{"dynamicOutputs":{},"outputs":["out"]},"2vp90ljr3dyk45rjyqaidqj3a69