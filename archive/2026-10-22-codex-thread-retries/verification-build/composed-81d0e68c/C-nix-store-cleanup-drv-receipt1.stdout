eParallelBuilding":"1","enableParallelChecking":"","enableParallelInstalling":"1","gettextNeedsLdflags":"","info":"/nix/store/br964py3blvcc3rhjs5vavssnga5piqx-gettext-1.0-info","man":"/nix/store/qd3ngfvkxpy5jr4zz2jc6i7rg61phwb3-gettext-1.0-man","mesonFlags":"","name":"gettext-1.0","nativeBuildInputs":"/nix/store/n0cfs2mffganfm6v2gl7fzz5cx21yb2q-update-autotools-gnu-config-scripts-hook","out":"/nix/store/35ms57dszp6rfmnqrlxlh3nmm26kc1jx-gettext-1.0","outputs":"out man doc info","patches":"/nix/store/p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff /nix/store/yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch","pname":"gettext","postPatch":"# Older versions of gettext come with a copy of `extern-inline.m4` that is not compatible with clang 18.\n# When a project uses gettext + autoreconfPhase, autoreconfPhase will invoke `autopoint -f`, which will\n# replace whatever (probably compatible) version of `extern-inline.m4` with one that probalby won’t work\n# because `autopoint` will copy the autoconf macros from the project’s required version of gettext.\n# Fixing this requires replacing all the older copies of the problematic file with a new one.\n#\n# This is ugly, but it avoids requiring workarounds in every package using gettext and autoreconfPhase.\ndeclare -a oldFiles=($(tar tf gettext-tools/autotools/archive.dir.tar | grep '^gettext-0\\.[19].*/extern-inline.m4'))\noldFilesDir=$(mktemp -d)\nfor oldFile in \"${oldFiles[@]}\"; do\n  mkdir -p \"$oldFilesDir/$(dirname \"$oldFile\")\"\n  cp -a gettext-tools/gnulib-m4/extern-inline.m4 \"$oldFilesDir/$oldFile\"\ndone\ntar uf gettext-tools/autotools/archive.dir.tar --owner=0 --group=0 --numeric-owner -C \"$oldFilesDir\" \"${oldFiles[@]}\"\n\nsubstituteAllInPlace gettext-runtime/src/gettext.sh.in\nsubstituteInPlace gettext-tools/projects/KDE/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/projects/GNOME/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/src/project-id --replace \"/bin/pwd\" pwd\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHooks":"/nix/store/v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash /nix/store/ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","src":"/nix/store/n4lwy41bnpq1fsqsrf5fac3m7vmhk6sr-gettext-1.0.tar.gz","stdenv":"/nix/store/93mabyq3gv1mbg2jhfm1wvrby3222kbd-bootstrap-stage1-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"1.0"},"inputs":{"drvs":{"jack8zs70j98mqsfd8bwljrvx8jj4j6m-bootstrap-stage1-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"mwn6l5wyvhk2dzddbvd4jb0x3cqlgl8h-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["dev"]},"rrjsnqynybwh1dqi5jw0jxcyxj7rk82c-update-autotools-gnu-config-scripts-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"zdbga6f8g5jysvhngmnjlwmj674bzds2-gettext-1.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"zv2kqb8hbz2bhvsikii3cxh49gdsy1l9-bash-static-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash","yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch"]},"name":"gettext-1.0","outputs":{"doc":{"path":"hyssnqwwabr5dajjfj3z94g7ybhpqb8a-gettext-1.0-doc"},"info":{"path":"br964py3blvcc3rhjs5vavssnga5piqx-gettext-1.0-info"},"man":{"path":"qd3ngfvkxpy5jr4zz2jc6i7rg61phwb3-gettext-1.0-man"},"out":{"path":"35ms57dszp6rfmnqrlxlh3nmm26kc1jx-gettext-1.0"}},"system":"x86_64-linux","version":4},"61xx94zmcm2pypfk8zjhfarkjly0vv05-bash-5.3p9.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash","env":{"NIX_CFLAGS_COMPILE":"-DSYS_BASHRC=\"/etc/bashrc