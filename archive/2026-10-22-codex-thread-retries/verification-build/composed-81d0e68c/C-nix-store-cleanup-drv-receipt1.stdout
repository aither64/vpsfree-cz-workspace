=':' -DSCCS_GET=\\\"get\\\" -DSTDC_HEADERS -Dsig_atomic_t=int -Dvfork=fork\"\nCC -c src/ar.c\nCC -c src/arscan.c\nCC -c src/commands.c\nCC -c src/default.c\nCC -c src/dir.c\nCC -c src/expand.c\nCC -c src/file.c\nCC -c src/function.c\nCC -c src/getopt.c\nCC -c src/getopt1.c\nCC -c src/guile.c\nCC -c src/hash.c\nCC -c src/implicit.c\nCC -c src/job.c\nCC -c src/load.c\nCC -c src/loadapi.c\nCC -c src/main.c\nCC -c src/misc.c\nCC -c src/output.c\nCC -c src/read.c\nCC -c src/remake.c\nCC -c src/rule.c\nCC -c src/shuffle.c\nCC -c src/signame.c\nCC -c src/strcache.c\nCC -c src/variable.c\nCC -c src/version.c\nCC -c src/vpath.c\nCC -c lib/fnmatch.c\nCC -c lib/glob.c\nCC -c src/remote-stub.c\nCC -c src/posixos.c\n\n# Link\nCC -o make ar.o arscan.o commands.o default.o dir.o expand.o file.o function.o getopt.o getopt1.o guile.o hash.o implicit.o job.o load.o loadapi.o main.o misc.o output.o read.o remake.o rule.o shuffle.o signame.o strcache.o variable.o version.o vpath.o fnmatch.o glob.o remote-stub.o posixos.o\n\n# Check\n./make --version\n\n# Install\nmkdir -p ${out}/bin\ncp ./make ${out}/bin\nchmod 555 ${out}/bin/make\n"},"inputs":{"drvs":{"whkczx14wnzmkchfys92zgas16rnzqw9-make-4.4.1.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"xi8dy016hq7842iplkgfdmzribiy8a3m-tinycc-bootstrappable-libs-unstable-2024-07-07.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["2k52bklbjhhq47dn35gm833vlh06fgfn-0001-No-impure-bin-sh.patch","6cc64ayl3fd2nc28ffw47cqsqi2bg1sn-0002-remove-impure-dirs.patch","9bsy65vc7cqbphmsvkph5rpcsqly30kj-0003-tinycc-support.patch","m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"gnumake-4.4.1-builder","outputs":{"out":{"path":"qdycs2z57maflbgk9fm4y118rxva132a-gnumake-4.4.1-builder"}},"system":"x86_64-linux","version":4},"20i1igy2hxwh5i5nrakzj41c