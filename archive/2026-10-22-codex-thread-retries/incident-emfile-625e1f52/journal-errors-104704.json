{
  "query": [
    "journalctl",
    "--user",
    "--no-pager",
    "-o",
    "json",
    "--since",
    "2026-10-24 09:45:00 UTC",
    "--until",
    "2026-10-24 10:46:59 UTC",
    "-n",
    "300",
    "-g",
    "(?i)(too many open files|EMFILE|ENFILE|625e1f52-0a41-4127-80c4-bc058fdbfa45|failed to (start|spawn|exec)|failed starting|start.*outcome unknown)",
    "-u",
    "workspace-portal@vpsfree-cz.service",
    "-u",
    "workspace-codex@vpsfree-cz.service",
    "-u",
    "workspace-codex-provider@vpsfree-cz.service",
    "-u",
    "workspace-coordinator.service"
  ],
  "exit": 0,
  "stderr": "",
  "matchedRecords": 0,
  "cap": 300,
  "atCap": false,
  "redaction": "Only fixed error phrases/markers and timestamp/PID/unit retained. No raw messages, prompts, histories or file paths.",
  "records": []
}
