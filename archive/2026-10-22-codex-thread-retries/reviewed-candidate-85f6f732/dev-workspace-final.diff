+	now = time.UnixMilli(deadline)
+	wait("actual automatic continuation", func() bool {
+		_ = controller.Step(ctx, scope)
+		s, err := controller.Store.Load(scope)
+		return err == nil && s.Pending != nil && s.Pending.ResultTurn != ""
+	})
+	accepted, _ := controller.Store.Load(scope)
