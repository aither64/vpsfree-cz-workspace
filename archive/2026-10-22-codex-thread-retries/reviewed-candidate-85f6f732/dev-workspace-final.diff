+package turnretry
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/aither64/codex-web/codex"
+)
+
+type fakeBackend struct {
+	o                Observation
+	boundary         string
+	hold             bool
+	sends            int
+	accepted         string
+	unknown          bool
+	never            bool
+	observed         int
+	duringEnrollment bool
+}
+
+func (f *fakeBackend) Observe(context.Context, Scope) (Observation, error) {
+	f.observed++
+	if f.duringEnrollment && f.observed == 2 {
+		return Observation{"initial", "failed", "serverOverloaded"}, nil
+	}
+	return f.o, nil
+}
+func (f *fakeBackend) Boundary(context.Context, Scope) (string, error) { return f.boundary, nil }
+func (f *fakeBackend) Prove(_ context.Context, _ Scope, s *State, turn string) error {
+	s.AddSnapshot(proof(turn))
+	return nil
+}
+func (f *fakeBackend) Check(context.Context, Scope, Snapshot) error {
+	if f.hold {
+		return errors.New("execution held")
+	}
+	return nil
+}
+func (f *fakeBackend) Reconcile(context.Context, Scope, Pending) (codex.SendReceipt, bool, error) {
+	if f.accepted != "" {
+		return codex.SendReceipt{TurnID: f.accepted}, true, nil
+	}
+	if f.unknown {
+		return codex.SendReceipt{}, false, &codex.UnknownSendOutcomeError{Err: errors.New("lost response")}
+	}
+	return codex.SendReceipt{}, false, nil
+}
+func (f *fakeBackend) Continue(context.Context, Scope, Pending) (codex.SendReceipt, error) {
+	f.sends++
+	if f.unknown {
+		return codex.SendReceipt{}, &codex.UnknownSendOutcomeError{Err: errors.New("lost response")}
+	}
+	f.accepted = "continued"
+	return codex.SendReceipt{TurnID: f.accepted}, nil
+}
+func (f *fakeBackend) NeverSubmitted(context.Context, Scope, Pending) (bool, error) {
+	return f.never, nil
+}
+
+func controllerFixture(t *testing.T) (Controller, *fakeBackend, *time.Time) {
+	t.Helper()
+	now := time.Unix(1000, 0)
+	backend := &fakeBackend{boundary: "incarnation", never: true}
+	c := Controller{Store: Store{Root: t.TempDir(), Workspace: "/workspace"}, Backend: backend, Clock: func() time.Time { return now }}
+	return c, backend, &now
+}
+
+func TestControllerRestartReconcilesAcceptedBeforeNewerFailureAndCancellation(t *testing.T) {
+	c, b, now := controllerFixture(t)
+	scope := fixtureScope()
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	b.o = Observation{"failed", "failed", "cyberPolicy"}
+	b.unknown = true
+	if err := c.Step(context.Background(), scope); err == nil {
+		t.Fatal("unknown outcome hidden")
+	}
+	s, _ := c.Store.Load(scope)
+	if !s.Uncertain() || s.Attempt != 1 || len(s.Cyber) != 1 {
+		t.Fatalf("lost uncertain reservation: %+v", s)
+	}
+	id := s.Pending.ID
+	tx, _ := c.Store.Lock(context.Background(), scope)
+	tx.State.Cancel("manual_input")
+	if err := tx.Save(); err != nil {
+		t.Fatal(err)
+	}
+	tx.Close()
+	b.o = Observation{"newer", "failed", "cyberPolicy"}
+	*now = now.Add(time.Second)
+	if err := c.Step(context.Background(), scope); err == nil {
+		t.Fatal("unknown outcome accepted")
+	}
+	if b.sends != 1 {
+		t.Fatal("uncertain resend")
+	}
+	b.accepted = "continued"
+	b.unknown = false
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	s, _ = c.Store.Load(scope)
+	if s.Phase != "cancelled" || s.Pending.ID != id || s.Pending.ResultTurn != "continued" || b.sends != 1 {
+		t.Fatalf("receipt/cancel lost: %+v", s)
+	}
+}
+
+func TestControllerColdHoldDuplicatePollAndOverdueCapacity(t *testing.T) {
+	c, b, now := controllerFixture(t)
+	scope := fixtureScope()
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	b.o = Observation{"failed", "failed", "serverOverloaded"}
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	s, _ := c.Store.Load(scope)
+	id, deadline := s.Pending.ID, s.DeadlineMS
+	*now = now.Add(time.Hour)
+	b.hold = true
+	if err := c.Step(context.Background(), scope); err == nil {
+		t.Fatal("cold hold ignored")
+	}
+	if b.sends != 0 {
+		t.Fatal("held send")
+	}
+	s, _ = c.Store.Load(scope)
+	if s.Pending.ID != id || s.DeadlineMS != deadline {
+		t.Fatal("held schedule changed")
+	}
+	b.hold = false
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	if b.sends != 1 {
+		t.Fatal("overdue burst")
+	}
+	b.o = Observation{"continued", "inProgress", ""}
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	if b.sends != 1 {
+		t.Fatal("duplicate poll dispatched")
+	}
+}
+
+func TestControllerEnrollmentCompletionRaceAndIncarnationFence(t *testing.T) {
+	c, b, _ := controllerFixture(t)
+	scope := fixtureScope()
+	b.o = Observation{"initial", "inProgress", ""}
+	b.duringEnrollment = true
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	s, _ := c.Store.Load(scope)
+	if s.BaselineActive || s.Baseline != "initial" {
+		t.Fatal("uncertain enrollment completion admitted")
+	}
+	b.duringEnrollment = false
+	b.o = Observation{"initial", "failed", "serverOverloaded"}
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	if b.sends != 0 {
+		t.Fatal("old failure restarted")
+	}
+	b.boundary = "replacement"
+	if err := c.Step(context.Background(), scope); err == nil {
+		t.Fatal("incarnation replacement admitted")
+	}
+}
diff --git a/portal/internal/turnretry/state.go b/portal/internal/turnretry/state.go
new file mode 100644
index 0000000..af99cfc
--- /dev/null
+++ b/portal/internal/turnretry/state.go
@@ -0,0 +1,345 @@
+// Package turnretry owns durable automatic-continuation policy. It has no
+// authority to load a thread, execute native work, or infer a turn's settings.
+package turnretry
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/aither64/codex-web/codex"
+)
+
+const Schema = 1
+const MaxBytes = 1024 * 1024
+const MaxSnapshotBytes = 256 * 1024
+const CyberLimit = 30
+const MaxSnapshots = 64
+
+const Continuation = "Continue the interrupted task from the saved conversation. Inspect the current state before repeating actions."
+
+type Scope struct {
+	Workspace string `json:"workspace"`
+	Slug      string `json:"slug"`
+	Root      string `json:"root"`
+	Thread    string `json:"thread"`
+	Socket    string `json:"socket"`
+}
+
+// Snapshot is captured at managed admission, never reconstructed from defaults
+// after failure. Turn is populated only by an exact accepted receipt.
+type Snapshot struct {
+	Version            int               `json:"version"`
+	ID                 string            `json:"id"`
+	Turn               string            `json:"turn"`
+	Origin             string            `json:"origin"`
+	Provider           string            `json:"provider"`
+	Mode               string            `json:"mode"`
+	CommonInstructions string            `json:"commonInstructions"`
+	Options            codex.TurnOptions `json:"options"`
+	Digest             string            `json:"digest"`
+	Proven             bool              `json:"proven"`
+	TextDigest         string            `json:"textDigest"`
+	SocketIdentity     string            `json:"socketIdentity"`
+	NativeContext      json.RawMessage   `json:"nativeContext,omitempty"`
+	BindingDigest      string            `json:"bindingDigest"`
+}
+
+type Binding struct {
+	SocketIdentity     string             `json:"socketIdentity"`
+	Provider           string             `json:"provider"`
+	Policy             codex.ThreadPolicy `json:"policy"`
+	CommonInstructions string             `json:"commonInstructions"`
+	Digest             string             `json:"digest"`
+}
+
+func (b Binding) Hash() (string, error) {
+	b.Digest = ""
+	data, err := json.Marshal(b)
+	if err != nil {
+		return "", err
+	}
+	return hash(string(data)), nil
+}
+
+func (s Snapshot) Hash() (string, error) {
+	s.Digest, s.Turn, s.Proven = "", "", false
+	data, err := json.Marshal(s)
+	if err != nil {
+		return "", err
+	}
+	if len(data) > MaxSnapshotBytes {
+		return "", errors.New("retry settings snapshot exceeds 256 KiB")
+	}
+	hash := sha256.Sum256(data)
+	return hex.EncodeToString(hash[:]), nil
+}
+
+type Pending struct {
+	ID          string   `json:"id"`
+	Action      string   `json:"action"`
+	Failure     string   `json:"failure"`
+	Snapshot    Snapshot `json:"snapshot"`
+	ChargedAtMS int64    `json:"chargedAtMs"`
+	ResultTurn  string   `json:"resultTurn"`
+}
+
+type State struct {
+	Schema         int        `json:"schema"`
+	Scope          Scope      `json:"scope"`
+	Enabled        bool       `json:"enabled"`
+	Enrolled       bool       `json:"enrolled"`
+	Boundary       string     `json:"boundary"`
+	Baseline       string     `json:"baseline"`
+	BaselineActive bool       `json:"baselineActive"`
+	Handled        string     `json:"handled"`
+	Chain          string     `json:"chain"`
+	Class          string     `json:"class"`
+	Phase          string     `json:"phase"`
+	Reason         string     `json:"reason"`
+	Attempt        uint64     `json:"attempt"`
+	Capacity       uint64     `json:"capacity"`
+	DeadlineMS     int64      `json:"deadlineMs"`
+	ClockMS        int64      `json:"clockMs"`
+	Cyber          []int64    `json:"cyber"`
+	Cancelled      bool       `json:"cancelled"`
+	Pending        *Pending   `json:"pending"`
+	Snapshots      []Snapshot `json:"snapshots"`
+	Binding        *Binding   `json:"binding,omitempty"`
+}
+
+type Observation struct{ Turn, Status, Code string }
+
+func New(scope Scope) State {
+	return State{Schema: Schema, Scope: scope, Enabled: true, Phase: "idle", Cyber: []int64{}, Snapshots: []Snapshot{}}
+}
+
+// Enroll consumes a terminal baseline. An active baseline is eligible only if
+// still active at the completed enrollment boundary supplied by the caller.
+func (s *State) Enroll(o Observation) {
+	if s.Enrolled {
+		return
+	}
+	s.Enrolled, s.Baseline = true, o.Turn
+	s.BaselineActive = o.Status == "inProgress"
+}
+
+func (s *State) SetEnabled(enabled bool, baseline Observation) {
+	if s.Enabled == enabled {
+		return
+	}
+	s.Enabled = enabled
+	s.Cancel("disabled")
+	if enabled {
+		s.Baseline, s.BaselineActive, s.Handled = baseline.Turn, baseline.Status == "inProgress", baseline.Turn
+		if s.BaselineActive {
+			s.Handled = ""
+		}
+	}
+}
+
+func (s *State) Uncertain() bool {
+	return s.Pending != nil && (s.Phase == "submitting" || s.Phase == "reconciling")
+}
+func (s *State) Owned() bool { return s.Phase == "scheduled" || s.Uncertain() }
+
+func (s *State) Cancel(reason string) {
+	s.Cancelled, s.DeadlineMS, s.Reason = true, 0, reason
+	if s.Pending != nil && s.Pending.ResultTurn != "" {
+		s.Handled = s.Pending.ResultTurn
+	}
+	if !s.Uncertain() {
+		s.Phase, s.Pending = "cancelled", nil
+	}
+}
+
+func (s *State) Now(now time.Time) int64 {
+	// A backward clock jump cannot expire charges or make a deadline due early.
+	value := now.UnixMilli()
+	if value < s.ClockMS {
+		return s.ClockMS
+	}
+	s.ClockMS = value
+	return value
+}
+
+func (s *State) CyberUsed(now int64) int {
+	count := 0
+	for _, at := range s.Cyber {
+		if at > now-300000 {
+			count++
+		}
+	}
+	return count
+}
+
+func CapacityDelay(attempt uint64, random float64) time.Duration {
+	seconds := [...]int64{15, 30, 60, 120, 240, 300}
+	index := min(attempt, uint64(len(seconds)-1))
+	base := time.Duration(seconds[index]) * time.Second
+	if random < 0 {
+		random = 0
+	}
+	if random > 1 {
+		random = 1
+	}
+	jitter := time.Duration(float64(min(3*time.Second, base/10)) * random)
+	return min(300*time.Second, base+jitter)
+}
+
+func Class(code string) string {
+	switch code {
+	case "serverOverloaded":
+		return "capacity"
+	case "cyberPolicy":
+		return "cybersecurity"
+	}
+	return ""
+}
+
+func (s *State) Proof(turn string) *Snapshot {
+	for i := len(s.Snapshots) - 1; i >= 0; i-- {
+		if s.Snapshots[i].Turn == turn && s.Snapshots[i].Proven {
+			v := s.Snapshots[i]
+			return &v
+		}
+	}
+	return nil
+}
+
+// Observe records each terminal failure once, including unsupported failures.
+// Quota exhaustion and cancel remain terminal until an independent turn.
+func (s *State) Observe(o Observation, now time.Time, random float64) error {
+	clock := s.Now(now)
+	if !s.Enrolled {
+		s.Enroll(o)
+		return nil
+	}
+	if s.Uncertain() {
+		return nil
+	}
+	if s.Pending != nil && s.Pending.ResultTurn == "" && o.Turn != s.Pending.Failure && o.Turn != "" {
+		s.Cancel("superseded")
+	}
+	if s.Pending != nil && s.Pending.ResultTurn != "" && o.Turn == s.Pending.ResultTurn && o.Status == "inProgress" {
+		return nil
+	}
+	if o.Status == "inProgress" {
+		return nil
+	}
+	if o.Turn == s.Handled || (o.Turn == s.Baseline && !s.BaselineActive) {
+		return nil
+	}
+	if s.Pending != nil && s.Pending.ResultTurn != "" && o.Turn != s.Pending.ResultTurn {
+		s.Cancel("superseded")
+	}
+	if o.Status != "failed" {
+		if o.Turn != "" {
+			s.Handled = o.Turn
+		}
+		if !s.Uncertain() {
+			s.Phase, s.Pending, s.DeadlineMS, s.Class = "idle", nil, 0, ""
+		}
+		return nil
+	}
+	s.Handled = o.Turn
+	class := Class(o.Code)
+	if class == "" || !s.Enabled {
+		return nil
+	}
+	continuing := s.Pending != nil && s.Pending.ResultTurn == o.Turn && !s.Cancelled
+	if !continuing {
+		s.Chain, s.Attempt, s.Capacity, s.Cancelled = o.Turn, 0, 0, false
+	}
+	s.Class = class
+	proof := s.Proof(o.Turn)
+	if proof == nil {
+		s.Phase, s.Reason, s.Pending, s.DeadlineMS = "blocked", "settings_unproven", nil, 0
+		return nil
+	}
+	if class == "cybersecurity" && s.CyberUsed(clock) >= CyberLimit {
+		s.Phase, s.Reason, s.Pending, s.DeadlineMS = "exhausted", "cyber_limit", nil, 0
+		return nil
+	}
+	id, err := NewID()
+	if err != nil {
+		return err
+	}
+	s.Pending = &Pending{ID: id, Failure: o.Turn, Snapshot: *proof, Action: "turn-retry:" + o.Turn + ":" + proof.Digest + ":" + id}
+	s.Phase, s.Reason, s.DeadlineMS = "scheduled", "", clock
+	if class == "capacity" {
+		s.DeadlineMS += CapacityDelay(s.Capacity, random).Milliseconds()
+	}
+	return nil
+}
+
+func (s *State) Begin(now time.Time) error {
+	clock := s.Now(now)
+	if !s.Enabled || s.Cancelled || s.Phase != "scheduled" || s.Pending == nil || clock < s.DeadlineMS {
+		return errors.New("retry is not due")
+	}
+	if s.Class == "cybersecurity" {
+		if s.CyberUsed(clock) >= CyberLimit {
+			s.Phase, s.Reason, s.DeadlineMS = "exhausted", "cyber_limit", 0
+			s.Pending = nil
+			return nil
+		}
+		kept := []int64{}
+		for _, at := range s.Cyber {
+			if at > clock-300000 {
+				kept = append(kept, at)
+			}
+		}
+		s.Cyber = append(kept, clock)
+		s.Pending.ChargedAtMS = clock
+	}
+	s.Attempt++
+	if s.Class == "capacity" {
+		s.Capacity++
+	}
+	s.Phase, s.DeadlineMS, s.Reason = "submitting", 0, ""
+	return nil
+}
+
+func (s *State) Accepted(turn string) error {
+	if s.Pending == nil || turn == "" {
+		return errors.New("retry receipt has no exact turn")
+	}
+	s.Pending.ResultTurn = turn
+	proof := s.Pending.Snapshot
+	proof.ID, proof.Turn, proof.Origin, proof.Proven = s.Pending.ID, turn, "automatic", false
+	proof.TextDigest = hash(Continuation)
+	proof.NativeContext = nil
+	proof.Digest, _ = proof.Hash()
+	s.AddSnapshot(proof)
+	s.Phase, s.Reason = "running", ""
+	if s.Cancelled {
+		s.Phase, s.Handled = "cancelled", turn
+	}
+	return nil
+}
+
+func (s *State) AddSnapshot(snapshot Snapshot) {
+	for i := range s.Snapshots {
+		if s.Snapshots[i].ID == snapshot.ID {
+			s.Snapshots[i] = snapshot
+			return
+		}
+	}
+	// Never evict queued or uncertain admissions to make room. Save enforces
+	// the bounded record and the caller refuses before submitting new work.
+	s.Snapshots = append(s.Snapshots, snapshot)
+}
+
+func NewID() (string, error) {
+	var b [16]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		return "", err
+	}
+	b[6], b[8] = b[6]&15|64, b[8]&63|128
+	return fmt.Sprintf("%x-%x-%x-%x-%x", b[:4], b[4:6], b[6:8], b[8:10], b[10:]), nil
+}
diff --git a/portal/internal/turnretry/state_test.go b/portal/internal/turnretry/state_test.go
new file mode 100644
index 0000000..ae88df2
--- /dev/null
+++ b/portal/internal/turnretry/state_test.go
@@ -0,0 +1,293 @@
+package turnretry
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/aither64/codex-web/codex"
+)
+
+func fixtureScope() Scope {
+	return Scope{Workspace: "/workspace", Slug: "2026-10-22-test", Root: "root", Thread: "root", Socket: "/socket"}
+}
+func proof(turn string) Snapshot {
+	p := Snapshot{Version: 1, ID: "manual-" + turn, Turn: turn, Origin: "browser", Provider: "openai", Mode: "default", Options: codex.TurnOptions{Model: "model", ReasoningEffort: "high"}, Proven: true}
+	p.Digest, _ = p.Hash()
+	return p
+}
+func observe(t *testing.T, s *State, turn, code string, now time.Time) {
+	t.Helper()
+	s.AddSnapshot(proof(turn))
+	if err := s.Observe(Observation{turn, "failed", code}, now, 0); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestNewFailuresAndActiveEnrollment(t *testing.T) {
+	now := time.Unix(1000, 0)
+	s := New(fixtureScope())
+	observe(t, &s, "old", "serverOverloaded", now)
+	if s.Phase != "idle" {
+		t.Fatal("old failure restarted")
+	}
+	observe(t, &s, "new", "serverOverloaded", now)
+	if s.Phase != "scheduled" || s.DeadlineMS != now.Add(15*time.Second).UnixMilli() {
+		t.Fatalf("new failure: %+v", s)
+	}
+	id := s.Pending.ID
+	observe(t, &s, "new", "serverOverloaded", now.Add(time.Second))
+	if s.Pending.ID != id {
+		t.Fatal("duplicate notification changed identity")
+	}
+	active := New(fixtureScope())
+	active.Enroll(Observation{"active", "inProgress", ""})
+	observe(t, &active, "active", "cyberPolicy", now)
+	if active.Phase != "scheduled" {
+		t.Fatal("active enrollment failed completion excluded")
+	}
+}
+
+func TestBackoffAcrossAcceptedChainAndRestart(t *testing.T) {
+	now := time.Unix(1000, 0)
+	s := New(fixtureScope())
+	s.Enroll(Observation{})
+	for i, delay := range []time.Duration{15, 30, 60, 120, 240, 300, 300, 300} {
+		turn := string(rune('a' + i))
+		observe(t, &s, turn, "serverOverloaded", now)
+		if got := time.Duration(s.DeadlineMS-now.UnixMilli()) * time.Millisecond; got != delay*time.Second {
+			t.Fatalf("attempt %d: %v", i, got)
+		}
+		now = time.UnixMilli(s.DeadlineMS)
+		if err := s.Begin(now); err != nil {
+			t.Fatal(err)
+		}
+		if err := s.Accepted(string(rune('a' + i + 1))); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := uint64(0); i < 12; i++ {
+		low, high := CapacityDelay(i, 0), CapacityDelay(i, 1)
+		if high > 300*time.Second || high-low > min(3*time.Second, low/10) {
+			t.Fatal("jitter escaped cap")
+		}
+	}
+}
+
+func TestCyberPossibleSendsExhaustionAndClock(t *testing.T) {
+	now := time.Unix(1000, 0)
+	s := New(fixtureScope())
+	s.Enroll(Observation{})
+	for i := 0; i < 30; i++ {
+		turn := string(rune(100 + i))
+		observe(t, &s, turn, "cyberPolicy", now)
+		if err := s.Begin(now); err != nil {
+			t.Fatal(err)
+		}
+		// A crash after Begin consumes one possible send. Reconciliation, even
+		// after a backwards wall-clock jump, cannot reserve a new slot.
+		if err := s.Observe(Observation{turn, "failed", "cyberPolicy"}, now.Add(-time.Hour), 0); err != nil {
+			t.Fatal(err)
+		}
+		if s.CyberUsed(s.Now(now.Add(-time.Hour))) != i+1 {
+			t.Fatal("lost uncertain charge")
+		}
+		if err := s.Accepted(string(rune(101 + i))); err != nil {
+			t.Fatal(err)
+		}
+	}
+	observe(t, &s, string(rune(130)), "cyberPolicy", now)
+	if s.Phase != "exhausted" || s.Pending != nil {
+		t.Fatal("31st send permitted")
+	}
+	observe(t, &s, string(rune(130)), "cyberPolicy", now.Add(10*time.Minute))
+	if s.Phase != "exhausted" {
+		t.Fatal("timer rearmed exhausted failure")
+	}
+	if s.CyberUsed(now.UnixMilli()+300000) != 0 {
+		t.Fatal("rolling window lower boundary included")
+	}
+}
+
+func TestCancelDisableAndUnknownOutcome(t *testing.T) {
+	now := time.Unix(1000, 0)
+	s := New(fixtureScope())
+	s.Enroll(Observation{})
+	observe(t, &s, "failed", "cyberPolicy", now)
+	s.Cancel("manual_input")
+	if err := s.Begin(now); err == nil {
+		t.Fatal("cancelled dispatch allowed")
+	}
+	observe(t, &s, "failed", "cyberPolicy", now)
+	if s.Pending != nil {
+		t.Fatal("cancel rearmed same failure")
+	}
