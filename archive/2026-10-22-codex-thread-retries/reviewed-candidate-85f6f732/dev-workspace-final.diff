+	defer again.Close()
+	if again.State.Pending.ID != id || again.State.DeadlineMS != deadline {
+		t.Fatal("restart lost saved schedule")
+	}
+	info, _ := os.Stat(store.path(scope))
+	if info.Mode().Perm() != 0600 {
