tar.xz","outputHash":"sha256-uOchgrLslqNXTimYxHt6qmTMIM4ADY6awxPMB87PKMc=","outputHashAlgo":"sha256","outputHashMode":"flat","preferLocalBuild":"1","system":"builtin","unpack":"","url":"https://ftpmirror.gnu.org/sed/sed-4.10.tar.xz","urls":"https://ftpmirror.gnu.org/sed/sed-4.10.tar.xz"},"inputs":{"drvs":{},"srcs":[]},"name":"sed-4.10.tar.xz","outputs":{"out":{"hash":"sha256-uOchgrLslqNXTimYxHt6qmTMIM4ADY6awxPMB87PKMc=","method":"flat"}},"system":"builtin","version":4},"ky6jgz9qsvmg00d83hjfkqgb6k8bk3s0-CVE-2026-5222.patch.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/f5dykzc26kny99x6jbvf5yn9wsdvwmyj-CVE-2026-5222.patch"},"inputs":{"drvs":{"3fc7klhja3mn322hjxl4bax4mk3m6h8l-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"asxqrkwwpzvlzlyv38c251wz39m1a46j-patchutils-0.3.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"nccfw1s0py9wvalrf7s92cfmg7bijj0i-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"CVE-2026-5222.patch","outputs":{"out":{"hash":"sha256-YG7xtC308z+o1xVzrV81qqWov1121GVouyAXKflyBF8=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":[],"curlOpts":"","curlOptsList":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"downloadToTemp":false,"env":{"SSL_CERT_FILE":"/no-cert-file.crt"},"executable":false,"hash":"sha256-YG7xtC308z+o1xVzrV81qqWov1121GVouyAXKflyBF8=","impureEnvVars":["http_proxy","https_proxy","ftp_proxy","all_proxy","no_proxy","HTTP_PROXY","HTTPS_PROXY","FTP_PROXY","ALL_PROXY","NO_PROXY","NIX_SSL_CERT_FILE","NIX_CURL_FLAGS","NIX_HASHED_MIRRORS","NIX_CONNECT_TIMEOUT","NIX_MIRRORS_alsa","NIX_MIRRORS_apache","NIX_MIRRORS_bioc","NIX_MIRRORS_bitlbee","NIX_MIRRORS_centos","NIX_MIRRORS_cpan","NIX_MIRRORS_cran","NIX_MIRRORS_debian","NIX_MIRRORS_dub","NIX_MIRRORS_fedora","NIX_MIRRORS_gcc","NIX_MIRRORS_gentoo","NIX_MIRRORS_gnome","NIX_MIRRORS_gnu","NIX_MIRRORS_gnupg","NIX_MIRRORS_hackage","NIX_MIRRORS_hashedMirrors","NIX_MIRRORS_ibiblioPubLinux","NIX_MIRRORS_imagemagick","NIX_MIRRORS_kde","NIX_MIRRORS_kernel","NIX_MIRRORS_luarocks","NIX_MIRRORS_maven","NIX_MIRRORS_mozilla","NIX_MIRRORS_mysql","NIX_MIRRORS_openbsd","NIX_MIRRORS_opensuse","NIX_MIRRORS_osdn","NIX_MIRRORS_postgresql","NIX_MIRRORS_pypi","NIX_MIRRORS_qt","NIX_MIRRORS_sageupstream","NIX_MIRRORS_samba","NIX_MIRRORS_savannah","NIX_MIRRORS_sourceforge","NIX_MIRRORS_steamrt","NIX_MIRRORS_tcsh","NIX_MIRRORS_testpypi","NIX_MIRRORS_texhistoric","NIX_MIRRORS_ubuntu","NIX_MIRRORS_xfce","NIX_MIRRORS_xorg"],"mesonFlags":[],"mirrorsFile":"/nix/store/981lgfashyzwys4rf4y452n92hblkx5h-mirrors-list","name":"CVE-2026-5222.patch","nativeBuildInputs":["/nix/store/3kyk0wjam6yl651y2hdz4wm8qilsxq71-curl-8.22.0-dev","/nix/store/93k2ibiipgz5knnnwl1kn99xiba8rynx-patchutils-0.3.3"],"nixpkgsVersion":"26.05","outputChecks":{"out":{}},"outputHash":"sha256-YG7xtC308z+o1xVzrV81qqWov1121GVouyAXKflyBF8=","outputHashMode":"flat","outputs":["out"],"patches":[],"postFetch":"tmpfile=\"$TMPDIR/patch\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Fetched patch file '$out' is empty!\" 1>&2\n  exit 1\nfi\n\nset +e\ncat < \"$out\" > \"$tmpfile\"\nif [ $? -ne 0 ] || [ ! -s \"$tmpfile\" ]; then\n    echo 'Failed to decode patch with command \"'cat'\"' >&2\n    echo 'Fetched file was (limited to 128 bytes):' >&2\n    od -A x -t x1z -v -N 128 \"$out\" >&2\n    exit 1\nfi\nset -e\nmv \"$tmpfile\" \"$out\"\n\nlsdiff \\\n   \\\n  \"$out\" \\\n| sort -u | sed -e 's/[*?]/\\\\&/g' \\\n| xargs -I{} --delimiter='\\n' \\\n  filterdiff \\\n  --include={} \\\n  --strip=1 \\\n  --addoldprefix=a/src/tools/cargo/ \\\n--addnewprefix=b/src/tools/cargo/ \\\n \\\n  --clean \"$out\" > \"$tmpfile\"\n\nif [ ! -s \"$tmpfile\" ]; then\n  echo \"error: Normalized patch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://github.com/rust-lang/cargo/commit/c4d63a44234de22dc745231c416b80ed848d997f.patch"]},"system":"x86_64-linux","version":4},"kyq3pkcn2zym902ks396id0nhczxkw9q-snprintf-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"snprintf-builder","out":"/nix/store/bwaj3qc469jd3bzccjvhfcrvy6rvja4j-snprintf-builder","passAsFile":"text","system":"