aBuild":true,"dontUseNinjaCheck":true,"dontUseNinjaInstall":true,"enableParallelBuilding":true,"enableParallelChecking":false,"enableParallelInstalling":true,"env":{"NINJA":"TERM=dumb ninja","NIX_MAIN_PROGRAM":"node"},"mesonFlags":[],"moveToDev":false,"name":"nodejs-slim-24.21.0","nativeBuildInputs":["/nix/store/in3nqj51pch28k23pj7b0g19m7jamfpa-install-shell-files","/nix/store/jl5zl7fan8qvlyc8hl5sl48q4l00yzm4-ninja-1.13.2","/nix/store/p82z8amhf9g6wfidd1q4k58nsmk735zs-pkgconf-wrapper-2.5.1","/nix/store/jy00n3jp5xj8s40n1fbldmkcr5n7avxc-python3-3.13.15"],"outputChecks":{"corepack":{"disallowedReferences":["libv8","npm"]},"dev":{},"libv8":{"disallowedReferences":["out","npm","corepack"]},"npm":{"disallowedReferences":["libv8","corepack"]},"out":{"disallowedReferences":["libv8","npm","corepack"]}},"outputs":["out","libv8","npm","corepack","dev"],"patches":["/nix/store/j4p9lc7z8hi4g40cpqpj3qxb9a7bvanp-configure-armv6-vfpv2.patch","/nix/store/igz0qnjkvwi4f2mn7i13h3ndxl9n5ryi-node-npm-build-npm-package-logic.patch","/nix/store/57n0csr7hpdd0y91ljxpiwlfw7fsx3kl-use-correct-env-in-tests.patch","/nix/store/p2mhv95s89kaqmdynhz6y6asalf8y4dh-bin-sh-node-run-v22.patch","/nix/store/3za8p3x3hjfr1a9b1lc3z4aapp9sm2ja-use-nix-codesign.patch","/nix/store/nf5qia29mzasf2idq21pldcbxyxgwdjy-869d0cbca3b0b5e594b3254869a34d549664e089.patch?full_index=1"],"pname":"nodejs-slim","postConfigure":"","postFixup":"HOST_PATH=$out/bin patchShebangs --host $out $corepack $npm\n\nfor dir in \"$npm/lib/node_modules/npm/man/\"*; do\n  mkdir -p $npm/share/man/$(basename \"$dir\")\n  for page in \"$dir\"/*; do\n    ln -rs $page $npm/share/man/$(basename \"$dir\")\n  done\ndone\n","postInstall":"mkdir -p $dev/bin\ncp out/Release/{bytecode_builtins_list_generator,mksnapshot,torque,node_js2c,gen-regexp-special-case} $dev/bin\n\n$out/bin/node --completion-bash > node.bash\ninstallShellCompletion node.bash\n\n\nmkdir -p $npm/share/bash-completion/completions\nln -s $npm/lib/node_modules/npm/lib/utils/completion.sh \\\n  $npm/share/bash-completion/completions/npm\n\n# install the missing headers for node-gyp\n# TODO: use propagatedBuildInputs instead of copying headers.\ncp -r /nix/store/6w8169j14r7zrl35yfsmdpc1p19vjd17-ada-3.4.4/include/* /nix/store/41r5x5klzq7kdkh9l43glqnkpz2r4hmx-brotli-1.2.0-dev/include/* /nix/store/6dbxpvmq0h5wklv708hpp7r6fb204zh0-c-ares-1.34.8-dev/include/* /nix/store/2fbhjr74zbbrwfzw73b3dp2yg8izfr5l-llhttp-9.4.3-dev/include/* /nix/store/bb3ysnf0qljwwbasxqwsigamqgihmx31-libuv-1.52.1-dev/include/* /nix/store/mbl0bx9bsszf851dnw7ggh97z5qzkkvh-merve-1.2.2/include/* /nix/store/6s6ajz3vw48qxnqggp9pih22af5gdc6r-nghttp2-1.69.0-dev/include/* /nix/store/wssc1dzk2dc7d4vdym6lrjcifgfk5i6n-nghttp3-1.15.0-dev/include/* /nix/store/xzz3cxfj20sajfjrn7dfgkrc70r93cfk-ngtcp2-1.22.1-dev/include/* /nix/store/7l09089ahshxjx4js3zswqk6azhx6ccq-openssl-3.6.5-dev/include/* /nix/store/gxa98661px2ybkpqdy816nlhf14ii9cw-simdjson-4.6.4/include/* /nix/store/z4nqf7iyjgx3asz6643qs9lnm0sw01kp-simdutf-6.5.0/include/* /nix/store/mhy634114a25wmcc6l64kzwi2cgyqsc3-sqlite-3.51.2-dev/include/* /nix/store/3a3nzzip10mi5mi8wpkn89hrrfcbks65-uvwasi-0.0.23/include/* /nix/store/2k9dj65vyanlvq863ks3ii7cjx82kfng-zlib-1.3.2-dev/include/* /nix/store/1hjg44rywjpc52nnhs1z9iba9vgr2s3n-zstd-1.5.7-dev/include/* $out/include/node\n\n# assemble a static v8 library and put it in the 'libv8' output\nmkdir -p $libv8/lib\npushd out/Release/obj\nfind . -path \"**/torque_*/**/*.o\" -or -path \"**/v8*/**/*.o\" \\\n  -and -not -name \"torque.*\" \\\n  -and -not -name \"mksnapshot.*\" \\\n  -and -not -name \"gen-regexp-special-case.*\" \\\n  -and -not -name \"bytecode_builtins_list_generator.*\" \\\n  | sort -u >files\ntest -s files # ensure that the list is not empty\n$AR -cqs $libv8/lib/libv8.a @files\npopd\n\n# copy v8 headers\ncp -r deps/v8/include $libv8/\n\n# create a pkgconfig file for v8\nmajor=$(grep V8_MAJOR_VERSION deps/v8/include/v8-version.h | cut -d ' ' -f 3)\nminor=$(grep V8_MINOR_VERSION deps/v8/include/v8-version.h | cut -d ' ' -f 3)\npatch=$(grep V8_PATCH_LEVEL deps/v8/include/v8-version.h | cut -d ' ' -f 3)\nmkdir -p $libv8/lib/pkgconfig\ncat > $libv8/lib/pkgconfig/v8.pc << EOF\nName: v8\nDescription: V8 JavaScript Engine\nVersion: $major.$minor.$patch\nLibs: -L$libv8/lib -lv8 -pthread -licui18n -licuuc\nCflags: -I$libv8/include\nEOF\ncp -r $out/include $dev/include\n","postPatch":"substituteInPlace tools/install.py \\\n  --replace-fail '  corepack_files(options, action)' \"  oip=options.install_path;options.install_path='$corepack';corepack_files(options, action);options.install_path=oip\" \\\n  --replace-fail '  npm_files(options, action)' \"  oip=options.install_path;options.install_path='$npm';npm_files(options, action);options.install_path=oip\"\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"setOutputFlags":false,"setupHook":"/nix/store/ay9ps6p97mf12nybf9d4r3nyina81b87-setup-hook.sh","src":"/nix/store/y82fpqricgrybg6crp3y0hy52fh84q9k-node-v24.21.0.tar.xz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"24.21.0"},"system":"x86_64-linux","version":4},"fl6mqjpa5193l28xwgdla6mj4i186568-tinycc-mes-chain-unstable-2025-12-03.drv":{"args":["--verbose","--strict","--file","/nix/store/xwyi18mfkbn61by2viy6n7j8dzf88sai-tinycc-mes-chain-unstable-2025-12-03-builder"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin:/nix/store/53zd871rgpcvi7qmqkffxhzaiq0is7k4-mescc-tools-1.9.1/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","name":"tinycc-mes-chain-unstable-2025-12-03","out":"/nix/store/sh3rpfhiyjc8wsjb4m224xh9rkx1k71s-tinycc-mes-chain-unstable-2025-12-03","system":"x86_64-linux"},"inputs":{"drvs":{"0978f9k46zgxwpc8lwzk9fxajma156kr-tinycc-mes-