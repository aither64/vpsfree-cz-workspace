"description\":\"No osctl pool is imported into osctld\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"No osctl pool in use (instance {{ $labels.instance }})\"},\"expr\":\"osctl_pool_count{job=\\\"nodes\\\",role=\\\"hypervisor\\\",state=\\\"active\\\"} == 0\",\"for\":\"15m\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"fatal\"}},{\"alert\":\"VpsNoRefquotaSet\",\"annotations\":{\"description\":\"VPS has no refquota set\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS has no refquota set (instance {{ $labels.instance }})\"},\"expr\":\"osctl_container_dataset_refquota_bytes{job=\\\"nodes\\\"} == 0\",\"for\":\"12h\",\"labels\":{\"alertclass\":\"vpsquota\",\"frequency\":\"hourly\",\"severity\":\"warning\"}},{\"alert\":\"VpsStartingTooLong\",\"annotations\":{\"description\":\"VPS is taking too long to start\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS is taking too long to start (instance {{ $labels.instance }})\"},\"expr\":\"osctl_container_state_starting{job=\\\"nodes\\\"} == 1\",\"for\":\"15m\",\"labels\":{\"alertclass\":\"vpsstate\",\"frequency\":\"15m\",\"severity\":\"critical\"}},{\"alert\":\"VpsAborting\",\"annotations\":{\"description\":\"VPS is taking too long to abort\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS is taking too long to abort (instance {{ $labels.instance }})\"},\"expr\":\"osctl_container_state_aborting{job=\\\"nodes\\\"} == 1\",\"for\":\"15m\",\"labels\":{\"alertclass\":\"vpsstate\",\"frequency\":\"15m\",\"severity\":\"critical\"}},{\"alert\":\"VpsError\",\"annotations\":{\"description\":\"VPS is in an error state\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS is in an error state (instance {{ $labels.instance }})\"},\"expr\":\"osctl_container_state_aborting{job=\\\"nodes\\\"} == 1\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"vpsstate\",\"frequency\":\"15m\",\"severity\":\"critical\"}},{\"alert\":\"VpsFrozen\",\"annotations\":{\"description\":\"VPS is in an error state\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS is in an error state (instance {{ $labels.instance }})\"},\"expr\":\"osctl_container_state_freezing{job=\\\"nodes\\\"} == 1 or on(instance) osctl_container_state_frozen == 1\",\"for\":\"10m\",\"labels\":{\"alertclass\":\"vpsstate\",\"frequency\":\"15m\",\"severity\":\"critical\"}},{\"alert\":\"PacketLoss\",\"annotations\":{\"description\":\"VALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Packet loss detected (instance {{ $labels.instance }})\"},\"expr\":\"rate(node_network_transmit_drop_total{device=~\\\"(teng.+)|(oneg.+)\\\"}[5m]) > 0 or rate(node_network_receive_drop_total{device=~\\\"(teng.+)|(oneg.+)\\\"}[5m]) > 0\",\"for\":\"10m\",\"labels\":{\"alertclass\":\"packetloss\",\"frequency\":\"15m\",\"severity\":\"warning\"}}]},{\"name\":\"nodectld\",\"rules\":[{\"alert\":\"NodectldPaused\",\"annotations\":{\"description\":\"nodectld is paused and not executing transactions\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"nodectld is paused (instance {{ $labels.instance }})\"},\"expr\":\"nodectld_state_paused == 1\",\"for\":\"30m\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"critical\"}},{\"alert\":\"VpsAutostartNotRunning\",\"annotations\":{\"description\":\"vpsAdmin has auto-start enabled for this VPS, but nodectld cannot\\nfind it in the running state.\\n\",\"summary\":\"VPS {{ $labels.vps_id }} should be running on {{ $labels.fqdn }} in pool {{ $labels.pool }}\"},\"expr\":\"(\\n  nodectld_vps_autostart_unsatisfied{role=\\\"hypervisor\\\"} == 1\\n  and on(fqdn)\\n    nodectld_vps_autostart_check_success{role=\\\"hypervisor\\\"} == 1\\n  and on(fqdn)\\n    time() - nodectld_vps_autostart_check_last_success_timestamp_seconds{role=\\\"hypervisor\\\"} < 300\\n)\\nand on(fqdn)\\n  vpsfree_hypervisor_booting == 0\\n\",\"for\":\"10m\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"critical\"}},{\"alert\":\"VpsAutostartCheckFailed\",\"annotations\":{\"description\":\"nodectld has not completed a recent comparison of the vpsAdmin\\nauto-start settings with the containers in osctld.\\n\",\"summary\":\"VPS auto-start status check is failing on {{ $labels.fqdn }}\"},\"expr\":\"(\\n  nodectld_vps_autostart_check_success{role=\\\"hypervisor\\\"} == 0\\n  or\\n    time() - nodectld_vps_autostart_check_last_success_timestamp_seconds{role=\\\"hypervisor\\\"} > 300\\n)\\nand on(fqdn)\\n  vpsfree_hypervisor_booting == 0\\n\",\"for\":\"10m\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"warning\"}},{\"alert\":\"VpsStartStalled\",\"annotations\":{\"description\":\"VPS takes more than 20 minutes to start\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS start has stalled (instance {{ $labels.instance }})\"},\"expr\":\"nodectld_command_seconds{handler=\\\"Vps::Start\\\"} > 60*20\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"fatal\"}},{\"alert\":\"VpsStopStalled\",\"annotations\":{\"description\":\"VPS takes more than 20 minutes to stop, it is quite likely stuck\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS stop has stalled (instance {{ $labels.instance }})\"},\"expr\":\"nodectld_command_seconds{handler=\\\"Vps::Stop\\\"} > 60*20\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"fatal\"}},{\"alert\":\"VpsRestartStalled\",\"annotations\":{\"description\":\"VPS takes more than 20 minutes to restart, it is quite likely stuck\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS restart has stalled (instance {{ $labels.instance }})\"},\"expr\":\"nodectld_command_seconds{handler=\\\"Vps::Restart\\\"} > 60*20\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"critical\"}}]}]}"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"vps-a