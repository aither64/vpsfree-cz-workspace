stance) time() - node_boot_time_seconds > 1800\",\"for\":\"1m\",\"labels\":{\"alertclass\":\"processes_d\",\"severity\":\"fatal\"}},{\"alert\":\"NodeWarnZombieProcesses\",\"annotations\":{\"description\":\"VALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Node has too many zombie processes (instance {{ $labels.instance }})\"},\"expr\":\"node_processes_state{job=\\\"nodes\\\",state=\\\"Z\\\"} > 10000\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"processes_z\",\"frequency\":\"6h\",\"severity\":\"warning\"}},{\"alert\":\"VpsWarnUninterruptibleProcesses\",\"annotations\":{\"description\":\"VALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Too many VPS with uninterruptible (D) processes (instance {{ $labels.instance }})\"},\"expr\":\"count by (fqdn) (osctl_container_processes_state{state=\\\"D\\\"} > 5) > 5 and on(fqdn) time() - node_boot_time_seconds > 1800\",\"for\":\"1m\",\"labels\":{\"alertclass\":\"vps_processes_d\",\"severity\":\"warning\"}},{\"alert\":\"VpsWarnZombieProcesses\",\"annotations\":{\"description\":\"VALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS has too many zombie processes (instance {{ $labels.instance }})\"},\"expr\":\"osctl_container_processes_state{state=\\\"Z\\\"} > 10000\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"vps_processes_z\",\"frequency\":\"hourly\",\"severity\":\"warning\"}},{\"alert\":\"SshExporterDown\",\"annotations\":{\"description\":\"SSH exporter is down, node SSH checks are not working.\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"SSH exporter is down (instance {{ $labels.instance }})\"},\"expr\":\"up{job=\\\"ssh-exporters\\\"} == 0\",\"for\":\"5m\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"critical\"}},{\"alert\":\"NodeSshDownCrit\",\"annotations\":{\"description\":\"Node is not responding over SSH\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Node not responding over SSH (instance {{ $labels.instance }})\"},\"expr\":\"ssh_ho