4i4zr2405l1hissh2d08rhmvwr9-glibc-iconv-2.42.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["85ax0pclk9prgkp8d7m6n6q1g7v5m58j-git-send-email-honor-PATH.patch","j6vpikcvv4ry0pwalvpz1m65k2wckavl-docbook2texi.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","xprdd33cnqprwk19lxi57h907fz7xic2-git-sh-i18n.patch"]},"name":"git-minimal-2.54.0","outputs":{"debug":{"path":"wa13iqazc515arr9aq357piih48pnmyk-git-minimal-2.54.0-debug"},"out":{"path":"g2f1qz4fwxxj6xs3q58zykrlzj1f9hiq-git-minimal-2.54.0"}},"structuredAttrs":{"NIX_LDFLAGS":"-lgcc_s","NIX_MAIN_PROGRAM":"git","buildInputs":["/nix/store/pqvvkzca5in8kfdz9chymswfwsg4ga6a-curl-8.22.0-dev","/nix/store/7l09089ahshxjx4js3zswqk6azhx6ccq-openssl-3.6.5-dev","/nix/store/cdba8gkd7c9n89cgcq7fiasqc84fv73v-zlib-ng-2.3.3-dev","/nix/store/4z7x3563mcg0whqads5wa149hsvy6c44-expat-2.8.5-dev","/nix/store/ngy9kz80vpiylr093kjbcv8y2igq0m80-glibc-iconv-2.42","/nix/store/mnv5sn4d6bdkq84f0wn3nibsxvqxaplr-bash-interactive-5.3p9-dev"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":["ac_cv_prog_CURL_CONFIG=/nix/store/pqvvkzca5in8kfdz9chymswfwsg4ga6a-curl-8.22.0-dev/bin/curl-config"],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"NIX_LDFLAGS":"-lgcc_s","NIX_MAIN_PROGRAM":"git"},"installCheckFlags":["DEFAULT_TEST_TARGET=prove","PERL_PATH=/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3/bin/perl"],"installCheckTarget":"test","installFlags":["NO_INSTALL_HARDLINKS=1"],"makeFlags":["prefix=${out}","ZLIB_NG=1","SHELL_PATH=/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","NO_PERL=1","NO_PYTHON=1","sysconfdir=/etc"],"mesonFlags":[],"name":"git-minimal-2.54.0","nativeBuildInputs":["/nix/store/076bszxgxgrp2vg1iw4fqsij10kkzkdi-uname","/nix/store/r6cl7zk1vhckkbnrjvvgf5ah1a23s090-gettext-1.0","/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3","/nix/store/7whrgb2wib2q83wgbs78xsq9h25lf3aw-make-shell-wrapper-hook","/nix/store/viqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2","/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh"],"outputChecks":{"debug":{},"out":{"disallowedReferences":[]}},"outputs":["out","debug"],"patches":["/nix/store/j6vpikcvv4ry0pwalvpz1m65k2wckavl-docbook2texi.patch","/nix/store/xprdd33cnqprwk19lxi57h907fz7xic2-git-sh-i18n.patch","/nix/store/85ax0pclk9prgkp8d7m6n6q1g7v5m58j-git-send-email-honor-PATH.patch","/nix/store/k7c6k6zwjh9fgzm9fazn9l1qm6wnv0cy-t7703-ignore-ls-total.patch","/nix/store/fzzc79ndlidjp84dx1mxr4ir8sgi3msm-expect-gui--askyesno-failure-in-t1517.patch","/nix/store/xf1lm1n1lj6prcalhi1mnglfwndvc81l-darwin-unicode-filename-fix.patch"],"pname":"git-minimal","postBuild":"# Set up the flags array for make in the same way as for the main build\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelBuilding:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray buildFlags buildFlagsArray\nechoCmd 'build flags' \"${flagsArray[@]}\"\nmake -C contrib/subtree \"${flagsArray[@]}\" all \nunset flagsArray\n","postInstall":"# Set up the flags array for make in the same way as for the main install\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelInstalling:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray installFlags installFlagsArray\nechoCmd 'install flags' \"${flagsArray[@]}\"\n\n# Install git-subtree.\nmake -C contrib/subtree \"${flagsArray[@]}\" install \nrm -rf contrib/subtree\n\n# Install contrib stuff.\nmkdir -p $out/share/git\ncp -a contrib $out/share/git/\nmkdir -p $out/share/bash-completion/completions\nln -s $out/share/git/contrib/completion/git-prompt.sh $out/share/bash-completion/completions/\n\n# grep is a runtime dependency, need to patch so that it's found\nsubstituteInPlace $out/libexec/git-core/git-sh-setup \\\n    --replace ' grep' ' /nix/store/cqhgy07rpxdwk9kd2qlc3cw4s9ajzm9f-gnugrep-3.12/bin/grep' \\\n    --replace ' egrep' ' /nix/store/cqhgy07rpxdwk9kd2qlc3cw4s9ajzm9f-gnugrep-3.12/bin/egrep'\n\n# Fix references to the perl, sed, awk and various coreutil binaries used by\n# shell scripts that git calls (e.g. filter-branch)\nSCRIPT=\"$(cat <<'EOS'\n  BEGIN{\n    @a=(\n      '/nix/store/cqhgy07rpxdwk9kd2qlc3cw4s9ajzm9f-gnugrep-3.12/bin/grep', '/nix/store/0s17nja4n8b63by0nlg1m31mxn2bq1g1-gnused-4.10/bin/sed', '/nix/store/xbqis14s3fvckwlayc6vxvglws1v2mcw-gawk-5.4.1/bin/awk',\n      '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/cut', '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/basename', '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/dirname',\n      '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/wc', '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/tr'\n      \n    );\n  }\n  foreach $c (@a) {\n    $n=(split(\"/\", $c))[-1];\n    s|(?<=[^#][^/.-])\\b${n}(?=\\s)|${c}|g\n  }\nEOS\n)\"\nperl -0777 -i -pe \"$SCRIPT\" \\\n  $out/libexec/git-core/git-{sh-setup,filter-branch,merge-octopus,mergetool,quiltimport,request-pull,submodule,subtree,web--browse}\n\n\n# Also put git-http-backend into $PATH, so that we can use smart\n# HTTP(s) transports for pushing\nln -s $out/libexec/git-core/git-http-backend $out/bin/git-http-backend\nrm $out/libexec/git-core/git-svn\nrm $out/libexec/git-core/git-send-email\nfor prog in bin/gitk libexec/git-core/git-gui; do\n  rm \"$out/$prog\"\ndone\nunset flagsArray\n","postPatch":"# Fix references to gettext introduced by ./git-sh-i18n.patch\nsubstituteInPlace git-sh-i18n.sh \\\n    --subst-var-by gettext /nix/store/r6cl7zk1vhckkbnrjvvgf5ah1a23s090-gettext-1.0\nsubstituteInPlace contrib/credential/libsecret/Makefile \\\n    --replace-fail 'pkg-config' \"$PKG_CONFIG\"\n# ensure we are using the correct shell when executing the test scripts\npatchShebangs t/*.sh\n","preBuild":"makeFlagsArray+=( perllibdir=$out/$(perl -MConfig -wle 'print substr $Config{installsitelib}, 1 + length $Config{siteprefixexp}') )\n","preInstall":"","preInstallCheck":"# Some tests break with high concurrency\n# https://github.com/NixOS/nixpkgs/pull/403237\nif ((NIX_BUILD_CORES > 32)); then\n  NIX_BUILD_CORES=32\nfi\n\ninstallCheckFlagsArray+=(\n  GIT_PROVE_OPTS=\"--jobs $NIX_BUILD_CORES --failures --state=failed,save\"\n  GIT_TEST_INSTALLED=$out/bin\n  NO_SVN_TESTS=y\n)\n\nfunction disable_test {\n  local test=$1 pattern=$2\n  if [ $# -eq 1 ]; then\n    mv t/{,skip-}$test.sh || true\n  else\n    sed -i t/$test.sh \\\n      -e \"/^\\s*test_expect_.*$pattern/,/^\\s*' *\\$/{s/^/: #/}\"\n  fi\n}\n\n# Shared permissions are forbidden in sandbox builds:\nsubstituteInPlace t/test-lib.sh \\\n  --replace \"test_set_prereq POSIXPERM\" \"\"\n# TODO: Investigate while these still fail (without POSIXPERM):\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'shared overrides system'\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'init honors global core.sharedRepository'\n# Tested to fail: 2.46.0\ndisable_test t1301-shared-repo\n# /build/git-2.44.0/contrib/completion/git-completion.bash: line 452: compgen: command not found\ndisable_test t9902-completion\n# Disable sendmail tests\ndisable_test t9001-send-email\n# Flaky tests:\ndisable_test t0027-auto-crlf\ndisable_test t1451-fsck-buffer\ndisable_test t5319-multi-pack-index\ndisable_test t6421-merge-partial-clone\ndisable_test t7504-commit-msg-hook\ndisable_test t5515-fetch-merge-logic\ndisable_test t4104-apply-boundary\ndisable_test t7002-mv-sparse-checkout\ndisable_test t4122-apply-symlink-inside\ndisable_test t7513-interpret-trailers\ndisable_test t2200-add-update\n\n# Fails reproducibly on ZFS on Linux with formD normalization\ndisable_test t0021-conversion\ndisable_test t3910-mac-os-precompose\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"src":"/nix/store/drcyzlalnx264vlmp2js5vp2kkvyn132-git-2.54.0.tar.xz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":false,"stripDebugList":["lib","libexec","bin","share/git/contrib/credential"],"system":"x86_64-linux","version":"2.54.0"},"system":"x86_64-linux","version":4},"irpf44fixgjjcisk8ifmwqwbm49mlrlx-mes-m2-libs-0.27.1-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"mes-m2-libs-0.27.1-builder","out":"/nix/store/jrxycrv3wljy8lf5cv5wskjpr5plhcr3-mes-m2-libs-0.27.1-builder","passAsFile":"text","system":"x86_64-linux","text":"LIBDIR=${out}/lib\nmkdir -p ${out} ${LIBDIR}\n\nmkdir -p ${LIBDIR}/x86_64-mes\n\n# crt1.o\ncp /nix/store/1c9wqvj31w272lvd4473bfhy0nqfgqi1-crt1/crt1.o ${LIBDIR}/x86_64-mes\ncp /nix/store/1c9wqvj31w272lvd4473bfhy0nqfgqi1-crt1/crt1.s ${LIBDIR}/x86_64-mes\n\n# libc-mini.a\ncp /nix/store/c4wgyhs8rw28zswdfj1yi92c29w0c80x-mes-libc-mini-0.27.1/lib/libc-mini.a ${LIBDIR}/x86_64-mes\ncp /nix/store/c4wgyhs8rw28zswdfj1yi92c29w0c80x-mes-libc-mini-0.27.1/lib/libc-mini.s ${LIBDIR}/x86_64-mes\n\n# libmescc.a\ncp /nix/store/3mhypgqj993x5xa6wpxqgff6hrsdgkdm-mes-libmescc-0.27.1/lib/libmescc.a ${LIBDIR}/x86_64-mes\ncp /nix/store/3mhypgqj993x5xa6wpxqgff6hrsdgkdm-mes-libmescc-0.27.1/lib/libmescc.s ${LIBDIR}/x86_64-mes\n\n# libc.a\ncp /nix/store/z4p3bd0q58lmmdwj2pfiiljxarfm06x9-mes-libc-0.27.1/lib/libc.a ${LIBDIR}/x86_64-mes\ncp /nix/store/z4p3bd0q5