intf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","checkPhase":"","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"","mesonFlags":"","name":"vps-autostart-rules.json","nativeBuildInputs":"","out":"/nix/store/xivwh2i1lcqb0ypc9nh2rrj0cj2qrq2f-vps-autostart-rules.json","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"{\"groups\":[{\"interval\":\"20s\",\"name\":\"nodes\",\"rules\":[{\"alert\":\"NodeExporterDown\",\"annotations\":{\"description\":\"Prometheus exporter down\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Exporter down (instance {{ $labels.instance }})\"},\"expr\":\"up{job=\\\"nodes\\\"} == 0\",\"for\":\"1m\",\"labels\":{\"frequency\":\"2m\",\"severity\":\"critical\"}},{\"expr\":\"(time() - node_boot_time_seconds{role=\\\"hypervisor\\\"}) < bool 1800\\n\",\"record\":\"vpsfree_hypervisor_booting\"},{\"alert\":\"HypervisorBooting\",\"annotations\":{\"description\":\"This alert fires when a node is booting. It can be used to inhibit\\nother alerts. It should be blackholed by Alertmanager.\\n\"},\"expr\":\"vpsfree_hypervisor_booting == 1\",\"labels\":{\"severity\":\"none\"}},{\"alert\":\"HypervisorEmpty\",\"annotations\":{\"description\":\"This alert fires when a node is booting. It can be used to inhibit\\nother alerts. It should be blackholed by Alertmanager.\\n\"},\"expr\":\"osctl_pool_containers_count{role=\\\"hypervisor\\\",state=\\\"running\\\"} == 0\",\"labels\":{\"severity\":\"none\"}},{\"alert\":\"HypervisorNearlyEmpty\",\"annotations\":{\"description\":\"This alert fires when a node is booting. It can be used to inhibit\\nother alerts. It should be blackholed by Alertmanager.\\n\"},\"expr\":\"osctl_pool_containers_count{role=\\\"hypervisor\\\",state=\\\"running\\\"} <= 10\",\"labels\":{\"severity\":\"none\"}},{\"alert\":\"HypervisorHighCpuLoad\",\"annotations\":{\"description\":\"CPU load is > 80%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"High CPU load (instance {{ $labels.instance }})\"},\"expr\":\"100 - (avg by(instance, alias, fqdn) (irate(node_cpu_seconds_total{mode=\\\"idle\\\",role=\\\"hypervisor\\\",location!~\\\"stg|pgnd\\\"}[5m])) * 100) > 80 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"10m\",\"labels\":{\"alertclass\":\"cpuload\",\"severity\":\"warning\"}},{\"alert\":\"HypervisorHighCpuLoadStaging\",\"annotations\":{\"description\":\"CPU load is > 80%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"High CPU load (instance {{ $labels.instance }})\"},\"expr\":\"100 - (avg by(instance, alias, fqdn, location) (irate(node_cpu_seconds_total{mode=\\\"idle\\\",role=\\\"hypervisor\\\",location=~\\\"stg|pgnd\\\"}[5m])) * 100) > 80 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"50m\",\"labels\":{\"alertclass\":\"cpuload\",\"severity\":\"warning\"}},{\"alert\":\"HypervisorCritOsCpuLoad\",\"annotations\":{\"description\":\"CPU load is > 90%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Critical CPU load (instance {{ $labels.instance }})\"},\"expr\":\"100 - (avg by(instance, alias, fqdn) (irate(node_cpu_seconds_total{mode=\\\"idle\\\",role=\\\"hypervisor\\\",os=\\\"vpsadminos\\\",location!~\\\"stg|pgnd\\\"}[5m])) * 100) > 90 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"10m\",\"labels\":{\"alertclass\":\"cpuload\",\"severity\":\"critical\"}},{\"alert\":\"HypervisorCritOsCpuLoadStaging\",\"annotations\":{\"description\":\"CPU load is > 90%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Critical CPU load (instance {{ $labels.instance }})\"},\"expr\":\"100 - (avg by(instance, alias, fqdn, location) (irate(node_cpu_seconds_total{mode=\\\"idle\\\",role=\\\"hypervisor\\\",os=\\\"vpsadminos\\\",location=~\\\"stg|pgnd\\\"}[5m])) * 100) > 90 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"50m\",\"labels\":{\"alertclass\":\"cpuload\",\"severity\":\"critical\"}},{\"alert\":\"HypervisorHighIoWait\",\"annotations\":{\"description\":\"CPU iowait is > 20%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"High CPU iowait (instance {{ $labels.instance }})\"},\"expr\":\"(avg by(instance, alias, fqdn) (irate(node_cpu_seconds_total{mode=\\\"iowait\\\",role=\\\"hypervisor\\\"}[5m])) * 100) > 20 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"10m\",\"labels\":{\"alertclass\":\"iowait\",\"severity\":\"warning\"}},{\"alert\":\"HypervisorCritIoWait\",\"annotations\":{\"description\":\"CPU iowait is > 40%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Critical CPU iowait (instance {{ $labels.instance }})\"},\"expr\":\"(avg by(instance, alias, fqdn) (irate(node_cpu_seconds_total{mode=\\\"iowait\\\",role=\\\"hypervisor\\\"}[5m])) * 100) > 40 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"10m\",\"labels\":{\"alertclass\":\"iowait\",\"severity\":\"critical\"}},{\"alert\":\"HypervisorFatalIoWait\",\"annotations\":{\"description\":\"CPU iowait is > 50%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Critical CPU iowait (instance {{ $labels.instance }})\"},\"expr\":\"(avg by(instance, alias, fqdn) (irate(node_cpu_seconds_total{mode=\\\"iowait\\\",role=\\\"hypervisor\\\"}[5m])) * 100) > 50 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"20m\",\"labels\":{\"alertclass\":\"iowait\",\"severity\":\"critical\"}},{\"alert\":\"HypervisorLongHighIoWait\",\"annotations\":{\"description\":\"CPU iowait is > 10% for too long\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Long-term high CPU iowait (instance {{ $labels.instance }})\"},\"expr\":\"(avg by(instance, alias, fqdn) (irate(node_cpu_seconds_total{mode=\\\"iowait\\\",role=\\\"hypervisor\\\"}[5m])) * 100) > 10 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"6h\",\"labels\":{\"alertclass\":\"iowait\",\"severity\":\"warning\"}},{\"alert\":\"StorageHighCpuLoad\",\"annotations\":{\"description\":\"CPU load is > 80%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"High CPU load (instance {{ $labels.instance }})\"},\"expr\":\"100 - (avg by(instance, alias, fqdn) (irate(node_cpu_seconds_total{mode=\\\"idle\\\",role=\\\"storage\\\"}[5m])) * 100) > 80\",\"for\":\"15m\",\"labels\":{\"severity\":\"warning\"}},{\"alert\":\"StorageHighIoWait\",\"annotations\":{\"description\":\"CPU iowait is > 30%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"High CPU iowait (instance {{ $labels.instance }})\"},\"expr\":\"(avg by(instance, alias, fqdn) (irate(node_cpu_seconds_total{mode=\\\"iowait\\\",role=\\\"storage\\\"}[5m])) * 100) > 30\",\"for\":\"15m\",\"labels\":{\"severity\":\"warning\"}},{\"alert\":\"StorageCritPoolFreeSpace\",\"annotations\":{\"description\":\"Top-level pool dataset {{ $labels.name }} on pool {{ $labels.pool }} has less than 1 TB available\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Low top-level pool dataset free space (instance {{ $labels.instance }})\"},\"expr\":\"zfs_dataset_available_bytes{job=\\\"nodes\\\",role=\\\"storage\\\",type=\\\"filesystem\\\",name!~\\\".*/.*\\\"} < 1024 * 1024 * 1024 * 1024\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"zpoolcap\",\"frequency\":\"hourly\",\"severity\":\"critical\"}},{\"alert\":\"HypervisorCritPoolFreeSpace\",\"annotations\":{\"description\":\"Top-level pool dataset {{ $labels.name }} on pool {{ $labels.pool }} has less than 512 GB available\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Low top-level pool dataset free space (instance {{ $labels.instance }})\"},\"expr\":\"zfs_dataset_available_bytes{job=\\\"nodes\\\",role=\\\"hypervisor\\\",type=\\\"filesystem\\\",name!~\\\".*/.*\\\"} < 512 * 1024 * 1024 * 1024\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"zpoolcap\",\"frequency\":\"hourly\",\"severity\":\"critical\"}},{\"alert\":\"HypervisorFatalPoolFreeSpace\",\"annotations\":{\"description\":\"Top-level pool dataset {{ $labels.name }} on pool {{ $labels.pool }} has less than 256 GB available\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Low top-level pool dataset free space (instance {{ $labels.instance }})\"},\"expr\":\"zfs_dataset_available_bytes{job=\\\"nodes\\\",role=\\\"hypervisor\\\",type=\\\"filesystem\\\",name!~\\\".*/.*\\\"} < 256 * 1024 * 1024 * 1024\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"zpoolcap\",\"frequency\":\"10m\",\"severity\":\"fatal\"}},{\"alert\":\"HypervisorLowZfsArcC\",\"annotations\":{\"description\":\"ZFS arc_c is too low (less than 1/8 of total memory)\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"ZFS arc_c too low (instance {{ $labels.instance }})\"},\"expr\":\"node_zfs_arc_c{role=\\\"hypervisor\\\"} < (node_memory_MemTotal_bytes / 8) and on(instance) (avg by(instance) (irate(node_cpu_seconds_total{mode=\\\"iowait\\\",role=\\\"hypervisor\\\"}[5m])) * 100) > 10\",\"for\":\"5m\",\"labels\":{\"severity\":\"warning\"}},{\"alert\":\"HypervisorHighArcMetaUsed\",\"annotations\":{\"description\":\"ZFS arc_meta_used uses more than 80% of arc_size\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"ZFS arc_meta_used uses too much of arc_size (instance {{ $labels.instance }})\"},\"expr\":\"node_zfs_arc_arc_meta_used{role=\\\"hypervisor\\\"} / node_zfs_arc_size * 100 > 80 and on(instance) (avg by(instance) (irate(node_cpu_seconds_total{mode=\\\"iowait\\\",role=\\\"hypervisor\\\"}[5m])) * 100) > 10\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"arcmetaused\",\"severity\":\"warning\"}},{\"alert\":\"HypervisorCritArcMetaUsed\",\"annotations\":{\"description\":\"ZFS arc_meta_used uses more than 90% of arc_size\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"ZFS arc_meta_used uses too much of arc_size (instance {{ $labels.instance }})\"},\"expr\":\"node_zfs_arc_arc_meta_used{role=\\\"hypervisor\\\"} / node_zfs_arc_size * 100 > 90 and on(instance) (avg by(instance) (irate(node_cpu_seconds_total{mode=\\\"iowait\\\",role=\\\"hypervisor\\\"}[5m])) * 100) > 20\",\"for\":\"10m\",\"labels\":{\"alertclass\":\"arcmetaused\",\"severity\":\"critical\"}},{\"alert\":\"NodeHighTxgCount\",\"annotations\":{\"description\":\"ZFS makes more than 20 TXGs per minute\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"ZFS high TXG count per minute (instance {{ $labels.instance }})\"},\"expr\":\"rate(zpool_txgs_count{job=\\\"nodes\\\"}[5m]) * 60 >= 20\",\"for\":\"2m\",\"labels\":{\"alertclass\":\"txgcount\",\"severity\":\"warning\"}},{\"alert\":\"NodeCritNoTxgs\",\"annotations\":{\"description\":\"ZFS made less than 1 TXG in three minutes\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"ZFS not making TXGs (instance {{ $labels.instance }})\"},\"expr\":\"rate(zpool_txgs_count{job=\\\"nodes\\\",role=\\\"hypervisor\\\"}[5m]) * 180 < 1\",\"for\":\"1m\",\"labels\":{\"alertclass\":\"nodenotxgs\",\"frequency\":\"2m\",\"severity\":\"critical\"}},{\"alert\":\"NodeFatalNoTxgs\",\"annotations\":{\"description\":\"ZFS made less than 1 TXG in four minutes\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"ZFS not making TXGs (instance {{ $labels.instance }})\"},\"expr\":\"rate(zpool_txgs_count{job=\\\"nodes\\\",role=\\\"hypervisor\\\"}[2m]) * 240 < 1\",\"for\":\"1m\",\"labels\":{\"alertclass\":\"nodenotxgs\",\"frequency\":\"2m\",\"severity\":\"fatal\"}},{\"alert\":\"StorageCritNoTxgs\",\"annotations\":{\"description\":\"ZFS made less than 1 TXG in four minutes\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"ZFS not making TXGs (instance {{ $labels.instance }})\"},\"expr\":\"rate(zpool_txgs_count{job=\\\"nodes\\\",role=\\\"storage\\\"}[5m]) * 240 < 1\",\"for\":\"1m\",\"labels\":{\"alertclass\":\"storagenotxgs\",\"frequency\":\"2m\",\"severity\":\"critical\"}},{\"alert\":\"StorageFatalNoTxgs\",\"annotations\":{\"description\":\"ZFS made less than 1 TXG in 30 minutes\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"ZFS not making TXGs (instance {{ $labels.instance }})\"},\"expr\":\"rate(zpool_txgs_count{job=\\\"nodes\\\",role=\\\"storage\\\"}[5m]) * 1800 < 1\",\"for\":\"1m\",\"labels\":{\"alertclass\":\"storagenotxgs\",\"frequency\":\"2m\",\"severity\":\"fatal\"}},{\"alert\":\"HypervisorFatalNoSsdWrites\",\"annotations\":{\"description\":\"Block devices not showing any writes\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Block devices not showing any writes (instance {{ $labels.instance }})\"},\"expr\":\"sum by (alias,fqdn) (increase(node_disk_written_bytes_total{job=\\\"nodes\\\",role=\\\"hypervisor\\\",storage_type=~\\\"hdd|ssd\\\",device=~\\\"sd.+\\\"}[1m])) == 0\",\"labels\":{\"alertclass\":\"nowrites\",\"alertwhen\":\"inuse\",\"frequency\":\"2m\",\"severity\":\"fatal\"}},{\"alert\":\"HypervisorFatalNoNvmeWrites\",\"annotations\":{\"description\":\"Block devices not showing any writes\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Block devices not showing any writes (instance {{ $labels.instance }})\"},\"expr\":\"sum by (alias,fqdn) (increase(node_disk_written_bytes_total{job=\\\"nodes\\\",role=\\\"hypervisor\\\",storage_type=\\\"nvme\\\",device=~\\\"nvme.+\\\"}[1m])) == 0\",\"labels\":{\"alertclass\":\"nowrites\",\"alertwhen\":\"inuse\",\"frequency\":\"2m\",\"severity\":\"fatal\"}},{\"alert\":\"NodeFatalRootfsFreeSpace\",\"annotations\":{\"description\":\"Rootfs uses more than 95% of available space\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Not enough free space on rootfs (instance {{ $labels.instance }})\"},\"expr\":\"(node_filesystem_avail_bytes{job=\\\"nodes\\\",mountpoint=\\\"/\\\"} / node_filesystem_size_bytes) * 100 <= 5\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"fsavail\",\"frequency\":\"5m\",\"severity\":\"fatal\"}},{\"alert\":\"NodeHighLoad\",\"annotations\":{\"description\":\"5 minute load average is too high\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Load average too high (instance {{ $labels.instance }})\"},\"expr\":\"node_load5{job=\\\"nodes\\\",location!=\\\"stg\\\"} > 300 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"loadavg\",\"severity\":\"warning\"}},{\"alert\":\"NodeHighLoadStaging\",\"annotations\":{\"description\":\"5 minute load average is too high\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Load average too high (instance {{ $labels.instance }})\"},\"expr\":\"node_load5{job=\\\"nodes\\\",location=\\\"stg\\\"} > 300 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"10m\",\"labels\":{\"alertclass\":\"loadavg\",\"location\":\"stg\",\"severity\":\"warning\"}},{\"alert\":\"NodeCritLoad\",\"annotations\":{\"description\":\"5 minute load average is too high\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Load average critical (instance {{ $labels.instance }})\"},\"expr\":\"node_load5{job=\\\"nodes\\\",location!=\\\"stg\\\"} > 1000\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"loadavg\",\"frequency\":\"hourly\",\"severity\":\"critical\"}},{\"alert\":\"NodeCritLoadStaging\",\"annotations\":{\"description\":\"5 minute load average is too high\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Load average critical (instance {{ $labels.instance }})\"},\"expr\"