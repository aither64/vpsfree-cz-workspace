s.instance }})\"},\"expr\":\"up{job=\\\"http_vpsfree_cz\\\"} == 0\",\"for\":\"10m\",\"labels\":{\"frequency\":\"hourly\",\"severity\":\"critical\"}},{\"alert\":\"VpsFreeOrgExporterDown\",\"annotations\":{\"description\":\"Unable to check web availability\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Web exporter is down (instance {{ $labels.instance }})\"},\"expr\":\"up{job=\\\"http_vpsfree_org\\\"} == 0\",\"for\":\"10m\",\"labels\":{\"frequency\":\"hourly\",\"severity\":\"critical\"}},{\"alert\":\"VpsFreeWebDown\",\"annotations\":{\"description\":\"{{ $labels.instance }} does not return the expected HTTP response\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"vpsFree web probe failed (instance {{ $labels.instance }})\"},\"expr\":\"probe_success{type=\\\"vpsfree-web\\\"} == 0\",\"for\":\"120s\",\"labels\":{\"frequency\":\"5m\",\"severity\":\"critical\"}},{\"alert\":\"VpsfStatusDown\",\"annotations\":{\"description\":\"{{ $labels.instance }} does not return the expected HTTP response\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"status.vpsf.cz HTTP probe failed (instance {{ $labels.instance }})\"},\"expr\":\"probe_success{type=\\\"vpsf-status\\\"} == 0\",\"for\":\"120s\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"VpsFreePublicServiceExporterDown\",\"annotations\":{\"description\":\"Unable to check public HTTP service availability\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Public HTTP exporter is down (instance {{ $labels.instance }})\"},\"expr\":\"up{job=~\\\"http_(kb_vpsfree_cz|kb_vpsfree_org|rubygems_vpsfree_cz|paste_vpsfree_cz|discourse_vpsfree_cz|munin_vpsfree_cz|grafana_prg_vpsfree_cz)\\\"} == 0\",\"for\":\"10m\",\"labels\":{\"frequency\":\"hourly\",\"severity\":\"warning\"}},{\"alert\":\"VpsFreePublicServiceProbeFailed\",\"annotations\":{\"description\":\"{{ $labels.instance }} does not return the expected HTTP response\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Public HTTP probe failed (instance {{ $labels.instance }})\"},\"