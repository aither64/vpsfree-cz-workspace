"cmakeFlags":"","configureFlags":"","content":"exec /nix/store/dzk9nlvp0b53xm9wifz3jqy0k5dhksh8-python3.13-flake8-7.3.0/bin/flake8 --show-source --ignore E501,W503 \"$1\"\n","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","interpreter":"/nix/store/rw3q446sci75bwjg8xrhgv0cjs4slch0-dash-0.5.13.3/bin/dash","makeWrapperArgs":"","mesonFlags":"","name":"pythoncheck.sh","nativeBuildInputs":"/nix/store/01gh6jng9881dmkwr055p0z3x15jvk8c-make-binary-wrapper-hook","out":"/nix/store/a52ccbnsgl2pmpvfl4hnrqhrqlrr8lwy-pythoncheck.sh","outputs":"out","passAsFile":"buildCommand content","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"2hrk66lqj9lfi3nqsbfw8zddyzmcr85m-python3.13-flake8-7.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"czsvlgwfqq996pdbqp8d7lvjbrl7vgzc-dash-0.5.13.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"jzfv1mdbc1gpmmlx04il205rbkww8yjq-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"pythoncheck.sh","outputs":{"out":{"path":"a52ccbnsgl2pmpvfl4hnrqhrqlrr8lwy-pythoncheck.sh"}},"system":"x86_64-linux","version":4},"qhv2ilydgb1l254xqkc71g8gw8ryygl9-symlink-0.1.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-build