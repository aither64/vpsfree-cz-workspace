mvb0i1i8iz-bootstrap-stage1-gcc-wrapper-15.3.0\" /no-such-path \\\n  --replace \"/nix/store/13s3avx5gh5jfqr2v1f9z78ph5gzg4r0-gcc-15.3.0\" /no-such-path \\\n  --replace \"/no-such-path\" /no-such-path \\\n  --replace \"$man\" /no-such-path\n","postPatch":"substituteInPlace dist/PathTools/Cwd.pm \\\n  --replace \"/bin/pwd\" \"$(type -P pwd)\"\n# Perl's build system uses the src variable, and its value may end up in\n# the output in some cases (when cross-compiling).\nunset src\n","preConfigure":"cat > config.over <<EOF\nosvers=\"gnulinux\"\nmyuname=\"nixpkgs\"\nmyhostname=\"nixpkgs\"\ncf_by=\"nixpkgs\"\ncf_time=\"$(date -d \"@$SOURCE_DATE_EPOCH\")\"\nEOF\n\n# Compress::Raw::Zlib should use our zlib package instead of the one\n# included with the distribution\ncat > ./cpan/Compress-Raw-Zlib/config.in <<EOF\nBUILD_ZLIB   = False\nINCLUDE      = /nix/store/axhn9b8sb1dflif3n6n36xja2hxpk89h-zlib-1.3.2-dev/include\nLIB          = /nix/store/ld3jwvl2190557phm7x1hgvzmsnx8bcy-zlib-1.3.2/lib\nOLD_ZLIB     = False\nGZIP_OS_CODE = AUTO_DETECT\nUSE_ZLIB_NG  = False\nZLIB_INCLUDE = /nix/store/axhn9b8sb1dflif3n6n36xja2hxpk89h-zlib-1.3.2-dev/include\nZLIB_LIB     = /nix/store/ld3jwvl2190557phm7x1hgvzmsnx8bcy-zlib-1.3.2/lib\nEOF\n# We need to do this because the bootstrap doesn't have a static libpthread\nsed -i 's,\\(libswanted.*\\)pthread,\\1,g' Configure\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setOutputFlags":"","setupHook":"/nix/store/dm81j9qdcdr4c458pqbc9wvq9ymgzk4m-setup-hook.sh","src":"/nix/store/m2qam71fmv9f8vyliw7741lr87mbxcwk-perl-5.42.3.tar.gz","stdenv":"/nix/store/93mabyq3gv1mbg2jhfm1wvrby3222kbd-bootstrap-stage1-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"5.42.3"},"inputs":{"drvs":{"7xndndh5sjhkyz8hsra61cskr0vdvc8z-gcc-15.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"fbf01swvxyly217m977fwnkvaw8m6srh-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"i5vdzi50awjn7zbi92rc7hbl5bxa2ci1-bootstrap-stage1-gcc-wrapper-