 | $NL2SP/' ltmain.sh\n# alias makeinfo to true\nmkdir aliases\nln -s /nix/store/wb7pvclab1aaa7myi0jafbjc60d5yij5-bootstrap-coreutils-5.0/bin/true aliases/makeinfo\nexport PATH=\"$(pwd)/aliases/:$PATH\"\n\n# Configure\nexport CC=\"tcc -B /nix/store/a2vic34l7rx2vyxysp7wlqd196pm4gzx-tinycc-musl-unstable-2025-12-03-libs/lib\"\nexport AR=\"tcc -ar\"\nexport lt_cv_sys_max_cmd_len=32768\n\nexport CFLAGS=\"-D__LITTLE_ENDIAN__=1\"\nbash ./configure --prefix=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9 --build=x86_64-unknown-linux-gnu --host=x86_64-unknown-linux-gnu --with-sysroot=/ --disable-dependency-tracking --disable-nls --enable-deterministic-archives --disable-gprofng --enable-new-dtags --with-lib-path=:\n\n# Build\nmake -j $NIX_BUILD_CORES all-libiberty all-gas all-bfd all-libctf all-zlib all-gprof\nmake all-ld # race condition on ld/.deps/ldwrite.Po, serialize\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install\n\n# gprof/addr2line/elfedit + man pages are unused downstream.\nrm -f $out/bin/gprof $out/bin/addr2line $out/bin/elfedit\nrm -rf $out/share/info $out/share/man\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"binutils-2.46.0","out":"/nix/store/z8va212wrar5kxwv4ivlalrzasm2clx1-binutils-2.46.0","passAsFile":"buildCommand","pname":"binutils","system":"x86_64-linux","version":"2.46.0"},"inputs":{"drvs":{"3zhi7fn92ym1ds0n3yybmjyjvksypi39-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"4hfq6p045k7knv86fc57kq5cnf2djia6-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gwpvw0ssr7xmfzvy97c6f493fhc2f7r-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"cblshqv4b81g5gxis3zpb4inagkaffi1-binutils-2.46.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"d9hngw468h7b7fpcyx284kqwdgcn3gzy-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"j1aiw0pfh51n