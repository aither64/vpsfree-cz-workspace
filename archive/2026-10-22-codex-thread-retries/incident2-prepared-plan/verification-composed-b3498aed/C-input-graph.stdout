\",\"annotations\":{\"description\":\"VALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Packet loss detected (instance {{ $labels.instance }})\"},\"expr\":\"rate(node_network_transmit_drop_total{device=~\\\"(teng.+)|(oneg.+)\\\"}[5m]) > 0 or rate(node_network_receive_drop_total{device=~\\\"(teng.+)|(oneg.+)\\\"}[5m]) > 0\",\"for\":\"10m\",\"labels\":{\"alertclass\":\"packetloss\",\"frequency\":\"15m\",\"severity\":\"warning\"}}]},{\"name\":\"infra\",\"rules\":[{\"alert\":\"InfraExporterDown\",\"annotations\":{\"description\":\"Prometheus exporter down\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Exporter down (instance {{ $labels.instance }})\"},\"expr\":\"up{job=\\\"infra\\\"} == 0\",\"for\":\"10m\",\"labels\":{\"severity\":\"critical\"}},{\"alert\":\"InfraHighCpuLoad\",\"annotations\":{\"description\":\"CPU load is > 80%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"High CPU load (instance {{ $labels.instance }})\"},\"expr\":\"100 - (avg by(instance, alias, fqdn) (irate(node_cpu_seconds_total{mode=\\\"idle\\\",job=\\\"infra\\\"}[5m])) * 100) > 80 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"10m\",\"labels\":{\"severity\":\"warning\"}},{\"alert\":\"InfraHighIoWait\",\"annotations\":{\"description\":\"CPU iowait is > 30%\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"High CPU iowait (instance {{ $labels.instance }})\"},\"expr\":\"(avg by(instance, alias, fqdn) (irate(node_cpu_seconds_total{mode=\\\"iowait\\\",job=\\\"infra\\\"}[5m])) * 100) > 30 and on(instance) time() - node_boot_time_seconds > 3600\",\"for\":\"10m\",\"labels\":{\"severity\":\"warning\"}},{\"alert\":\"InfraHighLoad\",\"annotations\":{\"description\":\"5 minute load average is too high\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Load average too high (instance {{ $labels.instance }})\"},\"expr\":\"node_load5{job=\\\"infra\\\"} > 300 and on(instance) time() - node_boot_ti