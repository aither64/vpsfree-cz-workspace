0\",\"for\":\"15m\",\"labels\":{\"alertclass\":\"sshdown\",\"frequency\":\"2m\",\"severity\":\"fatal\"}},{\"alert\":\"NodeSshLoginWarn\",\"annotations\":{\"description\":\"Node SSH login takes too long\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Node SSH login takes too long (instance {{ $labels.instance }})\"},\"expr\":\"ssh_host_check_seconds{job=\\\"ssh-exporters\\\"} > 10\",\"labels\":{\"alertclass\":\"sshtime\",\"frequency\":\"1h\",\"severity\":\"warning\"}},{\"alert\":\"NodeSshLoginCrit\",\"annotations\":{\"description\":\"Node SSH login takes too long\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Node SSH login takes too long (instance {{ $labels.instance }})\"},\"expr\":\"ssh_host_check_seconds{job=\\\"ssh-exporters\\\"} >= 30\",\"for\":\"2m\",\"labels\":{\"alertclass\":\"sshtime\",\"frequency\":\"10m\",\"severity\":\"critical\"}},{\"alert\":\"NodeSshCritLoad\",\"annotations\":{\"description\":\"Node load average fetched over SSH is too high\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Node loadavg is too high (instance {{ $labels.instance }})\"},\"expr\":\"up{job=\\\"nodes\\\"} == 0 and on (fqdn) ssh_host_load1 > 1000\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"sshload\",\"frequency\":\"5m\",\"severity\":\"critical\"}},{\"alert\":\"NodeSshFatalLoad\",\"annotations\":{\"description\":\"Node load average fetched over SSH is too high\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Node loadavg is too high (instance {{ $labels.instance }})\"},\"expr\":\"up{job=\\\"nodes\\\"} == 0 and on (fqdn) ssh_host_load1 > 2000\",\"for\":\"5m\",\"labels\":{\"alertclass\":\"sshload\",\"frequency\":\"5m\",\"severity\":\"fatal\"}},{\"alert\":\"KernelPtyWarn\",\"annotations\":{\"description\":\"More than 4096 allocated PTYs. In general, 6 PTYs are needed for 1 VPS.\\n\\nVALUE = {{ $value }}\\nLABELS: {{ $labels }}\\n\",\"summary\":\"High PTY count (instance {{ $labels.instance }})\"},