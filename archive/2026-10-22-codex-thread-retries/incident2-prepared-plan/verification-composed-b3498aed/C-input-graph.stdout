or\":\"10m\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"VpsAdminWebuiNotActive\",\"annotations\":{\"description\":\"phpfpm-vpsadmin-webui.service on {{ $labels.node_name }} is not active\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"phpfpm-vpsadmin-webui.service on {{ $labels.node_name }} is not active\"},\"expr\":\"node_systemd_unit_state{name=\\\"phpfpm-vpsadmin-webui.service\\\",state=\\\"active\\\"} == 0\",\"for\":\"10m\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"NewadminBffNotActive\",\"annotations\":{\"summary\":\"newadmin BFF unit is inactive or missing on {{ $labels.fqdn }}\"},\"expr\":\"up{job=\\\"infra\\\",fqdn=\\\"vpsadmin-webui1.int.vpsfree.cz\\\"} == 1\\nunless on(instance)\\nnode_systemd_unit_state{job=\\\"infra\\\",fqdn=\\\"vpsadmin-webui1.int.vpsfree.cz\\\",name=\\\"vpsadmin-webui-bff.service\\\",state=\\\"active\\\"} == 1\\n\",\"for\":\"10m\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"NewadminInfraScrapeMissing\",\"annotations\":{\"summary\":\"newadmin host metrics are missing for {{ $labels.fqdn }}\"},\"expr\":\"absent(up{job=\\\"infra\\\",fqdn=\\\"vpsadmin-webui1.int.vpsfree.cz\\\"})\\nor up{job=\\\"infra\\\",fqdn=\\\"vpsadmin-webui1.int.vpsfree.cz\\\"} == 0\\n\",\"for\":\"10m\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"NewadminCertificateExpiring\",\"annotations\":{\"summary\":\"newadmin.vpsfree.cz TLS certificate expires within 14 days\"},\"expr\":\"probe_ssl_earliest_cert_expiry{job=\\\"http_newadmin_vpsfree_cz\\\"} - time() < 14 * 24 * 60 * 60\\n\",\"for\":\"10m\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"NewadminFrontendProbeMissing\",\"annotations\":{\"summary\":\"newadmin frontend HTTP probe metrics are missing\"},\"expr\":\"absent(up{job=\\\"http_newadmin_vpsfree_cz\\\"})\\nor absent(probe_success{job=\\\"http_newadmin_vpsfree_cz\\\"})\\n\",\"for\":\"10m\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"NewadminBffProbeMissing\",\"annotations\":{\"summary\":\"newadmin BFF HTTP probe metrics are missing\"},\"expr\":\"absent(up{job=\\\"http_newadmin_bff_vpsfree_cz\\\"})\\nor absent(probe_success{job=\\\"http_newadmin_bff_vpsfree_cz\\\"})\\n\",\"for\":\"10m\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"VpsAdminPasswordRecoveryQueueFull\",\"annotations\":{\"description\":\"The vpsAdmin password recovery queue is full or reached its global\\ncapacity during the last ten minutes. Check\\nvpsadmin-password-recovery.service and the incoming request volume.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"vpsAdmin password recovery queue reached its global capacity\"},\"expr\":\"max(vpsadmin_password_recovery_pending_submissions)\\n  >= max(vpsadmin_password_recovery_submission_limit)\\nor\\ntime() - max(vpsadmin_password_recovery_queue_capacity_last_reached_timestamp_seconds)\\n  < 10 * 60\\n\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"VpsAdminConsoleRouterNotActive\",\"annotations\":{\"description\":\"vpsadmin-console-router.service on {{ $labels.node_name }} is not active\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"vpsadmin-console-router.service on {{ $labels.node_name }} is not active\"},\"expr\":\"node_systemd_unit_state{name=\\\"vpsadmin-console-router.service\\\",state=\\\"active\\\"} == 0\",\"for\":\"10m\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"NodeCtldUnresponsive\",\"annotations\":{\"description\":\"nodectld on {{ $labels.node_name }} is not responding\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"nodectld on {{ $labels.node_name }} is not responding\"},\"expr\":\"vpsadmin_node_last_report_seconds{node_platform=\\\"vpsadminos\\\"} >= 90\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"TransactionChainFatal\",\"annotations\":{\"description\":\"Transaction chain {{ $labels.chain_id }} ({{ $labels.chain_type }})\\nis in state fatal and needs to be resolved.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Transaction chain {{ $labels.chain_id }} is in state fatal\"},\"expr\":\"vpsadmin_transaction_chain_fatal == 1\",\"labels\":{\"frequency\":\"1h\",\"severity\":\"warning\"}},{\"alert\":\"VpsMigrationFatal\",\"annotations\":{\"description\":\"Transaction chain {{ $labels.chain_id }} ({{ $labels.chain_type }})\\nis in state fatal and needs to be resolved.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Transaction chain {{ $labels.chain_id }} is in state fatal\"},\"expr\":\"vpsadmin_transaction_chain_fatal{chain_type=\\\"TransactionChains::Vps::Migrate::OsToOs\\\"} == 1\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"fatal\"}},{\"alert\":\"VpsStartDelayed\",\"annotations\":{\"description\":\"Transaction chain {{ $labels.chain_id }} ({{ $labels.chain_type }})\\nis in state {{ $labels.chain_state }} for too long and is potentially\\nstuck.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Transaction chain {{ $labels.chain_id }} takes too long to start a VPS\"},\"expr\":\"vpsadmin_transaction_chain_queued_seconds{chain_type=\\\"TransactionChains::Vps::Start\\\"} >= 15*60\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"critical\"}},{\"alert\":\"VpsRestartDelayed\",\"annotations\":{\"description\":\"Transaction chain {{ $labels.chain_id }} ({{ $labels.chain_type }})\\nis in state {{ $labels.chain_state }} for too long and is potentially\\nstuck.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Transaction chain {{ $labels.chain_id }} takes too long to restart a VPS\"},\"expr\":\"vpsadmin_transaction_chain_queued_seconds{chain_type=\\\"TransactionChains::Vps::Restart\\\"} >= 15*60\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"critical\"}},{\"alert\":\"VpsStopDelayed\",\"annotations\":{\"description\":\"Transaction chain {{ $labels.chain_id }} ({{ $labels.chain_type }})\\nis in state {{ $labels.chain_state }} for too long and is potentially\\nstuck.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Transaction chain {{ $labels.chain_id }} takes too long to stop a VPS\"},\"expr\":\"vpsadmin_transaction_chain_queued_seconds{chain_type=\\\"TransactionChains::Vps::Stop\\\"} >= 15*60\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"critical\"}},{\"alert\":\"VpsMigrationDelayed\",\"annotations\":{\"description\":\"Transaction chain {{ $labels.chain_id }} ({{ $labels.chain_type }})\\nis in state {{ $labels.chain_state }} for too long and is potentially\\nstuck.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Transaction chain {{ $labels.chain_id }} takes too long to migrate a VPS\"},\"expr\":\"vpsadmin_transaction_chain_queued_seconds{chain_type=\\\"TransactionChains::Vps::Migrate::OsToOs\\\"} >= 24*60*60\",\"labels\":{\"frequency\":\"10m\",\"severity\":\"warning\"}},{\"alert\":\"DatasetBackupDelayed\",\"annotations\":{\"description\":\"Transaction chain {{ $labels.chain_id }} ({{ $labels.chain_type }})\\nis in state {{ $labels.chain_state }} for too long and is potentially\\nstuck.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Transaction chain {{ $labels.chain_id }} takes too long\"},\"expr\":\"vpsadmin_transaction_chain_queued_seconds{chain_type=\\\"TransactionChains::Dataset::Backup\\\"} >= 12*60*60\",\"labels\":{\"frequency\":\"1h\",\"severity\":\"warning\"}},{\"alert\":\"BackupDownloadDelayed\",\"annotations\":{\"description\":\"Transaction chain {{ $labels.chain_id }} ({{ $labels.chain_type }})\\nis in state {{ $labels.chain_state }} for too long and is potentially\\nstuck.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Transaction chain {{ $labels.chain_id }} takes too long\"},\"expr\":\"vpsadmin_transaction_chain_queued_seconds{chain_type=\\\"TransactionChains::Dataset::FullDownload\\\"} >= 12*60*60\",\"labels\":{\"frequency\":\"1h\",\"severity\":\"warning\"}},{\"alert\":\"TransactionChainDelayed\",\"annotations\":{\"description\":\"Transaction chain {{ $labels.chain_id }} ({{ $labels.chain_type }})\\nis in state {{ $labels.chain_state }} for too long and is potentially\\nstuck.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Transaction chain {{ $labels.chain_id }} takes too long\"},\"expr\":\"vpsadmin_transaction_chain_queued_seconds{chain_type!~\\\"TransactionChains::Dataset::Backup|TransactionChains::Dataset::FullDownload|TransactionChains::Vps::Start|TransactionChains::Vps::Restart|TransactionChains::Vps::Stop|TransactionChains::Vps::Migrate::OsToOs\\\"} >= 3*60*60\",\"labels\":{\"frequency\":\"15m\",\"severity\":\"warning\"}},{\"alert\":\"DatasetExpansionCountWarn\",\"annotations\":{\"description\":\"Dataset {{ $labels.dataset_name }} in VPS {{ $labels.vps_id }} on {{ $labels.vps_node }}\\nis expanded more than 3 times.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS {{ $labels.vps_id }} on {{ $labels.vps_node }} expanded >3 times\"},\"expr\":\"vpsadmin_dataset_expansion_count > 3\",\"labels\":{\"frequency\":\"6h\",\"severity\":\"warning\"}},{\"alert\":\"DatasetExpansionCountCrit\",\"annotations\":{\"description\":\"Dataset {{ $labels.dataset_name }} in VPS {{ $labels.vps_id }} on {{ $labels.vps_node }}\\nis expanded more than 5 times.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS {{ $labels.vps_id }} on {{ $labels.vps_node }} expanded >5 times\"},\"expr\":\"vpsadmin_dataset_expansion_count > 5\",\"labels\":{\"frequency\":\"6h\",\"severity\":\"critical\"}},{\"alert\":\"DatasetExpansionSpaceWarn\",\"annotations\":{\"description\":\"Dataset {{ $labels.dataset_name }} in VPS {{ $labels.vps_id }} on {{ $labels.vps_node }}\\nuses more than 100G of extra space.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS {{ $labels.vps_id }} on {{ $labels.vps_node }} given >100G\"},\"expr\":\"vpsadmin_dataset_expansion_added_bytes > 100*1024*1024*1024\",\"labels\":{\"frequency\":\"6h\",\"severity\":\"warning\"}},{\"alert\":\"DatasetExpansionDeadlineWarn\",\"annotations\":{\"description\":\"Dataset {{ $labels.dataset_name }} in VPS {{ $labels.vps_id }} on {{ $labels.vps_node }}\\nhas exceeded its deadline.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"VPS {{ $labels.vps_id }} on {{ $labels.vps_node }} is expanded for too long\"},\"expr\":\"vpsadmin_dataset_expansion_over_refquota_seconds > vpsadmin_dataset_expansion_max_over_refquota_seconds\",\"labels\":{\"frequency\":\"12h\",\"severity\":\"warning\"}},{\"alert\":\"ExportHostIpOwnerMismatch\",\"annotations\":{\"description\":\"Export {{ $labels.export_id }} of user {{ $labels.user_id_id }} has mismatching\\nhost IP owner.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Export {{ $labels.export_id }} of user {{ $labels.user_id }} has mismatching host IP owner\"},\"expr\":\"vpsadmin_export_host_ip_owner_mismatch == 1\",\"labels\":{\"frequency\":\"1h\",\"severity\":\"warning\"}},{\"alert\":\"DnsZoneSerialMismatch\",\"annotations\":{\"description\":\"Zone {{ $labels.dns_zone }} is out of sync, servers are reporting different\\nserial numbers.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Zone {{ $labels.dns_zone }} is out of sync\"},\"expr\":\"count(count_values(\\\"serial\\\", vpsadmin_dns_server_zone_serial) by (dns_zone)) by (dns_zone) > 1\",\"for\":\"10m\",\"labels\":{\"frequency\":\"6h\",\"severity\":\"warning\"}},{\"alert\":\"DnsRecordAnswerError\",\"annotations\":{\"description\":\"DNS server {{ $labels.dns_server }} returns unexpected query answer for record {{ $labels.record_name }} {{ $labels.record_type }}\\nfrom zone {{ $labels.dns_zone }}.\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"DNS record {{ $labels.record_name }} {{ $labels.record_type }} from zone {{ $labels.dns_zone }} is misconfigured\"},\"expr\":\"vpsadmin_dns_record_answer_error == 1\",\"for\":\"10m\",\"labels\":{\"frequency\":\"1h\",\"severity\":\"warning\"}}]},{\"interval\":\"300s\",\"name\":\"vpsadmin-front\",\"rules\":[{\"alert\":\"ApiVpsfreeCzExporterDown\",\"annotations\":{\"description\":\"Unable to check web availability\\n\\nLABELS: {{ $labels }}\\n\",\"summary\":\"Web exporter is down (instance {{ $labels.instance }})\"},\"expr\":\"