+func (c *retryBackendBrowserDisplay) Subscribe(_ context.Context, _ string) (<-chan struct{}, func(), error) {
+	ch := make(chan struct{}, 1)
+	c.mu.Lock()
+	c.listeners[ch] = true
+	c.mu.Unlock()
+	return ch, func() { c.mu.Lock(); delete(c.listeners, ch); c.mu.Unlock() }, nil
