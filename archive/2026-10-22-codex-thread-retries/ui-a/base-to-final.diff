diff --git a/conversation/retry.go b/conversation/retry.go
new file mode 100644
index 0000000..f3fe75d
--- /dev/null
+++ b/conversation/retry.go
@@ -0,0 +1,86 @@
+package conversation
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"slices"
+	"unicode/utf8"
+)
+
+// RetryProvider is application-owned policy, scheduling and authority. Reads
+// are observations; preference changes and cancellation must be idempotent.
+type RetryProvider interface {
+	ReadRetry(context.Context, string) (RetryStatus, error)
+	SetRetryEnabled(context.Context, string, bool) (RetryStatus, error)
+	CancelRetry(context.Context, string) (RetryStatus, error)
+}
+
+// RetryStatus carries safe presentation only, never native routing or options.
+// NextAttemptAtMS is null when there is no deadline. ServerNowMS lets a browser
+// display the deadline without relying on its wall clock matching the server.
+type RetryStatus struct {
+	Enabled         bool   `json:"enabled"`
+	Class           string `json:"class"`
+	Phase           string `json:"phase"`
+	Attempt         int    `json:"attempt"`
+	NextAttemptAtMS *int64 `json:"nextAttemptAtMs"`
+	ServerNowMS     int64  `json:"serverNowMs"`
+	CyberUsed       int    `json:"cyberUsed"`
+	CyberLimit      int    `json:"cyberLimit"`
+	Reason          string `json:"reason"`
+}
+
+func (handler *Handler) retry(response http.ResponseWriter, request *http.Request, target Target, operation string) {
+	if !target.Capabilities.Retry ||
+		(operation == "retry" && request.Method != http.MethodGet) ||
+		(operation != "retry" && request.Method != http.MethodPost) {
+		handler.rejectOperation(response, request)
+		return
+	}
+	if target.Retry == nil {
+		writeError(response, http.StatusNotFound, "retry is unavailable")
+		return
+	}
+	var state RetryStatus
+	var err error
+	switch operation {
+	case "retry":
+		state, err = target.Retry.ReadRetry(request.Context(), target.ThreadID)
+	case "retry/enabled":
+		var body struct {
+			Enabled *bool `json:"enabled"`
+		}
+		if !handler.decode(response, request, &body) {
+			return
+		}
+		if body.Enabled == nil {
+			writeError(response, http.StatusBadRequest, "enabled must be a boolean")
+			return
+		}
+		state, err = target.Retry.SetRetryEnabled(request.Context(), target.ThreadID, *body.Enabled)
+	case "retry/cancel":
+		if !handler.decodeEmpty(response, request) {
+			return
+		}
+		state, err = target.Retry.CancelRetry(request.Context(), target.ThreadID)
+	}
+	if err != nil {
+		handler.serverError(response, request, errors.New("retry provider operation failed"))
+		return
+	}
+	if !validRetryStatus(state) {
+		handler.serverError(response, request, errors.New("retry provider returned invalid status"))
+		return
+	}
+	writeJSON(response, http.StatusOK, state)
+}
+
+func validRetryStatus(state RetryStatus) bool {
+	return slices.Contains([]string{"", "capacity", "cybersecurity"}, state.Class) &&
+		slices.Contains([]string{"idle", "scheduled", "submitting", "reconciling", "running", "cancelled", "exhausted", "blocked"}, state.Phase) &&
+		state.Attempt >= 0 && state.ServerNowMS > 0 &&
+		(state.NextAttemptAtMS == nil || *state.NextAttemptAtMS > 0) &&
+		state.CyberUsed >= 0 && state.CyberUsed <= state.CyberLimit && state.CyberLimit == 30 &&
+		len(state.Reason) <= 1024 && utf8.ValidString(state.Reason)
+}
diff --git a/conversation/retry_activity.go b/conversation/retry_activity.go
new file mode 100644
index 0000000..b747441
--- /dev/null
+++ b/conversation/retry_activity.go
@@ -0,0 +1,154 @@
+package conversation
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"regexp"
+	"slices"
+	"unicode/utf8"
+)
+
+// RetryActivityProvider observes application-owned retry chains. Tokens compare
+// exact action identities; the application still owns authority and scheduling.
+type RetryActivityProvider interface {
+	ReadRetryActivity(context.Context, string) (RetryActivityStatus, error)
+	RetryNow(context.Context, string, string) (RetryActivityStatus, error)
+	StopRetry(context.Context, string, string) (RetryActivityStatus, error)
+}
+
+type RetryActivityStatus struct {
+	ServerNowMS int64          `json:"serverNowMs"`
+	Activity    *RetryActivity `json:"activity"`
+}
+
+// RetryActivity contains safe presentation data, never native routing, prompts
+// or execution options. Nullable metrics preserve unavailable observations.
+type RetryActivity struct {
+	ChainKey        string `json:"chainKey"`
+	Class           string `json:"class"`
+	Phase           string `json:"phase"`
+	ConfirmedStarts *int64 `json:"confirmedStarts"`
+	Unconfirmed     int    `json:"unconfirmed"`
+	CountQuality    string `json:"countQuality"`
+	StartedAtMS     *int64 `json:"startedAtMs"`
+	ElapsedMS       *int64 `json:"elapsedMs"`
+	TimingQuality   string `json:"timingQuality"`
+	FinishedAtMS    *int64 `json:"finishedAtMs"`
+	NextAttemptAtMS *int64 `json:"nextAttemptAtMs"`
+	Outcome         string `json:"outcome"`
+	Reason          string `json:"reason"`
+	RetryNowToken   string `json:"retryNowToken"`
+	StopToken       string `json:"stopToken"`
+}
+
+const (
+	RetryActionStale         = "retry_action_stale"
+	RetryReloadRequired      = "retry_reload_required"
+	RetryActivityUnavailable = "retry_activity_unavailable"
+)
+
+// RetryActivityError supplies a bounded public error code. Provider diagnostics
+// are never copied into the HTTP response or logs.
+type RetryActivityError struct{ Code string }
+
+func (err *RetryActivityError) Error() string { return "retry activity action failed" }
+
+var retryActivityIdentity = regexp.MustCompile(`^[A-Za-z0-9_-]{1,256}$`)
+
+const maxSafeJSONInteger int64 = 1<<53 - 1
+
+func (handler *Handler) retryActivity(response http.ResponseWriter, request *http.Request, target Target, operation string) {
+	if !target.Capabilities.RetryActivity ||
+		(operation == "retry/activity" && request.Method != http.MethodGet) ||
+		(operation != "retry/activity" && request.Method != http.MethodPost) {
+		handler.rejectOperation(response, request)
+		return
+	}
+	if target.RetryActivity == nil {
+		writeError(response, http.StatusNotFound, "retry activity is unavailable")
+		return
+	}
+	var state RetryActivityStatus
+	var err error
+	if operation == "retry/activity" {
+		state, err = target.RetryActivity.ReadRetryActivity(request.Context(), target.ThreadID)
+	} else {
+		var body struct {
+			Token string `json:"token"`
+		}
+		if !handler.decode(response, request, &body) {
+			return
+		}
+		if !retryActivityIdentity.MatchString(body.Token) {
+			writeError(response, http.StatusBadRequest, "retry action token is invalid")
+			return
+		}
+		if operation == "retry/now" {
+			state, err = target.RetryActivity.RetryNow(request.Context(), target.ThreadID, body.Token)
+		} else {
+			state, err = target.RetryActivity.StopRetry(request.Context(), target.ThreadID, body.Token)
+		}
+	}
+	if err != nil {
+		code, message, status := RetryActivityUnavailable, "Retry activity is unavailable. Try again later.", http.StatusServiceUnavailable
+		var actionErr *RetryActivityError
+		if errors.As(err, &actionErr) && actionErr != nil {
+			switch actionErr.Code {
+			case RetryActionStale:
+				code, message, status = RetryActionStale, "The retry changed. Refresh its status before trying again.", http.StatusConflict
+			case RetryReloadRequired:
+				code, message, status = RetryReloadRequired, "Reload the page to use the current retry controls.", http.StatusConflict
+			}
+		}
+		writeJSON(response, status, map[string]string{"code": code, "error": message})
+		return
+	}
+	if !validRetryActivityStatus(state) {
+		handler.serverError(response, request, errors.New("retry activity provider returned invalid status"))
+		return
+	}
+	writeJSON(response, http.StatusOK, state)
+}
+
+func validRetryActivityStatus(state RetryActivityStatus) bool {
+	if state.ServerNowMS <= 0 || state.ServerNowMS > maxSafeJSONInteger {
+		return false
+	}
+	a := state.Activity
+	if a == nil {
+		return true
+	}
+	quality := func(value string) bool { return slices.Contains([]string{"exact", "partial", "unavailable"}, value) }
+	metric := func(value *int64) bool { return value == nil || *value >= 0 && *value <= maxSafeJSONInteger }
+	timestamp := func(value *int64) bool { return value == nil || *value > 0 && *value <= maxSafeJSONInteger }
+	if !retryActivityIdentity.MatchString(a.ChainKey) ||
+		!slices.Contains([]string{"capacity", "cybersecurity"}, a.Class) ||
+		!slices.Contains([]string{"scheduled", "submitting", "reconciling", "running", "terminal"}, a.Phase) ||
+		!quality(a.CountQuality) || !quality(a.TimingQuality) || !metric(a.ConfirmedStarts) ||
+		(a.Unconfirmed != 0 && a.Unconfirmed != 1) || !metric(a.ElapsedMS) ||
+		!timestamp(a.StartedAtMS) || !timestamp(a.FinishedAtMS) || !timestamp(a.NextAttemptAtMS) ||
+		len(a.Reason) > 1024 || !utf8.ValidString(a.Reason) {
+		return false
+	}
+	if (a.CountQuality == "unavailable") != (a.ConfirmedStarts == nil) ||
+		(a.TimingQuality == "unavailable") != (a.StartedAtMS == nil && a.ElapsedMS == nil) ||
+		(a.StartedAtMS == nil) != (a.ElapsedMS == nil) {
+		return false
+	}
+	if a.Phase == "terminal" {
+		if !slices.Contains([]string{"success", "stopped", "exhausted", "superseded", "blocked"}, a.Outcome) ||
+			a.NextAttemptAtMS != nil || a.RetryNowToken != "" || a.StopToken != "" {
+			return false
+		}
+	} else if a.Outcome != "" || a.FinishedAtMS != nil {
+		return false
+	}
+	if a.RetryNowToken != "" && (a.Phase != "scheduled" || !retryActivityIdentity.MatchString(a.RetryNowToken)) {
+		return false
+	}
+	if a.StopToken != "" && !retryActivityIdentity.MatchString(a.StopToken) {
+		return false
+	}
+	return a.NextAttemptAtMS == nil || a.Phase == "scheduled"
+}
diff --git a/conversation/retry_activity_test.go b/conversation/retry_activity_test.go
new file mode 100644
index 0000000..fd9c227
--- /dev/null
+++ b/conversation/retry_activity_test.go
@@ -0,0 +1,224 @@
+package conversation
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+type activityFixture struct {
+	state                    RetryActivityStatus
+	err                      error
+	lock                     *retryFixtureLock
+	thread, token, operation string
+	calls                    int
+}
+
+func (f *activityFixture) call(thread, token, operation string) (RetryActivityStatus, error) {
+	if operation != "read" && !f.lock.held {
+		return RetryActivityStatus{}, errors.New("mutation lock missing")
+	}
+	f.thread, f.token, f.operation = thread, token, operation
+	f.calls++
+	return f.state, f.err
+}
+func (f *activityFixture) ReadRetryActivity(_ context.Context, thread string) (RetryActivityStatus, error) {
+	return f.call(thread, "", "read")
+}
+func (f *activityFixture) RetryNow(_ context.Context, thread, token string) (RetryActivityStatus, error) {
+	return f.call(thread, token, "now")
+}
+func (f *activityFixture) StopRetry(_ context.Context, thread, token string) (RetryActivityStatus, error) {
+	return f.call(thread, token, "stop")
+}
+
+func activityNumber(value int64) *int64 { return &value }
+func activityState() RetryActivityStatus {
+	return RetryActivityStatus{ServerNowMS: 100000, Activity: &RetryActivity{
+		ChainKey: "chain-1", Class: "capacity", Phase: "scheduled", ConfirmedStarts: activityNumber(3),
+		CountQuality: "exact", StartedAtMS: activityNumber(30000), ElapsedMS: activityNumber(70000), TimingQuality: "exact",
+		NextAttemptAtMS: activityNumber(115000), RetryNowToken: "attempt-token", StopToken: "chain-token",
+	}}
+}
+func activityHandler(t *testing.T, provider RetryActivityProvider, grant bool, lock *retryFixtureLock, output *bytes.Buffer) *Handler {
+	t.Helper()
+	h, err := NewHandler(Options{AllowedOrigins: []string{"https://trusted.test"}, Logger: log.New(output, "", 0),
+		Resolver: ResolverFunc(func(_ context.Context, request ResolveRequest) (Target, error) {
+			if request.ID != "opaque" {
+				t.Fatalf("untrusted route: %+v", request)
+			}
+			return Target{Client: &fakeClient{}, ThreadID: "trusted-thread", Directory: "/trusted", MutationLock: lock,
+				RetryActivity: provider, Capabilities: Capabilities{RetryActivity: grant}}, nil
+		})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return h
+}
+
+func TestRetryActivityRoutes(t *testing.T) {
+	for _, tc := range []struct {
+		name, method, path, body, origin, operation string
+		grant, provider                             bool
+		status, calls                               int
+	}{
+		{"read", "GET", "activity", "", "", "read", true, true, 200, 1},
+		{"now", "POST", "now", `{"token":"attempt-token"}`, "https://trusted.test", "now", true, true, 200, 1},
+		{"stop", "POST", "stop", `{"token":"chain-token"}`, "https://trusted.test", "stop", true, true, 200, 1},
+		{"denied", "GET", "activity", "", "", "", false, true, 403, 0},
+		{"no provider", "GET", "activity", "", "", "", true, false, 404, 0},
+		{"cross origin", "POST", "stop", `{"token":"x"}`, "https://evil.test", "", true, true, 403, 0},
+		{"no origin", "POST", "stop", `{"token":"x"}`, "", "", true, true, 403, 0},
+		{"wrong read verb", "POST", "activity", `{}`, "https://trusted.test", "", true, true, 403, 0},
+		{"wrong action verb", "GET", "now", "", "", "", true, true, 403, 0},
+		{"missing token", "POST", "now", `{}`, "https://trusted.test", "", true, true, 400, 0},
+		{"null token", "POST", "stop", `{"token":null}`, "https://trusted.test", "", true, true, 400, 0},
+		{"invalid token", "POST", "now", `{"token":"x/y"}`, "https://trusted.test", "", true, true, 400, 0},
+		{"oversize token", "POST", "now", `{"token":"` + strings.Repeat("x", 257) + `"}`, "https://trusted.test", "", true, true, 400, 0},
+		{"thread injection", "POST", "now", `{"token":"x","threadId":"evil"}`, "https://trusted.test", "", true, true, 400, 0},
+		{"input injection", "POST", "stop", `{"token":"x","message":"send"}`, "https://trusted.test", "", true, true, 400, 0},
+		{"options injection", "POST", "now", `{"token":"x","options":{}}`, "https://trusted.test", "", true, true, 400, 0},
+		{"trailing body", "POST", "stop", `{"token":"x"}{}`, "https://trusted.test", "", true, true, 400, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			lock := &retryFixtureLock{}
+			f := &activityFixture{state: activityState(), lock: lock}
+			var selected RetryActivityProvider = f
+			if !tc.provider {
+				selected = nil
+			}
+			var output bytes.Buffer
+			h := activityHandler(t, selected, tc.grant, lock, &output)
+			r := httptest.NewRequest(tc.method, "/codex/conversations/opaque/retry/"+tc.path, strings.NewReader(tc.body))
+			if tc.origin != "" {
+				r.Header.Set("Origin", tc.origin)
+			}
+			w := httptest.NewRecorder()
+			h.ServeHTTP(w, r)
+			if w.Code != tc.status || f.calls != tc.calls {
+				t.Fatalf("status=%d body=%s calls=%d", w.Code, w.Body.String(), f.calls)
+			}
+			if tc.calls > 0 && (f.thread != "trusted-thread" || f.operation != tc.operation) {
+				t.Fatalf("provider=%+v", f)
+			}
+			if tc.operation != "read" && tc.calls > 0 && !strings.Contains(tc.body, `"`+f.token+`"`) {
+				t.Fatal("token changed")
+			}
+			if lock.held {
+				t.Fatal("lock leaked")
+			}
+			if w.Code == 200 {
+				var got RetryActivityStatus
+				if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+					t.Fatal(err)
+				}
+				if !validRetryActivityStatus(got) {
+					t.Fatal(w.Body.String())
+				}
+			}
+		})
+	}
+}
+
+func TestRetryActivityErrorsAreBounded(t *testing.T) {
+	for _, tc := range []struct {
+		err    error
+		status int
+		code   string
+	}{
+		{errors.New("secret /private/native-data"), 503, RetryActivityUnavailable},
+		{&RetryActivityError{Code: RetryActivityUnavailable}, 503, RetryActivityUnavailable},
+		{fmt.Errorf("secret: %w", &RetryActivityError{Code: RetryActionStale}), 409, RetryActionStale},
+		{&RetryActivityError{Code: RetryReloadRequired}, 409, RetryReloadRequired},
+		{&RetryActivityError{Code: "secret"}, 503, RetryActivityUnavailable},
+		{(*RetryActivityError)(nil), 503, RetryActivityUnavailable},
+	} {
+		t.Run(tc.code+fmt.Sprint(tc.err), func(t *testing.T) {
+			var output bytes.Buffer
+			f := &activityFixture{err: tc.err}
+			h := activityHandler(t, f, true, &retryFixtureLock{}, &output)
