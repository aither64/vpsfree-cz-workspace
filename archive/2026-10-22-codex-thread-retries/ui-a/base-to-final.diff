+		a.CountQuality = "unavailable"
+		a.StartedAtMS = nil
+		a.ElapsedMS = nil
+		a.TimingQuality = "unavailable"
+		if phase == "terminal" {
+			a.Outcome = "stopped"
+			a.StopToken = ""
+		}
+		if !validRetryActivityStatus(s) {
+			t.Fatalf("rejected valid unavailable %s", phase)
+		}
+	}
+	var output bytes.Buffer
