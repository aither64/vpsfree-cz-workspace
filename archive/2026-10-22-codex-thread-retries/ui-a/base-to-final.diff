diff --git a/codex/turn_context.go b/codex/turn_context.go
new file mode 100644
index 0000000..b0f355c
--- /dev/null
+++ b/codex/turn_context.go
@@ -0,0 +1,330 @@
+package codex
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"slices"
+)
+
+// TurnContext is an exact native Codex 0.163.0 rollout projection, available
+// only to trusted Go callers. It does not prove provider, instructions or MCP
+// authority and never exposes arbitrary context or developer instruction text.
+type TurnContext struct {
+	ThreadID          string
+	TurnID            string
+	Cwd               string
+	Model             string
+	ReasoningEffort   string
+	CollaborationMode string
+	ApprovalPolicy    json.RawMessage
+	SandboxPolicy     json.RawMessage
+	ApprovalsReviewer string
+	PermissionProfile json.RawMessage
+}
+
+func (c *Client) ReadTurnContext(ctx context.Context, threadID, turnID string) (TurnContext, error) {
+	metadata, err := c.ReadThreadMetadata(ctx, threadID, true)
+	if err != nil {
+		return TurnContext{}, err
+	}
+	if metadata.Path == nil || turnID == "" {
+		return TurnContext{}, errors.New("exact turn context is unavailable")
+	}
+	return readExactTurnContext(ctx, *metadata.Path, threadID, turnID, metadata.Cwd)
+}
+
+func readExactTurnContext(ctx context.Context, path, threadID, turnID, cwd string) (TurnContext, error) {
+	if cwd == "" || !filepath.IsAbs(cwd) || filepath.Clean(cwd) != cwd {
+		return TurnContext{}, errors.New("invalid trusted turn directory")
+	}
+	file, before, err := openRolloutFile(path)
+	if err != nil {
+		return TurnContext{}, err
+	}
+	defer file.Close()
+	// Full snapshot, bounded records and memory, with cancellation on each read.
+	// A long turn can put its context outside the display metadata's fixed tail.
+	scanner := rolloutRecordScanner(pageContextReader{ctx: ctx, reader: io.LimitReader(file, before.Size())}, true)
+	matchedSession := false
+	var found *TurnContext
+	for scanner.Scan() {
+		if err := ctx.Err(); err != nil {
+			return TurnContext{}, err
+		}
+		var record struct {
+			Type    string          `json:"type"`
+			Payload json.RawMessage `json:"payload"`
+		}
+		if json.Unmarshal(scanner.Bytes(), &record) != nil {
+			return TurnContext{}, errors.New("invalid native rollout record")
+		}
+		if record.Type == "session_meta" {
+			var session struct{ ID, Cwd string }
+			if json.Unmarshal(record.Payload, &session) != nil {
+				return TurnContext{}, errors.New("invalid native session metadata")
+			}
+			if session.ID == threadID && session.Cwd == cwd {
+				matchedSession = true
+			} else if matchedSession {
+				return TurnContext{}, errors.New("native rollout changed session identity")
+			}
+			continue
+		}
+		if record.Type != "turn_context" || !matchedSession {
+			continue
+		}
+		var identity struct {
+			TurnID string `json:"turn_id"`
+		}
+		if json.Unmarshal(record.Payload, &identity) != nil {
+			return TurnContext{}, errors.New("invalid native turn context identity")
+		}
+		if identity.TurnID != turnID {
+			continue
+		}
+		value, err := projectTurnContext(record.Payload, threadID, turnID, cwd)
+		if err != nil {
+			return TurnContext{}, err
+		}
+		if found != nil && !reflect.DeepEqual(*found, value) {
+			return TurnContext{}, errors.New("conflicting exact native turn contexts")
+		}
+		found = &value
+	}
+	if err := scanner.Err(); err != nil {
+		return TurnContext{}, err
+	}
+	after, err := os.Stat(path)
+	if err != nil {
+		return TurnContext{}, err
+	}
+	if !os.SameFile(before, after) || before.Size() != after.Size() || !before.ModTime().Equal(after.ModTime()) {
+		return TurnContext{}, errors.New("native rollout changed during context read")
+	}
+	if !matchedSession || found == nil {
+		return TurnContext{}, errors.New("exact native turn context is unavailable")
+	}
+	return *found, nil
+}
+
+func completeRolloutRecord(data []byte, atEOF bool) (int, []byte, error) {
+	if i := bytes.IndexByte(data, '\n'); i >= 0 {
+		return i + 1, data[:i], nil
+	}
+	if atEOF && len(data) > 0 {
+		return 0, nil, errors.New("native rollout has a partial final record")
+	}
+	return 0, nil, nil
+}
+
+func projectTurnContext(raw json.RawMessage, threadID, turnID, cwd string) (TurnContext, error) {
+	var payload struct {
+		Cwd    string `json:"cwd"`
+		Model  string `json:"model"`
+		Effort string `json:"effort"`
+		Mode   struct {
+			Mode string `json:"mode"`
+		} `json:"collaboration_mode"`
+		Approval json.RawMessage `json:"approval_policy"`
+		Sandbox  json.RawMessage `json:"sandbox_policy"`
+		Reviewer string          `json:"approvals_reviewer"`
+		Profile  json.RawMessage `json:"permission_profile"`
+	}
+	if json.Unmarshal(raw, &payload) != nil || payload.Cwd != cwd || payload.Model == "" || len(payload.Model) > 4096 ||
+		!slices.Contains([]string{"none", "minimal", "low", "medium", "high", "xhigh", "max"}, payload.Effort) ||
+		!slices.Contains([]string{"default", "plan"}, payload.Mode.Mode) ||
+		!slices.Contains([]string{"user", "auto_review", "guardian_subagent"}, payload.Reviewer) {
+		return TurnContext{}, errors.New("incomplete or unsupported native turn context")
+	}
+	approval, err := validatedNativeApproval(payload.Approval)
+	if err != nil {
+		return TurnContext{}, err
+	}
+	sandbox, err := validatedNativeSandbox(payload.Sandbox)
+	if err != nil {
+		return TurnContext{}, err
+	}
+	profile, err := validatedNativePermissionProfile(payload.Profile)
+	if err != nil {
+		return TurnContext{}, err
+	}
+
+	return TurnContext{ThreadID: threadID, TurnID: turnID, Cwd: cwd, Model: payload.Model, ReasoningEffort: payload.Effort, CollaborationMode: payload.Mode.Mode, ApprovalPolicy: approval, SandboxPolicy: sandbox, ApprovalsReviewer: payload.Reviewer, PermissionProfile: profile}, nil
+}
+
+func validatedNativeApproval(raw json.RawMessage) (json.RawMessage, error) {
+	var scalar string
+	if json.Unmarshal(raw, &scalar) == nil && slices.Contains([]string{"untrusted", "on-request", "never"}, scalar) {
+		return json.Marshal(scalar)
+	}
+	var value map[string]map[string]json.RawMessage
+	if json.Unmarshal(raw, &value) != nil || len(value) != 1 || value["granular"] == nil {
+		return nil, errors.New("unsupported native approval policy")
+	}
+	flags := value["granular"]
+	for _, key := range []string{"mcp_elicitations", "rules", "sandbox_approval"} {
+		if _, ok := flags[key]; !ok {
+			return nil, errors.New("incomplete native approval policy")
+		}
+	}
+	for key, flag := range flags {
+		if !nativeBool(flag) || !slices.Contains([]string{"mcp_elicitations", "rules", "sandbox_approval", "request_permissions", "skill_approval"}, key) {
+			return nil, errors.New("unsupported native approval policy")
+		}
+	}
+	return json.Marshal(value)
+}
+
+func validatedNativeSandbox(raw json.RawMessage) (json.RawMessage, error) {
+	var value map[string]json.RawMessage
+	if json.Unmarshal(raw, &value) != nil {
+		return nil, errors.New("unsupported native sandbox policy")
+	}
+	var kind string
+	if json.Unmarshal(value["type"], &kind) != nil {
+		return nil, errors.New("unsupported native sandbox policy")
+	}
+	allowed := []string{"type"}
+	switch kind {
+	case "danger-full-access":
+	case "read-only":
+		allowed = append(allowed, "network_access")
+	case "external-sandbox":
+		allowed = append(allowed, "network_access")
+	case "workspace-write":
+		allowed = append(allowed, "writable_roots", "network_access", "exclude_slash_tmp", "exclude_tmpdir_env_var")
+	default:
+		return nil, errors.New("unsupported native sandbox policy")
+	}
+	for key, field := range value {
+		if !slices.Contains(allowed, key) {
+			return nil, errors.New("unsupported native sandbox policy field")
+		}
+		switch key {
+		case "network_access":
+			if kind == "external-sandbox" {
+				var s string
+				if json.Unmarshal(field, &s) != nil || !slices.Contains([]string{"restricted", "enabled"}, s) {
+					return nil, errors.New("invalid native network policy")
+				}
+			} else {
+				if !nativeBool(field) {
+					return nil, errors.New("invalid native network policy")
+				}
+			}
+		case "exclude_slash_tmp", "exclude_tmpdir_env_var":
+			if !nativeBool(field) {
+				return nil, errors.New("invalid native sandbox flag")
+			}
+		case "writable_roots":
+			var roots []string
+			if json.Unmarshal(field, &roots) != nil || roots == nil || len(roots) > 256 {
+				return nil, errors.New("invalid native sandbox roots")
+			}
+			for _, root := range roots {
+				if !filepath.IsAbs(root) || filepath.Clean(root) != root {
+					return nil, errors.New("invalid native sandbox root")
+				}
+			}
+		}
+	}
+	return json.Marshal(value)
+}
+
+func validatedNativePermissionProfile(raw json.RawMessage) (json.RawMessage, error) {
+	if len(raw) == 0 || bytes.Equal(raw, []byte("null")) {
+		return nil, nil
+	}
+	if len(raw) > 256*1024 {
+		return nil, errors.New("native permission profile exceeds limit")
+	}
+	var value map[string]json.RawMessage
+	if json.Unmarshal(raw, &value) != nil {
+		return nil, errors.New("invalid native permission profile")
+	}
+	var kind string
+	if json.Unmarshal(value["type"], &kind) != nil {
+		return nil, errors.New("invalid native permission profile type")
+	}
+	if kind == "disabled" && len(value) == 1 {
+		return json.Marshal(value)
+	}
+	if kind != "managed" || len(value) != 3 {
+		return nil, errors.New("unsupported native permission profile")
+	}
+	var network string
+	if json.Unmarshal(value["network"], &network) != nil || !slices.Contains([]string{"restricted", "enabled"}, network) {
+		return nil, errors.New("invalid native permission network policy")
+	}
+	var fs map[string]json.RawMessage
+	if json.Unmarshal(value["file_system"], &fs) != nil {
+		return nil, errors.New("invalid native filesystem policy")
+	}
+	var fsKind string
+	if json.Unmarshal(fs["type"], &fsKind) != nil {
+		return nil, errors.New("invalid native filesystem policy type")
+	}
+	if fsKind == "unrestricted" && len(fs) == 1 {
+		return json.Marshal(value)
+	}
+	if fsKind != "restricted" || len(fs) != 2 {
+		return nil, errors.New("unsupported native filesystem policy")
+	}
+	var entries []map[string]json.RawMessage
+	if json.Unmarshal(fs["entries"], &entries) != nil || entries == nil || len(entries) > 256 {
+		return nil, errors.New("invalid native filesystem entries")
+	}
+	for _, entry := range entries {
+		if len(entry) < 2 || len(entry) > 3 {
+			return nil, errors.New("invalid native filesystem entry")
+		}
+		for key := range entry {
+			if !slices.Contains([]string{"path", "access", "missing_path_behavior"}, key) {
+				return nil, errors.New("unsupported native filesystem entry")
+			}
+		}
+		var access string
+		if json.Unmarshal(entry["access"], &access) != nil || !slices.Contains([]string{"read", "write"}, access) {
+			return nil, errors.New("invalid native filesystem access")
+		}
+		if missing, ok := entry["missing_path_behavior"]; ok {
+			var policy string
+			if json.Unmarshal(missing, &policy) != nil || policy != "skip" {
+				return nil, errors.New("unsupported native missing-path policy")
+			}
+		}
+		var path map[string]json.RawMessage
+		if json.Unmarshal(entry["path"], &path) != nil || len(path) != 2 {
+			return nil, errors.New("invalid native permission path")
+		}
+		var pathKind string
+		if json.Unmarshal(path["type"], &pathKind) != nil {
+			return nil, errors.New("invalid native permission path type")
+		}
+		switch pathKind {
+		case "path":
+			var absolute string
+			if json.Unmarshal(path["path"], &absolute) != nil || len(absolute) > 4096 || !filepath.IsAbs(absolute) || filepath.Clean(absolute) != absolute {
+				return nil, errors.New("invalid native absolute permission path")
+			}
+		case "special":
+			var special map[string]string
+			if json.Unmarshal(path["value"], &special) != nil || len(special) != 1 || !slices.Contains([]string{"root", "slash_tmp", "tmpdir"}, special["kind"]) {
+				return nil, errors.New("unsupported native special permission path")
+			}
+		default:
+			return nil, errors.New("unsupported native permission path type")
+		}
+	}
+	return json.Marshal(value)
+}
+
+func nativeBool(raw json.RawMessage) bool {
+	return bytes.Equal(raw, []byte("true")) || bytes.Equal(raw, []byte("false"))
+}
diff --git a/codex/turn_context_test.go b/codex/turn_context_test.go
new file mode 100644
index 0000000..c32a082
--- /dev/null
+++ b/codex/turn_context_test.go
@@ -0,0 +1,115 @@
+package codex
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// Safe native 0.163.0 field shapes; no prompt, developer text or private paths.
+const nativeContextFixture = `{"type":"turn_context","payload":{"turn_id":"queued-turn","cwd":"/workspace","model":"execution-model","effort":"xhigh","collaboration_mode":{"mode":"plan","settings":{"developer_instructions":"must not be projected"}},"approval_policy":"never","approvals_reviewer":"user","sandbox_policy":{"type":"danger-full-access"},"permission_profile":{"type":"disabled"}}}`
+const nativeSessionFixture = `{"type":"session_meta","payload":{"id":"thread-1","cwd":"/workspace"}}`
+
+func TestReadExactTurnContextMatchesExecutionAndHidesUnrelatedPayload(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "rollout.jsonl")
+	other := strings.ReplaceAll(nativeContextFixture, "queued-turn", "later-turn")
+	other = strings.ReplaceAll(other, "execution-model", "current-default-model")
+	text := nativeSessionFixture + "\n" + nativeContextFixture + "\n" + nativeContextFixture + "\n" + other + "\n"
+	if err := os.WriteFile(path, []byte(text), 0600); err != nil {
+		t.Fatal(err)
+	}
+	value, err := readExactTurnContext(context.Background(), path, "thread-1", "queued-turn", "/workspace")
+	if err != nil || value.Model != "execution-model" || value.CollaborationMode != "plan" || value.ReasoningEffort != "xhigh" {
+		t.Fatalf("value=%+v err=%v", value, err)
+	}
+	encoded, _ := json.Marshal(value)
+	if strings.Contains(string(encoded), "must not be projected") || strings.Contains(string(encoded), "current-default-model") {
+		t.Fatal("unrelated native context leaked")
+	}
+	if string(value.PermissionProfile) != `{"type":"disabled"}` {
+		t.Fatalf("profile=%s", value.PermissionProfile)
+	}
+}
+
+func TestReadExactTurnContextRejectsMissingPartialForeignAndConflictingRecords(t *testing.T) {
+	for _, test := range []struct{ name, text string }{
+		{"missing", nativeSessionFixture + "\n"},
+		{"foreign session", strings.ReplaceAll(nativeSessionFixture, "thread-1", "foreign") + "\n" + nativeContextFixture + "\n"},
+		{"wrong cwd", strings.ReplaceAll(nativeSessionFixture, "/workspace", "/other") + "\n" + nativeContextFixture + "\n"},
+		{"foreign turn", nativeSessionFixture + "\n" + strings.ReplaceAll(nativeContextFixture, "queued-turn", "other-turn") + "\n"},
+		{"partial", nativeSessionFixture + "\n" + nativeContextFixture},
+		{"partial following record", nativeSessionFixture + "\n" + nativeContextFixture + "\n" + `{"type":`},
+		{"conflict", nativeSessionFixture + "\n" + nativeContextFixture + "\n" + strings.ReplaceAll(nativeContextFixture, "execution-model", "different-model") + "\n"},
+		{"invalid policy", nativeSessionFixture + "\n" + strings.ReplaceAll(nativeContextFixture, "danger-full-access", "unknown") + "\n"},
+		{"incomplete", nativeSessionFixture + "\n" + strings.ReplaceAll(nativeContextFixture, `"effort":"xhigh",`, "") + "\n"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "rollout.jsonl")
+			if err := os.WriteFile(path, []byte(test.text), 0600); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := readExactTurnContext(context.Background(), path, "thread-1", "queued-turn", "/workspace"); err == nil {
+				t.Fatal("unproved execution context accepted")
+			}
+			if test.name == "partial" {
+				file, err := os.OpenFile(path, os.O_APPEND|os.O_WRONLY, 0600)
+				if err != nil {
+					t.Fatal(err)
+				}
+				file.WriteString("\n")
+				file.Close()
+				if _, err := readExactTurnContext(context.Background(), path, "thread-1", "queued-turn", "/workspace"); err != nil {
+					t.Fatalf("completed append did not recover: %v", err)
+				}
+			}
+		})
+	}
+}
+
+func TestReadExactTurnContextBeyondDisplayTailAndCancellation(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "rollout.jsonl")
+	file, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	file.WriteString(nativeSessionFixture + "\n" + nativeContextFixture + "\n")
+	padding := `{"type":"response_item","payload":"` + strings.Repeat("x", 1024*1024) + "\"}\n"
+	for written := 0; written < readLimit; written += len(padding) {
+		if _, err := file.WriteString(padding); err != nil {
+			t.Fatal(err)
+		}
+	}
+	file.Close()
+	value, err := readExactTurnContext(context.Background(), path, "thread-1", "queued-turn", "/workspace")
+	if err != nil || value.TurnID != "queued-turn" {
+		t.Fatalf("outside fixed suffix: %+v %v", value, err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := readExactTurnContext(ctx, path, "thread-1", "queued-turn", "/workspace"); err == nil {
+		t.Fatal("cancelled read accepted")
+	}
+}
+
+func TestNativeContextPoliciesValidatePinnedShapes(t *testing.T) {
+	managed := `{"type":"managed","file_system":{"type":"restricted","entries":[{"path":{"type":"special","value":{"kind":"root"}},"access":"read"},{"path":{"type":"path","path":"/workspace"},"access":"write"},{"path":{"type":"special","value":{"kind":"slash_tmp"}},"access":"write"},{"path":{"type":"path","path":"/optional"},"access":"read","missing_path_behavior":"skip"}]},"network":"restricted"}`
+	if _, err := validatedNativePermissionProfile(json.RawMessage(managed)); err != nil {
+		t.Fatal(err)
+	}
+	for _, raw := range []string{`{"type":"workspace-write","writable_roots":["/workspace"],"network_access":false,"exclude_tmpdir_env_var":true,"exclude_slash_tmp":false}`, `{"type":"read-only"}`, `{"type":"external-sandbox","network_access":"restricted"}`} {
+		if _, err := validatedNativeSandbox(json.RawMessage(raw)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := validatedNativeApproval(json.RawMessage(`{"granular":{"mcp_elicitations":false,"rules":true,"sandbox_approval":true}}`)); err != nil {
+		t.Fatal(err)
+	}
+	for _, raw := range []string{`{"type":"managed","file_system":{},"network":"restricted"}`, `{"type":"disabled","secret":"hidden"}`, `{"type":"custom"}`} {
+		if _, err := validatedNativePermissionProfile(json.RawMessage(raw)); err == nil {
+			t.Fatalf("unvalidated native profile accepted: %s", raw)
+		}
+	}
+}
diff --git a/codex/turn_state.go b/codex/turn_state.go
new file mode 100644
index 0000000..3146209
--- /dev/null
+++ b/codex/turn_state.go
@@ -0,0 +1,88 @@
+package codex
+
+import (
+	"context"
+	"errors"
+	"slices"
+)
+
+// TerminalFailure describes only the latest, authoritatively failed turn.
+// Code preserves the native string discriminator. Unknown and structured
+// discriminators never become a known retry class through message matching.
+type TerminalFailure struct {
+	TurnID  string `json:"turnId"`
+	Code    string `json:"code"`
+	Message string `json:"message"`
+}
+
+type TurnState struct {
+	ThreadID         string           `json:"threadId"`
+	Status           string           `json:"status"`
+	LatestTurnID     string           `json:"latestTurnId"`
+	LatestTurnStatus string           `json:"latestTurnStatus"`
+	TerminalFailure  *TerminalFailure `json:"terminalFailure"`
+}
+
+// IsLoadedFailedTurn checks only the exact loaded terminal observation. Native
+// systemError can persist after a failed turn until another turn starts. This
+// predicate does not classify errors or prove queue, request or authority holds.
+func (s TurnState) IsLoadedFailedTurn(expectedTurnID string) bool {
+	return expectedTurnID != "" && s.LatestTurnID == expectedTurnID &&
+		s.LatestTurnStatus == "failed" && (s.Status == "idle" || s.Status == "systemError")
+}
+
+// ReadTurnState is a bounded cold observation. It never loads a thread or
+// derives failure state from intermediate error notifications or transcript text.
+func (c *Client) ReadTurnState(ctx context.Context, threadID string) (TurnState, error) {
+	var metadata struct {
+		Thread map[string]any `json:"thread"`
+	}
+	if err := c.historyRequest(ctx, "thread/read", map[string]any{
+		"threadId": threadID, "excludeTurns": true,
+	}, &metadata); err != nil {
+		return TurnState{}, err
+	}
+	if threadID == "" || stringValue(metadata.Thread["id"]) != threadID {
+		return TurnState{}, errors.New("thread/read returned the wrong thread")
+	}
+	state := TurnState{ThreadID: threadID, Status: statusValue(metadata.Thread["status"])}
+	if !slices.Contains([]string{"idle", "notLoaded", "active", "systemError"}, state.Status) {
+		return TurnState{}, errors.New("thread/read returned an unknown thread status")
+	}
+	var page struct {
+		Data *[]map[string]any `json:"data"`
+	}
+	if err := c.historyRequest(ctx, "thread/turns/list", map[string]any{
+		"threadId": threadID, "limit": 1, "sortDirection": "desc", "itemsView": "notLoaded",
+	}, &page); err != nil {
+		if c.freshThreadMissingSourceRollout(metadata.Thread, threadID, err) {
+			return state, nil
+		}
+		return TurnState{}, err
+	}
+	if page.Data == nil || len(*page.Data) > 1 {
+		return TurnState{}, errors.New("thread/turns/list returned invalid latest turn data")
+	}
+	if len(*page.Data) == 0 {
+		if state.Status == "active" {
+			return TurnState{}, errors.New("active thread returned no latest turn")
+		}
+		return state, nil
+	}
+	turn := (*page.Data)[0]
+	state.LatestTurnID = stringValue(turn["id"])
+	state.LatestTurnStatus = stringValue(turn["status"])
+	if state.LatestTurnID == "" || !slices.Contains([]string{"inProgress", "completed", "failed", "interrupted"}, state.LatestTurnStatus) {
+		return TurnState{}, errors.New("thread/turns/list returned invalid latest turn identity or status")
+	}
+	// Native status notifications can lag turn metadata. In-progress turns with
+	// idle status remain active for admission; a terminal turn with active thread
+	// status is also refused by the continuation preflight.
+	if state.LatestTurnStatus == "failed" {
+		if failure, ok := turn["error"].(map[string]any); ok {
+			state.TerminalFailure = &TerminalFailure{TurnID: state.LatestTurnID,
+				Code: stringValue(failure["codexErrorInfo"]), Message: stringValue(failure["message"])}
+		}
+	}
+	return state, nil
+}
