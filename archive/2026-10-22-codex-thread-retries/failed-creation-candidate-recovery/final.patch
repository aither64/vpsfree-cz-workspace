+                             tracking:, manifest:, start:, creation:, roster:, calls:, fault_marker:, root_thread:,
+                             receipt_path: File.join(portal, 'creations', slug + '.json'),
+                             preparation_path: File.join(portal, 'session-preparations', request + '.json'))
+    end
+  end
