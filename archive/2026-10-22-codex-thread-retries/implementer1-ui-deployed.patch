@@ -0,0 +1,271 @@
+package turnretry
+
+import (
+	"context"
+	"errors"
+	"os"
+	"time"
+
+	"github.com/aither64/codex-web/codex"
+)
+
+var ErrMissingProof = errors.New("managed execution settings are unproved")
+
+// Backend is application-owned authority. Step never acquires an outer lock:
+// its caller retains generation/runtime/roster/conversation admission. Native
+// methods below must not reenter the per-thread admission fence.
+type Backend interface {
+	Observe(context.Context, Scope) (Observation, error)
+	Boundary(context.Context, Scope) (string, error)
+	Prove(context.Context, Scope, *State, string) error
+	Check(context.Context, Scope, Snapshot) error
+	Reconcile(context.Context, Scope, Pending) (codex.SendReceipt, bool, error)
+	Continue(context.Context, Scope, Pending) (codex.SendReceipt, error)
+	NeverSubmitted(context.Context, Scope, Pending) (bool, error)
+}
+
+type Controller struct {
+	Store   Store
+	Backend Backend
+	Clock   func() time.Time
+	Random  func() float64
+}
+
+func (c Controller) now() time.Time {
+	if c.Clock != nil {
+		return c.Clock()
+	}
+	return time.Now()
+}
+func (c Controller) random() float64 {
+	if c.Random != nil {
+		return c.Random()
+	}
+	return 0
+}
+
+// ReconcileOnly recovers an existing exact intent without enrollment or
+// execution. It may retire that intent's positively unsubmitted prepared
+// ledger entry so ordinary admission can run again. It never calls Continue.
+func (c Controller) ReconcileOnly(ctx context.Context, scope Scope) error {
+	if _, err := c.Store.Load(scope); errors.Is(err, os.ErrNotExist) {
+		return nil
+	} else if err != nil {
+		return err
+	}
+	tx, err := c.Store.Lock(ctx, scope)
+	if err != nil {
+		return err
+	}
+	defer tx.Close()
+	if err := c.checkBoundary(ctx, tx); err != nil {
+		return err
+	}
+	if !tx.State.Uncertain() {
+		return nil
+	}
+	_, err = c.reconcile(ctx, tx)
+	return err
+}
+
+func (c Controller) checkBoundary(ctx context.Context, tx *Transaction) error {
+	s := &tx.State
+	boundary, err := c.Backend.Boundary(ctx, s.Scope)
+	if err != nil {
+		return err
+	}
+	if s.Boundary == "" {
+		s.Boundary = boundary
+	} else if s.Boundary != boundary {
+		s.Cancel("identity_changed")
+		if err := tx.Save(); err != nil {
+			return err
+		}
+		return errors.New("retry session incarnation changed")
+	}
+	return nil
+}
+
+// A false result means accepted, cancelled, or still uncertain: no fresh
+// outbound attempt is permitted by this reconciliation pass.
+func (c Controller) reconcile(ctx context.Context, tx *Transaction) (bool, error) {
+	s := &tx.State
+	p := *s.Pending
+	receipt, found, err := c.Backend.Reconcile(ctx, s.Scope, p)
+	if found && err == nil {
+		if err := s.Accepted(receipt.TurnID, c.now()); err != nil {
+			return false, err
+		}
+		return false, tx.Save()
+	}
+	if err == nil {
+		var never bool
+		never, err = c.Backend.NeverSubmitted(ctx, s.Scope, p)
+		if err == nil && never {
+			if s.Cancelled || !s.Enabled {
+				s.Phase, s.Pending = "cancelled", nil
+			}
+			return s.Pending != nil, tx.Save()
+		}
+	}
+	s.Phase, s.Reason = "reconciling", "outcome_unknown"
+	if saveErr := tx.Save(); saveErr != nil {
+		return false, saveErr
+	}
+	if err == nil {
+		err = errors.New("automatic submission requires reconciliation")
+	}
+	return false, err
+}
+
+func (c Controller) Step(ctx context.Context, scope Scope) error {
+	tx, err := c.Store.Lock(ctx, scope)
+	if err != nil {
+		return err
+	}
+	defer tx.Close()
+	s := &tx.State
+	if err := c.checkBoundary(ctx, tx); err != nil {
+		return err
+	}
+	// Reconcile before current-failure/policy checks: a receipt remains valid
+	// after a newer user turn, opt-out, stop or generation recovery.
+	if s.Uncertain() {
+		unsubmitted, err := c.reconcile(ctx, tx)
+		if err != nil || !unsubmitted {
+			return err
+		}
+		p := *s.Pending
+		// Positive proof permits this same ID/options to be sent. Renew its
+		// reservation at dispatch time; an old charge cannot cover a new call.
+		if err := c.Backend.Check(ctx, scope, p.Snapshot); err != nil {
+			s.Reason = "admission_held"
+			if saveErr := tx.Save(); saveErr != nil {
+				return saveErr
+			}
+			return err
+		}
+		if err := c.preflightAccepted(tx); err != nil {
+			return err
+		}
+		if err := s.ReserveUnsubmitted(c.now()); err != nil {
+			return err
+		}
+		if err := tx.Save(); err != nil {
+			return err
+		}
+		if s.Pending == nil {
+			return nil
+		}
+		return c.dispatch(ctx, tx, *s.Pending)
+	}
+	o, err := c.Backend.Observe(ctx, scope)
+	if err != nil {
+		return err
+	}
+	if !s.Enrolled {
+		// Read twice around the durable baseline. A native completion racing
+		// enrollment is consumed conservatively instead of becoming new work.
+		s.Enroll(o)
+		if err := tx.Save(); err != nil {
+			return err
+		}
+		after, err := c.Backend.Observe(ctx, scope)
+		if err != nil {
+			return err
+		}
+		if o != after {
+			s.Baseline, s.BaselineActive = after.Turn, false
+		}
+		return tx.Save()
+	}
+	if o.Status == "failed" && Class(o.Code) != "" && o.Turn != s.Handled && (o.Turn != s.Baseline || s.BaselineActive) {
+		if err := c.Backend.Prove(ctx, scope, s, o.Turn); err != nil {
+			s.Phase, s.Reason = "blocked", "settings_unproven"
+			if errors.Is(err, ErrMissingProof) {
+				s.Handled = o.Turn
+			}
+			if saveErr := tx.Save(); saveErr != nil {
+				return saveErr
+			}
+			return err
+		}
+	}
+	if err := s.Observe(o, c.now(), c.random()); err != nil {
+		return err
+	}
+	if err := tx.Save(); err != nil {
+		return err
+	}
+	if s.Phase != "scheduled" || s.Pending == nil || !s.Enabled || s.Cancelled || s.Now(c.now()) < s.DeadlineMS {
+		return nil
+	}
+	if err := c.Backend.Check(ctx, scope, s.Pending.Snapshot); err != nil {
+		s.Reason = "admission_held"
+		if saveErr := tx.Save(); saveErr != nil {
+			return saveErr
+		}
+		return err
+	}
+	unsubmitted, err := c.reconcile(ctx, tx)
+	if err != nil || !unsubmitted {
+		return err
+	}
+	if err := c.preflightAccepted(tx); err != nil {
+		return err
+	}
+	if err := s.Begin(c.now()); err != nil {
+		return err
+	}
+	if err := tx.Save(); err != nil {
+		return err
+	}
+	if s.Pending == nil {
+		return nil
+	}
+	return c.dispatch(ctx, tx, *s.Pending)
+}
+
+// Called only after exact positive never-submitted proof. Unknown intents must
+// remain reconciliation-only, including when the provenance record is full.
+func (c Controller) preflightAccepted(tx *Transaction) error {
+	err := tx.State.PreflightAccepted()
+	if err != nil {
+		if errors.Is(err, ErrSnapshotCapacity) {
+			tx.State.Handled = tx.State.Pending.Failure
+			tx.State.Phase, tx.State.Reason, tx.State.Cancelled, tx.State.DeadlineMS = "blocked", "settings_unproven", true, 0
+			if saveErr := tx.Save(); saveErr != nil {
+				return saveErr
+			}
+		}
+		return err
+	}
+	return nil
+}
+
+func (c Controller) dispatch(ctx context.Context, tx *Transaction, p Pending) error {
+	receipt, err := c.Backend.Continue(ctx, tx.State.Scope, p)
+	if err == nil {
+		if err := tx.State.Accepted(receipt.TurnID, c.now()); err != nil {
+			return err
+		}
+		return tx.Save()
+	}
+	var unknown *codex.UnknownSendOutcomeError
+	if errors.As(err, &unknown) {
+		tx.State.Phase, tx.State.Reason = "reconciling", "outcome_unknown"
+	} else {
+		never, proofErr := c.Backend.NeverSubmitted(ctx, tx.State.Scope, p)
+		if proofErr != nil || !never {
+			tx.State.Phase, tx.State.Reason = "reconciling", "outcome_unknown"
+		} else {
+			// A positively refused attempt is terminal for this source failure.
+			// Retain its conservative quota charge; no timer retries refusal.
+			tx.State.Phase, tx.State.Reason, tx.State.Pending = "blocked", "dispatch_refused", nil
+		}
+	}
+	if saveErr := tx.Save(); saveErr != nil {
+		return saveErr
+	}
+	return err
+}
diff --git a/portal/internal/turnretry/controller_test.go b/portal/internal/turnretry/controller_test.go
new file mode 100644
index 00000000..05497a7e
--- /dev/null
+++ b/portal/internal/turnretry/controller_test.go
@@ -0,0 +1,176 @@
+package turnretry
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/aither64/codex-web/codex"
+)
+
+type fakeBackend struct {
+	o                Observation
+	boundary         string
+	hold             bool
+	sends            int
+	accepted         string
+	unknown          bool
+	never            bool
+	observed         int
+	duringEnrollment bool
+}
+
+func (f *fakeBackend) Observe(context.Context, Scope) (Observation, error) {
+	f.observed++
+	if f.duringEnrollment && f.observed == 2 {
+		return Observation{"initial", "failed", "serverOverloaded"}, nil
+	}
+	return f.o, nil
+}
+func (f *fakeBackend) Boundary(context.Context, Scope) (string, error) { return f.boundary, nil }
+func (f *fakeBackend) Prove(_ context.Context, _ Scope, s *State, turn string) error {
+	s.AddSnapshot(proof(turn))
+	return nil
+}
+func (f *fakeBackend) Check(context.Context, Scope, Snapshot) error {
+	if f.hold {
+		return errors.New("execution held")
+	}
+	return nil
+}
+func (f *fakeBackend) Reconcile(context.Context, Scope, Pending) (codex.SendReceipt, bool, error) {
+	if f.accepted != "" {
+		return codex.SendReceipt{TurnID: f.accepted}, true, nil
+	}
+	if f.unknown && f.sends > 0 {
+		return codex.SendReceipt{}, false, &codex.UnknownSendOutcomeError{Err: errors.New("lost response")}
+	}
+	return codex.SendReceipt{}, false, nil
+}
+func (f *fakeBackend) Continue(context.Context, Scope, Pending) (codex.SendReceipt, error) {
+	f.sends++
+	if f.unknown {
+		return codex.SendReceipt{}, &codex.UnknownSendOutcomeError{Err: errors.New("lost response")}
+	}
+	f.accepted = "continued"
+	return codex.SendReceipt{TurnID: f.accepted}, nil
+}
+func (f *fakeBackend) NeverSubmitted(context.Context, Scope, Pending) (bool, error) {
+	return f.never, nil
+}
+
+func controllerFixture(t *testing.T) (Controller, *fakeBackend, *time.Time) {
+	t.Helper()
+	now := time.Unix(1000, 0)
+	backend := &fakeBackend{boundary: "incarnation", never: true}
+	c := Controller{Store: Store{Root: t.TempDir(), Workspace: "/workspace"}, Backend: backend, Clock: func() time.Time { return now }}
+	return c, backend, &now
+}
+
+func TestControllerRestartReconcilesAcceptedBeforeNewerFailureAndCancellation(t *testing.T) {
+	c, b, now := controllerFixture(t)
+	scope := fixtureScope()
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	b.o = Observation{"failed", "failed", "cyberPolicy"}
+	b.unknown = true
+	if err := c.Step(context.Background(), scope); err == nil {
+		t.Fatal("unknown outcome hidden")
+	}
+	s, _ := c.Store.Load(scope)
+	if !s.Uncertain() || s.Attempt != 1 || len(s.Cyber) != 1 {
+		t.Fatalf("lost uncertain reservation: %+v", s)
+	}
+	id := s.Pending.ID
+	tx, _ := c.Store.Lock(context.Background(), scope)
+	tx.State.Cancel("manual_input")
+	if err := tx.Save(); err != nil {
+		t.Fatal(err)
+	}
+	tx.Close()
+	b.o = Observation{"newer", "failed", "cyberPolicy"}
+	*now = now.Add(time.Second)
+	if err := c.Step(context.Background(), scope); err == nil {
+		t.Fatal("unknown outcome accepted")
+	}
+	if b.sends != 1 {
+		t.Fatal("uncertain resend")
+	}
+	b.accepted = "continued"
+	b.unknown = false
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	s, _ = c.Store.Load(scope)
+	if s.Phase != "cancelled" || s.Pending.ID != id || s.Pending.ResultTurn != "continued" || b.sends != 1 {
+		t.Fatalf("receipt/cancel lost: %+v", s)
+	}
+}
+
+func TestControllerColdHoldDuplicatePollAndOverdueCapacity(t *testing.T) {
+	c, b, now := controllerFixture(t)
+	scope := fixtureScope()
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	b.o = Observation{"failed", "failed", "serverOverloaded"}
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	s, _ := c.Store.Load(scope)
+	id, deadline := s.Pending.ID, s.DeadlineMS
+	*now = now.Add(time.Hour)
+	b.hold = true
+	if err := c.Step(context.Background(), scope); err == nil {
+		t.Fatal("cold hold ignored")
+	}
+	if b.sends != 0 {
+		t.Fatal("held send")
+	}
+	s, _ = c.Store.Load(scope)
+	if s.Pending.ID != id || s.DeadlineMS != deadline {
+		t.Fatal("held schedule changed")
+	}
+	b.hold = false
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	if b.sends != 1 {
+		t.Fatal("overdue burst")
+	}
+	b.o = Observation{"continued", "inProgress", ""}
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	if b.sends != 1 {
+		t.Fatal("duplicate poll dispatched")
+	}
+}
+
+func TestControllerEnrollmentCompletionRaceAndIncarnationFence(t *testing.T) {
+	c, b, _ := controllerFixture(t)
+	scope := fixtureScope()
+	b.o = Observation{"initial", "inProgress", ""}
+	b.duringEnrollment = true
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	s, _ := c.Store.Load(scope)
+	if s.BaselineActive || s.Baseline != "initial" {
+		t.Fatal("uncertain enrollment completion admitted")
+	}
+	b.duringEnrollment = false
+	b.o = Observation{"initial", "failed", "serverOverloaded"}
+	if err := c.Step(context.Background(), scope); err != nil {
+		t.Fatal(err)
+	}
+	if b.sends != 0 {
+		t.Fatal("old failure restarted")
+	}
+	b.boundary = "replacement"
+	if err := c.Step(context.Background(), scope); err == nil {
+		t.Fatal("incarnation replacement admitted")
+	}
+}
diff --git a/portal/internal/turnretry/recovery_test.go b/portal/internal/turnretry/recovery_test.go
new file mode 100644
index 00000000..3dd04e72
--- /dev/null
+++ b/portal/internal/turnretry/recovery_test.go
@@ -0,0 +1,277 @@
+package turnretry
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/aither64/codex-web/codex"
+)
+
+func savedUnsubmitted(t *testing.T, c Controller, now time.Time) Pending {
+	t.Helper()
+	tx, err := c.Store.Lock(context.Background(), fixtureScope())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Close()
+	tx.State.Boundary = "incarnation"
+	tx.State.Enroll(Observation{})
+	tx.State.AddSnapshot(proof("failed"))
+	if err := tx.State.Observe(Observation{"failed", "failed", "cyberPolicy"}, now, 0); err != nil {
+		t.Fatal(err)
+	}
+	if err := tx.State.Begin(now); err != nil {
+		t.Fatal(err)
+	}
+	if err := tx.Save(); err != nil {
+		t.Fatal(err)
+	}
+	return *tx.State.Pending
+}
+
+func TestControllerDelayedUnsubmittedCyberReservation(t *testing.T) {
+	for _, delay := range []time.Duration{299 * time.Second, 301 * time.Second} {
+		t.Run(delay.String(), func(t *testing.T) {
+			c, b, now := controllerFixture(t)
+			p := savedUnsubmitted(t, c, *now)
+			*now = now.Add(delay)
+			b.o = Observation{"failed", "failed", "cyberPolicy"}
+			if err := c.ReconcileOnly(context.Background(), fixtureScope()); err != nil {
+				t.Fatal(err)
+			}
+			if b.sends != 0 {
+				t.Fatal("reconciliation dispatched")
+			}
+			if err := c.Step(context.Background(), fixtureScope()); err != nil {
+				t.Fatal(err)
+			}
+			s, err := c.Store.Load(fixtureScope())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if b.sends != 1 || s.Pending.ID != p.ID || s.Attempt != 1 || s.Cyber[0].AtMS != now.UnixMilli() {
+				t.Fatal("stale reservation reused", s)
+			}
+			// Twenty-nine subsequent possible sends fit; a thirtieth must not.
+			for i := 0; i < 30; i++ {
+				tx, err := c.Store.Lock(context.Background(), fixtureScope())
+				if err != nil {
+					t.Fatal(err)
+				}
+				tx.State.Pending = nil
+				tx.State.Phase = "idle"
+				turn := fmt.Sprintf("next-%d", i)
+				tx.State.AddSnapshot(proof(turn))
+				if err := tx.State.Observe(Observation{turn, "failed", "cyberPolicy"}, *now, 0); err != nil {
+					t.Fatal(err)
+				}
+				if err := tx.State.Begin(*now); err != nil && i < 29 {
+					t.Fatal(err)
+				}
+				if i == 29 && (tx.State.Pending != nil || tx.State.Phase != "exhausted") {
+					t.Fatal("31st possible send admitted")
+				}
+				if err := tx.Save(); err != nil {
+					t.Fatal(err)
+				}
+				tx.Close()
+			}
+		})
+	}
+}
+
+func TestControllerUnsubmittedReservationCountsOtherIDsAndClock(t *testing.T) {
+	for _, others := range []int{29, 30} {
+		t.Run(fmt.Sprint(others), func(t *testing.T) {
+			c, b, now := controllerFixture(t)
+			p := savedUnsubmitted(t, c, *now)
+			*now = now.Add(301 * time.Second)
+			tx, _ := c.Store.Lock(context.Background(), fixtureScope())
+			for i := 0; i < others; i++ {
+				id, _ := NewID()
+				tx.State.Cyber = append(tx.State.Cyber, Charge{ID: id, AtMS: now.UnixMilli()})
+			}
+			if err := tx.Save(); err != nil {
+				t.Fatal(err)
+			}
+			tx.Close()
+			b.o = Observation{"failed", "failed", "cyberPolicy"}
+			if err := c.Step(context.Background(), fixtureScope()); err != nil {
+				t.Fatal(err)
+			}
+			s, _ := c.Store.Load(fixtureScope())
+			if b.sends != 30-others || s.CyberUsed(now.UnixMilli()) != 30 {
+				t.Fatal("other reservations were removed", s)
+			}
+			if others == 29 && s.Pending.ID != p.ID {
+				t.Fatal("replacement UUID")
+			}
+			if others == 30 && s.Phase != "exhausted" {
+				t.Fatal("quota not exhausted")
+			}
+			if others == 30 {
+				*now = now.Add(time.Hour)
+				if err := c.Step(context.Background(), fixtureScope()); err != nil {
+					t.Fatal(err)
+				}
+				if b.sends != 0 {
+					t.Fatal("timer rearmed exhaustion")
+				}
+			}
+		})
+	}
+	// Equal timestamps carry distinct identities; renewing one leaves the other.
+	c, _, now := controllerFixture(t)
+	p := savedUnsubmitted(t, c, *now)
+	tx, _ := c.Store.Lock(context.Background(), fixtureScope())
+	other, _ := NewID()
+	tx.State.Cyber = append(tx.State.Cyber, Charge{ID: other, AtMS: p.ChargedAtMS})
+	if err := tx.State.ReserveUnsubmitted(now.Add(-time.Minute)); err != nil {
+		t.Fatal(err)
+	}
+	if len(tx.State.Cyber) != 2 || tx.State.Cyber[0].ID != other || tx.State.Pending.ChargedAtMS != p.ChargedAtMS {
+		t.Fatal("equal timestamp charge removed or backwards time accepted")
+	}
+	tx.Close()
+}
+
+func TestControllerDelayedUnknownAcceptanceReanchorsOnceWithoutResend(t *testing.T) {
+	c, b, now := controllerFixture(t)
+	p := savedUnsubmitted(t, c, *now)
+	b.sends = 1
+	b.unknown = true
+	b.never = false
+	*now = now.Add(301 * time.Second)
+	if err := c.ReconcileOnly(context.Background(), fixtureScope()); err == nil {
+		t.Fatal("unknown outcome released")
+	}
+	s, _ := c.Store.Load(fixtureScope())
+	if s.Cyber[0].AtMS != p.ChargedAtMS || b.sends != 1 {
+		t.Fatal("unknown was recharged or resent")
+	}
+	b.accepted = "accepted"
+	b.unknown = false
+	if err := c.ReconcileOnly(context.Background(), fixtureScope()); err != nil {
+		t.Fatal(err)
+	}
+	s, _ = c.Store.Load(fixtureScope())
+	at := s.Cyber[0].AtMS
+	if at != now.UnixMilli() || !s.Cyber[0].Accepted || s.Pending.ID != p.ID {
+		t.Fatal("delayed acceptance expired too soon")
+	}
+	tx, _ := c.Store.Lock(context.Background(), fixtureScope())
+	tx.State.Phase = "reconciling"
+	tx.State.Pending.ResultTurn = ""
+	if err := tx.Save(); err != nil {
+		t.Fatal(err)
+	}
+	tx.Close()
+	*now = now.Add(time.Minute)
+	if err := c.ReconcileOnly(context.Background(), fixtureScope()); err != nil {
+		t.Fatal(err)
+	}
+	s, _ = c.Store.Load(fixtureScope())
+	if s.Cyber[0].AtMS != at || len(s.Cyber) != 1 || b.sends != 1 {
+		t.Fatal("duplicate receipt changed charge")
+	}
+}
+
+func TestRetryFinalSchemaRejectsPreliminaryShapes(t *testing.T) {
+	c, _, now := controllerFixture(t)
+	savedUnsubmitted(t, c, *now)
+	s, _ := c.Store.Load(fixtureScope())
+	data, _ := json.Marshal(s)
+	for name, change := range map[string]func(map[string]any){
+		"missing epoch":          func(v map[string]any) { delete(v, "epoch") },
+		"anonymous quota":        func(v map[string]any) { v["cyber"] = []any{float64(now.UnixMilli())} },
+		"duplicate charge":       func(v map[string]any) { v["cyber"] = append(v["cyber"].([]any), v["cyber"].([]any)[0]) },
+		"missing snapshot epoch": func(v map[string]any) { delete(v["snapshots"].([]any)[0].(map[string]any), "epoch") },
+		"wrong pending charge":   func(v map[string]any) { v["pending"].(map[string]any)["chargedAtMs"] = float64(1) },
+	} {
+		t.Run(name, func(t *testing.T) {
+			var raw map[string]any
+			_ = json.Unmarshal(data, &raw)
+			change(raw)
+			bad, _ := json.Marshal(raw)
+			if err := os.WriteFile(c.Store.path(fixtureScope()), bad, 0600); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := c.Store.Load(fixtureScope()); err == nil {
+				t.Fatal("preliminary state accepted")
+			}
+		})
+	}
+	if err := os.WriteFile(c.Store.path(fixtureScope()), data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.Store.Load(fixtureScope()); err != nil {
+		t.Fatal(err)
+	}
+}
+
+type delayedReceiptBackend struct {
+	*fakeBackend
+	now *time.Time
+}
+
+func (b delayedReceiptBackend) Continue(ctx context.Context, scope Scope, p Pending) (codex.SendReceipt, error) {
+	*b.now = b.now.Add(301 * time.Second)
+	return b.fakeBackend.Continue(ctx, scope, p)
