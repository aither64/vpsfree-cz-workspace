+func (c *planDeliveryClient) ListThreads(context.Context, codex.ThreadListOptions) ([]codex.ThreadMetadata, *string, error) {
+	threads := []codex.ThreadMetadata{{ID: "thread-1", Cwd: c.cwd, Source: "vscode"}}
