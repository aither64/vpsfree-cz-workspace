+func proof(turn string) Snapshot {
+	p := Snapshot{Epoch: 1, Version: 1, ID: "manual-" + turn, Turn: turn, Origin: "browser", Provider: "openai", Mode: "default", Options: codex.TurnOptions{Model: "model", ReasoningEffort: "high"}, Proven: true}
