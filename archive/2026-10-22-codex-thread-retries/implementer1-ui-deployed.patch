+)
+
+// Independent clients share only the production durable admission/ledger paths,
+// not a websocket or codex-web's per-client queueUpdateLock. RPC barriers wait
+// outside the fake native-state mutex so that mutex cannot supply exclusion.
+type retryContentionWire struct {
+	armed, hideHistory atomic.Bool
+	owner              string
+	entered, release   chan struct{}
+	once               sync.Once
+	mu                 sync.Mutex
+	automatic, steers  int
+	manualMutations    int
+}
+
+func (b *retryContentionWire) counts() (int, int, int) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.automatic, b.steers, b.manualMutations
+}
+
+func (b *retryContentionWire) serve(w *retrySettingsWire, conn *websocket.Conn) error {
+	defer conn.CloseNow()
+	if err := handshake(conn); err != nil {
+		return err
+	}
+	for {
+		req, err := readObject(conn)
+		if err != nil {
+			return nil
+		}
+		p, _ := req["params"].(map[string]any)
+		method, _ := req["method"].(string)
+		text := ""
+		if input, ok := p["input"].([]any); ok && len(input) != 0 {
+			text, _ = input[0].(map[string]any)["text"].(string)
+		}
+		auto := text == turnretry.Continuation
+		armed := b.armed.Load()
+		if armed && (strings.HasPrefix(method, "turn/") || method == "thread/resume" || method == "thread/settings/update" || method == "thread/queue/add") {
+			if !auto && b.owner != "manual" {
+				saved, err := w.client.RetryStore().Load(w.scope)
+				accepted := false
+				for _, snapshot := range saved.Snapshots {
+					accepted = accepted || (snapshot.Origin == "automatic" && snapshot.Turn == "automatic" && snapshot.TextDigest == textHash(turnretry.Continuation))
+				}
+				if err != nil || !accepted || saved.Uncertain() {
+					w.t.Error("manual mutation preceded durable automatic receipt", saved, err)
+				}
+			}
+			b.mu.Lock()
+			if auto {
+				b.automatic++
+				if method == "turn/steer" {
+					b.steers++
+				}
+			} else {
+				b.manualMutations++
+			}
+			b.mu.Unlock()
+		}
+		w.mu.Lock()
+		var result any
+		failure := ""
+		var notify any
+		switch {
+		case armed && method == "thread/items/list" && b.hideHistory.Load():
+			result = map[string]any{"data": []any{}, "nextCursor": nil}
+		case armed && method == "thread/resume":
+			// This is the ordinary explicit manual path, which may apply its
+			// authorized policy. Automatic continuation must never take it.
+			config, _ := p["config"].(map[string]any)
+			servers, _ := config["mcp_servers"].(map[string]any)
+			server, _ := servers["team"].(map[string]any)
+			if server["command"] != w.policy.MCPServer.Command || p["developerInstructions"] != "common lifecycle\n\n"+w.policy.DeveloperInstructions {
+				w.t.Error("manual resume lost authorized role/MCP", p)
+			}
+			result = map[string]any{"thread": map[string]any{"id": w.thread}}
+		case armed && (method == "turn/start" || method == "turn/steer") && !auto:
+			if method == "turn/start" {
+				w.turn = "manual-independent"
+				w.items = nil
+			} else if p["expectedTurnId"] != w.turn {
+				w.t.Error("manual steer lost exact active turn", p)
+			}
+			w.status, w.loaded = "inProgress", "active"
+			w.items = append(w.items, retrySettingsInput(w.turn, p["clientUserMessageId"].(string), text)...)
+			result = map[string]any{"turn": map[string]any{"id": w.turn}}
+			if method == "turn/steer" {
+				result = map[string]any{"turnId": w.turn}
+			}
+		default:
+			result, failure, notify = w.reply(req)
+		}
+		w.mu.Unlock()
+		// Native has processed input, but its receipt has not reached the
+		// caller. The production admission lock must remain held here.
+		if armed && ((b.owner == "manual" && !auto && (method == "turn/start" || method == "thread/queue/add")) || (b.owner != "manual" && auto)) {
+			b.once.Do(func() { close(b.entered) })
+			<-b.release
+			if b.owner == "unknown" {
+				b.hideHistory.Store(true)
+				result = map[string]any{"turn": map[string]any{}}
+			}
+		}
+		reply := map[string]any{"id": req["id"], "result": result}
+		if failure != "" {
+			delete(reply, "result")
+			reply["error"] = map[string]any{"code": -32000, "message": failure}
+		}
+		if err := writeObject(conn, reply); err != nil {
+			return nil
+		}
+		if notify != nil {
+			if err := writeObject(conn, notify); err != nil {
+				return nil
+			}
+		}
+	}
+}
+
+func TestRetryManagedInputContendsWithController(t *testing.T) {
+	for _, member := range []bool{false, true} {
+		for _, writer := range []string{"send", "queue"} {
+			for _, owner := range []string{"manual", "automatic", "unknown"} {
+				t.Run(fmt.Sprintf("member=%t/%s/%s", member, writer, owner), func(t *testing.T) {
+					barrier := &retryContentionWire{owner: owner, entered: make(chan struct{}), release: make(chan struct{})}
+					var release sync.Once
+					defer release.Do(func() { close(barrier.release) })
+					w := newRetrySettingsWireWithServer(t, member, "default", barrier.serve)
+					ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+					defer cancel()
+					if _, err := w.client.QueueWithPolicy(ctx, w.thread, "managed source", "source-id", w.policy); err != nil {
+						t.Fatal(err)
+					}
+					w.mu.Lock()
+					w.turn, w.status, w.loaded = "failed-source", "failed", "systemError"
+					w.queue = nil
+					w.items = retrySettingsInput(w.turn, "source-id", "managed source")
+					w.writeRollout(w.turn)
+					w.mu.Unlock()
+					now := time.Now()
+					controller := turnretry.Controller{Store: w.client.RetryStore(), Backend: w.client.RetryBackend(), Clock: func() time.Time { return now }}
+					if err := controller.Step(ctx, w.scope); err != nil {
+						t.Fatal(err)
+					}
+					scheduled, err := controller.Store.Load(w.scope)
+					if err != nil || scheduled.Pending == nil || scheduled.Phase != "scheduled" {
+						t.Fatal("real managed failure did not schedule", scheduled, err)
+					}
+					now = time.UnixMilli(scheduled.DeadlineMS)
+					manual := NewWithOptions(w.scope.Socket, w.scope.Workspace, codex.ClientOptions{DeveloperInstructions: "common lifecycle", PreserveThreadInstructionsOnResume: true, SubmissionLedgerPath: w.client.submissionLedgerPath})
+					defer manual.Close()
+					manual.RecoveryRoot = w.client.RecoveryRoot
+					attempted := make(chan struct{}, 1)
+					manual.RetryPolicyResolver = func(ctx context.Context, thread string) (codex.ThreadPolicy, error) {
+						select {
+						case attempted <- struct{}{}:
+						default:
+						}
+						return w.client.RetryPolicyResolver(ctx, thread)
+					}
+					if manual.Client == w.client.Client || manual.RetryStore() != controller.Store {
+						t.Fatal("contention must use independent clients and one authoritative store")
+					}
+					input := func(ctx context.Context) error {
+						if writer == "queue" {
+							entry, err := manual.QueueWithPolicy(ctx, w.thread, "independent manual input", "manual-id", w.policy)
+							if err == nil && entry.ClientUserMessageID != "manual-id" {
+								return errors.New("manual queue lost client identity")
+							}
+							return err
+						}
+						receipt, err := manual.SendWithOptions(ctx, w.thread, "independent manual input", "manual-id", "manual-action", codex.TurnOptions{Model: w.model, ReasoningEffort: w.effort, ThreadPolicy: w.policy})
+						if err == nil && (receipt.TurnID == "" || receipt.Steered != (owner != "manual")) {
+							return errors.New("manual send changed ordinary idle/steer semantics")
+						}
+						return err
+					}
+					barrier.armed.Store(true)
+					first := make(chan error, 1)
+					if owner == "manual" {
+						go func() { first <- input(ctx) }()
+					} else {
+						go func() { first <- controller.Step(ctx, w.scope) }()
+					}
+					select {
+					case <-barrier.entered:
+					case err := <-first:
+						t.Fatal("owner never reached native receipt barrier", err)
+					case <-ctx.Done():
+						t.Fatal("owner never reached native receipt barrier", ctx.Err())
+					}
+					_, _, beforeManual := barrier.counts()
+					if owner != "manual" && beforeManual != 0 {
+						t.Fatal("automatic owner changed native settings before dispatch", beforeManual)
+					}
+					contend, stop := context.WithTimeout(ctx, 60*time.Millisecond)
+					if owner == "manual" {
+						err = controller.Step(contend, w.scope)
+					} else {
+						err = input(contend)
+					}
+					stop()
+					if !errors.Is(err, context.DeadlineExceeded) {
+						t.Fatal("competing production path bypassed the admission fence", err)
+					}
+					auto, steers, mutations := barrier.counts()
+					if steers != 0 || mutations != beforeManual || (owner == "manual" && auto != 0) || (owner != "manual" && auto != 1) {
+						t.Fatalf("input escaped receipt critical section: automatic=%d steers=%d manual=%d/%d", auto, steers, mutations, beforeManual)
+					}
+					var waiting chan error
+					if owner != "manual" {
+						<-attempted // The deadline-limited contention probe above.
+						waiting = make(chan error, 1)
+						go func() { waiting <- input(ctx) }()
+						select {
+						case <-attempted:
+						case <-ctx.Done():
+							t.Fatal("managed waiter did not enter production admission")
+						}
+					}
+					release.Do(func() { close(barrier.release) })
+					err = <-first
+					if owner == "unknown" {
+						var unknown *codex.UnknownSendOutcomeError
+						if !errors.As(err, &unknown) {
+							t.Fatal("lost actual synthetic receipt was not uncertain", err)
+						}
+						saved, loadErr := controller.Store.Load(w.scope)
+						if loadErr != nil || !saved.Uncertain() || saved.Pending.ID != scheduled.Pending.ID {
+							t.Fatal("uncertainty lost exact intent", saved, loadErr)
+						}
+						assertRetrySubmitting(t, w.client.submissionLedgerPath, w.thread, *saved.Pending)
+						if err := <-waiting; err == nil || !strings.Contains(err.Error(), "requires reconciliation") {
+							t.Fatal("unknown automatic outcome did not hold managed input", err)
+						}
+						auto, steers, mutations = barrier.counts()
+						if auto != 1 || steers != 0 || mutations != beforeManual {
+							t.Fatal("uncertain input reached native", auto, steers, mutations)
+						}
+						after, _ := controller.Store.Load(w.scope)
+						if !after.Uncertain() || !reflect.DeepEqual(after.Pending, saved.Pending) {
+							t.Fatal("manual hold rewrote uncertain identity")
+						}
+						barrier.hideHistory.Store(false)
+						if err := controller.ReconcileOnly(ctx, w.scope); err != nil {
+							t.Fatal("exact receipt reconciliation", err)
+						}
+					} else if err != nil {
+						t.Fatal("fence owner failed", err)
+					}
+					if owner == "manual" {
+						if err := controller.Step(ctx, w.scope); err != nil {
+							t.Fatal(err)
+						}
+						saved, _ := controller.Store.Load(w.scope)
+						if saved.Pending != nil || !saved.Cancelled {
+							t.Fatal("manual admission did not cancel/supersede pending retry", saved)
+						}
+					} else if owner == "unknown" {
+						saved, _ := controller.Store.Load(w.scope)
+						if saved.Pending == nil || saved.Pending.ResultTurn != "automatic" {
+							t.Fatal("receipt handling did not persist before unlocking", saved)
+						}
+						if err := input(ctx); err != nil {
+							t.Fatal("ordinary managed input failed after exact receipt", err)
+						}
+					} else if err := <-waiting; err != nil {
+						t.Fatal("managed waiter failed after dispatch/receipt critical section", err)
+					}
+					auto, steers, _ = barrier.counts()
+					want := 1
+					if owner == "manual" {
+						want = 0
+					}
+					if auto != want || steers != 0 {
+						t.Fatal("automatic input dispatched or steered twice", auto, steers)
+					}
+				})
+			}
+		}
+	}
+}
+
+// Inspect the real generic writer's ledger, without manufacturing acceptance.
+func assertRetrySubmitting(t *testing.T, path, thread string, pending turnretry.Pending) {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ledger struct {
+		Schema int `json:"schema"`
+		Sends  map[string]map[string]struct {
+			State, Context, Digest string
+			Turn                   string `json:"turnId"`
+		} `json:"sends"`
+	}
+	if err := json.Unmarshal(data, &ledger); err != nil {
+		t.Fatal(err)
+	}
+	attempt := ledger.Sends[thread][pending.ID]
+	if ledger.Schema != 3 || attempt.State != "submitting" || attempt.Context != pending.Action || attempt.Digest != textHash(turnretry.Continuation) || attempt.Turn != "" {
+		t.Fatal("missing exact native submitting attempt", ledger.Schema, attempt)
+	}
+}
diff --git a/portal/internal/workspacecodex/turn_retry_proof.go b/portal/internal/workspacecodex/turn_retry_proof.go
new file mode 100644
index 00000000..41c0e0ff
--- /dev/null
+++ b/portal/internal/workspacecodex/turn_retry_proof.go
@@ -0,0 +1,240 @@
+package workspacecodex
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+
+	"github.com/aither64/codex-web/codex"
+	"github.com/aither64/dev-workspace/portal/internal/session"
+	"github.com/aither64/dev-workspace/portal/internal/turnretry"
+)
+
+type retryBackend struct{ client *Client }
+
+func (c *Client) RetryBackend() turnretry.Backend { return retryBackend{c} }
+
+func (b retryBackend) Observe(ctx context.Context, scope turnretry.Scope) (turnretry.Observation, error) {
+	s, err := b.client.Client.ReadTurnState(ctx, scope.Thread)
+	if err != nil {
+		return turnretry.Observation{}, err
+	}
+	o := turnretry.Observation{Turn: s.LatestTurnID, Status: s.LatestTurnStatus}
+	if s.TerminalFailure != nil {
+		o.Code = s.TerminalFailure.Code
+	}
+	return o, nil
+}
+func (b retryBackend) Boundary(_ context.Context, scope turnretry.Scope) (string, error) {
+	return session.ObservationIdentity(scope.Workspace, scope.Slug, filepath.Join(scope.Workspace, "work", scope.Slug), scope.Root)
+}
+
+func (b retryBackend) Prove(ctx context.Context, scope turnretry.Scope, state *turnretry.State, turn string) error {
+	if state.Handled == turn {
+		return turnretry.ErrMissingProof
+	}
+	if state.Proof(turn) != nil {
+		return nil
+	}
+	native, err := b.client.Client.ReadTurnContext(ctx, scope.Thread, turn)
+	if err != nil {
+		return err
+	}
+	if native.Cwd != filepath.Join(scope.Workspace, "work", scope.Slug) {
+		return turnretry.ErrMissingProof
+	}
+	// Every contributing user item must have a managed admission. This also
+	// accounts for steers; their requested defaults never replace the actual
+	// active-turn settings obtained from the exact native context.
+	contributors := []turnretry.Snapshot{}
+	seen := map[string]bool{}
+	cursor := ""
+	complete := false
+	for pages := 0; pages < 256; pages++ {
+		page, err := b.client.Client.ReadThreadPage(ctx, scope.Thread, cursor)
+		if err != nil {
+			return err
+		}
+		older := false
+		for _, entry := range page.Entries {
+			if entry.TurnID != "" && entry.TurnID != turn {
+				older = true
+				continue
+			}
+			if entry.TurnID != turn || entry.Kind != "userMessage" {
+				continue
+			}
+			var candidate *turnretry.Snapshot
+			for i := range state.Snapshots {
+				p := &state.Snapshots[i]
+				matches := p.ID == entry.ClientUserMessageID && entry.ClientUserMessageID != ""
+				if entry.ClientUserMessageID == "" && p.Origin == "initial" && p.TextDigest == entry.ClientUserMessageDigest {
+					matches = true
+				}
+				if matches {
+					if candidate != nil {
+						return turnretry.ErrMissingProof
+					}
+					candidate = p
+				}
+			}
+			if candidate == nil || candidate.TextDigest != entry.ClientUserMessageDigest || candidate.BindingDigest == "" {
+				return turnretry.ErrMissingProof
+			}
+			if candidate.Turn != "" && candidate.Turn != turn {
+				return turnretry.ErrMissingProof
+			}
+			candidate.Turn = turn
+			if !seen[candidate.ID] {
+				contributors = append(contributors, *candidate)
+				seen[candidate.ID] = true
+			}
+		}
+		if older || !page.HasOlder {
+			complete = true
+			break
+		}
+		if page.OlderCursor == nil || *page.OlderCursor == cursor {
+			return errors.New("retry receipt history cursor is incomplete")
+		}
+		cursor = *page.OlderCursor
+	}
+	if !complete || len(contributors) == 0 {
+		return turnretry.ErrMissingProof
+	}
+	proof, err := proveContributors(scope, state.Binding, native, contributors)
+	if err != nil {
+		return err
+	}
+	if err := state.RetainProof(proof); err != nil {
+		if errors.Is(err, turnretry.ErrSnapshotCapacity) {
+			state.SuppressTurn(turn)
+			return turnretry.ErrMissingProof
+		}
+		return err
+	}
+	return nil
+}
+
+func proveContributors(scope turnretry.Scope, binding *turnretry.Binding, native codex.TurnContext, contributors []turnretry.Snapshot) (turnretry.Snapshot, error) {
+	if binding == nil || binding.Epoch == 0 || native.ThreadID != scope.Thread || native.TurnID == "" || native.Cwd != filepath.Join(scope.Workspace, "work", scope.Slug) {
+		return turnretry.Snapshot{}, turnretry.ErrMissingProof
+	}
+	proof := contributors[0]
+	context := map[string]codex.AdditionalContextEntry{}
+	ids := []string{}
+	for _, p := range contributors {
+		if p.Epoch != binding.Epoch || p.BindingDigest != binding.Digest || p.SocketIdentity != binding.SocketIdentity || p.Provider != binding.Provider || p.CommonInstructions != binding.CommonInstructions || !reflect.DeepEqual(p.Options.ThreadPolicy, binding.Policy) {
+			return turnretry.Snapshot{}, turnretry.ErrMissingProof
+		}
+		if p.Origin == "queue" && len(p.Options.AdditionalContext) != 0 {
+			return turnretry.Snapshot{}, turnretry.ErrMissingProof
+		}
+		for key, value := range p.Options.AdditionalContext {
+			if old, ok := context[key]; ok && old != value {
+				return turnretry.Snapshot{}, turnretry.ErrMissingProof
+			}
+			context[key] = value
+		}
+		ids = append(ids, p.ID+":"+p.TextDigest)
+	}
+	if err := authorizedNativePolicy(native, binding.Policy); err != nil {
+		return turnretry.Snapshot{}, err
+	}
+	sort.Strings(ids)
+	proof.ID, proof.Turn, proof.Origin, proof.Proven = "executed:"+native.TurnID, native.TurnID, "executed", true
+	proof.TextDigest = textHash(strings.Join(ids, "\n"))
+	proof.Options.Model, proof.Options.ReasoningEffort = native.Model, native.ReasoningEffort
+	proof.Options.AdditionalContext = context
+	proof.Mode = native.CollaborationMode
+	data, err := json.Marshal(native)
+	if err != nil {
+		return turnretry.Snapshot{}, err
+	}
+	proof.NativeContext = data
+	proof.Digest, err = proof.Hash()
+	return proof, err
+}
+
+func authorizedNativePolicy(native codex.TurnContext, policy codex.ThreadPolicy) error {
+	if policy.Sandbox != "" {
+		var sandbox struct {
+			Type string `json:"type"`
+		}
+		if json.Unmarshal(native.SandboxPolicy, &sandbox) != nil {
+			return turnretry.ErrMissingProof
+		}
+		// Native rollout policy uses kebab-case, unlike v2 request enums.
+		if sandbox.Type != policy.Sandbox {
+			return turnretry.ErrMissingProof
+		}
+	}
+	if policy.ApprovalPolicy != "" {
+		var approval string
+		if json.Unmarshal(native.ApprovalPolicy, &approval) != nil || approval != policy.ApprovalPolicy {
+			return turnretry.ErrMissingProof
+		}
+	}
+	return nil
+}
+
+func (b retryBackend) Check(ctx context.Context, scope turnretry.Scope, proof turnretry.Snapshot) error {
+	state, err := b.client.RetryStore().Load(scope)
+	if err != nil {
+		return err
+	}
+	if state.Binding == nil || state.Epoch != proof.Epoch || state.Binding.Epoch != state.Epoch || state.Binding.Digest != proof.BindingDigest || !proof.Proven {
+		return turnretry.ErrMissingProof
+	}
+	epoch, err := session.SocketIdentity(scope.Socket)
+	if err != nil || epoch != proof.SocketIdentity || !b.client.allowImplicitResume(scope.Thread) {
+		return errors.New("retry execution permission is held")
+	}
+	policy, err := b.client.RetryPolicyResolver(ctx, scope.Thread)
+	if err != nil {
+		return err
+	}
+	if !reflect.DeepEqual(policy, proof.Options.ThreadPolicy) || proof.CommonInstructions != b.client.retryCommonInstructions {
+		return errors.New("retry authorized binding changed")
+	}
+	provider, err := b.client.retryProvider(ctx, scope)
+	if err != nil || provider != proof.Provider {
+		return errors.New("retry provider changed")
+	}
+	s, err := b.client.Client.ReadTurnState(ctx, scope.Thread)
+	if err != nil {
+		return err
+	}
+	if !s.IsLoadedFailedTurn(proof.Turn) {
+		return errors.New("retry requires the exact latest failed turn on a loaded thread")
+	}
+	// Current managed mode/access changes cancel the chain under this same
+	// admission fence. Exact failed-turn context plus the unchanged managed
+	// binding is authority; the transcript display-mode cache is not.
+	native, err := b.client.Client.ReadTurnContext(ctx, scope.Thread, proof.Turn)
+	if err != nil {
+		return err
+	}
+	data, err := json.Marshal(native)
+	if err != nil {
+		return err
+	}
+	if !reflect.DeepEqual(json.RawMessage(data), proof.NativeContext) {
+		return turnretry.ErrMissingProof
+	}
+	return authorizedNativePolicy(native, policy)
+}
+
+func (b retryBackend) Reconcile(ctx context.Context, scope turnretry.Scope, p turnretry.Pending) (codex.SendReceipt, bool, error) {
+	return b.client.Client.ReconcileSendWithOptions(ctx, scope.Thread, turnretry.Continuation, p.ID, p.Action, p.Snapshot.Options)
+}
+func (b retryBackend) Continue(ctx context.Context, scope turnretry.Scope, p turnretry.Pending) (codex.SendReceipt, error) {
+	return b.client.Client.ContinueFailedTurn(ctx, scope.Thread, turnretry.Continuation, p.ID, p.Action, p.Failure, p.Snapshot.Options)
+}
+func (b retryBackend) NeverSubmitted(_ context.Context, scope turnretry.Scope, p turnretry.Pending) (bool, error) {
+	return b.client.Client.DiscardPreparedSendWithOptions(scope.Thread, turnretry.Continuation, p.ID, p.Action, p.Snapshot.Options)
+}
diff --git a/portal/internal/workspacecodex/turn_retry_retention_test.go b/portal/internal/workspacecodex/turn_retry_retention_test.go
new file mode 100644
index 00000000..f81f1f17
--- /dev/null
+++ b/portal/internal/workspacecodex/turn_retry_retention_test.go
@@ -0,0 +1,521 @@
+package workspacecodex
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"reflect"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/aither64/codex-web/codex"
+	"github.com/aither64/dev-workspace/portal/internal/turnretry"
+	"github.com/coder/websocket"
+)
+
+type retryRetentionWire struct {
+	mu           sync.Mutex
+	sends        int
+	lostID       string
+	hideHistory  bool
+	failSaveID   string
+	stopBeforeID string
+}
+
+func (r *retryRetentionWire) count() int {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.sends
+}
+
+func (r *retryRetentionWire) serve(w *retrySettingsWire, conn *websocket.Conn) error {
+	defer conn.CloseNow()
+	if err := handshake(conn); err != nil {
+		return err
+	}
+	for {
+		req, err := readObject(conn)
+		if err != nil {
+			return nil
+		}
+		w.mu.Lock()
+		r.mu.Lock()
+		method, _ := req["method"].(string)
+		p, _ := req["params"].(map[string]any)
+		var result, notify any
+		failure := ""
+		switch {
+		case method == "thread/resume" && w.bound && p["developerInstructions"] != nil:
+			config, _ := p["config"].(map[string]any)
+			servers, _ := config["mcp_servers"].(map[string]any)
+			server, _ := servers["team"].(map[string]any)
+			if p["developerInstructions"] != "common lifecycle\n\n"+w.policy.DeveloperInstructions || p["sandbox"] != w.policy.Sandbox || p["approvalPolicy"] != w.policy.ApprovalPolicy || server["command"] != w.policy.MCPServer.Command {
+				w.t.Error("explicit prepared send changed authorized instructions/MCP/access", p)
+			}
+			w.resumes++
+			result = map[string]any{"thread": map[string]any{"id": w.thread}}
+		case method == "thread/items/list" && (r.hideHistory || w.items == nil):
+			result = map[string]any{"data": []any{}, "nextCursor": nil}
+		case method == "thread/read" && r.stopBeforeID != "":
+			saved, err := w.client.RetryStore().Load(w.scope)
+			admitted := false
+			for _, snapshot := range saved.Snapshots {
+				admitted = admitted || snapshot.ID == r.stopBeforeID
+			}
+			if err == nil && admitted {
+				failure = "synthetic interruption after durable admission"
+			} else {
+				result, failure, notify = w.reply(req)
+			}
+		case method == "turn/start" || method == "turn/steer":
+			r.sends++
+			id, _ := p["clientUserMessageId"].(string)
+			text := p["input"].([]any)[0].(map[string]any)["text"].(string)
+			if method == "turn/start" {
+				w.turn, w.items = fmt.Sprint("independent-", r.sends), nil
+			} else if p["expectedTurnId"] != w.turn {
+				w.t.Error("manual steer lost exact turn", p)
+			}
+			w.status, w.loaded = "inProgress", "active"
+			input := retrySettingsInput(w.turn, id, text)
+			input[0].(map[string]any)["item"].(map[string]any)["id"] = "native-" + id
+			w.items = append(w.items, input...)
+			w.writeRollout(w.turn)
+			result = map[string]any{"turn": map[string]any{"id": w.turn}}
+			if method == "turn/steer" {
+				result = map[string]any{"turnId": w.turn}
+			}
+			if id == r.lostID {
+				r.hideHistory = true
+				result = map[string]any{}
+			}
+			if id == r.failSaveID {
+				if err := os.Chmod(w.recordDirectory, 0500); err != nil {
+					w.t.Error(err)
+				}
+			}
+		default:
+			result, failure, notify = w.reply(req)
+		}
+		r.mu.Unlock()
+		w.mu.Unlock()
+		reply := map[string]any{"id": req["id"], "result": result}
+		if failure != "" {
+			delete(reply, "result")
+			reply["error"] = map[string]any{"code": -32000, "message": failure}
+		}
+		if err := writeObject(conn, reply); err != nil {
+			return nil
+		}
+		if notify != nil {
+			if err := writeObject(conn, notify); err != nil {
+				return nil
+			}
+		}
+	}
+}
