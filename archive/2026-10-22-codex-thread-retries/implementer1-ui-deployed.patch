+			f.wire.mu.Lock()
+			defer f.wire.mu.Unlock()
+			if f.wire.starts != 1 || f.wire.updates != 1 {
+				t.Fatal("same-ID recovery repeated native or settings", f.wire.starts, f.wire.updates)
