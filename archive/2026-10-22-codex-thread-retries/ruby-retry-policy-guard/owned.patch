+    def turn_retry_policy_state?
+      root = File.join(@state, 'turn-retry-policy')
+      begin
+        stat = File.lstat(root)
+      rescue Errno::ENOENT
+        return false
+      end
+      unless stat.directory? && !stat.symlink?
+        raise Error, 'cannot inspect session retry policy state; preserve retained state and recover forward with a compatible package'
+      end
+
+      directories = [root]
+      until directories.empty?
+        directory = directories.pop
+        Dir.children(directory).each do |name|
+          path = File.join(directory, name)
+          entry = File.lstat(path)
+          if entry.directory?
+            directories << path
+          elsif name.end_with?('.json')
+            return true
+          elsif entry.symlink?
+            raise Error, 'cannot inspect session retry policy state; preserve retained state and recover forward with a compatible package'
+          end
+        end
+      end
