+
+func retentionSnapshot(id, turn string) Snapshot {
+	p := proof(turn)
+	p.ID, p.Origin, p.Proven = id, "steer", false
+	p.Digest, _ = p.Hash()
+	return p
+}
+
+func fillRetention(s *State, turn string, n int) {
+	for i := 0; i < n; i++ {
+		s.Snapshots = append(s.Snapshots, retentionSnapshot(fmt.Sprint("input-", i), turn))
+	}
+}
