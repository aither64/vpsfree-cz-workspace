+type planDeliveryWire struct {
+	mu                                        sync.Mutex
+	t                                         *testing.T
+	cwd, rollout, mode, latest, status        string
+	starts, updates, resumes                  int
+	items                                     []any
+	lost, hide, failSettings, failReceiptSave bool
