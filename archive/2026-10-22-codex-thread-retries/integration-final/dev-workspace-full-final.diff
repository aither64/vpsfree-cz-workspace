+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = lock.Close()
+	var stat unix.Stat_t
+	if err := unix.Stat(filepath.Join(s.config.AuthorityDir, "source.lock"), &stat); err != nil {
+		t.Fatal(err)
+	}
+	fixture.device, fixture.inode = stat.Dev, stat.Ino
+	return fixture
+}
