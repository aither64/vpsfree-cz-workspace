2026-10-23T14:58:19.8283871Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-23T14:58:19.8284303Z 
2026-10-23T14:58:19.8284666Z # To enable the settings / commands in this file for login shells as well,
2026-10-23T14:58:19.8285433Z # this file has to be sourced in /etc/profile.
2026-10-23T14:58:19.8285726Z 
2026-10-23T14:58:19.8285882Z # If not running interactively, don't do anything
2026-10-23T14:58:19.8286225Z [ -z "$PS1" ] && return
2026-10-23T14:58:19.8286393Z 
2026-10-23T14:58:19.8286551Z # check the window size after each command and, if necessary,
2026-10-23T14:58:19.8286961Z # update the values of LINES and COLUMNS.
2026-10-23T14:58:19.8287266Z shopt -s checkwinsize
2026-10-23T14:58:19.8287429Z 
2026-10-23T14:58:19.8287665Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-23T14:58:19.8288165Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-23T14:58:19.8288785Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-23T14:58:19.8289052Z fi
2026-10-23T14:58:19.8289146Z 
2026-10-23T14:58:19.8289329Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-23T14:58:19.8289775Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-23T14:58:19.8290193Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-23T14:58:19.8290532Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-23T14:58:19.8290813Z fi
2026-10-23T14:58:19.8290911Z 
2026-10-23T14:58:19.8291136Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-23T14:58:19.8291585Z # If this is an xterm set the title to user@host:dir
2026-10-23T14:58:19.8291871Z #case "$TERM" in
2026-10-23T14:58:19.8292069Z #xterm*|rxvt*)
2026-10-23T14:58:19.8292623Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
