2026-10-23T14:58:19.8297094Z 
2026-10-23T14:58:19.8297166Z # sudo hint
2026-10-23T14:58:19.8297669Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-10-23T14:58:19.8298334Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-10-23T14:58:19.8298959Z     if [ -x /usr/bin/sudo ]; then
2026-10-23T14:58:19.8299378Z 	cat <<-EOF
2026-10-23T14:58:19.8299882Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-10-23T14:58:19.8300539Z 	See "man sudo_root" for details.
2026-10-23T14:58:19.8300944Z 	
2026-10-23T14:58:19.8301214Z 	EOF
2026-10-23T14:58:19.8301488Z     fi
2026-10-23T14:58:19.8301765Z     esac
2026-10-23T14:58:19.8302051Z fi
2026-10-23T14:58:19.8302202Z 
2026-10-23T14:58:19.8302778Z # if the command-not-found package is installed, use it
