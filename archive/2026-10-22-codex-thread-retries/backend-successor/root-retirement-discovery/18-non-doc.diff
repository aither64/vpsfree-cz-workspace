+        File.open(#{calls.dump}, 'a') { |file| file.puts JSON.generate(ARGV) }
+        abort 'injected native retirement failure' if ARGV[0, 2] == ['thread', 'retire'] && File.exist?(#{fault_marker.dump})
+        if ARGV[0, 2] == ['team', 'prepare-delete']
