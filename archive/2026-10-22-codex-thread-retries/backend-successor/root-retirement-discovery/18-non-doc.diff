+
+      candidate = File.realpath(packages.fetch(0))
+      unless candidate == File.realpath(package_root) && candidate != predecessor &&
+             %w[bin/workspace-host bin/workspace-portal libexec/workspace-portal/dev-session].all? { |name| File.executable?(File.join(candidate, name)) }
+        raise Error, 'failed-creation deletion recovery requires the exact unselected source package'
+      end
+      require_failed_creation_recovery_contract!(predecessor, candidate)
