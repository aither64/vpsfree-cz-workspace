+      end
+      # Portal reconciliation takes its own shared transition lock. The caller
+      # performs that separate exact-request operation after this entry returns.
+    end
+
+    def require_failed_creation_recovery_generation!(token, predecessor, selected_codex)
+      unless token == profile_link_token && File.symlink?(@profile) &&
+             File.realpath(@profile) == predecessor && File.realpath(active_codex) == selected_codex
+        raise Error, 'selected workspace package or Codex changed during failed-creation deletion recovery'
+      end
+    end
+
+    def require_failed_creation_recovery_contract!(predecessor, candidate)
+      old, current = [predecessor, candidate].map do |package|
+        path = File.join(package, 'share/workspace-portal/runtime-contract.json')
+        parse_strict_json_object(File.binread(path, 64 * 1024 + 1), 'failed-creation recovery contract', 64 * 1024)
+      end
+      addition = 'turnRetrySessionPolicy'
+      unless current.eql?(RUNTIME_CONTRACT) && current[addition].is_a?(Integer) && current[addition] == 1 &&
+             (!old.key?(addition) || (old[addition].is_a?(Integer) && old[addition] == 1)) &&
+             old.reject { |key, _| key == addition }.eql?(current.reject { |key, _| key == addition }) &&
+             current.fetch('devSessionFlags').include?('--portal-command') && current['lifecycleJournals'] == LIFECYCLE_JOURNALS
+        raise Error, 'selected predecessor has an incompatible failed-creation recovery contract'
+      end
+    rescue SystemCallError => e
+      raise Error, "failed-creation recovery contract is unavailable: #{e.message}"
+    end
+
+    def failed_creation_delete_identity!(entry, slug, request_id)
+      load_archive_recovery_executor!
+      verifier = failed_creation_delete_verifier(entry)
+      verifier.with_verified_failed_creation_delete(slug, request_id:)
+    rescue DevSession::Error => e
+      raise Error, "failed-creation deletion verification failed: #{e.message}"
+    end
+
+    def failed_creation_delete_verifier(entry)
+      DevSession::Runner.new(
+        workspace: entry.fetch('root'), authority_dir: instance_runtime(entry).fetch(:authority),
+        tmux_socket: instance_runtime(entry).fetch(:tmux), codex_socket: instance_runtime(entry).fetch(:codex),
+        codex_command: active_codex, codex_version: codex_version(active_codex),
+        env: @env.to_h, require_runtime: false
+      )
+    end
