inal patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/fbrmzbsak0m5kx8is8i71igsnwmhxs9q-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://github.com/zeromq/libzmq/pull/4711/commits/55bd6b3df06734730d3012c17bc26681e25b549d.patch"]},"system":"x86_64-linux","version":4},"zhwaq1pghk6gqbjlcjgw3crf8ggrazay-M1-macro-0-footer.M1-1.9.1.drv":{"args":["--64","-f","/nix/store/48vpsn5rm5kb7134gr8ai9rzk67cplhb-M1-macro-0.M1-1.9.1","--little-endian","-o","/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9"],"builder":"/nix/store/pc7xsqqlrmd36wlnpikj5kfr2rrpfmck-blood-elf-0-1.9.1","env":{"builder":"/nix/store/pc7xsqqlrmd36wlnpikj5kfr2rrpfmck-blood-elf-0-1.9.1","name":"M1-macro-0-footer.M1-1.9.1","out":"/nix/store/m7ycsdgbw9s4w4xl7aa45z9ws5xsbrw2-M1-macro-0-footer.M1-1.9.1","pname":"M1-macro-0-footer.M1","system":"x86_64-linux","version":"1.9.1"},"inputs":{"drvs":{"d9q3m3dkpm5f2yidcnf39bxqy3xniw6q-M1-macro-0.M1-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"xsn3z4sqkn6ac7mlq35b62qs31mlnhbw-blood-elf-0-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":[]},"name":"M1-macro-0-footer.M1-1.9.1","outputs":{"out":{"path":"m7ycsdgbw9s4w4xl7aa45z9ws5xsbrw2-M1-macro-0-footer.M1-1.9.1"}},"system":"x86_64-linux","version":4},"zhwxmvlzwbg4dmgydr5c6xg6az6nz62p-OpenSP-1.5.2.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","env":{"out":"/nix/store/4mbfsnymaw7i5n3004jwyar16bsmjywx-OpenSP-1.5.2.tar.gz"},"inputs":{"drvs":{"10136ajvx1rhzs6b8ais9i6cwqjbsxg0-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"707fmw6193cbcr4wa8