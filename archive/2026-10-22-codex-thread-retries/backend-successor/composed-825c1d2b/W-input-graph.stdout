 sbin instead of bin.\nln -s bin \"$out/sbin\"\nmv $out/lib/modules-load.d $out/example\nmv $out/lib/sysusers.d $out/example\n","postPatch":"substituteInPlace src/basic/path-util.h --replace \"@defaultPathNormal@\" \"/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/bin/\"\nsubstituteInPlace meson.build \\\n  --replace \"find_program('clang'\" \"find_program('clang'\"\nshopt -s extglob\npatchShebangs tools test src/!(rpm|kernel-install|ukify) src/kernel-install/test-kernel-install.sh\n","preConfigure":"substituteInPlace src/libsystemd/sd-journal/catalog.c \\\n  --replace /usr/lib/systemd/catalog/ $out/lib/systemd/catalog/\n","preInstall":"export DESTDIR=/\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"src":"/nix/store/kban61mm86a1nhq05rzg771n4l7qfjgw-source","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":false,"stripExclude":["lib/systemd/boot/efi/*"],"system":"x86_64-linux","version":"260.2"},"system":"x86_64-linux","version":4},"4hffil34ch5smcg5cbq754jhkwibkxmh-crate-zerocopy-0.8.31.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","env":{"out":"/nix/store/zgnxma07id4ip4k7gyqhkj9lvwq5xi68-crate-zerocopy-0.8.31.tar.gz"},"inputs":{"drvs":{"10136ajvx1rhzs6b8ais9i6cwqjbsxg0-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"707fmw6193cbcr4wa8h0c06khamrlwzh-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"jfk5cr6f6ry3hlb9lpa5hyzh17m73i37-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"ycllkcwvqhbhbnkhjny8hxqcwxk9hs8z-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"crate-zerocopy-0.8.31.tar.gz","outputs":{"out":{"hash":"sha256-/XTsmLklCts8pVS93iaa32MVSfUdio+PChC1DxyymMM="