yxgwdjy-869d0cbca3b0b5e594b3254869a34d549664e089.patch?full_index=1"],"pname":"nodejs-slim","postConfigure":"","postFixup":"HOST_PATH=$out/bin patchShebangs --host $out $corepack $npm\n\nfor dir in \"$npm/lib/node_modules/npm/man/\"*; do\n  mkdir -p $npm/share/man/$(basename \"$dir\")\n  for page in \"$dir\"/*; do\n    ln -rs $page $npm/share/man/$(basename \"$dir\")\n  done\ndone\n","postInstall":"mkdir -p $dev/bin\ncp out/Release/{bytecode_builtins_list_generator,mksnapshot,torque,node_js2c,gen-regexp-special-case} $dev/bin\n\n$out/bin/node --completion-bash > node.bash\ninstallShellCompletion node.bash\n\n\nmkdir -p $npm/share/bash-completion/completions\nln -s $npm/lib/node_modules/npm/lib/utils/completion.sh \\\n  $npm/share/bash-completion/completions/npm\n\n# install the missing headers for node-gyp\n# TODO: use propagatedBuildInputs instead of copying headers.\ncp -r /nix/store/78clspwgq61jj4y1ln9clxbgy18n5qy1-ada-3.4.4/include/* /nix/store/bvryc561m5cn5nfqavxqql6sw84cvk2r-brotli-1.2.0-dev/include/* /nix/store/9w0ys61j2h6ry37j9vanacy9xz0lk9a5-c-ares-1.34.8-dev/include/* /nix/store/3flh93mwld9vgpi893p919l0lvzlhhmp-llhttp-9.4.3-dev/include/* /nix/store/fz2s2ckr3hclnphy173yvrpb64l0fhnf-libuv-1.52.1-dev/include/* /nix/store/d3qzvky0xvxzhl5r4i9lpni9gsjifyh9-merve-1.2.2/include/* /nix/store/3mjbx8xhlnp8qkjdwbb6y8x9zmyg5f0k-nghttp2-1.69.0-dev/include/* /nix/store/xpvn3c6nkk7cgav0wwm6blg03aphzlgs-nghttp3-1.15.0-dev/include/* /nix/store/da764zck0fadyiz45ip4g4i8k8xz9dnd-ngtcp2-1.22.1-dev/include/* /nix/store/27dj4bd2636m5r9fl9kfhpawiygvkp5p-openssl-3.6.3-dev/include/* /nix/store/jzpz9wynpwmddmpln1w0cds02di5kpsz-simdjson-4.6.4/include/* /nix/store/8pnmmp5ahpsgwmj48radg4bysdinhkyr-simdutf-6.5.0/include/* /nix/store/rjcp14md3ak00d36ppx7rhaab20i5f0c-sqlite-3.51.2-dev/include/* /nix/store/zzxm5bswdk5mln6kkdn4zrkpqpvz831g-uvwasi-0.0.23/include/* /nix/store/4dqrmfgg548b3zcd5wl30j3pj2jyvpkg-zlib-1.3.2-dev/include/* /nix/store/zn1dzwl0gi06sllcqanvk8grnbrpsbcg-zstd-1.5.7-dev/include/* $out/include/node\n\n# assemble a static v8 library and put it in the 'libv8' output\nmkdir -p $libv8/lib\npushd out/Release/obj\nfind . -path \"**/torque_*/**/*.o\" -or -path \"**/v8*/**/*.o\" \\\n  -and -not -name \"torque.*\" \\\n  -and -not -name \"mksnapshot.*\" \\\n  -and -not -name \"gen-regexp-special-case.*\" \\\n  -and -not -name \"bytecode_builtins_list_generator.*\" \\\n  | sort -u >files\ntest -s files # ensure that the list is not empty\n$AR -cqs $libv8/lib/libv8.a @files\npopd\n\n# copy v8 headers\ncp -r deps/v8/include $libv8/\n\n# create a pkgconfig file for v8\nmajor=$(grep V8_MAJOR_VERSION deps/v8/include/v8-version.h | cut -d ' ' -f 3)\nminor=$(grep V8_MINOR_VERSION deps/v8/include/v8-version.h | cut -d ' ' -f 3)\npatch=$(grep V8_PATCH_LEVEL deps/v8/include/v8-version.h | cut -d ' ' -f 3)\nmkdir -p $libv8/lib/pkgconfig\ncat > $libv8/lib/pkgconfig/v8.pc << EOF\nName: v8\nDescription: V8 JavaScript Engine\nVersion: $major.$minor.$patch\nLibs: -L$libv8/lib -lv8 -pthread -licui18n -licuuc\nCflags: -I$libv8/include\nEOF\ncp -r $out/include $dev/include\n","postPatch":"substituteInPlace tools/install.py \\\n  --replace-fail '  corepack_files(options, action)' \"  oip=options.install_path;options.install_path='$corepack';corepack_files(options, action);options.install_path=oip\" \\\n  --replace-fail '  npm_files(options, action)' \"  oip=options.install_path;options.install_path='$npm';npm_files(options, action);options.install_path=oip\"\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"setOutputFlags":false,"setupHook":"/nix/store/ay9ps6p97mf12nybf9d4r3nyina81b87-setup-hook.sh","src":"/nix/store/7w9s1sbk3zf9x41g1fqmcjp5rxd7anap-node-v24.19.0.tar.xz","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"24.19.0"},"system":"x86_64-linux","version":4},"jr0x81gryd72nkc7064kqbz402di1i6h-Test-RequiresInternet-0.05.tar.gz.drv":{"