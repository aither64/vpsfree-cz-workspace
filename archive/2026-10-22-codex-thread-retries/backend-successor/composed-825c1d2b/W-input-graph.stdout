ildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/qmv85369r1a3gm16cihxjynsi518xags-musl-1.2.5-dev","doCheck":"","doInstallCheck":"","dontAddStaticConfigureFlags":"1","dontDisableStatic":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"stackprotector","mesonFlags":"","name":"musl-1.2.5","nativeBuildInputs":"/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/bhk34kfgnwjmd4dp25wjs5pc8df414cw-musl-1.2.5","outputs":"out bin dev debug","patches":"/nix/store/mdmbvb93z195n3bij8pa838v3safw346-300-relative.patch /nix/store/72fpjkqigm2ssmzsajvcar5g8vb86q4n-CVE-2025-26519_0.patch /nix/store/54zx02rd8drmrcq3i69y93srfxs5dnjf-CVE-2025-26519_1.patch /nix/store/fhs9vjjjgzpq70dzf7jwl5ipr9zhbbkl-CVE-2026-6042.patch /nix/store/alsk597agykwgmiljv54cxs1ykah2ryj-CVE-2026-40200.patch /nix/store/ym7qvxyrjvqqp5y9mfmgs909k410w6gk-stdio-skip-empty-iovec-when-buffering-is-disabled.patch","pname":"musl","postInstall":"# Not sure why, but link in all but scsi directory as that's what uclibc/glibc do.\n# Apparently glibc provides scsi itself?\n(cd $dev/include && ln -s $(ls -d /nix/store/cijinz4hl3lkcw6jydz74gkpz9921wss-linux-headers-6.18.7/include/* | grep -v \"scsi$\") .)\n\n\n\n# Create 'ldd' symlink, builtin\nln -s $out/lib/libc.so $bin/bin/ldd\n\n# (impure) cc wrapper around musl for interactive usuage\nfor i in musl-gcc musl-clang ld.musl-clang; do\n  moveToOutput bin/$i $dev\ndone\nmoveToOutput lib/musl-gcc.specs $dev\nsubstituteInPlace $dev/bin/musl-gcc \\\n  --replace $out/lib/musl-gcc.specs $dev/lib/musl-gcc.specs\n\n# provide 'iconv' utility, using just-built headers, libc/ldso\n$CC /nix/store/2bim63kxh3vi6ka6inclfpba9rsjj6v9-iconv.c -o $bin/bin/iconv \\\n  -I$dev/include \\\n  -L$out/lib -Wl,-rpath=$out/lib \\\n  -lc \\\n  -B $out/lib \\\n  -Wl,-dynamic-linker=$(ls $out/lib/ld-*)\n# Create 'libc.musl-$arch' symlink\nln -rs $out/lib/libc.so $out/lib/libc.musl-x86_64.so.1\ninstall -D /nix/store/5rcakigix8xmpkmcx90a083pkf8v0gwp-sys-queue.h $dev/include/sys/queue.h\ninstall -D /nix/store/byib83r321c1fjgdk37kai1q1zxncra7-sys-cdefs.h $dev/include/sys/cdefs.h\ninstall -D /nix/store/rnay1kyfxqvjhmk0bfj7g85q6zskk1xy-sys-tree.h $dev/include/sys/tree.h\n","postPatch":"substituteInPlace configure \\\n  --replace -fno-unwind-tables \"\" \\\n  --replace -fno-asynchronous-unwind-tables \"\"\n","preBuild":"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","src":"/nix/store/mp8mmm58idwnlcla8fb2d3289q9m2b26-musl-1.2.5.tar.gz","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.2.5"},"inputs":{"drvs":{"blhyn00pdcbkcxmnwi2f4fm4y26d1bff-sys-cdefs.h.drv":{"dynamicOutputs":{},"outputs":["out"]},"by4cl66h6gdym8xqh33a89sqgg6029hi-sys-tree.h.drv":{"dynamicOutputs":{},"outputs":["out"]},"cpay38ibrb7za95c750w7h6slnxkv8nd-linux-headers-6.18.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"cx0z006vpj4hsz406759jddy3cvajj9w-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"dng1fqvzj0cxksd3w77zz8jac4fvlc75-CVE-2025-26519_0.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"fygs19i0py2b0zl7mh9p6qxky0sb28db-sys-queue.h.drv":{"dynamicOutputs":{},"outputs":["out"]},"h4hziiwija95d2xrpz1ca2kq0cfsqc4w-CVE-2025-26519_1.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"jz89dbp8r11j3i764yc1rxnjz2p51y3y-iconv.c.drv":{"dynamicOutputs":{},"outputs":["out"]},"kq1iy1srd56gr82xjp8shjn1fqb8dba8-musl-1.2.5.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"lh3338z7mb1yjwrzal9r5wbj3z9l7azh-300-relative.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"p6fmz26z57skxr4b7fwd6w8g7frvfw19-CVE-2026-40200.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"rwykm1352nfi14kx21bdnr6fs7wpxgv1-CVE-2026-6042.patch.drv":{"dynamicOutpu