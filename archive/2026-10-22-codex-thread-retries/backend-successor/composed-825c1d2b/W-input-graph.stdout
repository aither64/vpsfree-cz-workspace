zx-tinycc-musl-unstable-2025-12-03-libs/lib\"\nexport AR=\"tcc -ar\"\nexport lt_cv_sys_max_cmd_len=32768\n\nexport CFLAGS=\"-D__LITTLE_ENDIAN__=1\"\nbash ./configure --prefix=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9 --build=x86_64-unknown-linux-gnu --host=x86_64-unknown-linux-gnu --with-sysroot=/ --disable-dependency-tracking --disable-nls --enable-deterministic-archives --disable-gprofng --enable-new-dtags --with-lib-path=:\n\n# Build\nmake -j $NIX_BUILD_CORES all-libiberty all-gas all-bfd all-libctf all-zlib all-gprof\nmake all-ld # race condition on ld/.deps/ldwrite.Po, serialize\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install\n\n# gprof/addr2line/elfedit + man pages are unused downstream.\nrm -f $out/bin/gprof $out/bin/addr2line $out/bin/elfedit\nrm -rf $out/share/info $out/share/man\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"binutils-2.46.0","out":"/nix/store/z8va212wrar5kxwv4ivlalrzasm2clx1-binutils-2.46.0","passAsFile":"buildCommand","pname":"binutils","system":"x86_64-linux","version":"2.46.0"},"inputs":{"drvs":{"3zhi7fn92ym1ds0n3yybmjyjvksypi39-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"4hfq6p045k7knv86fc57kq5cnf2djia6-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gwpvw0ssr7xmfzvy97c6f493fhc2f7r-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"cblshqv4b81g5gxis3zpb4inagkaffi1-binutils-2.46.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"d9hngw468h7b7fpcyx284kqwdgcn3gzy-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"j1aiw0pfh51nyay8zavyx3adq86xdnkl-tinycc-musl-unstable-2025-12-03-compiler.drv":{"dynamicOutputs":{},"outputs":["out"]},"jm8c5a9ysfm3fckryllnl6pd3nm1hd17-bootstrap-coreutils-musl-9.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"jvn6rxfx2j66k0svyl5njyqzq2nh0v5s-gnutar-musl-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"l6a6rj0gy31gp6k7k80qzn4ni0yvyzgh-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a9pds57ms69gfi2ya-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"v8jl1cziqai2qqgn0axr9cv3masm5nb5-bash-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"xlhf3ibq6r6qy2myin330ay7qscfzi1g-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"zmvpmmh7i1qba20c97v4cl6yi7zqpv3a-gnupatch-2.5.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["1bs8wn3nwiji4vcwfzxpncwsa1pnh404-fix-tinycc-attribute.patch","70acbfgbz5cxsx4sqzcnj8qaqhb4i9ay-bash-builder.sh","sqbhaaayam0xw3a3164ks1vvbrdhl9vq-deterministic.patch"]},"name":"binutils-2.46.0","outputs":{"out":{"path":"z8va212wrar5kxwv4ivlalrzasm2clx1-binutils-2.46.0"}},"system":"x86_64-linux","version":4},"s2hjwqhh6xz3h8dwl73r97g7191nm5pr-tinycc-musl-unstable-2025-12-03.drv":{"args":["-e","/nix/store/9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh"],"builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","env":{"PATH":"/nix/store/whsh3m5f892b10k5xg3j5x2vfplakwpw-tinycc-musl-unstable-2025-12-03-compiler/bin:/nix/store/azdj57mzy4npxfajhmgv91iz6wzb3686-gnupatch-2.5.9/bin:/nix/store/9i47y99mnryi9ldkalnpr0mp4iijqkwa-gnutar-1.12/bin:/nix/store/6skcsg3yn7afxaf0mkp0d0n4yjyz08s4-gzip-1.2.4/bin:/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin:/nix/store/mr3ikv5qcbjs672v5fsyxhfa6vn0v8f5-bootstrap-coreutils-5.0/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","SHELL":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","buildCommand":"# Unpack\ntar xzf /nix/store/j8vqssml916z4hvq1dk36w19grfrks7y-cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341.tar.gz\ncd tinycc-cb41cbf\n\n# Patch\npatch -Np0 -i /nix/store/caakpwmdf9gpgdinaqrikc7vr8y62mf6-static-link.patch\nreplace --file i386-asm.c --output i386-asm.c --match-on \"switch(size)\" --replace-with \"if (reg >= 8) { cstr_printf(add_str, \\\"%%r%d%c\\\", reg, (size == 1) ? 'b' : ((size == 2) ? 'w' : ((size == 4) ? 'd' : ' '))); return; } switch(size)\"\n\n# If performing ptr + (-1) for example, the offset should be ptrdiff_t and not size_t\nreplace --file tccgen.c --output tccgen.c --match-on \"vpush_type_size(pointed_type(&vtop[-1].type), &align);\" --replace-with \"vpush_type_size(pointed_type(&vtop[-1].type), &align); if (!(vtop[-1].type.t & VT_UNSIGNED)) gen_cast_s(VT_PTRDIFF_T);\"\n\n# Configure\ntouch config.h\n\n# Build\n# We first have to recompile using tcc-0.9.26 as tcc-0.9.27 is not self-hosting,\n# but when linked with musl it is.\nln -s /nix/store/8vaxvk541czfwm8h41i705hf4a1gispq-musl-1.2.6/lib/libtcc1.a ./libtcc1.a\n\ntcc \\\n  -B /nix/store/km6izy2mps05hgn54byk9vav7lmkazil-tinycc-musl-unstable-2025-12-03-libs/lib \\\n  -DC2STR \\\n  -o c2str \\\n  conftest.c\n./c2str include/tccdefs.h tccdefs_.h\n\ntcc -v \\\n  -static \\\n  -o tcc-musl \\\n  -D TCC_TARGET_X86_64=1 \\\n  -D CONFIG_TCCDIR=\\\"\\\" \\\n  -D CONFIG_TCC_CRTPREFIX=\\\"{B}\\\" \\\n  -D CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\" \\\n  -D CONFIG_TCC_LIBPATHS=\\\"{B}\\\" \\\n  -D CONFIG_TCC_SYSINCLUDEPATHS=\\\"/nix/store/8vaxvk541czfwm8h41i705hf4a1gispq-musl-1.2.6/include\\\" \\\n  -D TCC_LIBGCC=\\\"libc.a\\\" \\\n  -D TCC_LIBTCC1=\\\"libtcc1.a\\\" \\\n  -D CONFIG_TCC_STATIC=1 \\\n  -D CONFIG_USE_LIBGCC=1 \\\n  -D TCC_VERSION=\\\"0.9.27\\\" \\\n  -D ONE_SOURCE=1 \\\n  -D TCC_MUSL=1 \\\n  -D CONFIG_TCC_PREDEFS=1 \\\n  -D CONFIG_TCC_SEMLOCK=0 \\\n  -D CONFIG_TCC_BACKTRACE=0 \\\n  -B . \\\n  -B /nix/store/km6izy2mps05hgn54byk9vav7lmkazil-tinycc-musl-unstable-2025-12-03-libs/lib \\\n  tcc.c\n# libtcc1.a\nrm -f libtcc1.a\ntcc -c -D HAVE_CONFIG_H=1 lib/libtcc1.c\ntcc -ar cr libtcc1.a libtcc1.o\n\n# Rebuild tcc-musl with itself\n./tcc-musl \\\n  -v \\\n  -static \\\n  -o tcc-musl \\\n  -D TCC_TARGET_X86_64=1 \\\n  -D CONFIG_TCCDIR=\\\"\\\" \\\n  -D CONFIG_TCC_CRTPREFIX=\\\"{B}\\\" \\\n  -D CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\" \\\n  -D CONFIG_TCC_LIBPATHS=\\\"{B}\\\" \\\n  -D CONFIG_TCC_SYSINCLUDEPATHS=\\\"/nix/store/8vaxvk541czfwm8h41i705hf4a1gispq-musl-1.2.6/include\\\" \\\n  -D TCC_LIBGCC=\\\"libc.a\\\" \\\n  -D TCC_LIBTCC1=\\\"libtcc1.a\\\" \\\n  -D CONFIG_TCC_STATIC=1 \\\n  -D CONFIG_USE_LIBGCC=1 \\\n  -D TCC_VERSION=\\\"0.9.27\\\" \\\n  -D ONE_SOURCE=1 \\\n  -D TCC_MUSL=1 \\\n  -D CONFIG_TCC_PREDEFS=1 \\\n  -D CONFIG_TCC_SEMLOCK=0 \\\n  -D CONFIG_TCC_BACKTRACE=0 \\\n  -B . \\\n  -B /nix/store/8vaxvk541czfwm8h41i705hf4a1gispq-musl-1.2.6/lib \\\n  tcc.c\n# libtcc1.a\nrm -f libtcc1.a\n./tcc-musl -c -D HAVE_CONFIG_H=1 lib/libtcc1.c\n./tcc-musl -c -D HAVE_CONFIG_H=1 lib/alloca.S\n./tcc-musl -ar cr libtcc1.a libtcc1.o alloca.o\n\n# Install\ninstall -D tcc-musl $out/bin/tcc\ninstall -Dm444 libtcc1.a $out/lib/libtcc1.a\n","builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","name":"tinycc-musl-unstable-2025-12-03","out":"/nix/store/yr2zlb7xa6mjiyfl44aai4632cm8a8pp-tinycc-musl-unstable-2025-12-03","passAsFile":"buildCommand","pname":"tinycc-musl","system":"x86_64-linux","version":"unstable-2025-12-03"},"inputs":{"drvs":{"05z44243pvwk3qrcimv1cf5g3nxi5jjb-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"6f6p45qkd5mhdwvfzgxdydwdpplccvgj-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"7g9biqznf18jyzs1r19hhlbf1jvwyivl-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"d1simrxi41d15h88m043y00yd400fpd4-cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"hyz2fh44bhyj16rypvs556g2rr9sycv1-musl-1.2.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"lgd7h63qh3mjndrhj3q41h8g2xn1bar9-tinycc-musl-unstable-2025-12-03-compiler.drv":{"dynamicOutputs":{},"outputs":["out"]},"qcz565439vz47snj3vky7rbdd4ihvxzl-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"whq0s6ghclpnf52df7f03msah0fqr4vs-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutput