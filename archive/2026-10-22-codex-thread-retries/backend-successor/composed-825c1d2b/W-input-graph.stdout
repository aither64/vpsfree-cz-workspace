-enable-add-ons","--sysconfdir=/etc","--enable-stack-protector=strong","--enable-bind-now","--without-headers","--disable-profile","--enable-fortify-source","--enable-static-pie"],"depsBuildBuild":["/nix/store/j1938gsbvbhkyz4kbmvjk56r479mkw3s-gcc-wrapper-16.2.0"],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"BASH_SHELL":"/bin/sh","LOCALEDEF_FLAGS":"--little-endian","NIX_NO_SELF_RPATH":1,"is64bit":true,"linuxHeaders":""},"extraNativeBuildInputs":["/nix/store/h4wfwic161kxrr74jlzla5lsm28hgary-glibc-2.44-25"],"installFlags":["sysconfdir=$(out)/etc"],"installPhase":"mkdir -p \"$out/lib/locale\" \"$out/share/i18n\"\ncp -v \"$TMPDIR/$NIX_STORE/\"*\"/lib/locale/locale-archive\" \"$out/lib/locale\"\ncp -v ../localedata/SUPPORTED \"$out/share/i18n/SUPPORTED\"\n","is64bit":true,"linuxHeaders":"","makeFlags":["OBJCOPY=objcopy","zonedir=/usr/share/zoneinfo","BUILD_LDFLAGS=-Wl,-rpath,/nix/store/h4wfwic161kxrr74jlzla5lsm28hgary-glibc-2.44-25/lib","OBJDUMP=/nix/store/y5sgl0vvrpbcwgjwpjs60r1hg0gi7i0n-binutils-2.46/bin/objdump","localedata/install-locales","localedir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/locale"],"mesonFlags":[],"name":"glibc-locales-2.44-25","nativeBuildInputs":["/nix/store/xrbwwd9zjvalag6hlxbrvgyb9y1wvfdn-bison-3.8.2","/nix/store/gfkkr23q11kvyz6xxyxz3qbsp1msxdcv-gettext-1.0","/nix/store/q6cpy3g7jva3lsnfzw4v48bb9058gmrp-python3-minimal-3.14.7","/nix/store/m38wglsqnh1mrmj2cmqa3pjb6w4yjxdi-glibc-2.44-25-dev"],"outputChecks":{"out":{}},"outputs":["out"],"patches":["/nix/store/xb11mg2vxj0al4gvh3hfy9wwz0kb1if0-2.44-master.patch","/nix/store/nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch","/nix/store/43lp683anlywwy1m6rv0mrw9m2iv681q-dont-use-system-ld-so-cache.patch","/nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch","/nix/store/llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch","/nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch","/nix/store/001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch","/nix/store/ywdz7fsdiff19745v59snscar3qsgd79-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch","/nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch","/nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch","/nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch"],"pname":"glibc-locales","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n","postInstall":"moveToOutput bin/getent $getent\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/q0lbdx5yv93a3md74kjhm0v2kljjii89-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"# Awful hack: `localedef' doesn't allow the path to `locale-archive'\n# to be overriden, but you *can* specify a prefix, i.e. it will use\n# <prefix>/<path-to-glibc>/lib/locale/locale-archive.  So we use\n# $TMPDIR as a prefix, meaning that the locale-archive is placed in\n# $TMPDIR/nix/store/...-glibc-.../lib/locale/locale-archive.\nLOCALEDEF_FLAGS+=\" --prefix=$TMPDIR\"\n\nexport inst_complocaledir=\"$TMPDIR/\"/nix/store/h4wfwic161kxrr74jlzla5lsm28hgary-glibc-2.44-25/lib/locale\nmkdir -p \"$inst_complocaledir\"\n\necho 'C.UTF-8/UTF-8 \\' >> ../localedata/SUPPORTED\n\n# Hack to allow building of the locales (needed since glibc-2.12)\nsubstituteInPlace ../localedata/Makefile \\\n  --replace-fail '$(rtld-prefix) $(common-objpfx)locale/localedef' 'localedef $(LOCALEDEF_FLAGS)'\n","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"setupHook":"/nix/store/fbsh5pmwsmjj7h2ngslnamm250cv2bnq-locales-setup-hook.sh","src":"/nix/store/jq00nlpdcxgcj5xwx25jibn61a611234-glibc-2.44.tar.xz","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"2.44-25"},"system":"x86_64-linux","version":4},"ww3f3ib9jr5hljh34p5k1b2gkp5jx7bd-perl-5.42.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","env":{"NIX_CFLAGS_COMPILE":"","NIX_MAIN_PROGRAM":"perl","__structuredAttrs":"","buildInputs":"","builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"-de -Dprefix=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9 -Dman1dir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/share/man/man1 -Dman3dir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/share/man/man3 -Dcc=cc -Duseshrplib -Uinstallusrbinperl -Dinstallstyle=lib/perl5 -Dlocincpth=/nix/store/rlrznkmvs6jyp5kgq5jv2wqam83jv1r7-glibc-2.42-84-dev/include -Dloclibpth=/nix/store/rkiwrqh8g6gs5rws4bf1s3mrdcs15gm9-glibc-2.42-84/lib -Accflags=-D_GNU_SOURCE -Dusethreads -A clear:d_crypt_r","configurePlatforms":"","configureScript":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash ./Configure","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","devdoc":"/nix/store/sczr30zdz64b996diipxjsf9299dl6km-perl-5.42.0-devdoc","disallowedReferences":"/nix/store/hbsz2ngi9ixbhd9na1xagh2yc8qnmj7y-gcc-wrapper-15.2.0","doCheck":"","doInstallCheck":"","dontAddPrefix":"1","dontAddStaticConfigureFlags":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","man":"/nix/store/wsnad4nqhmvx1svk6vcvwpqkklq58a6k-perl-5.42.0-man","mesonFlags":"","name":"perl-5.42.0","nativeBuildInputs":"","out":"/nix/store/4yxr38mpbvmrdr7cp3l1zczhqvj9439c-perl-5.42.0","outputs":"out man devdoc","patches":"/nix/store/6dd4aj4q0n602yg42cqz46g76plb7wif-no-sys-dirs.patch /nix/store/3ifi7476gv5ikllxbkzkchaisf5ds93y-CVE-2026-8376.patch","pname":"perl","postConfigure":"","postInstall":"# Remove dependency between \"out\" and \"man\" outputs.\nrm \"$out\"/lib/perl5/*/*/.packlist\n\n# Remove dependencies on glibc and gcc\nsed \"/ *libpth =>/c    libpth => ' ',\" \\\n  -i \"$out\"/lib/perl5/*/*/Config.pm\n# TODO: removing those paths would be cleaner than overwriting with nonsense.\nsubstituteInPlace \"$out\"/lib/perl5/*/*/Config_heavy.pl \\\n  --replace \"/nix/store/rlrznkmvs6jyp5kgq5jv2wqam83jv1r7-glibc-2.42-84-dev\" /no-such-path \\\n  --replace \"/nix/store/hbsz2ngi9ixbhd9na1xagh2yc8qnmj7y-gcc-wrapper-15.2.0\" /no-such-path \\\n  --replace \"/nix/store/6hjng4hd5c688hjgdcyb1rzfjz220srh-gcc-15.2.0\" /no-such-path \\\n  --replace \"/no-such-path\" /no-such-path \\\n  --replace \"$man\" /no-such-path\n","postPatch":"substituteInPlace dist/PathTools/Cwd.pm \\\n  --replace \"/bin/pwd\" \"$(type -P pwd)\"\nrm -rf cpan/HTTP-Tiny\nmkdir -p cpan/HTTP-Tiny\n\ntar --strip-components=1 -C cpan/HTTP-Tiny -xf /nix/store/jlqba5y57i3jci9fdrg7cb2phwlxvmgl-HTTP-Tiny-0.094.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/HTTP-Tiny -type f -exec chmod a-x {} +\n\nrm -rf cpan/Compress-Raw-Zlib\nmkdir -p cpan/Compress-Raw-Zlib\n\ntar --strip-components=1 -C cpan/Compress-Raw-Zlib -xf /nix/store/5bwwd3c0a0wyrsalx048sjrxkj9jc334-Compress-Raw-Zlib-2.222.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Compress-Raw-Zlib -type f -exec chmod a-x {} +\n\nrm -rf cpan/Compress-Raw-Bzip2\nmkdir -p cpan/Compress-Raw-Bzip2\n\ntar --strip-components=1 -C cpan/Compress-Raw-Bzip2 -xf /nix/store/7zngpz79lxvj9rgbmzvs7lizr64qj8di-Compress-Raw-Bzip2-2.218.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Compress-Raw-Bzip2 -type f -exec chmod a-x {} +\n\nrm -rf cpan/IO-Compress\nmkdir -p cpan/IO-Compress\n\ntar --strip-components=1 -C cpan/IO-Compress -xf /nix/store/5q7xqjml453ckx9sk2plzbjxf6bkrqg9-IO-Compress-2.220.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/IO-Compress -type f -exec chmod a-x {} +\n\nrm -rf cpan/Archive-Tar\nmkdir -p cpan/Archive-Tar\n\ntar --strip-components=1 -C cpan/Archive-Tar -xf /nix/store/53yp48jf1rnbf978f1dql94j9128zi1l-Archive-Tar-3.12.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Archive-Tar -type f -exec chmod a-x {} +\n# Perl's build system uses the src variable, and its value may end up in\n# the output in some cases (when cross-compiling).\nunset src\n","preConfigure":"cat > config.over <<EOF\nosvers=\"gnulinux\"\nmyuname=\"nixpkgs\"\nmyhostname=\"nixpkgs\"\ncf_by=\"nixpkgs\"\ncf_time=\"$(date -d \"@$SOURCE_DATE_EPOCH\")\"\nEOF\n\n# Compress::Raw::Zlib should use our zlib package instead of the one\n# included with the distribution\ncat > ./cpan/Compress-Raw-Zlib/config.in <<EOF\nBUILD_ZLIB   = False\nINCLUDE      = /nix/store/4dqrmfgg548b3zcd5wl30j3pj2jyvpkg-zlib-1.3.2-dev/include\nLIB          = /nix/store/yq335q9gkpbpm9z7vzfcfngydldpj6q4-zlib-1.3.2/lib\nOLD_ZLIB     = False\nGZIP_OS_CODE = AUTO_DETECT\nUSE_ZLIB_NG  = False\nZLIB_INCLUDE = /nix/store/4dqrmfgg548b3zcd5wl30j3pj2jyvpkg-zlib-1.3.2-dev/include\nZLIB_LIB     = /nix/store/yq335q9gkpbpm9z7vzfcfngydldpj6q4-zlib-1.3.2/lib\nEOF\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setOutputFlags":"","setupHook":"/nix/store/dm81j9qdcdr4c458pqbc9wvq9ymgzk4m-setup-hook.sh","src":"/nix/store/mhcbhc42ymmh2laf6yr0m2jimr07y8z0-perl-5.42.0.tar.gz","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"5.42.0"},"inputs":{"drvs":{"2fp6w5x73xid21s244h4sz5z6yjfsac4-glibc-2.42-84.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"3fiaam5rvj8yfacngwr7p9vs11zd8n5g-Compress-Raw-Zlib-2.222.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"4v205kdf9fayw00k4wxx20abw5hbdh6q-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"4y9kzg6h4wxyfpvw3ml99ia9cgn8p6n7-perl-5.42.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"7zi2040j4zk02fj86pngxpw091rkr8ms-IO-Compress-2.220.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"8wjz435nqc46mz0ndzh02hwa6fnpip3n-gcc-wrapper-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"cx0z006vpj4hsz406759jddy3cvajj9w-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"hpyarkycr4m0ppy39319r3gq0y5km1fy-gcc-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"kbadg0bs1m129vqy9gjrihf30z1zy1rm-Compress-Raw-Bzip2-2.218.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"m60kxbwzc815289i46idwnk79ss0bdqz-HTTP-Tiny-0.094.tar.gz.drv":{"dynamicOutputs":{},"ou