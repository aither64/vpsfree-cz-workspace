.3 mpc\n\n# Patch\npatch -Np1 -i /nix/store/7bqlyrbj1r9ddcmm825g9zzhrgwxy9fw-no-system-headers.patch\n# doesn't recognise musl\nsed -i 's|\"os/gnu-linux\"|\"os/generic\"|' libstdc++-v3/configure.host\n\n# Configure\nexport CC=\"gcc -Wl,-dynamic-linker -Wl,/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/lib/libc.so\"\nexport CFLAGS_FOR_TARGET=\"-Wl,-dynamic-linker -Wl,/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/lib/libc.so\"\nexport C_INCLUDE_PATH=\"/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/include\"\nexport CPLUS_INCLUDE_PATH=\"$C_INCLUDE_PATH\"\nexport LIBRARY_PATH=\"/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/lib\"\n\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-native-system-header-dir=/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/include \\\n  --with-build-sysroot=/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6 \\\n  --enable-languages=c,c++ \\\n  --enable-checking=release \\\n  --disable-bootstrap \\\n  --disable-dependency-tracking \\\n  --disable-libgomp \\\n  --disable-libmudflap \\\n  --disable-libquadmath \\\n  --disable-libssp \\\n  --disable-libstdcxx-pch \\\n  --disable-lto \\\n  --disable-multilib \\\n  --disable-nls\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"gcc-cxx-4.6.4","out":"/nix/store/xms9pin5rh7l1d7p2yibqwpcv3vz2kcy-gcc-cxx-4.6.4","passAsFile":"buildCommand","pname":"gcc-cxx","system":"x86_64-linux","version":"4.6.4"},"inputs":{"drvs":{"18d4rgqv4dfdd3qq09r312hpzjjxwrky-gcc-4.6.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"37zapxlhmx12r050xsjw39n4vw3nck3a-mpc-1.0.3.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b0xnqkbv7qnbbbc7zhqwahygjf7mc2i-findutils-4.10.0.drv":{"dynamicOutputs"