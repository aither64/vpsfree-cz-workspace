x/store/r1r1ls8j4ca1vbsysajrq99qc1zgxn41-ninja-1.13.2 /nix/store/8w5py73f81yixkqkzq0w3f2w90326fkr-pkg-config-wrapper-0.29.2 /nix/store/w8mnw9h158ikd0cw5wjs9mhvqihbzbr4-perl-5.42.0 /nix/store/h3l4z7p6wny3phbckwwhy1i2g52pdnj4-python3-3.13.15 /nix/store/5aif797j8bs2g0c4bc1jjdw1vdzbgx29-python3.13-packaging-26.1 /nix/store/8gkjjin0bhnrni8mwa0jqqfsl6xsb72r-wrap-python-hook /nix/store/3jdbra59k1zvb2ml8wc0xiwy2f10x8m4-gettext-1.0 /nix/store/a4yzsb981ymmqlvp1jszyx02kybqigj6-libxslt-1.1.45-dev /nix/store/bwchsx61gfp1y9fc355p5vqaxxa7m69w-gi-docgen-2026.1 /nix/store/qhw7grgyz25sfk4fn9w9c3i03nplgb9s-gobject-introspection-wrapped-1.86.0-dev /nix/store/21l1gphiiwmsprf0bn974hr8sz5hgihi-systemtap-5.4 /nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/3zrzn6fp2ylm7y1cya5jjsgi47ffgbdc-glib-2.88.3","outputs":"bin out dev devdoc debug","patches":"/nix/store/1741v6rlizzg8k41myx7jk53rwa24b2m-glib-appinfo-watch.patch /nix/store/xmaba5a6w625vcyk9iaf44vzz8mnydk7-schema-override-variable.patch /nix/store/d8pkc3xxx3arcvdid48vh8imx9q9g4vq-elementary-terminal-support.patch /nix/store/0s51jr07rjwls4bwwb7mrpzikc2ax15m-split-dev-programs.patch /nix/store/abzy833a3cyracjdj47qxkx26r7lw2sg-gdb_script.patch","pname":"glib","postCheck":"rm $out/lib/libgobject-2.0.so.0\nrm $out/lib/libgio-2.0.so.0\nrm $out/lib/libglib-2.0.so.0\n","postConfigure":"patchShebangs gio/gdbus-2.0/codegen/gdbus-codegen gobject/glib-{genmarshal,mkenums}\n","postFixup":"for i in $dev/bin/*; do\n  moveToOutput \"share/man/man1/${i##*/}.1.*\" \"$dev\"\ndone\n\n# Cannot be in postInstall, otherwise _multioutDocs hook in preFixup will move right back.\nmoveToOutput \"share/doc\" \"$devdoc\"\n","postInstall":"moveToOutput \"share/glib-2.0\" \"$dev\"\nmoveToOutput \"share/glib-2.0/gdb\" \"$out\"\nsubstituteInPlace \"$dev/bin/gdbus-codegen\" --replace \"$out\" \"$dev\"\nsed -i \"$dev/bin/glib-gettextize\" -e \"s|^gettext_dir=.*|gettext_dir=$dev/share/glib-2.0/gettext|\"\n\n# This file is *included* in gtk3 and would introduce runtime reference via __FILE__.\nsed '1i#line 1 \"glib-2.88.3/include/glib-2.0/gobject/gobjectnotifyqueue.c\"' \\\n  -i \"$dev\"/include/glib-2.0/gobject/gobjectnotifyqueue.c\nfor i in $bin/bin/*; do\n  moveToOutput \"share/bash-completion/completions/${i##*/}\" \"$bin\"\ndone\nfor i in $dev/bin/*; do\n  moveToOutput \"share/bash-completion/completions/${i##*/}\" \"$dev\"\ndone\n","postPatch":"patchShebangs glib/gen-unicode-tables.pl\npatchShebangs glib/tests/gen-casefold-txt.py\npatchShebangs glib/tests/gen-casemap-txt.py\npatchShebangs tools/gen-visibility-macros.py\npatchShebangs tests\n\n# Needs machine-id, comment the test\nsed -e '/\\/gdbus\\/codegen-peer-to-peer/ s/^\\/*/\\/\\//' -i gio/tests/gdbus-peer.c\nsed -e '/g_test_add_func/ s/^\\/*/\\/\\//' -i gio/tests/gdbus-address-get-session.c\n# All gschemas fail to pass the test, upstream bug?\nsed -e '/g_test_add_data_func/ s/^\\/*/\\/\\//' -i gio/tests/gschema-compile.c\n# Cannot reproduce the failing test_associations on hydra\nsed -e '/\\/appinfo\\/associations/d' -i gio/tests/appinfo.c\n# Needed because of libtool wrappers\nsed -e '/g_subprocess_launcher_set_environ (launcher, envp);/a g_subprocess_launcher_setenv (launcher, \"PATH\", g_getenv(\"PATH\"), TRUE);' -i gio/tests/gsubprocess.c\n","preCheck":"","preFixup":"buildPythonPath /nix/store/5aif797j8bs2g0c4bc1jjdw1vdzbgx29-python3.13-packaging-26.1\npatchPythonScript \"$dev/share/glib-2.0/codegen/utils.py\"\n","propagatedBuildInputs":"/nix/store/4dqrmfgg548b3zcd5wl30j3pj2jyvpkg-zlib-1.3.2-dev /nix/store/nxw8i0014ny1v588nziq9yax64gdkn3h-libffi-3.8.0-dev /nix/store/3jdbra59k1zvb2ml8wc0xiwy2f10x8m4-gettext-1.0 /nix/store/p1qg08rl7kd4rx49yk3lv9sd6s1rvlpd-glibc-iconv-2.42","propagatedNativeBuildInputs":"","separateDebugInfo":"1","setupHook":"/nix/store/qgfij9cxhp7gfjk6hs43hzy4n3w9am3c-setup-hook.sh","src":"/nix/store/4298knw9zvdfz2mg7xizhzdvcq4gl8sr-glib-2.88.3.tar.xz","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linu