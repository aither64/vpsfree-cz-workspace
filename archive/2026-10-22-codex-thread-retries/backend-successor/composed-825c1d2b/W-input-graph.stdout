,"owner":"python","patches":[],"postFetch":"unpackDir=\"$TMPDIR/unpack\"\nmkdir \"$unpackDir\"\ncd \"$unpackDir\"\n\nrenamed=\"$TMPDIR/download.tar.gz\"\nmv \"$downloadedFile\" \"$renamed\"\nunpackFile \"$renamed\"\nchmod -R +w \"$unpackDir\"\nif [ $(ls -A \"$unpackDir\" | wc -l) != 1 ]; then\n  echo \"error: zip file must contain a single file or directory.\"\n  echo \"hint: Pass stripRoot=false; to fetchzip to assume flat list of files.\"\n  exit 1\nfi\nfn=$(cd \"$unpackDir\" && ls -A)\nif [ -f \"$unpackDir/$fn\" ]; then\n  mkdir $out\nfi\nmv \"$unpackDir/$fn\" \"$out\"\n\n\nchmod 755 \"$out\"\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"recursiveHash":true,"repo":"mypy","rev":"refs/tags/v1.20.1","showURLs":false,"stdenv":"/nix/store/fbrmzbsak0m5kx8is8i71igsnwmhxs9q-stdenv-linux","strictDeps":false,"stripRoot":true,"system":"x86_64-linux","tag":"v1.20.1","urls":["https://github.com/python/mypy/archive/refs/tags/v1.20.1.tar.gz"]},"system":"x86_64-linux","version":4},"vda3dxp2568dwv487kb113qqmylby9g7-eval-apply-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"eval-apply-builder","out":"/nix/store/d12idshmaaj7n8a1qa0glh37js9ziv4c-eval-apply-builder","passAsFile":"text","system":"x86_64-linux","text":"mkdir ${out}\ncd ${out}\n/nix/store/n9mj1f0ipsva4vyd2llpdgv3wyrcmsm1-mes-src-0.27.1-bin/bin/mes-m2 -e main /nix/store/n9mj1f0ipsva4vyd2llpdgv3wyrcmsm1-mes-src-0.27.1-bin/bin/mescc.scm -D HAVE_CONFIG_H=1 -I /nix/store/vhbf57apsjqv01fnvhavm6iyk91m91si-mes-src-0.27.1/mes-0.27.1/include -I /nix/store/vhbf57apsjqv01fnvhavm6iyk91m91si-mes-src-0.27.1/mes-0