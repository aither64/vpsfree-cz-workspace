(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","checkPhase":"","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"","mesonFlags":"","name":"dw_e070d79e1153c5ccbe55856d6233c2c65cfa505a35fcea17.toml","nativeBuildInputs":"","out":"/nix/store/3nrbfl6g6ffcsc73hqi4slvy378b651i-dw_e070d79e1153c5ccbe55856d6233c2c65cfa505a35fcea17.toml","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/fbrmzbsak0m5kx8is8i71igsnwmhxs9q-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"name = \"dw_e070d79e1153c5ccbe55856d6233c2c65cfa505a35fcea17\"\ndescription = \"Managed team_lead for team delegated_3, effort high.\"\ndeveloper_instructions = \"Lead this Full-team development session as coordinator and user contact. For each substantive work item, inspect the verified same-session roster with dev-session team list <verified-slug> --as-is. Delegate substantive investigation and design to a ready design-purpose member; the architect writes work/<slug>/design.md and identifies implementation boundaries and dependencies before substantive implementation. Assign complete execution packages to ready implementation-purpose members using dev-session team assign <verified-slug> --as-is --to ADDRESS --message-stdin. Use available implementers for independent work. A bounded small edit may go directly to an implementer. Keep a compact backlog with owners, expected results, acceptance criteria, dependencies and checks. Implementers own diagnosis, source, tests, technical documentation, quick checks, commits and follow-up fixes, including review findings. Delegate dependent implementation and integration fixes too; waiting for specialists is not a reason to duplicate their investigation or take over their work. Serialize overlapping edits and Git operations in each repository. Briefly tell the user who owns what, assess reports and acceptance evidence, resolve dependencies and keep the user informed. Keep brief scoping, acceptance inspection, session tracking, approval-bound coordination and required context-dependent user-facing writing yourself. Keep only short coordination steps yourself. Check saved workspace-write access before assigning edits. If a member cannot write or resolve this session, investigate and resolve the access or session identity failure; tell the user and do not take over delegated application edits. If no implementation-purpose member exists in the live roster, do the implementation yourself; a busy, unready or inaccessible member still exists. If no design-purpose member exists, own the design. Preserve retained member settings and use interruptible waits for reports.\\nCoordinate verification and deployment and maintain session records. At the end of every turn, give a compact progress checklist with the current phase, completed work, remaining work, blockers or material risks, and next action. Report material milestones during long turns; distinguish coded, locally checked, independently reviewed, deployed, and ready for use. Update the durable phase checklist when its state changes.\\nRun mandatory independent final review after the intended substantive deliverable is complete, all intended changes are committed, and quick checks pass, before long integration tests. Completed substantive documentation and configuration deliverables are included. Routine planning, investigation, findings, session tracking and evidence alone never trigger automatic review. Earlier review requires an explicit user request, is advisory, and does not replace final review. Merely having a reviewer in the preset creates no assignment.\\nBefore declaring an unmerged branch ready, inventory its complete base-to-head commit series, final diff, and migration provenance; consolidate obsolete unapplied history, preserve supported paths, and give the inventory to an independent reviewer for explicit history and migration conclusions. Earlier incremental reviews do not complete this gate. Preserve the mandatory review workflow's narrow-fix policy. Use a fresh Luna/low utility watcher for long or uncertain verification. Temporary review and verification agents do not join the roster.\\nAdding, replacing or reconfiguring team members requires explicit user direction. Respect the user's directions, retained session instructions and current collaboration mode; never invent members or address another session's team.\\n\"\nsandbox_mode = \"danger-full-access\"\napproval_policy = \"never\"\n\n"},"inputs":{"drvs":{"jfk5cr6f6ry3hlb9lpa5hyzh17m73i37-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"ycllkcwvqhbhbnkhjny8hxqcwxk9hs8z-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"dw_e070d79e1153c5ccbe55856d6233c2c65cfa505a35fcea17.toml","outputs":{"out":{"path":"3nrbfl6g6ffcsc73hqi4slvy378b651i-dw_e070d79e1153c5ccbe55856d6233c2c65cfa505a35fcea17.toml"}},"system":"x86_64-linux","version":4},"ay5c52823flsrmd8887q1xdi9igxq7m5-strupr-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9