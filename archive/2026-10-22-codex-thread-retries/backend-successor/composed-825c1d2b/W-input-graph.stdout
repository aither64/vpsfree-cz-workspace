[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"setOutputFlags":false,"setupHooks":"/nix/store/skyp8xs2584fkc44ki1cim9ag55wbi68-setup-hook.sh","src":"/nix/store/rjla2n2jag8m7n8f2515s3rb74g985af-rustc-1.98.1-src.tar.gz","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":true,"stripDebugList":["bin"],"system":"x86_64-linux","version":"1.98.1"},"system":"x86_64-linux","version":4},"xk0kpra19allzcgwqqqilx22k6vbkfgy-python3.13-pytest-cov-stub-1.0.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","env":{"LANG":"C.UTF-8","__structuredAttrs":"","buildInputs":"","builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","catchConflicts":"1","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","disallowedReferences":"","dist":"/nix/store/ba7cvv4d9c4xlxzdd4lcm93w8cn9fkc7-python3.13-pytest-cov-stub-1.0.0-dist","doCheck":"","doInstallCheck":"1","dontWrapPythonPrograms":"","mesonFlags":"","name":"python3.13-pytest-cov-stub-1.0.0","nativeBuildInputs":"/nix/store/h3l4z7p6wny3phbckwwhy1i2g52pdnj4-python3-3.13.15 /nix/store/8gkjjin0bhnrni8mwa0jqqfsl6xsb72r-wrap-python-hook /nix/store/sbv1s7vpj7xq1i0xzk8lk3jjhqqxawgb-ensure-newer-sources-hook /nix/store/gxc801imkakyacggp2s0s9gabmdpzijp-python-remove-tests-dir-hook /nix/store/5g2fi2ncm3ylkxkvvzmaai89pk3hhpnq-python-catch-conflicts-hook /nix/store/ay5q13vwg5gn84agd22a72blsr76ja4b-python-remove-bin-bytecode-hook /nix/store/i2ikr86dav7fj7wanvl2wly9s8q016xw-pypa-build-hook.sh /nix/store/hj067bj5mxs1iy4nay8jlxqwlyviqncz-python-runtime-deps-check-hook.sh /nix/store/qfg27xk1gjnr0fdxff8gx8qg4f3ppq79-pypa-install-