mmand;'\nfi\n","preBuild":"# Upstream's ThinLTO + codegen-units=4 make late-stage rustc peak at\n# ~12 GiB and the whole build crawl; fall back to cargo defaults like\n# nixpkgs does. Line tables for codex-core/codex-tui add more memory\n# and the aarch64 builders OOM-kill rustc when many big crates compile\n# in parallel, so drop debuginfo and cap cargo's job count.\nsubstituteInPlace Cargo.toml \\\n  --replace-fail 'lto = \"thin\"' \"\" \\\n  --replace-fail 'codegen-units = 4' \"\" \\\n  --replace-fail 'debug = \"line-tables-only\"' 'debug = \"none\"'\nif [ \"$NIX_BUILD_CORES\" -gt 8 ]; then\n  export NIX_BUILD_CORES=8\nfi\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","sourceRoot":"source/codex-rs","src":"/nix/store/9is267xl3palxb615kk86qlli9nggkf9-source","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"0.163.0"},"inputs":{"drvs":{"109gn1ryh0xvy67zcxjrbk7vm6h8jjfl-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"15i5wzh2bfjn2zgshx3h5f3v8997nlx0-cargo-check-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"21innvbx093vkgdpi0bsllx84cxgb7b1-cargo-1.98.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"3icwg8a395a2kx5wjf9i56jj5br9mghb-version-check-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"3mpsxkqkww1418jfxpzhwyvi83dnhrfs-bubblewrap-0.12.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"4gi36dm0d23bi6kmzfmbxkgn711likn5-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"59vf7ypybrk9diynsp9c4hza1aw38v4h-libcap-2.78.drv":{"dynamicOutputs":{},"outputs":["dev"]},"6idc6nky9h345b4m2v2p3ppq8yhzpiwh-ripgrep-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"6kysq2svidbjdn1xrb51jlzyw6hcz8xc-cargo-setup-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"80i4k1vx1jl3yjvzvmrzakr2wl15mq6h-src_binding-150.4.0.rs.drv":{"dynamicOutputs":{},"outputs":["out"]},"bh24jswvl9r4lxbj57vb9ll1r1b16ghf-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"hp95mfq2w2