lCheck":"1","dontWrapPythonPrograms":"","mesonFlags":"","name":"python3.14-flake8-7.3.0","nativeBuildInputs":"/nix/store/lb41b0anx1f98y9y5s9mdv97gjgsq740-python3-3.14.7 /nix/store/mpqg9hiira9dc5gkdawd6pna982cwahv-wrap-python-hook /nix/store/x1f9skkpjginqvay1gpf8liwi72p0hdm-ensure-newer-sources-hook /nix/store/4nnwajchjix28pn07ha3j7zqhzz3lv9k-python-remove-tests-dir-hook /nix/store/p8qkp3d39lc1ksn8r3vgrm3pwxcg52gv-python-catch-conflicts-hook /nix/store/5qaz4if6frmg9i6923ylkyphf166r2fz-python-remove-bin-bytecode-hook /nix/store/vr83s1i28fxg01vmmapwhzs93m0nkclq-pypa-build-hook.sh /nix/store/s2z9qcgndqvxr7hjd0nn4lcd1ryakgjq-python-runtime-deps-check-hook.sh /nix/store/5mpfykjfizyf9zid6fy1prg8xqdhgaif-pypa-install-hook /nix/store/6kl422hjg95aqcnkrbllw0yzmq4n2c7y-python-imports-check-hook.sh /nix/store/z65sv2syk5wvq9p97fdfk87x8zkq835i-python-metadata-check-hook.sh /nix/store/k2bpdyx2sjdair9qw3v6dr6i280f77sk-python-namespaces-hook.sh /nix/store/fmbbbf3498lpzrjy5m4l6w161g3hzcv8-python-output-dist-hook /nix/store/fiwq290ghcn0zx89nkqvjfi5a0g5nd13-python3.14-setuptools-83.0.0 /nix/store/0s3rk62sq0iqfmvybfpnd6g5895kv7ra-pytest-check-hook","out":"/nix/store/i79m3cjpslr7ghhkj1w1wi2xc3ghqf63-python3.14-flake8-7.3.0","outputs":"out dist","patches":"","pname":"flake8","postFixup":"wrapPythonPrograms\n","propagatedBuildInputs":"/nix/store/65xbgdqwi6xv20da0aiv3c03vlb6w7vi-python3.14-mccabe-0.7.0 /nix/store/34nilhga0rfdsg90jwvh3y3bsisklqg8-python3.14-pycodestyle-2.14.0 /nix/store/x5d9jl8wk20i2fc6w1lbvdp1awb82xyl-python3.14-pyflakes-3.4.0 /nix/store/lb41b0anx1f98y9y5s9mdv97gjgsq740-python3-3.14.7","propagatedNativeBuildInputs":"","src":"/nix/store/nx6cp8nzqn0cf47dg242lb7r15h9ri8x-source","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"7.3.0"},"inputs":{"drvs":{"02qvnfm5x60q9g1wczmj50qsq7qr6z0r-python3.14-mccabe-0.7.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"109gn1ryh0xvy67zcxjrbk7vm6h8jjfl-stdenv-linux.drv":{"d