efault-builder.sh"],"builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","env":{"NIX_HARDENING_ENABLE":"bindnow libcxxhardeningfast pic relro stackclashprotection stackprotector strictflexarrays1 strictoverflow zerocallusedregs","NIX_MAIN_PROGRAM":"busybox","__structuredAttrs":"","buildInputs":"","builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","configurePhase":"export KCONFIG_NOTIMESTAMP=1\nmake allnoconfig\n\nfunction parseconfig {\n    while IFS=\" \" read NAME OPTION; do\n        if ! [[ \"$NAME\" =~ ^CONFIG_ ]]; then continue; fi\n\n        echo \"parseconfig: removing $NAME\"\n        sed -i /$NAME'\\(=\\| \\)'/d .config\n\n        echo \"parseconfig: setting $NAME=$OPTION\"\n        echo \"$NAME=$OPTION\" >> .config\n    done\n}\n\n\ncat << EOF | parseconfig\n\nCONFIG_PREFIX \"$out\"\nCONFIG_INSTALL_NO_USR y\n\nCONFIG_LFS y\n\n# More features for modprobe.\n\n\nCONFIG_STATIC y\n\n\n\n\n# Use the external mount.cifs program.\nCONFIG_FEATURE_MOUNT_CIFS n\nCONFIG_FEATURE_MOUNT_HELPERS y\n\n# Set paths for console fonts.\nCONFIG_DEFAULT_SETFONT_DIR \"/etc/kbd\"\n\n# Bump from 4KB, much faster I/O\nCONFIG_FEATURE_COPYBUF_KB 64\n\n# Doesn't build with current kernel headers.\n# https://bugs.busybox.net/show_bug.cgi?id=15934\nCONFIG_TC n\n\n# Set the path for the udhcpc script\nCONFIG_UDHCPC_DEFAULT_SCRIPT \"$out/default.script\"\n\nCONFIG_FEATURE_FANCY_ECHO y\nCONFIG_FEATURE_SH_MATH y\nCONFIG_FEATURE_SH_MATH_64 y\nCONFIG_FEATURE_TEST_64 y\n\nCONFIG_ASH y\nCONFIG_ASH_OPTIMIZE_FOR_SIZE y\n\nCONFIG_ASH_ALIAS y\nCONFIG_ASH_BASH_COMPAT y\nCONFIG_ASH_CMDCMD y\nCONFIG_ASH_ECHO y\nCONFIG_ASH_GETOPTS y\nCONFIG_ASH_INTERNAL_GLOB y\nCONFIG_ASH_JOB_CONTROL y\nCONFIG_ASH_PRINTF y\nCONFIG_ASH_TEST y\n\nCONFIG_CROSS_COMPILER_PREFIX \"\"\nCONFIG_FEATURE_UTMP n\nCONFIG_FEATURE_WTMP n\n\nEOF\n\nmake oldconfig\n\nrunHook postConfigure\n","debug":"/nix/store/vw9afapkavxqwg6dj4pzaqrcww6vd5yp-busybox-1.37.0-debug","depsBuildBuild":"/nix/store/hbsz2ngi9ixbhd9na1xagh2yc8qnmj7y-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"format fortify","makeFlags":"SKIP_STRIP=y","mesonFlags":"","name":"busybox-1.37.0","nativeBuildInputs":"/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/wjn2kkmswxldfbqgjai4vf92wd9z1p2k-busybox-1.37.0","outputs":"out debug","patches":"/nix/store/7wpjbl21q85z0vrqdx4c7lxg6n4rgwh7-busybox-in-store.patch /nix/store/ix0srl7w9s21y5bnpp4q8gmg7jwvjynd-fix-aarch64-sha1.patch /nix/store/221bb8kxaxp50dprlgw4m9qll0x3djd4-CVE-2023-39810.patch /nix/store/7kidyfd8x0fn46y1610yqknjbh5rffib-CVE-2026-26157_CVE-2026-26158.patch /nix/store/ivhl0vw16larnp208maq278bhzspf4qm-CVE-2026-26157_CVE-2026-26158-2.patch /nix/store/569ibvaqi0fxpxc2xndsi6dvfnqkasgf-busybox-1.37-fix-syslogd.patch /nix/store/qcp6w5nlqy2m4l2xj8sa07q3fpj4riz5-build-system-buffer-overflow.patch /nix/store/2asd10s4bxhpz6ylwc52m7di7xb3kwia-CVE-2025-60876.patch","pname":"busybox","postConfigure":"makeFlagsArray+=(\"CC=cc -isystem /nix/store/qmv85369r1a3gm16cihxjynsi518xags-musl-1.2.5-dev/include -B/nix/store/bhk34kfgnwjmd4dp25wjs5pc8df414cw-musl-1.2.5/lib -L/nix/store/bhk34kfgnwjmd4dp25wjs5pc8df414cw-musl-1.2.5/lib\")\n","postInstall":"sed -e '\n1 a busybox() { '$out'/bin/busybox \"$@\"; }\\\nlogger() { '$out'/bin/logger \"$@\"; }\\\n' /nix/store/4wbq5vgb43mhxd4cdc7fzs6cdaq6pp00-source/debian/tree/udhcpc/etc/udhcpc/default.script > $out/default.script\nsed -i 's|/sbin/resolvconf|\"$(busybox which resolvconf)\"|g' $out/default.script\nchmod 555 $out/default.script\nHOST_PATH=$out/bin patchShebangs --host $out/default.script\n","postPatch":"patchShebangs .","propagatedBuildInput