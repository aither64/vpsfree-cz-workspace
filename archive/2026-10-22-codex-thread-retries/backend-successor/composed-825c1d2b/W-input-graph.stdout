ext.o argmatch.o backupfile.o basename.o dirname.o getopt.o getopt1.o inp.o maketime.o partime.o patch.o pch.o quote.o quotearg.o quotesys.o util.o version.o xmalloc.o error.o\n\n# Check\n./patch --version\n\n# Install\nmkdir -p ${out}/bin\ncp ./patch ${out}/bin\nchmod 555 ${out}/bin/patch\n"},"inputs":{"drvs":{"m2khnp0iw665w7zjkyvil62v5wjlbl8i-patch-2.5.9.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"y0yxb5kxhvzffj19ggf3d7snxrc0xbjb-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"gnupatch-2.5.9-builder","outputs":{"out":{"path":"19af8r5m9q5l7did1vz8qbzlmr11afq2-gnupatch-2.5.9-builder"}},"system":"x86_64-linux","version":4},"qpwl5hz91p8xkgfwpr4v775b2prdl2fl-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","env":{"out":"/nix/store/vdl4k6npi1d79a0f70z1q3axkvdz0j82-source"},"inputs":{"drvs":{"10136ajvx1rhzs6b8ais9i6cwqjbsxg0-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"707fmw6193cbcr4wa8h0c06khamrlwzh-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"jfk5cr6f6ry3hlb9lpa5hyzh17m73i37-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"ycllkcwvqhbhbnkhjny8hxqcwxk9hs8z-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"source","outputs":{"out":{"hash":"sha256-VwOyR9YYhA/uyVRJbspNrKkJWJGYFFktwPnnwnIJ97s=","method":"nar"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-