ip\n\n# gprof/addr2line/elfedit + man pages are unused downstream.\nrm -f $out/bin/gprof $out/bin/addr2line $out/bin/elfedit\nrm -rf $out/include $out/lib $out/share\n\n# The target-prefixed tools duplicate the unprefixed tools byte-for-byte.\n# Keep the conventional target-prefixed paths, but make them symlinks.\ntargetBin=$out/x86_64-unknown-linux-gnu/bin\nif [ -d \"$targetBin\" ]; then\n  for tool in ar as ld ld.bfd nm objcopy objdump ranlib readelf strip; do\n    if [ -e \"$targetBin/$tool\" ] && cmp -s \"$out/bin/$tool\" \"$targetBin/$tool\"; then\n      rm \"$targetBin/$tool\"\n      ln -s ../../bin/$tool \"$targetBin/$tool\"\n    fi\n  done\nfi\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"binutils-static-2.46","out":"/nix/store/6pap6fdlrmd8inbl2kv1b40zsfvfgw8l-binutils-static-2.46","passAsFile":"buildCommand","pname":"binutils-static","system":"x86_64-linux","version":"2.46"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"0dpycpy1hz7sccz9w6a9vc22zfzc17hd-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"13xfjqnaic4i15jc78lx7yllnq7wf68l-gcc-wrapper-16.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"5qsfr7wfv9fnbk79s85v1gs759r2rw78-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"6v8bjfwdcw75b9hv7gzl0jyfljdlc3vw-binutils-2.47.drv":{"dynamicOutputs":{},"outputs":["out"]},"8xy9yi1vwp0mc32lz37jgva7hck5j9by-gawk-5.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"aw4a7hi7q0mb2ljazxq0in9f5v4905a5-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"bjfpxb6q4p4dxn2r8h5p337hn1vf444n-findutils-4.11.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"cblshqv4b81g5gxis3zpb4inagkaffi1-binutils-2.46.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"pip5q1b15n46rw6cbmz3jjk8mngqp7aw-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"wcy0xsar1c27zdiz6mb6nwgiygar2k6h-bash-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"x2k1rx0682qi8q01sv