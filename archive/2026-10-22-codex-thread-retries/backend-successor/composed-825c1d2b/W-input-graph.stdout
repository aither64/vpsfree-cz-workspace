st-*.py[co]\" -delete\n}\nappendToVar preDistPhases pytestRemoveBytecodePhase\n"},"system":"x86_64-linux","version":4},"26h8yr93n461mwg8jq2y8zk2spxkj08s-libutempter-1.2.3.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildInputs":"/nix/store/wz072hz2d26snq6a18yhyj1fxys5p70x-glib-2.88.3-dev","builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","makeFlags":"libdir=${out}/lib libexecdir=${out}/lib includedir=${out}/include mandir=${out}/share/man","mesonFlags":"","name":"libutempter-1.2.3","nativeBuildInputs":"","out":"/nix/store/191h9dgyni9q4grzjzkcad9hgc00cycg-libutempter-1.2.3","outputs":"out","patchFlags":"-p2","patches":"/nix/store/lzrq8vv9bw3s2rxqkp3v4zfvmdhkr9ss-exec_path.patch /nix/store/5sqbs87awm8vhfwd5gm4m7kjxpz4hmb2-build-overwrite-already-existing-symlinks-during-ins.patch /nix/store/6brhzahnasy6dqcyj5yf0w95l8zbahas-Makefile-add-STATIC-and-DYNAMIC-build-variables.patch","pname":"libutempter","prePatch":"substituteInPlace Makefile --replace 2711 0711\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","sourceRoot":"source/libutempter","src":"/nix/store/68wzff6p9gpvjdfrxrrda5zqhr7flays-source","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.2.3"},"inputs":{"drvs":{"cx0z006vpj4hsz406759jddy3cvajj9w-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"gvqw29g7g91xz9qqg8f7qjji1f59af60-build-overwrite-already-existing-symlinks-during-ins.patch.drv":{"dynamicOutputs":{},"outputs":[