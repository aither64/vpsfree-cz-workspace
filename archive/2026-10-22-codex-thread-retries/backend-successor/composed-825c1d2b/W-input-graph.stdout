p7k4yy4m8vz8l9k-perl-5.42.0-devdoc","disallowedReferences":"/nix/store/hbsz2ngi9ixbhd9na1xagh2yc8qnmj7y-gcc-wrapper-15.2.0","doCheck":"","doInstallCheck":"","dontAddPrefix":"1","dontAddStaticConfigureFlags":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","man":"/nix/store/n76nk4n71h5srghid9853rxwglxn78r2-perl-5.42.0-man","mesonFlags":"","name":"perl-5.42.0","nativeBuildInputs":"","out":"/nix/store/w8mnw9h158ikd0cw5wjs9mhvqihbzbr4-perl-5.42.0","outputs":"out man devdoc","patches":"/nix/store/6dd4aj4q0n602yg42cqz46g76plb7wif-no-sys-dirs.patch /nix/store/3ifi7476gv5ikllxbkzkchaisf5ds93y-CVE-2026-8376.patch","pname":"perl","postConfigure":"","postInstall":"# Remove dependency between \"out\" and \"man\" outputs.\nrm \"$out\"/lib/perl5/*/*/.packlist\n\n# Remove dependencies on glibc and gcc\nsed \"/ *libpth =>/c    libpth => ' ',\" \\\n  -i \"$out\"/lib/perl5/*/*/Config.pm\n# TODO: removing those paths would be cleaner than overwriting with nonsense.\nsubstituteInPlace \"$out\"/lib/perl5/*/*/Config_heavy.pl \\\n  --replace \"/nix/store/rlrznkmvs6jyp5kgq5jv2wqam83jv1r7-glibc-2.42-84-dev\" /no-such-path \\\n  --replace \"/nix/store/hbsz2ngi9ixbhd9na1xagh2yc8qnmj7y-gcc-wrapper-15.2.0\" /no-such-path \\\n  --replace \"/nix/store/6hjng4hd5c688hjgdcyb1rzfjz220srh-gcc-15.2.0\" /no-such-path \\\n  --replace \"/no-such-path\" /no-such-path \\\n  --replace \"$man\" /no-such-path\n","postPatch":"substituteInPlace dist/PathTools/Cwd.pm \\\n  --replace \"/bin/pwd\" \"$(type -P pwd)\"\nrm -rf cpan/HTTP-Tiny\nmkdir -p cpan/HTTP-Tiny\n\ntar --strip-components=1 -C cpan/HTTP-Tiny -xf /nix/store/jlqba5y57i3jci9fdrg7cb2phwlxvmgl-HTTP-Tiny-0.094.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/HTTP-Tiny -type f -exec chmod a-x {} +\n\nrm -rf cpan/Compress-Raw-Zlib\nmkdir -p cpan/Compress-Raw-Zlib\n\ntar --strip-components=1 -C cpan/Compress-Raw-Zlib -xf /nix/store/5bwwd3c0a0wyrsalx048sjrxkj9jc334-Compress-Raw-Zlib-2.222.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Compress-Raw-Zlib -type f -exec chmod a-x {} +\n\nrm -rf cpan/Compress-Raw-Bzip2\nmkdir -p cpan/Compress-Raw-Bzip2\n\ntar --strip-components=1 -C cpan/Compress-Raw-Bzip2 -xf /nix/store/7zngpz79lxvj9rgbmzvs7lizr64qj8di-Compress-Raw-Bzip2-2.218.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Compress-Raw-Bzip2 -type f -exec chmod a-x {} +\n\nrm -rf cpan/IO-Compress\nmkdir -p cpan/IO-Compress\n\ntar --strip-components=1 -C cpan/IO-Compress -xf /nix/store/5q7xqjml453ckx9sk2plzbjxf6bkrqg9-IO-Compress-2.220.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/IO-Compress -type f -exec chmod a-x {} +\n\nrm -rf cpan/Archive-Tar\nmkdir -p cpan/Archive-Tar\n\ntar --strip-components=1 -C cpan/Archive-Tar -xf /nix/store/53yp48jf1rnbf978f1dql94j9128zi1l-Archive-Tar-3.12.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Archive-Tar -type f -exec chmod a-x {} +\n# Perl's build system uses the src variable, and its value may end up in\n# the output in some cases (when cross-compiling).\nunset src\n","preConfigure":"cat > config.over <<EOF\nosvers=\"gnulinux\"\nmyuname=\"nixpkgs\"\nmyhostname=\"nixpkgs\"\ncf_by=\"nixpkgs\"\ncf_time=\"$(date -d \"@$SOURCE_DATE_EPOCH\")\"\nEOF\n\n# Compress::Raw::Zlib should use our zlib package instead of the one\n# included with the distribution\ncat > ./cpan/Compress-Raw-Zlib/config.in <<EOF\nBUILD_ZLIB   = False\nINCLUDE      = /nix/store/4dqrmfgg548b3zcd5wl30j3pj2jyvpkg-zlib-1.3.2-dev/include\nLIB          = /nix/store/yq335q9gkpbpm9z7vzfcfngydldpj6q4-zlib-1.3.2/lib\nOLD_ZLIB     = False\nGZIP_OS_CODE = AUTO_DETECT\nUSE_ZLIB_NG  = False\nZLIB_INCLUDE = /nix/store/4dqrmfgg548b3zcd5wl30j3pj2jyvpkg-zlib-1.3.2-dev/include\nZLIB_LIB     = /nix/store/yq335q9gkpbpm9z7vzfcfngydldpj6q4-zlib-1.3.2/lib\nEOF\n","propagatedBuildInputs":"/nix/store/ka5dyx2ammky5biplc2fmfdlqk1s4rk