\/\\//' -i gio/tests/gdbus-peer.c\nsed -e '/g_test_add_func/ s/^\\/*/\\/\\//' -i gio/tests/gdbus-address-get-session.c\n# All gschemas fail to pass the test, upstream bug?\nsed -e '/g_test_add_data_func/ s/^\\/*/\\/\\//' -i gio/tests/gschema-compile.c\n# Cannot reproduce the failing test_associations on hydra\nsed -e '/\\/appinfo\\/associations/d' -i gio/tests/appinfo.c\n# Needed because of libtool wrappers\nsed -e '/g_subprocess_launcher_set_environ (launcher, envp);/a g_subprocess_launcher_setenv (launcher, \"PATH\", g_getenv(\"PATH\"), TRUE);' -i gio/tests/gsubprocess.c\n","preCheck":"","preFixup":"buildPythonPath /nix/store/5aif797j8bs2g0c4bc1jjdw1vdzbgx29-python3.13-packaging-26.1\npatchPythonScript \"$dev/share/glib-2.0/codegen/utils.py\"\n","propagatedBuildInputs":"/nix/store/4dqrmfgg548b3zcd5wl30j3pj2jyvpkg-zlib-1.3.2-dev /nix/store/nxw8i0014ny1v588nziq9yax64gdkn3h-libffi-3.8.0-dev /nix/store/3jdbra59k1zvb2ml8wc0xiwy2f10x8m4-gettext-1.0 /nix/store/p1qg08rl7kd4rx49yk3lv9sd6s1rvlpd-glibc-iconv-2.42","propagatedNativeBuildInputs":"","separateDebugInfo":"1","setupHook":"/nix/store/qgfij9cxhp7gfjk6hs43hzy4n3w9am3c-setup-hook.sh","src":"/nix/store/4298knw9zvdfz2mg7xizhzdvcq4gl8sr-glib-2.88.3.tar.xz","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.88.3"},"inputs":{"drvs":{"3g8pq2ic3hl6k5qyqzg7nb0x27pwy3fw-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"3s5dp28m9wabwfczvzkzv78aq5viqagb-gnum4-1.4.21.drv":{"dynamicOutputs":{},"outputs":["out"]},"447f826z0gjy1xr55r2npckpq4xcmmzv-libsysprof-capture-50.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"4kbjccsvsgf0cbbq3rmcw4jxynlnsza9-pcre2-10.46.drv":{"dynamicOutputs":{},"outputs":["dev"]},"4v205kdf9fayw00k4wxx20abw5hbdh6q-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"93fl39ak4jhpiq7qzfl4irk29ih94g48-wrap-python-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"bj3az2i0iz3zam7ag4n01kvdyrk7x59m-libselinux-3.10.drv":