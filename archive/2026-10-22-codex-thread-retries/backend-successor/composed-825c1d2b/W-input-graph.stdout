73vdgl6xs1hycac8kf2n9 --build=x86_64-unknown-linux-gnu --host=x86_64-unknown-linux-gnu --with-sysroot=/ --disable-dependency-tracking --disable-nls --enable-deterministic-archives --disable-gprofng --enable-new-dtags --with-lib-path=: --disable-gold --disable-plugins\n\n# Build\nmake -j $NIX_BUILD_CORES all-libiberty all-gas all-bfd all-libctf all-zlib all-gprof\nmake all-ld # race condition on ld/.deps/ldwrite.Po, serialize\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install\n\n# gprof/addr2line/elfedit + man pages are unused downstream.\nrm -f $out/bin/gprof $out/bin/addr2line $out/bin/elfedit\nrm -rf $out/share/info $out/share/man\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"binutils-2.47","out":"/nix/store/r04s6g51v2002prayd855xazjrsiszlb-binutils-2.47","passAsFile":"buildCommand","pname":"binutils","system":"x86_64-linux","version":"2.47"},"inputs":{"drvs":{"05z44243pvwk3qrcimv1cf5g3nxi5jjb-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"0dpycpy1hz7sccz9w6a9vc22zfzc17hd-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"8xy9yi1vwp0mc32lz37jgva7hck5j9by-gawk-5.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"a9zsjk7jcksa22bv35f7rhnbkhd71d66-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"aw4a7hi7q0mb2ljazxq0in9f5v4905a5-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"kxh2m956988rmzxrm8kcgddd8l1l755c-binutils-2.47.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"pip5q1b15n46rw6cbmz3jjk8mngqp7aw-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"rk3s60afwm2lzcsjpsbpdyaa90c21q4z-gnutar-musl-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"wcy0xsar1c27zdiz6mb6nwgiygar2k6h-bash-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"x2k1rx0682qi8q01svmay16q1c4glss2-bootstrap-coreutils-musl-9.11.drv":{"dynamicOutputs":{},"outputs":["