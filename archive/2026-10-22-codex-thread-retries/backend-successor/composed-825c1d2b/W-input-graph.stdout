/store/9gp1dcbsgimk40ca7wcw0y8bkcbdyvv1-e3ce4623c299068bbd47c35ee87aab334bac73b1.patch /nix/store/h33h0wkqqd4cqhs9hczh3gsy8vra9pbs-3f6e928d34aca977bd5d4191e6d2c2338a342.patch","pname":"openblas","postInstall":"    # Provide headers in /include directly for compat with some consumers like flint\n    (cd $dev/include && ln -sf openblas/*.h .)\n\n    # Write pkgconfig aliases. Upstream report:\n    # https://github.com/OpenMathLib/OpenBLAS/issues/1740\n    for alias in blas cblas lapack; do\n      cat <<EOF > $out/lib/pkgconfig/$alias.pc\nName: $alias\nVersion: 0.3.33\nDescription: $alias provided by the OpenBLAS package.\nCflags: -I$dev/include\nLibs: -L$out/lib -lopenblas\nEOF\n    done\n\n    # Setup symlinks for blas / lapack\nln -s $out/lib/libopenblas.so $out/lib/libblas.so\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so\nln -s $out/lib/libopenblas.so $out/lib/liblapacke.so\nln -s $out/lib/libopenblas.so $out/lib/libblas.so.3\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so.3\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so.3\nln -s $out/lib/libopenblas.so $out/lib/liblapacke.so.3\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"/nix/store/hg40cf61p13ki8f6qkn371qxzg1n7h1l-check-phase-thread-limit-hook","src":"/nix/store/8s966i8ks25b81iq8agnsmj8bz2zacp3-source","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.3.33"},"inputs":{"drvs":{"27zcims7njpmnizxnbwx0r20ni143vyj-3f6e928d34aca977bd5d4191e6d2c2338a342.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"8wjz435nqc46mz0ndzh02hwa6fnpip3n-gcc-wrapper-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"b2vwxzdkf48hdadbnrqi2phvr4raaync-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"cx0z006vpj4hsz406759jddy3cvajj9w-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"gzf5ign62dinii0770a963fq1l2cxv46-check-phase-thread-limit-hook.drv":{"dynamicOutputs":{},"outp