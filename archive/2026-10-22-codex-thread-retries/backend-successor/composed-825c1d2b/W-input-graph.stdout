ilder.sh"],"builder":"/nix/store/pzpmwj3agpmlkjfq0g62r2zxa7qysdya-bash-static-5.3/bin/bash","env":{"BASH_SHELL":"/bin/sh","LOCALEDEF_FLAGS":"--little-endian","NIX_NO_SELF_RPATH":"1","__structuredAttrs":"","buildInputs":"/nix/store/dmpn2sl84sqf9fskr16qwp4pbs5nm729-linux-headers-6.18.7","builder":"/nix/store/pzpmwj3agpmlkjfq0g62r2zxa7qysdya-bash-static-5.3/bin/bash","cmakeFlags":"","configureFlags":"-C --enable-add-ons --sysconfdir=/etc --enable-stack-protector=strong --enable-bind-now --without-headers --disable-profile --enable-fortify-source --enable-static-pie","depsBuildBuild":"/nix/store/z1lli1lpsp8b0ppgbvfi62dby3lwc0g7-bootstrap-stage4-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","extraNativeBuildInputs":"/nix/store/rkiwrqh8g6gs5rws4bf1s3mrdcs15gm9-glibc-2.42-84","installFlags":"sysconfdir=$(out)/etc","installPhase":"mkdir -p \"$out/lib/locale\" \"$out/share/i18n\"\ncp -v \"$TMPDIR/$NIX_STORE/\"*\"/lib/locale/locale-archive\" \"$out/lib/locale\"\ncp -v ../localedata/SUPPORTED \"$out/share/i18n/SUPPORTED\"\n","is64bit":"1","linuxHeaders":"","makeFlags":"OBJCOPY=objcopy BUILD_LDFLAGS=-Wl,-rpath,/nix/store/rkiwrqh8g6gs5rws4bf1s3mrdcs15gm9-glibc-2.42-84/lib OBJDUMP=/nix/store/vn3bzpk3dphwr2slxw1hkcq2fbcyn8xp-binutils-patchelfed-ld-2.46/bin/objdump localedata/install-locales localedir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/locale","mesonFlags":"","name":"glibc-locales-2.42-84","nativeBuildInputs":"/nix/store/znr5k5q69yivzf293wx2ylzr50advi0v-bison-3.8.2 /nix/store/c161y8md1c358p652fg3v01kxrnjlz33-gettext-1.0 /nix/store/wylqjdv2y6hj13cfbnszkmja4xx6jyi7-python3-minimal-3.13.15 /nix/store/rlrznkmvs6jyp5kgq5jv2wqam83jv1r7-glibc-2.42-84-dev","out":"/nix/store/llxig24gr63nfvcz5zl5j6d2jg7j5q6p-glibc-locales-2.42-84","outputs":"out","patches":"/nix/store/f3xrdrys50y52ij1vg5lk6qdqpvqmf9r-2.42-master.patch /nix/store/nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch /nix/store/b1w7zbvm39ff1i52iyjggyvw2rdxz104-dont-use-system-ld-so-cache.patch /nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch /nix/store/llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch /nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch /nix/store/001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch /nix/store/0mb1pqwqkz9sk1fwgn897zlwzhhgfpbf-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch /nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch /nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch /nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch","pname":"glibc-locales","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n","postInstall":"moveToOutput bin/getent $getent\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/xidgjdv05b8yz6w6qrhk4mmjxm4l2zjf-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"# Awful hack: `localedef' doesn't allow the path to `locale-archive'\n# to be overriden, but you *can* specify a prefix, i.e. it will use\n# <prefix>/<path-to-glibc>/lib/locale/locale-archive.  So we use\n# $TMPDIR as a prefix, meaning that the locale-archive is placed in\n# $TMPDIR/nix/store/...-glibc-.../lib/locale/locale-archive.\nLOCALEDEF_FLAGS+=\" --prefix=$TMPDIR\"\n\nexport inst_complocaledir=\"$TMPDIR/\"/nix/store/rkiwrqh8g6gs5rws4bf1s3mrdcs15gm9-glibc-2.42-84/lib/locale\nmkdir -p \"$inst_complocaledir\"\n\necho 'C.UTF-8/UTF-8 \\' >> ../localedata/SUPPORTED\n\n# Hack to allow building of the locales (needed since glibc-2.12)\nsubstituteInPlace ../localedata/Makefile \\\n  --replace-fail '$(rtld-prefix) $(common-objpfx)locale/localedef' 'localedef $(LOCALEDEF_FLAGS)'\n","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHook":"/nix/store/92i87xh3nzzikq13li4p93rizh45v8zk-locales-setup-hook.sh","src":"/nix/store/6zxixmszg0vbhpaa8rxwfr05by9axj68-glibc-2.42.tar.xz","stdenv":"/nix/store/j7m4brsfqw8kx6w4y9yx9n99p7gcpx30-bootstrap-stage4-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.42-84"},"inputs":{"drvs":{"2fp6w5x73xid21s244h4sz5z6yjfsac4-glibc-2.42-84.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"56vp67z4fqd6mpharm40p845npvsy7iy-bootstrap-stage4-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"7bhl034fnmzc48aybssbg0jivhxckbjj-python3-minimal-3.13.15.drv":{"dynamicOutputs":{},"outputs":["out"]},"8injyx1z38allpqjwycg8c7dm9r93mzk-libidn2-2.3.8.drv":{"dynam