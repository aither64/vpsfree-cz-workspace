opagated":"","disallowedReferences":"","doCheck":"1","doInstallCheck":"","doc":"/nix/store/sqx197a0lp93cm2l48ixdqy7hl5g2nqf-man-db-2.13.1-doc","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"man-db-2.13.1","nativeBuildInputs":"/nix/store/3pj0qks6vl7namn8vr0m5sms89f4wg8m-autoconf-2.73 /nix/store/i0qqd93l8633w3rh428w1ngpdac98p4c-automake-1.18.1 /nix/store/mlx1krf7f39qgbnvyl4yqpasf5bd4dni-flex-2.6.4 /nix/store/gfkkr23q11kvyz6xxyxz3qbsp1msxdcv-gettext-1.0 /nix/store/d1f5dv26j6m0yg9as8xb72s1x3pwp77i-groff-1.24.1 /nix/store/4lcs0d6iqnxjwnbm7h2xv8dfs9lb17ny-libtool-2.6.2 /nix/store/5imzg4hlah4jhnxyrd03d7ymsmms9jaj-make-shell-wrapper-hook /nix/store/b9izmrfjp0qnnyahdwwrzdwi87s1h179-pkg-config-wrapper-0.29.2 /nix/store/ihpqfjr2ay1bwnig3yf6ggsiwc7hz5hg-zstd-1.5.7-dev /nix/store/2fhx5hvmnmg9cxm00fd0nv3xyl4kkp8v-glibc-iconv-2.44","out":"/nix/store/2i156r4cbi500d28xhw1l59ydcy13n2f-man-db-2.13.1","outputMan":"out","outputs":"out doc","patches":"/nix/store/p4m9shlpsqrvir464livcdni0y32ah3f-systemwide-man-db-conf.patch","pname":"man-db","postInstall":"# apropos/whatis uses program name to decide whether to act like apropos or whatis\n# (multi-call binary). `apropos` is actually just a symlink to whatis. So we need to\n# make sure that we don't wrap symlinks (since that changes argv[0] to the -wrapped name)\nfind \"$out/bin\" -type f | while read file; do\n  wrapProgram \"$file\" \\\n    --prefix PATH : \"/nix/store/d1f5dv26j6m0yg9as8xb72s1x3pwp77i-groff-1.24.1/bin:/nix/store/yr6ar7lsk3yfas4d464z1ysaxwcq2gc5-gzip-1.14/bin:/nix/store/yfqdq38iw1k9n0a0w1ncsxpl2fs5gy94-zstd-1.5.7-bin/bin\"\ndone\n","postPatch":"# Remove all mandatory manpaths. Nixpkgs makes no requirements on\n# these directories existing.\nsed -i 's/^MANDATORY_MANPATH/# &/' src/man_db.conf.in\n\n# Add Nix-related manpaths\necho \"MANPATH_MAP\t/nix/var/nix/profiles/default/bin\t/nix/var/nix/profiles/default/share/man\" >> src/man_db.conf.in\n\n# Add mandb locations for the above\necho \"MANDB_MAP\t/nix/var/nix/profiles/default/share/man\t/var/cache/man/nixpkgs\" >> src/man_db.conf.in\n","preConfigure":"./bootstrap --no-git --gnulib-srcdir=/nix/store/9h8g0fbv1wkligzsnlkq57ddgxgw72r8-gnulib-20241001 --gen\nconfigureFlagsArray+=(\"--with-sections=1 n l 8 3 0 2 5 4 9 6 7\")\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/6kz444k9yjlacfhrbw84qrbw1mk7vjgw-source","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.13.1"},"inputs":{"drvs":{"109gn1ryh0xvy67zcxjrbk7vm6h8jjfl-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"3wj040870zc61cdqdd4r32l3wf4rv5lv-autoconf-2.73.drv":{"dynamicOutputs":{},"outputs":["out"]},"4kzkzll12a78qzsjyppppzigkw3rpsmv-zstd-1.5.7.drv":{"dynamicOutputs":{},"outputs":["bin","dev"]},"5vg8xc5d8v1lhmaghdffsd2ag9b486vd-glibc-iconv-2.44.drv":{"dynamicOutputs":{},"outputs":["out"]},"7pf4al0mxgi4jn72shb05f1n9pws9qna-gdbm-1.26.drv":{"dynamicOutputs":{},"outputs":["dev"]},"ad6f0m19pv0sb0r5yl9ka9b7f1djq8xa-util-linux-minimal-2.42.3.drv":{"dynamicOutputs":{},"outputs":["bin"]},"bh24jswvl9r4lxbj57vb9ll1r1b16ghf-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"fn5i3887s6s1zddscmi789z9mzjn9hj2-automake-1.18.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"i2kj89fi4asijp0w9kxc03a0kzpb7xqx-libtool-2.6.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"lm3p8fsw1npd2p5d9bcbpfjak3l3jr2p-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"lnyq5q2k40gi6mn91cklcwydyb8nc3ha-gnulib-20241001.drv":{"dynamicOutputs":{},"outputs":["out"]},"nqdcl1i3fq49d3qi239k786xgkdgrf5p-gettext-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"p0gmia6imz59hs2hxhnhja5z96bpzcbz-gzip-1.14.drv":{"dynamicOutputs":{},"outputs":["out"]},"q7i3y60ys5b983a1m33c437rjgzanrpa-flex-2.6.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"shphrxa8887gyzagc23nh9ixsggrcpqq-libpipeline-1.5.8.drv":{"dynamicOutputs":{},"outputs":["out"]}