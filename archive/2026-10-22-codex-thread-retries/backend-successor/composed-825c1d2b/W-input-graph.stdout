,"depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","mesonFlags":"","name":"xmlto-0.0.29","nativeBuildInputs":"/nix/store/jdnb1ri4g690zr2x3dnly7yg88w0phyg-autoreconf-hook /nix/store/bpjwzx5qrfcpfnnl18nj6xxx6mpm5bqm-make-shell-wrapper-hook /nix/store/fhi7sx1sqmy4g8b7xpppvnydki778c8a-getopt-1.1.6 /nix/store/5f4162f3xj3lhvkyvv94h767gjy7ac56-libxml2-2.15.3-dev /nix/store/a4yzsb981ymmqlvp1jszyx02kybqigj6-libxslt-1.1.45-dev","out":"/nix/store/yawg224228766ls4rsb9nv7r7iv9a3g5-xmlto-0.0.29","outputs":"out","patches":"","pname":"xmlto","postInstall":"# `w3m' is needed for HTML to text conversions.\nwrapProgram \"$out/bin/xmlto\" \\\n   --prefix PATH : \"/nix/store/glyk6m67m3ayxjsbjssza725bnzy0bw7-libxslt-1.1.45-bin/bin:/nix/store/cxnx7gm2ljy4mgn66pl4bca67s2qh01z-libxml2-2.15.3-bin/bin:/nix/store/fhi7sx1sqmy4g8b7xpppvnydki778c8a-getopt-1.1.6/bin:/nix/store/wk88rkwhz2nlvs9l0890wyf1km06gykk-w3m-0.5.6/bin\"\n","postPatch":"patchShebangs xmlif/test/run-test\n\nsubstituteInPlace \"xmlto.in\" \\\n  --replace-fail \"@XMLTO_BASH_PATH@\" \"/nix/store/yisa2lg79zcvgk4ck4yr6r0lz6j63hs3-bash-interactive-5.3p9/bin/bash\" \\\n  --replace-fail \"@FIND@\" \"/nix/store/n82li8za1mykdpj921c0v4f7dr7f6vba-findutils-4.10.0/bin/find\" \\\n  --replace-fail \"@GETOPT@\" \"/nix/store/fhi7sx1sqmy4g8b7xpppvnydki778c8a-getopt-1.1.6/bin/getopt\" \\\n  --replace-fail \"@GREP@\" \"/nix/store/x3mmarawk8qkqf3257aidf7cljax6mc8-gnugrep-3.12/bin/grep\" \\\n  --replace-fail \"@MKTEMP@\" \"$(type -P mktemp)\" \\\n  --replace-fail \"@SED@\" \"/nix/store/cwr0fxlfy7jzfxwz2wyhd30a3bzw7vx1-gnused-4.10/bin/sed\" \\\n  --replace-fail \"@TAIL@\" \"/nix/store/61685rbaxmpigwi3z23i33sv3jyfl70q-coreutils-9.11/bin/tail\"\n\nfor f in format/docbook/* xmlto.in; do\n  substituteInPlace $f \\\n    --replace-fail \"http://docbook.sourceforge.net/release/xsl/current\" \"/nix/store/wr1i7mr291aln8b9769zr41z9idnlszc-docbook-xsl-nons-1.79.2/xml/xsl/docbook\"\ndone\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/fn1p85j9v3ks6n39lqwnvikblyhlv8nl-xmlto","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"0.0.29"},"inputs":{"drvs":{"3sljck1n1q7mbhmk8cgdasf9nb46qdi3-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"8mczhs7dcvni600nd1gs3rv675vhzipi-w3m-0.5.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"aqy3zw01js2kzabz1d5r4bipsmh6hn1m-getopt-1.1.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"cx0z006vpj4hsz406759jddy3cvajj9w-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f4vwm3pxcqby7swhdfym8aq1m0v97nbm-libxslt-1.1.45.drv":{"dynamicOutputs":{},"outputs":["bin","dev"]},"gjx4km9wwkszq8gwcfy7kb3kb0wral4c-docbook-xsl-nons-1.79.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"hrixc7nxr28rcaiclrjy6sq3gqrby96w-autoreconf-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"k8abwnwdc1c71krxbrbvvf4mmviyd347-bash-interactive-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"lqgkapnazhw0fzfzvgkjwbpzb1k90hx1-xmlto.drv":{"dynamicOutputs":{},"outputs":["out"]},"md8flm2nb4cw728nf0kr6lfx2fmvvr22-gnused-4.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"mnm3hgp907qn3jxmhl2ns9zwf01l5j3h-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"qs15dhkbl5yyz1ig7sn6l59xrbxnafpq-gnugrep-3.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"w7rbfvi9gb3wms2hzmlxkx1wdizbfz6d-libxml2-2.15.3.drv":{"dynamicOutputs":{},"outputs":["bin","dev"]},"y4d5i73q4anxfgs5br841f6z36a1vmdq-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"ycllkcwvqhbhbnkhjny8hxqcwxk9hs8z-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"xmlto-0.0.29","outputs":{"out":{"path":"yawg224228766ls4rsb9nv7r7iv9a3g5-xmlto-0.0.29"}},"system":"x86_64-linux","version":4},"bnnlrkbp5af99y0msld5vc21pgrhl0yy-crate-rand-0.8.5.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6