"configureFlags":"--localstatedir=/var --with-cuse","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"1","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","man":"/nix/store/3f32qad3p17nf4xjx42n98iyvxyapbqh-swtpm-0.10.1-man","mesonFlags":"","name":"swtpm-0.10.1","nativeBuildInputs":"/nix/store/8w5py73f81yixkqkzq0w3f2w90326fkr-pkg-config-wrapper-0.29.2 /nix/store/72wc294y0hfy3xr2a1n6vf0lscc48x4r-netstat-net-tools-2.10 /nix/store/b510jwvvcwvwv8mh2jwk0gg936a31k1j-expect-5.45.4-dev /nix/store/p2k79yam5dw1mhac4h9ixw4mxkh0gvjw-socat-1.8.1.3 /nix/store/w8mnw9h158ikd0cw5wjs9mhvqihbzbr4-perl-5.42.0 /nix/store/h3l4z7p6wny3phbckwwhy1i2g52pdnj4-python3-3.13.15 /nix/store/jdnb1ri4g690zr2x3dnly7yg88w0phyg-autoreconf-hook /nix/store/bpjwzx5qrfcpfnnl18nj6xxx6mpm5bqm-make-shell-wrapper-hook /nix/store/dw3x07sr1hd5p1s49xd3rfpiah5v8amw-which-2.23","out":"/nix/store/as58fxjf3bg7j4jq248vq5p02jzz8h6r-swtpm-0.10.1","outputs":"out man","patches":"/nix/store/30mk0nsmsxrfajqplgqrwyagpm2g02yz-retry-nwwrite.patch","pname":"swtpm","postFixup":"wrapProgram \"$out/bin/swtpm_localca\" --suffix PATH : \"$out/bin\"\nwrapProgram \"$out/bin/swtpm_setup\" --suffix PATH : \"$out/bin\"\n","postPatch":"patchShebangs tests/*\n\n# Needed for cross-compilation\nsubstituteInPlace configure.ac --replace-fail 'pkg-config' 'pkg-config'\n\n# Makefile tries to create the directory /var/lib/swtpm-localca, which fails\nsubstituteInPlace samples/Makefile.am \\\n    --replace 'install-data-local:' 'do-not-execute:'\n\n# Use the correct path to the certtool binary\n# instead of relying on it being in the environment\nsubstituteInPlace src/swtpm_localca/swtpm_localca.c \\\n  --replace \\\n    '# define CERTTOOL_NAME \"gnutls-certtool\"' \\\n    '# define CERTTOOL_NAME \"/nix/store/zrm2yj4y40rjs580nqsz0y7fv6p3kirz-gnutls-3.8.13-bin/bin/certtool\"' \\\n  --replace \\\n    '# define CERTTOOL_NAME \"certtool\"' \\\n    '# define CERTTOOL_NAME \"/nix/store/zrm2yj4y40rjs580nqsz0y7fv6p3kirz-gnutls-3.8.13-bin/bin/certtool\"'\n\nsubstituteInPlace tests/common --replace \\\n    'CERTTOOL=gnutls-certtool;;' \\\n    'CERTTOOL=certtool;;'\n\n# Fix error on macOS:\n# stat: invalid option -- '%'\n# This is caused by the stat program not being the BSD version,\n# as is expected by the test\nsubstituteInPlace tests/common tests/sed-inplace --replace \\\n    'if [[ \"$(uname -s)\" =~ (Linux|CYGWIN_NT-) ]]; then' \\\n    'if [[ \"$(uname -s)\" =~ (Linux|Darwin|CYGWIN_NT-) ]]; then'\n\n# Otherwise certtool seems to pick up the system language on macOS,\n# which might cause a test to fail\nsubstituteInPlace tests/test_swtpm_setup_create_cert --replace \\\n    '$CERTTOOL' \\\n    'LC_ALL=C.UTF-8 $CERTTOOL'\n\nsubstituteInPlace tests/test_tpm2_swtpm_cert --replace \\\n    'certtool' \\\n    'LC_ALL=C.UTF-8 certtool'\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/wvff7n0icv2p3x8diafh0chkqdkha4wx-source","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.10.1"},"inputs":{"drvs":{"1j5kaciji4birpsx1a7532qmgil0ngbp-socat-1.8.1.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"2w93yc3jb47j03r8c68bv3pwhhb4m3bs-fuse-2.9.9.drv":{"dynamicOutputs":{},"outputs":["dev"]},"3g8pq2ic3hl6k5qyqzg7nb0x27pwy3fw-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"3la1r40irvl1xg9wfhjr0kc02vldplrs-libtasn1-4.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"3sljck1n1q7mbhmk8cgdasf9nb46qdi3-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"4z4g7k4x89bfynv2dg452cypb7grfn78-which-2.23.drv":{"dynamicOutputs":{},"outputs":["out"]},"9yb1vlvy008cjhbslzbrvbapvsdwjiyq-json-glib-1.10.8.drv":{"dynamicOutputs":{},"outputs":["dev"]},"cx0z006vpj4hsz406759jddy3cvajj9w-stdenv-linux.dr