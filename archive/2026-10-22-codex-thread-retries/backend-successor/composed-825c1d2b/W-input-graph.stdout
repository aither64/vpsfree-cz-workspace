Zlib\nmkdir -p cpan/Compress-Raw-Zlib\n\ntar --strip-components=1 -C cpan/Compress-Raw-Zlib -xf /nix/store/5bwwd3c0a0wyrsalx048sjrxkj9jc334-Compress-Raw-Zlib-2.222.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Compress-Raw-Zlib -type f -exec chmod a-x {} +\n\nrm -rf cpan/Compress-Raw-Bzip2\nmkdir -p cpan/Compress-Raw-Bzip2\n\ntar --strip-components=1 -C cpan/Compress-Raw-Bzip2 -xf /nix/store/7zngpz79lxvj9rgbmzvs7lizr64qj8di-Compress-Raw-Bzip2-2.218.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Compress-Raw-Bzip2 -type f -exec chmod a-x {} +\n\nrm -rf cpan/IO-Compress\nmkdir -p cpan/IO-Compress\n\ntar --strip-components=1 -C cpan/IO-Compress -xf /nix/store/5q7xqjml453ckx9sk2plzbjxf6bkrqg9-IO-Compress-2.220.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/IO-Compress -type f -exec chmod a-x {} +\n\nrm -rf cpan/Archive-Tar\nmkdir -p cpan/Archive-Tar\n\ntar --strip-components=1 -C cpan/Archive-Tar -xf /nix/store/53yp48jf1rnbf978f1dql94j9128zi1l-Archive-Tar-3.12.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Archive-Tar -type f -exec chmod a-x {} +\n# Perl's build system uses the src variable, and its value may end up in\n# the output in some cases (when cross-compiling).\nunset src\n","preConfigure":"cat > config.over <<EOF\nosvers=\"gnulinux\"\nmyuname=\"nixpkgs\"\nmyhostname=\"nixpkgs\"\ncf_by=\"nixpkgs\"\ncf_time=\"$(date -d \"@$SOURCE_DATE_EPOCH\")\"\nEOF\n\n# Compress::Raw::Zlib should use our zlib package instead of the one\n# included with the distribution\ncat > ./cpan/Compress-Raw-Zlib/config.in <<EOF\nBUILD_ZLIB   = False\nINCLUDE      = /nix/store/dm105zcla9j2lj0mjjzz2in3v0a3wal3-zlib-1.3.2-dev/include\nLIB          = /nix/store/a75c31a1m4s2j1wqpnlakjglzq2hnryz-zlib-1.3.2/lib\nOLD_ZLIB     = False\nGZIP_OS_CODE = AUTO_DETECT\nUSE_ZLIB_NG  = False\nZLIB_INCLUDE = /nix/store/dm105zcla9j2lj0mjjzz2in3v0a3wal3-zlib-1.3.2-dev/i