\nName: blas\nVersion: 3\nDescription: BLAS FORTRAN implementation\nLibs: -L$out/lib -lblas\nCflags: -I$dev/include\nEOF\n\n  libcblas=\"/nix/store/lplqipmzdw8gk1pddf6mjcki4vl3082w-openblas-0.3.33/lib/libcblas.so.3\"\n\n  if ! [ -e \"$libcblas\" ]; then\n    echo \"$libcblas does not exist, openblas-0.3.33 does not provide libcblas.\"\n    exit 1\n  fi\n\n  cp -L \"$libcblas\" $out/lib/libcblas.so.3\n  chmod +w $out/lib/libcblas.so.3\n\npatchelf --set-soname libcblas.so.3 $out/lib/libcblas.so.3\npatchelf --set-rpath \"$(patchelf --print-rpath $out/lib/libcblas.so.3):/nix/store/lplqipmzdw8gk1pddf6mjcki4vl3082w-openblas-0.3.33/lib\" $out/lib/libcblas.so.3\n  if [ \"$out/lib/libcblas.so.3\" != \"$out/lib/libcblas.so\" ]; then\n    ln -s $out/lib/libcblas.so.3 \"$out/lib/libcblas.so\"\n  fi\n\n  cp /nix/store/ziykq2jr0a6idf5y45hswc5wqr534pfv-liblapack-3.12.1/include/cblas{,_mangling}.h $dev/include\n\n  cat <<EOF > $dev/lib/pkgconfig/cblas.pc\nName: cblas\nVersion: 3\nDescription: BLAS C implementation\nCflags: -I$dev/include\nLibs: -L$out/lib -lcblas\nEOF\n","mesonFlags":"","name":"blas-3","nativeBuildInputs":"","out":"/nix/store/6s2xiaikiw38akrq32nnaiqq27wbfy4q-blas-3","outputs":"out dev","patches":"","pname":"blas","propagatedBuildInputs":"","propagatedNativeBuildInputs":"/nix/store/hg40cf61p13ki8f6qkn371qxzg1n7h1l-check-phase-thread-limit-hook","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":"","system":"x86_64-linux","unpackPhase":"src=$PWD","version":"3"},"inputs":{"drvs":{"6rcv0w4hpvmzrhz6yakg1gyj91k0n506-liblapack-3.12.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"7z4m6rq2hnsx0winw166bp4dynn6gddz-openblas-0.3.33.drv":{"dynamicOutputs":{},"outputs":["out"]},"cx0z006vpj4hsz406759jddy3cvajj9w-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"gzf5ign62dinii0770a963fq1l2cxv46-check-phase-thread-limit-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"ycllkcwvqhbhbnkhjny8hxqcwxk9hs8z-bash-5.3p9.drv":{"dynamicOutputs":{},"out