ool dllwrap windmc windres; do\n  if [ -e $ldPath/${binary} ]; then\n    ln -s $ldPath/${binary} $out/bin/${binary}\n  fi\ndone\n\nif [ -e ${ld:-$ldPath/ld} ]; then\n  wrap ld /nix/store/paaqz9ad8p8ravgs8hw3kzypqc3fwqws-ld-wrapper.sh ${ld:-$ldPath/ld}\nfi\n\nfor variant in $ldPath/ld.*; do\n  basename=$(basename \"$variant\")\n  wrap $basename /nix/store/paaqz9ad8p8ravgs8hw3kzypqc3fwqws-ld-wrapper.sh $variant\ndone\n","libc_bin":"/nix/store/389a70m1z11xiz1b5b4gawz1z7w085rh-glibc-2.42-84-bin","libc_dev":"/nix/store/rlrznkmvs6jyp5kgq5jv2wqam83jv1r7-glibc-2.42-84-dev","libc_lib":"/nix/store/rkiwrqh8g6gs5rws4bf1s3mrdcs15gm9-glibc-2.42-84","mesonFlags":"","mktemp":"/nix/store/9s1f2d6d99gq1f142pi6xam51h0q1z4b-coreutils-static-9.10/bin/mktemp","name":"binutils-patchelfed-ld-wrapper-2.46","nativeBuildInputs":"","out":"/nix/store/gj1mkvac4fpg01vr4a7srjq5cz7c9ry1-binutils-patchelfed-ld-wrapper-2.46","outputs":"out","patches":"","pname":"binutils-patchelfed-ld-wrapper","postFixup":"touch \"$out/nix-support/libc-ldflags\"\necho \"-L/nix/store/rkiwrqh8g6gs5rws4bf1s3mrdcs15gm9-glibc-2.42-84/lib\" >> $out/nix-support/libc-ldflags\n\necho \"/nix/store/rkiwrqh8g6gs5rws4bf1s3mrdcs15gm9-glibc-2.42-84\" > $out/nix-support/orig-libc\necho \"/nix/store/rlrznkmvs6jyp5kgq5jv2wqam83jv1r7-glibc-2.42-84-dev\" > $out/nix-support/orig-libc-dev\nif [[ -z ${dynamicLinker+x} ]]; then\n  echo \"Don't know the name of the dynamic linker for platform 'x86_64-unknown-linux-gnu', so guessing instead.\" >&2\n  local dynamicLinker=\"/nix/store/rkiwrqh8g6gs5rws4bf1s3mrdcs15gm9-glibc-2.42-84/lib/ld*.so.?\"\nfi\ndynamicLinker=($dynamicLinker)\n\ncase ${#dynamicLinker[@]} in\n  0) echo \"No dynamic linker found for platform 'x86_64-unknown-linux-gnu'.\" >&2;;\n  1) echo \"Using dynamic linker: '$dynamicLinker'\" >&2;;\n  *) echo \"Multiple dynamic linkers found for platform 'x86_64-unknown-linux-gnu'.\" >&2;;\nesac\n\nif [ -n \"${dynamicLinker-}\" ]; then\n  echo $dynamicLinker > $out/nix-support/dynamic-lin