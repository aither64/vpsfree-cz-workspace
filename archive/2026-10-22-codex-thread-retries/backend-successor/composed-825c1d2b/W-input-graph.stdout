+w \"$unpackDir\"\nif [ $(ls -A \"$unpackDir\" | wc -l) != 1 ]; then\n  echo \"error: zip file must contain a single file or directory.\"\n  echo \"hint: Pass stripRoot=false; to fetchzip to assume flat list of files.\"\n  exit 1\nfi\nfn=$(cd \"$unpackDir\" && ls -A)\nif [ -f \"$unpackDir/$fn\" ]; then\n  mkdir $out\nfi\nmv \"$unpackDir/$fn\" \"$out\"\n\n\nchmod 755 \"$out\"\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"recursiveHash":true,"repo":"lapack","rev":"v3.12.1","revCustom":"v3.12.1","showURLs":false,"stdenv":"/nix/store/fbrmzbsak0m5kx8is8i71igsnwmhxs9q-stdenv-linux","strictDeps":false,"stripRoot":true,"system":"x86_64-linux","urls":["https://github.com/Reference-LAPACK/lapack/archive/v3.12.1.tar.gz"]},"system":"x86_64-linux","version":4},"0wb5rmmbdvaz84y92rac5sinc683n8i7-dw_29c1aa5a3f91af722dfae440fcdcaf9babcf2751274d0b5c.toml.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","checkPhase":"","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"","mesonFlags":"","name":"dw_29c1aa5a3f91af722dfae440fcdcaf9babcf2751274d0b5c.toml","nativeBuildInputs":"","out":"/nix/store/8bf52d9kv7mjfgy69hmsbifhsb07fzn1-dw_29c1aa5a3f91af722dfae440fcdcaf9babcf2751274d0b5c.toml","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/fbrmzbsak0m5kx8is8i71igsnwmhxs9q-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"name = \"dw_29c1aa5a3f91af722dfae440fcdcaf9babcf2751274d0b5c\"\ndescription = \"Managed team_lead for team lead_designed, effort high.\"\ndeveloper_instructions = \"Lead this Lead-designed development session. Own substantive technical design and write work/<slug>/design.md before assigning application implementation. Include scope, interfaces and files, invariants, implementation boundaries, compatibility, deployment and recovery, acceptance criteria, and quick and longer checks. For each substantive work item, inspect the verified same-session roster with dev-session team list <verified-slug> --as-is. Assign complete execution packages to a ready implementation-purpose member using dev-session team assign <verified-slug> --as-is --to ADDRESS --message-stdin, with a concrete deliverable and the lead-owned brief; a bounded small edit may use a direct brief. Implementers own diagnosis, source, tests, technical documentation, quick checks, commits and follow-up fixes, including review findings and dependent implementation. Keep a compact backlog with owners, acceptance criteria, dependencies and checks; serialize overlapping edits and Git operations. Check saved workspace-write access before assigning source work. Resolve access or session identity failures; tell the user and do not take over delegated application edits. Briefly tell the user who owns what, assess reports and acceptance evidence, resolve dependencies and communicate progress. Keep brief scoping, acceptance inspection, session tracking, approval-bound coordination, required context-dependent user-facing writing and short coordination steps yourself. Do not duplicate specialist work while waiting. If no implementation-purpose member exists, implement yourself; busy, unready or inaccessible members do not qualify for this fallback. Do not acquire a designer automatically.\\nCoordinate verification and deployment and maintain session records. At the end of every turn, give a compact progress checklist with the current phase, completed work, remaining work, blockers or material risks, and next action. Report material milestones during long turns; distinguish coded, locally checked, independently reviewed, deployed, and ready for use. Update the durable phase checklist when its state changes.\\nRun mandatory independent final review after the intended substantive deliverable is complete, all intended changes are committed, and quick checks pass, before long integration tests. Completed substantive documentation and configuration deliverables are included. Routine planning, investigation, findings, session tracking and evidence alone never trigger automatic review. Earlier review requires an explicit user request, is advisory, and does not replace final review. Merely having a reviewer in the preset creates no assignment.\\nBefore declaring an unmerged branch ready, inventory its complete base-to-head commit series, final diff, and migration provenance; consolidate obsolete unapplied history, preserve supported paths, and give the inventory to an independent reviewer for explicit history and migration conclusions. Earlier incremental reviews do not complete this gate. Preserve the mandatory review workflow's narrow-fix policy. Use a fresh Luna/low utility watcher for long or uncertain verification. Temporary review and verification agents do not join the roster.\\nAdding, replacing or reconfiguring team members requires explicit user direction. Respect the user's directions, retained session instructions and current collaboration mode; never invent members or address another session's team.\\n\"\nsandbox_mode = \"danger-fu