single \\\n  --disable-libstdcxx-pch \\\n  --disable-build-with-cxx\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"gcc-4.6.4","out":"/nix/store/51kwhs29cpdaych25b1631a227c0vp3v-gcc-4.6.4","passAsFile":"buildCommand","pname":"gcc","system":"x86_64-linux","version":"4.6.4"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"37zapxlhmx12r050xsjw39n4vw3nck3a-mpc-1.0.3.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6v8bjfwdcw75b9hv7gzl0jyfljdlc3vw-binutils-2.47.drv":{"dynamicOutputs":{},"outputs":["out"]},"8xy9yi1vwp0mc32lz37jgva7hck5j9by-gawk-5.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"a9zsjk7jcksa22bv35f7rhnbkhd71d66-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"aw4a7hi7q0mb2ljazxq0in9f5v4905a5-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"bjfpxb6q4p4dxn2r8h5p337hn1vf444n-findutils-4.11.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"cxpi1vdfflr3zh9xhgsqz44vqjk0jfk8-mpfr-2.4.2.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"ia4sjsi3cl16751r14yfv92603830nnn-gmp-4.3.2.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"l3c18sdal1zr6930p31awpmz1ncs68wy-gcc-core-4.6.4.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"pip5q1b15n46rw6cbmz3jjk8mngqp7aw-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"qcz565439vz47snj3vky7rbdd4ihvxzl-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"rk3s60afwm2lzcsjpsbpdyaa90c21q4z-gnutar-musl-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"wcy0xsar1c27zdiz6mb6nwgiygar2k6h-bash-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"x2k1rx0682qi8q01svmay16q1c4glss2-bootstrap-coreutils-musl-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"xqxb9q4f0izf8s15d3wqlg06vajd2i8y-tinycc-musl-unstable-2025-12-03-compiler.drv":{"dynamicOutputs":{},"outputs":["out"]},"yp4zsyn8fp1