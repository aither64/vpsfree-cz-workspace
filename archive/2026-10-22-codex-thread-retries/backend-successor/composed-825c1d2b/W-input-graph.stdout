agated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"NIX_LDFLAGS":"-lgcc_s","NIX_MAIN_PROGRAM":"git"},"installCheckFlags":["DEFAULT_TEST_TARGET=prove","PERL_PATH=/nix/store/w8mnw9h158ikd0cw5wjs9mhvqihbzbr4-perl-5.42.0/bin/perl"],"installCheckTarget":"test","installFlags":["NO_INSTALL_HARDLINKS=1"],"makeFlags":["prefix=${out}","ZLIB_NG=1","SHELL_PATH=/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","NO_PERL=1","NO_PYTHON=1","sysconfdir=/etc"],"mesonFlags":[],"name":"git-minimal-2.54.0","nativeBuildInputs":["/nix/store/66y9sclrx3vbfcmxfa0v47ff3wwjpalv-uname","/nix/store/3jdbra59k1zvb2ml8wc0xiwy2f10x8m4-gettext-1.0","/nix/store/w8mnw9h158ikd0cw5wjs9mhvqihbzbr4-perl-5.42.0","/nix/store/bpjwzx5qrfcpfnnl18nj6xxx6mpm5bqm-make-shell-wrapper-hook","/nix/store/8w5py73f81yixkqkzq0w3f2w90326fkr-pkg-config-wrapper-0.29.2","/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh"],"outputChecks":{"debug":{},"out":{"disallowedReferences":[]}},"outputs":["out","debug"],"patches":["/nix/store/j6vpikcvv4ry0pwalvpz1m65k2wckavl-docbook2texi.patch","/nix/store/xprdd33cnqprwk19lxi57h907fz7xic2-git-sh-i18n.patch","/nix/store/85ax0pclk9prgkp8d7m6n6q1g7v5m58j-git-send-email-honor-PATH.patch","/nix/store/k7c6k6zwjh9fgzm9fazn9l1qm6wnv0cy-t7703-ignore-ls-total.patch","/nix/store/fzzc79ndlidjp84dx1mxr4ir8sgi3msm-expect-gui--askyesno-failure-in-t1517.patch","/nix/store/xf1lm1n1lj6prcalhi1mnglfwndvc81l-darwin-unicode-filename-fix.patch"],"pname":"git-minimal","postBuild":"# Set up the flags array for make in the same way as for the main build\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelBuilding:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray buildFlags buildFlagsArray\nechoCmd 'build flags' \"${flagsArray[@]}\"\nmake -C contrib/subtree \"${flagsArray[@]}\" all \nunset flagsArray\n","postInstall":"# Set up the flags array for make in the same way as for the main install\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelInstalling:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray installFlags installFlagsArray\nechoCmd 'install flags' \"${flagsArray[@]}\"\n\n# Install git-subtree.\nmake -C contrib/subtree \"${flagsArray[@]}\" install \nrm -rf contrib/subtree\n\n# Install contrib stuff.\nmkdir -p $out/share/git\ncp -a contrib $out/share/git/\nmkdir -p $out/share/bash-completion/completions\nln -s $out/share/git/contrib/completion/git-prompt.sh $out/share/bash-completion/completions/\n\n# grep is a runtime dependency, need to patch so that it's found\nsubstituteInPlace $out/libexec/git-core/git-sh-setup \\\n    --replace ' grep' ' /nix/store/x3mmarawk8qkqf3257aidf7cljax6mc8-gnugrep-3.12/bin/grep' \\\n    --replace ' egrep' ' /nix/store/x3mmarawk8qkqf3257aidf7cljax6mc8-gnugrep-3.12/bin/egrep'\n\n# Fix references to the perl, sed, awk and various coreutil binaries used by\n# shell scripts that git calls (e.g. filter-branch)\nSCRIPT=\"$(cat <<'EOS'\n  BEGIN{\n    @a=(\n      '/nix/store/x3mmarawk8qkqf3257aidf7cljax6mc8-gnugrep-3.12/bin/grep', '/nix/store/cwr0fxlfy7jzfxwz2wyhd30a3bzw7vx1-gnused-4.10/bin/sed', '/nix/store/l048yqk8sv2lpz14ww39bqc3vzcmlz6m-gawk-5.4.1/bin/awk',\n      '/nix/store/61685rbaxmpigwi3z23i33sv3jyfl70q-coreutils-9.11/bin/cut', '/nix/store/61685rbaxmpigwi3z23i33sv3jyfl70q-coreutils-9.11/bin/basename', '/nix/store/61685rbaxmpigwi3z23i33sv3jyfl70q-coreutils-9.11/bin/dirname',\n      '/nix/store/61685rbaxmpigwi3z23i33sv3jyfl70q-coreutils-9.11/bin/wc', '/nix/store/61685rbaxmpigwi3z23i33sv3jyfl70q-coreutils-9.11/bin/tr'\n      \n    );\n  }\n  foreach $c (@a) {\n    $n=(split(\"/\", $c))[-1];\n    s|(?<=[^#][^/.-])\\b${n}(?=\\s)|${c}|g\n  }\nEOS\n)\"\nperl -0777 -i -pe \"$SCRIPT\" \\\n  $out/libexec/git-core/git-{sh-setup,filter-branch,merge-octopus,mergetool,quiltimport,request-pull,submodule,subtree,web--browse}\n\n\n# Also put git-http-backend into $PATH, so that we can use smart\n# HTTP(s) transports for pushing\nln -s $out/libexec/git-core/git-http-backend $out/bin/git-http-backend\nln -s $out/share/git/contrib/git-jump/git-jump $out/bin/git-jump\nrm $out/libexec/git-core/git-svn\nrm $out/libexec/git-core/git-send-email\nfor prog in bin/gitk libexec/git-core/git-gui; do\n  rm \"$out/$prog\"\ndone\nunset flagsArray\n","postPatch":"# Fix references to gettext introduced by ./git-sh-i18n.patch\nsubstituteInPlace git-sh-i18n.sh \\\n    --subst-var-by gettext /nix/store/3jdbra59k1zvb2ml8wc0xiwy2f10x8m4-gettext-1.0\nsubstituteInPlace contrib/credential/libsecret/Makefile \\\n    --replace-fail 'pkg-config' \"$PKG_CONFIG\"\n# ensure we are using the correct shell when executing the test scripts\npatchShebangs t/*.sh\n","preBuild":"makeFlagsArray+=( perllibdir=$out/$(perl -MConfig -wle 'print substr $Config{installsitelib}, 1 + length $Config{siteprefixexp}') )\n","preInstall":"","preInstallCheck":"# Some tests break with high concurrency\n# https://github.com/NixOS/nixpkgs/pull/403237\nif ((NIX_BUILD_CORES > 32)); then\n  NIX_BUILD_CORES=32\nfi\n\ninstallCheckFlagsArray+=(\n  GIT_PROVE_OPTS=\"--jobs $NIX_BUILD_CORES --failures --state=failed,save\"\n  GIT_TEST_INSTALLED=$out/bin\n  NO_SVN_TESTS=y\n)\n\nfunction disable_test {\n  local test=$1 pattern=$2\n  if [ $# -eq 1 ]; then\n    mv t/{,skip-}$test.sh || true\n  else\n    sed -i t/$test.sh \\\n      -e \"/^\\s*test_expect_.*$pattern/,/^\\s*' *\\$/{s/^/: #/}\"\n  fi\n}\n\n# Shared permissions are forbidden in sandbox builds:\nsubstituteInPlace t/test-lib.sh \\\n  --replace \"test_set_prereq POSIXPERM\" \"\"\n# TODO: Investigate while these still fail (without POSIXPERM):\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'shared overrides system'\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'init honors global core.sharedRepository'\n# Tested to fail: 2.46.0\ndisable_test t1301-shared-repo\n# /build/git-2.44.0/contrib/completion/git-completion.bash: line 452: compgen: command not found\ndisable_test t9902-completion\n# Disable sendmail tests\ndisable_test t9001-send-email\n# Flaky tests:\ndisable_test t0027-auto-crlf\ndisable_test t1451-fsck-buffer\ndisable_test t5319-multi-pack-index\ndisable_test t6421-merge-partial-clone\ndisable_test t7504-commit-msg-hook\ndisable_test t5515-fetch-merge-logic\ndisable_test t4104-apply-boundary\ndisable_test t7002-mv-sparse-checkout\ndisable_test t4122-apply-symlink-inside\ndisable_test t7513-interpret-trailers\ndisable_test t2200-add-update\n\n# Fails reproducibly on ZFS on Linux with formD normalization\ndisable_test t0021-conversion\ndisable_test t3910-mac-os-precompose\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"src":"/nix/store/drcyzlalnx264vlmp2js5vp2kkvyn132-git-2.54.0.tar.xz","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":false,"stripDebugList":["lib","libexec","bin","share/git/contrib/credential"],"system":"x86_64-linux","version":"2.54.0"},"system":"x86_64-linux","version":4},"2fp6w5x73xid21s244h4sz5z6yjfsac4-glibc-2.42-84.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/pzpmwj3agpmlkjfq0g62r2zxa7qysdya-bash-static-5.3/bin/bash","env":{"BASH_SHELL":"/bin/sh","NIX_CFLAGS_COMPILE":"","NIX_HARDENING_ENABLE":"bindnow format libcxxhardeningfast pic relro stackclashprotection strictflexarrays1 strictoverflow zerocallusedregs","NIX_NO_SELF_RPATH":"1","__structuredAttrs":"","bin":"/nix/store/389a70m1z11xiz1b5b4gawz1z7w085rh-glibc-2.42-84-bin","buildInputs":"/nix/store/dmpn2sl84sqf9fskr16qwp4pbs5nm729-linux-headers-6.18.7","builder":"/nix/store/pzpmwj3agpmlkjfq0g62r2zxa7qysdya-bash-static-5.3/bin/bash","cmakeFlags":"","configureFlags":"-C --enable-add-ons --sysconfdir=/etc --enable-stack-protector=strong --enable-bind-now --with-headers=/nix/store/dmpn2sl84sqf9fskr16qwp4pbs5nm729-linux-headers-6.18.7/include --disable-profile --enable-fortify-source --enable-static-pie --enable-cet=permissive --enable-kernel=3.10.0","debug":"/nix/store/mazsm85wh9nzafhsyy138wkn4qw0c79y-glibc-2.42-84-debug","depsBuildBuild":"/nix/store/23jss44lyy72rjhxfi6kchczwvl0k9vp-bootstrap-stage2-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/rlrznkmvs6jyp5kgq5jv2wqam83jv1r7-glibc-2.42-84-dev","doCheck":"","doInstallCheck":"","enableCETRuntimeDefault":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","getent":"/nix/store/mzcxsv4qgymhbff4qxy1d02mln8g9553-glibc-2.42-84-getent","hardeningDisable":"fortify stackprotector strictflexarrays3","installFlags":"sysconfdir=$(out)/etc","is64bit":"1","linuxHeaders":"/nix/store/dmpn2sl84sqf9fskr16qwp4pbs5nm729-linux-headers-6.18.7","makeFlags":"OBJCOPY=objcopy BUILD_LDFLAGS=-Wl,-rpath,/nix/store/v54l9gm2kpiqd5wl6lg9cxzsf4lcdzqc-bootstrap-stage0-glibc-minimal-bootstrap/lib OBJDUMP=/nix/store/5q6dfjh1ilasmd712gbj0gfsfcsf6yw8-binutils-2.46/bin/objdump user-defined-trusted-dirs=/nix/store/rdw0n35z6xhipyiq6sc8qv0mg7vrldaj-xgcc-15.2.0-libgcc/lib","mesonFlags":"","name":"glibc-2.42-84","nativeBuildInputs":"/nix/store/znr5k5q69yivzf293wx2ylzr50advi0v-bison-3.8.2 /nix/store/k7p6bz6kzj6advgsjfkpccwh41if2zyz-gettext-1.0 /nix/store/pmdb1bhqyx7jh7ir5989m4val2icbqr5-python3-minimal-3.13.15 /nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/rkiwrqh8g6gs5rws4bf1s3mrdcs15gm9-glibc-2.42-84","outputs":"out bin dev static getent debug","patches":"/nix/store/f3xrdrys50y52ij1vg5lk6qdqpvqmf9r-2.42-master.patch /nix/store/nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch /nix/store/b1w7zbvm39ff1i52iyjggyvw2rdxz104-dont-use-system-ld-so-cache.patch /nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch /nix/store/llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch /nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch /nix/store/001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch /nix/store/0mb1pqwqkz9sk1fwgn897zlwzhhgfpbf-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch /nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch /nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch /nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch","pname":"glibc","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n\n# Apparently --bindir is not respected.\nmakeFlagsArray+=(\"bindir=$bin/bin\" \"sbindir=$bin/sbin\" \"rootsbindir=$bin/sbin\")\n","postInstall":"moveToOutput bin/getent $getent\necho SUPPORTED-LOCALES=C.UTF-8/UTF-8 > ../localedata/SUPPORTED\n# Don't install C.utf-8 into the archive, but into $out/lib/locale: on non-NixOS\n# systems with an empty /usr/lib/locale/locale-archive, glibc would fall back to\n# $libdir/locale/C.utf-8 instead of the locale archive of pkgs.glibc. See also #347965.\nmake -j${NIX_BUILD_CORES:-1} localedata/install-locale-files\n\ntest -f $out/etc/ld.so.cache && rm $out/etc/ld.so.cache\n\nif test -n \"$linuxHeaders\"; then\n    # Include the Linux kernel headers in Glibc, except the `scsi'\n    # subdirectory, which Glibc provides itself.\n    (cd $dev/include && \\\n     ln -sv $(ls -d $linuxHeaders/include/* | grep -v scsi\\$) .)\nfi\n\n# Fix for NIXOS-54 (ldd not working on x86_64).  Make a symlink\n# \"lib64\" to \"lib\".\nif test -n \"$is64bit\"; then\n    ln -s lib $out/lib64\nfi\n\n# Get rid of more unnecessary stuff.\nrm -rf $out/var $bin/bin/sln\n\n# Backwards-compatibility to fix e.g.\n# \"configure: error: Pthreads are required to build libgomp\" during `gcc`-build\n# because it's not actually needed anymore to link against `pthreads` since\n# it's now part of `libc.so.6` itself, but the gcc build breaks if\n# this doesn't work.\nln -sf $out/lib/libpthread.so.0 $out/lib/libpthread.so\nln -sf $out/lib/librt.so.1 $out/lib/librt.so\nln -sf $out/lib/libdl.so.2 $out/lib/libdl.so\ntest -f $out/lib/libutil.so.1 && ln -sf $out/lib/libutil.so.1 $out/lib/libutil.so\ntouch $out/lib/libpthread.a\n\n# Put libraries for static linking in a separate output.  Note\n# that libc_nonshared.a and libpthread_nonshared.a are required\n# for dynamically-linked applications.\nmkdir -p $static/lib\nmv $out/lib/*.a $static/lib\nmv $static/lib/lib*_nonshared.a $out/lib\n# If libutil.so.1 is missing, libutil.a is required.\ntest -f $out/lib/libutil.so.1 || mv $static/lib/libutil.a $out/lib\n# Some of *.a files are linker scripts where moving broke the paths.\nsed \"/^GROUP/s|$out/lib/lib|$static/lib/lib|g\" \\\n  -i \"$static\"/lib/*.a\n\n# Work around a Nix bug: hard links across outputs cause a build failure.\ncp $bin/bin/getconf $bin/bin/getconf_\nmv $bin/bin/getconf_ $bin/bin/getconf\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/xidgjdv05b8yz6w6qrhk4mmjxm4l2zjf-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","profilingLibraries":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","src":"/nix/store/6zxixmszg0vbhpaa8rxwfr05by9axj68-glibc-2.42.tar.xz","static":"/nix/store/fyiygrgirwjqbmbh9ikqgkdpqgqxi1i4-glibc-2.42-84-static","stdenv":"/nix/store/7l617p0v6z109bw304ibj67d84xwm4j4-bootstrap-stage2-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.42-84"},"inputs":{"drvs":{"2pap6r9k2921ggv0y0ayj89hkar8zcnx-binutils-2.46.drv":{"dynamicOutputs":{},"outputs":["out"]},"8injyx1z38allpqjwycg8c7dm9r93mzk-libidn2-2.3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"agqqbyl2c91lsx0iscdqiagcpg6d3q3r-bootstrap-stage2-gcc-wrapper-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"d2p9gf46iy9lv5hcafmq9c7d6mpaq0qs-python3-minimal-3.13.15.drv":{"dynamicOutputs":{},"outputs":["out"]},"h61a55fglgkavsvnj8sz8n0ini2ihbpn-bootstrap-stage0-glibc-minimal-bootstrap.drv":{"dynamicOutputs":{},"outputs":["out"]},"imyy7rg9gyf2qyhg3jjnmal8grabvra9-glibc-2.42.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"jg90wjpn0h9x0sryld47bpk9gf89zbwl-bootstrap-stage2-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"l7wl2l84vwllhjilvpcn5vw7302cgqb6-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"ngvmv5byddgbm7gcyc96rmnw43cgal9w-xgcc-15.2.0.drv":{"dynamicOutputs":{},"outputs":["libgcc"]},"prpimw6vfm9hx5g77g0qih8swwzr6q85-linux-headers-6.18.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"z1a6zj82v13glfvrfnhjkpic03y4kppc-bash-static-5.3.drv":{