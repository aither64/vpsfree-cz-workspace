code_stop $scripts\n","postPatch":"# Renaming keymaps with name clashes, because loadkeys just picks\n# the first keymap it sees. The clashing names lead to e.g.\n# \"loadkeys no\" defaulting to a norwegian dvorak map instead of\n# the much more common qwerty one.\npushd data/keymaps/i386\nmv qwertz/cz{,-qwertz}.map\nmv olpc/es{,-olpc}.map\nmv olpc/pt{,-olpc}.map\nmv fgGIod/trf{,-fgGIod}.map\nmv colemak/{en-latin9,colemak}.map\npopd\n","preConfigure":"# Perl and Bash only used during build time\npatchShebangs --build contrib/\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"src":"/nix/store/592smawrsjbsg0hl1vfqjyfz2nydgp9v-kbd","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"2.9.0"},"system":"x86_64-linux","version":4},"1jq3v52d2ssq9qqs5xmbb4wfvx2ny4j7-tcl-8.6.16.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","env":{"man":"/nix/store/3h1dfpkbmlw06fcihka97ccg1nljhk9g-tcl-8.6.16-man","out":"/nix/store/338gwr2718cdha9m9zavkpc9rvkrqd4q-tcl-8.6.16"},"inputs":{"drvs":{"109gn1ryh0xvy67zcxjrbk7vm6h8jjfl-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"95zz6wn5k0gdlirnkcg8d2dsgfs53jkf-autoreconf-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"bg634dbx0kzklyj0hx64dq04gp6vxw78-tzdata-2026d.drv":{"dynamicOutputs":{},"outputs":["out"]},"d2kl5ff96yig6agisf8pz6x87yx13iyb-1685fee268dcf1334b015840d873366a3cd8d237.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"im5ybha9jcbw1nri6qwkld9d0mdyzpi0-tcl8.6.16-src.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"svra7wnq5jbh36a4p1myr1if3ss7qh2g-bash-5.3p15.drv":{"dynamicOutputs":{},"outputs":["dev","out"]}},"srcs":["a7bglfjl9r2p6zp4cnxxr4qpa95w7i3h-8.6-windows-disable-tzdata.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83