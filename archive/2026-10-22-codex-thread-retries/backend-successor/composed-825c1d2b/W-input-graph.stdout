ed file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/fbrmzbsak0m5kx8is8i71igsnwmhxs9q-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://github.com/rockdaboot/libpsl/commit/490bd6f98a2addcade55028ea60c36cce07e21e4.patch"]},"system":"x86_64-linux","version":4},"yfyk44frrhkfjh07xsgiiqvvaahdsk16-tinycc-boot2-chain-unstable-2024-07-07-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"tinycc-boot2-chain-unstable-2024-07-07-builder","out":"/nix/store/jd44lq07fznnpzhvnzmia047qslvr11b-tinycc-boot2-chain-unstable-2024-07-07-builder","passAsFile":"text","system":"x86_64-linux","text":"echo /nix/store/zjhv1wpw0bm8g0pigi2n043za2kwjgg5-tinycc-boot1-chain-unstable-2024-07-07;\n/nix/store/kyqx4ayvvj9xcdi1zk5iapfx06vg040b-tinycc-boot2-unstable-2024-07-07/bin/tcc -version\nmkdir ${out}\n"},"inputs":{"drvs":{"c08j9sk7k3dqfyllv0l5wcp80001rjpm-tinycc-boot2-unstable-2024-07-07.drv":{"dynamicOutputs":{},"outputs":["out"]},"lmj4kyrya73pxb4l75kqvcy9wpw4ilzn-tinycc-boot1-chain-unstable-2024-07-07.drv":{"d