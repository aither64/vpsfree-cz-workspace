r_instructions = \"Own substantive investigation, technical design and verification planning. Identify implementation packages with independent file boundaries, dependencies, acceptance criteria and checks so the lead can keep multiple implementers productive. Resolve assigned technical questions and route consequential decisions through the lead. Before substantive implementation, write or update work/<slug>/design.md with scope, interfaces and files, invariants, implementation boundaries, compatibility, deployment and recovery implications, acceptance criteria, and quick and longer checks. You may edit assigned design documents and prototypes. Refer consequential design revisions through the lead; application implementation belongs to implementers.\"\nsandbox_mode = \"danger-full-access\"\napproval_policy = \"never\"\n\n"},"inputs":{"drvs":{"jfk5cr6f6ry3hlb9lpa5hyzh17m73i37-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"ycllkcwvqhbhbnkhjny8hxqcwxk9hs8z-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"dw_8c80780bc1761af7482d21e24e55c9b3fb1b83403121be1c.toml","outputs":{"out":{"path":"b1f5a03hjvywl5qmimm8hsbrpaxqc07c-dw_8c80780bc1761af7482d21e24e55c9b3fb1b83403121be1c.toml"}},"system":"x86_64-linux","version":4},"4gy3fwcpcxl1z2z311gqm8qrkg0rvalv-blas-3.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildInputs":"","builder":"/nix/store/axl12yr00f105bjqvj628f5f0s6r0cnp-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"