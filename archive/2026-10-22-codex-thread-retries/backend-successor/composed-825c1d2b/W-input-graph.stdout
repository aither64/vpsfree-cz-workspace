djz0y5ayrhxljn-bison-3.8.2 /nix/store/l32ndm1jw8k3ybpzm7gscg225gbanb7y-remove-references-to /nix/store/lhlwfdrvy8mdvj6al3rr7rrpzkw1gxg1-groff-1.24.1 /nix/store/9m6a1ica7ngj52r73l09lx6ajpzxsrbm-cargo-setup-hook.sh /nix/store/js1dvxbwhjjq2470qg998s6cakhky97p-rustc-wrapper-1.95.0","out":"/nix/store/5shv7ihqxa98r1psfz995q3j2cwk22sa-ruby-3.4.9","outputs":"out devdoc","patches":"/nix/store/c6d5gm3zc63zg49kanxf8w6cxfv69ibk-dont-refer-to-build-dir.patch","pname":"ruby","postInstall":"rbConfig=$(find $out/lib/ruby -name rbconfig.rb)\n# Remove references to the build environment from the closure\nsed -i '/^  CONFIG\\[\"\\(BASERUBY\\|SHELL\\|GREP\\|EGREP\\|MKDIR_P\\|MAKEDIRS\\|INSTALL\\)\"\\]/d' $rbConfig\n# Remove unnecessary groff reference from runtime closure, since it's big\nsed -i '/NROFF/d' $rbConfig\n\n\n# Allow to override compiler. This is important for cross compiling as\n# we need to set a compiler that is different from the build one.\nsed -i \"$rbConfig\" \\\n  -e 's/CONFIG\\[\"CC\"\\] = \"\\(.*\\)\"/CONFIG[\"CC\"] = if ENV[\"CC\"].nil? || ENV[\"CC\"].empty? then \"\\1\" else ENV[\"CC\"] end/' \\\n  -e 's/CONFIG\\[\"CXX\"\\] = \"\\(.*\\)\"/CONFIG[\"CXX\"] = if ENV[\"CXX\"].nil? || ENV[\"CXX\"].empty? then \"\\1\" else ENV[\"CXX\"] end/'\n\n# Remove unnecessary external intermediate files created by gems\nextMakefiles=$(find $out/lib/ruby/gems/3.4.0 -name Makefile)\nfor makefile in $extMakefiles; do\n  make -C \"$(dirname \"$makefile\")\" distclean\ndone\nfind \"$out/lib/ruby/gems/3.4.0\" \\( -name gem_make.out -o -name mkmf.log -o -name exts.mk \\) -delete\n# Bundler tries to create this directory\nmkdir -p $out/nix-support\ncat > $out/nix-support/setup-hook <<EOF\naddGemPath() {\n  addToSearchPath GEM_PATH \\$1/lib/ruby/gems/3.4.0\n}\naddRubyLibPath() {\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0/x86_64-linux\n}\n\naddEnvHooks \"$hostOffset\" addGemPath\naddEnvHooks \"$hostOffset\" addRubyLibPath\nEOF\n# Prevent the docs from being included in the closure\nsed -i \"s|\\$(DESTDIR)$devdoc|\\$(datarootdir)/\\$(RI_BASE_NAME)|\" $rbConfig\nsed -i \"s|'--with-ridir=$devdoc/share/ri'||\" $rbConfig\n\n# Add rbconfig shim so ri can find docs\nmkdir -p $devdoc/lib/ruby/site_ruby\ncp /nix/store/wq7zxvl223s5s97y3dhc3gkyk5d6dw0w-rbconfig.rb $devdoc/lib/ruby/site_ruby/rbconfig.rb\n","postPatch":"sed -i configure.ac -e '/config.guess/d'\ncp --remove-destination /nix/store/n8qzm0k3kl4al3khp5ki5r331vg4ksyj-autoconf-2.73/share/autoconf/build-aux/config.{guess,sub} tool/\n","postUnpack":"rm -rf $sourceRoot/{lib,test}/rubygems*\ncp -r /nix/store/k9va2w2wh3cn5j5p7qf3d4lsphh3k124-rubygems-3.7.2/lib/rubygems* $sourceRoot/lib\n","preConfigure":"# rdoc creates XDG_DATA_DIR (defaulting to $HOME/.local/share) even if\n# it's not going to be used.\nexport HOME=$TMPDIR\n","preInstall":"# Ruby installs gems here itself now.\nmkdir -pv \"$out/lib/ruby/gems/3.4.0\"\nexport GEM_HOME=\"$out/lib/ruby/gems/3.4.0\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/h459yblgc82az0vy3brjh5wc1452f8fw-ruby-3.4.9.tar.gz","stdenv":"/nix/store/99v98l4khhp1yib367g1bxgx8frmp9hs-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"3.4.9"},"inputs":{"drvs":{"3g1q6mvzv0a74qk7rh1gxxjx1bd150vr-rustc-wrapper-1.95.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"4v205kdf9fayw00k4wxx20abw5hbdh6q-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"6mq1vhaydi793231z35ss2y1r8cci5pn-ruby-3.4.9.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"7n7gb6ygk75b0x5ix6n3ysdlc9m32kl2-cargo-deps-vendor.drv":{"dynamicOutputs":{},"outputs":["out"]},"aahrvkxl3ic2jhfay01ggjqwxld9vkxc-libyaml-0.2.5.drv":{"dynamicOutputs":{},"outputs":["dev"]},"amwvxk3xx2vq3a6165i114a0p17rpmzs-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"cx0z006vpj4hsz406759jddy3cvajj9w-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"hri