\":\"Ruff configuration.\\nFor available settings see <https://docs.astral.sh/ruff/settings>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  line-length = 100;\\n  lint = {\\n    ignore = [ ];\\n    select = [\\n      \\\"E4\\\"\\n      \\\"E7\\\"\\n      \\\"E9\\\"\\n      \\\"F\\\"\\n    ];\\n  };\\n  per-file-ignores = {\\n    \\\"__init__.py\\\" = [\\n      \\\"F401\\\"\\n    ];\\n  };\\n}\"},\"loc\":[\"programs\",\"ruff\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.sagemath.configDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sagemath.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sagemath.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${config.xdg.configHome}/sage\"},\"description\":\"Directory where the {file}`sage.init` file will be stored.\\nNote that the upstream default is {file}`~/.sage`,\\nbut our default is to follow XDG.\\n\",\"loc\":[\"programs\",\"sagemath\",\"configDir\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sagemath.dataDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sagemath.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sagemath.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${config.xdg.dataHome}/sage\"},\"description\":\"Location for {env}`DOT_SAGE`.\\nNote that the upstream default is {file}`~/.sage`,\\nbut our default is to follow XDG.\\n\",\"loc\":[\"programs\",\"sagemath\",\"dataDir\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sagemath.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sagemath.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sagemath.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable SageMath, a mathematics software system.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sagemath\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sagemath.initScript\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sagemath.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sagemath.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Contents of the {file}`init.sage` file that is loaded on startup.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"%colors linux\\\"\"},\"loc\":[\"programs\",\"sagemath\",\"initScript\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.sagemath.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sagemath.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sagemath.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sage\"},\"description\":\"The sage package to use. The SageMath package to use.\\n\",\"loc\":[\"programs\",\"sagemath\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.sapling.aliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sapling.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sapling.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Sapling aliases to define.\",\"loc\":[\"programs\",\"sapling\",\"aliases\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.sapling.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sapling.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sapling.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Sapling.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sapling\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sapling.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sapling.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sapling.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Additional configuration to add.\",\"loc\":[\"programs\",\"sapling\",\"extraConfig\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.sapling.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sapling.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sapling.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sapling\"},\"description\":\"The sapling package to use.\",\"loc\":[\"programs\",\"sapling\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.sapling.userEmail\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sapling.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sapling.nix\"}],\"description\":\"Default user email to use.\",\"loc\":[\"programs\",\"sapling\",\"userEmail\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sapling.userName\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sapling.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sapling.nix\"}],\"description\":\"Default user name to use.\",\"loc\":[\"programs\",\"sapling\",\"userName\"],\"readOnly\":false,\"type\":\"string\"},\"programs.satty.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/satty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/satty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Satty - Modern Screenshot Annotation.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"satty\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.satty.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/satty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/satty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.satty\"},\"description\":\"The satty package to use.\",\"loc\":[\"programs\",\"satty\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.satty.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/satty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/satty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for Satty written to {file}`$XDG_CONFIG_HOME/satty/config.toml`.\\n\\nSee the [Satty documentation](https://github.com/gabm/Satty#configuration-file)\\nfor available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  general = {\\n    fullscreen = true;\\n    corner-roundness = 12;\\n    initial-tool = \\\"brush\\\";\\n    output-filename = \\\"/tmp/test-%Y-%m-%d_%H:%M:%S.png\\\";\\n  };\\n  color-palette = {\\n    palette = [ \\\"#00ffff\\\" \\\"#a52a2a\\\" \\\"#dc143c\\\" \\\"#ff1493\\\" \\\"#ffd700\\\" \\\"#008000\\\" ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"satty\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.sbt.baseUserConfigPath\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\".sbt\\\"\"},\"description\":\"Where the sbt configuration files should be located, relative\\n{env}`HOME`.\\n\",\"loc\":[\"programs\",\"sbt\",\"baseUserConfigPath\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sbt.credentials\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"A list of credentials to define in the sbt configuration directory.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    host = \\\"example.com\\\";\\n    passwordCommand = \\\"pass show sbt/user@example.com\\\";\\n    realm = \\\"Sonatype Nexus Repository Manager\\\";\\n    user = \\\"user\\\";\\n  }\\n]\"},\"loc\":[\"programs\",\"sbt\",\"credentials\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.sbt.credentials.*.host\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"description\":\"The hostname of the repository you're authenticating to.\",\"loc\":[\"programs\",\"sbt\",\"credentials\",\"*\",\"host\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sbt.credentials.*.passwordCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"description\":\"The command that provides the password or authentication token for\\nthe repository.\\n\",\"loc\":[\"programs\",\"sbt\",\"credentials\",\"*\",\"passwordCommand\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sbt.credentials.*.realm\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"description\":\"The realm of the repository you're authenticating to.\",\"loc\":[\"programs\",\"sbt\",\"credentials\",\"*\",\"realm\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sbt.credentials.*.user\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"description\":\"The user you're using to authenticate.\",\"loc\":[\"programs\",\"sbt\",\"credentials\",\"*\",\"user\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sbt.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable sbt.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sbt\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sbt.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sbt\"},\"description\":\"The sbt package to use.\",\"loc\":[\"programs\",\"sbt\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.sbt.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"A list of plugins to place in the sbt configuration directory.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    artifact = \\\"sbt-dependency-graph\\\";\\n    org = \\\"net.virtual-void\\\";\\n    version = \\\"0.10.0-RC1\\\";\\n  }\\n  {\\n    artifact = \\\"sbt-project-graph\\\";\\n    org = \\\"com.dwijnand\\\";\\n    version = \\\"0.4.0\\\";\\n  }\\n]\"},\"loc\":[\"programs\",\"sbt\",\"plugins\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.sbt.plugins.*.artifact\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"description\":\"The name of the artifact.\",\"loc\":[\"programs\",\"sbt\",\"plugins\",\"*\",\"artifact\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sbt.plugins.*.org\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"description\":\"The organization the artifact is published under.\",\"loc\":[\"programs\",\"sbt\",\"plugins\",\"*\",\"org\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sbt.plugins.*.version\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"description\":\"The version of the plugin.\",\"loc\":[\"programs\",\"sbt\",\"plugins\",\"*\",\"version\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sbt.pluginsExtra\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"A list of extra commands to put in plugins conf file.\\nUse it in last resort when you can't use the `plugins` option.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"addDependencyTreePlugin\\\"\\n]\"},\"loc\":[\"programs\",\"sbt\",\"pluginsExtra\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.sbt.repositories\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sbt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sbt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"A list of repositories to use when resolving dependencies. Defined as a\\nlist of pre-defined repository or custom repository as a set of name to\\nURL. The list will be used populate the `~/.sbt/repositories`\\nfile in the order specified.\\n\\nPre-defined repositories must be one of `local`,\\n`maven-local`, `maven-central`.\\n\\nCustom repositories are defined as\\n`{ name-of-repo = \\\"https://url.to.repo.com\\\"}`.\\n\\nSee\\n<https://www.scala-sbt.org/1.x/docs/Launcher-Configuration.html#3.+Repositories+Section>\\nabout this configuration section and\\n<https://www.scala-sbt.org/1.x/docs/Proxy-Repositories.html>\\nto read about proxy repositories.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"local\\\"\\n  { my-ivy-proxy-releases = \\\"http://repo.company.com/ivy-releases/, [organization]/[module]/(scala_[scalaVersion]/)(sbt_[sbtVersion]/)[revision]/[type]s/[artifact](-[classifier]).[ext]\\\" }\\n  { my-maven-proxy-releases = \\\"http://repo.company.com/maven-releases/\\\" }\\n  \\\"maven-central\\\"\\n]\\n\"},\"loc\":[\"programs\",\"sbt\",\"repositories\"],\"readOnly\":false,\"type\":\"list of (one of \\\"local\\\", \\\"maven-central\\\", \\\"maven-local\\\" or attribute set of string)\"},\"programs.scmpuff.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/scmpuff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/scmpuff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable scmpuff, a command line tool that allows you to work quicker with Git by\\nsubstituting numeric shortcuts for files.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"scmpuff\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.scmpuff.enableAliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/scmpuff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/scmpuff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable aliases (e.g. gs, ga, gd, gco).\\n\",\"loc\":[\"programs\",\"scmpuff\",\"enableAliases\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.scmpuff.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/scmpuff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/scmpuff.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"scmpuff\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.scmpuff.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/scmpuff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/scmpuff.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"scmpuff\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.scmpuff.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/scmpuff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/scmpuff.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"scmpuff\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.scmpuff.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/scmpuff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/scmpuff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.scmpuff\"},\"description\":\"The scmpuff package to use.\",\"loc\":[\"programs\",\"scmpuff\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.screen.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/screen.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/screen.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable screen.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"screen\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.screen.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/screen.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/screen.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.screen\"},\"description\":\"The screen package to use.\",\"loc\":[\"programs\",\"screen\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.screen.screenrc\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/screen.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/screen.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Config file for GNU Screen. All the details can be found here:\\n<https://www.gnu.org/software/screen/manual/screen.html>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  screen -t rtorrent rtorrent\\n  screen -t irssi irssi\\n  screen -t centerim centerim\\n  screen -t ncmpc ncmpc -c\\n  screen -t bash4\\n  screen -t bash5\\n  screen -t bash6\\n  screen -t bash7\\n  screen -t bash8\\n  screen -t bash9\\n  altscreen on\\n  term screen-256color\\n  bind ',' prev\\n  bind '.' next\\n''\"},\"loc\":[\"programs\",\"screen\",\"screenrc\"],\"readOnly\":false,\"type\":\"null or absolute path or strings concatenated with \\\"\\\\n\\\"\"},\"programs.script-directory.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/script-directory.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/script-directory.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable script-directory.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"script-directory\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.script-directory.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/script-directory.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/script-directory.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.script-directory\"},\"description\":\"The script-directory package to use.\",\"loc\":[\"programs\",\"script-directory\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.script-directory.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/script-directory.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/script-directory.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"script-directory config, for options take a look at the [documentation](https://github.com/ianthehenry/sd#options)\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  SD_ROOT = \\\"${config.home.homeDirectory}/.sd\\\";\\n  SD_EDITOR = \\\"nvim\\\";\\n  SD_CAT = \\\"lolcat\\\";\\n}\\n\"},\"loc\":[\"programs\",\"script-directory\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.senpai.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/senpai.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/senpai.nix\"}],\"description\":\"Configuration for senpai. For a complete list of options, see\\n{manpage}`senpai(5)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  address = \\\"libera.chat:6697\\\";\\n  nickname = \\\"nicholas\\\";\\n  password = \\\"verysecurepassword\\\";\\n}\"},\"loc\":[\"programs\",\"senpai\",\"config\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of anything\"},\"programs.senpai.config.address\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/senpai.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/senpai.nix\"}],\"description\":\"The address (`host[:port]`) of the IRC server. senpai uses TLS\\nconnections by default unless you specify tls option to be false.\\nTLS connections default to port 6697, plain-text use port 6667.\\n\\nUR`ircs://`, `irc://`, and `irc+insecure://` URLs are supported,\\nin which case only the hostname and port parts will be used. If\\nthe scheme is `ircs/irc+insecure`, tls will be overridden and set\\nto true/false accordingly.\\n\",\"loc\":[\"programs\",\"senpai\",\"config\",\"address\"],\"readOnly\":false,\"type\":\"string\"},\"programs.senpai.config.nickname\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/senpai.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/senpai.nix\"}],\"description\":\"Your nickname, sent with a NICK IRC message. It mustn't contain\\nspaces or colons (:).\\n\",\"loc\":[\"programs\",\"senpai\",\"config\",\"nickname\"],\"readOnly\":false,\"type\":\"string\"},\"programs.senpai.config.password\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/senpai.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/senpai.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Your password, used for SASL authentication. Note that it will\\nreside world-readable in the Nix store.\\n\",\"loc\":[\"programs\",\"senpai\",\"config\",\"password\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.senpai.config.password-cmd\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/senpai.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/senpai.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Alternatively to providing your SASL authentication password\\ndirectly in plaintext, you can specify a command to be run to\\nfetch the password at runtime. This is useful if you store your\\npasswords in a separate (probably encrypted) file using `gpg` or a\\ncommand line password manager such as `pass` or `gopass`. If a\\npassword-cmd is provided, the value of password will be ignored\\nand the first line of the output of `password-cmd` will be used\\nfor login.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"gopass\\\"\\n  \\\"show\\\"\\n  \\\"irc/guest\\\"\\n]\"},\"loc\":[\"programs\",\"senpai\",\"config\",\"password-cmd\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"programs.senpai.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/senpai.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/senpai.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable senpai.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"senpai\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.senpai.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/senpai.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/senpai.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.senpai\"},\"description\":\"The senpai package to use.\",\"loc\":[\"programs\",\"senpai\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.sesh.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sesh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sesh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the sesh terminal session manager.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sesh\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sesh.enableAlias\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sesh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sesh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable a shell alias `s` to quickly launch sessions.\",\"loc\":[\"programs\",\"sesh\",\"enableAlias\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sesh.enableTmuxIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sesh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sesh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Enable Tmux integration with sesh.\",\"loc\":[\"programs\",\"sesh\",\"enableTmuxIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sesh.fzfPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sesh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sesh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.fzf\"},\"description\":\"The fzf package to use.\",\"loc\":[\"programs\",\"sesh\",\"fzfPackage\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.sesh.icons\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sesh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sesh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Display icons next to results ({option}`--icons` argument).\\n\",\"loc\":[\"programs\",\"sesh\",\"icons\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sesh.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sesh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sesh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sesh\"},\"description\":\"The sesh package to use.\",\"loc\":[\"programs\",\"sesh\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.sesh.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sesh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sesh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for sesh, written to `~/.config/sesh/sesh.toml`.\\n\\nSee the [sesh documentation](https://github.com/joshmedeski/sesh#configuration) for available options.\\n\",\"loc\":[\"programs\",\"sesh\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"programs.sesh.tmuxKey\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sesh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sesh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"s\\\"\"},\"description\":\"Keybinding for invoking sesh in Tmux.\",\"loc\":[\"programs\",\"sesh\",\"tmuxKey\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sesh.zoxidePackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sesh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sesh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.zoxide\"},\"description\":\"The zoxide package to use.\",\"loc\":[\"programs\",\"sesh\",\"zoxidePackage\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.sftpman.defaultSshKey\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the SSH key to be used by default. Can be overridden per host.\",\"loc\":[\"programs\",\"sftpman\",\"defaultSshKey\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.sftpman.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable sftpman, an application that handles sshfs/sftp file systems mounting.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sftpman\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sftpman.mounts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The sshfs mount configurations written to\\n{file}`$XDG_CONFIG_HOME/sftpman/mounts/`.\\n\",\"loc\":[\"programs\",\"sftpman\",\"mounts\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.sftpman.mounts.<name>.authType\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"publickey\\\"\"},\"description\":\"The authentication method to use.\",\"loc\":[\"programs\",\"sftpman\",\"mounts\",\"<name>\",\"authType\"],\"readOnly\":false,\"type\":\"one of \\\"password\\\", \\\"publickey\\\", \\\"hostbased\\\", \\\"keyboard-interactive\\\", \\\"gssapi-with-mic\\\", \\\"authentication-agent\\\"\"},\"programs.sftpman.mounts.<name>.beforeMount\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"true\\\"\"},\"description\":\"Command to run before mounting.\",\"loc\":[\"programs\",\"sftpman\",\"mounts\",\"<name>\",\"beforeMount\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sftpman.mounts.<name>.host\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"description\":\"The host to connect to.\",\"loc\":[\"programs\",\"sftpman\",\"mounts\",\"<name>\",\"host\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sftpman.mounts.<name>.mountDestPath\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The path on the current machine where the remote path would be mounted.\",\"loc\":[\"programs\",\"sftpman\",\"mounts\",\"<name>\",\"mountDestPath\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.sftpman.mounts.<name>.mountOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Options to pass to sshfs.\",\"loc\":[\"programs\",\"sftpman\",\"mounts\",\"<name>\",\"mountOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.sftpman.mounts.<name>.mountPoint\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"description\":\"The remote path to mount.\",\"loc\":[\"programs\",\"sftpman\",\"mounts\",\"<name>\",\"mountPoint\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sftpman.mounts.<name>.port\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"22\"},\"description\":\"The port to connect to.\",\"loc\":[\"programs\",\"sftpman\",\"mounts\",\"<name>\",\"port\"],\"readOnly\":false,\"type\":\"16 bit unsigned integer; between 0 and 65535 (both inclusive)\"},\"programs.sftpman.mounts.<name>.sshKey\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.programs.sftpman.defaultSshKey\"},\"description\":\"Path to the SSH key to use for authentication.\\nOnly applies if authMethod is `publickey`.\\n\",\"loc\":[\"programs\",\"sftpman\",\"mounts\",\"<name>\",\"sshKey\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.sftpman.mounts.<name>.user\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"description\":\"The username to authenticate with.\",\"loc\":[\"programs\",\"sftpman\",\"mounts\",\"<name>\",\"user\"],\"readOnly\":false,\"type\":\"string\"},\"programs.sftpman.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sftpman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sftpman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sftpman\"},\"description\":\"The sftpman package to use.\",\"loc\":[\"programs\",\"sftpman\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.sheldon.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sheldon.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sheldon.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable sheldon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sheldon\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sheldon.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sheldon.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sheldon.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"sheldon\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sheldon.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sheldon.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sheldon.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"sheldon\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sheldon.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sheldon.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sheldon.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"sheldon\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sheldon.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sheldon.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sheldon.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sheldon\"},\"description\":\"The sheldon package to use.\",\"loc\":[\"programs\",\"sheldon\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.sheldon.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sheldon.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sheldon.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"loc\":[\"programs\",\"sheldon\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.sherlock.aliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sherlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sherlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Defines custom aliases.\\n\\nWritten to `sherlock_alias.json`.\\n\\nSee <https://github.com/Skxxtz/sherlock/blob/main/docs/aliases.md> for more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"NixOS Wiki\\\" = {\\n    exec = \\\"firefox https://wiki.nixos.org/w/index.php?search=%s\\\";\\n    icon = \\\"nixos\\\";\\n    keywords = \\\"nix wiki docs\\\";\\n    name = \\\"NixOS Wiki\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"sherlock\",\"aliases\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.sherlock.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sherlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sherlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Enable Sherlock, a fast and lightweight application launcher for Wayland.\\n\\nSee <https://github.com/Skxxtz/sherlock> for more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sherlock\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sherlock.ignore\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sherlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sherlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"A list of desktop entry IDs to ignore.\\n\\nWritten to `sherlockignore`.\\n\\nSee <https://github.com/Skxxtz/sherlock/blob/main/docs/sherlockignore.md> for more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  hicolor-icon-theme.desktop\\n  user-dirs.desktop\\n''\"},\"loc\":[\"programs\",\"sherlock\",\"ignore\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.sherlock.launchers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sherlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sherlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Defines fallback launchers.\\n\\nWritten to `fallback.json`.\\n\\nSee <https://github.com/Skxxtz/sherlock/blob/main/docs/launchers.md> for more information.\\n\",\"loc\":[\"programs\",\"sherlock\",\"launchers\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.sherlock.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sherlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sherlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sherlock-launcher\"},\"description\":\"The sherlock package to use.\",\"loc\":[\"programs\",\"sherlock\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.sherlock.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sherlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sherlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for Sherlock.\\n\\nWritten to `config.toml`.\\n\\nSee <https://github.com/Skxxtz/sherlock/blob/main/docs/config.md> for available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  max_results = 8;\\n  theme = \\\"dark\\\";\\n  width = 500;\\n}\"},\"loc\":[\"programs\",\"sherlock\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.sherlock.style\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sherlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sherlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom CSS to style the Sherlock UI.\\n\\nWritten to `main.css`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  window {\\n    background-color: #2E3440;\\n  }\\n''\"},\"loc\":[\"programs\",\"sherlock\",\"style\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.sherlock.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sherlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sherlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable sherlock as a daemon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sherlock\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sioyek.bindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sioyek.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sioyek.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Input configuration written to\\n{file}`$XDG_CONFIG_HOME/sioyek/keys_user.config`.\\nSee <https://github.com/ahrm/sioyek/blob/main/pdf_viewer/keys.config>.\\n\\nEach attribute could also accept a list of strings to set multiple\\nbindings of the same command.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"move_up\\\" = \\\"k\\\";\\n  \\\"move_down\\\" = \\\"j\\\";\\n  \\\"move_left\\\" = \\\"h\\\";\\n  \\\"move_right\\\" = \\\"l\\\";\\n  \\\"screen_down\\\" = [ \\\"d\\\" \\\"<C-d>\\\" ];\\n  \\\"screen_up\\\" = [ \\\"u\\\" \\\"<C-u>\\\" ];\\n}\\n\"},\"loc\":[\"programs\",\"sioyek\",\"bindings\"],\"readOnly\":false,\"type\":\"attribute set of (string or list of string)\"},\"programs.sioyek.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sioyek.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sioyek.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Input configuration written to\\n{file}`$XDG_CONFIG_HOME/sioyek/prefs_user.config`.\\nSee <https://github.com/ahrm/sioyek/blob/main/pdf_viewer/prefs.config>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  background_color = \\\"1.0 1.0 1.0\\\";\\n  startup_commands = [\\n    \\\"toggle_visual_scroll\\\"\\n    \\\"toggle_dark_mode\\\"\\n  ];\\n  text_highlight_color = \\\"1.0 0.0 0.0\\\";\\n}\"},\"loc\":[\"programs\",\"sioyek\",\"config\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of string\"},\"programs.sioyek.config.startup_commands\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sioyek.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sioyek.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Commands to be run upon startup. Will be written to {file}`$XDG_CONFIG_HOME/sioyek/prefs_user.config`.\\nSee <https://github.com/ahrm/sioyek/blob/a4ce95fd968804fbf6ff3befcbe0d9b972bd754c/pdf_viewer/prefs.config#L116>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"toggle_visual_scroll\\\"\\n  \\\"toggle_dark_mode\\\"\\n]\"},\"loc\":[\"programs\",\"sioyek\",\"config\",\"startup_commands\"],\"readOnly\":false,\"type\":\"string or list of string\"},\"programs.sioyek.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sioyek.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sioyek.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Sioyek, a PDF viewer designed for reading research papers and technical books.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sioyek\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sioyek.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sioyek.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sioyek.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sioyek\"},\"description\":\"The sioyek package to use.\",\"loc\":[\"programs\",\"sioyek\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.sketchybar.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The sketchybar configuration. Can be specified as:\\n\\n1. A string containing the configuration content directly\\n2. An attribute set with 'source' pointing to a directory containing\\n   the full configuration, and optionally 'recursive = true' to\\n   recursively copy all files\\n3. An attribute set with 'text' containing inline configuration\\n\\nWhen using a string or 'text', the appropriate shebang will be\\nautomatically added based on configType (bash or lua).\\n\\nWhen using a directory source, it should contain a file named\\n\\\"sketchybarrc\\\" which serves as the main entry point.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"# String example - inline configuration\\n''\\n# Define colors\\nexport COLOR_BLACK=\\\"0xff181926\\\"\\nexport COLOR_WHITE=\\\"0xffcad3f5\\\"\\n\\n# Configure bar\\nsketchybar --bar height=32 \\\\\\n                position=top \\\\\\n                padding_left=10 \\\\\\n                padding_right=10 \\\\\\n                color=$COLOR_BLACK\\n\\n# Configure default values\\nsketchybar --default icon.font=\\\"SF Pro:Bold:14.0\\\" \\\\\\n                    icon.color=$COLOR_WHITE \\\\\\n                    label.font=\\\"SF Pro:Bold:14.0\\\" \\\\\\n                    label.color=$COLOR_WHITE\\n\\n# Add items to the bar\\nsketchybar --add item clock right \\\\\\n          --set clock script=\\\"date '+%H:%M'\\\" \\\\\\n                      update_freq=10\\n\\n# Update the bar\\nsketchybar --update\\n''\\n\\n# Or directory example - for complex configurations\\n# {\\n#   source = ./path/to/sketchybar-config;\\n#   recursive = true;\\n# }\\n\"},\"loc\":[\"programs\",\"sketchybar\",\"config\"],\"readOnly\":false,\"type\":\"null or strings concatenated with \\\"\\\\n\\\" or (submodule)\"},\"programs.sketchybar.config.recursive\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Whether to recursively link files from {option}`source` (if it is a directory) in `.config/sketchybar`.\\n.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sketchybar\",\"config\",\"recursive\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sketchybar.config.source\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The path to be linked to `.config/sketchybar` if {option}`source` is a directory,\\nor to `.config/sketchybar/sketchybarrc` if it is a file.\\n\",\"loc\":[\"programs\",\"sketchybar\",\"config\",\"source\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.sketchybar.config.text\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Text to be included in `.config/sketchybar/sketchybarrc`.\\n\",\"loc\":[\"programs\",\"sketchybar\",\"config\",\"text\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.sketchybar.configType\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"bash\\\"\"},\"description\":\"The type of configuration to generate.\\n\\nSet to \\\"bash\\\" to use the standard bash configuration.\\nSet to \\\"lua\\\" to use the Lua configuration via SbarLua.\\n\",\"loc\":[\"programs\",\"sketchybar\",\"configType\"],\"readOnly\":false,\"type\":\"one of \\\"bash\\\", \\\"lua\\\"\"},\"programs.sketchybar.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable sketchybar.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sketchybar\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sketchybar.extraLuaPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"ps: [ ]\"},\"description\":\"The extra Lua packages required for your plugins to work.\\nThis option accepts a function that takes a Lua package set as an argument,\\nand selects the required Lua packages from this package set.\\nSee the example for more info.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"luaPkgs: with luaPkgs; [ luautf8 ]\"},\"loc\":[\"programs\",\"sketchybar\",\"extraLuaPackages\"],\"readOnly\":false,\"type\":\"function that evaluates to a(n) list of package\"},\"programs.sketchybar.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra packages to add to PATH for the sketchybar service.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.jq ]\"},\"loc\":[\"programs\",\"sketchybar\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.sketchybar.includeSystemPath\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to include common system `PATH` in the wrapper.\\nThis allows sketchybar to access system binaries.\\n\",\"loc\":[\"programs\",\"sketchybar\",\"includeSystemPath\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sketchybar.luaPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Lua interpreter to use when configType is lua.\\n\\nBy default this is inferred from `sbarLuaPackage.passthru.luaModule`\\nwhen available.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.lua5_5\"},\"loc\":[\"programs\",\"sketchybar\",\"luaPackage\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.sketchybar.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sketchybar\"},\"description\":\"The sketchybar package to use.\",\"loc\":[\"programs\",\"sketchybar\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.sketchybar.sbarLuaPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sbarlua\"},\"description\":\"The sbarlua package to use. Required when using a lua configuration.\",\"loc\":[\"programs\",\"sketchybar\",\"sbarLuaPackage\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.sketchybar.service.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable sketchybar service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sketchybar\",\"service\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sketchybar.service.errorLogFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${config.home.homeDirectory}/Library/Logs/sketchybar/sketchybar.err.log\"},\"description\":\"Absolute path to log all stderr output.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/Users/khaneliman/Library/Logs/sketchybar.log\\\"\"},\"loc\":[\"programs\",\"sketchybar\",\"service\",\"errorLogFile\"],\"readOnly\":false,\"type\":\"null or absolute path or string\"},\"programs.sketchybar.service.outLogFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sketchybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sketchybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${config.home.homeDirectory}/Library/Logs/sketchybar/sketchybar.out.log\"},\"description\":\"Absolute path to log all stdout output.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/Users/khaneliman/Library/Logs/sketchybar.log\\\"\"},\"loc\":[\"programs\",\"sketchybar\",\"service\",\"outLogFile\"],\"readOnly\":false,\"type\":\"null or absolute path or string\"},\"programs.skim.changeDirWidgetCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/skim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/skim.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The command that gets executed as the source for skim for the\\nALT-C keybinding.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fd --type d\\\"\"},\"loc\":[\"programs\",\"skim\",\"changeDirWidgetCommand\"],\"readOnly\":