5/modules/programs/lf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Commands to declare. Commands set to null or an empty string are\\ndeleted.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  get-mime-type = \\\"%xdg-mime query filetype \\\\\\\"$f\\\\\\\"\\\";\\n  open = \\\"$$OPENER $f\\\";\\n}\"},\"loc\":[\"programs\",\"lf\",\"commands\"],\"readOnly\":false,\"type\":\"attribute set of (null or string)\"},\"programs.lf.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable lf.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"lf\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.lf.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom lfrc lines.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  $mkdir -p ~/.trash\\n''\"},\"loc\":[\"programs\",\"lf\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.lf.keybindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Keys to bind. Keys set to null or an empty string are deleted.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  D = \\\"trash\\\";\\n  U = \\\"!du -sh\\\";\\n  gg = null;\\n  gh = \\\"cd ~\\\";\\n  i = \\\"$less $f\\\";\\n}\"},\"loc\":[\"programs\",\"lf\",\"keybindings\"],\"readOnly\":false,\"type\":\"attribute set of (null or string)\"},\"programs.lf.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.lf\"},\"description\":\"The lf package to use.\",\"loc\":[\"programs\",\"lf\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.lf.previewer.keybinding\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Key to bind to the script at {var}`previewer.source` and\\npipe through less. Setting to null will not bind any key.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"i\\\"\"},\"loc\":[\"programs\",\"lf\",\"previewer\",\"keybinding\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.lf.previewer.source\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Script or executable to use to preview files. Sets lf's\\n{var}`previewer` option.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.writeShellScript \\\"pv.sh\\\" ''\\n  #!/bin/sh\\n\\n  case \\\"$1\\\" in\\n      *.tar*) tar tf \\\"$1\\\";;\\n      *.zip) unzip -l \\\"$1\\\";;\\n      *.rar) unrar l \\\"$1\\\";;\\n      *.7z) 7z l \\\"$1\\\";;\\n      *.pdf) pdftotext \\\"$1\\\" -;;\\n      *) highlight -O ansi \\\"$1\\\" || cat \\\"$1\\\";;\\n  esac\\n''\\n\"},\"loc\":[\"programs\",\"lf\",\"previewer\",\"source\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.lf.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of lf settings. See the lf documentation for\\ndetailed descriptions of these options. Prefer\\n{option}`programs.lf.previewer.*` for setting lf's {var}`previewer`\\noption. All string options are quoted with double quotes.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  number = true;\\n  ratios = [\\n    1\\n    1\\n    2\\n  ];\\n  tabstop = 4;\\n}\"},\"loc\":[\"programs\",\"lf\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or list of (string or signed integer) or boolean)\"},\"programs.librewolf.darwinDefaultsId\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The id for the darwin defaults in order to set policies\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"com.developer.app\\\"\"},\"loc\":[\"programs\",\"librewolf\",\"darwinDefaultsId\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.librewolf.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable LibreWolf. LibreWolf is a privacy enhanced Firefox fork.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"librewolf\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.enableGnomeExtensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the GNOME Shell native host connector. Note, you\\nalso need to set the NixOS option\\n`services.gnome.gnome-browser-connector.enable` to\\n`true`.\\n\",\"loc\":[\"programs\",\"librewolf\",\"enableGnomeExtensions\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Resulting LibreWolf package.\",\"loc\":[\"programs\",\"librewolf\",\"finalPackage\"],\"readOnly\":true,\"type\":\"null or package\"},\"programs.librewolf.languagePacks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The language packs to install. Available language codes can be found\\non the releases page:\\n`https://releases.mozilla.org/pub/firefox/releases/${version}/linux-x86_64/xpi/`,\\nreplacing `${version}` with the version of LibreWolf you have. If\\nthe version string of your Firefox derivative diverts from the upstream\\nversion, try setting the `release` option.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"en-GB\\\"\\n  \\\"de\\\"\\n]\"},\"loc\":[\"programs\",\"librewolf\",\"languagePacks\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.librewolf.nativeMessagingHosts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Additional packages containing native messaging hosts that should be\\nmade available to LibreWolf extensions.\\n\",\"loc\":[\"programs\",\"librewolf\",\"nativeMessagingHosts\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.librewolf.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.librewolf\"},\"description\":\"The LibreWolf package to use. If state version ≥ 19.09 then\\nthis should be a wrapped LibreWolf package. For earlier state\\nversions it should be an unwrapped LibreWolf package.\\nSet to `null` to disable installing LibreWolf.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.librewolf.override {\\n  # See nixpkgs' firefox/wrapper.nix to check which options you can use\\n  nativeMessagingHosts = [\\n    # Gnome shell native connector\\n    pkgs.gnome-browser-connector\\n    # Tridactyl native connector\\n    pkgs.tridactyl-native\\n  ];\\n}\\n\"},\"loc\":[\"programs\",\"librewolf\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.librewolf.pkcs11Modules\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Additional packages to be loaded as PKCS #11 modules in Firefox.\\n\",\"loc\":[\"programs\",\"librewolf\",\"pkcs11Modules\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.librewolf.policies\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"[See list of policies](https://mozilla.github.io/policy-templates/).\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  BlockAboutConfig = true;\\n  DefaultDownloadDirectory = \\\"\\\\${home}/Downloads\\\";\\n  ExtensionSettings = {\\n    \\\"uBlock0@raymondhill.net\\\" = {\\n      default_area = \\\"menupanel\\\";\\n      install_url = \\\"https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi\\\";\\n      installation_mode = \\\"force_installed\\\";\\n      private_browsing = true;\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"librewolf\",\"policies\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.librewolf.profiles\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of LibreWolf profiles.\\n\\n\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.librewolf.profiles.<name>.bookmarks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Declarative bookmarks.\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"bookmarks\"],\"readOnly\":false,\"type\":\"(submodule) or ((list of ((bookmark submodule) or (directory submodule) or value \\\"separator\\\" (singular enum))) or (attribute set of ((bookmark submodule) or (directory submodule) or value \\\"separator\\\" (singular enum))) convertible to it) convertible to it\"},\"programs.librewolf.profiles.<name>.bookmarks.configFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Configuration file to define custom bookmarks.\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"bookmarks\",\"configFile\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.librewolf.profiles.<name>.bookmarks.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force override existing custom bookmarks.\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"bookmarks\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.profiles.<name>.bookmarks.meta.maintainers\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of maintainers of each module.\\nThis option should be defined at most once per module.\\n\\nThe option value is not a list of maintainers, but an attribute set that maps module file names to lists of maintainers.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.maintainers.alice lib.maintainers.bob ]\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"bookmarks\",\"meta\",\"maintainers\"],\"readOnly\":false,\"type\":\"list of lib.maintainers\"},\"programs.librewolf.profiles.<name>.bookmarks.meta.teams\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of team maintainers of each module.\\nThis option should be defined at most once per module.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.teams.acme lib.teams.haskell ]\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"bookmarks\",\"meta\",\"teams\"],\"readOnly\":false,\"type\":\"list of lib.teams\"},\"programs.librewolf.profiles.<name>.bookmarks.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Custom bookmarks.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    name = \\\"wikipedia\\\";\\n    tags = [ \\\"wiki\\\" ];\\n    keyword = \\\"wiki\\\";\\n    url = \\\"https://en.wikipedia.org/wiki/Special:Search?search=%s&go=Go\\\";\\n  }\\n  {\\n    name = \\\"kernel.org\\\";\\n    url = \\\"https://www.kernel.org\\\";\\n  }\\n  \\\"separator\\\"\\n  {\\n    name = \\\"Nix sites\\\";\\n    toolbar = true;\\n    bookmarks = [\\n      {\\n        name = \\\"homepage\\\";\\n        url = \\\"https://nixos.org/\\\";\\n      }\\n      {\\n        name = \\\"wiki\\\";\\n        tags = [ \\\"wiki\\\" \\\"nix\\\" ];\\n        url = \\\"https://wiki.nixos.org/\\\";\\n      }\\n    ];\\n  }\\n]\\n\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"bookmarks\",\"settings\"],\"readOnly\":false,\"type\":\"(list of ((bookmark submodule) or (directory submodule) or value \\\"separator\\\" (singular enum))) or (attribute set of ((bookmark submodule) or (directory submodule) or value \\\"separator\\\" (singular enum))) convertible to it\"},\"programs.librewolf.profiles.<name>.containers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of container configurations. See\\n[Multi-Account\\nContainers](https://support.mozilla.org/en-US/kb/containers)\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  dangerous = {\\n    color = \\\"red\\\";\\n    icon = \\\"fruit\\\";\\n    id = 2;\\n  };\\n  shopping = {\\n    color = \\\"blue\\\";\\n    icon = \\\"cart\\\";\\n    id = 1;\\n  };\\n}\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"containers\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.librewolf.profiles.<name>.containers.<name>.color\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pink\\\"\"},\"description\":\"Container color.\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"color\"],\"readOnly\":false,\"type\":\"one of \\\"blue\\\", \\\"turquoise\\\", \\\"green\\\", \\\"yellow\\\", \\\"orange\\\", \\\"red\\\", \\\"pink\\\", \\\"purple\\\", \\\"toolbar\\\"\"},\"programs.librewolf.profiles.<name>.containers.<name>.icon\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fruit\\\"\"},\"description\":\"Container icon.\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"icon\"],\"readOnly\":false,\"type\":\"one of \\\"briefcase\\\", \\\"cart\\\", \\\"circle\\\", \\\"dollar\\\", \\\"fence\\\", \\\"fingerprint\\\", \\\"gift\\\", \\\"vacation\\\", \\\"food\\\", \\\"fruit\\\", \\\"pet\\\", \\\"tree\\\", \\\"chill\\\"\"},\"programs.librewolf.profiles.<name>.containers.<name>.id\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"Container ID. This should be set to a unique number per container in this profile.\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"id\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"programs.librewolf.profiles.<name>.containers.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"Container name, e.g., shopping.\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"programs.librewolf.profiles.<name>.containersForce\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force replace the existing containers configuration.\\nThis is recommended since LibreWolf will replace the symlink on\\nevery launch, but note that you'll lose any existing configuration\\nby enabling this.\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"containersForce\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.profiles.<name>.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Submodule for installing and configuring extensions.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  packages = with pkgs.nur.repos.rycee.firefox-addons; [\\n    ublock-origin\\n  ];\\n  settings.\\\"uBlock0@raymondhill.net\\\".settings = {\\n    selectedFilterLists = [\\n      \\\"ublock-filters\\\"\\n      \\\"ublock-badware\\\"\\n      \\\"ublock-privacy\\\"\\n      \\\"ublock-unbreak\\\"\\n      \\\"ublock-quick-fixes\\\"\\n    ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"extensions\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.librewolf.profiles.<name>.extensions.exactPermissions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When enabled,\\n{option}`programs.librewolf.profiles.<profile>.extensions.settings.<extensionID>.permissions`\\nmust specify the exact set of permissions that the\\nextension will request.\\n\\nThis means that if the authorized permissions are\\nbroader than what the extension requests, the\\nassertion will fail.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"extensions\",\"exactPermissions\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.profiles.<name>.extensions.exhaustivePermissions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When enabled, the user must authorize requested\\npermissions for all extensions from\\n{option}`programs.librewolf.profiles.<profile>.extensions.packages`\\nin\\n{option}`programs.librewolf.profiles.<profile>.extensions.settings.<extensionID>.permissions`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"extensions\",\"exhaustivePermissions\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.profiles.<name>.extensions.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to override all previous firefox settings.\\n\\nThis is required when using `settings`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"extensions\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.profiles.<name>.extensions.packages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of ‹name› add-on packages to install for this profile.\\nSome pre-packaged add-ons are accessible from the Nix User Repository.\\nOnce you have NUR installed run\\n\\n```console\\n$ nix-env -f '<nixpkgs>' -qaP -A nur.repos.rycee.firefox-addons\\n```\\n\\nto list the available ‹name› add-ons.\\n\\nNote that it is necessary to manually enable these extensions\\ninside ‹name› after the first installation.\\n\\nTo automatically enable extensions add\\n`\\\"extensions.autoDisableScopes\\\" = 0;`\\nto\\n[{option}`programs.librewolf.profiles.<profile>.settings`](#opt-programs.librewolf.profiles._name_.settings)\\n\\nOn systems using impermanence, this only prevents\\n‹name› from requiring manual extension approval. It\\ndoes not preserve extension runtime state such as\\nextension UUIDs, logins, local storage, or\\nper-extension data. Persist the ‹name› profile state\\nneeded by your extensions, or configure supported\\nextension settings declaratively with\\n[{option}`programs.librewolf.profiles.<profile>.extensions.settings`](#opt-programs.librewolf.profiles._name_.extensions.settings).\\n\\nPersisting only the `extensions` directory is generally\\nnot sufficient, because ‹name› stores extension state\\nin other profile files and databases that are managed\\noutside Home Manager.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs.nur.repos.rycee.firefox-addons; [\\n  privacy-badger\\n]\\n\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"extensions\",\"packages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.librewolf.profiles.<name>.extensions.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of options for each extension.\\nThe keys of the attribute set consist of the ID of the extension\\nor its UUID wrapped in curly braces.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  # Example with uBlock origin's extensionID\\n  \\\"uBlock0@raymondhill.net\\\".settings = {\\n    selectedFilterLists = [\\n      \\\"ublock-filters\\\"\\n      \\\"ublock-badware\\\"\\n      \\\"ublock-privacy\\\"\\n      \\\"ublock-unbreak\\\"\\n      \\\"ublock-quick-fixes\\\"\\n    ];\\n  };\\n\\n  # Example with Stylus' UUID-form extensionID\\n  \\\"{7a7a4a92-a2a0-41d1-9fd7-1e92480d612d}\\\".settings = {\\n    dbInChromeStorage = true; # required for Stylus\\n  }\\n}\\n\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"extensions\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.librewolf.profiles.<name>.extensions.settings.<name>.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Forcibly override any existing configuration for\\nthis extension.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"extensions\",\"settings\",\"<name>\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.profiles.<name>.extensions.settings.<name>.permissions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Any permissions\\\"\"},\"description\":\"Allowed permissions for this extension. See\\n<https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/manifest.json/permissions>\\nfor a list of relevant permissions.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"activeTab\\\"\\n]\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"extensions\",\"settings\",\"<name>\",\"permissions\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"programs.librewolf.profiles.<name>.extensions.settings.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Json formatted options for this extension.\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"extensions\",\"settings\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.librewolf.profiles.<name>.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra preferences to add to {file}`user.js`.\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.librewolf.profiles.<name>.handlers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Declarative handlers configuration for MIME types and URL schemes.\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.librewolf.profiles.<name>.handlers.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force replace the existing handlers configuration.\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.profiles.<name>.handlers.meta.maintainers\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of maintainers of each module.\\nThis option should be defined at most once per module.\\n\\nThe option value is not a list of maintainers, but an attribute set that maps module file names to lists of maintainers.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.maintainers.alice lib.maintainers.bob ]\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\",\"meta\",\"maintainers\"],\"readOnly\":false,\"type\":\"list of lib.maintainers\"},\"programs.librewolf.profiles.<name>.handlers.meta.teams\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of team maintainers of each module.\\nThis option should be defined at most once per module.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.teams.acme lib.teams.haskell ]\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\",\"meta\",\"teams\"],\"readOnly\":false,\"type\":\"list of lib.teams\"},\"programs.librewolf.profiles.<name>.handlers.mimeTypes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set mapping MIME types to their handler configurations.\\n\\nFor a configuration example, see [this file on Firefox’s source code](https://github.com/mozilla-firefox/firefox/blob/c3797cdebac1316dd7168e995e3468c5a597e8d1/uriloader/exthandler/tests/unit/handlers.json).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"application/pdf\\\" = {\\n    action = 2;\\n    ask = false;\\n    handlers = [\\n      {\\n        name = \\\"Okular\\\";\\n        path = \\\"${pkgs.okular}/bin/okular\\\";\\n      }\\n    ];\\n    extensions = [ \\\"pdf\\\" ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.librewolf.profiles.<name>.handlers.mimeTypes.<name>.action\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"The action to take for this MIME type / URL scheme. Possible values:\\n- 0: Save file\\n- 1: Always ask\\n- 2: Use helper app\\n- 3: Open in LibreWolf\\n- 4: Use system default\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"action\"],\"readOnly\":false,\"type\":\"one of 0, 1, 2, 3, 4\"},\"programs.librewolf.profiles.<name>.handlers.mimeTypes.<name>.ask\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If true, the user is asked what they want to do with the file.\\nIf false, the action is taken without user intervention.\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"ask\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.profiles.<name>.handlers.mimeTypes.<name>.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of file extensions associated with this MIME type.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"jpg\\\"\\n  \\\"jpeg\\\"\\n]\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"extensions\"],\"readOnly\":false,\"type\":\"list of string matching the pattern ^[^\\\\.].+$\"},\"programs.librewolf.profiles.<name>.handlers.mimeTypes.<name>.handlers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"An array of handlers with the first one being the default.\\nIf you don't want to have a default handler, use an empty object for the first handler.\\nOnly valid when action is set to 2 (Use helper app).\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.librewolf.profiles.<name>.handlers.mimeTypes.<name>.handlers.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Display name of the handler.\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.librewolf.profiles.<name>.handlers.mimeTypes.<name>.handlers.*.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the executable to be used.\\n\\nOnly one of 'path' or 'uriTemplate' should be set.\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\",\"*\",\"path\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.librewolf.profiles.<name>.handlers.mimeTypes.<name>.handlers.