b/release-26.05/modules/services/window-managers/bspwm\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether the node should stay on the focused desktop.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"xsession\",\"windowManager\",\"bspwm\",\"rules\",\"<name>\",\"sticky\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"xsession.windowManager.bspwm.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/bspwm>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/bspwm\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"General settings given to `bspc config`.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  border_width = 2;\\n  gapless_monocle = true;\\n  split_ratio = 0.52;\\n}\"},\"loc\":[\"xsession\",\"windowManager\",\"bspwm\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or floating point number or string or list of (boolean or signed integer or floating point number or string))\"},\"xsession.windowManager.bspwm.startupPrograms\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/bspwm>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/bspwm\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Programs to be executed during startup.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"numlockx on\\\"\\n  \\\"tilda\\\"\\n]\"},\"loc\":[\"xsession\",\"windowManager\",\"bspwm\",\"startupPrograms\"],\"readOnly\":false,\"type\":\"list of string\"},\"xsession.windowManager.command\":{\"declarations\":[{\"name\":\"<home-manager/modules/xsession.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/xsession.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"test -n \\\\\\\"$1\\\\\\\" && eval \\\\\\\"$@\\\\\\\"\\\"\"},\"description\":\"Command to use to start the window manager.\\n\\nThe default value allows integration with NixOS' generated xserver configuration.\\n\\nExtra actions and commands can be specified in {option}`xsession.initExtra`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"let\\n  xmonad = pkgs.xmonad-with-packages.override {\\n    packages = self: [ self.xmonad-contrib self.taffybar ];\\n  };\\nin\\n  \\\"${xmonad}/bin/xmonad\\\";\\n\"},\"loc\":[\"xsession\",\"windowManager\",\"command\"],\"readOnly\":false,\"type\":\"string\"},\"xsession.windowManager.exwm.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/exwm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/exwm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable exwm.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"xsession\",\"windowManager\",\"exwm\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xsession.windowManager.exwm.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/exwm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/exwm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"epkgs: []\"},\"description\":\"Extra packages available to Emacs. The value must be a\\nfunction which receives the attrset defined in\\n{var}`emacs.pkgs` as the sole argument.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"epkgs: [\\n  epkgs.emms\\n  epkgs.magit\\n  epkgs.proof-general\\n]\\n\"},\"loc\":[\"xsession\",\"windowManager\",\"exwm\",\"extraPackages\"],\"readOnly\":false,\"type\":\"function that evaluates to a(n) list of package\"},\"xsession.windowManager.exwm.loadScript\":{\"declarations\":[{\"na