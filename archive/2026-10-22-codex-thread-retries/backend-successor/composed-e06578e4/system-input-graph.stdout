c\":[\"services\",\"pulseeffects\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.pulseeffects.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pulseeffects.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pulseeffects.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.pulseeffects-legacy\"},\"description\":\"The pulseeffects-legacy package to use.\",\"loc\":[\"services\",\"pulseeffects\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.pulseeffects.preset\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pulseeffects.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pulseeffects.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Which preset to use when starting pulseeffects.\\nWill likely need to launch pulseeffects to initially create preset.\\n\",\"loc\":[\"services\",\"pulseeffects\",\"preset\"],\"readOnly\":false,\"type\":\"string\"},\"services.radicle.node.args\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Additional command line arguments to pass when executing `radicle-node`.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"--force\\\"\"},\"loc\":[\"services\",\"radicle\",\"node\",\"args\"],\"readOnly\":false,\"type\":\"string\"},\"services.radicle.node.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Radicle Node.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"radicle\",\"node\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.radicle.node.environment\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Environment to set when executing `radicle-node`.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  RUST_BACKTRACE = \\\"full\\\";\\n}\"},\"loc\":[\"services\",\"radicle\",\"node\",\"environment\"],\"readOnly\":false,\"type\":\"attribute set of (null or string or absolute path or package)\"},\"services.radicle.node.lazy.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable a proxy service to lazily start and stop Radicle Node on demand.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"radicle\",\"node\",\"lazy\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.radicle.node.lazy.exitIdleTime\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"30min\\\"\"},\"description\":\"The idle time after which no interaction with Radicle Node via the `rad` CLI should be stopped, in a format that {manpage}`systemd-socket-proxyd(8)` understands for its `--exit-idle-time` argument.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"1h\\\"\"},\"loc\":[\"services\",\"radicle\",\"node\",\"lazy\",\"exitIdleTime\"],\"readOnly\":false,\"type\":\"string\"},\"services.radicle.node.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.radicle-node\"},\"description\":\"The radicle-node package to use.\",\"loc\":[\"services\",\"radicle\",\"node\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.random-background.display\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/random-background.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/random-background.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fill\\\"\"},\"description\":\"Display background images according to this option.\",\"loc\":[\"services\",\"random-background\",\"display\"],\"readOnly\":false,\"type\":\"one of \\\"center\\\", \\\"fill\\\", \\\"max\\\", \\\"scale\\\", \\\"tile\\\"\"},\"services.random-background.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/random-background.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/random-background.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable random desktop background.\\n\\nNote, if you are using NixOS and have set up a custom\\ndesktop manager session for Home Manager, then the session\\nconfiguration must have the `bgSupport`\\noption set to `true` or the background\\nimage set by this module may be overwritten.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"random-background\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.random-background.enableXinerama\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/random-background.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/random-background.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Will place a separate image per screen when enabled,\\notherwise a single image will be stretched across all\\nscreens.\\n\",\"loc\":[\"services\",\"random-background\",\"enableXinerama\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.random-background.imageDirectory\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/random-background.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/random-background.nix\"}],\"description\":\"The directory of images from which a background should be\\nchosen. Should be formatted in a way understood by systemd,\\ne.g., '%h' is the home directory.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"%h/backgrounds\\\"\"},\"loc\":[\"services\",\"random-background\",\"imageDirectory\"],\"readOnly\":false,\"type\":\"string\"},\"services.random-background.interval\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/random-background.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/random-background.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The duration between changing background image, set to null\\nto only set background when logging in. Should be formatted\\nas a duration understood by systemd.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"1h\\\"\"},\"loc\":[\"services\",\"random-background\",\"interval\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.random-background.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/random-background.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/random-background.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.feh\"},\"description\":\"The feh package to use.\",\"loc\":[\"services\",\"random-background\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.recoll.configDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/recoll.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/recoll.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${config.home.homeDirectory}/.recoll\"},\"description\":\"The directory to contain Recoll configuration files. This will be set\\nas {env}`RECOLL_CONFDIR`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"${config.xdg.configHome}/recoll\"},\"loc\":[\"services\",\"recoll\",\"configDir\"],\"readOnly\":false,\"type\":\"string\"},\"services.recoll.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/recoll.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/recoll.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Recoll file index service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"recoll\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.recoll.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/recoll.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/recoll.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.recoll\"},\"description\":\"The recoll package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"(pkgs.recoll.override { withGui = false; })\"},\"loc\":[\"services\",\"recoll\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.recoll.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/recoll.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/recoll.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The configuration to be written at {file}`$RECOLL_CONFDIR/recoll.conf`.\\n\\nSee {manpage}`recoll.conf(5)` for more details about the configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  loglevel = 5;\\n  nocjk = true;\\n  topdirs = [\\n    \\\"~/Downloads\\\"\\n    \\\"~/Documents\\\"\\n    \\\"~/projects\\\"\\n  ];\\n  \\\"~/Downloads\\\" = {\\n    \\\"skippedNames+\\\" = [\\n      \\\"*.iso\\\"\\n    ];\\n  };\\n  \\\"~/projects\\\" = {\\n    \\\"skippedNames+\\\" = [\\n      \\\"node_modules\\\"\\n      \\\"target\\\"\\n      \\\"result\\\"\\n    ];\\n  };\\n}\"},\"loc\":[\"services\",\"recoll\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (Recoll config value)\"},\"services.recoll.startAt\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/recoll.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/recoll.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"hourly\\\"\"},\"description\":\"When or how often the periodic update should run. Must be the format\\ndescribed from {manpage}`systemd.time(7)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"00/2:00\\\"\"},\"loc\":[\"services\",\"recoll\",\"startAt\"],\"readOnly\":false,\"type\":\"string\"},\"services.redshift.dawnTime\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/redshift.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/redshift.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the time interval of dawn manually.\\nThe times must be specified as HH:MM in 24-hour format.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"6:00-7:45\\\"\"},\"loc\":[\"services\",\"redshift\",\"dawnTime\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.redshift.duskTime\":{\"declarations\":[{\"name\":\"<home-manager/modules/s