astfetch/config.jsonc`.\\nSee <https://github.com/fastfetch-cli/fastfetch/wiki/Json-Schema>\\nfor the documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  logo = {\\n    source = \\\"nixos_small\\\";\\n    padding = {\\n      right = 1;\\n    };\\n  };\\n  display = {\\n    size = {\\n      binaryPrefix = \\\"si\\\";\\n    };\\n    color = \\\"blue\\\";\\n    separator = \\\"  \\\";\\n  };\\n  modules = [\\n    {\\n      type = \\\"datetime\\\";\\n      key = \\\"Date\\\";\\n      format = \\\"{1}-{3}-{11}\\\";\\n    }\\n    {\\n      type = \\\"datetime\\\";\\n      key = \\\"Time\\\";\\n      format = \\\"{14}:{17}:{20}\\\";\\n    }\\n    \\\"break\\\"\\n    \\\"player\\\"\\n    \\\"media\\\"\\n  ];\\n};\\n\"},\"loc\":[\"programs\",\"fastfetch\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.fd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable fd, a simple, fast and user-friendly alternative to {command}`find`.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"fd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.fd.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra command line options passed to fd.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--no-ignore\\\"\\n  \\\"--absolute-path\\\"\\n]\"},\"loc\":[\"programs\",\"fd\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.fd.hidden\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fd.nix>\",