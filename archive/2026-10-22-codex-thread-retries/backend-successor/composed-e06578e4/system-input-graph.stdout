d part of a Home Manager generation.\nhomeFilePattern=\"$(readlink -e /nix/store)/*-home-manager-files/*\"\n\nnewGenFiles=\"$1\"\nshift 1\nfor relativePath in \"$@\" ; do\n  targetPath=\"$HOME/$relativePath\"\n  if [[ -e \"$newGenFiles/$relativePath\" ]] ; then\n    verboseEcho \"Checking $targetPath: exists\"\n  elif [[ ! \"$(readlink \"$targetPath\")\" == $homeFilePattern ]] ; then\n    warnEcho \"Path '$targetPath' does not link into a Home Manager generation. Skipping delete.\"\n  else\n    verboseEcho \"Checking $targetPath: gone (deleting)\"\n    run rm $VERBOSE_ARG \"$targetPath\"\n\n    # Recursively delete empty parent directories.\n    targetDir=\"$(dirname \"$relativePath\")\"\n    if [[ \"$targetDir\" != \".\" ]] ; then\n      pushd \"$HOME\" > /dev/null\n\n      # Call rmdir with a relative path excluding $HOME.\n      # Otherwise, it might try to delete $HOME and exit\n      # with a permission error.\n      run rmdir $VERBOSE_ARG \\\n          -p --ignore-fail-on-non-empty \\\n          \"$targetDir\"\n\n      popd > /dev/null\n    fi\n  fi\ndone\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"92r52csb7ijaagxs5kvbg69vqw3kl797-hm-modules-messages.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","zhrjg6wxrxmdlpn6iapzpp2z2vylpvw5-home-manager.sh"]},"name":"cleanup","outputs":{"out":{"path":"qbl5yzra6n8rcavr711k762v5pp3w2q1-cleanup"}},"system":"x86_64-linux","version":4},"k1iddybq4w2k0amqz82p0rd1sq79bhbg-bootstrap-stage0-binutils-wrapper-2.46.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash","env":{"__structuredA