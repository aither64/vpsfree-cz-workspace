 patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://github.com/dgibson/dtc/commit/9a969f3b70b07bbf1c9df44a38d7f8d1d3a6e2a5.patch"]},"system":"x86_64-linux","version":4},"1mwlcdf3zpni1yvn3misbzgmj5v6fkjp-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh"],"builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","env":{"out":"/nix/store/54f75pjisgz20ql6azwmck1v779xs0a9-source"},"inputs":{"drvs":{"hqcarx3n5v7cylxly63lmd8fs601ia65-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"svra7wnq5jbh36a4p1myr1if3ss7qh2g-bash-5.3p15.drv":{"dynamicOutputs":{},"outputs":["out"]},"vhbs2wdxyq6abggm0qza7d62h16hdkj3-stdenv-linux-no-cc.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh","808pz59rm1qby6rnhg8jkgiwqjc1bl7a-mirrors-list","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh"]},"name":"source","outputs":{"out":{"hash":"sha256-pgd8g9Yfvp7abjCCKSmIn1smAROjqtfZaJkaUkBSKW0=","method":"nar"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","cmakeFlags":[],"configureFlags":[],"curlOpts":"","curlOptsList":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"downloadToTemp":true,"env":{"SSL_CERT_FILE":"/no-cert-file.crt"},"e