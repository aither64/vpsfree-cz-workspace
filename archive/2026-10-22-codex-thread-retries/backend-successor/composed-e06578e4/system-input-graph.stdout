bash-5.3p9/bin/bash\n\n\nexport PATH=\"$PATH\"\n\nsource /nix/store/mhxn5kwnri3z9hdzi3x0980id65p0icn-lib.sh\n\nsystemConfig='@out@'\n\nexport PATH=/empty\nfor i in /nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11 /nix/store/cqhgy07rpxdwk9kd2qlc3cw4s9ajzm9f-gnugrep-3.12 /nix/store/nl0wq6d4bpjrxmlax141liq0qr9z87gn-findutils-4.10.0 /nix/store/i2p2c4j7wn79jabnqgciff2i385gh5z4-getent-glibc-2.42-100 /nix/store/kgd806ssw99qaxwiislhfx5dwnc8k893-glibc-2.42-100-bin /nix/store/4i0fh2wxrp23043ml54bb0fd63ipc5cn-shadow-4.19.4 /nix/store/0bmapmnznzaxgx76jhzbznhlwq738g03-util-linux-2.42.3-bin; do\n    PATH=$PATH:$i/bin:$i/sbin\ndone\n\n_status=0\ntrap \"_status=1 _localstatus=\\$?\" ERR\n\n# Ensure a consistent umask.\numask 0022\n\n#### Activation script snippet binsh:\n_localstatus=0\n# Create the required /bin/sh symlink; otherwise lots of things\n# (notably the system() function) won't work.\nmkdir -p /bin\nchmod 0755 /bin\nln -sfn \"/nix/store/pwxj9ycwqd117yra6czifh3xfx5p88lh-bash-interactive-5.3p9/bin/sh\" /bin/.sh.tmp\nmv /bin/.sh.tmp /bin/sh # atomically replace /bin/sh\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"binsh\" \"$_localstatus\"\nfi\n\n#### Activation script snippet codexDeepseekProfile:\n_localstatus=0\nprofile=/home/aither/.codex/ds.config.toml\n\ninstall -d -m 0700 -o aither -g users /home/aither/.codex\nrm -f \"$profile\"\ninstall -m 0600 -o aither -g users /nix/store/ln3s81d331q70iw4f3vpijvrysr199pk-codex-ds.config.toml \"$profile\"\nrm -rf -- /var/lib/codex-deepseek-responses-proxy\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"codexDeepseekProfile\" \"$_localstatus\"\nfi\n\n#### Activation script snippet users:\n_localstatus=0\ninstall -m 0700 -d /root\ninstall -m 0755 -d /home\n\n/nix/store/g5yn47a3x9rbncggyi05m67h2paysrv7-perl-5.42.3-env/bin/perl \\\n-w /nix/store/dyx8qsmgnsz2csfzwn723gbd2jvp0j7g-update-users-groups.pl /nix/store/a2gks8ipz1rmpas0gvm4sd679nkhbyg0-users-groups.json\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"users\" \"$_localstatus\"\nfi\n\n#### Activation script snippet devWorkspaceCredentials:\n_localstatus=0\n/nix/store/4ngmjkanr42fc1by6cpjl7m3cvkgb9s0-workspace-portal-substrate-reconcile/bin/workspace-portal-substrate-reconcile\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"devWorkspaceCredentials\" \"$_localstatus\"\nfi\n\n#### Activation script snippet specialfs:\n_localstatus=0\nspecialMount() {\n  local device=\"$1\"\n  local mountPoint=\"$2\"\n  local options=\"$3\"\n  local fsType=\"$4\"\n\n  if mountpoint -q \"$mountPoint\"; then\n    local options=\"remount,$options\"\n  else\n    mkdir -p \"$mountPoint\"\n    chmod 0755 \"$mountPoint\"\n  fi\n  mount -t \"$fsType\" -o \"$options\" \"$device\" \"$mountPoint\"\n}\nsource /nix/store/br55jjkj5ldyq5w318sfz692rkcz6zry-mounts.sh\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"specialfs\" \"$_localstatus\"\nfi\n\n#### Activation script snippet etc:\n_localstatus=0\n# Set up the statically computed bits of /etc.\necho \"setting up /etc...\"\n/nix/store/9lrzpy4c3kbv01bf59c7cvf58z65mzs1-perl-5.42.3-env/bin/perl /nix/store/rg5rf512szdxmnj9qal3wfdnpfsx38qi-setup-etc.pl /nix/store/kzmnrs7q731d5wn9d1fxj2g56j268y10-etc/etc\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"etc\" \"$_localstatus\"\nfi\n\n#### Activation script snippet hashes:\n_localstatus=0\nusers=()\nwhile IFS=: read -r user hash _; do\n  if [[ \"$hash\" = \"$\"* && ! \"$hash\" =~ ^\\$(y|gy|sm3y|7|2b|2y|2a|6)\\$ ]]; then\n    users+=(\"$user\")\n  fi\ndone </etc/shadow\n\nif (( \"${#users[@]}\" )); then\n  echo \"\nWARNING: The following user accounts rely on password hashing algorithms\nthat have been removed. They need to be renewed as soon as possible, as\nthey do prevent their users from logging in.\"\n  printf ' - %s\\n' \"${users[@]}\"\nfi\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"hashes\" \"$_localstatus\"\nfi\n\n#### Activation script snippet modprobe:\n_localstatus=0\n# Allow the kernel to find our wrapped modprobe (which searches\n# in the right location in the Nix store for kernel modules).\n# We need this when the kernel (or some module) auto-loads a\n# module.\necho /nix/store/7hb639qc0cgc215kr10pgg6r3z0xrfk2-kmod-31/bin/modprobe > /proc/sys/kernel/modprobe\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"modprobe\" \"$_localstatus\"\nfi\n\n#### Activation script snippet nixStoreCleanupLauncher:\n_localstatus=0\nlauncher=/home/aither/bin/nix-store-cleanup\nif [ -f \"$launcher\" ] && [ ! -L \"$launcher\" ]; then\n  /nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/mv --backup=numbered -- \"$launcher\" \"$launcher.pre-declarative\"\nfi\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"nixStoreCleanupLauncher\" \"$_localstatus\"\nfi\n\n#### Activation script snippet udevd:\n_localstatus=0\n# The deprecated hotplug uevent helper is not used anymore\nif [ -e /proc/sys/kernel/hotplug ]; then\n  echo \"\" > /proc/sys/kernel/hotplug\nfi\n\n# Allow the kernel to find our firmware.\nif [ -e /sys/module/firmware_class/parameters/path ]; then\n  echo -n \"/nix/store/j2lp4qg2bz1m613j2yvyi7aqkixmy8my-firmware/lib/firmware\" > /sys/module/firmware_class/parameters/path\nfi\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"udevd\" \"$_localstatus\"\nfi\n\n#### Activation script snippet usrbinenv:\n_localstatus=0\nmkdir -p /usr/bin\nchmod 0755 /usr/bin\nln -sfn /nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/env /usr/bin/.env.tmp\nmv /usr/bin/.env.tmp /usr/bin/env # atomically replace /usr/bin/env\n\nif (( _localstatus > 0 )); then\n  printf \"Activation script snippet '%s' failed (%s)\\n\" \"usrbinenv\" \"$_localstatus\"\nfi\n\n# Make this configuration the current configuration.\n# The readlink is there to ensure that when $systemConfig = /system\n# (which is a symlink to the store), /run/current-system is still\n# used as a garbage collection root.\nln -sfn \"$(readlink -f \"$systemConfig\")\" /run/current-system\n\nexit $_status\n\n"},"inputs":{"drvs":{"0cbbn0lrf1qy5zv9lrvxdnybrqjs78jz-shadow-4.19.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"235q8xj5fy4smyynkb5w35jbkc5r0zdq-perl-5.42.3-env.drv":{"dynamicOutputs":{},"outputs":["out"]},"2rqjjnl3dj3s2l9mip1xfj3ka423gmkq-mounts.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"83mc379ifksrali2l45p8lj0hpv5f1qn-users-groups.json.drv":{"dynamicOutputs":{},"outputs":["out"]},"9b3c4gkqhc8q3blrraq5z7g014wd7fbg-getent-glibc-2.42-100.drv":{"dynamicOutputs":{},"outputs":["out"]},"b20jkyqkl2ii0qzjv4l7pm7d6j3dmz27-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"czdbvswd2xk2z0g51q4c9i4i6mmi1xd3-kmod-31.drv":{"dynamicOutputs":{},"outputs":["out"]},"d8d1ci2d25a2vmbzdfsxmv9sprvgqby2-firmware.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"i9mqpnsyzq1m1ngy4p53rk5rd8bhz9qv-gnugrep-3.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"iscp1sgln6664lz8fpkvf99gw11mqs3r-bash-interactive-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"k8mm8xc05mprnznf77rac3fhd67sc7nx-util-linux-2.42.3.drv":{"dynamicOutputs":{},"outputs":["bin"]},"kyznqw9ci7pgfiw8axhb0rf59k1cfa8w-etc.drv":{"dynamicOutputs":{},"outputs":["out"]},"p1csz0bl2pjkix69c89w1pcj58lxq3zi-glibc-2.42-100.drv":{"dynamicOutputs":{},"outputs":["bin"]},"qn8km1brvpslfzqd05l1idh6q40414r0-workspace-portal-substrate-reconcile