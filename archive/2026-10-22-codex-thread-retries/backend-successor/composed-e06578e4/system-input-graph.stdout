,"depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"/bin/br0-netdev-reload","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"unit-script-br0-netdev-reload","nativeBuildInputs":"","out":"/nix/store/fw0pn60016i5mk429gssngl149mj170i-unit-script-br0-netdev-reload","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash\nset -e\n\n# Un-enslave child interfaces (old list of interfaces)\nfor interface in `cat /run/br0.interfaces`; do\n  ip link set dev \"$interface\" nomaster up\ndone\n\n# Enslave child interfaces (new list of interfaces)\nip link set dev \"enp1s0\" master \"br0\"\nip link set dev \"enp1s0\" up\n\n# Save list of enslaved interfaces\necho \"enp1s0\n\" > /run/br0.interfaces\n\n# (Un-)set stp on the bridge\necho 0 > /sys/class/net/br0/bridge/stp_state\n\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-br0-netdev-reload","outputs":{"out":{"path":"fw0pn60016i5mk429gssngl149mj170i-unit-script-br0-netdev-reload"}},"system":"x86_64-linux","version":4},"h32256hl2fax9i25cklvjf07zr2fkqrj-sluice-0.5.5.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildCommand":"mkdir $out\ntar xf \"/nix/store/3hwm8m0m4ln