:"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash\nset -e\n\n# Remove Dead Interfaces\necho \"Removing old bridge br0...\"\nip link show dev \"br0\" >/dev/null 2>&1 && ip link del dev \"br0\"\n\necho \"Adding bridge br0...\"\nip link add name \"br0\" type bridge\n\n# Enslave child interfaces\nip link set dev \"enp1s0\" master \"br0\"\nip link set dev \"enp1s0\" up\n\n# Save list of enslaved interfaces\necho \"enp1s0\n\" > /run/br0.interfaces\n\n\n\n# Enable stp on the interface\n\n\nip link set dev \"br0\" up\n\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-br0-netdev-start","outputs":{"out":{"path":"bdk88db3w5yfw6hzs3n078fv0mdmf3jr-unit-script-br0-netdev-start"}},"system":"x86_64-linux","version":4},"lz0kkmp5nkrhyvymqqsmanbzwmkm1bwb-libffi-3.8.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","env":{"dev":"/nix/store/sv7pxhijbx78q5ppq0h2111bb8yai0p4-libffi-3.8.0-dev","info":"/nix/store/jxph0wxq1znkmbpip83f77038aqkqnzb-libffi-3.8.0-info","man":"/nix/store/04axz2jlhcwa3cz4mkl3hj6qpghhpgma-libffi-3.8.0-man","out":"/nix/store/pi2b23y3gv6zgcziwbgnihf8gam1cmlp-libffi-3.8.0"},"inputs":{"drvs":{"109gn1ryh0xvy67zcxjrbk7vm6h8jjfl-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"3s1jjcrfspmxajvpi106fb30wgkfc1zc-dejagnu-1.6.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"