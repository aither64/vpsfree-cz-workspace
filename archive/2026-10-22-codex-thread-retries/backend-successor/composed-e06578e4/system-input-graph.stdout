":4},"m3j3rbkpqwh9a165qd0f8n3pcbhliry6-pythoncheck.sh.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","env":{"NIX_MAIN_PROGRAM":"pythoncheck.sh","__structuredAttrs":"","allowSubstitutes":"","buildCommand":"# On darwin a script cannot be used as an interpreter in a shebang but\n# there doesn't seem to be a limit to the size of shebang and multiple\n# arguments to the interpreter are allowed.\nif [[ -n \"\" ]] && isScript $interpreter\nthen\n  wrapperInterpreterLine=$(head -1 \"$interpreter\" | tail -c+3)\n  # Get first word from the line (note: xargs echo remove leading spaces)\n  wrapperInterpreter=$(echo \"$wrapperInterpreterLine\" | xargs echo | cut -d \" \" -f1)\n\n  if isScript $wrapperInterpreter\n  then\n    echo \"error: passed interpreter ($interpreter) is a script which has another script ($wrapperInterpreter) as an interpreter, which is not supported.\"\n    exit 1\n  fi\n\n  # This should work as long as wrapperInterpreter is a shell, which is\n  # the case for programs wrapped with makeWrapper, like\n  # python3.withPackages etc.\n  interpreterLine=\"$wrapperInterpreterLine $interpreter\"\nelse\n  interpreterLine=$interpreter\nfi\n\necho \"#! $interpreterLine\" > $out\ncat \"$contentPath\" >> $out\n\nchmod +x $out\n\n# Relocate executable\n# Wrap it if makeWrapperArgs are specified\nmv $out tmp\n  mkdir -p $out/$(dirname \"/bin/pythoncheck.sh\")\n  mv tmp $out//bin/pythoncheck.sh\nif [ -n \"${makeWrapperArgs+${makeWrapperArgs[@]}}\" ]; then\n    wrapProgram $out//bin/pythoncheck.sh ${makeWrapperArgs[@]}\nfi\n","buildInputs":"","builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","cmakeFlags":"","configureFlags":"","content":"exec /nix/store/i79m3cjpslr7ghhkj1w1wi2xc3ghqf63-python3.14-flake8-7.3.0/bin/flake8 --show-source --ignore E501 \"$1\"\n","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","interpreter":"/nix/store/lxa1kx2xkr5gz4ckrm3i0p7v943aydkk-dash-0.5.13.5/bin/dash","makeWrapperArgs":"","mesonFlags":"","name":"pythoncheck.sh","nativeBuildInputs":"/nix/store/aajj151ynws8hj2ajkvhv38b2c8sjyw5-make-binary-wrapper-hook","out":"/nix/store/4r8jv082h4kbx4i9mcfravr413iik7d4-pythoncheck.sh","outputs":"out","passAsFile":"buildCommand content","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/xai718x2gpf0kf73zwhhv50likh5c18l-stdenv-linux-no-cc","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"5mq26m7f6ii3iy1zsjn530y4jrlp9bl9-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"dkr014s4xzxwkiidx22knl3c5ys8cscf-python3.14-flake8-7.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"flyyc82vzx7rxzlqigbrqi502x8x82qc-dash-0.5.13.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"svra7wnq5jbh36a4p1myr1if3ss7qh2g-bash-5.3p15.drv":{"dynamicOutputs":{},"outputs":["out"]},"vhbs2wdxyq6abggm0qza7d62h16hdkj3-stdenv-linux-no-cc.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"pythoncheck.sh","outputs":{"out":{"path":"4r8jv082h4kbx4i9mcfravr413iik7d4-pythoncheck.sh"}},"system":"x86_64-linux","version":4},"m3sg7zn72g81r5sziav259s8h2ilwmry-mandown-1.1.0-vendor.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildCommand":"fetch-cargo-vendor-util create-vendo