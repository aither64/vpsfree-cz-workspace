n\n\nCONFIG_STATIC y\n\n\n\n\n# Use the external mount.cifs program.\nCONFIG_FEATURE_MOUNT_CIFS n\nCONFIG_FEATURE_MOUNT_HELPERS y\n\n# Set paths for console fonts.\nCONFIG_DEFAULT_SETFONT_DIR \"/etc/kbd\"\n\n# Bump from 4KB, much faster I/O\nCONFIG_FEATURE_COPYBUF_KB 64\n\n# Doesn't build with current kernel headers.\n# https://bugs.busybox.net/show_bug.cgi?id=15934\nCONFIG_TC n\n\n# Set the path for the udhcpc script\nCONFIG_UDHCPC_DEFAULT_SCRIPT \"$out/default.script\"\n\nCONFIG_FEATURE_FANCY_ECHO y\nCONFIG_FEATURE_SH_MATH y\nCONFIG_FEATURE_SH_MATH_64 y\nCONFIG_FEATURE_TEST_64 y\n\nCONFIG_ASH y\nCONFIG_ASH_OPTIMIZE_FOR_SIZE y\n\nCONFIG_ASH_ALIAS y\nCONFIG_ASH_BASH_COMPAT y\nCONFIG_ASH_CMDCMD y\nCONFIG_ASH_ECHO y\nCONFIG_ASH_GETOPTS y\nCONFIG_ASH_INTERNAL_GLOB y\nCONFIG_ASH_JOB_CONTROL y\nCONFIG_ASH_PRINTF y\nCONFIG_ASH_TEST y\n\nCONFIG_CROSS_COMPILER_PREFIX \"\"\nCONFIG_FEATURE_UTMP n\nCONFIG_FEATURE_WTMP n\n\nEOF\n\nmake oldconfig\n\nrunHook postConfigure\n","debug":"/nix/store/fnzsqarsvks7rlaf3qyb6h2ycj6kxx1q-busybox-1.37.0-debug","depsBuildBuild":"/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"format fortify","makeFlags":"SKIP_STRIP=y","mesonFlags":"","name":"busybox-1.37.0","nativeBuildInputs":"/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/fl6zyj3yfpa973icc6ca3zbm55izmm9r-busybox-1.37.0","outputs":"out debug","patches":"/nix/store/7wpjbl21q85z0vrqdx4c7lxg6n4rgwh7-busybox-in-store.patch /nix/store/ix0srl7w9s21y5bnpp4q8gmg7jwvjynd-fix-aarch64-sha1.patch /nix/store/221bb8kxaxp50dprlgw4m9qll0x3djd4-CVE-2023-39810.patch /nix/store/7kidyfd8x0fn46y1610yqknjbh5rffib-CVE-2026-26157_CVE-2026-2615