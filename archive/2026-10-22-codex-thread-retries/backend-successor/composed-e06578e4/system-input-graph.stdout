true;\\n  };\\n  local-matrix = {\\n    Homeserver = \\\"https://matrix.org\\\";\\n    ListenAddress = \\\"127.0.0.1\\\";\\n    ListenPort = 8008;\\n  };\\n}\\n\"},\"loc\":[\"services\",\"pantalaimon\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"services.parcellite.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/parcellite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/parcellite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Parcellite.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"parcellite\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.parcellite.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/parcellite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/parcellite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Command line arguments passed to Parcellite.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--no-icon\\\"\\n]\"},\"loc\":[\"services\",\"parcellite\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.parcellite.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/parcellite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/parcellite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.parcellite\"},\"description\":\"The parcellite package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.clipit\"},\"loc\":[\"services\",\"parcellite\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.pass-secret-service.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pas