anager/modules/programs/darcs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/darcs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"File patterns to ignore\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"^.idea$\\\"\\n  \\\".iml$\\\"\\n  \\\"^.stack-work$\\\"\\n]\"},\"loc\":[\"programs\",\"darcs\",\"boring\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.darcs.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/darcs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/darcs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable darcs.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"darcs\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.darcs.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/darcs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/darcs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.darcs\"},\"description\":\"The darcs package to use.\",\"loc\":[\"programs\",\"darcs\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.dbeaver.dataSourcesSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dbeaver.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dbeaver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for DBeaver's `data-sources.json`. This file stores\\ndatabase connection definitions and is located at\\n`General/.dbeaver/data-sources.json` in the DBeaver workspace.\\n\\nSee the\\n[DBeaver documentation](https://dbeaver.com/docs/dbeaver/Admin-Manage-Connections/)\\nfor available connection options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  connections = {\\n    postgresql-local = {\\n      configuration = {\\n        database = \\\"mydb\\\";\\n        host = \\\"localhost\\\";\\n        port = \\\"5432\\\";\\n      };\\n      driver = \\\"postgres-jdbc\\\";\\n      name = \\\"Local PostgreSQL\\\";\\n      provider = \\\"postgresql\\\";\\n      save-password = false;\\n    };\\n  };\\n  folders = { };\\n}\"},\"loc\":[\"programs\",\"dbeaver\",\"dataSourcesSettings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.dbeaver.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dbeaver.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dbeaver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable DBeaver, a universal database management tool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"dbeaver\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.dbeaver.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dbeaver.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dbeaver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.dbeaver-bin\"},\"description\":\"The dbeaver-bin package to use.\",\"loc\":[\"programs\",\"dbeaver\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.dbeaver.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dbeaver.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dbeaver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"DBeaver workspace preferences. Each attribute set key corresponds to\\na preferences file name (without the `.prefs` extension) under\\n`General/.settings/` in the DBeaver workspace. Each value is a set\\nof key-value preference entries.\\n\\nFiles are generated with an `eclipse.preferences.version=1` header\\nas required by the Eclipse platform.\\n\\nCommon plugin IDs include `org.jkiss.dbeaver.core`,\\n`org.jkiss.dbeaver.model`, and `org.jkiss.dbeaver.ui`.\\n\\nFor examples:\\nhttps://dbeaver.com/docs/dbeaver/Admin-Manage-Preferences/\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"org.jkiss.dbeaver.core\\\" = {\\n    \\\"ui.showSystemObjects\\\" = \\\"false\\\";\\n    \\\"ui.showUtilityObjects\\\" = \\\"false\\\";\\n  };\\n  \\\"org.jkiss.dbeaver.model\\\" = {\\n    \\\"read.expiration.period\\\" = \\\"10000\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"dbeaver\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of string\"},\"programs.delta.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/delta.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/delta.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable delta, a syntax highlighter for git diffs.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"delta\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.delta.enableGitIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/delta.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/delta.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable git integration for delta.\\n\\nWhen enabled, delta will be configured as git's pager for\\n{command}`blame`, {command}`diff`, {command}`log`, and {command}`show`,\\nand as git's diff filter for interactive staging.\\n\",\"loc\":[\"programs\",\"delta\",\"enableGitIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.delta.enableJujutsuIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/delta.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/delta.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable jujutsu integration for delta.\\n\\nWhen enabled, delta will be configured as jujutsus's pager, diff filter, and merge tool.\\n\",\"loc\":[\"programs\",\"delta\",\"enableJujutsuIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.delta.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/delta.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/delta.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options to configure delta.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  decorations = {\\n    commit-decoration-style = \\\"bold yellow box ul\\\";\\n    file-decoration-style = \\\"none\\\";\\n    file-style = \\\"bold yellow ul\\\";\\n  };\\n  features = \\\"decorations\\\";\\n  whitespace-error-style = \\\"22 reverse\\\";\\n}\"},\"loc\":[\"programs\",\"delta\",\"options\"],\"readOnly\":false,\"type\":\"attribute set of (string or boolean or signed integer or attribute set of (string or boolean or signed integer))\"},\"programs.delta.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/delta.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/delta.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.delta\"},\"description\":\"The delta package to use.\",\"loc\":[\"programs\",\"delta\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.desktoppr.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/desktoppr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/desktoppr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable managing the desktop picture/wallpaper on macOS using desktoppr.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"desktoppr\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.desktoppr.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/desktoppr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/desktoppr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.desktoppr\"},\"description\":\"The desktoppr package to use.\",\"loc\":[\"programs\",\"desktoppr\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.desktoppr.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/desktoppr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/desktoppr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The settings to set for desktoppr.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  picture = \\\"/System/Library/Desktop Pictures/Solid Colors/Stone.png\\\";\\n}\"},\"loc\":[\"programs\",\"desktoppr\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of anything\"},\"programs.desktoppr.settings.color\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/desktoppr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/desktoppr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"000000\\\"\"},\"description\":\"The background color that will be used behind the chosen picture when\\nit does not fill the screen.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"2E2E2E\\\"\"},\"loc\":[\"programs\",\"desktoppr\",\"settings\",\"color\"],\"readOnly\":false,\"type\":\"string matching the pattern [0-9a-fA-F]{6}\"},\"programs.desktoppr.settings.picture\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/desktoppr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/desktoppr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The path to the desktop picture/wallpaper to set. Can also be an HTTP\\nor HTTPS URL to retrieve the picture from a remote URL at runtime.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/System/Library/Desktop Pictures/Solid Colors/Stone.png\\\"\"},\"loc\":[\"programs\",\"desktoppr\",\"settings\",\"picture\"],\"readOnly\":false,\"type\":\"null or absolute path or string matching the pattern ^http(s)?://.*$\"},\"programs.desktoppr.settings.scale\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/desktoppr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/desktoppr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fill\\\"\"},\"description\":\"The scaling behavior to use when using an image.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fit\\\"\"},\"loc\":[\"programs\",\"desktoppr\",\"settings\",\"scale\"],\"readOnly\":false,\"type\":\"one of \\\"fill\\\", \\\"stretch\\\", \\\"center\\\", \\\"fit\\\"\"},\"programs.desktoppr.settings.setOnlyOnce\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/desktoppr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/desktoppr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If false (the default), the desktop picture/wallpaper will be reset\\nto the configured parameters on every system configuration change.\\n\\nIf true, the desktop picture/wallpaper will only be set when it\\ndiffers from the one previously set. This allows the user to manually\\nchange the desktop picture/wallpaper after it has been set.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"desktoppr\",\"settings\",\"setOnlyOnce\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.desktoppr.settings.sha256\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/desktoppr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/desktoppr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"An optional SHA256 checksum of the desktop picture/wallpaper. If the\\nspecified file does not match the checksum, it will not be set.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"e1e594dec9343b721005a6bf06c48e0aac34ac9a77090e42b543bae9e1e0354a\\\"\"},\"loc\":[\"programs\",\"desktoppr\",\"settings\",\"sha256\"],\"readOnly\":false,\"type\":\"null or string matching the pattern ^[a-f0-9]{64}$\"},\"programs.diff-highlight.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/diff-highlight.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/diff-highlight.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Enable the contrib {command}`diff-highlight` syntax highlighter.\\nSee <https://github.com/git/git/blob/master/contrib/diff-highlight/README>,\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"diff-highlight\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.diff-highlight.enableGitIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/diff-highlight.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/diff-highlight.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable git integration for diff-highlight.\\n\\nWhen enabled, diff-highlight will be configured as git's pager for\\n{command}`diff`, {command}`log`, and {command}`show`, and as git's diff\\nfilter for interactive staging.\\n\",\"loc\":[\"programs\",\"diff-highlight\",\"enableGitIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.diff-highlight.pagerOpts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/diff-highlight.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/diff-highlight.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Arguments to be passed to {command}`less`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--tabs=4\\\"\\n  \\\"-RFX\\\"\\n]\"},\"loc\":[\"programs\",\"diff-highlight\",\"pagerOpts\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.diff-so-fancy.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/diff-so-fancy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/diff-so-fancy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable diff-so-fancy, a diff colorizer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"diff-so-fancy\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.diff-so-fancy.enableGitIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/diff-so-fancy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/diff-so-fancy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable git integration for diff-so-fancy.\\n\\nWhen enabled, diff-so-fancy will be configured as git's pager for\\n{command}`diff`, {command}`log`, and {command}`show`, and as git's diff\\nfilter for interactive staging.\\n\",\"loc\":[\"programs\",\"diff-so-fancy\",\"enableGitIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.diff-so-fancy.pagerOpts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/diff-so-fancy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/diff-so-fancy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--tabs=4\\\"\\n  \\\"-RFX\\\"\\n]\"},\"description\":\"Arguments to be passed to {command}`less`.\\n\",\"loc\":[\"programs\",\"diff-so-fancy\",\"pagerOpts\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.diff-so-fancy.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/diff-so-fancy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/diff-so-fancy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options to configure diff-so-fancy. See\\n<https://github.com/so-fancy/diff-so-fancy#configuration> for available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  changeHunkIndicators = true;\\n  markEmptyLines = true;\\n  rulerWidth = 80;\\n  stripLeadingSymbols = true;\\n  useUnicodeRuler = true;\\n}\"},\"loc\":[\"programs\",\"diff-so-fancy\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (string or boolean or signed integer)\"},\"programs.difftastic.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/difftastic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/difftastic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable difftastic, a structural diff tool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"difftastic\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.difftastic.git.diffToolMode\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/difftastic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/difftastic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to additionally configure difftastic as a git difftool.\\n\\nWhen `false`, only `diff.external` is set (used for `git diff`).\\nWhen `true`, both `diff.external` and difftool config are set (supporting both `git diff` and `git difftool`).\\n\",\"loc\":[\"programs\",\"difftastic\",\"git\",\"diffToolMode\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.difftastic.git.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/difftastic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/difftastic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable git integration for difftastic.\\n\\nWhen enabled, difftastic will be configured as git's external diff tool or difftool\\ndepending on the value of {option}`programs.difftastic.git.diffToolMode`.\\n\",\"loc\":[\"programs\",\"difftastic\",\"git\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.difftastic.jujutsu.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/difftastic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/difftastic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable jujutsu integration for difftastic.\\n\",\"loc\":[\"programs\",\"difftastic\",\"jujutsu\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.difftastic.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/difftastic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/difftastic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration options for {command}`difftastic`. See {command}`difft --help`\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  color = \\\"dark\\\";\\n  sort-paths = true;\\n  tab-width = 8;\\n}\"},\"loc\":[\"programs\",\"difftastic\",\"options\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean or list of (string or signed integer or boolean))\"},\"programs.difftastic.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/difftastic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/difftastic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.difftastic\"},\"description\":\"The difftastic package to use.\",\"loc\":[\"programs\",\"difftastic\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.dircolors.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dircolors.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dircolors.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to manage {file}`.dir_colors`\\nand set `LS_COLORS`.\\n\",\"loc\":[\"programs\",\"dircolors\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.dircolors.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dircolors.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dircolors.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"dircolors\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.dircolors.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dircolors.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dircolors.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"dircolors\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.dircolors.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dircolors.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dircolors.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"dircolors\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.dircolors.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dircolors.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dircolors.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"dircolors\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.dircolors.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dircolors.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dircolors.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra lines added to {file}`.dir_colors` file.\\n\",\"loc\":[\"programs\",\"dircolors\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.dircolors.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/dircolors.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/dircolo