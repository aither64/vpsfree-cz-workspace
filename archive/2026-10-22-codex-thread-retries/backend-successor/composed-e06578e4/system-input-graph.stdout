c0qc42xdhks16ziv-wrap-python-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"v6d1zsp3i33dj483qv4ryzrkfhf1gyp8-python3-3.13.15.drv":{"dynamicOutputs":{},"outputs":["out"]},"wy0avgwlpi89v6z6zjn7ld90gpyc9wng-python-catch-conflicts-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"ywrglhyn3irzkblr1fbw9y30r5asjwxf-python-imports-check-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"python3.13-toposort-1.10","outputs":{"dist":{"path":"cmq3s5qq3qa9bjh6j3adp1m188x1pbs4-python3.13-toposort-1.10-dist"},"out":{"path":"r18rcqy32higndlnl3xgvmvjcidjcz7j-python3.13-toposort-1.10"}},"system":"x86_64-linux","version":4},"qm9gnl305mym26pvzy6j75lywygkv75p-user-units.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"mkdir -p $out\n\n# Copy the upstream systemd units we're interested in.\nfor i in app.slice background.slice basic.target bluetooth.target capsule@.target default.target exit.target graphical-session-pre.target graphical-session.target paths.target printer.target session.slice shutdown.target smartcard.target sockets.target sound.target systemd-exit.service timers.target xdg-desktop-autostart.target systemd-tmpfiles-clean.service systemd-tmpfiles-clean.timer systemd-tmpfiles-setup.service; do\n  fn=/nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/example/systemd/user/$i\n  if ! [ -e $fn ]; then echo \"missing $fn\"; false; fi\n  if [ -L $fn ]; then\n    target=\"$(readlink \"$fn\")\"\n    if [ ${target:0:3} = ../ ]; then\n      ln -s \"$(readlink -f \"$fn\")\" $out/\n    else\n      cp -pd $fn $out/\n    fi\n  else\n    ln -s $fn $out/\n  fi\ndone\n\n# Copy .wants links, but only those that point to units that\n# we're interested in.\nfor i in ; do\n  fn=/nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/example/systemd/user/$i\n  if ! [ -e $fn ]; then echo \"missing $fn\"; false; fi\n  x=$out/$(basename $fn)\n  mkdir $x\n  for i in $fn/*; do\n    y=$x/$(basename $i)\n    cp -pd $i $y\n    if ! [ -e $y ]; then rm $y; fi\n  done\ndone\n\n# Symlink all units provided listed in systemd.packages.\npackages=\"/nix/store/3cgzffw8krnknnhnvz0b0fic9l9210zv-podman-5.8.8 /nix/store/mvkx9892k6jj608im4kijqfcwq99s923-lvm2-2.03.39 /nix/store/5np0yidzrnyjbb243hvgqpgpss865p0n-nix-2.34.9 /nix/store/2hc6lqclam28wdnjgd8gjdmw168mlf1a-dbus-1.16.2 /nix/store/yly12cgk8diwbba5pjdr7g0b3hk8db0c-dbus-broker-37 /nix/store/0bmapmnznzaxgx76jhzbznhlwq738g03-util-linux-2.42.3-bin /nix/store/fvxwz94g9mnjmsnx9hpj24r9jng5znzl-util-linux-2.42.3-lastlog\"\n\n# Filter duplicate directories\ndeclare -A unique_packages\nfor k in $packages ; do unique_packages[$k]=1 ; done\n\nfor i in ${!unique_packages[@]}; do\n  for fn in $i/etc/systemd/user/* $i/lib/systemd/user/*; do\n    if ! [[ \"$fn\" =~ .wants$ ]]; then\n      if [[ -d \"$fn\" ]]; then\n        targetDir=\"$out/$(basename \"$fn\")\"\n        mkdir -p \"$targetDir\"\n        /nix/store/smriw9hf43mvqp4v7nrn4d0wgny9yvk0-lndir-1.0.5/bin/lndir \"$fn\" \"$targetDir\"\n      else\n        ln -s $fn $out/\n      fi\n    fi\n  done\ndone\n\n# Symlink units defined by systemd.units where override strategy\n# shall be automatically detected. If these are also provided by\n# systemd or systemd.packages, then add them as\n# <unit-name>.d/overrides.conf, which makes them extend the\n# upstream unit.\nfor i in /nix/store/09sycac8rll73wx6il6w8n47b27r3ngp-unit-dbus-broker.service /nix/store/36g710y8k216icbapl8b0gn6clwsc1s1-unit-dbus.service /nix/store/fiz75wibqx1pkzcy3cf6s3lssl1nczi5-unit-dbus.socket /nix/store/c9n0kza43k0rg5vlsy0dy1ip2yyja9wg-unit-nixos-activation.service /nix/store/vzqvrz3nnwm2ysn9ka4qbdx9fcnhy9y5-unit-nixos-fake-graphical-session.target /nix/store/rmkcjarddbqfbf29v1qrxd1zv3f5s2q2-unit-podman.service /nix/store/rr8jwfmk7ffn9wqqjvkicy50d509281b-unit-podman.socket /nix/store/f52kv12y7n0svqcqyvak9rpbdmjl7jj6-unit-systemd-tmpfiles-clean.timer /nix/store/aq444q21lwlqh8a833xaryfmv3s0gzmz-unit-systemd-tmpfiles-setup.service; do\n  fn=$(basename $i/*)\n  if [ -e $out/$fn ]; then\n    if [ \"$(readlink -f $i/$fn)\" = /dev/null ]; then\n      ln -sfn /dev/null $out/$fn\n    else\n      mkdir -p $out/$fn.d\nln -s $i/$fn $out/$fn.d/overrides.conf\n\n    fi\n else\n    ln -fs $i/$fn $out/\n  fi\ndone\n\n# Symlink units defined by systemd.units which shall be\n# treated as drop-in file.\nfor i in ; do\n  fn=$(basename $i/*)\n  mkdir -p $out/$fn.d\n  ln -s $i/$fn $out/$fn.d/overrides.conf\ndone\n\n# Create service aliases from aliases option.\nln -sfn 'dbus-broker.service' $out/'dbus.service'\n\n\n# Create .wants, .upholds and .requires symlinks from the wantedBy, upheldBy and\n# requiredBy options.\nmkdir -p $out/'sockets.target.wants'\nln -sfn '../dbus.socket' $out/'sockets.target.wants'/\nmkdir -p $out/'default.target.wants'\nln -sfn '../nixos-activation.service' $out/'default.target.wants'/\nmkdir -p $out/'sockets.target.wants'\nln -sfn '../podman.socket' $out/'sockets.target.wants'/\nmkdir -p $out/'timers.target.wants'\nln -sfn '../systemd-tmpfiles-clean.timer' $out/'timers.target.wants'/\nmkdir -p $out/'basic.target.wants'\nln -sfn '../systemd-tmpfiles-setup.service' $out/'basic.target.wants'/\n\n\n\n\n\n\n\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"user-units","nativeBuil