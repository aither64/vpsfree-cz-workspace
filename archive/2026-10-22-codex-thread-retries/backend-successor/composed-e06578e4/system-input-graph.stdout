lob/release-26.05/modules/programs/jujutsu.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options to add to the {file}`config.toml` file. See\\n<https://github.com/martinvonz/jj/blob/main/docs/config.md>\\nfor options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  user = {\\n    email = \\\"jdoe@example.org\\\";\\n    name = \\\"John Doe\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"jujutsu\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.k9s.aliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/k9s.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/k9s.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Aliases written to {file}`$XDG_CONFIG_HOME/k9s/aliases.yaml` (linux)\\nor {file}`Library/Application Support/k9s/aliases.yaml` (darwin). See\\n<https://k9scli.io/topics/aliases/> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  # Use pp as an alias for Pod\\n  pp = \\\"v1/pods\\\";\\n}\\n\"},\"loc\":[\"programs\",\"k9s\",\"aliases\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.k9s.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/k9s.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/k9s.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable k9s - Kubernetes CLI To Manage Your Clusters In Style.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"k9s\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.k9s.hotKeys\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/k9s.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/k9s.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Hotkeys written to {file}`$XDG_CONFIG_HOME/k9s/hotkeys.yaml` (linux)\\nor {file}`Library/Application Support/k9s/hotkeys.yaml` (darwin). See\\n<https://k9scli.io/topics/hotkeys/> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  shift-0 = {\\n    command = \\\"pods\\\";\\n    description = \\\"Viewing pods\\\";\\n    shortCut = \\\"Shift-0\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"k9s\",\"hotKeys\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.k9s.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/k9s.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/k9s.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.k9s\"},\"description\":\"The k9s package to use.\",\"loc\":[\"programs\",\"k9s\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.k9s.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/k9s.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/k9s.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Plugins written to {file}`$XDG_CONFIG_HOME/k9s/plugins.yaml (linux)`\\nor {file}`Library/Application Support/k9s/plugins.yaml` (darwin). See\\n<https://k9scli.io/topics/plugins/> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  # Defines a plugin to provide a `ctrl-l` shortcut to\\n  # tail the logs while in pod view.\\n  fred = {\\n    shortCut = \\\"Ctrl-L\\\";\\n    description = \\\"Pod logs\\\";\\n    scopes = [ \\\"po\\\" ];\\n    command = \\\"kubectl\\\";\\n    background = false;\\n    args = [\\n      \\\"logs\\\"\\n      \\\"-f\\\"\\n      \\\"$NAME\\\"\\n      \\\"-n\\\"\\n      \\\"$NAMESPACE\\\"\\n      \\\"--context\\\"\\n      \\\"$CLUSTER\\\"\\n    ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"k9s\",\"plugins\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.k9s.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/k9s.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/k9s.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/k9s/config.yaml` (linux)\\nor {file}`Library/Application Support/k9s/config.yaml` (darwin), See\\n<https://k9scli.io/topics/config/> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"k9s = {\\n  refreshRate = 2;\\n};\\n\"},\"loc\":[\"programs\",\"k9s\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.k9s.skins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/k9s.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/k9s.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Skin files written to {file}`$XDG_CONFIG_HOME/k9s/skins/` (linux)\\nor {file}`Library/Application Support/k9s/skins/` (darwin). See\\n<https://k9scli.io/topics/skins/> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  my_blue_skin = {\\n    k9s = {\\n      body = {\\n        fgColor = \\\"dodgerblue\\\";\\n      };\\n    };\\n  };\\n  my_red_skin = ./red_skin.yaml;\\n}\\n\"},\"loc\":[\"programs\",\"k9s\",\"skins\"],\"readOnly\":false,\"type\":\"attribute set of (YAML 1.1 value or absolute path)\"},\"programs.k9s.views\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/k9s.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/k9s.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Resource column views written to\\n{file}`$XDG_CONFIG_HOME/k9s/views.yaml (linux)`\\nor {file}`Library/Application Support/k9s/views.yaml` (darwin).\\nSee <https://k9scli.io/topics/columns/> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"v1/pods\\\" = {\\n    columns = [\\n      \\\"AGE\\\"\\n      \\\"NAMESPACE\\\"\\n      \\\"NAME\\\"\\n      \\\"IP\\\"\\n      \\\"NODE\\\"\\n      \\\"STATUS\\\"\\n      \\\"READY\\\"\\n    ];\\n  };\\n}\"},\"loc\":[\"programs\",\"k9s\",\"views\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.kakoune.colorSchemePackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kakoune.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kakoune.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A kakoune color schemes to add to your colors folder. This works\\nbecause kakoune recursively checks\\n{file}`$XDG_CONFIG_HOME/kak/colors/`. To apply the color scheme use\\n`programs.kakoune.config.colorScheme = \\\"theme\\\"`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.kakounePlugins.kakoune-catppuccin\"},\"loc\":[\"programs\",\"kakoune\",\"colorSchemePackage\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.kakoune.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kakoune.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kakoune.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"kakoune configuration options.\",\"loc\":[\"programs\",\"kakoune\",\"config\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"programs.kakoune.config.alignWithTabs\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kakoune.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kakoune.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Use tabs for the align command.\\n\",\"loc\":[\"programs\",\"kakoune\",\"config\",\"alignWithTabs\"],\"readOnly\":false,\"type\":\"boole