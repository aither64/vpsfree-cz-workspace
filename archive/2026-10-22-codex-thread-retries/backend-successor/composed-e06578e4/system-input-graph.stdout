",\"accounts\",\"<name>\",\"jmap\",\"host\"],\"readOnly\":false,\"type\":\"null or string\"},\"accounts.email.accounts.<name>.jmap.sessionUrl\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"URL for the JMAP Session resource.\\n\\nIf both this option and [](#opt-accounts.email.accounts._name_.jmap.host) are specified,\\n`host` is preferred by applications when establishing a\\nsession.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"https://jmap.example.org:443/.well-known/jmap\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"jmap\",\"sessionUrl\"],\"readOnly\":false,\"type\":\"null or string\"},\"accounts.email.accounts.<name>.lieer.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable lieer Gmail synchronization for notmuch.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.lieer.notmuchSetupWarning\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Warn if Notmuch is not also enabled for this account.\\n\\nThis can safely be disabled if {command}`notmuch init`\\nhas been used to configure this account outside of Home\\nManager.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"notmuchSetupWarning\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.lieer.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings which are applied to {file}`.gmailieer.json`\\nfor the account.\\n\\nSee the [lieer manual](https://github.com/gauteh/lieer/)\\nfor documentation of settings not explicitly covered by this module.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (JSON value)\"},\"accounts.email.accounts.<name>.lieer.settings.drop_non_existing_label\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Allow missing labels on the Gmail side to be dropped.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"settings\",\"drop_non_existing_label\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.lieer.settings.file_extension\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extension to include in local file names, which can be useful\\nfor indexing with third-party programs.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"mbox\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"settings\",\"file_extension\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.lieer.settings.ignore_empty_history\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Work around a Gmail API quirk where an empty change history\\nis sometimes returned.\\n\\nSee this\\n[GitHub issue](https://github.com/gauteh/lieer/issues/120)\\nfor more details.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"settings\",\"ignore_empty_history\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.lieer.settings.ignore_remote_labels\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"CATEGORY_FORUMS\\\"\\n  \\\"CATEGORY_PROMOTIONS\\\"\\n  \\\"CATEGORY_UPDATES\\\"\\n  \\\"CATEGORY_SOCIAL\\\"\\n  \\\"CATEGORY_PERSONAL\\\"\\n]\"},\"description\":\"Set Gmail labels to ignore when syncing from remote labels to\\nlocal tags (before translations).\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"settings\",\"ignore_remote_labels\"],\"readOnly\":false,\"type\":\"list of string\"},\"accounts.email.accounts.<name>.lieer.settings.ignore_tags\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Set labels to ignore when syncing from local tags to\\nremote labels (after translations).\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"settings\",\"ignore_tags\"],\"readOnly\":false,\"type\":\"list of string\"},\"accounts.email.accounts.<name>.lieer.settings.local_trash_tag\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"trash\\\"\"},\"description\":\"Local tag to which the remote Gmail 'TRASH' label is translated.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"settings\",\"local_trash_tag\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.lieer.settings.remove_local_messages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Remove local messages that have been deleted on the remote.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"settings\",\"remove_local_messages\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.lieer.settings.replace_slash_with_dot\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Replace '/' with '.' in Gmail labels.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"settings\",\"replace_slash_with_dot\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.lieer.settings.timeout\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"600\"},\"description\":\"HTTP timeout in seconds. 0 means forever or system timeout.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"settings\",\"timeout\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"accounts.email.accounts.<name>.lieer.sync.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable lieer synchronization service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"sync\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.lieer.sync.frequency\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"*:0/5\\\"\"},\"description\":\"How often to synchronize the account.\\n\\nThis value is passed to the systemd timer configuration as the\\nonCalendar option. See\\n{manpage}`systemd.time(7)`\\nfor more information about the format.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"lieer\",\"sync\",\"frequency\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.maildir\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  path = \\\"\\\\${name}\\\";\\n}\"},\"description\":\"Maildir configuration for this account.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"maildir\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"accounts.email.accounts.<name>.maildir.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"description\":\"Path to maildir directory where mail for this account is\\nstored. This is relative to the base maildir path.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"maildir\",\"path\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.mbsync.create\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"none\\\"\"},\"description\":\"Automatically create missing mailboxes within the\\ngiven mail store.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"maildir\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"create\"],\"readOnly\":false,\"type\":\"one of \\\"none\\\", \\\"maildir\\\", \\\"imap\\\", \\\"both\\\"\"},\"accounts.email.accounts.<name>.mbsync.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable synchronization using mbsync.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.mbsync.expunge\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"none\\\"\"},\"description\":\"Permanently remove messages marked for deletion from\\nthe given mail store.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"both\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"expunge\"],\"readOnly\":false,\"type\":\"one of \\\"none\\\", \\\"maildir\\\", \\\"imap\\\", \\\"both\\\"\"},\"accounts.email.accounts.<name>.mbsync.extraConfig.account\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Account section extra configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  TLSType = \\\"IMAP\\\";\\n  TLSVersions = [ \\\"+1.3\\\" \\\"+1.2\\\" \\\"-1.1\\\" ];\\n  PipelineDepth = 10;\\n  Timeout = 60;\\n};\\n\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"extraConfig\",\"account\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean or list of string)\"},\"accounts.email.accounts.<name>.mbsync.extraConfig.channel\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Per channel extra configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  MaxMessages = 10000;\\n  MaxSize = \\\"1m\\\";\\n};\\n\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"extraConfig\",\"channel\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean or list of string)\"},\"accounts.email.accounts.<name>.mbsync.extraConfig.local\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Local store extra configuration.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"extraConfig\",\"local\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean or list of string)\"},\"accounts.email.accounts.<name>.mbsync.extraConfig.remote\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Remote store extra configuration.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"extraConfig\",\"remote\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean or list of string)\"},\"accounts.email.accounts.<name>.mbsync.flatten\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"If set, flattens the hierarchy within the maildir by\\nsubstituting the canonical hierarchy delimiter\\n`/` with this value.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\".\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"flatten\"],\"readOnly\":false,\"type\":\"null or string\"},\"accounts.email.accounts.<name>.mbsync.groups\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Some email providers (Gmail) have a different directory hierarchy for\\nsynchronized email messages. Namely, when using mbsync without specifying\\na set of channels into a group, all synchronized directories end up beneath\\nthe `[Gmail]/` directory.\\n\\nThis option allows you to specify a group, and subsequently channels that\\nwill allow you to sync your mail into an arbitrary hierarchy.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"groups\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"accounts.email.accounts.<name>.mbsync.groups.<name>.channels\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"List of channels that should be grouped together into this group. When\\nperforming a synchronization, the groups are synchronized, rather than\\nthe individual channels.\\n\\nUsing these channels and then grouping them together allows for you to\\ndefine the maildir hierarchy as you see fit.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"groups\",\"<name>\",\"channels\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"accounts.email.accounts.<name>.mbsync.groups.<name>.channels.<name>.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra configuration lines to add to *THIS* channel's\\nconfiguration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  CopyArrivalDate = \\\"yes\\\";\\n  Create = \\\"both\\\";\\n  MaxMessages = 10000;\\n  MaxSize = \\\"1m\\\";\\n}\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"groups\",\"<name>\",\"channels\",\"<name>\",\"extraConfig\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean or list of string)\"},\"accounts.email.accounts.<name>.mbsync.groups.<name>.channels.<name>.farPattern\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"IMAP4 patterns for which mailboxes on the remote mail server to sync.\\nIf `Patterns` are specified, `farPattern`\\nis interpreted as a prefix which is not matched against the patterns,\\nand is not affected by mailbox list overrides.\\n\\nIf this is left as the default, then mbsync will default to the pattern\\n`INBOX`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"[Gmail]/Sent Mail\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"groups\",\"<name>\",\"channels\",\"<name>\",\"farPattern\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.mbsync.groups.<name>.channels.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"The unique name for THIS channel in THIS group. The group will refer to\\nthis channel by this name.\\n\\nIn addition, you can manually sync just this channel by specifying this\\nname to mbsync on the command line.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"groups\",\"<name>\",\"channels\",\"<name>\",\"name\"],\"readOnly\":true,\"type\":\"string\"},\"accounts.email.accounts.<name>.mbsync.groups.<name>.channels.<name>.nearPattern\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Name for where mail coming from the remote (far) mail server will end up\\nlocally. The mailbox specified by the far pattern will be placed in\\nthis directory.\\n\\nIf this is left as the default, then mbsync will default to the pattern\\n`INBOX`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Sent\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"groups\",\"<name>\",\"channels\",\"<name>\",\"nearPattern\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.mbsync.groups.<name>.channels.<name>.patterns\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Instead of synchronizing *just* the mailboxes that\\nmatch the `farPattern`, use it as a prefix which is\\nnot matched against the patterns, and is not affected by mailbox list\\noverrides.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"INBOX\\\"\\n]\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"groups\",\"<name>\",\"channels\",\"<name>\",\"patterns\"],\"readOnly\":false,\"type\":\"list of string\"},\"accounts.email.accounts.<name>.mbsync.groups.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"The name of this group for this account. These names are different than\\nsome others, because they will hide channel names that are the same.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"groups\",\"<name>\",\"name\"],\"readOnly\":true,\"type\":\"string\"},\"accounts.email.accounts.<name>.mbsync.patterns\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"*\\\"\\n]\"},\"description\":\"Pattern of mailboxes to synchronize.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"patterns\"],\"readOnly\":false,\"type\":\"list of string\"},\"accounts.email.accounts.<name>.mbsync.remove\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"none\\\"\"},\"description\":\"Propagate mailbox deletions to the given mail store.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"imap\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"remove\"],\"readOnly\":false,\"type\":\"one of \\\"none\\\", \\\"maildir\\\", \\\"imap\\\", \\\"both\\\"\"},\"accounts.email.accounts.<name>.mbsync.subFolders\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Verbatim\\\"\"},\"description\":\"The on-disk folder naming style. This option has no\\neffect when {option}`flatten` is used.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Maildir++\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mbsync\",\"subFolders\"],\"readOnly\":false,\"type\":\"one of \\\"Verbatim\\\", \\\"Maildir++\\\", \\\"Legacy\\\"\"},\"accounts.email.accounts.<name>.meli.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/meli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/meli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the meli mail client for this account.\\nRequires SMTP settings..\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"meli\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.meli.mailboxAliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/meli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/meli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Folder display name\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  INBOX = {\\n    alias = \\\"📥 Inbox\\\";\\n  };\\n  Sent = {\\n    alias = \\\"📤 Sent\\\";\\n  };\\n}\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"meli\",\"mailboxAliases\"],\"readOnly\":false,\"type\":\"attribute set of (attribute set)\"},\"accounts.email.accounts.<name>.meli.mailboxes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/meli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/meli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"Inbox\\\"\\n  \\\"Sent\\\"\\n  \\\"Trash\\\"\\n  \\\"Drafts\\\"\\n]\"},\"description\":\"Mailboxes to show in meli\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"INBOX\\\"\\n  \\\"Sent\\\"\\n  \\\"Trash\\\"\\n  \\\"Drafts\\\"\\n]\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"meli\",\"mailboxes\"],\"readOnly\":false,\"type\":\"list of string\"},\"accounts.email.accounts.<name>.meli.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/meli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/meli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Account specific meli configuration\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"meli\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"accounts.email.accounts.<name>.msmtp.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/msmtp>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/msmtp\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable msmtp.\\n\\nIf enabled then it is possible to use the\\n`--account` command line\\noption to send a message for a given account using the\\n{command}`msmtp` or {command}`msmtpq` tool.\\nFor example, {command}`msmtp --account=private` would\\nsend using the account defined in\\n{option}`accounts.email.accounts.private`. If the\\n`--account` option is not\\ngiven then the primary account will be used.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"msmtp\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.msmtp.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/msmtp>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/msmtp\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra configuration options to add to {file}`~/.msmtprc`.\\nSee <https://marlam.de/msmtp/msmtprc.txt> for\\nexamples.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  auth = \\\"login\\\";\\n}\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"msmtp\",\"extraConfig\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"accounts.email.accounts.<name>.msmtp.tls.fingerprint\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/msmtp>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/msmtp\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Fingerprint of a trusted TLS certificate.\\nThe fingerprint can be obtained by executing\\n{command}`msmtp --serverinfo --tls --tls-certcheck=off`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"my:SH:a2:56:ha:sh\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"msmtp\",\"tls\",\"fingerprint\"],\"readOnly\":false,\"type\":\"null or string matching the pattern ([[:alnum:]]{2}:)+[[:alnum:]]{2}\"},\"accounts.email.accounts.<name>.mu.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mu.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mu.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable mu indexing.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mu\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.mujmap.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable mujmap JMAP synchronization for notmuch.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.mujmap.notmuchSetupWarning\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Warn if Notmuch is not also enabled for this account.\\n\\nThis can safely be disabled if {file}`mujmap.toml` is managed\\noutside of Home Manager.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"notmuchSetupWarning\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.mujmap.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings which are applied to {file}`mujmap.toml`\\nfor the account.\\n\\nSee the [mujmap project](https://github.com/elizagamedev/mujmap)\\nfor documentation of settings not explicitly covered by this module.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"accounts.email.accounts.<name>.mujmap.settings.auto_create_new_mailboxes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to create new mailboxes automatically on the server from notmuch\\ntags.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\",\"auto_create_new_mailboxes\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.mujmap.settings.cache_dir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The cache directory in which to store mail files while they are being\\ndownloaded. The default is operating-system specific.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\",\"cache_dir\"],\"readOnly\":false,\"type\":\"null or string\"},\"accounts.email.accounts.<name>.mujmap.settings.fqdn\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Fully qualified domain name of the JMAP service.\\n\\nmujmap looks up the JMAP SRV record for this host to determine the JMAP session\\nURL. Mutually exclusive with\\n[](#opt-accounts.email.accounts._name_.mujmap.settings.session_url).\\n\\nIf `null`, defaults to\\n[](#opt-accounts.email.accounts._name_.jmap.host).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"example.com\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\",\"fqdn\"],\"readOnly\":false,\"type\":\"null or string\"},\"accounts.email.accounts.<name>.mujmap.settings.password_command\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Shell command which will print a password to stdout for basic HTTP\\nauthentication.\\n\\nIf `null`, defaults to\\n[](#opt-accounts.email.accounts._name_.passwordCommand).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pass alice@example.com\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\",\"password_command\"],\"readOnly\":false,\"type\":\"null or string or list of string\"},\"accounts.email.accounts.<name>.mujmap.settings.session_url\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Session URL to connect to.\\n\\nMutually exclusive with\\n[](#opt-accounts.email.accounts._name_.mujmap.settings.fqdn).\\n\\nIf `null`, defaults to\\n[](#opt-accounts.email.accounts._name_.jmap.sessionUrl).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"https://jmap.example.com/.well-known/jmap\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\",\"session_url\"],\"readOnly\":false,\"type\":\"null or string\"},\"accounts.email.accounts.<name>.mujmap.settings.tags\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Tag configuration.\\n\\nBeware that there are quirks that require manual consideration if changing the\\nvalues of these files; please see\\n<https://github.com/elizagamedev/mujmap/blob/main/mujmap.toml.example>\\nfor more details.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\",\"tags\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"accounts.email.accounts.<name>.mujmap.settings.tags.deleted\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"deleted\\\"\"},\"description\":\"Tag for notmuch to use for messages stored in the mailbox labeled with the\\n`Trash` name attribute.\\n\\nIf set to an empty string, this mailbox *and its child\\nmailboxes* are not synchronized with a tag.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\",\"tags\",\"deleted\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.mujmap.settings.tags.directory_separator\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/\\\"\"},\"description\":\"Directory separator for mapping notmuch tags to maildirs.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\".\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\",\"tags\",\"directory_separator\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.mujmap.settings.tags.important\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"important\\\"\"},\"description\":\"Tag for notmuch to use for messages stored in the mailbox labeled with the\\n`Important` name attribute and/or with the `$Important`\\nkeyword.\\n\\nIf set to an empty string, this mailbox, *its child\\nmailboxes*, and these keywords are not synchronized with a tag.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\",\"tags\",\"important\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.mujmap.settings.tags.inbox\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"inbox\\\"\"},\"description\":\"Tag for notmuch to use for messages stored in the mailbox labeled with the\\n`Inbox` name attribute.\\n\\nIf set to an empty string, this mailbox *and its child\\nmailboxes* are not synchronized with a tag.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"mujmap\",\"settings\",\"tags\",\"inbox\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.mujmap.settings.tags.lowercase\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mujmap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mujmap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If true, translate all mailboxes to lowercase names when mapping to notmuch\\ntags.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"