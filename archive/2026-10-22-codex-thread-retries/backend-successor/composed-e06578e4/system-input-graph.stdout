","out":"/nix/store/gg0wpkl7v01i4g9ymwyv5gsamkkzqyzn-glib-2.88.3","outputs":"bin out dev devdoc debug","patches":"/nix/store/1741v6rlizzg8k41myx7jk53rwa24b2m-glib-appinfo-watch.patch /nix/store/xmaba5a6w625vcyk9iaf44vzz8mnydk7-schema-override-variable.patch /nix/store/d8pkc3xxx3arcvdid48vh8imx9q9g4vq-elementary-terminal-support.patch /nix/store/0s51jr07rjwls4bwwb7mrpzikc2ax15m-split-dev-programs.patch /nix/store/abzy833a3cyracjdj47qxkx26r7lw2sg-gdb_script.patch","pname":"glib","postCheck":"rm $out/lib/libgobject-2.0.so.0\nrm $out/lib/libgio-2.0.so.0\nrm $out/lib/libglib-2.0.so.0\n","postConfigure":"patchShebangs gio/gdbus-2.0/codegen/gdbus-codegen gobject/glib-{genmarshal,mkenums}\n","postFixup":"for i in $dev/bin/*; do\n  moveToOutput \"share/man/man1/${i##*/}.1.*\" \"$dev\"\ndone\n\n# Cannot be in postInstall, otherwise _multioutDocs hook in preFixup will move right back.\nmoveToOutput \"share/doc\" \"$devdoc\"\n","postInstall":"moveToOutput \"share/glib-2.0\" \"$dev\"\nmoveToOutput \"share/glib-2.0/gdb\" \"$out\"\nsubstituteInPlace \"$dev/bin/gdbus-codegen\" --replace \"$out\" \"$dev\"\nsed -i \"$dev/bin/glib-gettextize\" -e \"s|^gettext_dir=.*|gettext_dir=$dev/share/glib-2.0/gettext|\"\n\n# This file is *included* in gtk3 and would introduce runtime reference via __FILE__.\nsed '1i#line 1 \"glib-2.88.3/include/glib-2.0/gobject/gobjectnotifyqueue.c\"' \\\n  -i \"$dev\"/include/glib-2.0/gobject/gobjectnotifyqueue.c\nfor i in $bin/bin/*; do\n  moveToOutput \"share/bash-completion/completions/${i##*/}\" \"$bin\"\ndone\nfor i in $dev/bin/*; do\n  moveToOutput \"share/bash-completion/completions/${i##*/}\" \"$dev\"\ndone\n","postPatch":"patchShebangs glib/gen-unicode-tables.pl\npatchShebangs glib/tests/gen-casefold-txt.py\npatchShebangs glib/tests/gen-casemap-txt.py\npatchShebangs tools/gen-visibility-macros.py\npatchShebangs tests\n\n# Needs machine-id, comment the test\nsed -e '/\\/gdbus\\/codegen-peer-to-peer/ s/^\\/*/\\/\\//' -i gio/tests/gdbus-peer.c\nsed -e '/g_test_add_func/ s/^\\/*/\\/\\//' -i gio/tests/gdbus-address-get-session.c\n# All gschemas fail to pass the test, upstream bug?\nsed -e '/g_test_add_data_func/ s/^\\/*/\\/\\//' -i gio/tests/gschema-compile.c\n# Cannot reproduce the failing test_associations on hydra\nsed -e '/\\/appinfo\\/associations/d' -i gio/tests/appinfo.c\n# Needed because of libtool wrappers\nsed -e '/g_subprocess_launcher_set_environ (launcher, envp);/a g_subprocess_launcher_setenv (launcher, \"PATH\", g_getenv(\"PATH\"), TRUE);' -i gio/tests/gsubprocess.c\n","preCheck":"","preFixup":"buildPythonPath /nix/store/671dh91zx227fz6a3q3fp086y2w19r2z-python3.13-packaging-26.1\npatchPythonScript \"$dev/share/glib-2.0/codegen/utils.py\"\n","propagatedBuildInputs":"/nix/store/2k9dj65vyanlvq863ks3ii7cjx82kfng-zlib-1.3.2-dev /nix/store/vaf7c4aslgbislz4dmfjk950iwrlqdfl-libffi-3.8.0-dev /nix/store/r6cl7zk1vhckkbnrjvvgf5ah1a23s090-gettext-1.0 /nix/store/ngy9kz80vpiylr093kjbcv8y2igq0m80-glibc-iconv-2.42","propagatedNativeBuildInputs":"","separateDebugInfo":"1","setupHook":"/nix/store/qgfij9cxhp7gfjk6hs43hzy4n3w9am3c-setup-hook.sh","src":"/nix/store/4298knw9zvdfz2mg7xizhzdvcq4gl8sr-glib-2.88.3.tar.xz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.88.3"},"inputs":{"drvs":{"0d366k265ck4d3xndk91bzafracrv2am-python3.13-packaging-26.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"2i7prvz6cdf1l28g0nb5fybnrhzpzw5k-meson-1.10.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"2knmcn8w4yv9rmmxg68n9v7bq67mz41g-libsystemtap-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"2qghs36d1hvcz187kg4kj1pvjj3g54rh-elfutils-0.194.drv":{"dynamicOutputs":{},"outputs":["dev"]},"4h14gh40cmy92iwbsv9z0rxcchi0c980-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"5jrl8lrv8b7sz1zm86jz260applm6zcj-pcre2-10.49.drv":{"dynamicOutputs":{},"outputs":["dev"]},"63zjnxw73yn1avnz9vcsb4hjlsvd0gls-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"a7sw