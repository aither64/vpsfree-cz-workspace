astcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;\nfastcgi_param REDIRECT_STATUS 200;\nfastcgi_pass unix:/run/phpfpm/dokuwiki-kb-cs.aitherdev.int.vpsfree.cz.sock;\n\n  \n  \n  \n}\n\nlocation ~ ^/data/ {\n  \n  \n  \n  \n  \n  \n  \n  \n  root /var/lib/dokuwiki/kb-cs.aitherdev.int.vpsfree.cz;\n  \n  \n  internal;\n  \n  \n  \n}\n\nlocation ~ ^/lib.*\\.(js|css|gif|png|ico|jpg|jpeg)$ {\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  expires 365d;\n  \n  \n  \n}\n\n\n  \n}\n\n\n\nserver {\n  \n            listen 0.0.0.0:80 ;\n\n            listen [::0]:80 ;\n  server_name kb-en.aitherdev.int.vpsfree.cz ;\n  \n  \n  \n  \n  \n  \n\n  \n\n  root /nix/store/8ignwv6hdwn736xfk5yg9302c0hmzj3q-dokuwiki-kb-en.aitherdev.int.vpsfree.cz-2026-07-14c/share/dokuwiki;\n\n  \n  \n  location / {\n  \n  \n  \n  \n  \n  \n  index doku.php;\n  \n  \n  \n  \n  try_files $uri $uri/ @dokuwiki;\n  \n  \n  \n}\n\nlocation @dokuwiki {\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  # rewrites \"doku.php/\" out of the URLs if you set the userwrite setting to .htaccess in dokuwiki config page\nrewrite ^/_media/(.*) /lib/exe/fetch.php?media=$1 last;\nrewrite ^/_detail/(.*) /lib/exe/detail.php?media=$1 last;\nrewrite ^/_export/([^/]+)/(.*) /doku.php?do=export_$1&id=$2 last;\nrewrite ^/(.*) /doku.php?id=$1&$args last;\n\n  \n  \n  \n}\n\nlocation ~ /(conf/|bin/|inc/|install.php) {\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  deny all;\n  \n  \n  \n}\n\nlocation ~ \\.php$ {\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  fastcgi_param HTTP_AUTHORIZATION $http_authorization;\n\ntry_files $uri $uri/ /doku.php;\ninclude /nix/store/smpkfhyjj22b4zy1f0cprzfhr0nimllr-nginx-1.30.6/conf/fastcgi_params;\nfastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;\nfastcgi_param REDIRECT_STATUS 200;\nfastcgi_pass unix:/run/phpfpm/dokuwiki-kb-en.aitherdev.int.vpsfree.cz.sock;\n\n  \n  \n  \n}\n\nlocation ~ ^/data/ {\n  \n  \n  \n  \n  \n  \n  \n  \n  root /var/lib/dokuwiki/kb-en.aitherdev.int