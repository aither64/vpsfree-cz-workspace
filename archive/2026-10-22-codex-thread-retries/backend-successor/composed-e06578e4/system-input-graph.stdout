utNames); do\n    mv \"$DESTDIR/${!o}\" \"${!o}\"\ndone\nmv \"$DESTDIR/etc\" \"$out\"\nmv \"$DESTDIR/usr/lib\"/{sysusers,tmpfiles}.d \"$out/lib\"\nmv \"$DESTDIR/run/current-system/sw/share\"/* \"$out/share\"\n# Ensure we did not forget to install anything.\nrmdir --parents --ignore-fail-on-non-empty \\\n    \"$DESTDIR/nix/store\" \\\n    \"$DESTDIR/usr/lib\" \\\n    \"$DESTDIR/run/current-system/sw/share\"\n! test -e \"$DESTDIR\"\n","postPatch":"patchShebangs \\\n  test/wrapper.py\n\n# ‘libpolkit-agent-1.so’ should call the setuid wrapper on\n# NixOS.  Hard-coding the path is kinda ugly.  Maybe we can just\n# call through $PATH, but that might have security implications.\nsubstituteInPlace src/polkitagent/polkitagentsession.c \\\n  --replace-fail 'PACKAGE_PREFIX \"/lib/polkit-1/'   '\"/run/wrappers/bin/'\nsubstituteInPlace test/data/etc/polkit-1/rules.d/10-testing.rules \\\n  --replace-fail /bin/true /nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/true \\\n  --replace-fail /bin/false /nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/false\n","propagatedBuildInputs":"/nix/store/d0vv6yniq5vhdm7dg7nvnpbinrkcr36y-glib-2.88.3-dev","propagatedNativeBuildInputs":"","src":"/nix/store/5abpqsi6y376517vnsb5piikzlvj9vgz-source","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"127"},"inputs":{"drvs":{"020ncj1fvdc04mwvwhi2p25h7m3f45yv-docbook-xsl-nons-1.79.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"1y1qnkiw0iwwwcvk49s633zf8rhl1185-gtk-doc-1.35.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"2i7prvz6cdf1l28g0nb5fybnrhzpzw5k-meson-1.10.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"63zjnxw73yn1avnz9vcsb4hjlsvd0gls-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6ib09qsay7w3ha9b3ccs7qaaks0i7acw-gobject-introspection-wrapped-1.86.0.drv":{"dynamicOutputs":{},"outputs