gins/prezto.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/plugins/prezto.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Integrate with iTerm2.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zsh\",\"prezto\",\"tmux\",\"itermIntegration\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.zsh.prezto.utility.safeOps\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/plugins/prezto.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/plugins/prezto.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Enabled safe options. This aliases {command}`cp`,\\n{command}`ln`, {command}`mv` and {command}`rm` so that they\\nprompt before deleting or overwriting files. Set to `no` to\\ndisable this safer behavior.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zsh\",\"prezto\",\"utility\",\"safeOps\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.zsh.profileExtra\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra commands that should be added to {file}`.zprofile`.\",\"loc\":[\"programs\",\"zsh\",\"profileExtra\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.zsh.sessionVariables\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Environment variables that will be set for zsh session.\\n\\nSetting a value to `null` will skip setting the variable at all, which\\nmay be useful when overriding.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  MAILCHECK = 30;\\n}\"},\"loc\":[\"programs\",\"zsh\",\"sessionVariables\"],\"readOnly\":false,\"type\":\"lazy attribute set of (null or string or absolute path or signed integer or floating point number or boolean)\"},\"programs.zsh.setOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Configure zsh options. See\\n{manpage}`zshoptions(1)`.\\n\\nTo unset an option, prefix it with \\\"NO_\\\".\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"EXTENDED_HISTORY\\\"\\n  \\\"RM_STAR_WAIT\\\"\\n  \\\"NO_BEEP\\\"\\n]\"},\"loc\":[\"programs\",\"zsh\",\"setOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.zsh.shellAliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set that maps aliases (the top level attribute names in\\nthis option) to command strings or directly to build outputs.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"..\\\" = \\\"cd ..\\\";\\n  ll = \\\"ls -l\\\";\\n}\"},\"loc\":[\"programs\",\"zsh\",\"shellAliases\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.zsh.shellGlobalAliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Similar to [](#opt-programs.zsh.shellAliases),\\nbut are substituted anywhere on a line.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  G = \\\"| grep\\\";\\n  UUID = \\\"$(uuidgen | tr -d \\\\\\\\n)\\\";\\n}\"},\"loc\":[\"programs\",\"zsh\",\"shellGlobalAliases\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.zsh.siteFunctions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Functions that are added to the Zsh environment and are subject to\\n{command}`autoload`ing. The key is the name and the value is the body of\\nthe function to be autoloaded.\\n\\nThey are also already marked for autoloading through `autoload -Uz`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  mkcd = ''\\n    mkdir --parents \\\"$1\\\" && cd \\\"$1\\\"\\n  '';\\n}\"},\"loc\":[\"programs\",\"zsh\",\"siteFunctions\"],\"readOnly\":false,\"type\":\"attribute set of strings concatenated with \\\"\\\\n\\\"\"},\"programs.zsh.syntaxHighlighting\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options related to zsh-syntax-highlighting.\",\"loc\":[\"programs\",\"zsh\",\"syntaxHighlighting\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.zsh.syntaxHighlighting.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable zsh syntax highlighting.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zsh\",\"syntaxHighlighting\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.syntaxHighlighting.highlighters\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"[ \\\\\\\"main\\\\\\\" ]\\\"\"},\"description\":\"Highlighters to enable\\nSee the list of highlighters: <https://github.com/zsh-users/zsh-syntax-highlighting/blob/master/docs/highlighters.md>\\n\\nNote: The \\\"main\\\" highlighter is always included automatically.\\nIf you'd like to exclude it, please configure with a higher priority using `mkForce`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"brackets\\\"\\n]\"},\"loc\":[\"programs\",\"zsh\",\"syntaxHighlighting\",\"highlighters\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.zsh.syntaxHighlighting.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.zsh-syntax-highlighting\"},\"description\":\"The zsh-syntax-highlighting package to use.\",\"loc\":[\"programs\",\"zsh\",\"syntaxHighlighting\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.zsh.syntaxHighlighting.patterns\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom syntax highlighting for user-defined patterns.\\nReference: <https://github.com/zsh-users/zsh-syntax-highlighting/blob/master/docs/highlighters/pattern.md>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"rm -rf *\\\" = \\\"fg=white,bold,bg=red\\\";\\n}\"},\"loc\":[\"programs\",\"zsh\",\"syntaxHighlighting\",\"patterns\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.zsh.syntaxHighlighting.styles\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom styles for syntax highlighting.\\nSee each highlighter style option: <https://github.com/zsh-users/zsh-syntax-highlighting/blob/master/docs/highlighters/main.md>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  comment = \\\"fg=black,bold\\\";\\n}\"},\"loc\":[\"programs\",\"zsh\",\"syntaxHighlighting\",\"styles\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.zsh.zplug.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zplug.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zplug.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable zplug - a zsh plugin manager.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zsh\",\"zplug\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.zplug.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zplug.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zplug.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.zplug\"},\"description\":\"The zplug package to use.\",\"loc\":[\"programs\",\"zsh\",\"zplug\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.zsh.zplug.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zplug.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zplug.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of zplug plugins.\",\"loc\":[\"programs\",\"zsh\",\"zplug\",\"plugins\"],