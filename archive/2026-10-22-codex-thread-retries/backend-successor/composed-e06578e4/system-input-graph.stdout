"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"activesupport highline json require_all rest-client ruby-progressbar","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"haveapi-client","gemPath":"/nix/store/sqwpbck3nkmyd74v4czzxkfark7rryfp-ruby3.4-activesupport-7.2.1 /nix/store/rz0w7a2zqgkbp630r66fiqv88hai3gbi-ruby3.4-highline-3.1.1 /nix/store/52y6d9166jfcbkk4z1am3bxgdccb4ykx-ruby3.4-json-2.7.2 /nix/store/pnsd7wq44mz7q5gq431gr0p1c7ilapfg-ruby3.4-require_all-2.0.0 /nix/store/il3296k9ylghfvvzabli1llbwzlpyywp-ruby3.4-rest-client-2.1.0 /nix/store/200rv8nh5s1klmnvzx21ml1fxf6rf25r-ruby3.4-ruby-progressbar-1.13.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-haveapi-client-0.23.7","nativeBuildInputs":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9 /nix/store/7whrgb2wib2q83wgbs78xsq9h25lf3aw-make-shell-wrapper-hook","out":"/nix/store/6cfx8axga9n1fwvkjjipin5a1mbx4n8b-ruby3.4-haveapi-client-0.23.7","outputs":"out","patches":"","pname":"haveapi-client","propagatedBuildInputs":"/nix/store/sqwpbck3nkmyd74v4czzxkfark7rryfp-ruby3.4-activesupport-7.2.1 /nix/store/rz0w7a2zqgkbp630r66fiqv88hai3gbi-ruby3.4-highline-3.1.1 /nix/store/52y6d9166jfcbkk4z1am3bxgdccb4ykx-ruby3.4-json-2.7.2 /nix/store/pnsd7wq44mz7q5gq431gr0p1c7ilapfg-ruby3.4-require_all-2.0.0 /nix/store/il3296k9ylghfvvzabli1llbwzlpyywp-ruby3.4-rest-client-2.1.0 /nix/store/200rv8nh5s1klmnvzx21ml1fxf6rf25r-ruby3.4-ruby-progressbar-1.13.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/s