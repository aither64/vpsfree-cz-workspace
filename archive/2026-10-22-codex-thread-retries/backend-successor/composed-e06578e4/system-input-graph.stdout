es/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Custom ASCII section. Specify your own ASCII art file.\\nOmit to exclude the [custom_ascii] section entirely.\\n\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"custom_ascii\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"programs.macchina.themes.<name>.custom_ascii.color\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Color of the ASCII art. Omitted when null.\\nAccepts hex (\\\"#00FF00\\\"), indexed (\\\"046\\\"), or named colors (e.g. \\\"Green\\\").\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Cyan\\\"\"},\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"custom_ascii\",\"color\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.macchina.themes.<name>.custom_ascii.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to a file containing ASCII art. ANSI escape sequences are supported.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"~/ascii/arch_linux\\\"\"},\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"custom_ascii\",\"path\"],\"readOnly\":false,\"type\":\"null or string or absolute path\"},\"programs.macchina.themes.<name>.hide_ascii\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to disable ASCII rendering entirely.\",\"loc\