arator\\\" (singular enum))) convertible to it\"},\"programs.floorp.profiles.<name>.containers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of container configurations. See\\n[Multi-Account\\nContainers](https://support.mozilla.org/en-US/kb/containers)\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  dangerous = {\\n    color = \\\"red\\\";\\n    icon = \\\"fruit\\\";\\n    id = 2;\\n  };\\n  shopping = {\\n    color = \\\"blue\\\";\\n    icon = \\\"cart\\\";\\n    id = 1;\\n  };\\n}\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"containers\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.floorp.profiles.<name>.containers.<name>.color\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pink\\\"\"},\"description\":\"Container color.\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"color\"],\"readOnly\":false,\"type\":\"one of \\\"blue\\\", \\\"turquoise\\\", \\\"green\\\", \\\"yellow\\\", \\\"orange\\\", \\\"red\\\", \\\"pink\\\", \\\"purple\\\", \\\"toolbar\\\"\"},\"programs.floorp.profiles.<name>.containers.<name>.icon\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fruit\\\"\"},\"description\":\"Container icon.\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"icon\"],\"readOnly\":false,\"type\":\"one of \\\"briefcase\\\", \\\"cart\\\", \\\"circle\\\", \\\"dollar\\\", \\\"fence\\\", \\\"fingerprint\\\", \\\"gift\\\", \\\"vacation\\\", \\\"food\\\", \\\"fruit\\\", \\\"pet\\\", \\\"tree\\\", \\\"chill\\\"\"},\"programs.floorp.profiles.<name>.containers.<name>.id\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"Container ID. This should be set to a unique number per container in this profile.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"id\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"programs.floorp.profiles.<name>.containers.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"Container name, e.g., shopping.\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"programs.floorp.profiles.<name>.containersForce\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force replace the existing containers configuration.\\nThis is recommended since Floorp will replace the symlink on\\nevery launch, but note that you'll lose any existing configuration\\nby enabling this.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"containersForce\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.floorp.profiles.<name>.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Submodule for installing and configuring extensions.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  packages = with pkgs.nur.repos.rycee.firefox-addons; [\\n    ublock-origin\\n  ];\\n  settings.\\\"uBlock0@raymondhill.net\\\".settings = {\\n    selectedFilterLists = [\\n      \\\"ublock-filters\\\"\\n      \\\"ublock-badware\\\"\\n      \\\"ublock-privacy\\\"\\n      \\\"ublock-unbreak\\\"\\n      \\\"ublock-quick-fixes\\\"\\n    ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"extensions\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.floorp.profiles.<name>.extensions.exactPermissions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When enabled,\\n{option}`programs.floorp.profiles.<profile>.extensions.settings.<extensionID>.permissions`\\nmust specify the exact set of permissions that the\\nextension will request.\\n\\nThis means that if the authorized permissions are\\nbroader than what the extension requests, the\\nassertion will fail.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"extensions\",\"exactPermissions\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.floorp.profiles.<name>.extensions.exhaustivePermissions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When enabled, the user must authorize requested\\npermissions for all extensions from\\n{option}`programs.floorp.profiles.<profile>.extensions.packages`\\nin\\n{option}`programs.floorp.profiles.<profile>.extensions.settings.<extensionID>.permissions`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"extensions\",\"exhaustivePermissions\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.floorp.profiles.<name>.extensions.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to override all previous firefox settings.\\n\\nThis is required when using `settings`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"extensions\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.floorp.profiles.<name>.extensions.packages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of ‹name› add-on packages to install for this profile.\\nSome pre-packaged add-ons are accessible from the Nix User Repository.\\nOnce you have NUR installed run\\n\\n```console\\n$ nix-env -f '<nixpkgs>' -qaP -A nur.repos.rycee.firefox-addons\\n```\\n\\nto list the available ‹name› add-ons.\\n\\nNote that it is necessary to manually enable these extensions\\ninside ‹name› after the first installation.\\n\\nTo automatically enable extensions add\\n`\\\"extensions.autoDisableScopes\\\" = 0;`\\nto\\n[{option}`programs.floorp.profiles.<profile>.settings`](#opt-programs.floorp.profiles._name_.settings)\\n\\nOn systems using impermanence, this only prevents\\n‹name› from requiring manual extension approval. It\\ndoes not preserve extension runtime state such as\\nextension UUIDs, logins, local storage, or\\nper-extension data. Persist the ‹name› profile state\\nneeded by your extensions, or configure supported\\nextension settings declaratively with\\n[{option}`programs.floorp.profiles.<profile>.extensions.settings`](#opt-programs.floorp.profiles._name_.extensions.settings).\\n\\nPersisting only the `extensions` directory is generally\\nnot sufficient, because ‹name› stores extension state\\nin other profile files and databases that are managed\\noutside Home Manager.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs.nur.repos.rycee.firefox-addons; [\\n  privacy-badger\\n]\\n\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"extensions\",\"packages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.floorp.profiles.<name>.extensions.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of options for each extension.\\nThe keys of the attribute set consist of the ID of the extension\\nor its UUID wrapped in curly braces.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  # Example with uBlock origin's extensionID\\n  \\\"uBlock0@raymondhill.net\\\".settings = {\\n    selectedFilterLists = [\\n      \\\"ublock-filters\\\"\\n      \\\"ublock-badware\\\"\\n      \\\"ublock-privacy\\\"\\n      \\\"ublock-unbreak\\\"\\n      \\\"ublock-quick-fixes\\\"\\n    ];\\n  };\\n\\n  # Example with Stylus' UUID-form extensionID\\n  \\\"{7a7a4a92-a2a0-41d1-9fd7-1e92480d612d}\\\".settings = {\\n    dbInChromeStorage = true; # required for Stylus\\n  }\\n}\\n\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"extensions\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.floorp.profiles.<name>.extensions.settings.<name>.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Forcibly override any existing configuration for\\nthis extension.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"extensions\",\"settings\",\"<name>\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.floorp.profiles.<name>.extensions.settings.<name>.permissions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Any permissions\\\"\"},\"description\":\"Allowed permissions for this extension. See\\n<https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/manifest.json/permissions>\\nfor a list of relevant permissions.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"activeTab\\\"\\n]\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"extensions\",\"settings\",\"<name>\",\"permissions\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"programs.floorp.profiles.<name>.extensions.settings.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Json formatted options for this extension.\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"extensions\",\"settings\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.floorp.profiles.<name>.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra preferences to add to {file}`user.js`.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.floorp.profiles.<name>.handlers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Declarative handlers configuration for MIME types and URL schemes.\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.floorp.profiles.<name>.handlers.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force replace the existing handlers configuration.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.floorp.profiles.<name>.handlers.meta.maintainers\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of maintainers of each module.\\nThis option should be defined at most once per module.\\n\\nThe option value is not a list of maintainers, but an attribute set that maps module file names to lists of maintainers.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.maintainers.alice lib.maintainers.bob ]\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"meta\",\"maintainers\"],\"readOnly\":false,\"type\":\"list of lib.maintainers\"},\"programs.floorp.profiles.<name>.handlers.meta.teams\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of team maintainers of each module.\\nThis option should be defined at most once per module.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.teams.acme lib.teams.haskell ]\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"meta\",\"teams\"],\"readOnly\":false,\"type\":\"list of lib.teams\"},\"programs.floorp.profiles.<name>.handlers.mimeTypes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set mapping MIME types to their handler configurations.\\n\\nFor a configuration example, see [this file on Firefox’s source code](https://github.com/mozilla-firefox/firefox/blob/c3797cdebac1316dd7168e995e3468c5a597e8d1/uriloader/exthandler/tests/unit/handlers.json).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"application/pdf\\\" = {\\n    action = 2;\\n    ask = false;\\n    handlers = [\\n      {\\n        name = \\\"Okular\\\";\\n        path = \\\"${pkgs.okular}/bin/okular\\\";\\n      }\\n    ];\\n    extensions = [ \\\"pdf\\\" ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.floorp.profiles.<name>.handlers.mimeTypes.<name>.action\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"The action to take for this MIME type / URL scheme. Possible values:\\n- 0: Save file\\n- 1: Always ask\\n- 2: Use helper app\\n- 3: Open in Floorp\\n- 4: Use system default\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"action\"],\"readOnly\":false,\"type\":\"one of 0, 1, 2, 3, 4\"},\"programs.floorp.profiles.<name>.handlers.mimeTypes.<name>.ask\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If true, the user is asked what they want to do with the file.\\nIf false, the action is taken without user intervention.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"ask\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.floorp.profiles.<name>.handlers.mimeTypes.<name>.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of file extensions associated with this MIME type.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"jpg\\\"\\n  \\\"jpeg\\\"\\n]\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"extensions\"],\"readOnly\":false,\"type\":\"list of string matching the pattern ^[^\\\\.].+$\"},\"programs.floorp.profiles.<name>.handlers.mimeTypes.<name>.handlers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"An array of handlers with the first one being the default.\\nIf you don't want to have a default handler, use an empty object for the first handler.\\nOnly valid when action is set to 2 (Use helper app).\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.floorp.profiles.<name>.handlers.mimeTypes.<name>.handlers.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Display name of the handler.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.floorp.profiles.<name>.handlers.mimeTypes.<name>.handlers.*.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the executable to be used.\\n\\nOnly one of 'path' or 'uriTemplate' should be set.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\",\"*\",\"path\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.floorp.profiles.<name>.handlers.mimeTypes.<name>.handlers.*.uriTemplate\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"URI for the application handler.\\n\\nOnly one of 'path' or 'uriTemplate' should be set.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\",\"*\",\"uriTemplate\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.floorp.profiles.<name>.handlers.schemes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set mapping URL schemes to their handler configurations.\\n\\nFor a configuration example, see [this file on Firefox’s source code](https://github.com/mozilla-firefox/firefox/blob/c3797cdebac1316dd7168e995e3468c5a597e8d1/uriloader/exthandler/tests/unit/handlers.json).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  mailto = {\\n    action = 2;\\n    ask = false;\\n    handlers = [\\n      {\\n        name = \\\"Gmail\\\";\\n        uriTemplate = \\\"https://mail.google.com/mail/?extsrc=mailto&url=%s\\\";\\n      }\\n    ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"schemes\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.floorp.profiles.<name>.handlers.schemes.<name>.action\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"The action to take for this MIME type / URL scheme. Possible values:\\n- 0: Save file\\n- 1: Always ask\\n- 2: Use helper app\\n- 3: Open in Floorp\\n- 4: Use system default\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"action\"],\"readOnly\":false,\"type\":\"one of 0, 1, 2, 3, 4\"},\"programs.floorp.profiles.<name>.handlers.schemes.<name>.ask\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If true, the user is asked what they want to do with the file.\\nIf false, the action is taken without user intervention.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"ask\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.floorp.profiles.<name>.handlers.schemes.<name>.handlers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"An array of handlers with the first one being the default.\\nIf you don't want to have a default handler, use an empty object for the first handler.\\nOnly valid when action is set to 2 (Use helper app).\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"handlers\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.floorp.profiles.<name>.handlers.schemes.<name>.handlers.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Display name of the handler.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"handlers\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.floorp.profiles.<name>.handlers.schemes.<name>.handlers.*.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the executable to be used.\\n\\nOnly one of 'path' or 'uriTemplate' should be set.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"handlers\",\"*\",\"path\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.floorp.profiles.<name>.handlers.schemes.<name>.handlers.*.uriTemplate\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"URI for the application handler.\\n\\nOnly one of 'path' or 'uriTemplate' should be set.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"handlers\",\"*\",\"uriTemplate\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.floorp.profiles.<name>.id\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"description\":\"Profile ID. This should be set to a unique number per profile.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"id\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"programs.floorp.profiles.<name>.isDefault\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"true if profile ID is 0\\\"\"},\"description\":\"Whether this is a default profile.\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"isDefault\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.floorp.profiles.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"Profile name.\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"programs.floorp.profiles.<name>.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"Profile path.\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"path\"],\"readOnly\":false,\"type\":\"string\"},\"programs.floorp.profiles.<name>.preConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra preferences to add to {file}`user.js`, before\\n[](#opt-programs.firefox.profiles._name_.settings).\\n\\nUse [](#opt-programs.firefox.profiles._name_.extraConfig), unless\\nyou want to overwrite in\\n[](#opt-programs.firefox.profiles._name_.settings), then use this\\noption.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"preConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.floorp.profiles.<name>.search\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Declarative search engine configuration.\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"search\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.floorp.profiles.<name>.search.default\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default search engine used in the address bar and search\\nbar.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ddg\\\"\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"search\",\"default\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.floorp.profiles.<name>.search.engines\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of search engine configurations. Engines that\\nonly have {var}`metaData` specified will be treated as builtin\\nto Floorp.\\n\\nSee [SearchEngine.jsm](https://searchfox.org/mozilla-central/rev/e3f42ec9320748b2aab3d474d1e47075def9000c/toolkit/components/search/SearchEngine.sys.mjs#890-923)\\nin Floorp's source for available options. We maintain a\\nmapping to let you specify all options in the referenced link\\nwithout underscores, but it may fall out of date with future\\noptions.\\n\\nNote, {var}`icon` is also a special option added by Home\\nManager to make it convenient to specify absolute icon paths.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  nix-packages = {\\n    name = \\\"Nix Packages\\\";\\n    urls = [{\\n      template = \\\"https://search.nixos.org/packages\\\";\\n      params = [\\n        { name = \\\"type\\\"; value = \\\"packages\\\"; }\\n        { name = \\\"query\\\"; value = \\\"{searchTerms}\\\"; }\\n      ];\\n    }];\\n\\n    icon = \\\"${pkgs.nixos-icons}/share/icons/hicolor/scalable/apps/nix-snowflake.svg\\\";\\n    definedAliases = [ \\\"@np\\\" ];\\n  };\\n\\n  nixos-wiki = {\\n    name = \\\"NixOS Wiki\\\";\\n    urls = [{ template = \\\"https://wiki.nixos.org/w/index.php?search={searchTerms}\\\"; }];\\n    iconMapObj.\\\"16\\\" = \\\"https://wiki.nixos.org/favicon.ico\\\";\\n    definedAliases = [ \\\"@nw\\\" ];\\n  };\\n\\n  bing.metaData.hidden = true;\\n  google.metaData.alias = \\\"@g\\\"; # builtin engines only support specifying one additional alias\\n}\\n\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"search\",\"engines\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (JSON value)\"},\"programs.floorp.profiles.<name>.search.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force replace the existing search\\nconfiguration. This is recommended since Floorp will\\nreplace the symlink for the search configuration on every\\nlaunch, but note that you'll lose any existing configuration\\nby enabling this.\\n\",\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"search\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.floorp.profiles.<name>.search.meta.maintainers\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of maintainers of each module.\\nThis option should be defined at most once per module.\\n\\nThe option value is not a list of maintainers, but an attribute set that maps module file names to lists of maintainers.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.maintainers.alice lib.maintainers.bob ]\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"search\",\"meta\",\"maintainers\"],\"readOnly\":false,\"type\":\"list of lib.maintainers\"},\"programs.floorp.profiles.<name>.search.meta.teams\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of team maintainers of each module.\\nThis option should be defined at most once per module.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.teams.acme lib.teams.haskell ]\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"search\",\"meta\",\"teams\"],\"readOnly\":false,\"type\":\"list of lib.teams\"},\"programs.floorp.profiles.<name>.search.order\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The order the search engines are listed in. Any engines that\\naren't included in this list will be listed after these in an\\nunspecified order.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"ddg\\\"\\n  \\\"google\\\"\\n]\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"search\",\"order\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.floorp.profiles.<name>.search.privateDefault\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default search engine used in the Private Browsing.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ddg\\\"\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"search\",\"privateDefault\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.floorp.profiles.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of Floorp preferences.\\n\\nFloorp only supports int, bool, and string types for\\npreferences, but home-manager will automatically\\nconvert all other JSON-compatible values into strings.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"browser.startup.homepage\\\" = \\\"https://nixos.org\\\";\\n  \\\"browser.search.region\\\" = \\\"GB\\\";\\n  \\\"browser.search.isUS\\\" = false;\\n  \\\"distribution.searchplugins.defaultLocale\\\" = \\\"en-GB\\\";\\n  \\\"general.useragent.locale\\\" = \\\"en-GB\\\";\\n  \\\"browser.bookmarks.showMobileBookmarks\\\" = true;\\n  \\\"browser.newtabpage.pinned\\\" = [{\\n    title = \\\"NixOS\\\";\\n    url = \\\"https://nixos.org\\\";\\n  }];\\n}\\n\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (Floorp preference (int, bool, string, and also attrs, list, float as a JSON string))\"},\"programs.floorp.profiles.<name>.userChrome\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom Floorp user chrome CSS.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  /* Hide tab bar in FF Quantum */\\n  @-moz-document url(chrome://browser/content/browser.xul), url(chrome://browser/content/browser.xhtml) {\\n    #TabsToolbar {\\n      visibility: collapse !important;\\n      margin-bottom: 21px !important;\\n    }\\n  \\n    #sidebar-box[sidebarcommand=\\\"treestyletab_piro_sakura_ne_jp-sidebar-action\\\"] #sidebar-header {\\n      visibility: collapse !important;\\n    }\\n  }\\n''\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"userChrome\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.floorp.profiles.<name>.userContent\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/floorp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/floorp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom Floorp user content CSS.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  /* Hide scrollbar in FF Quantum */\\n  *{scrollbar-width:none !important}\\n''\"},\"loc\":[\"programs\",\"floorp\",\"profiles\",\"<name>\",\"userContent\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.foliate.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/foliate.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/foliate.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Foliate.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"foliate\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.foliate.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/foliate.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/foliate.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.foliate\"},\"description\":\"The foliate package to use.\",\"loc\":[\"programs\",\"foliate\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.foliate.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/foliate.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/foliate.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Added to `config.dconf.settings` under `com/github/johnfactotum/Foliate`,\\nthe scheme is defined at\\n<https://github.com/johnfactotum/foliate/blob/gtk4/data/com.github.johnfactotum.Foliate.gschema.xml>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  myTheme = {\\n    color-scheme = 0;\\n    library = {\\n      show-covers = true;\\n      view-mode = \\\"grid\\\";\\n    };\\n    \\\"viewer/font\\\" = {\\n      default-size = 12;\\n      monospace = \\\"Maple Mono\\\";\\n    };\\n    \\\"viewer/view\\\" = {\\n      theme = \\\"myTheme.json\\\";\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"foliate\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of ((GVariant value) or attribute set of (GVariant value))\"},\"programs.foliate.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/foliate.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/foliate.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Each theme is written to\\n{file}`$XDG_CONFIG_HOME/com.github.johnfactotum.Foliate/themes/NAME.json`.\\nSee <https://github.com/johnfactotum/foliate/blob/gtk4/src/themes.js>\\nfor implementation of themes in Foliate.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  label = \\\"My Theme\\\";\\n  light = {\\n    fg = \\\"#89b4fa\\\";\\n    bg = \\\"#1e1e2e\\\";\\n    link = \\\"#89b4fa\\\";\\n  };\\n  dark = { };\\n}\\n\"},\"loc\":[\"programs\",\"foliate\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value or string or absolute path)\"},\"programs.foot.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/foot.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/foot.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Foot terminal.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"foot\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.foot.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/foot.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/foot.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.foot\"},\"description\":\"The foot package to use.\",\"loc\":[\"programs\",\"foot\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.foot.server.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/foot.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/foot.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Foot terminal server.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"foot\",\"server\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.foot.server.systemdTarget\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/foot.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/foot.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.wayland.systemd.target\"},\"description\":\"The systemd target that will automatically start the Foot server service.\\n\\nWhen setting this value to `\\\"sway-session.target\\\"`,\\nmake sure to also enable {option}`wayland.windowManager.sway.systemd.enable`,\\notherwise the service may never be started.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"sway-session.target\\\"\"},\"loc\":[\"programs\",\"foot\",\"server\",\"systemdTarget\"],\"readOnly\":false,\"type\":\"string\"},\"programs.foot.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/foot.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/foot.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/foot/foot.ini`. See <https://codeberg.org/dnkl/foot/src/branch/master/foot.ini>\\nfor a list of available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  main = {\\n    dpi-aware = \\\"yes\\\";\\n    font = \\\"Fira Code:size=11\\\";\\n    term = \\\"xterm-256color\\\";\\n  };\\n  mouse = {\\n    hide-when-typing = \\\"yes\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"foot\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string) or a list of them for duplicate keys)\"},\"programs.formiko.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/formiko.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/formiko.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable formiko.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"formiko\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.formiko.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/formiko.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/formiko.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.formiko\"},\"description\":\"The formiko package to use.\",\"loc\":[\"programs\",\"formiko\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.formiko.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/formiko.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/formiko.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for formiko. All the available options\\ncan be found by looking at ~/.config/formiko.ini.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  editor = {\\n    auto_indent = false;\\n    check_spelling = false;\\n    period_save = true;\\n  };\\n  main = {\\n    auto_scroll = true;\\n    parser = \\\"json\\\";\\n    preview = 0;\\n    writer = \\\"tiny\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"formiko\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.freetube.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/freetube.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/freetube.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable FreeTube, a YT client for Windows, Mac, and Linux.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"freetube\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.freetube.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/freetube.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/freetube.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.freetube\"},\"description\":\"The freetube package to use.\",\"loc\":[\"programs\",\"freetube\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.freetube.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/freetube.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/freetube.nix\"}],\"default\":{\