same way as for the main build\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelBuilding:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray buildFlags buildFlagsArray\nechoCmd 'build flags' \"${flagsArray[@]}\"\n# Need to build the main Git documentation before building the\n# contrib/subtree documentation, as the latter depends on the\n# asciidoc.conf file created by the former.\nmake -C Documentation PERL_PATH=/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3/bin/perl \"${flagsArray[@]}\"\nmake -C contrib/subtree \"${flagsArray[@]}\" all doc\nmake -C contrib/diff-highlight \"${flagsArray[@]}\"\nunset flagsArray\n","postInstall":"# Set up the flags array for make in the same way as for the main install\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelInstalling:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray installFlags installFlagsArray\nechoCmd 'install flags' \"${flagsArray[@]}\"\n\n# Install git-subtree.\nmake -C contrib/subtree \"${flagsArray[@]}\" install install-doc\nrm -rf contrib/subtree\n\n# Install contrib stuff.\nmkdir -p $out/share/git\ncp -a contrib $out/share/git/\nmkdir -p $out/share/bash-completion/completions\nln -s $out/share/git/contrib/completion/git-prompt.sh $out/share/bash-completion/completions/\n\n# grep is a runtime dependency, need to patch so that it's found\nsubstituteInPlace $out/libexec/git-core/git-sh-setup \\\n    --replace ' grep' ' /nix/store/cqhgy07rpxdwk9kd2qlc3cw4s9ajzm9f-gnugrep-3.12/bin/grep' \\\n    --replace ' egrep' ' /nix/store/cqhgy07rpxdwk9kd2qlc3cw4s9ajzm9f-gnugrep-3.12/bin/egrep'\n\n# Fix references to the perl, sed, awk and various coreutil binaries used by\n# shell scripts that git calls (e.g. filter-branch)\nSCRIPT=\"$(cat <<'EOS'\n  BEGIN{\n    @a=(\n      '/nix/store/cqhgy07rpxdwk9kd2qlc3cw4s9ajzm9f-gnugrep-3.12/bin/grep', '/nix/store/0s17nja4n8b63by0nlg1m31mxn2bq1g1-gnused-4.10/bin/sed', '/nix/store/xbqis14s3fvckwlayc6vxvglws1v2mcw-gawk-5.4.1/bin/awk',\n      '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/cut', '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/basename', '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/dirname',\n      '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/wc', '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/tr'\n      , '/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3/bin/perl'\n    );\n  }\n  foreach $c (@a) {\n    $n=(split(\"/\", $c))[-1];\n    s|(?<=[^#][^/.-])\\b${n}(?=\\s)|${c}|g\n  }\nEOS\n)\"\nperl -0777 -i -pe \"$SCRIPT\" \\\n  $out/libexec/git-core/git-{sh-setup,filter-branch,merge-octopus,mergetool,quiltimport,request-pull,submodule,subtree,web--browse}\n\n\n# Also put git-http-backend into $PATH, so that we can use smart\n# HTTP(s) transports for pushing\nln -s $out/libexec/git-core/git-http-backend $out/bin/git-http-backend\nmakeWrapper $out/share/git/contrib/git-jump/git-jump $out/bin/git-jump \\\n  --prefix PATH : \"$out/bin:/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3/bin:/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin\"\n\n# wrap perl commands\nmakeWrapper \"$out/share/git/contrib/credential/netrc/git-credential-netrc.perl\" $out/libexec/git-core/git-credential-netrc \\\n            --set PERL5LIB   \"$out/lib/perl5/site_perl:/nix/store/pa014a5yifla1r5mxh1r3qwfy9h0qd3i-perl5.42.3-libwww-perl-6.83/lib/perl5/site_perl:/nix/store/lnfvr020s1s3l2y2s5pldmzjq72y62vv-perl5.42.3-URI-5.21/lib/perl5/site_perl:/nix/store/xbjpjiklhbx8zhqjf6w840w7rwm24l35-perl5.42.3-TermReadKey-2.38/lib/perl5/site_perl\"\n# ideally unneeded, but added for backwards compatibility\nln -s $out/libexec/git-core/git-credential-netrc $out/bin/\n\nwrapProgram $out/libexec/git-core/git-cvsimport \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/pa014a5yifla1r5mxh1r3qwfy9h0qd3i-perl5.42.3-libwww-perl-6.83/lib/perl5/site_perl:/nix/store/lnfvr020s1s3l2y2s5pldmzjq72y62vv-perl5.42.3-URI-5.21/lib/perl5/site_perl:/nix/store/xbjpjiklhbx8zhqjf6w840w7rwm24l35-perl5.42.3-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-archimport \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/pa014a5yifla1r5mxh1r3qwfy9h0qd3i-perl5.42.3-libwww-perl-6.83/lib/perl5/site_perl:/nix/store/lnfvr020s1s3l2y2s5pldmzjq72y62vv-perl5.42.3-URI-5.21/lib/perl5/site_perl:/nix/store/xbjpjiklhbx8zhqjf6w840w7rwm24l35-perl5.42.3-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-instaweb \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/pa014a5yifla1r5mxh1r3qwfy9h0qd3i-perl5.42.3-libwww-perl-6.83/lib/perl5/site_perl:/nix/store/lnfvr020s1s3l2y2s5pldmzjq72y62vv-perl5.42.3-URI-5.21/lib/perl5/site_perl:/nix/store/xbjpjiklhbx8zhqjf6w840w7rwm24l35-perl5.42.3-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-cvsexportcommit \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/pa014a5yifla1r5mxh1r3qwfy9h0qd3i-perl5.42.3-libwww-perl-6.83/lib/perl5/site_perl:/nix/store/lnfvr020s1s3l2y2s5pldmzjq72y62vv-perl5.42.3-URI-5.21/lib/perl5/site_perl:/nix/store/xbjpjiklhbx8zhqjf6w840w7rwm24l35-perl5.42.3-TermReadKey-2.38/lib/perl5/site_perl\"\n\n# gzip (and optionally bzip2, xz, zip) are runtime dependencies for\n# gitweb.cgi, need to patch so that it's found\nsed -i -e \"s|'compressor' => \\['gzip'|'compressor' => ['/nix/store/k1z3ys65nbrdc60975wajrj4xjwaqqm4-gzip-1.14/bin/gzip'|\" \\\n    $out/share/gitweb/gitweb.cgi\n# Give access to CGI.pm and friends (was removed from perl core in 5.22)\nfor p in /nix/store/dn5b97k658v3fjy88bdpxqjkvg1ggnli-perl5.42.3-CGI-4.59 /nix/store/mjkrk0rmvbs4b81hc79xj0mzmq9ws9ji-perl5.42.3-HTML-Parser-3.85 /nix/store/fnn77cc9k8v18c1kx0xnygdrl8a4ac67-perl5.42.3-CGI-Fast-2.16 /nix/store/z1d6s1vqmxqkxd1ak4hqhsyjy723az9g-perl5.42.3-FCGI-0.82 /nix/store/2bwgjri0khvc9psgwbym9chfcbkq3rbm-perl5.42.3-FCGI-ProcManager-0.28 /nix/store/cyqbsymjvxbzsc72jiir4c6bmn7a2lb0-perl5.42.3-HTML-TagCloud-0.38; do\n    sed -i -e \"/use CGI /i use lib \\\"$p/lib/perl5/site_perl\\\";\" \\\n        \"$out/share/gitweb/gitweb.cgi\"\ndone\npatchShebangs $out/share/git/contrib/fast-import/import-zips.py\nrm $out/libexec/git-core/git-svn\n# wrap git-send-email\nwrapProgram $out/libexec/git-core/git-send-email \\\n             --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/m732fivivi7958k8l2cgddpvx3jds91n-perl5.42.3-libnet-3.15/lib/perl5/site_perl:/nix/store/1drp0a6d95agkgyacxyzjr36ysx7g4pk-perl5.42.3-Net-SMTP-SSL-1.04/lib/perl5/site_perl:/nix/store/rqj30mz4yccizaq5f5y1m00h2nw1za9c-perl5.42.3-IO-Socket-SSL-2.083/lib/perl5/site_perl:/nix/store/884ysmz7s6c4nc5yri8mn78003wifb9n-perl5.42.3-Net-SSLeay-1.92/lib/perl5/site_perl:/nix/store/vmbl35hdfaqpvsa0i5azm1dsmj1n61yj-perl5.42.3-Authen-SASL-2.2100/lib/perl5/site_perl:/nix/store/2kgn78bsw0k5pcxc2icqpajw03b9bgqg-perl5.42.3-Digest-HMAC-1.05/lib/perl5/site_perl\"\n# Install man pages\nmake \"${flagsArray[@]}\" install install-html \\\n  -C Documentation\nfor prog in bin/gitk libexec/git-core/git-gui; do\n  rm \"$out/$prog\"\ndone\nunset flagsArray\n","postPatch":"# Fix references to gettext introduced by ./git-sh-i18n.patch\nsubstituteInPlace git-sh-i18n.sh \\\n    --subst-var-by gettext /nix/store/r6cl7zk1vhckkbnrjvvgf5ah1a23s090-gettext-1.0\nsubstituteInPlace contrib/credential/libsecret/Makefile \\\n    --replace-fail 'pkg-config' \"$PKG_CONFIG\"\n# ensure we are using the correct shell when executing the test scripts\npatchShebangs t/*.sh\n","preBuild":"makeFlagsArray+=( perllibdir=$out/$(perl -MConfig -wle 'print substr $Config{installsitelib}, 1 + length $Config{siteprefixexp}') )\n","preInstall":"","preInstallCheck":"# Some tests break with high concurrency\n# https://github.com/NixOS/nixpkgs/pull/403237\nif ((NIX_BUILD_CORES > 32)); then\n  NIX_BUILD_CORES=32\nfi\n\ninstallCheckFlagsArray+=(\n  GIT_PROVE_OPTS=\"--jobs $NIX_BUILD_CORES --failures --state=failed,save\"\n  GIT_TEST_INSTALLED=$out/bin\n  NO_SVN_TESTS=y\n)\n\nfunction disable_test {\n  local test=$1 pattern=$2\n  if [ $# -eq 1 ]; then\n    mv t/{,skip-}$test.sh || true\n  else\n    sed -i t/$test.sh \\\n      -e \"/^\\s*test_expect_.*$pattern/,/^\\s*' *\\$/{s/^/: #/}\"\n  fi\n}\n\n# Shared permissions are forbidden in sandbox builds:\nsubstituteInPlace t/test-lib.sh \\\n  --replace \"test_set_prereq POSIXPERM\" \"\"\n# TODO: Investigate while these still fail (without POSIXPERM):\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'shared overrides system'\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'init honors global core.sharedRepository'\n# Tested to fail: 2.46.0\ndisable_test t1301-shared-repo\n# /build/git-2.44.0/contrib/completion/git-completion.bash: line 452: compgen: command not found\ndisable_test t9902-completion\n# Flaky tests:\ndisable_test t0027-auto-crlf\ndisable_test t1451-fsck-buffer\ndisable_test t5319-multi-pack-index\ndisable_test t6421-merge-partial-clone\ndisable_test t7504-commit-msg-hook\ndisable_test t5515-fetch-merge-logic\ndisable_test t4104-apply-boundary\ndisable_test t7002-mv-sparse-checkout\ndisable_test t4122-apply-symlink-inside\ndisable_test t7513-interpret-trailers\ndisable_test t2200-add-update\n\n# Fails reproducibly on ZFS on Linux with formD normalization\ndisable_test t0021-conversion\ndisable_test t3910-mac-os-precompose\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"src":"/nix/store/drcyzlalnx264vlmp2js5vp2kkvyn132-git-2.54.0.tar.xz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":false,"stripDebugList":["lib","libexec","bin","share/git/contrib/credential"],"system":"x86_64-linux","version":"2.54.0"},"system":"x86_64-linux","version":4},"32n7i1qcxzjy4adll5sz3y621slq252c-nixos-configuration-reference-manpage.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stden