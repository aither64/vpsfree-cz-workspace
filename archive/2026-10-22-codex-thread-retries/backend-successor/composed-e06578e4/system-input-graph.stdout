A-1\\\";\\n      WIDTH = 1920;\\n      HEIGHT = 1080;\\n      HZ = 60;\\n    }\\n  ];\\n  TRANSFORM = [\\n    {\\n      NAME_DESC = \\\"eDP-1\\\"\\n      TRANSFORM = \\\"FLIPPED-90\\\";\\n    }\\n  ];\\n};\\n\"},\"loc\":[\"services\",\"way-displays\",\"settings\"],\"readOnly\":false,\"type\":\"null or YAML 1.1 value\"},\"services.way-displays.systemdTarget\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/way-displays.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/way-displays.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.wayland.systemd.target\"},\"description\":\"Systemd target to bind to.\\n\",\"loc\":[\"services\",\"way-displays\",\"systemdTarget\"],\"readOnly\":false,\"type\":\"string\"},\"services.wayle.autoInstallDependencies\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wayle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wayle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to automatically install soft dependencies used by wayle that\\nwill be required based on your config.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"services\",\"wayle\",\"autoInstallDependencies\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.wayle.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wayle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wayle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable wayle shell.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"wayle\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.wayle.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wayle.nix>\",\"url\":\"https://github.com/nix-community/h