ression\",\"text\":\"{\\n  filename = \\\"~/.config/mutt/mailboxes\\\";\\n  footer = \\\"'\\\\\\\\n'\\\";\\n  header = \\\"'mailboxes '\\\";\\n  peritem = \\\"'+%(accountname)s/%(foldername)s'\\\";\\n  sep = \\\"' '\\\";\\n}\"},\"loc\":[\"programs\",\"offlineimap\",\"extraConfig\",\"mbnames\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean)\"},\"programs.offlineimap.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/offlineimap>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/offlineimap\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.offlineimap\"},\"description\":\"The offlineimap package to use. Can be used to specify extensions.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.offlineimap.overridePythonAttrs ( old: {\\n  propagatedBuildInputs = old.propagatedBuildInputs\\n    ++ (with pkgs.python3Packages; [\\n      requests_oauthlib xdg gpgme]);\\n})\"},\"loc\":[\"programs\",\"offlineimap\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.offlineimap.pythonFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/offlineimap>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/offlineimap\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  import subprocess\\n  \\n  def get_pass(service, cmd):\\n      return subprocess.check_output(cmd, )\\n''\"},\"description\":\"Python code that can then be used in other parts of the\\nconfiguration.\\n\",\"loc\":[\"programs\",\"offlineimap\",\"pythonFile\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.oh-my-posh.configFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/oh-my-posh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/oh-my-posh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to a custom configuration path, can be json, yaml or toml.\\n\",\"loc\":[\"programs\",\"oh-my-posh\",\"configFile\"],\"readOnly\":false,\"type\":\"null or string or absolute path\"},\"programs.oh-my-posh.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/oh-my-posh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/oh-my-posh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable oh-my-posh, a prompt theme engine for any shell.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"oh-my-posh\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.oh-my-posh.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/oh-my-posh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/oh-my-posh.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"oh-my-posh\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.oh-my-posh.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/oh-my-posh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/oh-my-posh.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"oh-my-posh\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.oh-my-posh.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/oh-my-posh.nix>\",\"url\":\"https://gith