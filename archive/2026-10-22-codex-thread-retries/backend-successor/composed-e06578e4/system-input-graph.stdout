redAttrs":"","allowSubstitutes":"","buildCommand":"mkdir -p $out\n\n# Copy the upstream systemd units we're interested in.\nfor i in app.slice background.slice basic.target bluetooth.target capsule@.target default.target exit.target graphical-session-pre.target graphical-session.target paths.target printer.target session.slice shutdown.target smartcard.target sockets.target sound.target systemd-exit.service timers.target xdg-desktop-autostart.target systemd-tmpfiles-clean.service systemd-tmpfiles-clean.timer systemd-tmpfiles-setup.service; do\n  fn=/nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/example/systemd/user/$i\n  if ! [ -e $fn ]; then echo \"missing $fn\"; false; fi\n  if [ -L $fn ]; then\n    target=\"$(readlink \"$fn\")\"\n    if [ ${target:0:3} = ../ ]; then\n      ln -s \"$(readlink -f \"$fn\")\" $out/\n    else\n      cp -pd $fn $out/\n    fi\n  else\n    ln -s $fn $out/\n  fi\ndone\n\n# Copy .wants links, but only those that point to units that\n# we're interested in.\nfor i in ; do\n  fn=/nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/example/systemd/user/$i\n  if ! [ -e $fn ]; then echo \"missing $fn\"; false; fi\n  x=$out/$(basename $fn)\n  mkdir $x\n  for i in $fn/*; do\n    y=$x/$(basename $i)\n    cp -pd $i $y\n    if ! [ -e $y ]; then rm $y; fi\n  done\ndone\n\n# Symlink all units provided listed in systemd.packages.\npackages=\"/nix/store/5np0yidzrnyjbb243hvgqpgpss865p0n-nix-2.34.9 /nix/store/2hc6lqclam28wdnjgd8gjdmw168mlf1a-dbus-1.16.2 /nix/store/yly12cgk8diwbba5pjdr7g0b3hk8db0c-dbus-broker-37 /nix/store/0bmapmnznzaxgx76jhzbznhlwq738g03-util-linux-2.42.3-bin /nix/store/fvxwz94g9mnjmsnx9hpj24r9jng5znzl-util-linux-2.42.3-lastlog\"\n\n# Filter duplicate directories\ndeclare -A unique_packages\nfor k in $packages ; do unique_packages[$k]=1 ; done\n\nfor i in ${!unique_packages[@]}; do\n  for fn in $i/etc/systemd/user/* $i/lib/systemd/user/*; do\n    if ! [[ \"$fn\" =~ .wants$ ]]; then\n      if [[ -d \"$fn\" ]]; then\n        targetDir=\"$out/$(basename \"$fn\")\"\n        mkdir -p \"$targetDir\"\n        /nix/store/smriw9hf43mvqp4v7nrn4d0wgny9yvk0-lndir-1.0.5/bin/lndir \"$fn\" \"$targetDir\"\n      else\n        ln -s $fn $out/\n      fi\n    fi\n  done\ndone\n\n# Symlink units defined by systemd.units where override strategy\n# shall be automatically detected. If these are also provided by\n# systemd or systemd.packages, then add them as\n# <unit-name>.d/overrides.conf, which makes them extend the\n# upstream unit.\nfor i in /nix/store/fkgpvysmp3i9ick3vcqf3jxckg1a928m-unit-dbus-broker.service /nix/store/36g710y8k216icbapl8b0gn6clwsc1s1-unit-dbus.service /nix/store/fiz75wibqx1pkzcy3cf6s3lssl1nczi5-unit-dbus.socket /nix/store/c9n0kza43k0rg5vlsy0dy1ip2yyja9wg-unit-nixos-activation.service /nix/store/vzqvrz3nnwm2ysn9ka4qbdx9fcnhy9y5-unit-nixos-fake-graphical-session.target /nix/store/f52kv12y7n0svqcqyvak9rpbdmjl7jj6-unit-systemd-tmpfiles-clean.timer /nix/store/aq444q21lwlqh8a833xaryfmv3s0gzmz-unit-systemd-tmpfiles-setup.service; do\n  fn=$(basename $i/*)\n  if [ -e $out/$fn ]; then\n    if [ \"$(readlink -f $i/$fn)\" = /dev/null ]; then\n      ln -sfn /dev/null $out/$fn\n    else\n      mkdir -p $out/$fn.d\nln -s $i/$fn $out/$fn.d/overrides.conf\n\n    fi\n else\n    ln -fs $i/$fn $out/\n  fi\ndone\n\n# Symlink units defined by systemd.units which shall be\n# treated as drop-in file.\nfor i in ; do\n  fn=$(basename $i/*)\n  mkdir -p $out/$fn.d\n  ln -s $i/$fn $out/$fn.d/overrides.conf\ndone\n\n# Create service aliases from aliases option.\nln -sfn 'dbus-broker.service' $out/'dbus.service'\n\n\n# Create .wants, .upholds and .requires symlinks from the wantedBy, upheldBy and\n# requiredBy options.\nmkdir -p $out/'sockets.target.wants'\nln -sfn '../dbus.socket' $out/'sockets.target.wants'/\nmkdir -p $out/'default.target.wants'\nln -sfn '../nixos-activation.service' $out/'default.target.wants'/\nmkdir -p $out/'timers.target.wants'\nln -sfn '../systemd-tmpfiles-clean.timer' $out/'timers.target.wants'/\nmkdir -p $out/'basic.target.wants'\nln -sfn '../systemd-tmpfiles-setup.service' $out/'basic.target.wants'/\n\n\n\n\n\n\n\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"user-units","nativeBuildInputs":"","out":"/nix/store/j0s0jjynpq1ws4pffyzfwl3dgc8qly91-user-units","outputs":"out","passAsFile":"buildCommand","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"39nfm2472znpir8ql0pspdfhgpw2s3p2-unit-dbus.service.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"6nvqr8wjg8kd0gw3a8yk3qcdaky170va-dbus-1.16.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"cj13fcsp1y46gd6c9i53c9ahcx7hjlsj-unit-systemd-tmpfiles-clean.timer.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"fkr3mnzy7i96x0dcnw97bw0s2dbksc68-unit-nixos-fake-graphical-session.target.drv":{"dynamicOutputs":{},"outputs":["out"]},"k8mm8xc05mprnznf77rac3fhd67sc7nx-util-linux-2.42.3.drv":{"dynamicOutputs":{},"outputs":["bin","lastlog"]},"ngkwybvqq73iza3xj52iba4gcfifh7yc-lndir-1.0.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"p3rhflvmfsk5nwwvndv74n5l4cxdwvbz-nix-2.34.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"w1llhi7xzdjgxfva3rbk6jdng18gp42l-unit-systemd-tmpfiles-setup.service.drv":{"dynamicOutputs":{},"outputs":["out"]},"y4i860ajzy8838im17