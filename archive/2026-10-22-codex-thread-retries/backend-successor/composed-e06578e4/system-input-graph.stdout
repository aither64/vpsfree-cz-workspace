anager/modules/programs/borgmatic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/borgmatic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra settings.\",\"loc\":[\"programs\",\"borgmatic\",\"backups\",\"<name>\",\"location\",\"extraConfig\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.borgmatic.backups.<name>.location.patterns\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/borgmatic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/borgmatic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Patterns to include/exclude.\\n\\nSee the output of `borg help patterns` for the syntax. Pattern paths\\nare relative to `/` even when a different recursion root is set.\\n\\nMutually exclusive with [](#opt-programs.borgmatic.backups._name_.location.sourceDirectories).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"R /home/user\\\"\\n  \\\"- home/user/.cache\\\"\\n  \\\"- home/user/Downloads\\\"\\n  \\\"+ home/user/Videos/Important Video\\\"\\n  \\\"- home/user/Videos\\\"\\n]\"},\"loc\":[\"programs\",\"borgmatic\",\"backups\",\"<name>\",\"location\",\"patterns\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"programs.borgmatic.backups.<name>.location.repositories\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/borgmatic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/borgmatic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of local or remote repositories with paths and optional labels.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    \\\"path\\\" = \\\"ssh://myuser@myrepo.myserver.com/./repo\\\";\\n    \\\"label\\\" = \\\"server\\\";\\n  }\\n  {\\n    \\\"path\\\" = \\\"/var/lib/backups/local.borg\\\";\\n    \\\"label\\\" = \\\"local\\\";\\n  }\\n]\\n\"},\"loc\":[\"programs\",\"borgmatic\",\"backups\",\"<name>\",\"location\",\"repositories\"],\"readOnly\":false,\"type\":\"list of (string or (submodule))\"},\"programs.borgmatic.backups.<name>.location.repositories.*.label\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Short text describing the repository. Can be used with the\\n`--repository` flag to select a repository.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"remote\\\"\"},\"loc\":[\"programs\",\"borgmatic\",\"backups\",\"<name>\",\"location\",\"repositories\",\"*\",\"label\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.borgmatic.backups.<name>.location.repositories.*.path\":{\"declarations\":[],\"description\":\"Path of the repository.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ssh://myuser@myrepo.myserver.com/./repo\\\"\"},\"loc\":[\"programs\",\"borgmatic\",\"backups\",\"<name>\",\"location\",\"repositories\",\"*\",\"path\"],\"readOnly\":false,\"type\":\"string\"},\"programs.borgmatic.backups.<name>.location.sourceDirectories\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/borgmatic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/borgmatic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Directories to backup.\\n\\nMutually exclusive with [](#opt-programs.borgmatic.backups._name_.location.patterns).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[config.home.homeDirectory]\"},\"loc\":[\"programs\",\"borgmatic\",\"backups\",\"<name>\",\"location\",\"sourceDirectories\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"programs.borgmatic.backups.<name>.output.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/borgmatic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/