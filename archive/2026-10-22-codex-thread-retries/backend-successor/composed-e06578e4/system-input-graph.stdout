fish.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable enable the bind. Set false if you want to ignore the bind.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"fish\",\"binds\",\"<name>\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.fish.binds.<name>.erase\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fish.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fish.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable remove bind.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"fish\",\"binds\",\"<name>\",\"erase\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.fish.binds.<name>.mode\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fish.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fish.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Specify the bind mode that the bind is used in\",\"loc\":[\"programs\",\"fish\",\"binds\",\"<name>\",\"mode\"],\"readOnly\":false,\"type\":\"null or one of \\\"default\\\", \\\"insert\\\", \\\"paste\\\" or string\"},\"programs.fish.binds.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fish.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fish.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The key name that is used for the bind.\\nIf null, the attribute set key is used.\\n\",\"loc\":[\"programs\",\"fish\",\"binds\",\"<name>\",\"name\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.fish.binds.<name>.operate\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fish.nix>\",\"url\":\"https://github.com/nix-comm