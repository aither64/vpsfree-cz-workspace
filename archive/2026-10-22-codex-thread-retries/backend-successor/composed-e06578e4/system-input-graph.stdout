",\"NSAutomaticDashSubstitutionEnabled\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"targets.darwin.defaults.NSGlobalDomain.NSAutomaticPeriodSubstitutionEnabled\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/darwin/user-defaults/opts-allhosts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/darwin/user-defaults/opts-allhosts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to enable period with double space.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"targets\",\"darwin\",\"defaults\",\"NSGlobalDomain\",\"NSAutomaticPeriodSubstitutionEnabled\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"targets.darwin.defaults.NSGlobalDomain.NSAutomaticQuoteSubstitutionEnabled\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/darwin/user-defaults/opts-allhosts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/darwin/user-defaults/opts-allhosts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to enable smart quotes.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"targets\",\"darwin\",\"defaults\",\"NSGlobalDomain\",\"NSAutomaticQuoteSubstitutionEnabled\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"targets.darwin.defaults.NSGlobalDomain.NSAutomaticSpellingCorrectionEnabled\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/darwin/user-defaults/opts-allhosts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/darwin/user-defaults/opts-allhosts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to enable spelling correction.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"targets\",\"darwin\",\"defaults\",\"NSGlobalDomain\",\"NSAutomaticSpellingCorrectionEnabled\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"targets.darwin.keybindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/darwin/keybindings.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/darwin/keybindings.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"This will configure the default keybindings for text fields in macOS\\napplications. See\\n[Apple's documentation](https://developer.apple.com/library/archive/documentation/Cocoa/Conceptual/EventOverview/TextDefaultsBindings/TextDefaultsBindings.html)\\nfor more details.\\n\\n::: {.warning}\\nExisting keybinding configuration will be wiped when using this\\noption.\\n:::\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"^u\\\" = \\\"deleteToBeginningOfLine:\\\";\\n  \\\"^w\\\" = \\\"deleteWordBackward:\\\";\\n}\"},\"loc\":[\"targets\",\"darwin\",\"keybindings\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"targets.darwin.linkApps.directory\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/darwin/linkapps.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/darwin/linkapps.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Applications/Home Manager Apps\\\"\"},\"description\":\"Path to link apps relative to the home directory.\",\"loc\":[\"targets\",\"darwin\",\"linkApps\",\"directory\"],\"readOnly\":false,\"type\":\"string\"},\"targets.darwin.linkApps.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/darwin/linkapps.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/darwin/linkapps.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.stdenv.hostPlatform.isDarwin && (lib.versionOlder config.home.stateVersion \\\"25.11\\\")\"},\"description\":\"Whether to enable linking macOS applications to the user environment.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"targets\",\"darwin\",\"linkApps\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"targets.darwin.search\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/darwin/search.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/darwin/search.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Default search engine.\",\"loc\":[\"targets\",\"darwin\",\"search\"],\"readOnly\":false,\"type\":\"null or one of \\\"Bing\\\", \\\"DuckDuckGo\\\", \\\"Ecosia\\\", \\\"Google\\\", \\\"Yahoo\\\"\"},\"targets.genericLinux.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable settings that make Home Manager work better on\\nGNU/Linux distributions other than NixOS.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"targets\",\"genericLinux\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"targets.genericLinux.gpu.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/gpu>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/gpu\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.targets.genericLinux.enable && config.targets.genericLinux.nixGL.packages == null\"},\"description\":\"Whether to enable GPU driver integration for non-NixOS systems.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"targets\",\"genericLinux\",\"gpu\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"targets.genericLinux.gpu.nixStateDirectory\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/gpu>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/gpu\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/nix/var/nix\\\"\"},\"description\":\"The path to the Nix state directory. This only needs to be changed\\nfrom default if the path was overridden, e.g., by setting the\\n`NIX_STATE_DIR` environment variable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/var/lib/nix\\\"\"},\"loc\":[\"targets\",\"genericLinux\",\"gpu\",\"nixStateDirectory\"],\"readOnly\":false,\"type\":\"absolute path\"},\"targets.genericLinux.gpu.nvidia.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/gpu>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/gpu\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable proprietary Nvidia drivers.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"targets\",\"genericLinux\",\"gpu\",\"nvidia\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"targets.genericLinux.gpu.nvidia.sha256\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/gpu>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/gpu\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The hash of the downloaded driver file. It can be obtained by\\nrunning, for example,\\n\\n```sh\\nnix store prefetch-file https://download.nvidia.com/XFree86/Linux-x86_64/@VERSION@/NVIDIA-Linux-x86_64-@VERSION@.run\\n```\\n\\nwhere `@VERSION@` is replaced with the exact driver version.\\nIf you are on ARM, replace Linux-x86_64 with Linux-aarch64.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"sha256-hfK1D5EiYcGRegss9+H5dDr/0Aj9wPIJ9NVWP3dNUC0=\\\"\"},\"loc\":[\"targets\",\"genericLinux\",\"gpu\",\"nvidia\",\"sha256\"],\"readOnly\":false,\"type\":\"null or string matching the pattern sha256-.*=\"},\"targets.genericLinux.gpu.nvidia.version\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/gpu>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/gpu\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The exact version of Nvidia drivers to use. This version **must**\\nmatch the version of the driver used by the host OS.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"550.163.01\\\"\"},\"loc\":[\"targets\",\"genericLinux\",\"gpu\",\"nvidia\",\"version\"],\"readOnly\":false,\"type\":\"null or string matching the pattern [0-9]{3}\\\\.[0-9]{2,3}(\\\\.[0-9]{2,3})?\"},\"targets.genericLinux.gpu.packages\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/gpu>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/gpu\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs\"},\"description\":\"The Nixpkgs package set where drivers are taken from.\",\"loc\":[\"targets\",\"genericLinux\",\"gpu\",\"packages\"],\"readOnly\":false,\"type\":\"attribute set\"},\"targets.genericLinux.gpu.setupPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/gpu>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/gpu\"}],\"description\":\"Resulting setup package.\",\"loc\":[\"targets\",\"genericLinux\",\"gpu\",\"setupPackage\"],\"readOnly\":true,\"type\":\"package\"},\"targets.genericLinux.nixGL.defaultWrapper\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/nixgl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/nixgl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"mesa\\\"\"},\"description\":\"The package wrapper function available for use as `(config.lib.nixGL.wrap\\n<package>)`. Intended to start programs on the main GPU.\\n\\nWrapper functions can be found under `config.lib.nixGL.wrappers`. They\\ncan be used directly, however, setting this option provides a convenient\\nshorthand.\\n\\nThe following wrappers are available:\\n- mesa\\n- mesaPrime\\n- nvidia\\n- nvidiaPrime\\n\",\"loc\":[\"targets\",\"genericLinux\",\"nixGL\",\"defaultWrapper\"],\"readOnly\":false,\"type\":\"one of \\\"mesa\\\", \\\"mesaPrime\\\", \\\"nvidia\\\", \\\"nvidiaPrime\\\"\"},\"targets.genericLinux.nixGL.installScripts\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/nixgl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/nixgl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"For each wrapper `wrp` named in the provided list, a wrapper script\\nnamed `nixGLWrp` is installed into the environment. These scripts are\\nuseful for running programs not installed via Home Manager.\\n\\nThe following wrappers are available:\\n- mesa\\n- mesaPrime\\n- nvidia\\n- nvidiaPrime\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"mesa\\\"\\n  \\\"mesaPrime\\\"\\n]\"},\"loc\":[\"targets\",\"genericLinux\",\"nixGL\",\"installScripts\"],\"readOnly\":false,\"type\":\"null or (list of (one of \\\"mesa\\\", \\\"mesaPrime\\\", \\\"nvidia\\\", \\\"nvidiaPrime\\\"))\"},\"targets.genericLinux.nixGL.offloadWrapper\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/nixgl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/nixgl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"mesaPrime\\\"\"},\"description\":\"The package wrapper function available for use as\\n`(config.lib.nixGL.wrapOffload <package>)`. Intended to start programs\\non the secondary GPU.\\n\\nWrapper functions can be found under `config.lib.nixGL.wrappers`. They\\ncan be used directly, however, setting this option provides a convenient\\nshorthand.\\n\\nThe following wrappers are available:\\n- mesa\\n- mesaPrime\\n- nvidia\\n- nvidiaPrime\\n\",\"loc\":[\"targets\",\"genericLinux\",\"nixGL\",\"offloadWrapper\"],\"readOnly\":false,\"type\":\"one of \\\"mesa\\\", \\\"mesaPrime\\\", \\\"nvidia\\\", \\\"nvidiaPrime\\\"\"},\"targets.genericLinux.nixGL.packages\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/nixgl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/nixgl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The nixGL package set containing GPU library wrappers. This can be used\\nto provide OpenGL and Vulkan access to applications on non-NixOS systems\\nby using `(config.lib.nixGL.wrap <package>)` for the default wrapper, or\\n`(config.lib.nixGL.wrappers.<wrapper> <package>)` for any available\\nwrapper.\\n\\nThe wrapper functions are always available. If this option is empty (the\\ndefault), they are a no-op. This is useful on NixOS where the wrappers\\nare unnecessary.\\n\\nNote that using any Nvidia wrapper requires building the configuration\\nwith the `--impure` option.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"inputs.nixGL.packages\"},\"loc\":[\"targets\",\"genericLinux\",\"nixGL\",\"packages\"],\"readOnly\":false,\"type\":\"null or (attribute set)\"},\"targets.genericLinux.nixGL.prime.card\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/nixgl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/nixgl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"1\\\"\"},\"description\":\"Selects the non-default graphics card used for PRIME render offloading.\\nThe value can be:\\n\\n- a number, selecting the n-th non-default GPU;\\n- a PCI bus id in the form `pci-XXX_YY_ZZ_U`;\\n- a PCI id in the form `vendor_id:device_id`\\n\\nFor more information, consult the Mesa documentation on the `DRI_PRIME`\\nenvironment variable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pci-0000_06_00_0\\\"\"},\"loc\":[\"targets\",\"genericLinux\",\"nixGL\",\"prime\",\"card\"],\"readOnly\":false,\"type\":\"string\"},\"targets.genericLinux.nixGL.prime.installScript\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/nixgl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/nixgl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"If this option is set, the wrapper script `prime-offload` is installed\\ninto the environment. It allows starting programs on the secondary GPU\\nselected by the `nixGL.prime.card` option. This makes sense when the\\nprogram is not already using one of nixGL PRIME wrappers, or for\\nprograms not installed from Nixpkgs.\\n\\nThis option can be set to either \\\"mesa\\\" or \\\"nvidia\\\", making the script\\nuse one or the other graphics library.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"mesa\\\"\"},\"loc\":[\"targets\",\"genericLinux\",\"nixGL\",\"prime\",\"installScript\"],\"readOnly\":false,\"type\":\"null or one of \\\"mesa\\\", \\\"nvidia\\\"\"},\"targets.genericLinux.nixGL.prime.nvidiaProvider\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/nixgl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/nixgl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"If this option is set, it overrides the offload provider for Nvidia\\nPRIME offloading. Consult the proprietary Nvidia driver documentation\\non the `__NV_PRIME_RENDER_OFFLOAD_PROVIDER` environment variable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"NVIDIA-G0\\\"\"},\"loc\":[\"targets\",\"genericLinux\",\"nixGL\",\"prime\",\"nvidiaProvider\"],\"readOnly\":false,\"type\":\"null or string\"},\"targets.genericLinux.nixGL.vulkan.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/targets/generic-linux/nixgl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/targets/generic-linux/nixgl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Vulkan in nixGL wrappers.\\n\\nThis is disabled by default because Vulkan brings in several libraries\\nthat can cause symbol version conflicts in wrapped programs. Your\\nmileage may vary.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"targets\",\"genericLinux\",\"nixGL\",\"vulkan\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"uninstall\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/uninstall.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/uninstall.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to set up a minimal configuration that will remove all managed\\nfiles and packages.\\n\\nUse this with extreme care since running the generated activation script\\nwill remove all Home Manager state from your user environment. This\\nincludes removing all your historic Home Manager generations.\\n\",\"loc\":[\"uninstall\"],\"readOnly\":false,\"type\":\"boolean\"},\"vdirsyncer.auth\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Authentication settings. The default is `basic`.\\n\",\"loc\":[\"vdirsyncer\",\"auth\"],\"readOnly\":false,\"type\":\"null or one of \\\"basic\\\", \\\"digest\\\", \\\"guess\\\"\"},\"vdirsyncer.authCert\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Either a path to a certificate with a client certificate and\\nthe key or a list of paths to the files with them.\\n\",\"loc\":[\"vdirsyncer\",\"authCert\"],\"readOnly\":false,\"type\":\"null or string or list of string\"},\"vdirsyncer.clientIdCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A command that prints the OAuth credentials to standard\\noutput.\\n\\nSee\\n<https://vdirsyncer.pimutils.org/en/stable/config.html#google>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"pass\\\"\\n  \\\"client_id\\\"\\n]\"},\"loc\":[\"vdirsyncer\",\"clientIdCommand\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"vdirsyncer.clientSecretCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A command that prints the OAuth credentials to standard\\noutput.\\n\\nSee\\n<https://vdirsyncer.pimutils.org/en/stable/config.html#google>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"pass\\\"\\n  \\\"client_secret\\\"\\n]\"},\"loc\":[\"vdirsyncer\",\"clientSecretCommand\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"vdirsyncer.collections\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The collections to synchronize between the storages.\\n\",\"loc\":[\"vdirsyncer\",\"collections\"],\"readOnly\":false,\"type\":\"null or (list of (string or list of string))\"},\"vdirsyncer.conflictResolution\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"What to do in case of a conflict between the storages. Either\\n`remote wins` or\\n`local wins` or\\na list that contains a command to run. By default, an error\\nmessage is printed.\\n\",\"loc\":[\"vdirsyncer\",\"conflictResolution\"],\"readOnly\":false,\"type\":\"null or one of \\\"remote wins\\\", \\\"local wins\\\" or list of string\"},\"vdirsyncer.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable synchronization using vdirsyncer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"vdirsyncer\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"vdirsyncer.itemTypes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Kinds of items to show. The default is to show everything.\\nThis depends on particular features of the server, the results\\nare not validated.\\n\",\"loc\":[\"vdirsyncer\",\"itemTypes\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"vdirsyncer.metadata\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Metadata keys that should be synchronized when vdirsyncer\\nmetasync is executed.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"color\\\"\\n  \\\"displayname\\\"\\n]\"},\"loc\":[\"vdirsyncer\",\"metadata\"],\"readOnly\":false,\"type\":\"list of string\"},\"vdirsyncer.partialSync\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"What should happen if synchronization in one direction\\nis impossible due to one storage being read-only.\\nDefaults to `revert`.\\n\\nSee\\n<https://vdirsyncer.pimutils.org/en/stable/config.html#pair-section>\\nfor more information.\\n\",\"loc\":[\"vdirsyncer\",\"partialSync\"],\"readOnly\":false,\"type\":\"null or one of \\\"revert\\\", \\\"error\\\", \\\"ignore\\\"\"},\"vdirsyncer.postHook\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Command to call for each item creation and modification.\\nThe command will be called with the path of the new/updated\\nfile.\\n\",\"loc\":[\"vdirsyncer\",\"postHook\"],\"readOnly\":false,\"type\":\"null or strings concatenated with \\\"\\\\n\\\"\"},\"vdirsyncer.timeRange\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A time range to synchronize. start and end can be any Python\\nexpression that returns a `datetime.datetime`\\nobject.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  end = \\\"datetime.now() + timedelta(days=365)\\\";\\n  start = \\\"datetime.now() - timedelta(days=365)\\\";\\n}\"},\"loc\":[\"vdirsyncer\",\"timeRange\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"vdirsyncer.timeRange.end\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"description\":\"End of time range to show.\",\"loc\":[\"vdirsyncer\",\"timeRange\",\"end\"],\"readOnly\":false,\"type\":\"string\"},\"vdirsyncer.timeRange.start\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"description\":\"Start of time range to show.\",\"loc\":[\"vdirsyncer\",\"timeRange\",\"start\"],\"readOnly\":false,\"type\":\"string\"},\"vdirsyncer.tokenFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A file path where access tokens are stored.\\n\",\"loc\":[\"vdirsyncer\",\"tokenFile\"],\"readOnly\":false,\"type\":\"null or string\"},\"vdirsyncer.urlCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A command that prints the URL of the storage.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"~/get-url.sh\\\"\\n]\"},\"loc\":[\"vdirsyncer\",\"urlCommand\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"vdirsyncer.useVcard4\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Specifies whether vdirsyncer should request vCards in version 4.0.\\nIf set to `false` then vdirsyncer will default to version 3.0.\\n\",\"loc\":[\"vdirsyncer\",\"useVcard4\"],\"readOnly\":false,\"type\":\"boolean\"},\"vdirsyncer.userAgent\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The user agent to report to the server. Defaults to\\n`vdirsyncer`.\\n\",\"loc\":[\"vdirsyncer\",\"userAgent\"],\"readOnly\":false,\"type\":\"null or string\"},\"vdirsyncer.userNameCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A command that prints the user name to standard output.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"~/get-username.sh\\\"\\n]\"},\"loc\":[\"vdirsyncer\",\"userNameCommand\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"vdirsyncer.verify\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Null or path to certificate to verify SSL against\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/path/to/cert.pem\\\"\"},\"loc\":[\"vdirsyncer\",\"verify\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"vdirsyncer.verifyFingerprint\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer/accounts.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer/accounts.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Optional. SHA1 or MD5 fingerprint of the expected server certificate.\\n\\nSee\\n<https://vdirsyncer.pimutils.org/en/stable/ssl-tutorial.html#ssl-tutorial>\\nfor more information.\\n\",\"loc\":[\"vdirsyncer\",\"verifyFingerprint\"],\"readOnly\":false,\"type\":\"null or string\"},\"wayland.systemd.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/wayland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/wayland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"graphical-session.target\\\"\"},\"description\":\"The systemd target that will automatically start the graphical Wayland services.\\nThis option is a generalization of individual `systemd.target` or `systemdTarget`,\\nand affect all Wayland services by default.\\n\\nWhen setting this value to `\\\"sway-session.target\\\"`,\\nmake sure to also enable {option}`wayland.windowManager.sway.systemd.enable`,\\notherwise the service may never be started.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"sway-session.target\\\"\"},\"loc\":[\"wayland\",\"systemd\",\"target\"],\"readOnly\":false,\"type\":\"string\"},\"wayland.windowManager.hyprland.configType\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"if lib.versionAtLeast config.home.stateVersion \\\"26.05\\\" then \\\"lua\\\" else \\\"hyprlang\\\"\\n\"},\"description\":\"The type of Hyprland configuration to generate.\\n\\n`hyprlang` writes {file}`$XDG_CONFIG_HOME/hypr/hyprland.conf`.\\n`lua` writes {file}`$XDG_CONFIG_HOME/hypr/hyprland.lua`.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"configType\"],\"readOnly\":false,\"type\":\"one of \\\"hyprlang\\\", \\\"lua\\\"\"},\"wayland.windowManager.hyprland.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable configuration for Hyprland, a tiling Wayland\\ncompositor that doesn't sacrifice on its looks.\\n\\n::: {.note}\\nThis module configures Hyprland and adds it to your user's {env}`PATH`,\\nbut does not make certain system-level changes. NixOS users should\\nenable the NixOS module with {option}`programs.hyprland.enable`, which\\nmakes system-level changes such as adding a desktop session entry.\\n:::\\n\",\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.hyprland.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration content appended to the generated Hyprland file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  hl.on(\\\"window.open\\\", function()\\n    hl.timer(function()\\n      hl.dispatch(hl.dsp.exec_cmd(\\\"notify-send 'Window opened'\\\"))\\n    end, {\\n      timeout = 100,\\n      type = \\\"oneshot\\\",\\n    })\\n  end)\\n''\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"wayland.windowManager.hyprland.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"`wayland.windowManager.hyprland.package` with applied configuration\"},\"description\":\"The Hyprland package after applying configuration.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"finalPackage\"],\"readOnly\":true,\"type\":\"null or package\"},\"wayland.windowManager.hyprland.finalPortalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"`wayland.windowManager.hyprland.portalPackage` with\\n        `wayland.windowManager.hyprland.finalPackage` override\"},\"description\":\"The xdg-desktop-portal-hyprland package after overriding its hyprland input.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"finalPortalPackage\"],\"readOnly\":true,\"type\":\"null or package\"},\"wayland.windowManager.hyprland.importantPrefixes\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"$\\\"\\n  \\\"bezier\\\"\\n  \\\"curve\\\"\\n  \\\"name\\\"\\n  \\\"output\\\"\\n]\"},\"description\":\"List of prefix of attributes to source at the top of the config.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"$\\\"\\n  \\\"bezier\\\"\\n]\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"importantPrefixes\"],\"readOnly\":false,\"type\":\"list of string\"},\"wayland.windowManager.hyprland.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.hyprland\"},\"description\":\"The hyprland package to use. Set this to null if you use the NixOS module to install Hyprland.\",\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"wayland.windowManager.hyprland.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Hyprland plugins to use. Can either be packages or\\nabsolute plugin paths.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"plugins\"],\"readOnly\":false,\"type\":\"list of (package or absolute path)\"},\"wayland.windowManager.hyprland.portalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.xdg-desktop-portal-hyprland\"},\"description\":\"The xdg-desktop-portal-hyprland package to use.\",\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"portalPackage\"],\"readOnly\":false,\"type\":\"null or package\"},\"wayland.windowManager.hyprland.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Hyprland configuration written in Nix. Entries with the same key\\nshould be written as lists. Variables' and colors' names should be\\nquoted. See <https://wiki.hypr.land> for more examples.\\n\\n::: {.note}\\nUse the [](#opt-wayland.windowManager.hyprland.plugins) option to\\ndeclare plugins.\\n:::\\n\\nWhen {option}`wayland.windowManager.hyprland.configType` is `\\\"lua\\\"`,\\neach attribute maps to an `hl.<name>(...)` call. List values generate\\none call per element.\\n\\nAttribute values with an `_args` list generate multi-argument calls.\\nAttribute values with `_var` generate a Lua local variable instead of\\nan `hl.<name>(...)` call. If no `name` is set, the attribute name is\\nused as the Lua variable name.\\nValues created with `lib.generators.mkLuaInline` are rendered as raw\\nLua expressions.\\n\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  mod = {\\n    _var = \\\"SUPER\\\";\\n  };\\n\\n  config = {\\n    general = {\\n      gaps_in = 5;\\n      gaps_out = 20;\\n      border_size = 2;\\n    };\\n\\n    decoration = {\\n      rounding = 10;\\n    };\\n  };\\n\\n  bind = [\\n    {\\n      _args = [\\n        (lib.generators.mkLuaInline \\\"mod .. \\\\\\\" + Q\\\\\\\"\\\")\\n        (lib.generators.mkLuaInline \\\"hl.dsp.window.close()\\\")\\n        { locked = true; }\\n      ];\\n    }\\n    {\\n      _args = [\\n        \\\"SUPER + RETURN\\\"\\n        (lib.generators.mkLuaInline \\\"hl.dsp.exec_cmd(\\\\\\\"kitty\\\\\\\")\\\")\\n      ];\\n    }\\n    {\\n      _args = [\\n        \\\"ALT + R\\\"\\n        (lib.generators.mkLuaInline \\\"hl.dsp.submap(\\\\\\\"resize\\\\\\\")\\\")\\n      ];\\n    }\\n  ];\\n\\n  define_submap = {\\n    _args = [\\n      \\\"resize\\\"\\n      (lib.generators.mkLuaInline \\\"function()\\\\n  hl.bind(\\\\\\\"right\\\\\\\", hl.dsp.window.resize({ x = 10, y = 0, relative = true }), { repeating = true })\\\\n  hl.bind(\\\\\\\"left\\\\\\\", hl.dsp.window.resize({ x = -10, y = 0, relative = true }), { repeating = true })\\\\n  hl.bind(\\\\\\\"escape\\\\\\\", hl.dsp.submap(\\\\\\\"reset\\\\\\\"))\\\\nend\\\")\\n    ];\\n  };\\n\\n  window_rule = {\\n    match.class = \\\"kitty\\\";\\n    border_size = 2;\\n  };\\n\\n  on = {\\n    _args = [\\n      \\\"hyprland.start\\\"\\n      (lib.generators.mkLuaInline \\\"function()\\\\n  hl.exec_cmd(\\\\\\\"waybar\\\\\\\")\\\\nend\\\")\\n    ];\\n  };\\n}\\n\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"settings\"],\"readOnly\":false,\"type\":\"Hyprland configuration value\"},\"wayland.windowManager.hyprland.sourceFirst\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable putting source entries at the top of the configuration\\n.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"sourceFirst\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.hyprland.submaps\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of Hyprland submaps.\\n\\nSee <https://wiki.hypr.land/Configuring/Basics/Binds/#submaps> to learn about submaps.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  # submap to change window focus with vim keys\\n  move_focus = {\\n    settings = {\\n      bind = [\\n        \\\", h, movefocus, l\\\"\\n        \\\", j, movefocus, d\\\"\\n        \\\", k, movefocus, u\\\"\\n        \\\", l, movefocus, r\\\"\\n\\n        \\\", escape, submap, reset\\\"\\n      ];\\n    };\\n  };\\n\\n  other_submap = {\\n    settings = {\\n      # ...\\n    };\\n  };\\n}\\n\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"submaps\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"wayland.windowManager.hyprland.submaps.<name>.onDispatch\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Submap to use after a dispatch. Can either be a name or `reset` to disable submap after any dispatch.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"reset\\\"\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"submaps\",\"<name>\",\"onDispatch\"],\"readOnly\":false,\"type\":\"string\"},\"wayland.windowManager.hyprland.submaps.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Hyprland binds to be put in the submap.\\n\\nString entries render only when\\n{option}`wayland.windowManager.hyprland.configType` is\\n`\\\"hyprlang\\\"`.\\n\\nAttribute set entries render only when\\n{option}`wayland.windowManager.hyprland.configType` is `\\\"lua\\\"`.\\nAttribute values with an `_args` list generate multi-argument\\ncalls. Values created with `lib.generators.mkLuaInline` are\\nrendered as raw Lua expressions.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  binde = [\\n   \\\", right, resizeactive, 10 0\\\"\\n   \\\", left, resizeactive, -10 0\\\"\\n   \\\", up, resizeactive, 0 -10\\\"\\n   \\\", down, resizeactive, 0 10\\\"\\n  ];\\n\\n  bind = [\\n    \\\", escape, submap, reset\\\"\\n    {\\n      _args = [\\n        \\\"escape\\\"\\n        (lib.generators.mkLuaInline \\\"hl.dsp.submap(\\\\\\\"reset\\\\\\\")\\\")\\n      ];\\n    }\\n  ];\\n}\\n\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"submaps\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"Hyprland binds\"},\"wayland.windowManager.hyprland.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable {file}`hyprland-session.target` on\\nhyprland startup. This links to `graphical-session.target`.\\nSome important environment variables will be imported to systemd\\nand D-Bus user environment before reaching the target, including\\n- `DISPLAY`\\n- `HYPRLAND_INSTANCE_SIGNATURE`\\n- `WAYLAND_DISPLAY`\\n- `XDG_CURRENT_DESKTOP`\\n- `XDG_SESSION_TYPE`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.hyprland.systemd.enableXdgAutostart\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable autostart of applications using\\n{manpage}`systemd-xdg-autostart-generator(8)`.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"systemd\",\"enableXdgAutostart\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.hyprland.systemd.extraCommands\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"systemctl --user stop hyprland-session.target\\\"\\n  \\\"systemctl --user start hyprland-session.target\\\"\\n]\"},\"description\":\"Extra commands to be run after D-Bus activation.\",\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"systemd\",\"extraCommands\"],\"readOnly\":false,\"type\":\"list of string\"},\"wayland.windowManager.hyprland.systemd.variables\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"DISPLAY\\\"\\n  \\\"HYPRLAND_INSTANCE_SIGNATURE\\\"\\n  \\\"WAYLAND_DISPLAY\\\"\\n  \\\"XDG_CURRENT_DESKTOP\\\"\\n  \\\"XDG_SESSION_TYPE\\\"\\n]\"},\"description\":\"Environment variables to be imported in the systemd & D-Bus user\\nenvironment.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--all\\\"\\n]\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"systemd\",\"variables\"],\"readOnly\":false,\"type\":\"list of string\"},\"wayland.windowManager.hyprland.xwayland.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/hyprland.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/hyprland.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether or not to enable XWayland.\\n\\nOverrides the `enableXWayland` option of the Hyprland package.\\n\\nIn newer versions of Hyprland, you can use the {option}`wayland.windowManager.hyprland.settings.xwayland`\\noption to avoid recompiling Hyprland.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"hyprland\",\"xwayland\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.labwc.autostart\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/labwc>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/labwc\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Command to autostart when labwc start.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"wayvnc &\\\"\\n  \\\"waybar &\\\"\\n  \\\"swaybg -c '#113344' >/dev/null 2>&1 &\\\"\\n]\"},\"loc\":[\"wayland\",\"windowManager\",\"labwc\",\"autostart\"],\"readOnly\":false,\"type\":\"list of string\"},\"wayland.windowManager.labwc.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/labwc>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/labwc\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Labwc, a wayland window-stacking compositor.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"labwc\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.labwc.enviro