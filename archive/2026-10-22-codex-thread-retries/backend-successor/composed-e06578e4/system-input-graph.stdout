ult\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.lazygit\"},\"description\":\"The lazygit package to use.\",\"loc\":[\"programs\",\"lazygit\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.lazygit.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lazygit.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lazygit.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/lazygit/config.yml`\\non Linux or on Darwin if [](#opt-xdg.enable) is set, otherwise\\n{file}`~/Library/Application Support/lazygit/config.yml`.\\nSee\\n<https://github.com/jesseduffield/lazygit/blob/master/docs/Config.md>\\nfor supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  gui = {\\n    theme = {\\n      activeBorderColor = [\\n        \\\"blue\\\"\\n        \\\"bold\\\"\\n      ];\\n      inactiveBorderColor = [\\n        \\\"black\\\"\\n      ];\\n      lightTheme = true;\\n      selectedLineBgColor = [\\n        \\\"default\\\"\\n      ];\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"lazygit\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.lazygit.shellWrapperName\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lazygit.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lazygit.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"lg\\\"\"},\"description\":\"Name of the shell wrapper to be called.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"lg\\\"\"},\"loc\":[\"programs\",\"lazygit\",\"shellWrapperName\"],\"readOnly\":false,\"type\":\"string\"},\"programs.lazysql.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lazysql.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lazysql.nix\"}],\