npackDir\"\nif [ $(ls -A \"$unpackDir\" | wc -l) != 1 ]; then\n  echo \"error: zip file must contain a single file or directory.\"\n  echo \"hint: Pass stripRoot=false; to fetchzip to assume flat list of files.\"\n  exit 1\nfi\nfn=$(cd \"$unpackDir\" && ls -A)\nif [ -f \"$unpackDir/$fn\" ]; then\n  mkdir $out\nfi\nmv \"$unpackDir/$fn\" \"$out\"\n\n\nchmod 755 \"$out\"\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"recursiveHash":true,"repo":"tomli-w","rev":"1.2.0","revCustom":"1.2.0","showURLs":false,"stdenv":"/nix/store/xai718x2gpf0kf73zwhhv50likh5c18l-stdenv-linux-no-cc","strictDeps":true,"stripRoot":true,"system":"x86_64-linux","urls":["https://github.com/hukkin/tomli-w/archive/1.2.0.tar.gz"]},"system":"x86_64-linux","version":4},"r3xl0njx1y4gvv3bh9hkdf3bsakwlscl-unit-script-network-addresses-eth0-pre-stop.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"network-addresses-eth0-pre-stop","__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","checkPhase":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash -n -O extglob \"$target\"\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"/bin/network-addresses-eth0-pre-stop","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"unit-script-network-addresses-eth0-pre-stop","nativeBuildInputs":"","out":"/nix/store/r5naiv4rk4hzna0gwgqjxw4lkbks0q1r-unit-script-network-addresses-eth0-pre-stop","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash\nset -e\n\nstate=\"/run/nixos/network/routes/eth0\"\nif [ -e \"$state\" ]; then\n  while read -r cidr; do\n    echo -n \"deleting route $cidr... \"\n    ip route del \"$cidr\" dev \"eth0\" >/dev/null 2>&1 && echo \"done\" || echo \"failed\"\n  done < \"$state\"\n  rm -f \"$state\"\nfi\n\nstate=\"/run/nixos/network/addresses/eth0\"\nif [ -e \"$state\" ]; then\n  while read -r cidr; do\n    echo -n \"deleting address $cidr... \"\n    ip addr del \"$cidr\" dev \"eth0\" >/dev/null 2>&1 && echo \"done\" || echo \"failed\"\n  done < \"$state\"\n  rm -f \"$state\"\nfi\n\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-network-addresses-eth0-pre-stop","outputs":{"out":{"path":"r5naiv4rk4hzna0gwgqjxw4lkbks0q1r-unit-script-network-addresses-eth0-pre-stop"}},"system":"x86_64-linux","version":4},"r3ziwzs5n9i4hlr4qrzl6hx9bgr5jqbb-splitmix-0.1.3.2.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/1ij5xcr25khr40jrb35rms45p3r7pn04-splitmix-0.1.3.2.tar.gz"},"inputs"