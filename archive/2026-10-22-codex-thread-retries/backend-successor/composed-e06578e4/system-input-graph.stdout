6_64-linux","urls":["mirror://hackage/happy-lib-2.1.7.tar.gz"]},"system":"x86_64-linux","version":4},"fz6vky5jh09qakfdzx2ygsfasldr6p0d-tinycc-bootstrappable-unstable-2024-07-07-source-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"tinycc-bootstrappable-unstable-2024-07-07-source-builder","out":"/nix/store/wh639gn1kfnxz9gz41jhcyh12gscvzjs-tinycc-bootstrappable-unstable-2024-07-07-source-builder","passAsFile":"text","system":"x86_64-linux","text":"ungz --file /nix/store/2kx2q1ph63s63dlq0g31sa7wk83w7m0z-tinycc-ea3900f6d5e71776c5cfabcabee317652e3a19ee.tar.gz --output tinycc.tar\nmkdir -p ${out}\ncd ${out}\nuntar --file ${NIX_BUILD_TOP}/tinycc.tar\n\n# Patch\ncd tinycc-ea3900f6d5e71776c5cfabcabee317652e3a19ee\n\ncp /nix/store/h5x1k0lv3jlh1ir8ry23lm59hizjx01z-mes-libc-0.27.1/lib/libtcc1.c lib/libtcc1.c\n\n# Static link by default\nreplace --file libtcc.c --output libtcc.c --match-on \"s->ms_extensions = 1;\" --replace-with \"s->ms_extensions = 1; s->static_link = 1;\"\n\n# TODO: may not need following patches for mes 0.28.\n# Or maybe we don't need tinycc-bootstrappable for mes 0.28?\n\n# mes-libc depends on max_align_t in stddef.h, which is not provided by tinycc-boot\nreplace --file include/stddef.h --output include/stddef.h --match-on \"void *alloca\" --replace-with \"\n  typedef union { long double ld; long long ll; } max_align_t;\n  void *alloca\n\"\n# VLA is broken in mescc 0.27.1. alloca is not available either. Let's just use malloc and leak on x86_64.\nreplace --file x86_64-gen.c --output x86_64-gen.c --match-on \"char _onstack[nb_args], *onstack = _onstack;\" --replace-with \"char *onstack = tcc_malloc(nb_args);\"\n\n# Abort is not provided by mescc\nreplace --file x86_64-gen.c --output x86_64-gen.c --match-on \"abort();\" --replace-with \"/* abort(); */\"\n\n# Work around bug in mescc.\nreplace --file x86_64-gen.c --output x86_64-gen.c --match-on \"g(vtop->c.i & (ll ? 63 : 31));\" --replace-with \"if (ll) g(vtop->c.i & 63); else g(vtop->c.i & 31);\"\n\n# Normally tinycc only performs relocations on the PLT when creating a dynamically-linked executable.\n# This is fine for most targets because a PLT is not generated. But on x86_64 we do generate a PLT and hence\n# we must assure plt->got references are appropriately relocated.\n# This patch is applied even if we aren't targeting x86_64. Because there's no PLT outside x86_64, it's basically a no-op.\nreplace --file tccelf.c --output tccelf.c --match-on \"fill_got(s1);\" --replace-with \"\n{\n  fill_got(s1);\n  relocate_plt(s1);\n}\n\"\n"},"inputs":{"drvs":{"bll3p7icr7ylyxprj5n60j2r8bkf5qa3-mes-libc-0.27.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"h699vzb1lagddixp8liilf9kihibax6x-tinycc-ea3900f6d5e71776c5cfabcabee317652e3a19ee.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"tinycc-bootstrappable-unstable-2024-07-07-source-builder","outputs":{"out":{"path":"wh639gn1kfnxz9gz41jhcyh12gscvzjs-tinycc-bootstrappable-unstable-2024-07-07-source-builder"}},"system":"x86_64-linux","version":4},"fz7m1s1j4v0gkiggw7s80c9yq0rqgj10-libc.a-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"libc.a-builder","out":"/nix/store/li92x0kv77yfld5xjdvsyg9i0hqbsjh8-libc.a-builder","passAsFile":"text","system":"x86_64-linux","text":"/nix/store/xrr6cv4m9bz6l3q7fglv6yvp3k6ccgvb-tinycc-boot0-unstable-2024-07-07/bin/tcc -std=c11 -c /nix/store/h5x1k0lv3jlh1ir8ry23lm59hizjx01z-mes-libc-0.27.1/lib/libc.c\n/nix/store/xrr6cv4m9bz6l3q7fglv6yvp3k6ccgvb-tinycc-boot0-unstable-2024-07-07/bin/tcc -ar cr ${out} libc.o\n"},"inputs":{"drvs":{"bll3p7icr7ylyxprj5n60j2r8bkf5qa3-mes-libc-0.27.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"ks1l1rm4andjkd4gxr1qj5iqwflgmcsi-tinycc-boot0-unstable-2024-07-07.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"libc.a-builder","outputs":{"out":{"path":"li92x0kv77yfld5xjdvsyg9i0hqbsjh8-libc.a-builder"}},"system":"x86_64-linux","version":4},"fza9nz5apcvqvihh3dqyl1yira38hi62-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/6mng4bkb1nably08xnak0lczvrwpvgj4-source"},"inputs":{"drvs":{"3fc7klhja3mn322hjxl4bax4mk3m6h8l-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"nccfw1s0py9wvalrf7s92cfmg7bijj0i-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"source","outputs":{"out":{"hash":"sha256-8oQzsR7DSaNTN9su1uI9tR