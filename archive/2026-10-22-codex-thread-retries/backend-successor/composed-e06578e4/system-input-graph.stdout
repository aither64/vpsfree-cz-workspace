],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"xrender\\\"\"},\"description\":\"Backend to use: `egl`, `glx`, `xrender` or `xr_glx_hybrid`.\\n\",\"loc\":[\"services\",\"picom\",\"backend\"],\"readOnly\":false,\"type\":\"one of \\\"egl\\\", \\\"glx\\\", \\\"xrender\\\", \\\"xr_glx_hybrid\\\"\"},\"services.picom.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Picom X11 compositor.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"picom\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.picom.extraArgs\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra arguments to be passed to the picom executable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--legacy-backends\\\"\\n]\"},\"loc\":[\"services\",\"picom\",\"extraArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.picom.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines to append to the picom configuration file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  animations = (\\n    {\\n    \\ttriggers = [ \\\"open\\\", \\\"show\\\" ];\\n    \\tpreset = \\\"slide-in\\\";\\n    \\tdirection = \\\"up\\\";\\n      duration = 0.2;\\n    }\\n  )\\n''\"},\"loc\":[\"services\",\"picom\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"services.picom.fade\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Fade windows in and out.\\n\",\"loc\":[\"services\",\"picom\",\"fade\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.picom.fadeDelta\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"10\"},\"description\":\"Time between fade animation step (in ms).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"5\"},\"loc\":[\"services\",\"picom\",\"fadeDelta\"],\"readOnly\":false,\"type\":\"positive integer, meaning >0\"},\"services.picom.fadeExclude\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of conditions of windows that should not be faded.\\nSee `picom(1)` man page for more examples.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"window_type *= 'menu'\\\"\\n  \\\"name ~= 'Firefox$'\\\"\\n  \\\"focused = 1\\\"\\n]\"},\"loc\":[\"services\",\"picom\",\"fadeExclude\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.picom.fadeSteps\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  0.028\\n  0.03\\n]\"},\"description\":\"Opacity change between fade steps (in and out).\\n\"