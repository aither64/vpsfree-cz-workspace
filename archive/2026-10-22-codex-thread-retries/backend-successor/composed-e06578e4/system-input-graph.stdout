s/services/polybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Polybar status bar.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"polybar\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.polybar.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/polybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/polybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Additional configuration to add.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  [module/date]\\n  type = internal/date\\n  interval = 5\\n  date = \\\"%d.%m.%y\\\"\\n  time = %H:%M\\n  format-prefix-foreground = \\\\''${colors.foreground-alt}\\n  label = %time%  %date%\\n''\"},\"loc\":[\"services\",\"polybar\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"services.polybar.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/polybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/polybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.polybar\"},\"description\":\"The polybar package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.polybar.override {\\n  i3GapsSupport = true;\\n  alsaSupport = true;\\n  iwSupport = true;\\n  githubSupport = true;\\n}\\n\"},\"loc\":[\"services\",\"polybar\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.polybar.script\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/polybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/polybar.nix\"}],\"description\":\"This script will be used to start the polybars.\\nSet all necessary environment variables here and start all bars.\\nIt can be assumed that {command}`polybar` executable is in the {env}`PATH`.\\n\\nNote, this script must start all bars in the background and then terminate.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"polybar bar &\\\"\"},\"loc\":[\"services\",\"polybar\",\"script\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"services.polybar.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/polybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/polybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Polybar configuration. This takes a nix attrset and converts it to the\\nstrange data format that polybar uses.\\nEach entry will be converted to a section in the output file.\\nSeveral things are treated specially: nested keys are converted\\nto dash-separated keys; the special `text` key is ignored as a nested key,\\nto allow mixing different levels of nesting; and lists are converted to\\npolybar's `foo-0, foo-1, ...` format.\\n\\nFor example:\\n```nix\\n\\\"module/volume\\\" = {\\n  type = \\\"internal/pulseaudio\\\";\\n  format.volume = \\\"<ramp-volume> <label-volume>\\\";\\n  label.muted.text = \\\"🔇\\\";\\n  label.muted.foreground = \\\"#666\\\";\\n  ramp.volume = [\\\"🔈\\\" \\\"🔉\\\" \\\"🔊\\\"];\\n  click.right = \\\"pavucontrol &\\\";\\n}\\n```\\nbecomes:\\n```ini\\n[module/volume]\\ntype=internal/pulseaudio\\nformat-volume=<ramp-volume> <label-volume>\\nlabel-muted=🔇\\nlabel-muted-foreground=#666\\nramp-volume-0=🔈\\nramp-volume-1=🔉\\nramp-volume-2=🔊\\nclick-right=pavucontrol &\\n```\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"module/volume\\\" = {\\n    type = \\\"internal/pulseaudio\\\";\\n    format.volume = \\\"<ramp-volume> <label-volume>\\\";\\n    label.muted.text = \\\"🔇\\\";\\n    label.muted.foreground = \\\"#666\\\";\\n    ramp.volume = [\\\"🔈\\\" \\\"🔉\\\" \\\"🔊\\\"];\\n    click.right = \\\"pavucontrol &\\\";\\n  };\\n}\\n\"},\"loc\":[\"services\",\"polybar\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of attribute sets\"},\"services.poweralertd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/poweralertd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/poweralertd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the Upower-powered power alertd.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"poweralertd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.poweralertd.extraArgs\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/poweralertd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/poweralertd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra command line arguments to pass to poweralertd.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"-s\\\"\\n  \\\"-S\\\"\\n]\"},\"loc\":[\"services\",\"poweralertd\",\"extraArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.poweralertd.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/poweralertd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/poweralertd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.poweralertd\"},\"description\":\"The poweralertd package to use.\",\"loc\":[\"services\",\"poweralertd\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.proton-pass-agent.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/proton-pass-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/proton-pass-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Proton Pass as a SSH agent.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"proton-pass-agent\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.proton-pass-agent.extraArgs\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/proton-pass-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/proton-pass-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Options given to `pass-cli ssh-agent shart` when the service is run.\\n\\nSee <https://protonpass.github.io/pass-cli/commands/ssh-agent/#passphrase-protected-ssh-keys>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--share-id\\\"\\n  \\\"--vault-name\\\"\\n  \\\"MySshKeyVault\\\"\\n  \\\"--refresh-interval\\\"\\n  \\\"7200\\\"\\n]\"},\"loc\":[\"services\",\"proton-pass-agent\",\"extraArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.proton-pass-agent.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/proton-pass-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/proton-pass-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.proton-pass-cli\"},\"description\":\"The proton-pass-cli package to use.\",\"loc\":[\"services\",\"proton-pass-agent\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.proton-pass-agent.socket\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/proton-pass-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/proton-pass-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"proton-pass-agent\\\"\"},\"description\":\"The agent's socket; interpreted as a suffix to {env}`$XDG_RUNTIME_DIR`\\non Linux and `$(getconf DARWIN_USER_TEMP_DIR)` on macOS. This option\\nad