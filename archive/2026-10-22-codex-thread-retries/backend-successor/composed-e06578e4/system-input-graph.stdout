_FOR_BUILD)' >> config.mk\necho 'PKG_CONFIG = /nix/store/viqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2/bin/pkg-config' >> config.mk\necho 'RANLIB = /nix/store/g2i5zxslx9msaqjy14hdp2af064i9pbv-binutils-2.46/bin/ranlib' >> config.mk\n\n# Use libraries from Nixpkgs\necho \"TIFFLIB = libtiff.so\" >> config.mk\necho \"TIFFLIB_NEEDS_JPEG = N\" >> config.mk\necho \"TIFFLIB_NEEDS_Z = N\" >> config.mk\necho \"JPEGLIB = libjpeg.so\" >> config.mk\necho \"JBIGLIB = libjbig.a\" >> config.mk\n# Insecure\necho \"JASPERLIB = NONE\" >> config.mk\n\n# Fix path to rgb.txt\necho \"RGB_DB_PATH = $out/share/netpbm/misc/rgb.txt\" >> config.mk\nrunHook postConfigure\n","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/f6pr97sbz1fz7qn0s4js40r0ggl735z1-netpbm-11.13.3-dev","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","installPhase":"runHook preInstall\n\nmake package pkgdir=$out\n\nrm -rf $out/*_template $out/{pkginfo,README,VERSION} $out/man/web\n\nmkdir -p $out/share/netpbm\nmv $out/misc $out/share/netpbm/\n\nmoveToOutput bin \"${!outputBin}\"\n\n# wrap any scripts that expect other programs in the package to be in their PATH\nfor prog in ppmquant; do\n    wrapProgram \"${!outputBin}/bin/$prog\" --prefix PATH : \"${!outputBin}/bin\"\ndone\n\nrunHook postInstall\n","mesonFlags":"","name":"netpbm-11.13.3","nativeBuildInputs":"/nix/store/viqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2 /nix/store/lmlgg4x8djbs8mcxrk1b299dja91v1mh-flex-2.6.4 /nix/store/7whrgb2wib2q83wgbs78xsq9h25lf3aw-make-shell-wrapper-hook","out":"/nix/store/4c8i2i2m0ayyzxiq6f4j931b30314riv-netpbm-11.13.3","outputs":"bin out dev","patches":"/nix/store/q9zka83r372ba0rzyy3a7k2mw1jqdn3q-c23.patch","pname":"netpbm","postPatch":"# Install libnetpbm.so symlink to corr