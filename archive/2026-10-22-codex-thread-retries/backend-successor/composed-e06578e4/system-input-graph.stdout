gins.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  c = \\\"fzcd\\\";\\n  f = \\\"finder\\\";\\n  v = \\\"imgview\\\";\\n};\\n\"},\"loc\":[\"programs\",\"nnn\",\"plugins\",\"mappings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.nnn.plugins.src\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nnn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nnn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the plugin folder.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"(pkgs.fetchFromGitHub {\\n  owner = \\\"jarun\\\";\\n  repo = \\\"nnn\\\";\\n  rev = \\\"v4.0\\\";\\n  sha256 = \\\"sha256-Hpc8YaJeAzJoEi7aJ6DntH2VLkoR6ToP6tPYn3llR7k=\\\";\\n}) + \\\"/plugins\\\";\\n\"},\"loc\":[\"programs\",\"nnn\",\"plugins\",\"src\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.nnn.quitcd\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nnn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nnn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable cd on quit.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nnn\",\"quitcd\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nom.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable nom a terminal, rss feed reader..\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nom\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nom.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.nom\"},\"description\":\"The nom package to use.\",\"loc\":[\"programs\",\"nom\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.nom.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings for nom including themes, rss feeds, and openers for specific url regexes.\\n\\nOptions are listed on the github: <https://github.com/guyfedwards/nom>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  autoread = true;\\n  feeds = [\\n    {\\n      name = \\\"Jeff Geerling\\\";\\n      url = \\\"https://www.youtube.com/feeds/videos.xml?channel_id=UCR-DXc1voovS8nhAvccRZhg\\\";\\n    }\\n  ];\\n  openers = [\\n    {\\n      cmd = \\\"mpv %s\\\";\\n      regex = \\\"youtube\\\";\\n    }\\n  ];\\n  ordering = \\\"desc\\\";\\n  showread = false;\\n  theme = {\\n    glamour = \\\"dark\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"nom\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.noti.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/noti.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/noti.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Noti.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"noti\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.noti.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/noti.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/noti.nix\"}],\"default\":