-2.4.0-dev","/nix/store/dskgq3arj036hpb7nmw0sp38a81kf1m4-systemd-minimal-libs-260.5-dev"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":["--localstatedir=/var","--sysconfdir=/etc","--enable-raw-printing","--enable-threads","--enable-dbus","--enable-pam","--with-dbusdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/share/dbus-1","--enable-libusb","--enable-ssl","--enable-avahi","--enable-libpaper","--build=x86_64-unknown-linux-gnu","--host=x86_64-unknown-linux-gnu"],"configurePlatforms":["build","host"],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{},"installFlags":["CACHEDIR=$(TMPDIR)/dummy","LAUNCHD_DIR=$(TMPDIR)/dummy","LOGDIR=$(TMPDIR)/dummy","REQUESTS=$(TMPDIR)/dummy","STATEDIR=$(TMPDIR)/dummy","PAMDIR=$(out)/etc/pam.d","XINETD=$(out)/etc/xinetd.d","SERVERROOT=$(out)/etc/cups","MENUDIR=$(out)/share/applications","ICONDIR=$(out)/share/icons","CUPS_PRIMARY_SYSTEM_GROUP=root"],"mesonFlags":[],"name":"cups-2.4.19","nativeBuildInputs":["/nix/store/viqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2","/nix/store/svrzimmpgp5b9knw00b7cq6081hwadaz-remove-references-to"],"outputChecks":{"dev":{},"lib":{},"man":{},"out":{}},"outputs":["out","lib","dev","man"],"patches":["/nix/store/fymbancl9zzwfs7mbcsdydbv4hnqnyix-CVE-2026-87875.patch","/nix/store/h2jmni1pcbgacjv3qzkdfwc9mjlr26c0-76b515154ce6264dae6d7cc44915d85e0e5fa0f4.patch","/nix/store/qfnsmvv368rqax9w1803kd2cmla1zc9h-526adb34fe87f7f0cf5f63ae26751c1afa36a5d6.patch","/nix/store/sgwh5d4zml7m4zrjhv7z4629v3yacncx-CVE-2026-87876.patch"],"pname":"cups","postInstall":"libexec=lib/cups\nmoveToOutput $libexec \"$out\"\n\n# $lib contains references to $out/share/cups.\n# CUPS is working without them, so they are not vital.\nfind \"$lib\" -type f -exec grep -q \"$out\" {} \\; \\\n     -printf \"removing references from %p\\n\" \\\n     -exec remove-references-to -t \"$out\" {} +\n\n# Delete obsolete stuff that conflicts with cups-filters.\nrm -rf $out/share/cups/banners $out/share/cups/data/testprint\n\nmoveToOutput bin/cups-config \"$dev\"\nsed -e \"/^cups_serverbin=/s|$lib|$out|\" \\\n    -i \"$dev/bin/cups-config\"\n\nfor f in \"$out\"/lib/systemd/system/*; do\n  substituteInPlace \"$f\" --replace \"$lib/$libexec\" \"$out/$libexec\"\ndone\n# Use xdg-open when on Linux\nsubstituteInPlace \"$out\"/share/applications/cups.desktop \\\n  --replace \"Exec=htmlview\" \"Exec=xdg-open\"\n","postPatch":"substituteInPlace cups/testfile.c \\\n  --replace 'cupsFileFind(\"cat\", \"/bin' 'cupsFileFind(\"cat\", \"/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin'\n\n  # The cups.socket unit shouldn't be part of cups.service: stopping the\n  # service would stop the socket and break subsequent socket activations.\n  # See https://github.com/apple/cups/issues/6005\n  sed -i '/PartOf=cups.service/d' scheduler/cups.socket.in\n","preConfigure":"export AR=\"/nix/store/g2i5zxslx9msaqjy14hdp2af064i9pbv-binutils-2.46/bin/ar\"\nconfigureFlagsArray+=(\n  # Put just lib/* and locale into $lib; this didn't work directly.\n  # lib/cups is moved back to $out in postInstall.\n  # Beware: some parts of cups probably don't fully respect these.\n  \"--prefix=$lib\"\n  \"--datadir=$out/share\"\n  \"--localedir=$lib/share/locale\"\n\n  \"--with-systemd=$out/lib/systemd/system\"\n\n  \n)\n","propagatedBuildInputs":["/nix/store/48zd0j6xb1z8n6sqlz2kwbhl1c7z6zky-gmp-with-cxx-6.3.0-dev"],"propagatedNativeBuildInputs":[],"src":"/nix/store/0i7wmspcvcdzd774aspbr14kikdvcpdy-cups-2.4.19-source.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"2.4.19"},"system":"x86_64-linux","ver