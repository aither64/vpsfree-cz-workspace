ype\":\"attribute set of string\"},\"programs.kitty.mouseBindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kitty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kitty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Mapping of mouse bindings to actions.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"ctrl+left click\\\" = \\\"ungrabbed mouse_handle_click selection link prompt\\\";\\n  \\\"left click\\\" = \\\"ungrabbed no-op\\\";\\n};\\n\"},\"loc\":[\"programs\",\"kitty\",\"mouseBindings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.kitty.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kitty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kitty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.kitty\"},\"description\":\"The kitty package to use.\",\"loc\":[\"programs\",\"kitty\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.kitty.quickAccessTerminalConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kitty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kitty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/kitty/quick-access-terminal.conf`. See\\n<https://sw.kovidgoyal.net/kitty/kittens/quick-access-terminal/>\\nfor the documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  background_opacity = 0.85;\\n  hide_on_focus_loss = false;\\n  start_as_hidden = false;\\n}\"},\"loc\":[\"programs\",\"kitty\",\"quickAccessTerminalConfig\"],\"readOnly\":false,\"type\":\"attribute set of (string or boolean or signed integer or floating point number)\"},\"programs.kitty.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kitty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kitty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/kitty/kitty.conf`. See\\n<https://sw.kovidgoyal.net/kitty/conf.html>\\nfor the documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  enable_audio_bell = false;\\n  scrollback_lines = 10000;\\n  update_check_interval = 0;\\n}\"},\"loc\":[\"programs\",\"kitty\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (string or boolean or signed integer or floating point number)\"},\"programs.kitty.shellIntegration.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kitty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kitty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"(cfg.shellIntegration.mode != null)\\n&& !(elem \\\"disabled\\\" (splitString \\\" \\\" config.programs.kitty.shellIntegration.mode))\\n\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"kitty\",\"shellIntegration\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kitty.shellIntegration.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kitty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kitty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"(cfg.shellIntegration.mode != null)\\n&& !(elem \\\"disabled\\\" (splitString \\\" \\\" config.programs.kitty.shellIntegration.mode))\\n\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"kitty\",\"shellIntegration\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kitty.shellIntegration.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kitty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kitty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"(cfg.shellIntegration.mode != null)\\n&& !(elem \\\"disabled\\\" (splitString \\\" \\\" config.programs.kitty.shellIntegration.mode))\\n\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"kitty\",\"shellIntegration\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kitty.shellIntegration.mode\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kitty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kitty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"no-rc\\\"\"},\"description\":\"Set the mode of the shell integration. This accepts the same options\\nas the `shell_integration` option of Kitty. Note that\\n`no-rc` is always implied, unless this set to `null`. See\\n<https://sw.kovidgoyal.net/kitty/shell-integration>\\nfor more details.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"no-cursor\\\"\"},\"loc\":[\"programs\",\"kitty\",\"shellIntegration\",\"mode\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.kitty.themeFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kitty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kitty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Apply a Kitty color theme. This option takes the file name of a theme\\nin `kitty-themes`, without the `.conf` suffix. See\\n<https://github.com/kovidgoyal/kitty-themes/tree/master/themes> for a\\nlist of themes.\\n\\nNote that if any automatic themes are configured via\\n`programs.kitty.autoThemeFiles`, Kitty will prefer them based on the\\nOS color scheme and they will override other color and background image\\nsettings.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"SpaceGray_Eighties\\\"\"},\"loc\":[\"programs\",\"kitty\",\"themeFile\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.kodi.addonSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kodi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kodi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Attribute set with the plugin namespace as toplevel key and the plugins\\nsettings as lower level key/value pairs.\\n\\nKodi will still show the settings of plugins configured via this\\nmechanism in the GUI and they appear to be mutable. This however is\\nnot the case and the settings will stay as specified via Home Manager.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"service.xbmc.versioncheck\\\" = {\\n    versioncheck_enable = \\\"false\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"kodi\",\"addonSettings\"],\"readOnly\":false,\"type\":\"null or (attribute set of attribute set of string)\"},\"programs.kodi.datadir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kodi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kodi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/.kodi\\\"\"},\"description\":\"Directory to store configuration and metadata.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.xdg.dataHome}/kodi\\\"\"},\"loc\":[\"programs\",\"kodi\",\"datadir\"],\"readOnly\":false,\"type\":\"absolute path\"},\"programs.kodi.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kodi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kodi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Kodi.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"kodi\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kodi.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kodi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kodi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.kodi\"},\"description\":\"The kodi package to use. Can be used to specify extensions.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.kodi.withPackages (exts: [ exts.pvr-iptvsimple ])\"},\"loc\":[\"programs\",\"kodi\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.kodi.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kodi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kodi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Configuration to write to the `advancedsettings.xml`\\nfile in kodis userdata directory. Settings specified here will be\\nimmutable from inside kodi and be hidden from the GUI settings dialog.\\n\\nSee <https://kodi.wiki/view/Advancedsettings.xml> as\\nreference for how settings need to be specified.\\n\\nThe innermost attributes must be of type str.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  videolibrary = {\\n    showemptytvshows = \\\"true\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"kodi\",\"settings\"],\"readOnly\":false,\"type\":\"null or attribute sets or lists of strings\"},\"programs.kodi.sources\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kodi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kodi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Contents to populate the file `sources.xml` in kodis\\nuserdata directory.\\n\\nSee <https://kodi.wiki/view/Sources.xml> as\\nreference for how sources need to be specified.\\n\\nKodi will still show the dialogs to modify sources in the GUI and they\\nappear to be mutable. This however is not the case and the sources will\\nstay as specified via Home Manager.\\n\\nThe innermost attributes must be of type str.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  video = {\\n    default = \\\"movies\\\";\\n    source = [\\n      { name = \\\"videos\\\"; path = \\\"/path/to/videos\\\"; allowsharing = \\\"true\\\"; }\\n      { name = \\\"movies\\\"; path = \\\"/path/to/movies\\\"; allowsharing = \\\"true\\\"; }\\n    ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"kodi\",\"sources\"],\"readOnly\":false,\"type\":\"null or attribute sets or lists of strings\"},\"programs.kraftkit.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kraftkit.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kraftkit.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable kraftkit - CLI to build and use customized unikernel VMs.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"kraftkit\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kraftkit.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kraftkit.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kraftkit.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.kraft\"},\"description\":\"The kraft package to use.\",\"loc\":[\"programs\",\"kraftkit\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.kraftkit.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kraftkit.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kraftkit.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/kraftkit/config.yaml`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"no_prompt = true;\\nlog = {\\n  level = \\\"info\\\";\\n  type = \\\"fancy\\\";\\n};\\n\"},\"loc\":[\"programs\",\"kraftkit\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.kubecolor.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubecolor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubecolor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable kubecolor - Colorize your kubectl output.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"kubecolor\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kubecolor.enableAlias\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubecolor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubecolor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When set to true, it will create an alias for kubectl pointing to\\nkubecolor, thus making kubecolor the default kubectl client.\\n\",\"loc\":[\"programs\",\"kubecolor\",\"enableAlias\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kubecolor.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubecolor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubecolor.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"kubecolor\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kubecolor.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubecolor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubecolor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.kubecolor\"},\"description\":\"The kubecolor package to use.\",\"loc\":[\"programs\",\"kubecolor\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.kubecolor.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubecolor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubecolor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`~/.kube/color.yaml` (Linux)\\nor {file}`Library/Application Support/kube/color.yaml` (Darwin).\\nSee <https://kubecolor.github.io/reference/config/> for supported\\nvalues.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"kubectl = lib.getExe pkgs.kubectl\\npreset = \\\"dark\\\";\\npaging = \\\"auto\\\";\\n\"},\"loc\":[\"programs\",\"kubecolor\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.kubeswitch.commandName\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubeswitch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubeswitch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"kswitch\\\"\"},\"description\":\"The name of the command to use\",\"loc\":[\"programs\",\"kubeswitch\",\"commandName\"],\"readOnly\":false,\"type\":\"string\"},\"programs.kubeswitch.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubeswitch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubeswitch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the kubectx for operators.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"kubeswitch\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kubeswitch.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubeswitch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubeswitch.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"kubeswitch\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kubeswitch.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubeswitch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubeswitch.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"kubeswitch\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kubeswitch.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubeswitch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubeswitch.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"kubeswitch\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kubeswitch.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubeswitch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubeswitch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.kubeswitch\"},\"description\":\"The kubeswitch package to use.\",\"loc\":[\"programs\",\"kubeswitch\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.kubeswitch.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kubeswitch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kubeswitch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`~/.kube/switch-config.yaml`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  kind = \\\"SwitchConfig\\\";\\n  kubeconfigName = \\\"*.myconfig\\\";\\n  kubeconfigStores = [\\n    {\\n      kind = \\\"filesystem\\\";\\n      kubeconfigName = \\\"*.myconfig\\\";\\n      paths = [\\n        \\\"~/.kube/my-other-kubeconfigs/\\\"\\n      ];\\n    }\\n  ];\\n  version = \\\"v1alpha1\\\";\\n}\"},\"loc\":[\"programs\",\"kubeswitch\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.lapce.channel\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lapce.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lapce.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"stable\\\"\"},\"description\":\"Lapce channel to configure.\\nShould correspond to the package channel.\\nThis is used to determine the correct configuration and data directories.\\n\",\"loc\":[\"programs\",\"lapce\",\"channel\"],\"readOnly\":false,\"type\":\"one of \\\"stable\\\", \\\"nightly\\\"\"},\"programs.lapce.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lapce.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lapce.nix\"}],\"de