hlpsqrvir464livcdni0y32ah3f-systemwide-man-db-conf.patch","pname":"man-db","postInstall":"# apropos/whatis uses program name to decide whether to act like apropos or whatis\n# (multi-call binary). `apropos` is actually just a symlink to whatis. So we need to\n# make sure that we don't wrap symlinks (since that changes argv[0] to the -wrapped name)\nfind \"$out/bin\" -type f | while read file; do\n  wrapProgram \"$file\" \\\n    --prefix PATH : \"/nix/store/d1f5dv26j6m0yg9as8xb72s1x3pwp77i-groff-1.24.1/bin:/nix/store/yr6ar7lsk3yfas4d464z1ysaxwcq2gc5-gzip-1.14/bin:/nix/store/yfqdq38iw1k9n0a0w1ncsxpl2fs5gy94-zstd-1.5.7-bin/bin\"\ndone\n","postPatch":"# Remove all mandatory manpaths. Nixpkgs makes no requirements on\n# these directories existing.\nsed -i 's/^MANDATORY_MANPATH/# &/' src/man_db.conf.in\n\n# Add Nix-related manpaths\necho \"MANPATH_MAP\t/nix/var/nix/profiles/default/bin\t/nix/var/nix/profiles/default/share/man\" >> src/man_db.conf.in\n\n# Add mandb locations for the above\necho \"MANDB_MAP\t/nix/var/nix/profiles/default/share/man\t/var/cache/man/nixpkgs\" >> src/man_db.conf.in\n","preConfigure":"./bootstrap --no-git --gnulib-srcdir=/nix/store/9h8g0fbv1wkligzsnlkq57ddgxgw72r8-gnulib-20241001 --gen\nconfigureFlagsArray+=(\"--with-sections=1 n l 8 3 0 2 5 4 9 6 7\")\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/6kz444k9yjlacfhrbw84qrbw1mk7vjgw-source","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.13.1"},"inputs":{"drvs":{"109gn1ryh0xvy67zcxjrbk7vm6h8jjfl-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"3wj040870zc61cdqdd4r32l3wf4rv5lv-autoconf-2.73.drv":{"dynamicOutputs":{},"outputs":["out"]},"4kzkzll12a78qzsjyppppzigkw3rpsmv-zstd-1.5.7.drv":{"dynamicOutputs":{},"outputs":["bin","dev"]},"5vg8xc5d8v1lhmaghdffsd2ag9b486vd-glibc-iconv-2.44.drv":{"dynamicOutputs":{},"outputs":["out"]},"7pf4al0mxgi4jn72shb05f1n9pws9qna-gdbm-1.26.drv":{"dynamicOu