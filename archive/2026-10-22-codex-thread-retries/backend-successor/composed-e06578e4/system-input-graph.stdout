-nix/2a3-intermediate-musl.nix\nsed -i 's|/bin/sh|/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash|' \\\n  tools/*.sh\n# patch popen/system to search in PATH instead of hardcoding /bin/sh\nsed -i 's|posix_spawn(&pid, \"/bin/sh\",|posix_spawnp(\\&pid, \"sh\",|' \\\n  src/stdio/popen.c src/process/system.c\nsed -i 's|execl(\"/bin/sh\", \"sh\", \"-c\",|execlp(\"sh\", \"-c\",|'\\\n  src/misc/wordexp.c\n\n# Configure\nexport CC=\"gcc -B/nix/store/76n6dww7rhwzbhxfwad13rhl4v9pa7jm-gcc-16.2.0/lib/gcc/x86_64-unknown-linux-gnu/16.2.0 -Wl,-rpath,/nix/store/76n6dww7rhwzbhxfwad13rhl4v9pa7jm-gcc-16.2.0/lib/gcc/x86_64-unknown-linux-gnu/16.2.0\"\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --syslibdir=$out/lib\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install\nmkdir -p $out/bin\nln -s ../lib/libc.so $out/bin/ldd\nln -s $(ls -d /nix/store/kxg2gx616qp44cnz3by3gnzhacky8jbg-linux-headers-6.5.6/include/* | grep -v scsi\\$) $out/include/\n\n# Strip\n# Ignore failures, because strip may fail on non-elf files.\nfind $out/{bin,lib} -type f -exec strip --strip-debug {} + || true\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"musl-1.2.6","out":"/nix/store/dnrccv6yji8y8xc9h3lbzi6w4ziw1s8k-musl-1.2.6","passAsFile":"buildCommand","pname":"musl","system":"x86_64-linux","version":"1.2.6"},"inputs":{"drvs":{"13xfjqnaic4i15jc78lx7yllnq7wf68l-gcc-wrapper-16.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"4v0g1x9x1izfr6wfg94lixbd066s4m46-linux-headers-6.5.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"59pgig863abfc3p6lmz20vh8gjf2nsv1-musl-1.2.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6v8bjfwdcw75b9hv7gzl0jyfljdlc3vw-binutils-2.47.drv":{"dynamicOutputs":{},"outputs":["out"]},"7g9biqznf18jyzs1r19hhlbf1jvwyivl-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"aw4a7hi7q0mb2ljazxq0in9f5v4905a5-gnumake-musl-4.4.1.drv":{"dynam