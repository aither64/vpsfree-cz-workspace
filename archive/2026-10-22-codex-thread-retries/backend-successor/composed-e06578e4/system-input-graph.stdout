ription\":\"Whether to enable skim - a command-line fuzzy finder.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"skim\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.skim.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/skim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/skim.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"skim\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.skim.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/skim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/skim.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"skim\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.skim.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/skim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/skim.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"skim\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.skim.fileWidgetCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/skim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules