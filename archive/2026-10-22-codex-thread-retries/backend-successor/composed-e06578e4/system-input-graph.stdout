eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-|g\" -i $out/etc/postfix/makedefs.out\n","postPatch":"sed -e '/^PATH=/d' -i postfix-install\nsed -e \"s|@PACKAGE@|$out|\" -i conf/post-install\n\n# post-install need skip permissions check/set on all symlinks following to /nix/store\nsed -e \"s|@NIX_STORE@|$NIX_STORE|\" -i conf/post-install\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/4vw9bjhh7m1pw2i7i61747958p9d0p5n-postfix-3.11.7.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"3.11.7"},"inputs":{"drvs":{"049faz5h2hlc77kx3f6hvc147xrfc1n5-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"0jv8ljqjsq8n5wh6dj954266bihzrlx6-postfix-3.6.2-glibc-234-build-fix.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"1j30j8a9vf6wn3nhblga47spsxa8ba1h-lmdb-0.9.35.drv":{"dynamicOutputs":{},"outputs":["dev"]},"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"5jrl8lrv8b7sz1zm86jz260applm6zcj-pcre2-10.49.drv":{"dynamicOutputs":{},"outputs":["dev"]},"6xlkl033m1wah35haz90yiaahmvq9pb9-openldap-2.6.13.drv":{"dynamicOutputs":{},"outputs":["dev"]},"7nz6awffm4gijfj98n5g4iby81cnmf2v-gnused-4.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"9dp9ri7vkil869i5gcjbbffd8z9qk63c-libnsl-2.0.1.drv":{"dynamicOutputs":{},"outputs":["dev"]},"9xwp3vaz2gjj5ybaiddwijkpiw97mp9j-db-5.3.28.drv":{"dynamicOutputs":{},"outputs":["dev"]},"b19brkzvifpq06n8z8a42qp9x2q5gkmf-cyrus-sasl-2.1.28.drv":{"dynamicOutputs":{},"outputs":["dev"]},"b20jkyqkl2ii0qzjv4l7pm7d6j3dmz27-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"ckrh41imbslhwc13h9m8rhzw20k5w9ax-postfix-3.11.7.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"hd73dkpv6dx8qyq3yl4jv8iyi9955vr8-openssl-3.6.5.drv":{"dynamicOutputs":{},"outputs":["dev"]},"i9mqpnsyzq1m1ngy4p53rk5rd8bhz9qv-gnugrep-3.12.drv