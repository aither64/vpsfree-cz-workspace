/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#! /nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash -e\n# Helper command to manipulate both the IPv4 and IPv6 tables.\nip46tables() {\n  iptables -w \"$@\"\n  ip6tables -w \"$@\"\n\n}\n\n\n# Create a unique drop rule\nip46tables -D INPUT -j nixos-drop 2>/dev/null || true\nip46tables -F nixos-drop 2>/dev/null || true\nip46tables -X nixos-drop 2>/dev/null || true\nip46tables -N nixos-drop\nip46tables -A nixos-drop -j DROP\n\n# Don't allow traffic to leak out until the script has completed\nip46tables -A INPUT -j nixos-drop\n\n\n\nif /nix/store/v736f62bh2hrk3p9pgzl6jcadg63dkyd-firewall-start/bin/firewall-start; then\n  ip46tables -D INPUT -j nixos-drop 2>/dev/null || true\nelse\n  echo \"Failed to reload firewall... Stopping\"\n  /nix/store/l5269rnb26mm732gsr4p2vnc31w2c0bp-firewall-stop/bin/firewall-stop\n  exit 1\nfi\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"dn8gm03rizv8xljly8iq1n1xwfj2bz47-firewall-start.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"g4y45bcg9dknkp4gjrzfxgz9707fg2z4-firewall-stop.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"firewall-reload","outputs":{"out":{"path":"vkzr7cn8pjaihf6wd6l13r17w5ay2hi3-firewall-reload"}},"system":"x86_64-linux","version":4},"fwz3y71fndx2z7khyzy4235lqmzzcfhg-perl5.42.3-Net-SMTP-SSL-1.04.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/119w10l5ic8izi6igxqpq0wdmccs9mbc-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"AUTOMATED_TESTING":"1","PERL_AUTOINSTALL":"--skipdeps","PERL_USE_UNSAFE_INC":"1","__structuredAttrs":"","buildInputs":"/nix/s