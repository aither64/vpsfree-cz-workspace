"","dependencies":"css_parser matrix prawn rexml","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"prawn-svg","gemPath":"/nix/store/cmi6vrlxbp0fgy6va56fda29plkfvvpn-ruby3.4-css_parser-1.21.1 /nix/store/a0lv42sbyhs1ikha1mv055gfgkzb3ar5-ruby3.4-matrix-0.4.3 /nix/store/3qnl41xy1dwfbk21086vk8p2i7lswhy2-ruby3.4-prawn-2.4.0 /nix/store/2k4m1fz82zcigfbfp56cwwk12fcvl1w4-ruby3.4-rexml-3.4.4","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-prawn-svg-0.34.2","nativeBuildInputs":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9 /nix/store/7whrgb2wib2q83wgbs78xsq9h25lf3aw-make-shell-wrapper-hook","out":"/nix/store/wd6c1pv9h4ng7jsfwgr95nxn6smly55j-ruby3.4-prawn-svg-0.34.2","outputs":"out","patches":"","pname":"prawn-svg","propagatedBuildInputs":"/nix/store/cmi6vrlxbp0fgy6va56fda29plkfvvpn-ruby3.4-css_parser-1.21.1 /nix/store/a0lv42sbyhs1ikha1mv055gfgkzb3ar5-ruby3.4-matrix-0.4.3 /nix/store/3qnl41xy1dwfbk21086vk8p2i7lswhy2-ruby3.4-prawn-2.4.0 /nix/store/2k4m1fz82zcigfbfp56cwwk12fcvl1w4-ruby3.4-rexml-3.4.4","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/cmi6vrlxbp0fgy6va56fda29plkfvvpn-ruby3.4-css_parser-1.21.1 /nix/store/a0lv42sbyhs1ikha1mv055gfgkzb3ar5-ruby3.4-matrix-0.4.3 /nix/store/3qnl41xy1dwfbk21086vk8p2i7lswhy2-ruby3.4-prawn-2.4.0 /nix/store/2k4m1fz82zcigfbfp56cwwk12fcvl1w4-ruby3.4-rexml-3.4.4","ruby":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9","src":"/nix/store/vmg570v84akvv12n2d3xawd229q87nq5-prawn-svg-0.34.2.gem","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","suffix":"0.34.2","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"0.34.2"},"inputs":{"drvs":{"049faz5h2hlc77kx3f6hvc147xrfc1n5-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"2c5q9wmz7h07lx6idf2lrv5xpg5296x1-ruby3.4-css_parser-1.21.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"7x1m677japn5vsmrxmdg4qishzn3qzm9-ruby3.4-rexml-3.4.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"dyv2715caym9a4qg9f6wvqdp4b4iqdnc-prawn-svg-0.34.2.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"pnw6mfj7qybmpx6sg5brx1vzf4q02rjw-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"rgc7sl5rbhbhgjm8mba3npz4q923y3nd-ruby3.4-matrix-0.4.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"wx3cpvyyn5zwp52wb66kjgsgkdaxm2a1-ruby3.4-prawn-2.4.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-prawn-svg-0.34.2","outputs":{"out":{"path":"wd6c1pv9h4ng7jsfwgr95nxn6smly55j-ruby3.4-prawn-svg-0.34.2"}},"system":"x86_64-linux","version":4},"nhrsvwnf3d8m4vnz2469yiy6kkxngx00-ptyprocess-0.7.0.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh"],"builder":"/nix/store/10dxp0qxqx