\\\"#ffffff\\\"\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"colors\",\"focusedStatusline\"],\"readOnly\":false,\"type\":\"null or string\"},\"wayland.windowManager.sway.config.bars.*.colors.focusedWorkspace\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Border, background and text color for a workspace button when the workspace has focus.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"colors\",\"focusedWorkspace\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"wayland.windowManager.sway.config.bars.*.colors.inactiveWorkspace\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Border, background and text color for a workspace button when the workspace does not\\nhave focus and is not active.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"colors\",\"inactiveWorkspace\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"wayland.windowManager.sway.config.bars.*.colors.separator\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Text color to be used for the separator.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"colors\",\"separator\"],\"readOnly\":false,\"type\":\"null or string\"},\"wayland.windowManager.sway.config.bars.*.colors.statusline\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Text color to be used for the statusline.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"colors\",\"statusline\"],\"readOnly\":false,\"type\":\"null or string\"},\"wayland.windowManager.sway.config.bars.*.colors.urgentWorkspace\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Border, background and text color for a workspace button when the workspace contains\\na window with the urgency hint set.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"colors\",\"urgentWorkspace\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"wayland.windowManager.sway.config.bars.*.command\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"i3bar\"},\"description\":\"Command that will be used to start a bar.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\\${pkgs.waybar}/bin/waybar\\\"\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"command\"],\"readOnly\":false,\"type\":\"string\"},\"wayland.windowManager.sway.config.bars.*.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines for this bar.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"wayland.windowManager.sway.config.bars.*.fonts\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Font configuration for this bar.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  names = [\\n    \\\"DejaVu Sans Mono\\\"\\n    \\\"FontAwesome5Free\\\"\\n  ];\\n  size = 11.0;\\n  style = \\\"Bold Semi-Condensed\\\";\\n}\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"fonts\"],\"readOnly\":false,\"type\":\"(list of string) or (submodule)\"},\"wayland.windowManager.sway.config.bars.*.fonts.names\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ \\\"monospace\\\" ]\"},\"description\":\"List of font names list used for window titles. Only FreeType fonts are supported.\\nThe order here is important (e.g. icons font should go before the one used for text).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"FontAwesome\\\"\\n  \\\"Terminus\\\"\\n]\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"fonts\",\"names\"],\"readOnly\":false,\"type\":\"list of string\"},\"wayland.windowManager.sway.config.bars.*.fonts.size\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"8.0\"},\"description\":\"The font size to use for window titles.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"11.5\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"fonts\",\"size\"],\"readOnly\":false,\"type\":\"floating point number or string\"},\"wayland.windowManager.sway.config.bars.*.fonts.style\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"The font style to use for window titles.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Bold Semi-Condensed\\\"\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"fonts\",\"style\"],\"readOnly\":false,\"type\":\"string\"},\"wayland.windowManager.sway.config.bars.*.hiddenState\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"The default bar mode when 'bar.mode' == 'hide'.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"hiddenState\"],\"readOnly\":false,\"type\":\"null or one of \\\"hide\\\", \\\"show\\\"\"},\"wayland.windowManager.sway.config.bars.*.id\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Specifies the bar ID for the configured bar instance.\\nIf this option is missing, the ID is set to bar-x, where x corresponds\\nto the position of the embedding bar block in the config file.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"id\"],\"readOnly\":false,\"type\":\"null or string\"},\"wayland.windowManager.sway.config.bars.*.mode\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Bar visibility mode.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"mode\"],\"readOnly\":false,\"type\":\"null or one of \\\"dock\\\", \\\"hide\\\", \\\"invisible\\\"\"},\"wayland.windowManager.sway.config.bars.*.position\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"The edge of the screen swaybar should show up.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"position\"],\"readOnly\":false,\"type\":\"null or one of \\\"top\\\", \\\"bottom\\\"\"},\"wayland.windowManager.sway.config.bars.*.statusCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Command that will be used to get status lines.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"statusCommand\"],\"readOnly\":false,\"type\":\"null or string\"},\"wayland.windowManager.sway.config.bars.*.trayOutput\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Where to output tray.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"trayOutput\"],\"readOnly\":false,\"type\":\"null or string\"},\"wayland.windowManager.sway.config.bars.*.trayPadding\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Sets the pixel padding of the system tray.\\nThis padding will surround the tray on all sides and between each item.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"trayPadding\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"wayland.windowManager.sway.config.bars.*.workspaceButtons\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Whether workspace buttons should be shown or not.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"workspaceButtons\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"wayland.windowManager.sway.config.bars.*.workspaceNumbers\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null for state version ≥ 20.09, as example otherwise\\n\"},\"description\":\"Whether workspace numbers should be displayed within the workspace buttons.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bars\",\"*\",\"workspaceNumbers\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"wayland.windowManager.sway.config.bindkeysToCode\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to make use of {option}`--to-code` in keybindings.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bindkeysToCode\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.sway.config.bindswitches\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"No bindswitches by default\\\"\"},\"description\":\"Binds <switch> to execute the sway command command on state changes. Supported switches are lid (laptop\\nlid) and tablet (tablet mode) switches. Valid values for state are on, off and toggle. These switches are\\non when the device lid is shut and when tablet mode is active respectively. toggle is also supported to run\\na command both when the switch is toggled on or off.\\nSee sway(5).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"let\\n  laptop = \\\"eDP-1\\\";\\nin\\n{\\n  \\\"lid:on\\\" = {\\n    reload = true;\\n    locked = true;\\n    action = \\\"output ${laptop} disable\\\";\\n  };\\n  \\\"lid:off\\\" = {\\n    reload = true;\\n    locked = true;\\n    action = \\\"output ${laptop} enable\\\";\\n  };\\n}\\n\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bindswitches\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"wayland.windowManager.sway.config.bindswitches.<name>.action\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"description\":\"The sway command to execute on state changes\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bindswitches\",\"<name>\",\"action\"],\"readOnly\":false,\"type\":\"string\"},\"wayland.windowManager.sway.config.bindswitches.<name>.locked\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Unless the flag --locked is set, the command\\nwill not be run when a screen locking program\\nis active. If there is a matching binding with\\nand without --locked, the one with will be preferred\\nwhen locked and the one without will be\\npreferred when unlocked.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bindswitches\",\"<name>\",\"locked\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.sway.config.bindswitches.<name>.reload\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If the --reload flag is given, the binding will\\nalso be executed when the config is reloaded.\\ntoggle bindings will not be executed on reload.\\nThe --locked flag will operate as normal so if\\nthe config is reloaded while locked and\\n--locked is not given, the binding will not be\\nexecuted.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"bindswitches\",\"<name>\",\"reload\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.sway.config.colors\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Color settings. All color classes can be specified using submodules\\nwith 'border', 'background', 'text', 'indicator' and 'childBorder' fields\\nand RGB color hex-codes as values. See default values for the reference.\\nNote that 'sway.config.colors.background' parameter takes a single RGB value.\\n\\nSee <https://i3wm.org/docs/userguide.html#_changing_colors>.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"colors\"],\"readOnly\":false,\"type\":\"submodule\"},\"wayland.windowManager.sway.config.colors.background\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"#ffffff\\\"\"},\"description\":\"Background color of the window. Only applications which do not cover\\nthe whole area expose the color.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"colors\",\"background\"],\"readOnly\":false,\"type\":\"string\"},\"wayland.windowManager.sway.config.colors.focused\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  background = \\\"#285577\\\";\\n  border = \\\"#4c7899\\\";\\n  childBorder = \\\"#285577\\\";\\n  indicator = \\\"#2e9ef4\\\";\\n  text = \\\"#ffffff\\\";\\n}\"},\"description\":\"A window which currently has the focus.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"colors\",\"focused\"],\"readOnly\":false,\"type\":\"submodule\"},\"wayland.windowManager.sway.config.colors.focusedInactive\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  background = \\\"#5f676a\\\";\\n  border = \\\"#333333\\\";\\n  childBorder = \\\"#5f676a\\\";\\n  indicator = \\\"#484e50\\\";\\n  text = \\\"#ffffff\\\";\\n}\"},\"description\":\"A window which is the focused one of its container,\\nbut it does not have the focus at the moment.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"colors\",\"focusedInactive\"],\"readOnly\":false,\"type\":\"submodule\"},\"wayland.windowManager.sway.config.colors.placeholder\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  background = \\\"#0c0c0c\\\";\\n  border = \\\"#000000\\\";\\n  childBorder = \\\"#0c0c0c\\\";\\n  indicator = \\\"#000000\\\";\\n  text = \\\"#ffffff\\\";\\n}\"},\"description\":\"Background and text color are used to draw placeholder window\\ncontents (when restoring layouts). Border and indicator are ignored.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"colors\",\"placeholder\"],\"readOnly\":false,\"type\":\"submodule\"},\"wayland.windowManager.sway.config.colors.unfocused\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  background = \\\"#222222\\\";\\n  border = \\\"#333333\\\";\\n  childBorder = \\\"#222222\\\";\\n  indicator = \\\"#292d2e\\\";\\n  text = \\\"#888888\\\";\\n}\"},\"description\":\"A window which is not focused.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"colors\",\"unfocused\"],\"readOnly\":false,\"type\":\"submodule\"},\"wayland.windowManager.sway.config.colors.urgent\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  background = \\\"#900000\\\";\\n  border = \\\"#2f343a\\\";\\n  childBorder = \\\"#900000\\\";\\n  indicator = \\\"#900000\\\";\\n  text = \\\"#ffffff\\\";\\n}\"},\"description\":\"A window which has its urgency hint activated.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"colors\",\"urgent\"],\"readOnly\":false,\"type\":\"submodule\"},\"wayland.windowManager.sway.config.defaultWorkspace\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type