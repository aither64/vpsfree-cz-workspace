x>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/redshift.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The configuration to pass to Redshift.\\nAvailable options for Redshift described in\\n{manpage}`redshift(1)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  redshift = {\\n    adjustment-method = \\\"randr\\\";\\n  };\\n  randr = {\\n    screen = 0;\\n  };\\n};\\n\"},\"loc\":[\"services\",\"redshift\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"services.redshift.temperature.day\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/redshift.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/redshift.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"5500\"},\"description\":\"Colour temperature to use during the day, between\\n`1000` and `25000` K.\\n\",\"loc\":[\"services\",\"redshift\",\"temperature\",\"day\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.redshift.temperature.night\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/redshift.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/redshift.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"3700\"},\"description\":\"Colour temperature to use at night, between\\n`1000` and `25000` K.\\n\",\"loc\":[\"services\",\"redshift\",\"temperature\",\"night\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.redshift.tray\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/redshift.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/redshift.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Start the redshift-gtk tray applet.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"redshift\",\"tray\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.remmina.addRdpMimeTypeAssoc\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/remmina.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/remmina.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable Remmina RDP file open option.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"remmina\",\"addRdpMimeTypeAssoc\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.remmina.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/remmina.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/remmina.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Remmina.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"remmina\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.remmina.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/remmina.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/remmina.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.remmina\"},\"description\":\"The remmina package to use.\",\"loc\":[\"services\",\"remmina\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.remmina.systemdService.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/remmina.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/remmina.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable systemd Remmina service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"remmina\",\"systemdService\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.remmina.systemdService.startupFlags\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/remmina.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/remmina.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--icon\\\"\\n]\"},\"description\":\"Startup flags documented in the manpage to run at service startup.\\n\",\"loc\":[\"services\",\"remmina\",\"systemdService\",\"startupFlags\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.rescrobbled.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/rescrobbled.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/rescrobbled.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable rescrobbled, a MPRIS music scrobbler daemon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"rescrobbled\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.rescrobbled.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/rescrobbled.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/rescrobbled.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.rescrobbled\"},\"description\":\"The rescrobbled package to use.\",\"loc\":[\"services\",\"rescrobbled\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.rescrobbled.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/rescrobbled.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/rescrobbled.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/rescrobbled/config.toml`\\nSee <https://github.com/InputUsername/rescrobbled#configuration> for\\nthe full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  filter-script = \\\"path/to/script\\\";\\n  lastfm-key = \\\"Last.fm API key\\\";\\n  lastfm-secret = \\\"Last.fm API secret\\\";\\n  listenbrainz = [\\n    {\\n      token = \\\"User token\\\";\\n      url = \\\"Custom API URL\\\";\\n    }\\n  ];\\n  min-play-time = 0;\\n  player-whitelist = [\\n    \\\"Player MPRIS identity or bus name\\\"\\n  ];\\n  use-track-start-timestamp = false;\\n}\"},\"loc\":[\"services\",\"rescrobbled\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"services.restic.backups\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Backup configurations for Restic.\\n\\nOn Linux systems, a corresponding systemd user service\\n(and optionally a systemd timer for automatic scheduling)\\nwill be created, along with a helper wrapper script.\\n\\nOn non-Linux platforms, only the helper wrapper script\\nwill be created.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  localbackup = {\\n    exclude = [\\n      \\\"/home/*/.cache\\\"\\n    ];\\n    initialize = true;\\n    passwordFile = \\\"/etc/nixos/secrets/restic-password\\\";\\n    paths = [\\n      \\\"/home\\\"\\n    ];\\n    repository = \\\"/mnt/backup-hdd\\\";\\n  };\\n  remotebackup = {\\n    extraOptions = [\\n      \\\"sftp.command='ssh backup@host -i /etc/nixos/secrets/backup-private-key -s sftp'\\\"\\n    ];\\n    passwordFile = \\\"/etc/nixos/secrets/restic-password\\\";\\n    paths = [\\n      \\\"/home\\\"\\n    ];\\n    repository = \\\"sftp:backup@host:/backups/home\\\";\\n    timerConfig = {\\n      OnCalendar = \\\"00:05\\\";\\n      RandomizedDelaySec = \\\"5h\\\";\\n    };\\n  };\\n}\"},\"loc\":[\"services\",\"restic\",\"backups\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"services.restic.backups.<name>.backupCleanupCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A script that must run after finishing the backup process.\\n\\nThis option is only supported on linux.\\n\",\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"backupCleanupCommand\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.restic.backups.<name>.backupPrepareCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A script that must run before starting the backup process.\\n\\nThis option is only supported on linux.\\n\",\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"backupPrepareCommand\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.restic.backups.<name>.checkOpts\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"A list of options for 'restic check'.\\n\\nThis option is only supported on linux.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--with-cache\\\"\\n]\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"checkOpts\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.restic.backups.<name>.createWrapper\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to generate and add a script to the system path, that has the\\nsame environment variables set as the systemd service. This can be used\\nto e.g. mount snapshots or perform other opterations, without having to\\nmanually specify most options.\\n\",\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"createWrapper\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.restic.backups.<name>.dynamicFilesFrom\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A script that produces a list of files to back up. The results of\\nthis command, along with the paths specified via {option}`paths`,\\nare given to the '--files-from' option.\\n\\nThis option is only supported on linux.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"find /home/alice/git -type d -name .git\\\"\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"dynamicFilesFrom\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.restic.backups.<name>.environmentFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A file containing the credentials to access the repository, in the\\nformat of an EnvironmentFile as described by {manpage}`systemd.exec(5)`.\\nSee <https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html>\\nfor the specific credentials you will need for your backend.\\n\",\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"environmentFile\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.restic.backups.<name>.exclude\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Patterns to exclude when backing up. See\\n<https://restic.readthedocs.io/en/stable/040_backup.html#excluding-files> for\\ndetails on syntax.\\n\\nThis option is only supported on linux.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"/var/cache\\\"\\n  \\\"/home/*/.cache\\\"\\n  \\\".git\\\"\\n]\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"exclude\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.restic.backups.<name>.extraBackupArgs\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra arguments passed to restic backup.\\n\\nThis option is only supported on linux.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--cleanup-cache\\\"\\n  \\\"--exclude-file=/etc/nixos/restic-ignore\\\"\\n]\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"extraBackupArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.restic.backups.<name>.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra extended options to be passed to the restic `-o` flag. See the restic\\ndocumentation for more details.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"sftp.command='ssh backup@192.168.1.100 -i /home/user/.ssh/id_rsa -s sftp'\\\"\\n]\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.restic.backups.<name>.inhibitsSleep\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Prevents the system from sleeping while backing up. This uses systemd-inhibit\\nto block system idling so you may need to enable polkitd with\\n{option}`security.polkit.enable`.\\n\\nThis option is only supported on linux.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"inhibitsSleep\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.restic.backups.<name>.initialize\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Create the repository if it does not already exist.\\n\\nThis option is only supported on linux.\\n\",\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"initialize\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.restic.backups.<name>.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.restic\"},\"description\":\"The restic package to use.\",\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.restic.backups.<name>.passwordCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Command which returns one of the repository's passwords. Since\\n{env}`PATH` is set in the systemd service you need to provide\\nthe absolute path to the executable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${lib.getExe pkgs.gopass} show backups\\\"\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"passwordCommand\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.restic.backups.<name>.passwordFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A file containing the repository password.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/etc/nixos/restic-password\\\"\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"passwordFile\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.restic.backups.<name>.paths\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Paths to back up, alongside those defined by the {option}`dynamicFilesFrom`\\noption. If left empty and {option}`dynamicFilesFrom` is also not specified, no\\nbackup command will be run. This can be used to create a prune-only job.\\n\\nThis option is only supported on linux.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"/var/lib/postgresql\\\"\\n  \\\"/home/user/backup\\\"\\n]\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"paths\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.restic.backups.<name>.progressFps\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Controls the frequency of progress reporting.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"0.1\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"progressFps\"],\"readOnly\":false,\"type\":\"null or (nonnegative integer or floating point number, meaning >=0)\"},\"services.restic.backups.<name>.pruneOpts\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"A list of policy options for 'restic forget --prune', to automatically\\nprune old snapshots. See\\n<https://restic.readthedocs.io/en/latest/060_forget.html#removing-snapshots-according-to-a-policy>\\nfor a full list of options.\\n\\nNote: The 'forget' command is run *after* the 'backup' command, so keep\\nthat in mind when constructing the --keep-\\\\* options.\\n\\nThis option is only supported on linux.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--keep-daily 7\\\"\\n  \\\"--keep-weekly 5\\\"\\n  \\\"--keep-monthly 12\\\"\\n  \\\"--keep-yearly 75\\\"\\n]\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"pruneOpts\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.restic.backups.<name>.rcloneOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options to pass to rclone to control its behavior. See\\n<https://rclone.org/docs/#options> for available options. When specifying\\noption names, strip the leading `--`. To set a flag such as\\n`--drive-use-trash`, which does not take a value, set the value to the\\nBoolean `true`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  bwlimit = \\\"10M\\\";\\n  drive-use-trash = true;\\n}\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"rcloneOptions\"],\"readOnly\":false,\"type\":\"attribute set of (string or boolean or signed integer)\"},\"services.restic.backups.<name>.repository\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Repository to backup to. This should be in the form of a backend specification as\\ndetailed here\\n<https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html>.\\n\\nIf your using the rclone backend, you can configure your remotes with\\n{option}`programs.rclone.remotes` then use them in your backend specification.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"sftp:backup@192.168.1.100:/backups/‹name›\\\"\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"repository\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.restic.backups.<name>.repositoryFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to a file containing the repository location to backup to. This should be\\nin the same form as the {option}`repository` option.\\n\",\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"repositoryFile\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"services.restic.backups.<name>.runCheck\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"lib.length config.checkOpts > 0 || lib.length config.pruneOpts > 0\"},\"description\":\"Whether to run 'restic check' with the provided `checkOpts` options.\\nThis option is only supported on linux.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"runCheck\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.restic.backups.<name>.ssh-package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.openssh\"},\"description\":\"The openssh package to use.\",\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"ssh-package\"],\"readOnly\":false,\"type\":\"package\"},\"services.restic.backups.<name>.timerConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  OnCalendar = \\\"daily\\\";\\n  Persistent = true;\\n}\"},\"description\":\"When to run the backup. See {manpage}`systemd.timer(5)` for details. If null\\nno timer is created and the backup will only run when explicitly started.\\n\\nThis option is only supported on linux.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  OnCalendar = \\\"00:05\\\";\\n  Persistent = true;\\n  RandomizedDelaySec = \\\"5h\\\";\\n}\"},\"loc\":[\"services\",\"restic\",\"backups\",\"<name>\",\"timerConfig\"],\"readOnly\":false,\"type\":\"null or (attribute set of (boolean or signed integer or string or absolute path or list of (boolean or signed integer or string or absolute path)))\"},\"services.restic.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/restic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/restic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable restic.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"restic\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.rsibreak.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/rsibreak.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/rsibreak.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable rsibreak.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"rsibreak\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.rsibreak.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/rsibreak.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/rsibreak.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.rsibreak\"},\"description\":\"The rsibreak package to use.\",\"loc\":[\"services\",\"rsibreak\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.safeeyes.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/safeeyes.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/safeeyes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable The Safe Eyes OSGI service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"safeeyes\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.safeeyes.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/safeeyes.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/safeeyes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.safeeyes\"},\"description\":\"The safeeyes package to use.\",\"loc\":[\"services\",\"safeeyes\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.screen-locker.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/screen-locker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/screen-locker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable screen locker for X session.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"screen-locker\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.screen-locker.inactiveInterval\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/screen-locker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/screen-locker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"10\"},\"description\":\"Inactive time interval in minutes after which session will be locked.\\nThe minimum is 1 minute, and the maximum is 1 hour.\\nIf {option}`xautolock.enable` is true, it will use this setting.\\nSee <https://linux.die.net/man/1/xautolock>.\\nOtherwise, this will be used with {command}`xset` to configure\\nthe X server's screensaver timeout.\\n\",\"loc\":[\"services\",\"screen-locker\",\"inactiveInterval\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.screen-locker.lockCmd\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/screen-locker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/screen-lock