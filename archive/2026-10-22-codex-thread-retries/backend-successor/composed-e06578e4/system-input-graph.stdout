x\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"plain\\\"\"},\"description\":\"Scrollbar style.\",\"loc\":[\"programs\",\"urxvt\",\"scroll\",\"bar\",\"style\"],\"readOnly\":false,\"type\":\"one of \\\"rxvt\\\", \\\"plain\\\", \\\"next\\\", \\\"xterm\\\"\"},\"programs.urxvt.scroll.keepPosition\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/urxvt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/urxvt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to keep a scroll position when TTY receives new lines.\",\"loc\":[\"programs\",\"urxvt\",\"scroll\",\"keepPosition\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.urxvt.scroll.lines\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/urxvt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/urxvt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"10000\"},\"description\":\"Number of lines to save in the scrollback buffer.\",\"loc\":[\"programs\",\"urxvt\",\"scroll\",\"lines\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"programs.urxvt.scroll.scrollOnKeystroke\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/urxvt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/urxvt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to scroll to bottom on keyboard input.\",\"loc\":[\"programs\",\"urxvt\",\"scroll\",\"scrollOnKeystroke\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.urxvt.scroll.scrollOnOutput\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/urxvt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/urxvt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to scroll to bottom on TTY output.\",\"loc\":[\"programs\",\"urxvt\",\"scroll\",\"scrollOnOutput\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.urxvt.shading\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/urxvt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/urxvt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"100\"},\"description\":\"Darken (0 to 99) or lighten (101 to 200) the transparent background.\",\"loc\":[\"programs\",\"urxvt\",\"shading\"],\"readOnly\":false,\"type\":\"integer between 0 and 200 (both inclusive)\"},\"programs.urxvt.transparent\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/urxvt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/urxvt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable pseudo-transparency.\",\"loc\":[\"programs\",\"urxvt\",\"transparent\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.uv.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/uv.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/uv.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable uv.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"uv\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.uv.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/uv.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/uv.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.uv\"},\"description\":\"The uv package to use.\",\"loc\":[\"programs\",\"uv\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.uv.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/uv.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/uv.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/uv/uv.toml`.\\nSee <https://docs.astral.sh/uv/configuration/files/>\\nand <https://docs.astral.sh/uv/reference/settings/>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  python-downloads = \\\"never\\\";\\n  python-preference = \\\"only-system\\\";\\n  pip.index-url = \\\"https://test.pypi.org/simple\\\";\\n}\\n\"},\"loc\":[\"programs\",\"uv\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.vdirsyncer.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable vdirsyncer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vdirsyncer\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vdirsyncer.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vdirsyncer\"},\"description\":\"The vdirsyncer package to use.\",\"loc\":[\"programs\",\"vdirsyncer\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.vdirsyncer.statusPath\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vdirsyncer>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vdirsyncer\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$XDG_DATA_HOME/vdirsyncer/status\\\"\"},\"description\":\"A directory where vdirsyncer will store some additional data for the next sync.\\n\\nFor more information, see the\\n[vdirsyncer manual](https://vdirsyncer.pimutils.org/en/stable/config.html#general-section).\\n\",\"loc\":[\"programs\",\"vdirsyncer\",\"statusPath\"],\"readOnly\":false,\"type\":\"string\"},\"programs.vesktop.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vesktop>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vesktop\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Alternate client for Discord with Vencord built-in.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vesktop\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vesktop.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vesktop>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vesktop\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vesktop\"},\"description\":\"The vesktop package to use.\",\"loc\":[\"programs\",\"vesktop\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.vesktop.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vesktop>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vesktop\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Vesktop settings written to\\n{file}`$XDG_CONFIG_HOME/vesktop/settings.json`. See\\n<https://github.com/Vencord/Vesktop/blob/main/src/shared/settings.d.ts> for available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  appBadge = false;\\n  arRPC = true;\\n  checkUpdates = false;\\n  customTitleBar = false;\\n  disableMinSize = true;\\n  minimizeToTray = false;\\n  tray = false;\\n  splashBackground = \\\"#000000\\\";\\n  splashColor = \\\"#ffffff\\\";\\n  splashTheming = true;\\n  staticTitle = true;\\n  hardwareAcceleration = true;\\n  discordBranch = \\\"stable\\\";\\n}\\n\"},\"loc\":[\"programs\",\"vesktop\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.vesktop.vencord.extraQuickCss\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vesktop>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vesktop\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Additional CSS rules.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  /* disable webcam preview mirroring */\\n  .media-engine-video { transform: none; }\\n''\"},\"loc\":[\"programs\",\"vesktop\",\"vencord\",\"extraQuickCss\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.vesktop.vencord.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vesktop>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vesktop\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Vencord settings written to\\n{file}`$XDG_CONFIG_HOME/vesktop/settings/settings.json`. See\\n<https://github.com/Vendicated/Vencord/blob/main/src/api/Settings.ts> for available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  autoUpdate = false;\\n  autoUpdateNotification = false;\\n  disableMinSize = true;\\n  notifyAboutUpdates = false;\\n  plugins = {\\n    FakeNitro = {\\n      enabled = true;\\n    };\\n    MessageLogger = {\\n      enabled = true;\\n      ignoreSelf = true;\\n    };\\n  };\\n  useQuickCss = true;\\n}\"},\"loc\":[\"programs\",\"vesktop\",\"vencord\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.vesktop.vencord.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vesktop>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vesktop\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Themes to add for Vencord, they can be enabled by setting\\n`programs.vesktop.vencord.settings.enabledThemes`\\nto `[ \\\"THEME_NAME.css\\\" ]`\\n\",\"loc\":[\"programs\",\"vesktop\",\"vencord\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)\"},\"programs.vesktop.vencord.useSystem\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vesktop>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vesktop\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Vencord package from Nixpkgs.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vesktop\",\"vencord\",\"useSystem\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vicinae.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vicinae>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vicinae\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable vicinae launcher daemon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vicinae\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vicinae.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vicinae>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vicinae\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Vicinae extensions to install.\\n\\nYou can use the `config.lib.vicinae.mkExtension` and `config.lib.vicinae.mkRayCastExtension` functions to create them, like:\\n```nix\\n [\\n  (config.lib.vicinae.mkExtension {\\n    name = \\\"test-extension\\\";\\n    npmDepsHash = \\\"sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\\\";\\n    src =\\n      pkgs.fetchFromGitHub {\\n        owner = \\\"schromp\\\";\\n        repo = \\\"vicinae-extensions\\\";\\n        rev = \\\"f8be5c89393a336f773d679d22faf82d59631991\\\";\\n        sha256 = \\\"sha256-zk7WIJ19ITzRFnqGSMtX35SgPGq0Z+M+f7hJRbyQugw=\\\";\\n      }\\n      + \\\"/test-extension\\\";\\n  })\\n  (config.lib.vicinae.mkRayCastExtension {\\n    name = \\\"gif-search\\\";\\n    sha256 = \\\"sha256-G7il8T1L+P/2mXWJsb68n4BCbVKcrrtK8GnBNxzt73Q=\\\";\\n    rev = \\\"4d417c2dfd86a5b2bea202d4a7b48d8eb3dbaeb1\\\";\\n    npmDepsHash = \\\"sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\\\";\\n  })\\n  (config.lib.vicinae.mkRayCastExtension {\\n    name = \\\"my-local-raycast-extension\\\";\\n    src = ./extensions/my-local-raycast-extension;\\n  })\\n ],\\n  ```\\n\\nSet `npmDepsHash` when `src` is produced by a fetcher such as\\n`pkgs.fetchFromGitHub` or `pkgs.fetchgit`; otherwise\\ndependency import reads `package-lock.json` from the fetched source\\nduring evaluation.\\n\",\"loc\":[\"programs\",\"vicinae\",\"extensions\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.vicinae.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vicinae>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vicinae\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vicinae\"},\"description\":\"The vicinae package to use.\",\"loc\":[\"programs\",\"vicinae\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.vicinae.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vicinae>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vicinae\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings written as JSON to {file}`~/.config/vicinae/settings.json`.\\nSee {command}`vicinae config default`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  favicon_service = \\\"twenty\\\";\\n  font = {\\n    normal = {\\n      size = 10;\\n    };\\n  };\\n  pop_to_root_on_close = false;\\n  search_files_in_root = false;\\n  theme = {\\n    dark = {\\n      name = \\\"vicinae-dark\\\";\\n    };\\n    light = {\\n      name = \\\"vicinae-light\\\";\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"vicinae\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.vicinae.systemd.autoStart\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vicinae>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vicinae\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"If the vicinae daemon should be started automatically\",\"loc\":[\"programs\",\"vicinae\",\"systemd\",\"autoStart\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vicinae.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vicinae>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vicinae\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable vicinae systemd integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vicinae\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vicinae.systemd.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vicinae>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vicinae\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"graphical-session.target\\\"\"},\"description\":\"The systemd target that will automatically start the vicinae service.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"sway-session.target\\\"\"},\"loc\":[\"programs\",\"vicinae\",\"systemd\",\"target\"],\"readOnly\":false,\"type\":\"string\"},\"programs.vicinae.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vicinae>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vicinae\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Theme settings to add to the themes folder in `~/.config/vicinae/themes`. See <https://docs.vicinae.com/theming/getting-started> for supported values.\\n\\nThe attribute name of the theme will be the name of theme file,\\ne.g. `base16-default-dark` will be `base16-default-dark.toml` (or `.json` if vicinae version is < 0.15.0).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"# vicinae >= 0.15.0\\n{\\n  catppuccin-mocha = {\\n    meta = {\\n      version = 1;\\n      name = \\\"Catppuccin Mocha\\\";\\n      description = \\\"Cozy feeling with color-rich accents\\\";\\n      variant = \\\"dark\\\";\\n      icon = \\\"icons/catppuccin-mocha.png\\\";\\n      inherits = \\\"vicinae-dark\\\";\\n    };\\n\\n    colors = {\\n      core = {\\n        background = \\\"#1E1E2E\\\";\\n        foreground = \\\"#CDD6F4\\\";\\n        secondary_background = \\\"#181825\\\";\\n        border = \\\"#313244\\\";\\n        accent = \\\"#89B4FA\\\";\\n      };\\n      accents = {\\n        blue = \\\"#89B4FA\\\";\\n        green = \\\"#A6E3A1\\\";\\n        magenta = \\\"#F5C2E7\\\";\\n        orange = \\\"#FAB387\\\";\\n        purple = \\\"#CBA6F7\\\";\\n        red = \\\"#F38BA8\\\";\\n        yellow = \\\"#F9E2AF\\\";\\n        cyan = \\\"#94E2D5\\\";\\n      };\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"vicinae\",\"themes\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.vicinae.useLayerShell\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vicinae>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vicinae\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether vicinae should use the layer shell.\\nIf you are using version 0.17 or newer, you should use\\n{option}.programs.vicinae.settings.launcher_window.layer_shell.enabled = false\\ninstead.\\n\",\"loc\":[\"programs\",\"vicinae\",\"useLayerShell\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vifm.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vifm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vifm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable vifm, a Vim-like file manager.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vifm\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vifm.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vifm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vifm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra lines added to the {file}`$XDG_CONFIG_HOME/vifm/vifmrc` file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"mark h ~/\\\"\"},\"loc\":[\"programs\",\"vifm\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.vifm.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vifm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vifm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vifm\"},\"description\":\"The vifm package to use.\",\"loc\":[\"programs\",\"vifm\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.vim-vint.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vim-vint.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vim-vint.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the Vint linter for Vimscript.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vim-vint\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vim-vint.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vim-vint.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vim-vint.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vim-vint\"},\"description\":\"The vim-vint package to use.\",\"loc\":[\"programs\",\"vim-vint\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.vim-vint.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vim-vint.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vim-vint.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/.vintrc.yaml`\\n\",\"loc\":[\"programs\",\"vim-vint\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.vim.defaultEditor\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vim.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to configure {command}`vim` as the default\\neditor using the {env}`EDITOR` and {env}`VISUAL`\\nenvironment variables.\\n\",\"loc\":[\"programs\",\"vim\",\"defaultEditor\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vim.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vim.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Vim.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vim\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vim.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vim.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom .vimrc lines\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  set nocompatible\\n  set nobackup\\n''\"},\"loc\":[\"programs\",\"vim\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.vim.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vim.nix\"}],\"description\":\"Resulting customized vim package\",\"loc\":[\"programs\",\"vim\",\"package\"],\"readOnly\":true,\"type\":\"package\"},\"programs.vim.packageConfigurable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vim.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vim-full\"},\"description\":\"The vim-full package to use. Vim package to customize\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vim\"},\"loc\":[\"programs\",\"vim\",\"packageConfigurable\"],\"readOnly\":false,\"type\":\"package\"},\"programs.vim.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vim.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  <derivation vimplugin-vim-sensible-2.0-unstable-2024-06-08>\\n]\"},\"description\":\"List of vim plugins to install. To get a list of supported plugins run:\\n{command}`nix-env -f '<nixpkgs>' -qaP -A vimPlugins`.\\n\\nNote: String values are deprecated, please use actual packages.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.vimPlugins.YankRing ]\"},\"loc\":[\"programs\",\"vim\",\"plugins\"],\"readOnly\":false,\"type\":\"list of (string or package)\"},\"programs.vim.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vim.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vim.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"At attribute set of Vim settings. The attribute names and\\ncorresponding values must be among the following supported\\noptions.\\n\\n{var}`background`\\n: one of \\\"dark\\\", \\\"light\\\"\\n\\n{var}`backupdir`\\n: list of string\\n\\n{var}`copyindent`\\n: boolean\\n\\n{var}`directory`\\n: list of string\\n\\n{var}`expandtab`\\n: boolean\\n\\n{var}`hidden`\\n: boolean\\n\\n{var}`history`\\n: signed integer\\n\\n{var}`ignorecase`\\n: boolean\\n\\n{var}`modeline`\\n: boolean\\n\\n{var}`mouse`\\n: one of \\\"n\\\", \\\"v\\\", \\\"i\\\", \\\"c\\\", \\\"h\\\", \\\"a\\\", \\\"r\\\"\\n\\n{var}`mousefocus`\\n: boolean\\n\\n{var}`mousehide`\\n: boolean\\n\\n{var}`mousemodel`\\n: one of \\\"extend\\\", \\\"popup\\\", \\\"popup_setpos\\\"\\n\\n{var}`number`\\n: boolean\\n\\n{var}`relativenumber`\\n: boolean\\n\\n{var}`shiftwidth`\\n: signed integer\\n\\n{var}`smartcase`\\n: boolean\\n\\n{var}`tabstop`\\n: signed integer\\n\\n{var}`undodir`\\n: list of string\\n\\n{var}`undofile`\\n: boolean\\n\\n\\nSee the Vim documentation for detailed descriptions of these\\noptions. Use [](#opt-programs.vim.extraConfig) to manually\\nset any options not listed above.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  background = \\\"dark\\\";\\n  expandtab = true;\\n  history = 1000;\\n}\"},\"loc\":[\"programs\",\"vim\",\"settings\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.vinegar.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vinegar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vinegar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Vinegar.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vinegar\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vinegar.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vinegar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vinegar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vinegar\"},\"description\":\"The vinegar package to use.\",\"loc\":[\"programs\",\"vinegar\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.vinegar.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vinegar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vinegar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/vinegar/config.toml`.\\n\\nSee <https://vinegarhq.org/Configuration/> for more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  env = {\\n    WINEFSYNC = \\\"1\\\";\\n  };\\n  studio = {\\n    dxvk = false;\\n    env = {\\n      DXVK_HUD = \\\"0\\\";\\n      MANGOHUD = \\\"1\\\";\\n    };\\n    fflags = {\\n      DFIntTaskSchedulerTargetFps = 144;\\n    };\\n    renderer = \\\"Vulkan\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"vinegar\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (TOML value)\"},\"programs.visidata.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/visidata.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/visidata.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Visidata.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"visidata\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.visidata.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/visidata.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/visidata.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.visidata\"},\"description\":\"The visidata package to use.\",\"loc\":[\"programs\",\"visidata\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.visidata.visidatarc\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/visidata.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/visidata.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Configuration settings and Python function declarations\\nto be written to ~/.visidatarc. All available options\\ncan be found here: <https://www.visidata.org/docs/>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  options.min_memory_mb=100  # stop processing without 100MB free\\n  \\n  bindkey('0', 'go-leftmost')   # alias '0' to go to first column, like vim\\n  \\n  def median(values):\\n      L = sorted(values)\\n      return L[len(L)//2]\\n  \\n  vd.aggregator('median', median)\\n''\"},\"loc\":[\"programs\",\"visidata\",\"visidatarc\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.vivaldi.nativeMessagingHosts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Vivaldi Browser native messaging hosts to install.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  pkgs.keepassxc\\n]\\n\"},\"loc\":[\"programs\",\"vi