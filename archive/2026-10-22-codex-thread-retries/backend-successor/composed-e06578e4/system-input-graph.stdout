  {\\n          enable = true;\\n          match = \\\"eDP-1\\\";\\n        }\\n      ];\\n    }\\n  ];\\n}\"},\"loc\":[\"services\",\"shikane\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"services.shpool.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/shpool.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/shpool.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable shpool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"shpool\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.shpool.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/shpool.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/shpool.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.shpool\"},\"description\":\"The shpool package to use.\",\"loc\":[\"services\",\"shpool\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"services.shpool.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/shpool.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/shpool.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration to use for shpool. See\\n<https://github.com/shell-pool/shpool/blob/master/CONFIG.md>\\nfor available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  keybinding = [\\n    {\\n      action = \\\"detach\\\";\\n      binding = \\\"Ctrl-a d\\\";\\n    }\\n  ];\\n  motd = \\\"never\\\";\\n  prompt_prefix = \\\"[$SHPOOL_SESSION_NAME]\\\";\\n  session_restore_mode = {\\n    lines = 1000;\\n  };\\n}\"},\"loc\":[\"services\",\"shpool\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"services.shpool.systemd\":{\"declarations\":[{\"name\":\"<home-manager/modul