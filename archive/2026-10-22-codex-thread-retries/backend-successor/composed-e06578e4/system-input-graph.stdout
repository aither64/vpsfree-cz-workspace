the\\n{env}`JAVA_HOME` variable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"java\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.java.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/java.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/java.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.jdk\"},\"description\":\"The java package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.jre\"},\"loc\":[\"programs\",\"java\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.jetbrains-remote.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/jetbrains-remote.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/jetbrains-remote.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable JetBrains remote development system.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"jetbrains-remote\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.jetbrains-remote.ides\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/jetbrains-remote.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/jetbrains-remote.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"IDEs accessible to the JetBrains remote development system.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs.jetbrains; [ clion pycharm-professional ];\\n\"},\"loc\":[\"programs\",\"jetbrains-remote\",\"ides\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.jjui.configDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/jjui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/jjui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${config.xdg.configHome}/jjui\"},\"description\":\"The directory to contain jjui configuration files.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"${config.home.homeDirectory}/.jjui\"},\"loc\":[\"programs\",\"jjui\",\"configDir\"],\"readOnly\":false,\"type\":\"string\"},\"programs.jjui.configLua\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/jjui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/jjui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The content of the {file}`(config.programs.jjui.configDir)/config.lua` file, set either by specifying a path\\nto a Lua file or by providing a multi-line Lua string.\\n\\nSee <https://idursun.github.io/jjui/customization/config-lua/> for documentation on Lua support.\\n\\nUse the option {option}`plugins` to configure Lua plugins imported here.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  local foo = require(\\\"plugins.foo\\\")\\n  local bar = require(\\\"plugins.bar\\\")\\n  \\n  function setup(config)\\n    foo.setup(config)\\n    bar.setup(\\\"#5B8DEF\\\", config)\\n  \\n    config.action(\\\"show diff in diffnav\\\", function()\\n      local change_id = context.change_id()\\n      if not change_id or change_id == \\\"\\\" then\\n        flash({ text = \\\"No revision selected\\\", error = true })\\n        return\\n      end\\n  \\n      exec_shell(string.format(\\\"jj diff -r %q --git --color always | diffnav\\\", change_id))\\n    end, { desc = \\\"show diff in diffnav\\\", key = \\\"ctrl+d\\\", scope = \\\"revisions\\\" })\\n  end\\n''\"},\"loc\":[\"programs\",\"jjui\",\"configLua\"],\"readOnly\":false,\"type\":\"null or absolute path or strings concatenated with \\\"\\\\n\\\"\"},\"programs.jjui.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/jjui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/jjui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable jjui - A terminal user interface for jujutsu.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"jjui\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.jjui.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/jjui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/jjui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.jjui\"},\"description\":\"The jjui package to use.\",\"loc\":[\"programs\",\"jjui\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.jjui.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/jjui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/jjui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Lua plugins, one per attribute.\\nThe <name> attribute will become the plugin name, and the <value> attribute is a path to a Lua file or a multi-line Lua string.\\nEach attribute will be linked to {file}`(config.programs.jjui.configDir)/plugins/<name>.lua` with <value> content.\\n\\nSee <https://idursun.github.io/jjui/customization/config-lua/>\\nfor documentation on Lua support.\\n\\nRemember to import the defined plugins in the {option}`configLua` option.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  foo = ./foo.lua;\\n  bar = /* lua */ '\\\\'\\n    local M = {}\\n\\n    function M.setup(primary, config)\\n      config.ui = config.ui or {}\\n      config.ui.colors = config.ui.colors or {}\\n\\n      config.ui.colors.title = { fg = primary, bold = true }\\n    end\\n\\n    return M\\n  '\\\\';\\n}\\n\"},\"loc\":[\"programs\",\"jjui\",\"plugins\"],\"readOnly\":false,\"type\":\"attribute set of (absolute path or strings concatenated with \\\"\\\\n\\\")\"},\"programs.jjui.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/jjui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/jjui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options to add to the {file}`(config.programs.jjui.configDir)/config.toml` file. See\\n<https://idursun.github.io/jjui/customization/config-toml/>\\nfor options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  revisions = {\\n    revset = \\\"\\\";\\n    template = \\\"builtin_log_compact\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"jjui\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.joplin-desktop.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/joplin-desktop.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/joplin-desktop.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable joplin-desktop.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"joplin-desktop\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.joplin-desktop.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/joplin-desktop.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/joplin-desktop.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Use this to add other options to the Joplin config file. Settings are\\nwritten in JSON, so `\\\"sync.interval\\\": 600` would be written as\\n`\\\"sync.interval\\\" = 600`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"markdown.plugin.mark\\\" = true;\\n  newNoteFocus = \\\"title\\\";\\n}\"},\"loc\":[\"programs\",\"joplin-desktop\",\"extraConfig\"],\"readOnly\":false,\"type\":\"attribute set\"},\"programs.joplin-desktop.general.editor\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/joplin-desktop.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/joplin-desktop.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The editor command (may include arguments) that will be used to open a\\nnote. If none is provided Joplin will try to auto-detect the default\\neditor.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"kate\\\"\"},\"loc\":[\"programs\",\"joplin-desktop\",\"general\",\"editor\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.joplin-desktop.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/joplin-desktop.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/joplin-desktop.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.joplin-desktop\"},\"description\":\"The joplin-desktop package to use.\",\"loc\":[\"programs\",\"joplin-desktop\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.joplin-desktop.sync.interval\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/joplin-desktop.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/joplin-desktop.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"undefined\\\"\"},\"description\":\"Set the synchronisation interval.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"10m\\\"\"},\"loc\":[\"programs\",\"joplin-desktop\",\"sync\",\"interval\"],\"readOnly\":false,\"type\":\"one of \\\"undefined\\\", \\\"disabled\\\", \\\"5m\\\", \\\"10m\\\", \\\"30m\\\", \\\"1h\\\", \\\"12h\\\", \\\"1d\\\"\"},\"programs.joplin-desktop.sync.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/joplin-desktop.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26