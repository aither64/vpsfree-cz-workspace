t be found in the bindist build directory (at ghc-9.8.4*/\"bin/ghc\") for arch x86_64-linux, please check that ghcBinDists correctly reflect the bindist dependencies!\"; exit 1;\nfi\n\n\necho \"Checking bindist for libtinfo.so.6 to ensure that is still used\"\nif ! readelf -d ghc-9.8.4*/\"bin/ghc\" | grep \"libtinfo.so.6\"; then\n  echo >&2 \"File libtinfo.so.6 could not be found in bin/ghc for arch x86_64-linux, please check that ghcBinDists correctly reflect the bindist dependencies!\"; exit 1;\nfi\n\necho \"Checking that the nix package /nix/store/wpyc0r4d4idaq96y0dc1375ziabl4b38-ncurses-6.6 contains libtinfo.so.6\"\nif ! test -e \"/nix/store/wpyc0r4d4idaq96y0dc1375ziabl4b38-ncurses-6.6/lib/libtinfo.so.6\"; then\n  echo >&2 \"Nix package /nix/store/wpyc0r4d4idaq96y0dc1375ziabl4b38-ncurses-6.6 did not contain libtinfo.so.6 for arch x86_64-linux, please check that ghcBinDists correctly reflect the bindist dependencies!\"; exit 1;\nfi\nfind . -name 'ghc-bignum*.conf' \\\n    -exec sed -e '/^[a-z-]*library-dirs/a \\    /nix/store/nfwxmadv2vpbk713xl4qrxzgcz86xhh3-gmp-with-cxx-6.3.0/lib' -i {} \\;\nfind . -type f -executable -exec patchelf \\\n    --interpreter /nix/store/fsd4vbp9zjd9iaicq2fb9lpc1h5j973y-glibc-2.42-100/lib/ld-linux-x86-64.so.2 {} \\;\n","preConfigure":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/j4pgd446rpf4x59vxzvsbj6fbyqnyszd-ghc-9.8.4-x86_64-deb11-linux.tar.xz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"9.8.4"},"inputs":{"drvs":{"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"8xzqhmi0bhpmbzdhkkxinrx5zli4amwz-ncurses-6.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"l2fy6px2li3p7cv13nn43kaap38sgx39-ghc-9.8.4-x86_64-deb11-linux.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"lhyghwyrh7gdmsca5jb5xcyf546