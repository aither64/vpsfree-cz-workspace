tore/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","buildCommand":"# Unpack\ntar xf /nix/store/agzpvgbj5sk61kq8z5zwggcn4vd6f0ij-binutils-2.46.0.tar.xz\ncd binutils-2.46.0\n\n# Patch\npatch -Np1 -i /nix/store/sqbhaaayam0xw3a3164ks1vvbrdhl9vq-deterministic.patch\n\n# Configure\nbash ./configure LDFLAGS=--static --prefix=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9 --build=x86_64-unknown-linux-gnu --host=x86_64-unknown-linux-gnu --disable-dependency-tracking --disable-nls --enable-deterministic-archives --disable-gprofng --disable-gprof --enable-new-dtags --with-lib-path=: --disable-gold --disable-libctf --disable-plugins\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\n# strip to remove build dependency store path references\nmake -j $NIX_BUILD_CORES install-strip\n\n# gprof/addr2line/elfedit + man pages are unused downstream.\nrm -f $out/bin/gprof $out/bin/addr2line $out/bin/elfedit\nrm -rf $out/include $out/lib $out/share\n\n# The target-prefixed tools duplicate the unprefixed tools byte-for-byte.\n# Keep the conventional target-prefixed paths, but make them symlinks.\ntargetBin=$out/x86_64-unknown-linux-gnu/bin\nif [ -d \"$targetBin\" ]; then\n  for tool in ar as ld ld.bfd nm objcopy objdump ranlib readelf strip; do\n    if [ -e \"$targetBin/$tool\" ] && cmp -s \"$out/bin/$tool\" \"$targetBin/$tool\"; then\n      rm \"$targetBin/$tool\"\n      ln -s ../../bin/$tool \"$targetBin/$tool\"\n    fi\n  done\nfi\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"binutils-static-2.46","out":"/nix/store/6pap6fdlrmd8inbl2kv1b40zsfvfgw8l-binutils-static-2.46","passAsFile":"buildCommand","pname":"binutils-static","system":"x86_64-linux","version":"2.46"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"0dpycpy1hz7sccz9w6a9vc22zfzc17hd-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"13xfjqnaic4i15jc78lx7yllnq7wf68l-gcc-wrapper-16.2.0.drv":{"dynamicOutputs":{}