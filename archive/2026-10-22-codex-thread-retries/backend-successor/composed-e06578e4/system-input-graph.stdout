rictDeps":"1","system":"x86_64-linux","version":"6.0.2"},"inputs":{"drvs":{"63zjnxw73yn1avnz9vcsb4hjlsvd0gls-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"c0nkizv2ivnqamc9l8y8l94zydph596x-libx11-1.8.13.drv":{"dynamicOutputs":{},"outputs":["dev"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"hrijwlsa7ap3ylspkj23shc9r8cyjqac-xorgproto-2025.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"ycdj4f0h6lqa1ww4ycdgb5365ygs29m5-libXfixes-6.0.2.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"libxfixes-6.0.2","outputs":{"dev":{"path":"ihycnsbl35qxjybiray9vg5nil6banah-libxfixes-6.0.2-dev"},"out":{"path":"n4j77p1lrmkhfi8qacjgxfsimhr25d20-libxfixes-6.0.2"}},"system":"x86_64-linux","version":4},"nvpgwhvbbwd0wnk4jfz031nqrpm4y9ss-gettext-1.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash","env":{"__structuredAttrs":"","buildInputs":"/nix/store/5d17vvf7m7gfc3vsl7n5ivq2b3gjkakp-bash-5.3p9-dev","builder":"/nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash","cmakeFlags":"","configureFlags":"--disable-csharp","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","doc":"/nix/store/j2rw6v9kc11xz8lhmqbfyc9zsg1j7lcg-gettext-1.0-doc","enableParallelBuilding":"1","enableParallelChecking":"","enableParallelInstalling":"1","gettextNeedsLdflags":"","info":"/nix/store/607fq0i6djmrpq0zx7k0v1icjbwprsqm-gettext-1.0-info","man":"/nix/store/58ihmv0ciqbbwi7pdpxf833kalkd342b-gettext-1.0-man","mesonFlags":"","name":"gettext-1.0","nativeBuildInputs":"/nix/store/1ayzw3lmqyjklyfzw52c508d87pq6x67-update-autotools-gnu-config-scripts-hook","out":"/nix/store/y6rng1ng0l2ngd2pfcwxyzd1sdljq8b2-gettext-1.0","outputs":"out man doc info","patches":"/nix/store/p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff /nix/store/yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch","pname":"gettext","postPatch":"# Older versions of gettext come with a copy of `extern-inline.m4` that is not compatible with clang 18.\n# When a project uses gettext + autoreconfPhase, autoreconfPhase will invoke `autopoint -f`, which will\n# replace whatever (probably compatible) version of `extern-inline.m4` with one that probalby won’t work\n# because `autopoint` will copy the autoconf macros from the project’s required version of gettext.\n# Fixing this requires replacing all the older copies of the problematic file with a new one.\n#\n# This is ugly, but it avoids requiring workarounds in every package using gettext and autoreconfPhase.\ndeclare -a oldFiles=($(tar tf gettext-tools/autotools/archive.dir.tar | grep '^gettext-0\\.[19].*/extern-inline.m4'))\noldFilesDir=$(mktemp -d)\nfor oldFile in \"${oldFiles[@]}\"; do\n  mkdir -p \"$oldFilesDir/$(dirname \"$oldFile\")\"\n  cp -a gettext-tools/gnulib-m4/extern-inline.m4 \"$oldFilesDir/$oldFile\"\ndone\ntar uf gettext-tools/autotools/archive.dir.tar --owner=0 --group=0 --numeric-owner -C \"$oldFilesDir\" \"${oldFiles[@]}\"\n\nsubstituteAllInPlace gettext-runtime/src/gettext.sh.in\nsubstituteInPlace gettext-tools/projects/KDE/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/projects/GNOME/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/src/project-id --replace \"/bin/pwd\" pwd\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHooks":"/nix/store/v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash /nix/store/ny42y6hs4p294rvn