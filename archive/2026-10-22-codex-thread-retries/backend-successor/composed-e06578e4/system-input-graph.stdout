or = mkLiteral \\\"@foreground-color\\\";\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"rofi\",\"theme\"],\"readOnly\":false,\"type\":\"null or string or absolute path or attribute set of ((attribute set of (string or signed integer or boolean or (Rasi literal string) or list of (string or signed integer or boolean or (Rasi literal string)))) or string)\"},\"programs.rofi.xoffset\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"description\":\"Offset in the x-axis in pixels relative to the chosen location.\\n\",\"loc\":[\"programs\",\"rofi\",\"xoffset\"],\"readOnly\":false,\"type\":\"signed integer\"},\"programs.rofi.yoffset\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"description\":\"Offset in the y-axis in pixels relative to the chosen location.\\n\",\"loc\":[\"programs\",\"rofi\",\"yoffset\"],\"readOnly\":false,\"type\":\"signed integer\"},\"programs.rtorrent.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rtorrent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rtorrent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable rTorrent.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rtorrent\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rtorrent.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rtorrent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rtorrent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":