me-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom LibreWolf user chrome CSS.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  /* Hide tab bar in FF Quantum */\\n  @-moz-document url(chrome://browser/content/browser.xul), url(chrome://browser/content/browser.xhtml) {\\n    #TabsToolbar {\\n      visibility: collapse !important;\\n      margin-bottom: 21px !important;\\n    }\\n  \\n    #sidebar-box[sidebarcommand=\\\"treestyletab_piro_sakura_ne_jp-sidebar-action\\\"] #sidebar-header {\\n      visibility: collapse !important;\\n    }\\n  }\\n''\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"userChrome\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.librewolf.profiles.<name>.userContent\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom LibreWolf user content CSS.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  /* Hide scrollbar in FF Quantum */\\n  *{scrollbar-width:none !important}\\n''\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"userContent\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.librewolf.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of global LibreWolf settings and overrides. Refer to\\n<https://librewolf.net/docs/settings/>\\nfor details on supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"privacy.resistFingerprinting\\\" = false;\\n  \\\"webgl.disabled\\\" = false;\\n}\"},\"loc\":[\"programs\",\"librewolf\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or string)\"},\"programs.lieer.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable lieer Gmail synchronization for notmuch.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"lieer\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.lieer.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lieer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lieer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.lieer\"},\"description\":\"The lieer package to use.\",\"loc\":[\"programs\",\"lieer\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.looking-glass-client.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/looking-glass-client.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/looking-glass-client.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable looking-glass-client.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"looking-glass-client\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.looking-glass-client.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/looking-glass-client.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/looking-glass-client.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.looking-glass-client\"},\"description\":\"The looking-glass-client package to use.\",\"loc\":[\"programs\",\"looking-glass-client\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.looking-glass-client.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/looking-glass-client.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/looking-glass-client.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"looking-glass-client settings.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  app = {\\n    allowDMA = true;\\n    shmFile = \\\"/dev/kvmfr0\\\";\\n  };\\n  input = {\\n    escapeKey = 62;\\n    rawMouse = true;\\n  };\\n  spice = {\\n    audio = true;\\n    enable = true;\\n  };\\n  win = {\\n    fullScreen = true;\\n    jitRender = true;\\n    showFPS = false;\\n  };\\n}\"},\"loc\":[\"programs\",\"looking-glass-client\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.lsd.colors\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lsd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lsd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/lsd/colors.yaml`. See\\n<https://github.com/lsd-rs/lsd/tree/v1.0.0#color-theme-file-content> for\\nsupported colors.\\n\\nIf this option is non-empty then the `color.theme` option is\\nautomatically set to `\\\"custom\\\"`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  size = {\\n    large = \\\"dark_yellow\\\";\\n    none = \\\"grey\\\";\\n    small = \\\"yellow\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"lsd\",\"colors\"],\"readOnly\":false,\"type\":\"YAML 1.1 value or absolute path\"},\"programs.lsd.enable