ograms\",\"zsh\",\"antidote\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.zsh.antidote.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/antidote.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/antidote.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of antidote plugins.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"zsh-users/zsh-autosuggestions\\\"\\n]\"},\"loc\":[\"programs\",\"zsh\",\"antidote\",\"plugins\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.zsh.antidote.useFriendlyNames\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/antidote.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/antidote.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable friendly names.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zsh\",\"antidote\",\"useFriendlyNames\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.autocd\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Automatically enter into a directory if typed directly into shell.\\n\",\"loc\":[\"programs\",\"zsh\",\"autocd\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.zsh.autosuggestion.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Enable zsh autosuggestions\",\"loc\":[\"programs\",\"zsh\",\"autosuggestion\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.autosuggestion.highlight\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Custom styles for autosuggestion highlighting. See\\n{manpage}`zshzle(1)` for syntax.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fg=#ff00ff,bg=cyan,bold,underline\\\"\"},\"loc\":[\"programs\",\"zsh\",\"autosuggestion\",\"highlight\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.zsh.autosuggestion.strategy\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"history\\\"\\n]\"},\"description\":\"`ZSH_AUTOSUGGEST_STRATEGY` is an array that specifies how suggestions should be generated.\\nThe strategies in the array are tried successively until a suggestion is found.\\nThere are currently three built-in strategies to choose from:\\n\\n- `history`: Chooses the most recent match from history.\\n- `completion`: Chooses a suggestion based on what tab-completion would suggest. (requires `zpty` module)\\n- `match_prev_cmd`: Like `history`, but chooses the most recent match whose preceding history item matches\\n    the most recently executed command. Note that this strategy won't work as expected with ZSH options that\\n    don't preserve the history order such as `HIST_IGNORE_ALL_DUPS` or `HIST_EXPIRE_DUPS_FIRST`.\\n\\nSetting the option to an empty list `[]` will make ZSH_AUTOSUGGESTION_STRATEGY not be set automatically,\\nallowing the variable to be declared in {option}`programs.zsh.localVariables` or {option}`programs.zsh.sessionVariables`\\n\",\"loc\":[\"programs\",\"zsh\",\"autosuggestion\",\"strategy\"],\"readOnly\":false,\"type\":\"list of (one of \\\"history\\\", \\\"completion\\\", \\\"match_prev_cmd\\\")\"},\"programs.zsh.cdpath\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of paths to autocomplete calls to {command}`cd`.\\n\",\"loc\":[\"programs\",\"zsh\",\"cdpath\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.zsh.completionInit\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"autoload -U compinit && compinit\\\"\"},\"description\":\"Initialization commands to run when completion is enabled.\",\"loc\":[\"programs\",\"zsh\",\"completionInit\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.zsh.defaultKeymap\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default base keymap to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"emacs\\\"\"},\"loc\":[\"programs\",\"zsh\",\"defaultKeymap\"],\"readOnly\":false,\"type\":\"null or one of \\\"emacs\\\", \\\"vicmd\\\", \\\"viins\\\"\"},\"programs.zsh.dirHashes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set that adds to named directory hash table.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  docs  = \\\"$\\\\{config.home.homeDirectory}/Documents\\\";\\n  vids  = \\\"$\\\\{config.home.homeDirectory}/Videos\\\";\\n  dl    = \\\"$\\\\{config.home.homeDirectory}/Downloads\\\";\\n}\\n\"},\"loc\":[\"programs\",\"zsh\",\"dirHashes\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.zsh.dotDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"if config.xdg.enable && lib.versionAtLeast config.home.stateVersion \\\"26.05\\\" then\\n  \\\"${config.xdg.configHome}/zsh\\\"\\nelse\\n  config.home.homeDirectory\\n\"},\"description\":\"Directory where the zsh configuration and more should be located,\\nrelative to the users home directory. The default is the home\\ndirectory.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.xdg.configHome}/zsh\\\"\"},\"loc\":[\"programs\",\"zsh\",\"dotDir\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.zsh.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Z shell (Zsh).\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zsh\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.enableCompletion\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Enable zsh completion. Don't forget to add\\n```nix\\n  environment.pathsToLink = [ \\\"/share/zsh\\\" ];\\n```\\nto your system configuration to get completion for system packages (e.g. systemd).\\n\",\"loc\":[\"programs\",\"zsh\",\"enableCompletion\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.enableVteIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/vte.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/vte.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable integration with terminals using the VTE\\nlibrary. This will let the terminal track the current working\\ndirectory.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zsh\",\"enableVteIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.envExtra\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra commands that should be added to {file}`.zshenv`.\",\"loc\":[\"programs\",\"zsh\",\"envExtra\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.zsh.history\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options related to commands history configuration.\",\"loc\":[\"programs\",\"zsh\",\"history\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.zsh.history.append\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If set, zsh sessions will append their history list to the history\\nfile, rather than replace it. Thus, multiple parallel zsh sessions\\nwill all have the new entries from their history lists added to the\\nhistory file, in the order that they exit.\\n\\nThis file will still be periodically re-written to trim it when the\\nnumber of lines grows 20% beyond the value specified by\\n`programs.zsh.history.save`.\\n\",\"loc\":[\"programs\",\"zsh\",\"history\",\"append\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.history.expireDuplicatesFirst\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Expire duplicates first.\",\"loc\":[\"programs\",\"zsh\",\"history\",\"expireDuplicatesFirst\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.history.extended\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Save timestamp into the history file.\",\"loc\":[\"programs\",\"zsh\",\"history\",\"extended\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.history.findNoDups\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Do not display a line previously found in the history\\nfile.\\n\",\"loc\":[\"programs\",\"zsh\",\"history\",\"findNoDups\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.history.ignoreAllDups\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If a new command line being added to the history list\\nduplicates an older one, the older command is removed\\nfrom the list (even if it is not the previous event).\\n\",\"loc\":[\"programs\",\"zsh\",\"history\",\"ignoreAllDups\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.history.ignoreDups\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Do not enter command lines into the history list\\nif they are duplicates of the previous event.\\n\",\"loc\":[\"programs\",\"zsh\",\"history\",\"ignoreDups\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.history.ignorePatterns\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Do not enter command lines into the history list\\nif they match any one of the given shell patterns.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"rm *\\\"\\n  \\\"pkill *\\\"\\n]\"},\"loc\":[\"programs\",\"zsh\",\"history\",\"ignorePatterns\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.zsh.history.ignoreSpace\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Do not enter command lines into the history list\\nif the first character is a space.\\n\",\"loc\":[\"programs\",\"zsh\",\"history\",\"ignoreSpace\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.history.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"`\\\\${config.programs.zsh.dotDir}/.zsh_history`\\\"\"},\"description\":\"History file location\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"`\\\\${config.xdg.dataHome}/zsh/zsh_history`\\\"\"},\"loc\":[\"programs\",\"zsh\",\"history\",\"path\"],\"readOnly\":false,\"type\":\"string\"},\"programs.zsh.history.save\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"10000\"},\"description\":\"Number of history lines to save.\",\"loc\":[\"programs\",\"zsh\",\"history\",\"save\"],\"readOnly\":false,\"type\":\"signed integer\"},\"programs.zsh.history.saveNoDups\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Do not write duplicate entries into the history file.\\n\",\"loc\":[\"programs\",\"zsh\",\"history\",\"saveNoDups\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.history.share\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Share command history between zsh sessions.\",\"loc\":[\"programs\",\"zsh\",\"history\",\"share\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.history.size\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"10000\"},\"description\":\"Number of history lines to keep.\",\"loc\":[\"programs\",\"zsh\",\"history\",\"size\"],\"readOnly\":false,\"type\":\"signed integer\"},\"programs.zsh.historySubstringSearch\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options related to zsh-history-substring-search.\",\"loc\":[\"programs\",\"zsh\",\"historySubstringSearch\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.zsh.historySubstringSearch.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable history substring search.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zsh\",\"historySubstringSearch\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.historySubstringSearch.searchDownKey\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"^[[B\\\"\\n]\"},\"description\":\"The key codes to be used when searching down.\\nThe default of `^[[B` may correspond to the DOWN key -- if not, try\\n`$terminfo[kcud1]`.\\n\",\"loc\":[\"programs\",\"zsh\",\"historySubstringSearch\",\"searchDownKey\"],\"readOnly\":false,\"type\":\"(list of string) or string\"},\"programs.zsh.historySubstringSearch.searchUpKey\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/history.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/history.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"^[[A\\\"\\n]\"},\"description\":\"The key codes to be used when searching up.\\nThe default of `^[[A` may correspond to the UP key -- if not, try\\n`$terminfo[kcuu1]`.\\n\",\"loc\":[\"programs\",\"zsh\",\"historySubstringSearch\",\"searchUpKey\"],\"readOnly\":false,\"type\":\"(list of string) or string\"},\"programs.zsh.initContent\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Content to be added to {file}`.zshrc`.\\n\\nTo specify the order, use `lib.mkOrder`.\\n\\nCommon order values:\\n- 500 (mkBefore): Early initialization (replaces initExtraFirst)\\n- 550: Before completion initialization (replaces initExtraBeforeCompInit)\\n- 1000 (default): General configuration (replaces initExtra)\\n- 1500 (mkAfter): Last to run configuration\\n\\nTo specify both content in Early initialization and General configuration, use `lib.mkMerge`.\\n\\ne.g.\\n\\ninitContent = let\\n    zshConfigEarlyInit = lib.mkOrder 500 \\\"do something\\\";\\n    zshConfig = lib.mkOrder 1000 \\\"do something\\\";\\nin\\n    lib.mkMerge [ zshConfigEarlyInit zshConfig ];\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"lib.mkOrder 1200 '''\\n  echo \\\"Hello zsh initContent!\\\"\\n''';\\n\"},\"loc\":[\"programs\",\"zsh\",\"initContent\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.zsh.localVariables\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra local variables defined at the top of {file}`.zshrc`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  POWERLEVEL9K_LEFT_PROMPT_ELEMENTS = [\\n    \\\"dir\\\"\\n    \\\"vcs\\\"\\n  ];\\n}\"},\"loc\":[\"programs\",\"zsh\",\"localVariables\"],\"readOnly\":false,\"type\":\"attribute set\"},\"programs.zsh.loginExtra\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra commands that should be added to {file}`.zlogin`.\",\"loc\":[\"programs\",\"zsh\",\"loginExtra\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.zsh.logoutExtra\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra commands that should be added to {file}`.zlogout`.\",\"loc\":[\"programs\",\"zsh\",\"logoutExtra\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.zsh.oh-my-zsh\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/plugins/oh-my-zsh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/plugins/oh-my-zsh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options to configure oh-my-zsh.\",\"loc\":[\"programs\",\"zsh\",\"oh-my-zsh\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.zsh.oh-my-zsh.custom\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/plugins/oh-my-zsh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/plugins/oh-my-zsh