_to_allow_GRUB_w_GCC-15_compile_1_2.patch","pname":"grub","postConfigure":"# make sure .po files are up to date to workaround\n# parallel `msgmerge --update` on autogenerated .po files:\n#   https://github.com/NixOS/nixpkgs/pull/248747#issuecomment-1676301670\nmake dist\n","postInstall":"# Avoid a runtime reference to gcc\nsed -i $out/lib/grub/*/modinfo.sh -e \"/grub_target_cppflags=/ s|'.*'|' '|\"\n# just adding bash to buildInputs wasn't enough to fix the shebang\nsubstituteInPlace $out/lib/grub/*/modinfo.sh \\\n  --replace /nix/store/pwxj9ycwqd117yra6czifh3xfx5p88lh-bash-interactive-5.3p9 \"/usr/bin/bash\"\n","postPatch":"echo '#! /nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash' > util/grub-kbdcomp.in\necho 'echo \"Compile grub2 with { kbdcompSupport = true; } to enable support for this command.\"' >> util/grub-kbdcomp.in\n","preConfigure":" for i in \"tests/util/\"*.in\n do\n   sed -i \"$i\" -e's|/bin/bash|/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash|g'\n done\n\n # Apparently, the QEMU executable is no longer called\n # `qemu-system-i386', even on i386.\n #\n # In addition, use `-nodefaults' to avoid errors like:\n #\n #  chardev: opening backend \"stdio\" failed\n #  qemu: could not open serial device 'stdio': Invalid argument\n #\n # See <http://www.mail-archive.com/qemu-devel@nongnu.org/msg22775.html>.\n sed -i \"tests/util/grub-shell.in\" \\\n     -e's/qemu-system-i386/qemu-system-x86_64 -nodefaults/g'\n\nunset CPP # setting CPP intereferes with dependency calculation\n\npatchShebangs .\n\nGNULIB_REVISION=$(. bootstrap.conf; echo $GNULIB_REVISION)\nif [ \"$GNULIB_REVISION\" != 9f48fb992a3d7e96610c4ce8be969cff2d61a01b ]; then\n  echo \"This version of GRUB requires a different gnulib revision!\"\n  echo \"We have: 9f48fb992a3d7e96610c4ce8be969cff2d61a01b\"\n  echo \"GRUB needs: $GNULIB_REVISION\"\n  exit 1\nfi\n\ncp -f --no-preserve=mode /nix/store/8b2r9zy3vnq401b3l7vhq7w1mfgj03nf-source/po/LINGUAS /nix/store/8b2r9zy3vnq401b3l7vhq7w1mfgj03nf-source/po/*.po po\n\n./bootstrap --no-git --gnulib-srcdir=/nix/store/gmzis80yhd4sb0k7s8v0hzn7kgd11x79-gnulib-9f48fb9\n\nsubstituteInPlace ./configure --replace '/usr/share/fonts/unifont' '/nix/store/9j7ms62y0h7x1y09zbp3wgd65zpawddx-unifont-17.0.04/share/fonts'\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","src":"/nix/store/29zsvrihbkjw36ql7mdl2ppqd3ikr8x6-grub","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.12"},"inputs":{"drvs":{"09abhpb3pjvn3slijacfmsc4vhgkhz1g-automake-1.18.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"0ih6xn4hbchkabfkm1j9cfs4pi5x469x-35_kern_dl_check_for_the_SHF_INFO_LINK_flag_in_grub_dl_relocate_symbols.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"0kky2qd3xk08sgg4l2kchps8wimnssm0-65_script_execute_fix_potential_underflow_and_NULL.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"112br28jwjbpk3n83zi8lxsvlijm7m1y-61_net_use_safe_math_macros_to_prevent_overflows.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"16zcbjygs2waw6ai41fs3bdngc3kas6x-unifont-17.0.04.drv":{"dynamicOutputs":{},"outputs":["out"]},"1dgd5npbwk0p75fypgngplfdxsr7g8sn-04_fs_tar_initialize_name_in_grub_cpio_find_file.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"25dvf1w7qkkq684xpdwk56vg50fpj5n0-55_CVE-2025-0678_CVE-2025-1125.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"2kkzhzjgs3k999555q7b1njx5f7vn66l-libusb-compat-0.1.8.drv":{"dynamicOutputs":{},"outputs":["dev"]},"3g7a51l023srslmvl2w4cb8ay639b0a3-fuse-2.9.9.drv":{"dynamicOutputs":{},"outputs":["dev"]},"3h38wyymrb1b7vhm85c1ac91i65bxvxd-grub.drv":{"dynamicOutputs":{},"outputs":["out"]},"3j8c0hvqdlbsc6crvljwxm6kj761scvd-03_CVE-2024-45782_CVE-2024-56737.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"3n4xq871caxvsbyjfy4rcbvpifj391lw-59_fs_zfs_check_if_returned_pointer_for_allocated_memory_is_NULL.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"48ybhymvcfpv35n817xan9