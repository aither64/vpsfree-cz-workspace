known-linux-musl-1.2.5-debug","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/y6c394s9vb342r6wcngx80gnjw9bj9j9-musl-static-x86_64-unknown-linux-musl-1.2.5-dev","doCheck":"","doInstallCheck":"","dontAddStaticConfigureFlags":"1","dontDisableStatic":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"stackprotector","mesonFlags":"--cross-file=/nix/store/z5mm9bppvz0kmgygihk9wlpyvl57p6as-cross-file.conf","name":"musl-static-x86_64-unknown-linux-musl-1.2.5","nativeBuildInputs":"/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/kjddh2wx9sga6k2p0wh63xgkhdmmq0lq-musl-static-x86_64-unknown-linux-musl-1.2.5","outputs":"out bin dev debug","patches":"/nix/store/mdmbvb93z195n3bij8pa838v3safw346-300-relative.patch /nix/store/72fpjkqigm2ssmzsajvcar5g8vb86q4n-CVE-2025-26519_0.patch /nix/store/54zx02rd8drmrcq3i69y93srfxs5dnjf-CVE-2025-26519_1.patch /nix/store/fhs9vjjjgzpq70dzf7jwl5ipr9zhbbkl-CVE-2026-6042.patch /nix/store/alsk597agykwgmiljv54cxs1ykah2ryj-CVE-2026-40200.patch /nix/store/ym7qvxyrjvqqp5y9mfmgs909k410w6gk-stdio-skip-empty-iovec-when-buffering-is-disabled.patch","pname":"musl","postInstall":"# Not sure why, but link in all but scsi directory as that's what uclibc/glibc do.\n# Apparently glibc provides scsi itself?\n(cd $dev/include && ln -s $(ls -d /nix/store/fjpqwirch0gxf1min12g9lcmwrhka3q5-linux-headers-static-6.18.7/include/* | grep -v \"scsi$\") .)\n\n\n\n# Create 'ldd' symlink, builtin\nln -s $out/lib/libc.so $bin/bin/ldd\n\n# (impure) cc wrapper around musl for interactive usuage\nfor i in musl-gcc musl-clang ld.musl-clang; do\n  moveToOutput bin/$i $dev\ndone\nmoveToOutput lib/musl-gcc.specs $dev\nsubstituteInPlace $dev/bin/musl-gcc \\\n  --replace $out/lib/musl-gcc.specs $dev/lib/musl-gcc.specs\n\n# provide 'iconv' utility, using just-built headers, libc/ldso\n$CC /nix/store/2bim63kxh3vi6ka6inclfpba9rsjj6v9-iconv.c -o $bin/bin/iconv \\\n  -I$dev/include \\\n  -L$out/lib -Wl,-rpath=$out/lib \\\n  -lc \\\n  -B $out/lib \\\n  -Wl,-dynamic-linker=$(ls $out/lib/ld-*)\n# Create 'libc.musl-$arch' symlink\nln -rs $out/lib/libc.so $out/lib/libc.musl-x86_64.so.1\ninstall -D /nix/store/5rcakigix8xmpkmcx90a083pkf8v0gwp-sys-queue.h $dev/include/sys/queue.h\ninstall -D /nix/store/byib83r321c1fjgdk37kai1q1zxncra7-sys-cdefs.h $dev/include/sys/cdefs.h\ninstall -D /nix/store/rnay1kyfxqvjhmk0bfj7g85q6zskk1xy-sys-tree.h $dev/include/sys/tree.h\n","postPatch":"substituteInPlace configure \\\n  --replace -fno-unwind-tables \"\" \\\n  --replace -fno-asynchronous-unwind-tables \"\"\n","preBuild":"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","src":"/nix/store/mp8mmm58idwnlcla8fb2d3289q9m2b26-musl-1.2.5.tar.gz","stdenv":"/nix/store/y16f4klhvr37f0vzffcmkis96aqlh51q-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"1.2.5"},"inputs":{"drvs":{"23d17cqg76w1nxb9yk8d82prqrcvbam8-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"2jxjkkcvakvw2nw6d1hr8f42pij27vyn-sys-cdefs.h.drv":{"dynamicOutputs":{},"outputs":["out"]},"9pksyqvra6wvmfkvxrghk924g0qkb7ph-musl-1.2.5.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"aahlzbj2fdpaqnmsvsan9fls3vkw6vnr-CVE-2025-26519_1.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"ajn63aja8mh9baavm4icx4mf3wyg9mm2-CVE-2026-40200.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"icqcq393n11f9amzj2wzyipg757sj282-iconv.c.drv":{"dynamicOutputs":{},"outputs":["out"]},"k0crwh69f5x3h1r8n5mjgfcxljff0yqw-linux-headers-static-6.18.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"lcz2z5hhripyi3k305gsrag21nyncqrh-sys-tree.h.drv":{"dynamicOutputs":{},"outputs":["out"]},"p6i6dwln5xcvmmm9afj9y11fr93mcd7h-CVE-2025-26519_0.