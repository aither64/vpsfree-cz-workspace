fault\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set that maps aliases (the top level attribute names\\nin this option) to abbreviations. Abbreviations are expanded with\\nthe longer phrase after they are entered.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  gco = \\\"git checkout\\\";\\n  l = \\\"less\\\";\\n}\"},\"loc\":[\"programs\",\"zsh\",\"zsh-abbr\",\"abbreviations\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.zsh.zsh-abbr.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/plugins/zsh-abbr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/plugins/zsh-abbr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable zsh-abbr - zsh manager for auto-expanding abbreviations.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zsh\",\"zsh-abbr\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zsh.zsh-abbr.globalAbbreviations\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/plugins/zsh-abbr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/plugins/zsh-abbr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Similar to [](#opt-programs.zsh.zsh-abbr.abbreviations),\\nbut are expanded anywhere on a line.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  G = \\\"| grep\\\";\\n  L = \\\"| less -R\\\";\\n}\"},\"loc\":[\"programs\",\"zsh\",\"zsh-abbr\",\"globalAbbreviations\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.zsh.zsh-abbr.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zsh/plugins/zsh-abbr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zsh/plugins/zsh-abbr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.zsh-abbr\"},\"description\":\"The zsh-abbr package to use.\",\"loc\":[\"programs\",\"zsh\",\"zsh-abbr\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"qt.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Qt 5 and 6 configuration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"qt\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"qt.kde.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt/kconfig.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt/kconfig.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"A set of values to be modified by {command}`kwriteconfig6`.\\n\\nThe example value would cause the following command to run in the\\nactivation script:\\n\\n``` shell\\nkwriteconfig6 --file $XDG_CONFIG_HOME/powermanagementprofilesrc \\\\\\n              --group AC \\\\\\n              --group HandleButtonEvents \\\\\\n              --group lidAction \\\\\\n              --key lidAction \\\\\\n              32\\n```\\n\\nNote, `null` values will delete the corresponding entry instead of\\ninserting any value.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  powermanagementprofilesrc = {\\n    AC = {\\n      HandleButtonEvents = {\\n        lidAction = 32;\\n      };\\n    };\\n  };\\n}\"},\"loc\":[\"qt\",\"kde\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (KDE option value)\"},\"qt.kvantum.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt/kvantum.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt/kvantum.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Kvantum configuration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"qt\",\"kvantum\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"qt.kvantum.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt/kvantum.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt/kvantum.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Global configuration settings written to {file}`$XDG_CONFIG_HOME/Kvantum/kvantum.kvconfig`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  Applications = {\\n    KvArc = [\\n      \\\"app1\\\"\\n      \\\"app2\\\"\\n    ];\\n    KvFlat = [\\n      \\\"app3\\\"\\n    ];\\n  };\\n  General = {\\n    theme = \\\"KvAdapta\\\";\\n  };\\n  SomethingElse = {\\n    foo = \\\"bar\\\";\\n  };\\n}\"},\"loc\":[\"qt\",\"kvantum\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of section of a kvconfig file (attrs of INI atom (null, bool, int, float or string) or a non-empty list of them)\"},\"qt.kvantum.settings.Applications\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt/kvantum.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt/kvantum.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Application configuration settings for Kvantum.\\n\\nThemes set here will override {option}`qt.kvantum.settings.General.theme`\\nfor their specific applications.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  KvArc = [\\n    \\\"app1\\\"\\n    \\\"app2\\\"\\n  ];\\n  KvFlat = [\\n    \\\"app3\\\"\\n  ];\\n}\"},\"loc\":[\"qt\",\"kvantum\",\"settings\",\"Applications\"],\"readOnly\":false,\"type\":\"attribute set of list of string\"},\"qt.kvantum.settings.General\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt/kvantum.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt/kvantum.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"General configuration settings for Kvantum.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  theme = \\\"KvAdapta\\\";\\n}\"},\"loc\":[\"qt\",\"kvantum\",\"settings\",\"General\"],\"readOnly\":false,\"type\":\"open submodule of section of a kvconfig file (attrs of INI atom (null, bool, int, float or string) or a non-empty list of them)\"},\"qt.kvantum.settings.General.theme\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt/kvantum.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt/kvantum.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default Kvantum theme to use.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"KvAdapta\\\"\"},\"loc\":[\"qt\",\"kvantum\",\"settings\",\"General\",\"theme\"],\"readOnly\":false,\"type\":\"null or string\"},\"qt.kvantum.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt/kvantum.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt/kvantum.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Theme packages to install to {file}`$XDG_CONFIG_HOME/Kvantum/`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs; [\\n  gruvbox-kvantum\\n  catppuccin-kvantum\\n]\"},\"loc\":[\"qt\",\"kvantum\",\"themes\"],\"readOnly\":false,\"type\":\"list of package\"},\"qt.platformTheme\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Deprecated. Use {option}`qt.platformTheme.name` instead.\\n\",\"loc\":[\"qt\",\"platformTheme\"],\"readOnly\":false,\"type\":\"null or one of \\\"gtk\\\", \\\"gtk3\\\", \\\"gnome\\\", \\\"adwaita\\\", \\\"lxqt\\\", \\\"qtct\\\", \\\"kde\\\", \\\"kde6\\\" or (submodule)\"},\"qt.platformTheme.name\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Platform theme to use for Qt applications.\\n\\nSome examples are\\n\\n`gtk`\\n: Use GTK theme with\\n  [`qtstyleplugins`](https://github.com/qt/qtstyleplugins)\\n\\n`gtk3`\\n: Use [GTK3 integration](https://github.com/qt/qtbase/tree/dev/src/plugins/platformthemes/gtk3)\\n  for file picker dialogs, font and theme configuration\\n\\n`adwaita`\\n: Use Adwaita theme with\\n  [`qadwaitadecorations`](https://github.com/FedoraQt/QAdwaitaDecorations)\\n\\n`gnome` (deprecated)\\n: Use GNOME theme with\\n  [`qgnomeplatform`](https://github.com/FedoraQt/QGnomePlatform).\\n  Is no longer maintained so prefer `adwaita`.\\n\\n`lxqt`\\n: Use LXQt theme style set using the\\n  [`lxqt-config-appearance`](https://github.com/lxqt/lxqt-config)\\n  application\\n\\n`qtct`\\n: Use Qt style set using\\n  [`qt5ct`](https://github.com/desktop-app/qt5ct)\\n  and [`qt6ct`](https://github.com/trialuser02/qt6ct)\\n  applications\\n\\n`kde`\\n: Use Qt settings from Plasma\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"adwaita\\\"\"},\"loc\":[\"qt\",\"platformTheme\",\"name\"],\"readOnly\":false,\"relatedPackages\":\"- [`pkgs.qgnomeplatform`](\\n    https://search.nixos.org/packages?show=qgnomeplatform&sort=relevance&query=qgnomeplatform\\n  )\\n- [`pkgs.qgnomeplatform-qt6`](\\n    https://search.nixos.org/packages?show=qgnomeplatform-qt6&sort=relevance&query=qgnomeplatform-qt6\\n  )\\n- [`pkgs.qadwaitadecorations`](\\n    https://search.nixos.org/packages?show=qadwaitadecorations&sort=relevance&query=qadwaitadecorations\\n  )\\n- [`pkgs.qadwaitadecorations-qt6`](\\n    https://search.nixos.org/packages?show=qadwaitadecorations-qt6&sort=relevance&query=qadwaitadecorations-qt6\\n  )\\n- [`pkgs.libsForQt5.plasma-integration`](\\n    https://search.nixos.org/packages?show=libsForQt5.plasma-integration&sort=relevance&query=libsForQt5.plasma-integration\\n  )\\n- [`pkgs.libsForQt5.qt5ct`](\\n    https://search.nixos.org/packages?show=libsForQt5.qt5ct&sort=relevance&query=libsForQt5.qt5ct\\n  )\\n- [`pkgs.libsForQt5.qtstyleplugins`](\\n    https://search.nixos.org/packages?show=libsForQt5.qtstyleplugins&sort=relevance&query=libsForQt5.qtstyleplugins\\n  )\\n- [`pkgs.libsForQt5.systemsettings`](\\n    https://search.nixos.org/packages?show=libsForQt5.systemsettings&sort=relevance&query=libsForQt5.systemsettings\\n  )\\n- [`pkgs.kdePackages.plasma-integration`](\\n    https://search.nixos.org/packages?show=kdePackages.plasma-integration&sort=relevance&query=kdePackages.plasma-integration\\n  )\\n- [`pkgs.kdePackages.systemsettings`](\\n    https://search.nixos.org/packages?show=kdePackages.systemsettings&sort=relevance&query=kdePackages.systemsettings\\n  )\\n- [`pkgs.lxqt.lxqt-config`](\\n    https://search.nixos.org/packages?show=lxqt.lxqt-config&sort=relevance&query=lxqt.lxqt-config\\n  )\\n- [`pkgs.lxqt.lxqt-qtplugin`](\\n    https://search.nixos.org/packages?show=lxqt.lxqt-qtplugin&sort=relevance&query=lxqt.lxqt-qtplugin\\n  )\\n- [`pkgs.qt6Packages.qt6ct`](\\n    https://search.nixos.org/packages?show=qt6Packages.qt6ct&sort=relevance&query=qt6Packages.qt6ct\\n  )\\n- [`pkgs.qt6Packages.qt6gtk2`](\\n    https://search.nixos.org/packages?show=qt6Packages.qt6gtk2&sort=relevance&query=qt6Packages.qt6gtk2\\n  )\\n\",\"type\":\"null or string\"},\"qt.platformTheme.package\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Theme package to be used in Qt5/Qt6 applications.\\nAuto-detected from {option}`qt.platformTheme.name` if possible.\\nSee its documentation for available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[pkgs.adwaita-qt pkgs.adwaita-qt6]\"},\"loc\":[\"qt\",\"platformTheme\",\"package\"],\"readOnly\":false,\"type\":\"null or package or list of package\"},\"qt.qt5ctSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Qtct configuration. Writes settings to `qt5ct/qt5ct.conf`\\nfile. Lists will be translated to comma-separated strings.\\nFonts must be quoted (see example).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  Appearance = {\\n    icon_theme = \\\"Papirus-Dark\\\";\\n    standard_dialogs = \\\"xdgdesktopportal\\\";\\n    style = \\\"kvantum\\\";\\n  };\\n  Fonts = {\\n    fixed = \\\"\\\\\\\"DejaVuSansM Nerd Font Mono,12\\\\\\\"\\\";\\n    general = \\\"\\\\\\\"DejaVu Sans,12\\\\\\\"\\\";\\n  };\\n}\"},\"loc\":[\"qt\",\"qt5ctSettings\"],\"readOnly\":false,\"type\":\"null or (attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string) or a non-empty list of them))\"},\"qt.qt6ctSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Qtct configuration. Writes settings to `qt6ct/qt6ct.conf`\\nfile. Lists will be translated to comma-separated strings.\\nFonts must be quoted (see example).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  Appearance = {\\n    icon_theme = \\\"Papirus-Dark\\\";\\n    standard_dialogs = \\\"xdgdesktopportal\\\";\\n    style = \\\"kvantum\\\";\\n  };\\n  Fonts = {\\n    fixed = \\\"\\\\\\\"DejaVuSansM Nerd Font Mono,12\\\\\\\"\\\";\\n    general = \\\"\\\\\\\"DejaVu Sans,12\\\\\\\"\\\";\\n  };\\n}\"},\"loc\":[\"qt\",\"qt6ctSettings\"],\"readOnly\":false,\"type\":\"null or (attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string) or a non-empty list of them))\"},\"qt.style.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Style to use for Qt5/Qt6 applications. Case-insensitive.\\n\\nSome examples are\\n\\n`adwaita`, `adwaita-dark`, `adwaita-highcontrast`, `adwaita-highcontrastinverse`\\n: Use the Adwaita style from\\n  [`adwaita-qt`](https://github.com/FedoraQt/adwaita-qt)\\n\\n`breeze`\\n: Use the Breeze style from\\n  [`breeze`](https://github.com/KDE/breeze)\\n\\n`bb10bright`, `bb10dark`, `cde`, `cleanlooks`, `gtk2`, `motif`, `plastique`\\n: Use styles from\\n  [`qtstyleplugins`](https://github.com/qt/qtstyleplugins)\\n\\n`kvantum`\\n: Use styles from\\n  [`kvantum`](https://github.com/tsujan/Kvantum)\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"adwaita-dark\\\"\"},\"loc\":[\"qt\",\"style\",\"name\"],\"readOnly\":false,\"relatedPackages\":\"- [`pkgs.adwaita-qt`](\\n    https://search.nixos.org/packages?show=adwaita-qt&sort=relevance&query=adwaita-qt\\n  )\\n- [`pkgs.adwaita-qt6`](\\n    https://search.nixos.org/packages?show=adwaita-qt6&sort=relevance&query=adwaita-qt6\\n  )\\n- [`pkgs.libsForQt5.breeze-qt5`](\\n    https://search.nixos.org/packages?show=libsForQt5.breeze-qt5&sort=relevance&query=libsForQt5.breeze-qt5\\n  )\\n- [`pkgs.libsForQt5.qtstyleplugin-kvantum`](\\n    https://search.nixos.org/packages?show=libsForQt5.qtstyleplugin-kvantum&sort=relevance&query=libsForQt5.qtstyleplugin-kvantum\\n  )\\n- [`pkgs.libsForQt5.qtstyleplugins`](\\n    https://search.nixos.org/packages?show=libsForQt5.qtstyleplugins&sort=relevance&query=libsForQt5.qtstyleplugins\\n  )\\n- [`pkgs.qt6Packages.qt6gtk2`](\\n    https://search.nixos.org/packages?show=qt6Packages.qt6gtk2&sort=relevance&query=qt6Packages.qt6gtk2\\n  )\\n- [`pkgs.qt6Packages.qtstyleplugin-kvantum`](\\n    https://search.nixos.org/packages?show=qt6Packages.qtstyleplugin-kvantum&sort=relevance&query=qt6Packages.qtstyleplugin-kvantum\\n  )\\n\",\"type\":\"null or string\"},\"qt.style.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/qt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/qt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Theme package to be used in Qt5/Qt6 applications.\\nAuto-detected from {option}`qt.style.name` if possible.\\nSee its documentation for available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.adwaita-qt\"},\"loc\":[\"qt\",\"style\",\"package\"],\"readOnly\":false,\"type\":\"null or package or list of package\"},\"services.activitywatch.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable ActivityWatch, an automated time tracker.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"activitywatch\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.activitywatch.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Additional arguments to be passed on to the ActivityWatch server.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--port\\\"\\n  \\\"5999\\\"\\n]\"},\"loc\":[\"services\",\"activitywatch\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.activitywatch.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.activitywatch\"},\"description\":\"The activitywatch package to use. Specifically, this should be a package containing [the Rust implementation\\nof ActivityWatch server](https://github.com/ActivityWatch/aw-server-rust).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.aw-server-rust\"},\"loc\":[\"services\",\"activitywatch\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.activitywatch.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for `aw-server-rust` to be generated at\\n{file}`$XDG_CONFIG_HOME/activitywatch/aw-server-rust/config.toml`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  port = 3012;\\n\\n  custom_static = {\\n    my-custom-watcher = \\\"${pkgs.my-custom-watcher}/share/my-custom-watcher/static\\\";\\n    aw-keywatcher = \\\"${pkgs.aw-keywatcher}/share/aw-keywatcher/static\\\";\\n  };\\n}\\n\"},\"loc\":[\"services\",\"activitywatch\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"services.activitywatch.watchers\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Watchers to be included with the service alongside with their\\nconfiguration.\\n\\nCheck with `systemctl --user status \\\"*aw*\\\"`\\n\\nIf a configuration is set, a file will be generated in\\n{file}`$XDG_CONFIG_HOME/activitywatch/$WATCHER_NAME/$WATCHER_SETTINGS_FILENAME`.\\n\\n::: {.note}\\nThe watchers are run with the service manager and the settings format\\nof the configuration is only assumed to be in TOML. Furthermore, it\\nassumes the watcher program is using the official client libraries\\nwhich has functions to store it in the appropriate location.\\n:::\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  aw-watcher-afk = {\\n    package = pkgs.activitywatch;\\n    settings = {\\n      timeout = 300;\\n      poll_time = 2;\\n    };\\n  };\\n\\n  aw-watcher-window = {\\n    package = pkgs.activitywatch;\\n    settings = {\\n      poll_time = 1;\\n      exclude_title = true;\\n    };\\n  };\\n\\n  my-custom-watcher = {\\n    package = pkgs.my-custom-watcher;\\n    executable = \\\"mcw\\\";\\n    settings = {\\n      hello = \\\"there\\\";\\n      enable_greetings = true;\\n      poll_time = 5;\\n    };\\n    settingsFilename = \\\"config.toml\\\";\\n  };\\n}\\n\"},\"loc\":[\"services\",\"activitywatch\",\"watchers\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"services.activitywatch.watchers.<name>.executable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"The name of the executable of the watcher. This is useful in case the\\nwatcher name is different from the executable. By default, this\\noption uses the watcher name.\\n\",\"loc\":[\"services\",\"activitywatch\",\"watchers\",\"<name>\",\"executable\"],\"readOnly\":false,\"type\":\"string\"},\"services.activitywatch.watchers.<name>.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra arguments to be passed to the watcher executable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--host\\\"\\n  \\\"127.0.0.1\\\"\\n]\"},\"loc\":[\"services\",\"activitywatch\",\"watchers\",\"<name>\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.activitywatch.watchers.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"The name of the watcher. This will be used as the directory name for\\n{file}`$XDG_CONFIG_HOME/activitywatch/$NAME` when\\n{option}`services.activitywatch.watchers.<name>.settings` is set.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"aw-watcher-afk\\\"\"},\"loc\":[\"services\",\"activitywatch\",\"watchers\",\"<name>\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"services.activitywatch.watchers.<name>.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.activitywatch\"},\"description\":\"The activitywatch package to use. The derivation containing the watcher executable.\",\"loc\":[\"services\",\"activitywatch\",\"watchers\",\"<name>\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.activitywatch.watchers.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The settings for the individual watcher in TOML format. If set, a\\nfile will be generated at\\n{file}`$XDG_CONFIG_HOME/activitywatch/$NAME/$FILENAME`.\\n\\nTo set the basename of the settings file, see\\n[](#opt-services.activitywatch.watchers._name_.settingsFilename).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  poll_time = 2;\\n  timeout = 300;\\n}\"},\"loc\":[\"services\",\"activitywatch\",\"watchers\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"services.activitywatch.watchers.<name>.settingsFilename\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/activitywatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/activitywatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›.toml\\\"\"},\"description\":\"The filename of the generated settings file. By default, this uses\\nthe watcher name to be generated at\\n{file}`$XDG_CONFIG_HOME/activitywatch/$NAME/$NAME.toml`.\\n\\nThis is useful in case the watcher requires a different name for the\\nconfiguration file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"config.toml\\\"\"},\"loc\":[\"services\",\"activitywatch\",\"watchers\",\"<name>\",\"settingsFilename\"],\"readOnly\":false,\"type\":\"string\"},\"services.amberol.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/amberol.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/amberol.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Amberol music player as a daemon.\\n\\nNote, it is necessary to add\\n```nix\\nprograms.dconf.enable = true;\\n```\\nto your system configuration for the daemon to work correctly.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"amberol\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.