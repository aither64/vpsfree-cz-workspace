386f786d619bc9a16177f2e149/using-nix/2a3-intermediate-musl.nix\nsed -i 's|/bin/sh|/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash|' \\\n  tools/*.sh\nchmod 755 tools/*.sh\n# patch popen/system to search in PATH instead of hardcoding /bin/sh\nsed -i 's|posix_spawn(&pid, \"/bin/sh\",|posix_spawnp(\\&pid, \"sh\",|' \\\n  src/stdio/popen.c src/process/system.c\nsed -i 's|execl(\"/bin/sh\", \"sh\", \"-c\",|execlp(\"sh\", \"-c\",|'\\\n  src/misc/wordexp.c\n\n# @PLT specifier is not supported by tinycc.\n# Calls do go through PLT regardless.\nsed -i 's|@PLT||' src/math/x86_64/expl.s\nsed -i 's|@PLT||' src/signal/x86_64/sigsetjmp.s\n\n# TODO Implement the required asm constraints 'x' and 't' in tinycc.\n# For now, we just remove code using those constraints. musl automatically\n# polyfills with pure C implementations.\nrm src/math/i386/*.c\nrm src/math/x86_64/*.c\n\n# Configure\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --disable-shared \\\n  CC=tcc\n\n# Build\n# NOTE: parallel build (-j) under tcc here is unstable and broke a previous run.\nmake AR=\"tcc -ar\" RANLIB=true CFLAGS=\"-DSYSCALL_NO_TLS\"\n\n# Install\nmake install\ncp /nix/store/km6izy2mps05hgn54byk9vav7lmkazil-tinycc-musl-unstable-2025-12-03-libs/lib/libtcc1.a $out/lib\n","builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","name":"musl-1.2.6","out":"/nix/store/8vaxvk541czfwm8h41i705hf4a1gispq-musl-1.2.6","passAsFile":"buildCommand","pname":"musl","system":"x86_64-linux","version":"1.2.6"},"inputs":{"drvs":{"05z44243pvwk3qrcimv1cf5g3nxi5jjb-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"59pgig863abfc3p6lmz20vh8gjf2nsv1-musl-1.2.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6f6p45qkd5mhdwvfzgxdydwdpplccvgj-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"7g9biqznf18jyzs1r19hhlbf1jvwyivl-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"agzpw52wkapzm