makeEtcEntry() {\n  src=\"$1\"\n  target=\"$2\"\n  mode=\"$3\"\n  user=\"$4\"\n  group=\"$5\"\n\n  if [[ \"$src\" = *'*'* ]]; then\n    # If the source name contains '*', perform globbing.\n    mkdir -p \"$out/etc/$target\"\n    for fn in $src; do\n        ln -s \"$fn\" \"$out/etc/$target/\"\n    done\n  else\n\n    mkdir -p \"$out/etc/$(dirname \"$target\")\"\n    if ! [ -e \"$out/etc/$target\" ]; then\n      ln -s \"$src\" \"$out/etc/$target\"\n    else\n      echo \"duplicate entry $target -> $src\"\n      if [ \"$(readlink \"$out/etc/$target\")\" != \"$src\" ]; then\n        echo \"mismatched duplicate entry $(readlink \"$out/etc/$target\") <-> $src\"\n        ret=1\n      fi\n    fi\n\n    if [ \"$mode\" != symlink ]; then\n      echo \"$mode\" > \"$out/etc/$target.mode\"\n      echo \"$user\" > \"$out/etc/$target.uid\"\n      echo \"$group\" > \"$out/etc/$target.gid\"\n    fi\n  fi\n}\n\nmkdir -p \"$out/etc\"\nmakeEtcEntry /nix/store/h8rkvsai7yplgb6hmp4c5wglpbm9wry6-etc-bash_logout bash_logout symlink +0 +0\nmakeEtcEntry /nix/store/x148z08barylh2cqgsb6w97bgdmrxw7d-etc-bashrc bashrc symlink +0 +0\nmakeEtcEntry /nix/store/g28l15mbdbig59n102zd0ardsfisiw32-binfmt_nixos.conf binfmt.d/nixos.conf symlink +0 +0\nmakeEtcEntry /nix/store/yg067lljqxqsyy119cbcwbcrv5r5gg3y-dbus-1 dbus-1 symlink +0 +0\nmakeEtcEntry /nix/store/ficvykjp88vkd2ixlm4hxzgcxd58bkl6-useradd default/useradd symlink +0 +0\nmakeEtcEntry /nix/store/igj9imf4p7fa58si1k92zgg0pbf7jbzp-etc-environment.d-50-systemd-path.conf environment.d/50-systemd-path.conf symlink +0 +0\nmakeEtcEntry /nix/store/ypa65b41ppmjz5yv15635b9g5xjpv8cr-fontconfig-etc/etc/fonts/ fonts symlink +0 +0\nmakeEtcEntry /nix/store/3ihb2r0flh98q8xrhsppygkxf4p2gdj2-etc-fstab fstab symlink +0 +0\nmakeEtcEntry /nix/store/95s3v37l8w6h8c29pzqkizhh5llb0yc7-etc-fuse.conf fuse.conf symlink +0 +0\nmakeEtcEntry /nix/store/qrkafqdp6hf864cb6113xbhjpcrf0yli-etc-gai.conf gai.conf symlink +0 +0\nmakeEtcEntry /nix/store/n6c4yyjlgx992scmgavvdal6mh125db1-etc