ralExpression\",\"text\":\"[\\n  \\\"foo\\\"\\n  \\\"bar\\\"\\n]\"},\"loc\":[\"programs\",\"newsboat\",\"urls\",\"*\",\"tags\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.newsboat.urls.*.title\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/newsboat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/newsboat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Feed title.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ORF News\\\"\"},\"loc\":[\"programs\",\"newsboat\",\"urls\",\"*\",\"title\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.newsboat.urls.*.url\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/newsboat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/newsboat.nix\"}],\"description\":\"Feed URL.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"http://example.com\\\"\"},\"loc\":[\"programs\",\"newsboat\",\"urls\",\"*\",\"url\"],\"readOnly\":false,\"type\":\"string\"},\"programs.nh.clean.dates\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"weekly\\\"\"},\"description\":\"How often cleanup is performed.\\n\\nOn linux the format is described in {manpage}`systemd.time(7)`.\\n\\nOn Darwin, it must be one of: hourly, daily, weekly, monthly, semiannually, annually, which are implemented as defined in {manpage}`systemd.time(7)`.\\n\\n\",\"loc\":[\"programs\",\"nh\",\"clean\",\"dates\"],\"readOnly\":false,\"type\":\"(optionally newline-terminated) single-line string\"},\"programs.nh.clean.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable periodic garbage collection for user profile and nix store with nh clean\\nuser.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nh\",\"clean\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nh.clean.extraArgs\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Options given to nh clean when the service is run automatically.\\n\\nSee `nh clean all --help` for more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"--keep 5 --keep-since 3d\\\"\"},\"loc\":[\"programs\",\"nh\",\"clean\",\"extraArgs\"],\"readOnly\":false,\"type\":\"(optionally newline-terminated) single-line string\"},\"programs.nh.darwinFlake\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The string that will be used for the {env}`NH_DARWIN_FLAKE` environment variable.\\n\\n{env}`NH_DARWIN_FLAKE` is used by nh as the default flake for performing\\n{command}`nh darwin` actions, such as {command}`nh darwin switch`.\\nSetting this will take priority over the `flake` option.\\n\",\"loc\":[\"programs\",\"nh\",\"darwinFlake\"],\"readOnly\":false,\"type\":\"null or (optionally newline-terminated) single-line string or absolute path\"},\"programs.nh.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable nh, yet another Nix CLI helper.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nh\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nh.flake\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The path that will be used for the {env}`FLAKE` environment variable.\\n\\n{env}`FLAKE` is used by nh as the default flake for performing actions,\\nlike {command}`nh os switch`.\\n\",\"loc\":[\"programs\",\"nh\",\"flake\"],\"readOnly\":false,\"type\":\"null or (optionally newline-terminated) single-line string or absolute path\"},\"programs.nh.homeFlake\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The string that will be used for the {env}`NH_HOME_FLAKE` environment variable.\\n\\n{env}`NH_HOME_FLAKE` is used by nh as the default flake for performing {command}`nh home`\\nactions, such as {command}`nh home switch`.\\nSetting this will take priority over the `flake` option.\\n\",\"loc\":[\"programs\",\"nh\",\"homeFlake\"],\"readOnly\":false,\"type\":\"null or (optionally newline-terminated) single-line string or absolute path\"},\"programs.nh.osFlake\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The string that will be used for the {env}`NH_OS_FLAKE` environment variable.\\n\\n{env}`NH_OS_FLAKE` is used by nh as the default flake for performing {command}`nh os`\\nactions, such as {command}`nh os switch`.\\nSetting this will take priority over the `flake` option.\\n\",\"loc\":[\"programs\",\"nh\",\"osFlake\"],\"readOnly\":false,\"type\":\"null or (optionally newline-terminated) single-line string or absolute path\"},\"programs.nh.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.nh\"},\"description\":\"The nh package to use.\",\"loc\":[\"programs\",\"nh\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.nheko.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nheko.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nheko.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Qt desktop client for Matrix.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nheko\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nheko.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nheko.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nheko.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.nheko\"},\"description\":\"The nheko package to use.\",\"loc\":[\"programs\",\"nheko\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.nheko.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nheko.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nheko.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of Nheko preferences (converted to an INI file).\\n\\nFor now, it is recommended to run nheko and sign-in before filling in\\nthe configuration settings in this module, as nheko writes the access\\ntoken to {file}`$XDG_CONFIG_HOME/nheko/nheko.conf` the\\nfirst time we sign in, and we need that data into these settings for the\\ncorrect functionality of the application.\\n\\nThis a temporary inconvenience, however, as nheko has plans to [move the\\nauthentication stuff into the secret storage](https://github.com/Nheko-Reborn/nheko/issues/1591).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  general.disableCertificateValidation = false;\\n  auth = {\\n    accessToken = \\\"SECRET\\\";\\n    deviceId = \\\"MY_DEVICE\\\";\\n    homeServer = \\\"https://matrix-client.matrix.org:443\\\";\\n    userId = \\\"@@user:matrix.org\\\";\\n  };\\n  settings.scaleFactor = 1.0;\\n  sidebar.width = 416;\\n  user = {\\n    alertOnNotification = true;\\n    animateImagesOnHover = false;\\n    \\\"sidebar\\\\\\\\roomListWidth\\\" = 308;\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"nheko\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.nix-index.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-index.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-index.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable nix-index, a file database for nixpkgs.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nix-index\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nix-index.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-index.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-index.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"nix-index\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nix-index.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-index.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-index.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"nix-index\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nix-index.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-index.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-index.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"nix-index\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nix-index.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-index.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-index.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"nix-index\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nix-index.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-index.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-index.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.nix-index\"},\"description\":\"The nix-index package to use.\",\"loc\":[\"programs\",\"nix-index\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.nix-init.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-init.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-init.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable nix-init.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nix-init\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nix-init.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-init.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-init.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.nix-init\"},\"description\":\"The nix-init package to use.\",\"loc\":[\"programs\",\"nix-init\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.nix-init.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-init.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-init.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/nix-init/config.toml`.\\nSee <https://github.com/nix-community/nix-init#configuration> for the full list\\nof options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  maintainers = [\\n    \\\"figsoda\\\"\\n  ];\\n  nixpkgs = \\\"<nixpkgs>\\\";\\n  commit = true;\\n  access-tokens = {\\n    \\\"github.com\\\" = \\\"ghp_blahblahblah...\\\";\\n    \\\"gitlab.com\\\" = {\\n      command = [\\n        \\\"secret-tool\\\"\\n        \\\"or\\\"\\n        \\\"whatever\\\"\\n        \\\"you\\\"\\n        \\\"use\\\"\\n      ];\\n    };\\n    \\\"gitlab.gnome.org\\\" = {\\n      file = \\\"/path/to/api/token\\\";\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"nix-init\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.nix-search-tv.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-search-tv.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-search-tv.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable nix-search-tv.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nix-search-tv\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nix-search-tv.enableTelevisionIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-search-tv.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-search-tv.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.programs.television.enable\"},\"description\":\"Enables integration with television. Creates a channel through\\n`programs.television.channels.nix-search-tv`, which are set as defaults\\nand can be overridden.\\nSee [programs.television.channels](#opt-programs.television.channels)\\nfor more information\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nix-search-tv\",\"enableTelevisionIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nix-search-tv.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-search-tv.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-search-tv.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.nix-search-tv\"},\"description\":\"The nix-search-tv package to use.\",\"loc\":[\"programs\",\"nix-search-tv\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.nix-search-tv.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-search-tv.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-search-tv.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/nix-search-tv/config.json`.\\nSee <https://github.com/3timeslazy/nix-search-tv?tab=readme-ov-file#configuration>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  indexes = [ \\\"nixpkgs\\\" \\\"home-manager\\\" \\\"nixos\\\" ];\\n\\n  experimental = {\\n    render_docs_indexes = {\\n      nvf = \\\"https://notashelf.github.io/nvf/options.html\\\";\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"nix-search-tv\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.nix-your-shell.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-your-shell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-your-shell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable {command}`nix-your-shell`, a wrapper for `nix develop` or `nix-shell`\\nto retain the same shell inside the new environment.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nix-your-shell\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nix-your-shell.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nix-your-shell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nix-your-shell.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression