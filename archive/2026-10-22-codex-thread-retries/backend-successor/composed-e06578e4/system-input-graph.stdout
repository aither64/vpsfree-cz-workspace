ms\",\"wlogout\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.wlogout.style\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wlogout.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wlogout.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"CSS style of the bar.\\n\\nSee <https://github.com/ArtsyMacaw/wlogout#style>\\nfor the documentation.\\n\\nIf the value is set to a path literal, then the path will be used as the css file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  window {\\n    background: #16191C;\\n  }\\n  \\n  button {\\n    color: #AAB2BF;\\n  }\\n''\"},\"loc\":[\"programs\",\"wlogout\",\"style\"],\"readOnly\":false,\"type\":\"null or absolute path or strings concatenated with \\\"\\\\n\\\"\"},\"programs.wofi.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable wofi: a launcher/menu program for wlroots based wayland compositors such as sway.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"wofi\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.wofi.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wofi\"},\"description\":\"The wofi package to use.\",\"loc\":[\"programs\",\"wofi\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.wofi.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration options for wofi. See\\n{manpage}`wofi(5)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  allow_markup = true;\\n  location = \\\"bottom-right\\\";\\n  width = 250;\\n}\"},\"loc\":[\"programs\",\"wofi\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set\"},\"programs.wofi.style\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"CSS style for wofi to use as a stylesheet. See\\n{manpage}`wofi(7)`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  * {\\n      font-family: monospace;\\n  }\\n  \\n  window {\\n      background-color: #7c818c;\\n  }\\n''\"},\"loc\":[\"programs\",\"wofi\",\"style\"],\"readOnly\":false,\"type\":\"null or strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.workstyle.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/workstyle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/workstyle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Workstyle.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"workstyle\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.workstyle.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/workstyle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/workstyle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.workstyle\"},\"description\":\"The workstyle package to use.\",\"loc\":[\"programs\",\"workstyle\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.workstyle.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/workstyle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/workstyle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for workstyle\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  # Config for workstyle\\n  # Format: \\\"pattern\\\" = \\\"icon\\\";\\n  # The pattern will be used to match against the application name, class_id or WM_CLASS.\\n  # The icon will be used to represent that application.\\n  # Note if multiple patterns are present in the same application name,\\n  # precedence is given in order of apparition in this file.\\n  kitty = \\\"T\\\";\\n  firefox = \\\"B\\\";\\n  other = {\\n    fallback_icon = \\\"F\\\";\\n    deduplicate_icons = false;\\n    separator = \\\": \\\";\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"workstyle\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.workstyle.systemd.debug\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/workstyle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/workstyle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Workstyle debug logs.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"workstyle\",\"systemd\",\"debug\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.workstyle.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/workstyle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/workstyle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Workstyle systemd integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"workstyle\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.workstyle.systemd.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/workstyle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/workstyle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.wayland.systemd.target\"},\"description\":\"The systemd target that will automatically start the Workstyle service.\\n\\nWhen setting this value to `\\\"sway-session.target\\\"`,\\nmake sure to also enable {option}`wayland.windowManager.sway.systemd.enable`,\\notherwise the service may never be started.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"sway-session.target\\\"\"},\"loc\":[\"programs\",\"workstyle\",\"systemd\",\"target\"],\"readOnly\":false,\"type\":\"string\"},\"programs.xmobar.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/xmobar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/xmobar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Xmobar, a minimalistic status bar.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"xmobar\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.xmobar.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/xmobar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/xmobar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines to add to\\n{file}`$XDG_CONFIG_HOME/xmobar/.xmobarrc`.\\nSee\\n<https://xmobar.org/#configuration>\\nfor options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"Config\\n  { font        = \\\"Fira Code\\\"\\n  , borderColor = \\\"#d0d0d0\\\"\\n  , border      = FullB\\n  , borderWidth = 3\\n  , bgColor     = \\\"#222\\\"\\n  , fgColor     = \\\"grey\\\"\\n  , position    = TopSize C 99 30\\n  , commands    =\\n      [ Run Cpu [\\\"-t\\\", \\\"cpu: <fc=#4eb4fa><bar> <total>%</fc>\\\"] 10\\n      , Run Network \\\"enp3s0\\\" [\\\"-S\\\", \\\"True\\\", \\\"-t\\\", \\\"eth: <fc=#4eb4fa><rx></fc>/<fc=#4eb4fa><tx></fc>\\\"] 10\\n      , Run Memory [\\\"-t\\\",\\\"mem: <fc=#4eb4fa><usedbar> <usedratio>%</fc>\\\"] 10\\n      , Run Date \\\"date: <fc=#4eb4fa>%a %d %b %Y %H:%M:%S </fc>\\\" \\\"date\\\" 10\\n      , Run StdinReader\\n      ]\\n  , sepChar     = \\\"%\\\"\\n  , alignSep    = \\\"}{\\\"\\n  , template    = \\\"  %StdinReader% | %cpu% | %memory% | %enp3s0%  }{%date%  \\\"\\n  }\\n\"},\"loc\":[\"programs\",\"xmobar\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.xmobar.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/xmobar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/xmobar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.haskellPackages.xmobar\"},\"description\":\"The xmobar package to use.\",\"loc\":[\"programs\",\"xmobar\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.xplr.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/xplr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/xplr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable xplr, terminal UI based file explorer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"xplr\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.xplr.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/xplr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/xplr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra xplr configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"require(\\\"wl-clipboard\\\").setup {\\n  copy_command = \\\"wl-copy -t text/uri-list\\\",\\n  paste_command = \\\"wl-paste\\\",\\n  keep_selection = true,\\n}\\n\"},\"loc\":[\"programs\",\"xplr\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.xplr.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/xplr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/xplr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.xplr\"},\"description\":\"The xplr package to use.\",\"loc\":[\"programs\",\"xplr\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.xplr.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/xplr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/xplr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of plugin paths to be added to the [package.path]<https://www.lua.org/manual/5.4/manual.html#pdf-package.path> of the {file}`~/config/xplr/init.lua` configuration file.\\n\\nMust be a package or string representing the plugin directory's path.\\nIf the path string is not absolute, it will be relative to {file}`$XDG_CONFIG_HOME/xplr/init.lua`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  wl-clipboard = fetchFromGitHub {\\n    owner = \\\"sayanarijit\\\";\\n    repo = \\\"wl-clipboard.xplr\\\";\\n    rev = \\\"a3ffc87460c5c7f560bffea689487ae14b36d9c3\\\";\\n    hash = \\\"sha256-I4rh5Zks9hiXozBiPDuRdHwW5I7ppzEpQNtirY0Lcks=\\\";\\n  }\\n  local-plugin = \\\"/home/user/.config/plugins/local-plugin\\\";\\n};\\n\"},\"loc\":[\"programs\",\"xplr\",\"plugins\"],\"readOnly\":false,\"type\":\"null or (attribute set of (package or string))\"},\"programs.yambar.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yambar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yambar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Yambar.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"yambar\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yambar.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yambar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yambar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.yambar\"},\"description\":\"The yambar package to use.\",\"loc\":[\"programs\",\"yambar\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.yambar.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yambar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yambar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/yambar/config.yml`.\\nSee {manpage}`yambar(5)` for options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"bar = {\\n  location = \\\"top\\\";\\n  height = 26;\\n  background = \\\"00000066\\\";\\n\\n  right = [\\n    {\\n      clock.content = [\\n        {\\n          string.text = \\\"{time}\\\";\\n        }\\n      ];\\n    }\\n  ];\\n};\\n\"},\"loc\":[\"programs\",\"yambar\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.yambar.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yambar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yambar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable yambar systemd integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"yambar\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yambar.systemd.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yambar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yambar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.wayland.systemd.target\"},\"description\":\"The systemd target that will automatically start the yambar service.\\n\\nWhen setting this value to `\\\"sway-session.target\\\"`,\\nmake sure to also enable {option}`wayland.windowManager.sway.systemd.enable`,\\notherwise the service may never be started.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"sway-session.target\\\"\"},\"loc\":[\"programs\",\"yambar\",\"systemd\",\"target\"],\"readOnly\":false,\"type\":\"string\"},\"programs.yarn.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yarn>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yarn\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable management of yarn config.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"yarn\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yarn.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yarn>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yarn\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Available configuration options for yarn see:\\n<https://yarnpkg.com/configuration/yarnrc>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  httpProxy = \\\"http://proxy.example.org:3128\\\";\\n  httpsProxy = \\\"http://proxy.example.org:3128\\\";\\n}\\n\"},\"loc\":[\"programs\",\"yarn\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.yazi.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable yazi.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"yazi\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yazi.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"yazi\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yazi.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"yazi\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yazi.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"yazi\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yazi.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"yazi\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yazi.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra packages to make available to yazi.\\n\\nThese packages will be added to the yazi wrapper's PATH.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs; [\\n  glow\\n  ouch\\n]\\n\"},\"loc\":[\"programs\",\"yazi\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.yazi.flavors\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Pre-made themes.\\nValues should be a package or path containing the required files.\\nWill be linked to {file}`$XDG_CONFIG_HOME/yazi/flavors/<name>.yazi`.\\n\\nSee <https://yazi-rs.github.io/docs/flavors/overview/> for documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  foo = ./foo;\\n  bar = pkgs.bar;\\n}\\n\"},\"loc\":[\"programs\",\"yazi\",\"flavors\"],\"readOnly\":false,\"type\":\"attribute set of (absolute path or package)\"},\"programs.yazi.initLua\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The init.lua for Yazi itself.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"./init.lua\"},\"loc\":[\"programs\",\"yazi\",\"initLua\"],\"readOnly\":false,\"type\":\"null or absolute path or strings concatenated with \\\"\\\\n\\\"\"},\"programs.yazi.keymap\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/yazi/keymap.toml`.\\n\\nSee <https://yazi-rs.github.io/docs/configuration/keymap>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  input.prepend_keymap = [\\n    { run = \\\"close\\\"; on = [ \\\"<C-q>\\\" ]; }\\n    { run = \\\"close --submit\\\"; on = [ \\\"<Enter>\\\" ]; }\\n    { run = \\\"escape\\\"; on = [ \\\"<Esc>\\\" ]; }\\n    { run = \\\"backspace\\\"; on = [ \\\"<Backspace>\\\" ]; }\\n  ];\\n  mgr.prepend_keymap = [\\n    { run = \\\"escape\\\"; on = [ \\\"<Esc>\\\" ]; }\\n    { run = \\\"quit\\\"; on = [ \\\"q\\\" ]; }\\n    { run = \\\"close\\\"; on = [ \\\"<C-q>\\\" ]; }\\n  ];\\n}\\n\"},\"loc\":[\"programs\",\"yazi\",\"keymap\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.yazi.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.yazi\"},\"description\":\"The yazi package to use.\",\"loc\":[\"programs\",\"yazi\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.yazi.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Lua plugins.\\nValues can be a package or path (linked as-is), or an attribute set\\nwith {option}`package`, {option}`setup`, and {option}`settings`.\\n\\nPlugins with {option}`setup` set to {var}`true` generate a\\n{command}`require(\\\"{name}\\\"):setup({...})` call in\\n{file}`$XDG_CONFIG_HOME/yazi/init.lua`, written before any\\n{option}`initLua` content.\\n\\nSee <https://yazi-rs.github.io/docs/plugins/overview>\\nfor documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  # package only, no setup call\\n  foo = pkgs.foo;\\n\\n  # empty setup call: require(\\\"bar\\\"):setup()\\n  bar = {\\n    package = pkgs.bar;\\n    setup = true;\\n  };\\n\\n  # setup call with settings\\n  baz = {\\n    package = pkgs.baz;\\n    setup = true;\\n    settings = {\\n      part_separator = { open = \\\"\\\"; close = \\\"\\\"; };\\n      tab_width = 20;\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"yazi\",\"plugins\"],\"readOnly\":false,\"type\":\"attribute set of ((submodule) or (absolute path or package) convertible to it)\"},\"programs.yazi.plugins.<name>.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"description\":\"Package or path for the plugin.\\nWill be linked to\\n{file}`$XDG_CONFIG_HOME/yazi/plugins/<name>.yazi`.\\n\",\"loc\":[\"programs\",\"yazi\",\"plugins\",\"<name>\",\"package\"],\"readOnly\":false,\"type\":\"absolute path or package\"},\"programs.yazi.plugins.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set passed to the plugin's\\n{command}`setup()` as a Lua table (via\\n{command}`lib.generators.toLua`). Values created with\\n{command}`lib.generators.mkLuaInline` are rendered as raw Lua expressions.\\nOnly used when {option}`setup` is {var}`true`.\\nWhen empty, {command}`setup()` is called with no\\narguments.\\n\",\"loc\":[\"programs\",\"yazi\",\"plugins\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set\"},\"programs.yazi.plugins.<name>.setup\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When {var}`true`, generates a\\n{command}`require(\\\"{name}\\\"):setup({...})` call in\\n{file}`$XDG_CONFIG_HOME/yazi/init.lua`.\\n\",\"loc\":[\"programs\",\"yazi\",\"plugins\",\"<name>\",\"setup\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yazi.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/yazi/yazi.toml`.\\n\\nSee <https://yazi-rs.github.io/docs/configuration/yazi>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  log = {\\n    enabled = false;\\n  };\\n  mgr = {\\n    show_hidden = false;\\n    sort_by = \\\"mtime\\\";\\n    sort_dir_first = true;\\n    sort_reverse = true;\\n  };\\n}\"},\"loc\":[\"programs\",\"yazi\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.yazi.shellWrapperName\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"if lib.versionAtLeast config.home.stateVersion \\\"26.05\\\" then \\\"y\\\" else \\\"yy\\\"\\n\"},\"description\":\"Name of the shell wrapper to be called.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"yy\\\"\"},\"loc\":[\"programs\",\"yazi\",\"shellWrapperName\"],\"readOnly\":false,\"type\":\"string\"},\"programs.yazi.theme\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/yazi/theme.toml`.\\n\\nSee <https://yazi-rs.github.io/docs/configuration/theme>\\nfor the full list of options\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  filetype = {\\n    rules = [\\n      { fg = \\\"#7AD9E5\\\"; mime = \\\"image/*\\\"; }\\n      { fg = \\\"#F3D398\\\"; mime = \\\"video/*\\\"; }\\n      { fg = \\\"#F3D398\\\"; mime = \\\"audio/*\\\"; }\\n      { fg = \\\"#CD9EFC\\\"; mime = \\\"application/bzip\\\"; }\\n    ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"yazi\",\"theme\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.yazi.vfs\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/yazi/vfs.toml`.\\n\\nSee <https://yazi-rs.github.io/docs/configuration/vfs>\\nfor the full list of options\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  services = {\\n    my-server = {\\n      host = \\\"1.2.3.4\\\";\\n      port = 22;\\n      type = \\\"sftp\\\";\\n      user = \\\"root\\\";\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"yazi\",\"vfs\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.yofi.blacklist\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of .desktop files yofi should ignore.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"firefox\\\"\\n  \\\"librewolf\\\"\\n  \\\"com.obsproject.Studio\\\"\\n  \\\"com.rtosta.zapzap\\\"\\n  \\\"cups\\\"\\n  \\\"kitty-open\\\"\\n  \\\"nvim\\\"\\n]\"},\"loc\":[\"programs\",\"yofi\",\"blacklist\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.yofi.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable yofi.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"yofi\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yofi.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.yofi\"},\"description\":\"The yofi package to use.\",\"loc\":[\"programs\",\"yofi\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.yofi.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for yofi. For all the available options\\nsee: <https://github.com/l4l/yofi/wiki/Configuration#main-configuration>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  bg_border_color = \\\"0x131411ff\\\";\\n  bg_color = \\\"0x272822ee\\\";\\n  corner_radius = \\\"0\\\";\\n  font_size = 24;\\n  force_window = false;\\n  height = 512;\\n  input_text = {\\n    bg_color = \\\"0x75715eff\\\";\\n    font_color = \\\"0xf8f8f2ff\\\";\\n    margin = \\\"5\\\";\\n    padding = \\\"1.7 -4\\\";\\n  };\\n  width = 400;\\n}\"},\"loc\":[\"programs\",\"yofi\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.yt-dlp.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yt-dlp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yt-dlp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable yt-dlp.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"yt-dlp\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.yt-dlp.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yt-dlp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yt-dlp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration to add to\\n{file}`$XDG_CONFIG_HOME/yt-dlp/config`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  --update\\n  -F\\n''\"},\"loc\":[\"programs\",\"yt-dlp\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.yt-dlp.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yt-dlp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yt-dlp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.yt-dlp\"},\"description\":\"The yt-dlp package to use.\",\"loc\":[\"programs\",\"yt-dlp\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.yt-dlp.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/yt-dlp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/yt-dlp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/yt-dlp/config`.\\n\\nOptions must be specified in their \\\"long form\\\", for\\nexample, `update = true;` instead of `U = true;`.\\nShort options can be specified in the `extraConfig` option.\\nSee <https://github.com/yt-dlp/yt-dlp#configuration>\\nfor explanation about possible values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  color = [\\n    \\\"stdout:no_color\\\"\\n    \\\"stderr:always\\\"\\n  ];\\n  downloader = \\\"aria2c\\\";\\n  downloader-args = \\\"aria2c:'-c -x8 -s8 -k1M'\\\";\\n  embed-subs = true;\\n  embed-thumbnail = true;\\n  sub-langs = \\\"all\\\";\\n}\"},\"loc\":[\"programs\",\"yt-dlp\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or string or list of (boolean or signed integer or string))\"},\"programs.z-lua.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/z-lua.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/z-lua.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable z.lua.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"z-lua\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.z-lua.enableAliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/z-lua.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/z-lua.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable recommended z.lua aliases.\\n\",\"loc\":[\"programs\",\"z-lua\",\"enableAliases\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.z-lua.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/z-lua.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/z-lua.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"z-lua\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.z-lua.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/z-lua.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/z-lua.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"z-lua\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.z-lua.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/z-lua.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/z-lua.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"z-lua\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.z-lua.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/z-lua.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/z-lua.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of options to pass to z.lua.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"enhanced\\\"\\n  \\\"once\\\"\\n  \\\"fzf\\\"\\n]\"},\"loc\":[\"programs\",\"z-lua\",\"options\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.z-lua.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/z-lua.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/z-lua.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.z-lua\"},\"description\":\"The z-lua package to use.\",\"loc\":[\"programs\",\"z-lua\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.zapzap.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zapzap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zapzap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable zapzap.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zapzap\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zapzap.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zapzap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zapzap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.zapzap\"},\"description\":\"The zapzap package to use.\",\"loc\":[\"programs\",\"zapzap\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.zapzap.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zapzap.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zapzap.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for zapzap. All the available options can be found by\\nchanging the settings from the GUI and looking at $XDG_CONFIG_HOME/ZapZap/ZapZap.conf.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  notification = {\\n    donation_message = true;\\n  };\\n  system = {\\n    scale = 150;\\n    theme = \\\"dark\\\";\\n    wayland = true;\\n  };\\n  website = {\\n    open_page = false;\\n  };\\n}\"},\"loc\":[\"programs\",\"zapzap\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.zathura.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zathura.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zathura.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Zathura, a highly customizable and functional document viewer\\nfocused on keyboard interaction.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zathura\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zathura.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zathura.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zathura.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Additional commands for zathura that will be added to the\\n{file}`zathurarc` file.\\n\",\"loc\":[\"programs\",\"zathura\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.zathura.mappings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zathura.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zathura.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Add {option}`:map` mappings to zathura and make\\nthem permanent. See\\n{manpage}`zathurarc(5)`\\nfor the full list of possible mappings.\\n\\nYou can create a mode-specific mapping by specifying the mode before the key:\\n`\\\"[normal] <C-b>\\\" = \\\"scroll left\\\";`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"<Right>\\\" = \\\"navigate next\\\";\\n  D = \\\"toggle_page_mode\\\";\\n  \\\"[fullscreen] <C-i>\\\" = \\\"zoom in\\\";\\n}\"},\"loc\":[\"programs\",\"zathura\",\"mappings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.zathura.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zathura.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zathura.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Add {option}`:set` command options to zathura and make\\nthem permanent. See\\n{manpage}`zathurarc(5)`\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  default-bg = \\\"#000000\\\";\\n  default-fg = \\\"#FFFFFF\\\";\\n}\"},\"loc\":[\"programs\",\"zathura\",\"options\"],\"readOnly\":false,\"type\":\"attribute set of (string or boolean or signed integer or floating point number)\"},\"programs.zathura.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zathura.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zathura.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.zathura\"},\"description\":\"The zathura package to use.\",\"loc\":[\"programs\",\"zathura\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.zed-editor.defaultEditor\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to set {command}`zeditor -w` as the default editor using the\\n{env}`EDITOR` and {env}`VISUAL` environment variables.\\n\",\"loc\":[\"programs\",\"zed-editor\",\"defaultEditor\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zed-editor.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Zed, the high performance, multiplayer code editor from the creators of Atom and Tree-sitter.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zed-editor\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zed-editor.enableMcpIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to integrate the MCP server config from\\n{option}`programs.mcp.servers` into\\n{option}`programs.zed-editor.userSettings.context_servers`.\\n\\nNote: Settings defined in {option}`programs.zed-editor.userSettings.context_servers`\\nwill take precedence over the generated MCP configuration.\\n\",\"loc\":[\"programs\",\"zed-editor\",\"enableMcpIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zed-editor.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"A list of the extensions Zed should install on startup.\\nUse the name of a repository in the [extension list](https://github.com/zed-industries/extensions/tree/main/extensions).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"swift\\\"\\n  \\\"nix\\\"\\n  \\\"xy-zed\\\"\\n]\"},\"loc\":[\"programs\",\"zed-editor\",\"extensions\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.zed-editor.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra packages available to Zed.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.nixd ]\"},\"loc\":[\"programs\",\"zed-editor\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.zed-editor.installRemoteServer\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to symlink the Zed's remote server binary to the expected\\nlocation. This allows remotely connecting to this system from a\\ndistant Zed client.\\n\\nFor more information, consult the\\n[\\\"Remote Server\\\" section](https://wiki.nixos.org/wiki/Zed#Remote_Server)\\nin the wiki.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zed-editor\",\"installRemoteServer\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zed-editor.mutableUserDebug\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether user debug configurations (debug.json) can be updated by zed.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"zed-editor\",\"mutableUserDebug\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zed-editor.mutableUserKeymaps\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether user keymaps (keymap.json) can be updated by zed.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"zed-editor\",\"mutableUserKeymaps\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zed-editor.mutableUserSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether user settings (settings.json) can be updated by zed.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"zed-editor\",\"mutableUserSettings\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zed-editor.mutableUserTasks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether user tasks (tasks.json) can be updated by zed.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"zed-editor\",\"mutableUserTasks\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zed-editor.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.zed-editor\"},\"description\":\"The zed-editor package to use.\",\"loc\":[\"programs\",\"zed-editor\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.zed-editor.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Each theme is written to\\n{file}`$XDG_CONFIG_HOME/zed/themes/theme-name.json`\\nwhere the name of each attribute is the theme-name\\n\\nSee <https://zed.dev/docs/extensions/themes> for the structure of a\\nZed theme\\n\",\"loc\":[\"programs\",\"zed-editor\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value or absolute path or strings concatenated with \\\"\\\\n\\\")\"},\"programs.zed-editor.userDebug\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Configuration written to Zed's {file}`debug.json`.\\n\\nGlobal debug configurations for Zed's [Debugger](https://zed.dev/docs/debugger).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    adapter = \\\"Delve\\\";\\n    label = \\\"Go (Delve)\\\";\\n    mode = \\\"debug\\\";\\n    program = \\\"$ZED_FILE\\\";\\n    request = \\\"launch\\\";\\n  }\\n]\"},\"loc\":[\"programs\",\"zed-editor\",\"userDebug\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.zed-editor.userKeymaps\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Configuration written to Zed's {file}`keymap.json`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    context = \\\"Workspace\\\";\\n    bindings = {\\n      ctrl-shift-t = \\\"workspace::NewTerminal\\\";\\n    };\\n  };\\n]\\n\"},\"loc\":[\"programs\",\"zed-editor\",\"userKeymaps\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.zed-editor.userSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to Zed's {file}`settings.json`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  buffer_font_size = 16;\\n  features = {\\n    copilot = false;\\n  };\\n  telemetry = {\\n    metrics = false;\\n  };\\n  ui_font_size = 16;\\n  vim_mode = false;\\n}\"},\"loc\":[\"programs\",\"zed-editor\",\"userSettings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.zed-editor.userTasks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zed-editor.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zed-editor.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Configuration written to Zed's {file}`tasks.json`.\\n\\n[List of tasks](https://zed.dev/docs/tasks) that can be run from the\\ncommand palette.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    args = [\\n      \\\"fmt\\\"\\n      \\\"$ZED_WORKTREE_ROOT\\\"\\n    ];\\n    command = \\\"nix\\\";\\n    label = \\\"Format Code\\\";\\n  }\\n]\"},\"loc\":[\"programs\",\"zed-editor\",\"userTasks\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.zellij.attachExistingSession\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to attach to the default session after being autostarted if a Zellij session already exists.\\n\\nVariable is checked in `auto-start` script. Requires shell integration to be enabled to have effect.\\n\",\"loc\":[\"programs\",\"zellij\",\"attachExistingSession\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zellij.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Zellij.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zellij\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zellij.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zellij\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zellij.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zellij\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zellij.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zellij\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zellij.exitShellOnExit\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to exit the shell when Zellij exits after being autostarted.\\n\\nVariable is checked in `auto-start` script. Requires shell integration to be enabled to have effect.\\n\",\"loc\":[\"programs\",\"zellij\",\"exitShellOnExit\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zellij.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines to add to `$XDG_CONFIG_HOME/zellij/config.kdl`.\\n\\nThis does not support zellij.yaml and it's mostly a workaround for https://github.com/nix-community/home-manager/issues/4659.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  keybinds {\\n      // keybinds are divided into modes\\n      normal {\\n          // bind instructions can include one or more keys (both keys will be bound separately)\\n          // bind keys can include one or more actions (all actions will be performed with no sequential guarantees)\\n          bind \\\"Ctrl g\\\" { SwitchToMode \\\"locked\\\"; }\\n          bind \\\"Ctrl p\\\" { SwitchToMode \\\"pane\\\"; }\\n          bind \\\"Alt n\\\" { NewPane; }\\n          bind \\\"Alt h\\\" \\\"Alt Left\\\" { MoveFocusOrTab \\\"Left\\\"; }\\n      }\\n      pane {\\n          bind \\\"h\\\" \\\"Left\\\" { MoveFocus \\\"Left\\\"; }\\n          bind \\\"l\\\" \\\"Right\\\" { MoveFocus \\\"Right\\\"; }\\n          bind \\\"j\\\" \\\"Down\\\" { MoveFocus \\\"Down\\\"; }\\n          bind \\\"k\\\" \\\"Up\\\" { MoveFocus \\\"Up\\\"; }\\n          bind \\\"p\\\" { SwitchFocus; }\\n      }\\n      locked {\\n          bind \\\"Ctrl g\\\" { SwitchToMode \\\"normal\\\"; }\\n      }\\n  }\\n''\"},\"loc\":[\"programs\",\"zellij\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.zellij.layouts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/zellij/layouts/<layout>.kdl`.\\n\\nSee <https://zellij.dev/documentation> for the full\\nlist of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  dev = {\\n    layout = {\\n      _children = [\\n        {\\n          default_tab_template = {\\n            _children = [\\n              {\\n                pane = {\\n                  borderless = true;\\n                  plugin = {\\n                    location = \\\"zellij:tab-bar\\\";\\n                  };\\n                  size = 1;\\n                };\\n              }\\n              {\\n                children = { };\\n              }\\n              {\\n                pane = {\\n                  borderless = true;\\n                  plugin = {\\n                    location = \\\"zellij:status-bar\\\";\\n                  };\\n                  size = 2;\\n                };\\n              }\\n            ];\\n          };\\n        }\\n        {\\n          tab = {\\n            _children = [\\n              {\\n                pane = {\\n                  command = \\\"nvim\\\";\\n                };\\n              }\\n            ];\\n            _props = {\\n              focus = true;\\n              name = \\\"Project\\\";\\n            };\\n          };\\n        }\\n        {\\n          tab = {\\n            _children = [\\n              {\\n                pane = {\\n                  command = \\\"lazygit\\\";\\n                };\\n              }\\n            ];\\n            _props = {\\n              name = \\\"Git\\\";\\n            };\\n          };\\n        }\\n        {\\n          tab = {\\n            _children = [\\n              {\\n                pane = {\\n                  command = \\\"yazi\\\";\\n                };\\n              }\\n            ];\\n            _props = {\\n              name = \\\"Files\\\";\\n            };\\n          };\\n        }\\n        {\\n          tab = {\\n            _children = [\\n              {\\n                pane = {\\n                  command = \\\"zsh\\\";\\n                };\\n              }\\n            ];\\n            _props = {\\n              name = \\\"Shell\\\";\\n            };\\n          };\\n        }\\n      ];\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"zellij\",\"layouts\"],\"readOnly\":false,\"type\":\"attribute set of (YAML 1.1 value or absolute path or strings concatenated with \\\"\\\\n\\\")\"},\"programs.zellij.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.zellij\"},\"description\":\"The zellij package to use.\",\"loc\":[\"programs\",\"zellij\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.zellij.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/zellij/config.kdl`.\\n\\nIf `programs.zellij.package.version` is older than 0.32.0, then\\nthe configuration is written to {file}`$XDG_CONFIG_HOME/zellij/config.yaml`.\\n\\nSee <https://zellij.dev/documentation> for the full\\nlist of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  theme = \\\"custom\\\";\\n  themes.custom.fg = \\\"#ffffff\\\";\\n  keybinds._props.clear-defaults = true;\\n  keybinds.pane._children = [\\n    {\\n      bind = {\\n        _args = [\\\"e\\\"];\\n        _children = [\\n          { TogglePaneEmbedOrFloating = {}; }\\n          { SwitchToMode._args = [\\\"locked\\\"]; }\\n        ];\\n      };\\n    }\\n    {\\n      bind = {\\n        _args = [\\\"left\\\"];\\n        MoveFocus = [\\\"left\\\"];\\n      };\\n    }\\n  ];\\n}\\n\"},\"loc\":[\"programs\",\"zellij\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.zellij.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zellij.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zellij.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Each them is written to {file}`$XDG_CONFIG_HOME/zellij/themes/NAME.kdl`.\\nSee <https://zellij.dev/documentation/themes.html> for more information.\\n\",\"loc\":[\"programs\",\"zellij\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (YAML 1.1 value or absolute path or strings concatenated with \\\"\\\\n\\\")\"},\"programs.zk.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zk.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zk.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable zk.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zk\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zk.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zk.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zk.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.zk\"},\"description\":\"The zk package to use.\",\"loc\":[\"programs\",\"zk\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.zk.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zk.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zk.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/zk/config.toml`.\\n\\nSee <https://github.com/mickael-menu/zk/blob/main/docs/config.md> for\\navailable options and documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  extra = {\\n    author = \\\"Mickaël\\\";\\n  };\\n  note = {\\n    default-title = \\\"Untitled\\\";\\n    extension = \\\"md\\\";\\n    filename = \\\"{{id}}-{{slug title}}\\\";\\n    id-case = \\\"lower\\\";\\n    id-charset = \\\"alphanum\\\";\\n    id-length = 4;\\n    language = \\\"en\\\";\\n    template = \\\"default.md\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"zk\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.zoxide.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zoxide.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zoxide.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable zoxide.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"zoxide\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zoxide.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zoxide.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zoxide.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"zoxide\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zoxide.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zoxide.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zoxide.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"zoxide\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zoxide.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zoxide.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zoxide.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"zoxide\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.zoxide.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/zoxide.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/zoxide.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether