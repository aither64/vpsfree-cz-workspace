ease-26.05/modules/programs/discord.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"discord\\\"\"},\"description\":\"Name of the subdirectory where {file}`settings.json` is linked under.\\nFor example discord-canary uses `discordcanary`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"discordptb\\\"\"},\"loc\":[\"programs\",\"discord\",\"configName\"],\"readOnly\":false,\"type\":\"string\"},\"programs.discord.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/discord.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/discord.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Discord, the chat platform.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"discord\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.discord.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/discord.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/discord.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.discord\"},\"description\":\"The discord package to use.\",\"loc\":[\"programs\",\"discord\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.discord.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/discord.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/discord.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for Discord.\\nThe schema does not seem to be documented anywhere\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  DANGEROUS_ENABLE_DEVTOOLS_ONLY_ENABLE_IF_YOU_KNOW_WHAT_YOURE_DOING = true;\\n}\"},\"loc\":[\"programs\",\"discord\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (JSON value)\"},\"programs.discord.settings.DANGEROUS_ENABLE_DEVTOOLS_ONLY_ENABLE_IF_YOU_KNOW_WHAT_YOURE_DOING\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/discord.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/discord.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Chrome's devtools inside Discord\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"discord\",\"settings\",\"DANGEROUS_ENABLE_DEVTOOLS_ONLY_ENABLE_IF_YOU_KNOW_WHAT_YOURE_DOING\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.discord.settings.SKIP_HOST_UPDATE\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/discord.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/discord.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to skip Discord's automatic update checks at startup\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"discord\",\"settings\",\"SKIP_HOST_UPDATE\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.distrobox.containers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/distrobox.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/distrobox.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"A set of containers and all its respective configurations. Each option can be either a\\nbool, string or a list of strings. If passed a list, the option will be repeated for each element.\\nSee common-debian in the example config. All the available options for the containers can be found\\nin the distrobox-assemble documentation at <https://github.com/89luca89/distrobox/blob/main/docs/usage/distrobox-assemble.md>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  common-debian = {\\n    additional_packages = \\\"git\\\";\\n    entry = true;\\n    image = \\\"debian:13\\\";\\n    init_hooks = [\\n      \\\"ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/docker\\\"\\n      \\\"ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/docker-compose\\\"\\n    ];\\n  };\\n  office = {\\n    additional_packages = \\\"libreoffice onlyoffice\\\";\\n    clone = \\\"common-debian\\\";\\n    entry = true;\\n  };\\n  python-project = {\\n    additional_packages = \\\"python3 git\\\";\\n    image = \\\"fedora:40\\\";\\n    init_hooks = \\\"pip3 install numpy pandas torch torchvision\\\";\\n  };\\n  random-things = {\\n    clone = \\\"common-debian\\\";\\n    entry = false;\\n  };\\n}\"},\"loc\":[\"programs\",\"distrobox\",\"containers\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string) or a list of them for duplicate keys)\"},\"programs.distrobox.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/distrobox.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/distrobox.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable distrobox.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"distrobox\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.distrobox.enableSystemdUnit\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/distrobox.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/distrobox.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"config.programs.distrobox.containers != { } && config.programs.distrobox.package != null\\\"\"},\"description\":\"Whatever to enable a Systemd Unit that automatically rebuilds your\\ncontainers when changes are detected.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"distrobox\",\"enableSystemdUnit\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.distrobox.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/distrobox.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/distrobox.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.distrobox\"},\"description\":\"The distrobox package to use.\",\"loc\":[\"programs\",\"distrobox\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.distrobox.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/distrobox.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/distrobox.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for Distrobox. All the available options can be found here:\\n<https://github.com/89luca89/distrobox?tab=readme-ov-file#configure-distrobox>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  container_additional_volumes = \\\"/example:/example1 /example2:/example3:ro\\\";\\n  container_always_pull = \\\"1\\\";\\n  container_generate_entry = 0;\\n  container_image_default = \\\"registry.opensuse.org/opensuse/toolbox:latest\\\";\\n  container_init_hook = \\\"~/.local/distrobox/a_custom_default_init_hook.sh\\\";\\n  container_manager = \\\"docker\\\";\\n  container_manager_additional_flags = \\\"--env-file /path/to/file --custom-flag\\\";\\n  container_name_default = \\\"test-name-1\\\";\\n  container_pre_init_hook = \\\"~/a_custom_default_pre_init_hook.sh\\\";\\n  container_user_custom_home = \\\"$HOME/.local/share/container-home-test\\\";\\n  non_interactive = \\\"1\\\";\\n  skip_workdir = \\\"0\\\";\\n}\"},\"loc\":[\"programs\",\"distrobox\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (INI atom (null, bool, int, float or string) or a list of them for duplicate keys)\"},\"programs.docker-cli.configDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/docker-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/docker-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"if config.xdg.enable && lib.versionAtLeast config.home.stateVersion \\\"26.05\\\" then\\n  \\\"$XDG_CONFIG_HOME/docker\\\"\\nelse\\n  \\\".docker\\\"\\n\"},\"description\":\"Directory to store configuration and state. This also sets $DOCKER_CONFIG.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"${config.xdg.configHome}/docker\"},\"loc\":[\"programs\",\"docker-cli\",\"configDir\"],\"readOnly\":false,\"type\":\"string\"},\"programs.docker-cli.contexts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/docker-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/docker-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of Docker context configurations. Each attribute name becomes the context Name; overriding requires lib.mkForce. See:\\n<https://docs.docker.com/engine/manage-resources/contexts/\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  example = {\\n    Metadata = { Description = \\\"example1\\\"; };\\n    Endpoints.docker.Host = \\\"unix://example2\\\";\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"docker-cli\",\"contexts\"],\"readOnly\":false,\"type\":\"attribute set of (open submodule of (JSON value))\"},\"programs.docker-cli.contexts.<name>.Name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/docker-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/docker-cli.nix\"}],\"description\":\"Name of the Docker context. Defaults to the attribute name (the <name> in programs.docker-cli.contexts.<name>). Overriding requires lib.mkForce.\",\"loc\":[\"programs\",\"docker-cli\",\"contexts\",\"<name>\",\"Name\"],\