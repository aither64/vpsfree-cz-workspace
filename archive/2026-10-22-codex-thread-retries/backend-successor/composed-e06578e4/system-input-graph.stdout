r/modules/services/wayvnc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wayvnc.nix\"}],\"description\":\"The port to which the server shall bind.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"5901\"},\"loc\":[\"services\",\"wayvnc\",\"settings\",\"port\"],\"readOnly\":false,\"type\":\"16 bit unsigned integer; between 0 and 65535 (both inclusive)\"},\"services.wayvnc.systemdTarget\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wayvnc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wayvnc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.wayland.systemd.target\"},\"description\":\"Systemd target to bind to.\\n\",\"loc\":[\"services\",\"wayvnc\",\"systemdTarget\"],\"readOnly\":false,\"type\":\"string\"},\"services.wl-clip-persist.clipboardType\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wl-clip-persist.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wl-clip-persist.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"regular\\\"\"},\"description\":\"The clipboard type to persist.\\n\\n- `regular`: Persist the regular clipboard only (recommended).\\n- `primary`: Persist the primary selection only.\\n- `both`: Persist both regular and primary clipboards.\\n\\nNote: Operating on the primary clipboard may have unintended side effects\\nfor some applications.\\n\",\"loc\":[\"services\",\"wl-clip-persist\",\"clipboardType\"],\"readOnly\":false,\"type\":\"one of \\\"regular\\\", \\\"primary\\\", \\\"both\\\"\"},\"services.wl-clip-persist.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wl-clip-persist.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wl-clip-persist.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable wl-clip-persist, a Wayland clipboard persistence tool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"wl-clip-persist\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.wl-clip-persist.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wl-clip-persist.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wl-clip-persist.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra command-line arguments to pass to wl-clip-persist.\\n\\nAvailable options include:\\n- `--write-timeout <ms>`: Timeout for writing clipboard data (default: 3000).\\n- `--ignore-event-on-error`: Only handle events without errors.\\n- `--all-mime-type-regex <regex>`: Filter events by MIME type regex.\\n- `--selection-size-limit <bytes>`: Limit clipboard data size.\\n- `--reconnect-tries <n>`: Number of reconnection attempts.\\n- `--reconnect-delay <ms>`: Delay between reconnect attempts (default: 100).\\n- `--disable-timestamps`: Disable log timestamps.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--write-timeout\\\"\\n  \\\"1000\\\"\\n  \\\"--ignore-event-on-error\\\"\\n  \\\"--all-mime-type-regex\\\"\\n  \\\"'(?i)^(?!image/).+'\\\"\\n  \\\"--selection-size-limit\\\"\\n  \\\"1048576\\\"\\n]\"},\"loc\":[\"services\",\"wl-clip-persist\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.wl-clip-persist.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wl-clip-persist.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wl-clip-persist.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wl-clip-persist\"},\"description\":\"The wl-clip-persist package to use.\",\"loc\":[\"services\",\"wl-clip-persist\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.wl-clip-persist.systemdTarget