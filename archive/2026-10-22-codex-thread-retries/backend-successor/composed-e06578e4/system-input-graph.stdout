ression\",\"text\":\"false\"},\"description\":\"Whether to enable PulseAudio system tray.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"pasystray\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.pasystray.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pasystray.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pasystray.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra command-line arguments to pass to {command}`pasystray`.\\n\",\"loc\":[\"services\",\"pasystray\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.pasystray.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pasystray.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pasystray.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.pasystray\"},\"description\":\"The pasystray package to use.\",\"loc\":[\"services\",\"pasystray\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.pbgopy.cache.ttl\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pbgopy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pbgopy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"24h\\\"\"},\"description\":\"The TTL for the cache. Use `\\\"0s\\\"` to disable it.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"10m\\\"\"},\"loc\":[\"services\",\"pbgopy\",\"cache\",\"ttl\"],\"readOnly\":false,\"type\":\"string\"},\"services.pbgopy.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pbgopy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pbgopy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable pbgopy.\",