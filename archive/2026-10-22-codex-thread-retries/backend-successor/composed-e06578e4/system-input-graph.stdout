g-scripts-hook"],"outputChecks":{"doc":{},"info":{},"man":{},"out":{}},"outputs":["out","man","doc","info"],"patches":["/nix/store/p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff","/nix/store/yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch"],"pname":"gettext","postPatch":"# Older versions of gettext come with a copy of `extern-inline.m4` that is not compatible with clang 18.\n# When a project uses gettext + autoreconfPhase, autoreconfPhase will invoke `autopoint -f`, which will\n# replace whatever (probably compatible) version of `extern-inline.m4` with one that probalby won’t work\n# because `autopoint` will copy the autoconf macros from the project’s required version of gettext.\n# Fixing this requires replacing all the older copies of the problematic file with a new one.\n#\n# This is ugly, but it avoids requiring workarounds in every package using gettext and autoreconfPhase.\ndeclare -a oldFiles=($(tar tf gettext-tools/autotools/archive.dir.tar | grep '^gettext-0\\.[19].*/extern-inline.m4'))\noldFilesDir=$(mktemp -d)\nfor oldFile in \"${oldFiles[@]}\"; do\n  mkdir -p \"$oldFilesDir/$(dirname \"$oldFile\")\"\n  cp -a gettext-tools/gnulib-m4/extern-inline.m4 \"$oldFilesDir/$oldFile\"\ndone\ntar uf gettext-tools/autotools/archive.dir.tar --owner=0 --group=0 --numeric-owner -C \"$oldFilesDir\" \"${oldFiles[@]}\"\n\nsubstituteAllInPlace gettext-runtime/src/gettext.sh.in\nsubstituteInPlace gettext-tools/projects/KDE/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/projects/GNOME/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/src/project-id --replace \"/bin/pwd\" pwd\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"setupHooks":["/nix/store/v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash","/nix/store/ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh"],"src":"/nix/store/n4lwy41bnpq1fsqsrf5fac3m7vmhk6sr-gettext-1.0.tar.gz","stdenv":"/nix/store/ibyj3qs750igfnivfcl638clyrgmjmv3-bootstrap-stage1-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"1.0"},"system":"x86_64-linux","version":4},"pk56yihi6558wjw83vm5fcqhazvyclma-bluez-5.86.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"btinfo","__structuredAttrs":"","buildInputs":"/nix/store/7sywp36s22pmid5inwzksrzwh38j3vsk-alsa-lib-1.2.15.3-dev /nix/store/zyniprb6i1n5hyn1jjj3qjpw244mla8p-dbus-1.16.2-dev /nix/store/2n4fxvpxh7l72b30dzkq9v1rwnvjgx3x-ell-0.83-dev /nix/store/d0vv6yniq5vhdm7dg7nvnpbinrkcr36y-glib-2.88.3-dev /nix/store/7wxg1kj879avs5n5p9inb8df86m72h56-json-c-0.18-dev /nix/store/8dmkhgqidzwv8gks0k23gsnk9aw26syi-libical-3.0.20-dev /nix/store/jy00n3jp5xj8s40n1fbldmkcr5n7avxc-python3-3.13.15 /nix/store/2laizfqqmkh4zr65s6lxayk4528cgivy-readline-8.3p3-dev /nix/store/dskgq3arj036hpb7nmw0sp38a81kf1m4-systemd-minimal-libs-260.5-dev","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"--localstatedir=/var --disable-experimental --enable-btpclient --enable-cups --enable-external-ell --enable-health --enable-hid2hci --enable-library --enable-logger --enable-mesh --enable-midi --enable-nfc --enable-pie --enable-sixaxis --enable-systemd --enable-deprecated --with-dbusconfdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/share --with-dbussessionbusdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/share/dbus-1/services --with-dbussystembusdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/share/dbus-1/system-services --with-systemdsystemunitdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/etc/systemd/system --with-systemduserunitdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/etc/systemd/user --with-udevdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/udev","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/kb92lkd48gs2bzg8sjd2k5krsp77q4ir-bluez-5.86-dev","doCheck":"1","doInstallCheck":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","installFlags":"statedir=$(TMPDIR)/var/lib/bluetooth","makeFlags":"rulesdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/udev/rules.d","mesonFlags":"","name":"bluez-5.86","nativeBuildInputs":"/nix/store/xhvf9b98fc7v2xs6glqq3nmrhr6f0r3k-autoreconf-hook /nix/store/ivwzzymq13q5kvh2lbxzaiwfai7sf9wg-python3.13-docutils-0.22.4 /nix/store/viqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2 /nix/store/lq0jaw4axpjy96v5cqcn83fyks6w70mc-python3.13-pygments-2.20.0 /nix/store/4csc1mcirg39cm4g73pa3pl8wcd8bh3z-wrap-python-hook /nix/store/a431npxbmnrska6yw5gwhp6c7dbn3qxy-udev-check-hook","out":"/nix/store/26lciq5zcpmrmacyxxv6zlmm7wsprd1r-bluez-5.86","outputs":"out dev test","patches":"/nix/store/l2rdjracqz2rcgwqpkfrscdrsjn9ngr5-fix-btctl-noninteractive-regression /nix/store/s3phzi6ydljjm3vspj6vws9js9qdyn3n-fix-btctl-noninteractive-regression-2 /nix/store/8c4izxk0mda3mfw0002c7bc5c1p8f060-lreadline.patch","pname":"bluez","postInstall":"# for bluez4 compatibility for NixOS\nmkdir $out/sbin\nln -s ../libexec/bluetooth/bluetoothd $out/sbin/bluetoothd\nln -s ../libexec/bluetooth/obexd $out/sbin/obexd\n\n# Add extra configuration\nrm $out/etc/bluetooth/{main,input,network}.conf\nln -s /etc/bluetooth/main.conf $out/etc/bluetooth/main.conf\n\n# https://github.com/NixOS/nixpkgs/issues/204418\nln -s /etc/bluetooth/input.conf $out/etc/bluetooth/input.conf\nln -s /etc/bluetooth/network.conf $out/etc/bluetooth/network.conf\n\n# Add missing tools, ref https://git.archlinux.org/svntogit/packages.git/tree/trunk/PKGBUILD?h=packages/bluez\nfor files in $(find tools/ -type f -perm -755); do\n  filename=$(basename $files)\n  install -Dm755 tools/$filename $out/bin/$filename\ndone\ninstall -Dm755 attrib/gatttool $out/bin/gatttool\nmkdir -p $test/{bin,test}\ncp -a test $test\npushd $test/test\nfor t in \\\n        list-devices \\\n        monitor-bluetooth \\\n        simple-agent \\\n        test-adapter \\\n        test-device \\\n        ; do\n  ln -s ../test/$t $test/bin/bluez-$t\ndone\npopd\nwrapPythonProgramsIn $test/test \"$test/test /nix/store/0jrpvb3hkjr3hllyjaqzn3b8b6gsswsv-python3.13-dbus-python-1.4.0 /nix/store/f2cncqa42w5hcf89xmpwnbya60gqxnw5-python3.13-pygobject-3.56.3\"\n","postPatch":"substituteInPlace tools/hid2hci.rules \\\n  --replace-fail /sbin/udevadm /nix/store/srcx149smw6dsqj2ymsh2dxdx82nv9bj-systemd-minimal-libs-260.5/bin/udevadm \\\n  --replace-fail \"hid2hci \" \"$out/lib/udev/hid2hci \"\nskipTest() {\n  if [[ ! -f unit/$1.c ]]; then\n    echo \"unit/$1.c no longer exists\"\n    false\n  fi\n\n  echo 'int main() { return 77; }' > unit/$1.c\n}\n\nskipTest test-mesh-crypto\nskipTest test-vcp\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/1q1nfdd148wh3dkq93z7spjwic2rwc3r-bluez-5.86.tar.xz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","test":"/nix/store/14hf133pby2fqxgq2wi2lzh09xfsqlna-bluez-5.86-test","version":"5.86"},"inputs":{"drvs":{"1prdcfnwh9y8a2h89fzzdpqs1a8k5rrv-python3.13-dbus-python-1.4.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"63zjnxw73yn1avnz9vcsb4hjlsvd0gls-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6nvqr8wjg8kd0gw3a8yk3qcdaky170va-dbus-1.16.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"9lq2q0srznpg1cfp8q9ackdaa66q2vyz-systemd-minimal-libs-260.5.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"aqr67sc4fcqwgyqnwjlamd17bd5w3zcd-python3.13-pygments-2.20.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"b19j8qm8pdhbrk33f3ximwyzyyddjfvq-fix-btctl-noninteractive-regression-2.drv":{"dynamicOutputs":{},"outputs":["out"]},