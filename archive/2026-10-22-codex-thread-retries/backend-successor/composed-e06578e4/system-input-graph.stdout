\"0.3.1932\\\";\\n  }\\n]\"},\"loc\":[\"programs\",\"lapce\",\"plugins\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.lapce.plugins.*.author\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lapce.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lapce.nix\"}],\"description\":\"Author of the plugin.\\n\",\"loc\":[\"programs\",\"lapce\",\"plugins\",\"*\",\"author\"],\"readOnly\":false,\"type\":\"string\"},\"programs.lapce.plugins.*.hash\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lapce.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lapce.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Hash of the plugin tarball.\\nTo find the hash leave this empty, rebuild and copy the hash from the error message.\\n\",\"loc\":[\"programs\",\"lapce\",\"plugins\",\"*\",\"hash\"],\"readOnly\":false,\"type\":\"string\"},\"programs.lapce.plugins.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lapce.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lapce.nix\"}],\"description\":\"Name of the plugin.\\n\",\"loc\":[\"programs\",\"lapce\",\"plugins\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"programs.lapce.plugins.*.version\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lapce.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lapce.nix\"}],\"description\":\"Version of the plugin.\\n\",\"loc\":[\"programs\",\"lapce\",\"plugins\",\"*\",\"version\"],\"readOnly\":false,\"type\":\"string\"},\"programs.lapce.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lapce.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lapce.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/lapce/settings.toml`.\\nSee <https://github.com/lapce/lapce/blob/master/extra/schemas/settings.json> for schema.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  core = {\\n    custom-titlebar = false;\\n    color-theme = \\\"Custom\\\";\\n    icon-theme = \\\"Material Icons\\\";\\n  };\\n  editor = {\\n    font-family = \\\"FiraCode Nerd Bold Font, monospace\\\";\\n    font-size = 22;\\n    tab-width = 2;\\n    cursor-surrounding-lines = 4;\\n    render-whitespace = \\\"all\\\";\\n    bracket-pair-colorization = true;\\n    highlight-matching-brackets = true;\\n  };\\n  ui = {\\n    font-size = 20;\\n    open-editors-visible = false;\\n  };\\n  lapce-nix.lsp-path = \\\"$\\\\{pkgs.nil\\\\}/bin/nil\\\";\\n}\\n\"},\"loc\":[\"programs\",\"lapce\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.lazydocker.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lazydocker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lazydocker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable lazydocker, a simple terminal UI for both docker and docker compose.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"lazydocker\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.lazydocker.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lazydocker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lazydocker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.lazydocker\"},\"description\":\"The lazydocker package to use.\",\"loc\":[\"programs\",\"lazydocker\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.lazydocker.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lazydocker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lazydocker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  commandTemplates = {\\n    dockerCompose = \\\"docker compose\\\";\\n  };\\n}\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/lazydocker/config.yml`\\non Linux or on Darwin if [](#opt-xdg.enable) is set, otherwise\\n{file}`~/Library/Application Support/jesseduffield/lazydocker/config.yml`.\\nSee\\n<https://github.com/jesseduffield/lazydocker/blob/master/docs/Config.md>\\nfor supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  commandTemplates = {\\n    dockerCompose = \\\"docker compose compose -f docker-compose.yml\\\";\\n  };\\n  gui = {\\n    theme = {\\n      activeBorderColor = [\\n        \\\"red\\\"\\n        \\\"bold\\\"\\n      ];\\n      inactiveBorderColor = [\\n        \\\"blue\\\"\\n      ];\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"lazydocker\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.lazygit.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lazygit.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lazygit.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable lazygit, a simple terminal UI for git commands.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"lazygit\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.lazygit.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lazygit.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lazygit.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"li