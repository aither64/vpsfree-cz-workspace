tion":"","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"link","nativeBuildInputs":"","out":"/nix/store/jl4dfwfyb0ycqbkb1pgadz87c0npw278-link","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash\nexport TEXTDOMAIN=hm-modules\nexport TEXTDOMAINDIR=/nix/store/ybpfygv4wnx4p0wdmsq7y15xyr2k3m8d-hm-modules-messages\nsource /nix/store/zhrjg6wxrxmdlpn6iapzpp2z2vylpvw5-home-manager.sh\n\n\nnewGenFiles=\"$1\"\nshift\nfor sourcePath in \"$@\" ; do\n  relativePath=\"${sourcePath#$newGenFiles/}\"\n  targetPath=\"$HOME/$relativePath\"\n  if [[ -e \"$targetPath\" && ! -L \"$targetPath\" ]] ; then\n    if [[ -n \"$HOME_MANAGER_BACKUP_COMMAND\" ]] ; then\n      verboseEcho \"Running $HOME_MANAGER_BACKUP_COMMAND $targetPath.\"\n      run $HOME_MANAGER_BACKUP_COMMAND \"$targetPath\" || errorEcho \"Running `$HOME_MANAGER_BACKUP_COMMAND` on '$targetPath' failed.\"\n    elif [[ -n \"$HOME_MANAGER_BACKUP_EXT\" ]] ; then\n      # The target exists, back it up\n      backup=\"$targetPath.$HOME_MANAGER_BACKUP_EXT\"\n      if [[ -e \"$backup\" && -n \"$HOME_MANAGER_BACKUP_OVERWRITE\" ]]; then\n        run rm $VERBOSE_ARG \"$backup\"\n      fi\n      run mv $VERBOSE_ARG \"$targetPath\" \"$backup\" || errorEcho \"Moving '$targetPath' failed!\"\n    fi\n  fi\n\n  if [[ -e \"$targetPath\" && ! -L \"$targetPath\" ]] && cmp -s \"$sourcePath\" \"$targetPath\" ; then\n    # The target exists but is identical – don't do anything.\n    verboseEcho \"Skipping '$targetPath' as it is identical to '$sourcePath'\"\n  else\n    # Place that symlink, --force\n    # This can still fail if the target is a directory, in which case we bail out.\n    run mkdir -p $VERBOSE_ARG \"$(dirname \"$targetPath\")\"\n    run ln -Tsf $VERBOSE_ARG \"$sourcePath\" \"$targetPath\" || exit 1\n  fi\ndone\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"92r52csb7ijaagxs5kvbg69vqw3kl797-hm-modules-messages.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","zhrjg6wxrxmdlpn6iapzpp2z2vylpvw5-home-manager.sh"]},"name":"link","outputs":{"out":{"path":"jl4dfwfyb0ycqbkb1pgadz87c0npw278-link"}},"system":"x86_64-linux","version":4},"rdcja8bfhhk8m27f55b8wza444q4b3w0-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/z28sik0qwa47dg0r36gsc904rqzs4al5-source"},"inputs":{"drvs":{"3fc7klhja3mn322hjxl4bax4mk3m6h8l-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"45gypg5najzfbnll35p3v7sghx6zvspc-glibc-locales-2.42-100.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"nccfw1s0py9wvalrf7s92cfmg7bijj0i-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"znn1bl9j5d4ww3agv88mvyncs8c3bp73-unzip-6.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"source","outputs":{"out":{"hash":"sha256-NSq1tUfy2thz5gtsyASsKeYE4vMf71aSG4uXfrX86rk=","method":"nar"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":[],"curlOpts":"","curlOptsList":[],"depsBuildBuild