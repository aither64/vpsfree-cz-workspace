sys.c\nCC -c util.c\nCC -c version.c\nCC -c xmalloc.c\nCC -c error.c\n\n# Link\nCC -o patch addext.o argmatch.o backupfile.o basename.o dirname.o getopt.o getopt1.o inp.o maketime.o partime.o patch.o pch.o quote.o quotearg.o quotesys.o util.o version.o xmalloc.o error.o\n\n# Check\n./patch --version\n\n# Install\nmkdir -p ${out}/bin\ncp ./patch ${out}/bin\nchmod 555 ${out}/bin/patch\n"},"inputs":{"drvs":{"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"m2khnp0iw665w7zjkyvil62v5wjlbl8i-patch-2.5.9.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"gnupatch-2.5.9-builder","outputs":{"out":{"path":"jmxskfr3aj6ih0k90lwmxj9z2jjrzh90-gnupatch-2.5.9-builder"}},"system":"x86_64-linux","version":4},"la1hkqn1ykhd6cvjikawsacnb9ykn4jd-fix-cve-2026-58471.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/i6b2fannnz4r1yb0fi1x8blbi9mr88bi-fix-cve-2026-58471"},"inputs":{"drvs":{"3fc7klhja3mn322hjxl4bax4mk3m6h8l-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"asxqrkwwpzvlzlyv38c251wz39m1a46j-patchutils-0.3.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"nccfw1s0py9wvalrf7s92cfmg7bijj0i-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"fix-cve-2026-58471","