h\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Assume you are on workspace \\\"1: www\\\" and switch to \\\"2: IM\\\" using\\nmod+2 because somebody sent you a message. You don’t need to remember\\nwhere you came from now, you can just press $mod+2 again to switch\\nback to \\\"1: www\\\".\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"workspaceAutoBackAndForth\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.sway.config.workspaceLayout\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"default\\\"\"},\"description\":\"The mode in which new containers on workspace level will\\nstart.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"tabbed\\\"\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"workspaceLayout\"],\"readOnly\":false,\"type\":\"one of \\\"default\\\", \\\"stacking\\\", \\\"tabbed\\\"\"},\"wayland.windowManager.sway.config.workspaceOutputAssign\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Assign workspaces to outputs.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"workspaceOutputAssign\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"wayland.wind