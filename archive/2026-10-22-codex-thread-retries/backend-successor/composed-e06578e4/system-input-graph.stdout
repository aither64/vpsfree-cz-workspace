7xzf4jr5g2g-gzip-1.2.4/bin:/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin:/nix/store/wb7pvclab1aaa7myi0jafbjc60d5yij5-bootstrap-coreutils-5.0/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","SHELL":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","buildCommand":"# Unpack\ntar xzf /nix/store/1j3vmqzmlbx2j10q0j061fqychxd7q4i-musl-1.2.6.tar.gz\ncd musl-1.2.6\n\n# Patch\npatch -Np0 -i /nix/store/gg3z1dg2p54gc1zxj0m5a40kzgb0biqm-sigsetjmp.patch\n# tcc does not support complex types\nrm -rf src/complex\n# Configure fails without this\nmkdir -p /dev\n# https://github.com/ZilchOS/bootstrap-from-tcc/blob/2e0c68c36b3437386f786d619bc9a16177f2e149/using-nix/2a3-intermediate-musl.nix\nsed -i 's|/bin/sh|/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash|' \\\n  tools/*.sh\nchmod 755 tools/*.sh\n# patch popen/system to search in PATH instead of hardcoding /bin/sh\nsed -i 's|posix_spawn(&pid, \"/bin/sh\",|posix_spawnp(\\&pid, \"sh\",|' \\\n  src/stdio/popen.c src/process/system.c\nsed -i 's|execl(\"/bin/sh\", \"sh\", \"-c\",|execlp(\"sh\", \"-c\",|'\\\n  src/misc/wordexp.c\n\n# @PLT specifier is not supported by tinycc.\n# Calls do go through PLT regardless.\nsed -i 's|@PLT||' src/math/x86_64/expl.s\nsed -i 's|@PLT||' src/signal/x86_64/sigsetjmp.s\n\n# TODO Implement the required asm constraints 'x' and 't' in tinycc.\n# For now, we just remove code using those constraints. musl automatically\n# polyfills with pure C implementations.\nrm src/math/i386/*.c\nrm src/math/x86_64/*.c\n\n# Configure\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --disable-shared \\\n  CC=tcc\n\n# Build\n# NOTE: parallel build (-j) under tcc here is unstable and broke a previous run.\nmake AR=\"tcc -ar\" RANLIB=true CFLAGS=\"-DSYSCALL_NO_TLS\"\n\n# Install\nmake install\ncp /nix/store/rayh0cq2ik1xyw2hclrkdn7c67lppg2r-tinycc-mes-libs-unstable-2025-12-03/lib/libtcc1.a $out/lib\n","builder":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","name":"musl-1.2.6","out":"/nix/store/n68vha7bj7ki3yr4nqv4bn324vzgw5ai-musl-1.2.6","passAsFile":"buildCommand","pname":"musl","system":"x86_64-linux","version":"1.2.6"},"inputs":{"drvs":{"1vgxf29abq71i0mh3m5839my4664jfmh-tinycc-mes-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"54jdq8vp944qn49b18harrbjw34dlxcp-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"59pgig863abfc3p6lmz20vh8gjf2nsv1-musl-1.2.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"9ms5jx08n6hdg7ji8fxln4lsfbzd92fa-gnused-mes-4.0.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"b0faqgmz5282qmis5v2m13b7bsc0y9jg-gnumake-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"bv4a5fw05q4ysq24wy0z06bd5jysq1p2-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"d9hngw468h7b7fpcyx284kqwdgcn3gzy-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"pshx4r5vypzz5cjy5ikscgjyzhv2s99x-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a9pds57ms69gfi2ya-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zc4i6kv4525v20s2zh7fhxj1gcbcgggq-sigsetjmp.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"zmvpmmh7i1qba20c97v4cl6yi7zqpv3a-gnupatch-2.5.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh"]},"name":"musl-1.2.6","outputs":{"out":{"path":"n68vha7bj7ki3yr4nqv4bn324vzgw5ai-musl-1.2.6"}},"system":"x86_64-linux","version":4},"yj22i0m5xwf00wsyiyp13sz35qimixyv-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env