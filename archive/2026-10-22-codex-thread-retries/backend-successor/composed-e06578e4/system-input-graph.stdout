\\\"text\\\";\\n  auto = \\\"true\\\";\\n  batch = \\\"true\\\";\\n  log = \\\"false\\\"; # don't log to file, handled by systemd\\n}\\n\"},\"description\":\"Additional command line options as a dictionary to pass to the\\n`unison` program.\\n\\nUse a list of strings to declare the same option multiple times.\\n\\nSee\\n{manpage}`unison(1)`\\nfor a list of available options.\\n\",\"loc\":[\"services\",\"unison\",\"pairs\",\"<name>\",\"commandOptions\"],\"readOnly\":false,\"type\":\"attribute set of (string or list of string)\"},\"services.unison.pairs.<name>.roots\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/unison.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/unison.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Pair of roots to synchronise.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"/home/user/documents\\\"\\n  \\\"ssh://remote/documents\\\"\\n]\\n\"},\"loc\":[\"services\",\"unison\",\"pairs\",\"<name>\",\"roots\"],\"readOnly\":false,\"type\":\"list of string of length 2\"},\"services.unison.pairs.<name>.stateDirectory\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/unison.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/unison.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$XDG_DATA_HOME/unison\\\"\"},\"description\":\"Unison state directory to use.\\n\",\"loc\":[\"services\",\"unison\",\"pairs\",\"<name>\",\"stateDirectory\"],\"readOnly\":false,\"type\":\"absolute path\"},\"services.vdirsyncer.configFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/vdirsyncer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/vdirsyncer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Optional configuration file to link to use instead of\\nthe defa