ut\"\n\n\nchmod 755 \"$out\"\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"recursiveHash":true,"repo":"lapack","rev":"v3.12.1","revCustom":"v3.12.1","showURLs":false,"stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":false,"stripRoot":true,"system":"x86_64-linux","urls":["https://github.com/Reference-LAPACK/lapack/archive/v3.12.1.tar.gz"]},"system":"x86_64-linux","version":4},"j8h4yaxy45xq0qb38rspn5qhilhicfg4-udev-rules.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"mkdir -p $out\nshopt -s nullglob\nset +o pipefail\n\n# Set a reasonable $PATH for programs called by udev rules.\necho 'ENV{PATH}=\"/nix/store/rj7bqzd410k53j5fzvvwg23ihisqg52a-udev-path/bin:/nix/store/rj7bqzd410k53j5fzvvwg23ihisqg52a-udev-path/sbin\"' > $out/00-path.rules\n\n# Add the udev rules from other packages.\nfor i in $packages; do\n  echo \"Adding rules for package $i\"\n  for j in $i/{etc,lib}/udev/rules.d/*; do\n    echo \"Copying $j to $out/$(basename $j)\"\n    cat $j > $out/$(basename $j)\n  done\ndone\n\n# Fix some paths in the standard udev rules.  Hacky.\nfor i in $out/*.rules; do\n  substituteInPlace $i \\\n    --replace-quiet \\\"/sbin/modprobe \\\"/nix/store/7hb639qc0cgc215kr10pgg6r3z0xrfk2-kmod-31/bin/modprobe \\\n    --replace-quiet \\\"/sbin/mdadm \\\"/nix/store/85cs99zpcz7xvpdbh3wdv4a2lgxdsydc-mdadm-4.4/sbin/mdadm \\\n    --replace-quiet \\\"/sbin/blkid \\\"/nix/store/0bmapmnznzaxgx76jhzbznhlwq738g03-util-linux-2.42.3-bin/sbin/blkid \\\n    --replace-quiet \\\"/bin/mount \\\"/nix/store/0bmapmnznzaxgx76jhzbznhlwq738g03-util-linux-2.42.3-bin/bin/mount \\\n    --replace-quiet /usr/bin/readlink /nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/readlink \\\n    --replace-quiet /usr/bin/cat /nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/cat \\\n    --replace-quiet /usr/bin/basename /nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/basename 2>/dev/null\n\ndone\n\necho -n \"Checking that all programs called by relative paths in udev rules exist in /nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/lib/udev... \"\nimport_progs=$(grep 'IMPORT{program}=\"[^/$]' $out/* |\n  sed -e 's/.*IMPORT{program}=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nrun_progs=$(grep -v '^[[:space:]]*#' $out/* | grep 'RUN+=\"[^/$]' |\n  sed -e 's/.*RUN+=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nfor i in $import_progs $run_progs; do\n  if [[ ! -x /nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/lib/udev/$i && ! $i =~ socket:.* ]]; then\n    echo \"FAIL\"\n    echo \"$i is called in udev rules but not installed by udev\"\n    exit 1\n  fi\ndone\necho \"OK\"\n\necho -n \"Checking that all programs called by absolute paths in udev rules exist... \"\nimport_progs=$(grep 'IMPORT{program}=\"/' $out/* |\n  sed -e 's/.*IMPORT{program}=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nrun_progs=$(grep -v '^[[:space:]]*#' $out/* | grep 'RUN+=\"/' |\n  sed -e 's/.*RUN+=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nfor i in $import_progs $run_progs; do\n  # if the path refers to /run/current-system/systemd, replace with config.systemd.package\n  if [[ $i == /run/current-system/systemd* ]]; then\n    i=\"/nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/${i#/run/current-system/systemd/}\"\n  fi\n\n  if [[ ! -x $i ]]; then\n    echo \"FAIL\"\n    echo \"$i is called in udev rules but is not executable or does not exist\"\n    exit 1\n  fi\ndone\necho \"OK\"\n\nfilesToFixup=\"$(for i in \"$out\"/*; do\n  # list all files referring to (/usr)/bin paths, but allow references to /bin/sh.\n  grep -P -l '\\B(?!\\/bin\\/sh\\b)(\\/usr)?\\/bin(?:\\/.*)?' \"$i\" || :\ndone)\"\n\nif [ -n \"$filesToFixup\" ]; then\n  echo \"Consider fixing the following udev rules:\"\n  echo \"$filesToFixup\" | while read localFile; do\n    remoteFile=\"origin unknown\"\n    for i in /nix/store/xs1hgcqfb81bl8vd1jnkkxbfslsj5bs8-ipv6-privacy-extensions.rules /nix/store/q3i1ah7ws2bqdl9svpnyrd2xz66h43c2-ipv6-privacy-extensions.rules /nix/store/mvkx9892k6jj608im4kijqfcwq99s923-lvm2-2.03.39 /nix/store/rmzizfxnlvqvdhj9w1r0v1kx7hkflvx3-bcache-tools-1.1 /nix/store/5104p6gbfsimmsfxchkrk0dfdb7f6q0p-extra-udev-rules /nix/store/40gqr8an8lg1jjnm01hvblywz5mfm69q-extra-hwdb-file; do\n      for j in \"$i\"/*/udev/rules.d/*; do\n        [ -e \"$out/$(basename \"$j\")\" ] || continue\n        [ \"$(basename \"$j\")\" = \"$(basename \"$localFile\")\" ] || continue\n        remoteFile=\"originally from $j\"\n        break 2\n      done\n    done\n    refs=\"$(\n      grep -o '\\B\\(/usr\\)\\?/s\\?bin/[^ \"]\\+' \"$localFile\" \\\n        | sed -e ':r;N;${s/\\n/ and /;br};s/\\n/, /g;br'\n    )\"\n    echo \"$localFile ($remoteFile) contains references to $refs.\"\n  done\n  exit 1\nfi\n\n# Verify all the udev rules\necho \"Verifying udev rules using udevadm verify...\"\nudevadm verify --resolve-names=late --no-style $out\necho \"OK\"\n\n# If auto-configuration is disabled, then remove\n# udev's 80-drivers.rules file, which contains rules for\n# automatically calling modprobe.\n\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"udev-rules","nativeBuildInputs":"/nix/store/hkk2bbr51cdjc5w01x34h1pjzxwaxlvd-systemd-minimal-260.5","out":"/nix/store/pajk68xd5rwlzv8m2xs73lgfljh2s6f8-udev-rules","outputs":"out","pac