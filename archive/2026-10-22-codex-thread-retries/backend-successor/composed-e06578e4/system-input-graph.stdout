s.\\n\\nNote, {var}`icon` is also a special option added by Home\\nManager to make it convenient to specify absolute icon paths.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  nix-packages = {\\n    name = \\\"Nix Packages\\\";\\n    urls = [{\\n      template = \\\"https://search.nixos.org/packages\\\";\\n      params = [\\n        { name = \\\"type\\\"; value = \\\"packages\\\"; }\\n        { name = \\\"query\\\"; value = \\\"{searchTerms}\\\"; }\\n      ];\\n    }];\\n\\n    icon = \\\"${pkgs.nixos-icons}/share/icons/hicolor/scalable/apps/nix-snowflake.svg\\\";\\n    definedAliases = [ \\\"@np\\\" ];\\n  };\\n\\n  nixos-wiki = {\\n    name = \\\"NixOS Wiki\\\";\\n    urls = [{ template = \\\"https://wiki.nixos.org/w/index.php?search={searchTerms}\\\"; }];\\n    iconMapObj.\\\"16\\\" = \\\"https://wiki.nixos.org/favicon.ico\\\";\\n    definedAliases = [ \\\"@nw\\\" ];\\n  };\\n\\n  bing.metaData.hidden = true;\\n  google.metaData.alias = \\\"@g\\\"; # builtin engines only support specifying one additional alias\\n}\\n\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"search\",\"engines\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (JSON value)\"},\"programs.librewolf.profiles.<name>.search.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force replace the existing search\\nconfiguration. This is recommended since LibreWolf will\\nreplace the symlink for the search configuration on every\\nlaunch, but note that you'll lose any existing configuration\\nby enabling this.\\n\",\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"search\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.librewolf.profiles.<name>.search.meta.maintainers\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of maintainers of each module.\\nThis option should be defined at most once per module.\\n\\nThe option value is not a list of maintainers, but an attribute set that maps module file names to lists of maintainers.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.maintainers.alice lib.maintainers.bob ]\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"search\",\"meta\",\"maintainers\"],\"readOnly\":false,\"type\":\"list of lib.maintainers\"},\"programs.librewolf.profiles.<name>.search.meta.teams\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of team maintainers of each module.\\nThis option should be defined at most once per module.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.teams.acme lib.teams.haskell ]\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"search\",\"meta\",\"teams\"],\"readOnly\":false,\"type\":\"list of lib.teams\"},\"programs.librewolf.profiles.<name>.search.order\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/librewolf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/librewolf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The order the search engines are listed in. Any engines that\\naren't included in this list will be listed after these in an\\nunspecified order.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"ddg\\\"\\n  \\\"google\\\"\\n]\"},\"loc\":[\"programs\",\"librewolf\",\"profiles\",\"<name>\",\"search\",\"order\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.librewolf.profiles.<name>.search.pr