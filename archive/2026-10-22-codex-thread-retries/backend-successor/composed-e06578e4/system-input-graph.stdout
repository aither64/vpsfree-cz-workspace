larations\":[{\"name\":\"<home-manager/modules/programs/mcfly.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mcfly.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"description\":\"Whether to enable fuzzy searching.\\n0 is off; higher numbers weight toward shorter matches.\\nValues in the 2-5 range get good results so far.\\n\",\"loc\":[\"programs\",\"mcfly\",\"fuzzySearchFactor\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"programs.mcfly.fzf.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mcfly.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mcfly.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable McFly fzf integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"mcfly\",\"fzf\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.mcfly.interfaceView\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mcfly.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mcfly.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"TOP\\\"\"},\"description\":\"Interface view to use.\\n\",\"loc\":[\"programs\",\"mcfly\",\"interfaceView\"],\"readOnly\":false,\"type\":\"one of \\\"TOP\\\", \\\"BOTTOM\\\"\"},\"programs.mcfly.keyScheme\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mcfly.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mcfly.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"emacs\\\"\"},\"description\":\"Key scheme to use.\\n\",\"loc\":[\"programs\",\"mcfly\",\"keyScheme\"],\"readOnly\":false,\"type\":\"one of \\\"emacs\\\", \\\"vim\\\"\"},\"programs.mcfly.mcflyFzfPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mcfly.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mcfly.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.mcfly-fzf\"},\"description\":\"The mcfly-fzf package to use.\",\"loc\":[\"programs\",\"mcfly\",\"mcflyFzfPackage\"],\"readOnly\":false,\"type\":\"package\"},\"programs.mcfly.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mcfly.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mcfly.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.mcfly\"},\"description\":\"The mcfly package to use.\",\"loc\":[\"programs\",\"mcfly\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.mcfly.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mcfly.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mcfly.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings written to {file}`~/.config/mcfly/config.toml`.\\n\\nNote, if your McFly database is currently in {file}`~/.mcfly`,\\nthen this option has no effect.\\nMove the database to {file}`$XDG_DATA_DIR/mcfly/history.db` and\\nremove {file}`~/.mcfly` to make the settings take effect. See\\n<https://github.com/cantino/mcfly#database-location>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  colors = {\\n    darkmode = {\\n      prompt = \\\"cyan\\\";\\n      results_selection_bg = \\\"black\\\";\\n      results_selection_fg = \\\"cyan\\\";\\n      results_selection_hl = \\\"red\\\";\\n      timing = \\\"yellow\\\";\\n    };\\n    menubar = {\\n      bg = \\\"black\\\";\\n      fg = \\\"red\\\";\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"mcfly\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.mcp.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mcp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mcp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable mcp.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"mcp\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.mcp.servers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mcp.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mcp.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"MCP server configurations written to\\n{file}`XDG_CONFIG_HOME/mcp/mcp.json`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  everything = {\\n    command = \\\"npx\\\";\\n    args = [\\n      \\\"-y\\\"\\n      \\\"@modelcontextprotocol/server-everything\\\"\\n    ];\\n  };\\n  context7 = {\\n    url = \\\"https://mcp.context7.com/mcp\\\";\\n    headers = {\\n      CONTEXT7_API_KEY = \\\"{env:CONTEXT7_API_KEY}\\\";\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"mcp\",\"servers\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.meli.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/meli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/meli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable meli email client.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"meli\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.meli.includes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/meli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/meli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Paths of the various meli configuration files to include.\",\"loc\":[\"programs\",\"meli\",\"includes\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.meli.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/meli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/meli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.meli\"},\"description\":\"The meli package to use.\",\"loc\":[\"programs\",\"meli\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.meli.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/meli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/meli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Meli Configuration\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\nshortcuts = {\\ncontact-list = {\\n            create_contact = \\\"c\\\";\\n            edit_contact = \\\"m\\\";\\n          };\\ngeneral = {\\n  edit = \\\"m\\\";\\n  scroll_up = \\\"e\\\";\\n  scroll_down = \\\"n\\\";\\n};\\ncomposing = {\\n  edit = \\\"m\\\";\\n  scroll_up = \\\"e\\\";\\n  scroll_down = \\\"n\\\";\\n};\\nlisting = {\\n  new_mail = \\\"t\\\";\\n  set_seen = \\\"s\\\";\\n};\\npager = {\\n            scroll_up = \\\"e\\\";\\n            scroll_down = \\\"n\\\";\\n};\\n\\n}\\n}\"},\"loc\":[\"programs\",\"meli\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"programs.mercurial.aliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mercurial.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mercurial.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Mercurial aliases to define.\",\"loc\":[\"programs\",\"mercurial\",\"aliases\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.mercurial.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mercuri