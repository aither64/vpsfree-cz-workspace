adecimal\\\", \\\"indexed\\\", \\\"base\\\"\"},\"programs.macchina.themes.<name>.randomize.separator_color\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to randomize the separator color.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"randomize\",\"separator_color\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.themes.<name>.separator\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Glyph to use as the separator.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"separator\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.macchina.themes.<name>.separator_color\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Color of the separator. Omitted when null.\\nAccepts hex (\\\"#00FF00\\\"), indexed (\\\"046\\\"), or named colors (e.g. \\\"White\\\").\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"White\\\"\"},\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"separator_color\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.macchina.themes.<name>.spacing\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Spacing between the separator and adjacent content.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"spacing\"],\"readOnly\":false,\"type\":\"null or (unsigned integer, meaning >=0)\"},\"programs.man.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/man>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/man\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable manual pages and the {command}`man`\\ncommand. This also includes \\\"man\\\" outputs of all\\n`home.packages`.\\n\",\"loc\":[\"programs\",\"man\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.man.generateCaches\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/man>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/man\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to generate the manual page index caches using\\n{manpage}`mandb(8)`. This allows searching for a page or\\nkeyword using utilities like {manpage}`apropos(1)`.\\n\\nThis feature is disabled by default because it slows down\\nbuilding. If you don't mind waiting a few more seconds when\\nHome Manager builds a new generation, you may safely enable\\nthis option.\\n\",\"loc\":[\"programs\",\"man\",\"generateCaches\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.man.man-db.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/man/man-db.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/man/man-db.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable man-db as the man page viewer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"man\",\"man-db\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.man.man-db.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/man/man-db.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/man/man-db.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Additional fields to be added to the end of the user manpath config file.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  MANDATORY_MANPATH /usr/man\\n  SECTION 1 n l 8 3 0 2 3type 5 4 9 6 7\\n''\"},\"loc\":[\"programs\",\"man\",\"man-db\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.man.mandoc.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/man/mandoc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/man/mandoc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable mandoc as the man page viewer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"man\",\"mandoc\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.man.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/man>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/man\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"if pkgs.stdenv.isDarwin && lib.versionAtLeast config.home.stateVersion \\\"26.05\\\" then\\n  null\\nelse if cfg.man-db.enable then\\n  pkgs.man\\nelse if cfg.mandoc.enable then\\n  pkgs.mandoc\\nelse\\n  null;\\n\"},\"description\":\"The {command}`man` package to use.\",\"loc\":[\"programs\",\"man\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.mangohud.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mangohud.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mangohud.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Mangohud.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"mangohud\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.mangohud.enableSessionWide\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mangohud.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mangohud.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Sets environment variables so that\\nMangoHud is started on any application that supports it.\\n\",\"loc\":[\"programs\",\"mangohud\",\"enableSessionWide\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.mangohud.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mangohud.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mangohud.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.mangohud\"},\"description\":\"The mangohud package to use.\",\"loc\":[\"programs\",\"mangohud\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.mangohud.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mangohud.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mangohud.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/MangoHud/MangoHud.conf`. See\\n<https://github.com/flightlessmango/MangoHud/blob/master/data/MangoHud.conf>\\nfor the default configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  output_folder = ~/Documents/mangohud/;\\n  full = true;\\n}\\n\"},\"loc\":[\"programs\",\"mangohud\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or floating point number or string or absolute path or list of (signed integer or string))\"},\"programs.mangohud.settingsPerApplication\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mangohud.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mangohud.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Sets MangoHud settings per application.\\nConfiguration written to\\n{file}`$XDG_CONFIG_HOME/MangoHud/{application_name}.conf`. See\\n<https://github.com/flightlessmango/MangoHud/blob/master/data/MangoHud.conf>\\nfor the default configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  mpv = {\\n    no_display = true;\\n  };\\n}\"},\"loc\":[\"programs\",\"mangohud\",\"settingsPerApplication\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (boolean or signed integer or floating point number or string or absolute path or list of (signed integer or string))\"},\"programs.matplotlib.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/matplotlib.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/matplotlib.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Add terms to the {file}`matplotlibrc` file to\\ncontrol the default matplotlib behavior.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  axes = {\\n    edgecolor = \\\"FF9900\\\";\\n    facecolor = \\\"black\\\";\\n    grid = true;\\n  };\\n  backend = \\\"Qt5Agg\\\";\\n  grid = {\\n    color = \\\"FF9900\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"matplotlib\",\"config\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.matplotlib.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/matplotlib.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/matplotlib.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable matplotlib, a plotting library for python.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"matplotlib\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.matplotlib.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/matplotlib.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/matplotlib.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Additional commands for matplotlib that will be added to the\\n{file}`matplotlibrc` file.\\n\",\"loc\":[\"programs\",\"matplotlib\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.mbsync.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable mbsync IMAP4 and Maildir mailbox synchronizer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"mbsync\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.mbsync.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines to add to the mbsync configuration.\\n\",\"loc\":[\"programs\",\"mbsync\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.mbsync.groups\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Definition of groups.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  inboxes = {\\n    account1 = [\\n      \\\"Inbox\\\"\\n    ];\\n    account2 = [\\n      \\\"Inbox\\\"\\n    ];\\n  };\\n}\"},\"loc\":[\"programs\",\"mbsync\",\"groups\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of list of string\"},\"programs.mbsync.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mbsync>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mbsync\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.isync\"},\"description\":\"The isync package to use.\",\"loc\":[\"programs\",\"mbsync\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.mc.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Midnight Commander.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"mc\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.mc.extensionSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings for `mc/mc.ext.ini` file. This setting completely replaces the default `/etc/mc/mc.ext.ini`.\\n\\nMidnight Commander does not merge this file with the system default,\\nso you should copy the original if you want to preserve default behavior and add your changes there.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  EPUB = {\\n    Open = \\\"fbreader %f &\\\";\\n    Shell = \\\".epub\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"mc\",\"extensionSettings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.mc.fileHighlightSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings for `mc/filehighlight.ini` file. This setting completely replaces the default `/etc/mc/filehighlight.ini`.\\n\\nMidnight Commander does not merge this file with the system default, so you should copy the original if you want to preserve default behavior\\nand add your changes there.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  lua = {\\n    extensions = \\\"lua;luac\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"mc\",\"fileHighlightSettings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.mc.keymapSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings for `mc/mc.keymap` file.\\n\\nAny missing settings will fall back to the system default.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  panel = {\\n    Up = \\\"up;ctrl-k\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"mc\",\"keymapSettings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.mc.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.mc\"},\"description\":\"The mc package to use.\",\"loc\":[\"programs\",\"mc\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.mc.panelsSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings for `mc/panels` file.\\n\\nAny missing settings will fall back to the system default.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  Dirs = {\\n    current_is_left = false;\\n    other_dir = \\\"/home\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"mc\",\"panelsSettings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.mc.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings for `mc/ini` file.\\n\\nAny missing settings will fall back to the system default.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  Panels = {\\n    show_dot_files = false;\\n  };\\n}\"},\"loc\":[\"programs\",\"mc\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.mcfly.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/mcfly.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/mcfly.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable mcfly.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"mcfly\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.mcfly.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manag