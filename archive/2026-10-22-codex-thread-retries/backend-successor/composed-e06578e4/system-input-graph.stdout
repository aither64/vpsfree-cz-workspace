"},\"services.swaync.style\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/swaync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/swaync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"CSS style of the bar. See\\n<https://github.com/ErikReider/SwayNotificationCenter?tab=readme-ov-file#configuring>\\nfor the documentation.\\n\\nIf the value is set to a path literal, then the path will be used as the CSS file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  .notification-row {\\n    outline: none;\\n  }\\n  \\n  .notification-row:focus,\\n  .notification-row:hover {\\n    background: @noti-bg-focus;\\n  }\\n  \\n  .notification {\\n    border-radius: 12px;\\n    margin: 6px 12px;\\n    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3), 0 1px 3px 1px rgba(0, 0, 0, 0.7),\\n      0 2px 6px 2px rgba(0, 0, 0, 0.3);\\n    padding: 0;\\n  }\\n''\"},\"loc\":[\"services\",\"swaync\",\"style\"],\"readOnly\":false,\"type\":\"null or absolute path or strings concatenated with \\\"\\\\n\\\"\"},\"services.swayosd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/swayosd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/swayosd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable swayosd, a GTK based on screen display for keyboard shortcuts like\\ncaps-lock and volume.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"swayosd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.swayosd.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/swayosd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/swayosd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.swayosd\"},\"description\":\"The swayosd package to use.\",\"loc\":[\"services\",\"swayosd\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.swayosd.stylePath\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/swayosd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/swayosd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Use a custom Stylesheet file instead of looking for one.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/etc/xdg/swayosd/style.css\\\"\"},\"loc\":[\"services\",\"swayosd\",\"stylePath\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"services.swayosd.topMargin\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/swayosd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/swayosd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"OSD margin from top edge (0.5 would be screen center).\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"1.0\"},\"loc\":[\"services\",\"swayosd\",\"topMargin\"],\"readOnly\":false,\"type\":\"null or float between 0.0 and 1.0 (inclusive)\"},\"services.sxhkd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/sxhkd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/sxhkd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable simple X hotkey daemon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"sxhkd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.sxhkd.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/sxhkd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/sxhkd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Additional configuration to add.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"super + {_,shift +} {1-9,0}\\n  i3-msg {workspace,move container to workspace} {1-10}\\n\"},\"loc\":[\"services\",\"sxhkd\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"services.sxhkd.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/sxhkd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/sxhkd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Command line arguments to invoke {command}`sxhkd` with.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"-m 1\\\"\\n]\"},\"loc\":[\"services\",\"sxhkd\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.sxhkd.keybindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/sxhkd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/sxhkd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set that assigns hotkeys to commands.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"super + shift + {r,c}\\\" = \\\"i3-msg {restart,reload}\\\";\\n  \\\"super + {s,w}\\\"         = \\\"i3-msg {stacking,tabbed}\\\";\\n  \\\"super + F1\\\"            = pkgs.writeShellScript \\\"script\\\" \\\"echo $USER\\\";\\n}\\n\"},\"loc\":[\"services\",\"sxhkd\",\"keybindings\"],\"readOnly\":false,\"type\":\"attribute set of (null or string or absolute path)\"},\"services.sxhkd.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/sxhkd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/sxhkd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sxhkd\"},\"description\":\"The sxhkd package to use. containing the sxhkd executable\",\"loc\":[\"services\",\"sxhkd\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.syncthing.allProxy\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Overwrites the {env}`all_proxy` environment variable for the Syncthing\\nprocess to the given value. This is normally used to let Syncthing\\nconnect through a SOCKS5 proxy server. See\\n<https://docs.syncthing.net/users/proxying.html>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"socks5://address.com:1234\\\"\"},\"loc\":[\"services\",\"syncthing\",\"allProxy\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.syncthing.cert\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the `cert.pem` file, which will be copied into Syncthing's\\nconfig directory.\\n\",\"loc\":[\"services\",\"syncthing\",\"cert\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.syncthing.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Syncthing, a self-hosted open-source alternative to Dropbox and Bittorrent Sync.\\n.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"syncthing\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.syncthing.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra command-line arguments to pass to {command}`syncthing`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--reset-deltas\\\"\\n]\"},\"loc\":[\"services\",\"syncthing\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.syncthing.guiAddress\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"127.0.0.1:8384\\\"\"},\"description\":\"The address to serve the web interface at.\\n\",\"loc\":[\"services\",\"syncthing\",\"guiAddress\"],\"readOnly\":false,\"type\":\"string\"},\"services.syncthing.guiCredentials\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Credentials to use for access to the Syncthing GUI.  Configuring\\nthese is recommended, as otherwise any user with access to the GUI\\nweb address -- which would typically include all local accounts on\\nyour system -- will effectively have read/write access to the\\nfilesystem with your permissions.\\n\",\"loc\":[\"services\",\"syncthing\",\"guiCredentials\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"services.syncthing.guiCredentials.passwordFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The full path to a file that contains the password, or a hash of\\nthe password, to set for GUI access.\\n\\nThe password file is read each time Syncthing is started.\\n\\nIf the password file contains a bcrypt hash, Syncthing will use\\nthat hash as-is.  Otherwise, Syncthing will hash the password\\nprovided before storing it.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"config.sops.secrets.syncthing.path\"},\"loc\":[\"services\",\"syncthing\",\"guiCredentials\",\"passwordFile\"],\"readOnly\":false,\"type\":\"string\"},\"services.syncthing.guiCredentials.username\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"description\":\"Username to use to log into the Syncthing GUI.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"config.home.username\"},\"loc\":[\"services\",\"syncthing\",\"guiCredentials\",\"username\"],\"readOnly\":false,\"type\":\"non-empty string\"},\"services.syncthing.key\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the `key.pem` file, which will be copied into Syncthing's\\nconfig directory.\\n\",\"loc\":[\"services\",\"syncthing\",\"key\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.syncthing.overrideDevices\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to delete the devices which are not configured via the\\n[devices](#opt-services.syncthing.settings.devices) option.\\nIf set to `false`, devices added via the web\\ninterface will persist and will have to be deleted manually.\\n\",\"loc\":[\"services\",\"syncthing\",\"overrideDevices\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.syncthing.overrideFolders\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to delete the folders which are not configured via the\\n[folders](#opt-services.syncthing.settings.folders) option.\\nIf set to `false`, folders added via the web\\ninterface will persist and will have to be deleted manually.\\n\",\"loc\":[\"services\",\"syncthing\",\"overrideFolders\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.syncthing.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.syncthing\"},\"description\":\"The syncthing package to use.\",\"loc\":[\"services\",\"syncthing\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.syncthing.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra configuration options for Syncthing.\\nSee <https://docs.syncthing.net/users/config.html>.\\nNote that this attribute set does not exactly match the documented\\nXML format. Instead, this is the format of the JSON REST API. There\\nare slight differences. For example, this XML:\\n```xml\\n<options>\\n  <listenAddress>default</listenAddress>\\n  <minHomeDiskFree unit=\\\"%\\\">1</minHomeDiskFree>\\n</options>\\n```\\ncorresponds to the Nix code:\\n```nix\\n{\\n  options = {\\n    listenAddresses = [\\n      \\\"default\\\"\\n    ];\\n    minHomeDiskFree = {\\n      unit = \\\"%\\\";\\n      value = 1;\\n    };\\n  };\\n}\\n```\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  gui = {\\n    theme = \\\"black\\\";\\n  };\\n  options = {\\n    localAnnounceEnabled = false;\\n  };\\n}\"},\"loc\":[\"services\",\"syncthing\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (JSON value)\"},\"services.syncthing.settings.devices\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Peers/devices which Syncthing should communicate with.\\n\\nNote that you can still add devices manually, but those changes\\nwill be reverted on restart if [overrideDevices](#opt-services.syncthing.overrideDevices)\\nis enabled.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  bigbox = {\\n    addresses = [\\n      \\\"tcp://192.168.0.10:51820\\\"\\n    ];\\n    id = \\\"7CFNTQM-IMTJBHJ-3UWRDIU-ZGQJFR6-VCXZ3NB-XUH3KZO-N52ITXR-LAIYUAU\\\";\\n  };\\n}\"},\"loc\":[\"services\",\"syncthing\",\"settings\",\"devices\"],\"readOnly\":false,\"type\":\"attribute set of (open submodule of (JSON value))\"},\"services.syncthing.settings.devices.<name>.autoAcceptFolders\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Automatically create or share folders that this device advertises at the default path.\\nSee <https://docs.syncthing.net/users/config.html?highlight=autoaccept#config-file-format>.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"devices\",\"<name>\",\"autoAcceptFolders\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.syncthing.settings.devices.<name>.id\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"description\":\"The device ID. See <https://docs.syncthing.net/dev/device-ids.html>.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"devices\",\"<name>\",\"id\"],\"readOnly\":false,\"type\":\"string\"},\"services.syncthing.settings.devices.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"The name of the device.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"devices\",\"<name>\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"services.syncthing.settings.folders\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Folders which should be shared by Syncthing.\\n\\nNote that you can still add folders manually, but those changes\\nwill be reverted on restart if [overrideFolders](#opt-services.syncthing.overrideFolders)\\nis enabled.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"/home/user/sync\\\" = {\\n    devices = [\\n      \\\"bigbox\\\"\\n    ];\\n    id = \\\"syncme\\\";\\n  };\\n}\"},\"loc\":[\"services\",\"syncthing\",\"settings\",\"folders\"],\"readOnly\":false,\"type\":\"attribute set of (open submodule of (JSON value))\"},\"services.syncthing.settings.folders.<name>.copyOwnershipFromParent\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"On Unix systems, tries to copy file/folder ownership from\\nthe parent directory (the directory it’s located in).\\nRequires running Syncthing as a privileged user, or\\ngranting it additional capabilities (e.g. CAP_CHOWN on\\nLinux).\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"folders\",\"<name>\",\"copyOwnershipFromParent\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.syncthing.settings.folders.<name>.devices\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The devices this folder should be shared with. Each device must\\nbe defined in the [devices](#opt-services.syncthing.settings.devices) option.\\n\\nA list of either strings or attribute sets, where values\\nare device names or device configurations.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"folders\",\"<name>\",\"devices\"],\"readOnly\":false,\"type\":\"list of (string or (open submodule of (JSON value)))\"},\"services.syncthing.settings.folders.<name>.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to share this folder.\\nThis option is useful when you want to define all folders\\nin one place, but not every machine should share all folders.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"folders\",\"<name>\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.syncthing.settings.folders.<name>.id\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"The ID of the folder. Must be the same on all devices.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"folders\",\"<name>\",\"id\"],\"readOnly\":false,\"type\":\"string\"},\"services.syncthing.settings.folders.<name>.label\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"The label of the folder.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"folders\",\"<name>\",\"label\"],\"readOnly\":false,\"type\":\"string\"},\"services.syncthing.settings.folders.<name>.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"The path to the folder which should be shared.\\nOnly absolute paths (starting with `/`) and paths relative to\\nthe user's home directory (starting with `~/`) are allowed.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"folders\",\"<name>\",\"path\"],\"readOnly\":false,\"type\":\"string starting with / or ~/\"},\"services.syncthing.settings.folders.<name>.type\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"sendreceive\\\"\"},\"description\":\"Controls how the folder is handled by Syncthing.\\nSee <https://docs.syncthing.net/users/config.html#config-option-folder.type>.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"folders\",\"<name>\",\"type\"],\"readOnly\":false,\"type\":\"one of \\\"sendreceive\\\", \\\"sendonly\\\", \\\"receiveonly\\\", \\\"receiveencrypted\\\"\"},\"services.syncthing.settings.folders.<name>.versioning\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"How to keep changed/deleted files with Syncthing.\\nThere are 4 different types of versioning with different parameters.\\nSee <https://docs.syncthing.net/users/versioning.html>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    versioning = {\\n      type = \\\"simple\\\";\\n      params.keep = \\\"10\\\";\\n    };\\n  }\\n  {\\n    versioning = {\\n      type = \\\"trashcan\\\";\\n      params.cleanoutDays = \\\"1000\\\";\\n    };\\n  }\\n  {\\n    versioning = {\\n      type = \\\"staggered\\\";\\n      fsPath = \\\"/syncthing/backup\\\";\\n      params = {\\n        cleanInterval = \\\"3600\\\";\\n        maxAge = \\\"31536000\\\";\\n      };\\n    };\\n  }\\n  {\\n    versioning = {\\n      type = \\\"external\\\";\\n      params.versionsPath = pkgs.writers.writeBash \\\"backup\\\" ''\\n        folderpath=\\\"$1\\\"\\n        filepath=\\\"$2\\\"\\n        rm -rf \\\"$folderpath/$filepath\\\"\\n      '';\\n    };\\n  }\\n]\\n\"},\"loc\":[\"services\",\"syncthing\",\"settings\",\"folders\",\"<name>\",\"versioning\"],\"readOnly\":false,\"type\":\"null or (open submodule of (JSON value))\"},\"services.syncthing.settings.folders.<name>.versioning.type\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"description\":\"The type of versioning.\\nSee <https://docs.syncthing.net/users/versioning.html>.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"folders\",\"<name>\",\"versioning\",\"type\"],\"readOnly\":false,\"type\":\"one of \\\"external\\\", \\\"simple\\\", \\\"staggered\\\", \\\"trashcan\\\"\"},\"services.syncthing.settings.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The options element contains all other global configuration options\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"options\"],\"readOnly\":false,\"type\":\"open submodule of (JSON value)\"},\"services.syncthing.settings.options.limitBandwidthInLan\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to apply bandwidth limits to devices in the same broadcast domain as the local device.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"options\",\"limitBandwidthInLan\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"services.syncthing.settings.options.localAnnounceEnabled\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to send announcements to the local LAN, also use such announcements to find other devices.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"options\",\"localAnnounceEnabled\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"services.syncthing.settings.options.localAnnouncePort\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The port on which to listen and send IPv4 broadcast announcements to.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"options\",\"localAnnouncePort\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"services.syncthing.settings.options.maxFolderConcurrency\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"This option controls how many folders may concurrently be in I/O-intensive operations such as syncing or scanning.\\nThe mechanism is described in detail in a [separate chapter](https://docs.syncthing.net/advanced/option-max-concurrency.html).\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"options\",\"maxFolderConcurrency\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"services.syncthing.settings.options.relaysEnabled\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"When true, relays will be connected to and potentially used for device to device connections.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"options\",\"relaysEnabled\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"services.syncthing.settings.options.urAccepted\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether the user has accepted to submit anonymous usage data.\\nThe default, 0, mean the user has not made a choice, and Syncthing will ask at some point in the future.\\n\\\"-1\\\" means no, a number above zero means that that version of usage reporting has been accepted.\\n\",\"loc\":[\"services\",\"syncthing\",\"settings\",\"options\",\"urAccepted\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"services.syncthing.tray.command\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"syncthingtray --wait\"},\"description\":\"Syncthing tray command to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"qsyncthingtray\\\"\"},\"loc\":[\"services\",\"syncthing\",\"tray\",\"command\"],\"readOnly\":false,\"type\":\"string\"},\"services.syncthing.tray.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable a syncthing tray service.\",\"loc\":[\"services\",\"syncthing\",\"tray\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.syncthing.tray.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syncthing.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syncthing.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.syncthingtray-minimal\"},\"description\":\"The syncthingtray package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"qsyncthingtray\"},\"loc\":[\"services\",\"syncthing\",\"tray\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.syshud.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syshud.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syshud.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable syshud.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"syshud\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.syshud.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syshud.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syshud.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.syshud\"},\"description\":\"The syshud package to use.\",\"loc\":[\"services\",\"syshud\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.syshud.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syshud.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/syshud.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for syshud.\\nAll available options can be found here:\\n<https://github.com/System64fumo/syshud?tab=readme-ov-file#configuration>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  backlight-path = \\\"/sys/class/backlight/gmux_backlight\\\";\\n  height = 50;\\n  icon-size = 26;\\n  keyboard-path = \\\"/dev/input/eventXX\\\";\\n  listeners = \\\"audio_in,audio_out,backlight\\\";\\n  margins = \\\"0 0 0 0\\\";\\n  orientation = \\\"h\\\";\\n  position = \\\"bottom\\\";\\n  show-percentage = true;\\n  timeout = 3;\\n  transition-time = 250;\\n  width = 300;\\n}\"},\"loc\":[\"services\",\"syshud\",\"settings\"],\"readOnly\":false,\"type\":\"section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"services.syshud.style\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/syshud.nix>\",\"url\":\"https://