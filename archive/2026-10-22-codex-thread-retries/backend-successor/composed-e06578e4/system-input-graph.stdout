ager/blob/release-26.05/modules/programs/awscli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$HOME/.aws/credentials`.\\n\\nFor security reasons, never store cleartext passwords here.\\nWe recommend that you use `credential_process` option to retrieve\\nthe IAM credentials from your favorite password manager during runtime,\\nor use AWS IAM Identity Center to get short-term credentials.\\n\\nSee <https://docs.aws.amazon.com/cli/latest/userguide/cli-chap-authentication.html>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"default\\\" = {\\n    \\\"credential_process\\\" = \\\"${pkgs.pass}/bin/pass show aws\\\";\\n  };\\n};\\n\"},\"loc\":[\"programs\",\"awscli\",\"credentials\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.awscli.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/awscli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/awscli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable AWS CLI tool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"awscli\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.awscli.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/awscli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/awscli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.awscli2\"},\"description\":\"The aws package to use.\",\"loc\":[\"programs\",\"awscli\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.awscli.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/awscli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/rele