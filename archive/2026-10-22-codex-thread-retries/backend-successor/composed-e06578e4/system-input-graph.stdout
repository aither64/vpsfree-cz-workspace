strip=0 \\\n   \\\n  --clean \"$out\" > \"$tmpfile\"\n\nif [ ! -s \"$tmpfile\" ]; then\n  echo \"error: Normalized patch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://gitweb.gentoo.org/repo/gentoo.git/plain/app-arch/zip/files/zip-3.0-build.patch?id=d37d095fc7a2a9e4a8e904a7bf0f597fe99df85a"]},"system":"x86_64-linux","version":4},"nbrgq9hv4agp3mz77z3mysr1798ik6q9-libc.a-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"libc.a-builder","out":"/nix/store/498b7y27x90s3l5qzrx0nq1xm1mww8v1-libc.a-builder","passAsFile":"text","system":"x86_64-linux","text":"/nix/store/5rw53l1mkfaqsk0cgp9dx5qmiini3jnr-tinycc-mes-unstable-2025-12-03/bin/tcc -std=c11 -c /nix/store/h5x1k0lv3jlh1ir8ry23lm59hizjx01z-mes-libc-0.27.1/lib/libc.c\n/nix/store/5rw53l1mkfaqsk0cgp9dx5qmiini3jnr-tinycc-mes-unstable-2025-12-03/bin/tcc -ar cr ${out} libc.o\n"},"inputs":{"drvs":{"1vgxf29abq71i0mh3m