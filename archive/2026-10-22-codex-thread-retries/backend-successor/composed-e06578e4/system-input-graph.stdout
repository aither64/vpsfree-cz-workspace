s://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fish.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom fish completions. For more information see\\n<https://fishshell.com/docs/current/completions.html>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  my-prog = ''\\n    complete -c myprog -s o -l output\\n  '';\\n\\n  my-app = {\\n    body = ''\\n      complete -c myapp -s -v\\n    '';\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"fish\",\"completions\"],\"readOnly\":false,\"type\":\"attribute set of (strings concatenated with \\\"\\\\n\\\" or (submodule))\"},\"programs.fish.completions.<name>.body\":{\"declarations\":[],\"description\":\"The completion file's body.\\n\",\"loc\":[\"programs\",\"fish\",\"completions\",\"<name>\",\"body\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.fish.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fish.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fish.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable fish, the friendly interactive shell.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"fish\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.fish.functions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fish.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fish.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Basic functions to add to fish. For more information see\\n<https://fishshell.com/docs/current/cmds/function.html>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  __fish_command_not_found_handler = {\\n    body = \\\"__fish_default_command_not_found_handler $argv[1]\\\";\\n    onEvent = \\\"fish_command_not_found\\\";\\n  };\\n\\n  gitignore = \\\"curl -sL https://www.gitignore.io/api/$argv\\\";\\n}\\n\"},\"loc\":[\"programs\",\"fish\",\"functions\"],\"readOnly\":false,\"type\":\"attribute set of (strings concatenated with \\\"\\\\n\\\" or (submodule))\"},\"programs.fish.functions.<name>.argumentNames\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Assigns the value of successive command line arguments to the names\\ngiven.\\n\",\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"argumentNames\"],\"readOnly\":false,\"type\":\"null or string or list of string\"},\"programs.fish.functions.<name>.body\":{\"declarations\":[],\"description\":\"The function body.\\n\",\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"body\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.fish.functions.<name>.description\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A description of what the function does, suitable as a completion\\ndescription.\\n\",\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"description\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.fish.functions.<name>.inheritVariable\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Snapshots the value of the specified variable and defines a local\\nvariable with that same name and value when the function is defined.\\n\",\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"inheritVariable\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.fish.functions.<name>.noScopeShadowing\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Allows the function to access the variables of calling functions.\\n\",\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"noScopeShadowing\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.fish.functions.<name>.onEvent\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Tells fish to run this function when the specified named event is\\nemitted. Fish internally generates named events e.g. when showing the\\nprompt.\\n\",\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"onEvent\"],\"readOnly\":false,\"type\":\"null or string or list of string\"},\"programs.fish.functions.<name>.onJobExit\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Tells fish to run this function when the job with the specified group\\nID exits. Instead of a PID, the stringer `caller` can\\nbe specified. This is only legal when in a command substitution, and\\nwill result in the handler being triggered by the exit of the job\\nwhich created this command substitution.\\n\",\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"onJobExit\"],\"readOnly\":false,\"type\":\"null or string or signed integer\"},\"programs.fish.functions.<name>.onProcessExit\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Tells fish to run this function when the fish child process with the\\nspecified process ID exits. Instead of a PID, for backwards\\ncompatibility, `%self` can be specified as an alias\\nfor `$fish_pid`, and the function will be run when\\nthe current fish instance exits.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$fish_pid\\\"\"},\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"onProcessExit\"],\"readOnly\":false,\"type\":\"null or string or signed integer\"},\"programs.fish.functions.<name>.onSignal\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Tells fish to run this function when the specified signal is\\ndelivered. The signal can be a signal number or signal name.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"SIGHUP\\\"\\n  \\\"HUP\\\"\\n  1\\n]\"},\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"onSignal\"],\"readOnly\":false,\"type\":\"null or string or signed integer\"},\"programs.fish.functions.<name>.onVariable\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Tells fish to run this function when the specified variable changes\\nvalue.\\n\",\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"onVariable\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.fish.functions.<name>.wraps\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Causes the function to inherit completions from the given wrapped\\ncommand.\\n\",\"loc\":[\"programs\",\"fish\",\"functions\",\"<name>\",\"wraps\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.fish.generateCompletions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fish.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fish.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable the automatic generation of completions based upon installed man pages.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"fish\",\"generateCompletions\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.fish.interactiveShellInit\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fish.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fish.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Shell script code called during interactive fish shell\\ninitialisation.\\n\",\"loc\":[\"programs\",\"fish\",\"interactiveShellInit\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.fish.loginShellInit\"