less_grid = false;\\n  window_border_width = 1;\\n  window_border_active_color = \\\"#FF0000\\\";\\n}\\n\"},\"loc\":[\"xsession\",\"windowManager\",\"herbstluftwm\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or string)\"},\"xsession.windowManager.herbstluftwm.tags\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/herbstluftwm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/herbstluftwm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Tags to create on startup.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"work\\\"\\n  \\\"browser\\\"\\n  \\\"music\\\"\\n  \\\"gaming\\\"\\n]\"},\"loc\":[\"xsession\",\"windowManager\",\"herbstluftwm\",\"tags\"],\"readOnly\":false,\"type\":\"list of string\"},\"xsession.windowManager.i3.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/i3.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/i3.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"i3 configuration options.\",\"loc\":[\"xsession\",\"windowManager\",\"i3\",\"config\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"xsession.windowManager.i3.config.assigns\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/i3.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/i3.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set that assigns applications to workspaces based\\non criteria.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"0: extra\\\" = [\\n    {\\n      class = \\\"^Firefox$\\\";\\n      window_role = \\\"About\\\";\\n    }\\n  ];\\n  \\