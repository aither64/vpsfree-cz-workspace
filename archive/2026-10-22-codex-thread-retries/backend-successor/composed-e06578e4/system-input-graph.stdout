able-kernel=3.10.0","depsBuildBuild":"/nix/store/9ify11rwk3ci1s6f5ijcz0inklx1swlf-bootstrap-stage2-gcc-wrapper-15.3.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","dontInstall":"","dontUnpack":"","enableCETRuntimeDefault":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"fortify stackprotector strictflexarrays3","installFlags":"sysconfdir=$(out)/etc","installPhase":"mkdir $out\ncp sysdeps/generic/unsecvars.h $out\n","is64bit":"1","linuxHeaders":"/nix/store/9licwzbc8pzhrh43vz5wg137gky9anz3-linux-headers-6.18.7","makeFlags":"OBJCOPY=objcopy BUILD_LDFLAGS=-Wl,-rpath,/nix/store/x7wascvip2xhz68x5as5qi98kr1kz6zr-bootstrap-stage0-glibc-minimal-bootstrap/lib OBJDUMP=/nix/store/pniygg91p8wjk3ygf2p87q2v2pnlgglb-binutils-2.46/bin/objdump user-defined-trusted-dirs=/nix/store/l1n6wi2lyzglvgzbwzw9n9w2pzkcj41i-xgcc-15.3.0-libgcc/lib","mesonFlags":"","name":"glibc-2.42-100-source-unsecvars","nativeBuildInputs":"/nix/store/0r6nanzhxzsksjbc7ccyxasx23paikr5-bison-3.8.2 /nix/store/35ms57dszp6rfmnqrlxlh3nmm26kc1jx-gettext-1.0 /nix/store/wq6dp21s8b1dsjsysg964826ik4c1sxc-python3-minimal-3.13.15","out":"/nix/store/r2887sgbw0nhzqlpki5jslz8w0gax3h5-glibc-2.42-100-source-unsecvars","outputBin":"out","outputDev":"out","outputDevdoc":"out","outputDevman":"out","outputDoc":"out","outputInclude":"out","outputInfo":"out","outputLib":"out","outputMan":"out","outputs":"out","patches":"/nix/store/g3khz21aymjl3ii3xzxq9cbzsxiwyf28-2.42-master.patch /nix/store/nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch /nix/store/b1w7zbvm39ff1i52iyjggyvw2rdxz104-dont-use-system-ld-so-cache.patch /nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch /nix/store/llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch /nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch /nix/store/001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch /nix/store/0mb1pqwqkz9sk1fwgn897zlwzhhgfpbf-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch /nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch /nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch /nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch","phases":"unpackPhase patchPhase installPhase","pname":"glibc","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n\n# Apparently --bindir is not respected.\nmakeFlagsArray+=(\"bindir=$bin/bin\" \"sbindir=$bin/sbin\" \"rootsbindir=$bin/sbin\")\n","postInstall":"moveToOutput bin/getent $getent\necho SUPPORTED-LOCALES=C.UTF-8/UTF-8 > ../localedata/SUPPORTED\n# Don't install C.utf-8 into the archive, but into $out/lib/locale: on non-NixOS\n# systems with an empty /usr/lib/locale/locale-archive, glibc would fall back to\n# $libdir/locale/C.utf-8 instead of the locale archive of pkgs.glibc. See also #347965.\nmake -j${NIX_BUILD_CORES:-1} localedata/install-locale-files\n\ntest -f $out/etc/ld.so.cache && rm $out/etc/ld.so.cache\n\nif test -n \"$linuxHeaders\"; then\n    # Include the Linux kernel headers in Glibc, except the `scsi'\n    # subdirectory, which Glibc provides itself.\n    (cd $dev/include && \\\n     ln -sv $(ls -d $linuxHeaders/include/* | grep -v scsi\\$) .)\nfi\n\n# Fix for NIXOS-54 (ldd not working on x86_64).  Make a symlink\n# \"lib64\" to \"lib\".\nif test -n \"$is64bit\"; then\n    ln -s lib $out/lib64\nfi\n\n# Get rid of more unnecessary stuff.\nrm -rf $out/var $bin/bin/sln\n\n# Backwards-compatibility to fix e.g.\n# \"configure: error: Pthreads are required to build libgomp\" during `gcc`-build\n# because it's not actually needed anymore to link against `pthreads` since\n# it's now part of `libc.so.6` itself, but the gcc build breaks if\n# this doesn't work.\nln -sf $out/lib/libpthread.so.0 $out/lib/libpthread.so\nln -sf $out/lib/librt.so.1 $out/lib/librt.so\nln -sf $out/lib/libdl.so.2 $out/lib/libdl.so\ntest -f $out/lib/libutil.so.1 && ln -sf $out/lib/libutil.so.1 $out/lib/libutil.so\ntouch $out/lib/libpthread.a\n\n# Put libraries for static linking in a separate output.  Note\n# that libc_nonshared.a and libpthread_nonshared.a are required\n# for dynamically-linked applications.\nmkdir -p $static/lib\nmv $out/lib/*.a $static/lib\nmv $static/lib/lib*_nonshared.a $out/lib\n# If libutil.so.1 is missing, libutil.a is required.\ntest -f $out/lib/libutil.so.1 || mv $static/lib/libutil.a $out/lib\n# Some of *.a files are linker scripts where moving broke the paths.\nsed \"/^GROUP/s|$out/lib/lib|$static/lib/lib|g\" \\\n  -i \"$static\"/lib/*.a\n\n# Work around a Nix bug: hard links across outputs cause a build failure.\ncp $bin/bin/getconf $bin/bin/getconf_\nmv $bin/bin/getconf_ $bin/bin/getconf\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/l5y42bimjvvn8h3v5y40w13vv7y2p3k5-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","profilingLibraries":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"","src":"/nix/store/6zxixmszg0vbhpaa8rxwfr05by9axj68-glibc-2.42.tar.xz","stdenv":"/nix/store/b9nx1ma6kclwicf96id3ny5hf06hfzlp-bootstrap-stage2-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.42-100"},"inputs":{"drvs":{"3wa5cg5kw00sz41c5am8r1a46ryw5lwz-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"5zvp89mxindk21fhsw8jg3i7i8zddg61-gettext-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"7y9dhcsvg41d8ijzw6s8smcg1mld7fpf-libidn2-2.3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"g63m1s1h7yy2mw9w6kqwx0nlpdpc9z9y-bootstrap-stage2-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"imyy7rg9gyf2qyhg3jjnmal8grabvra9-glibc-2.42.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"n59ykfz9fgnzs6xa3i60amnzx3zpza3l-binutils-2.46.drv":{"dynamicOutputs":{},"outputs":["out"]},"s50pk97f9bsn3x7sszrswxq15mf8ph25-bootstrap-stage0-glibc-minimal-bootstrap.drv":{"dynamicOutputs":{},"outputs":["out"]},"vymcadm1nqaza937h2w09y6p211ckiks-python3-minimal-3.13.15.drv":{"dynamicOutputs":{},"outputs":["out"]},"w376i23z7amwhpjgffq12gs0fad1vphr-linux-headers-6.18.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"wsisnqqva71ba5k4x8dipsggdvcjb07x-xgcc-15.3.0.drv":{"dynamicOutputs":{},"outputs":["libgcc"]},"zpcyx19xh5p5faq27976yq1vh9q98aw5-bootstrap-stage2-gcc-wrapper-15.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"zv2kqb8hbz2bhvsikii3cxh49gdsy1l9-bash-static-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch","0mb1pqwqkz9sk1fwgn897zlwzhhgfpbf-0001-Revert-Remo