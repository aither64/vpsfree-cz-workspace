go\",\"telemetry\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.go.telemetry.date\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/go.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/go.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"1970-01-01\\\"\"},\"description\":\"The date indicating the date at which the modefile\\nwas updated, in YYYY-MM-DD format. It's used to\\nreset the timeout before the next telemetry report\\nis uploaded when telemetry mode is set to \\\"on\\\".\\n\",\"loc\":[\"programs\",\"go\",\"telemetry\",\"date\"],\"readOnly\":false,\"type\":\"string\"},\"programs.go.telemetry.mode\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/go.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/go.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Go telemetry mode to be set.\",\"loc\":[\"programs\",\"go\",\"telemetry\",\"mode\"],\"readOnly\":false,\"type\":\"null or one of \\\"off\\\", \\\"local\\\", \\\"on\\\"\"},\"programs.google-chrome-beta.nativeMessagingHosts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Google Chrome Beta native messaging hosts to install.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  pkgs.keepassxc\\n]\\n\"},\"loc\":[\"programs\",\"google-chrome-beta\",\"nativeMessagingHosts\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.google-chrome-dev.nativeMessagingHosts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Google Chrome Dev native messaging hosts to install.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  pkgs.keepassxc\\n]\\n\"},\"loc\":[\"programs\",\"google-chrome-dev\",\"nativeMessagingHosts\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.google-chrome.nativeMessagingHosts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Google Chrome native messaging hosts to install.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  pkgs.keepassxc\\n]\\n\"},\"loc\":[\"programs\",\"google-chrome\",\"nativeMessagingHosts\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.goto.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/goto.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/goto.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable {command}`goto`..\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"goto\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.goto.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/goto.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/goto.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"goto\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.goto.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/goto.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/goto.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"goto\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.goto.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/goto.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/goto.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.goto\"},\"description\":\"The goto package to use.\",\"loc\":[\"programs\",\"goto\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.gpg.dirmngrSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Dirmngr configuration options. Available options are described\\nin\\n[\\n  {manpage}`dirmngr(1)`\\n](https://www.gnupg.org/documentation/manuals/gnupg/Dirmngr-Options.html)\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  allow-version-check = true;\\n  keyserver = \\\"ldaps://ldap.example.com\\\";\\n}\\n\"},\"loc\":[\"programs\",\"gpg\",\"dirmngrSettings\"],\"readOnly\":false,\"type\":\"attribute set of (string or boolean or list of string)\"},\"programs.gpg.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable GnuPG.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gpg\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gpg.gpgsmSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"GPGSM configuration options. Available options are described\\nin\\n[\\n  {manpage}`gpgsm(1)`\\n](https://www.gnupg.org/documentation/manuals/gnupg/GPGSM-Options.html)\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  with-key-data = true;\\n}\"},\"loc\":[\"programs\",\"gpg\",\"gpgsmSettings\"],\"readOnly\":false,\"type\":\"attribute set of (string or boolean or list of string)\"},\"programs.gpg.homedir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/.gnupg\\\"\"},\"description\":\"Directory to store keychains and configuration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.xdg.dataHome}/gnupg\\\"\"},\"loc\":[\"programs\",\"gpg\",\"homedir\"],\"readOnly\":false,\"type\":\"absolute path\"},\"programs.gpg.mutableKeys\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"If set to `true`, you may manage your keyring as a user\\nusing the `gpg` command. Upon activation, the keyring\\nwill have managed keys added without overwriting unmanaged keys.\\n\\nIf set to `false`, the path\\n{file}`$GNUPGHOME/pubring.kbx` will become an immutable\\nlink to the Nix store, denying modifications.\\n\",\"loc\":[\"programs\",\"gpg\",\"mutableKeys\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gpg.mutableTrust\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"If set to `true`, you may manage trust as a user using\\nthe {command}`gpg` command. Upon activation, trusted keys have\\ntheir trust set without overwriting unmanaged keys.\\n\\nIf set to `false`, the path\\n{file}`$GNUPGHOME/trustdb.gpg` will be\\n*overwritten* on each activation, removing trust for\\nany unmanaged keys. Be careful to make a backup of your old\\n{file}`trustdb.gpg` before switching to immutable trust!\\n\",\"loc\":[\"programs\",\"gpg\",\"mutableTrust\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gpg.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gnupg\"},\"description\":\"The gnupg package to use. Also used by the gpg-agent service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gnupg23\"},\"loc\":[\"programs\",\"gpg\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.gpg.publicKeys\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"A list of public keys to be imported into GnuPG. Note, these key files\\nwill be copied into the world-readable Nix store.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ { source = ./pubkeys.txt; } ]\\n\"},\"loc\":[\"programs\",\"gpg\",\"publicKeys\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.gpg.publicKeys.*.source\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"description\":\"Path of an OpenPGP public key file.\\n\",\"loc\":[\"programs\",\"gpg\",\"publicKeys\",\"*\",\"source\"],\"readOnly\":false,\"type\":\"absolute path\"},\"programs.gpg.publicKeys.*.text\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Text of an OpenPGP public key.\\n\",\"loc\":[\"programs\",\"gpg\",\"publicKeys\",\"*\",\"text\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.gpg.publicKeys.*.trust\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The amount of trust you have in the key ownership and the care the\\nowner puts into signing other keys. The available levels are\\n\\n`unknown` or `1`\\n: I don't know or won't say.\\n\\n`never` or `2`\\n: I do **not** trust.\\n\\n`marginal` or `3`\\n: I trust marginally.\\n\\n`full` or `4`\\n: I trust fully.\\n\\n`ultimate` or `5`\\n: I trust ultimately.\\n\\nSee the [Key Management chapter](https://www.gnupg.org/gph/en/manual/x334.html)\\nof the GNU Privacy Handbook for more.\\n\",\"loc\":[\"programs\",\"gpg\",\"publicKeys\",\"*\",\"trust\"],\"readOnly\":false,\"type\":\"null or one of \\\"unknown\\\", 1, \\\"never\\\", 2, \\\"marginal\\\", 3, \\\"full\\\", 4, \\\"ultimate\\\", 5\"},\"programs.gpg.scdaemonSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"SCdaemon configuration options. Available options are described\\nin\\n[\\n  {manpage}`scdaemon(1)`\\n](https://www.gnupg.org/documentation/manuals/gnupg/Scdaemon-Options.html).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  disable-ccid = true;\\n}\"},\"loc\":[\"programs\",\"gpg\",\"scdaemonSettings\"],\"readOnly\":false,\"type\":\"attribute set of (string or boolean or list of string)\"},\"programs.gpg.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gpg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gpg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"GnuPG configuration options. Available options are described\\nin\\n[\\n  {manpage}`gpg(1)`\\n](https://gnupg.org/documentation/manpage.html).\\n\\nNote that lists are converted to duplicate keys.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  no-comments = false;\\n  s2k-cipher-algo = \\\"AES128\\\";\\n}\"},\"loc\":[\"programs\",\"gpg\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (string or boolean or list of string)\"},\"programs.gradle.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gradle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gradle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Gradle Build Tool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gradle\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gradle.home\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gradle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gradle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\".gradle\\\"\"},\"description\":\"The Gradle home directory, re