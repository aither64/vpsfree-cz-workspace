stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to file containing password for login.\\n\\n::: {.warning}\\n  This option takes precedence over {option}`services.stash.settings.password`\\n::\\n\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/path/to/password/file\\\"\"},\"loc\":[\"services\",\"stash\",\"passwordFile\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"services.stash.plugins\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The plugins Stash should be started with.\\n\",\"loc\":[\"services\",\"stash\",\"plugins\"],\"readOnly\":false,\"type\":\"list of package\"},\"services.stash.scrapers\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The scrapers Stash should be started with.\\n\",\"loc\":[\"services\",\"stash\",\"scrapers\"],\"readOnly\":false,\"type\":\"list of package\"},\"services.stash.sessionStoreKeyFile\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"description\":\"Path to file containing a secret for session store.\",\"loc\":[\"services\",\"stash\",\"sessionStoreKeyFile\"],\"readOnly\":false,\"type\":\"absolute path\"},\"services.stash.settings\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"description\":\"Stash configuration\",\"loc\":[\"services\",\"stash\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (YAML 1.1 value)\"},\"services.stash.settings.blobs_path\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/var/lib/stash/blobs\\\"\"},\"description\":\"Path to blobs\",\"loc\":[\"services\",\"stash\",\"settings\",\"blobs_path\"],\"readOnly\":false,\"type\":\"absolute path\"},\"services.stash.settings.blobs_storage\":{\"declaratio