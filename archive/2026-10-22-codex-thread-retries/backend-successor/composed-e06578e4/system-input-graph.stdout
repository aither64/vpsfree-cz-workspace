iguration for Fluxbox, written to\\n{file}`~/.fluxbox/keys`. Look at the\\n{manpage}`fluxbox-keys(1)` manpage for details.\\n\",\"loc\":[\"xsession\",\"windowManager\",\"fluxbox\",\"keys\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"xsession.windowManager.fluxbox.menu\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/fluxbox.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/fluxbox.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Menu configuration for Fluxbox, written to\\n{file}`~/.fluxbox/menu`. Look at the\\n{manpage}`fluxbox-menu(1)` manpage for details.\\n\",\"loc\":[\"xsession\",\"windowManager\",\"fluxbox\",\"menu\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"xsession.windowManager.fluxbox.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/fluxbox.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/fluxbox.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.fluxbox\"},\"description\":\"The fluxbox package to use.\",\"loc\":[\"xsession\",\"windowManager\",\"fluxbox\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"xsession.windowManager.fluxbox.slitlist\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/fluxbox.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/fluxbox.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Slitlist configuration for Fluxbox, written to\\n{file}`~/.fluxbox/slitlist`. Look at the\\n{manpage}`fluxbox(1)` manpage for details.\\n\",\"loc\":[\"xsession\",\"windowManager\",\"fluxbox\",\"slitlist\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"xsession.windowManager.fluxbox.windowmenu\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/fluxbox.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/fluxbox.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Window menu configuration for Fluxbox, written to\\n{file}`~/.fluxbox/windowmenu`. Look at the\\n{manpage}`fluxbox-menu(1)`\\nmanpage for details.\\n\",\"loc\":[\"xsession\",\"windowManager\",\"fluxbox\",\"windowmenu\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"xsession.windowManager.herbstluftwm.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/herbstluftwm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/herbstluftwm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable herbstluftwm window manager.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"xsession\",\"windowManager\",\"herbstluftwm\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xsession.windowManager.herbstluftwm.enableAlias\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/herbstluftwm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/herbstluftwm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Set an alias for the {command}`herbstclient` command in the\\n{file}`autostart` script that only stores its arguments and executes\\nthem all at once at the end of the {file}`autostart` script.\\n\\nThis reduces the amount of flickering you get while all options are\\nbeing applied and improves the performance.\\n\\nOn the other hand, this makes it more difficult to write bash functions\\nthat call {command}`herbstclient`. You can work around this by calling\\n{command}`command herbstclient` in your functions to still get some of\\nthe benefits of enabling this alias.\\n\",\"loc\":[\"xsession\",\"windowManager\",\"herbstluftwm\",\"enableAlias\"],\"readOnly\":false,\"type\":\"boolean\"},\"xsession.windowManager.herbstluftwm.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/herbstluftwm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/herbstluftwm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines to add verbatim to\\n{file}`$XDG_CONFIG_HOME/herbstluftwm/autostart`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  herbstclient set_layout max\\n  herbstclient detect_monitors\\n''\"},\"loc\":[\"xsession\",\"windowManager\",\"herbstluftwm\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"xsession.windowManager.herbstluftwm.keybinds\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/herbstluftwm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/herbstluftwm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Herbstluftwm keybinds.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  Mod4-o = \\\"split right\\\";\\n  Mod4-u = \\\"split bottom\\\";\\n}\"},\"loc\":[\"xsession\",\"windowManager\",\"herbstluftwm\",\"keybinds\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"xsession.windowManager.herbstluftwm.mousebinds\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/herbstluftwm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/herbstluftwm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{