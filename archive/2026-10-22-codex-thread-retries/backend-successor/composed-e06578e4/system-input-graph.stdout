-3.126-hashed","installPhase":"install -D -t \"$out/etc/ssl/certs\" ca-bundle.crt\n\n# install standard PEM compatible bundle\ninstall -D -t \"$out/etc/ssl/certs\" ca-no-trust-rules-bundle.crt\n\n# install p11-kit specific output to p11kit output\ninstall -D -t \"$p11kit/etc/ssl/trust-source\" ca-bundle.trust.p11-kit\n\n# install individual certs in unbundled output\ninstall -D -t \"$unbundled/etc/ssl/certs\" unbundled/*.crt\n\n# install hashed certs in hashed output\n# use cp as install doesn't copy symlinks\nmkdir -p $hashed/etc/ssl/certs/\ncp -P hashed/* $hashed/etc/ssl/certs/\n","mesonFlags":"","name":"nss-cacert-3.126","nativeBuildInputs":"/nix/store/s59ysc0lib928m5kdnnhdminh5xxxvps-python3.13-buildcatrust-0.5.1","out":"/nix/store/ngnbakidj612mzmkblzs4wf94x054f0c-nss-cacert-3.126","outputs":"out unbundled p11kit hashed","p11kit":"/nix/store/dqhyr2k2abmqvrbkpqg6ax2vmqc8a376-nss-cacert-3.126-p11kit","patches":"","pname":"nss-cacert","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHook":"/nix/store/jz6yi8j4gpjk0y3ggil7h2dd3bim689w-setup-hook.sh","src":"/nix/store/rfjs1fcacfd1xysy7cmvxsrb9znz6iln-certdata.txt","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","unbundled":"/nix/store/2grz46j1ffiacw6pajssz1g37ckkmlps-nss-cacert-3.126-unbundled","unpackPhase":"runHook preUnpack\ncp \"$src\" \"$(stripHash \"$src\")\"\nrunHook postUnpack\n","version":"3.126"},"inputs":{"drvs":{"6c6y9mdbgpa949jfcj006h3fwsgh43rj-certdata.txt.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"gyqyxjj1yd50hkli0r2wk6rjvr38bxcz-cacert-extra-certificates-bundle.crt.drv":{"dynamicOutputs":{},"outputs":["out"]},"mxj7zpm2kn21460wa8b1qnaisngdlknn-python3.13-buildcatrust-0.5.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"n99wxpg2cdwfnf6psd7q14w4dq7i73js-cacert-blocklist.txt.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk