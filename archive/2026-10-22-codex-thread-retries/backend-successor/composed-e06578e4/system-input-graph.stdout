ion\":\"Whether vdirsyncer should produce verbose output.\\n\",\"loc\":[\"services\",\"vdirsyncer\",\"verbosity\"],\"readOnly\":false,\"type\":\"null or one of \\\"CRITICAL\\\", \\\"ERROR\\\", \\\"WARNING\\\", \\\"INFO\\\", \\\"DEBUG\\\"\"},\"services.volnoti.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/volnoti.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/volnoti.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Volnoti volume HUD daemon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"volnoti\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.volnoti.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/volnoti.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/volnoti.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.volnoti\"},\"description\":\"The volnoti package to use.\",\"loc\":[\"services\",\"volnoti\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.walker.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/walker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/walker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable walker.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"walker\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.walker.enableElephantIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/walker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/walker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.services.elephant.enable\"},\"description\":\"Whether to make Walker's systemd s