.4.1/bin:/nix/store/8sn2nxrzlp4y2bn0s55pjlrdjmapyzkl-diffutils-3.8/bin:/nix/store/1694ha2msax6nrx00bhg2ybrpqfmkqq4-findutils-4.11.0/bin:/nix/store/6iaxizkgwnfgpdka79i294sl9kwz7vmd-python-3.14.6/bin:/nix/store/w26qq2n4s1lqin96yky4gkp9dwfwm04q-bison-3.8.2/bin:/nix/store/x7y50xlwjp75hyqrq6038krray7schys-gnutar-1.35/bin:/nix/store/fjy092g1x515rnpv33bjx00hxfbp67h9-xz-5.8.3/bin:/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin:/nix/store/rfv4gzzcgz85wlha9k4s850c9l3k46m2-bootstrap-coreutils-musl-9.11/bin","SHELL":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","buildCommand":"# Unpack\ntar xf /nix/store/jq00nlpdcxgcj5xwx25jibn61a611234-glibc-2.44.tar.xz\ncd glibc-2.44\n\n# Configure\nmkdir build\ncd build\n# libstdc++.so is built against musl and fails to link\nexport CXX=false\nexport CFLAGS=\"-O1\"\nbash ../configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-headers=/nix/store/kxg2gx616qp44cnz3by3gnzhacky8jbg-linux-headers-6.5.6/include \\\n  --disable-dependency-tracking \\\n  --disable-nscd \\\n  --disable-build-nscd \\\n  --disable-profile \\\n  --disable-timezone-tools \\\n  --disable-mathvec\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES INSTALL_UNCOMPRESSED=yes install\nln -s $(ls -d /nix/store/kxg2gx616qp44cnz3by3gnzhacky8jbg-linux-headers-6.5.6/include/* | grep -v scsi\\$) $out/include/\nfind $out/{bin,sbin,lib,libexec} -type f -exec strip --strip-unneeded {} + || true\n\n# localedef + iconv() are never invoked downstream of this glibc\nrm -rf $out/share/i18n $out/lib/gconv $out/share/locale\nrm -rf $out/bin $out/sbin\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"glibc-2.44","out":"/nix/store/51f6105iiff1b0rnn89nklj6va4rmhqz-glibc-2.44","passAsFile":"buildCommand","pname":"glibc","system":"x86_64-linux","version":"2.44"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs