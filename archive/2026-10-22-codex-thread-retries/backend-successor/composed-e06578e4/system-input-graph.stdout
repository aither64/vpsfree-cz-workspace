Expression\",\"text\":\"true\"},\"loc\":[\"programs\",\"pubs\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.pubs.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pubs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pubs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Configuration using syntax written to\\n{file}`$HOME/.pubsrc`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n[main]\\npubsdir = ${config.home.homeDirectory}/.pubs\\ndocsdir = ${config.home.homeDirectory}/.pubs/doc\\ndoc_add = link\\nopen_cmd = xdg-open\\n\\n[plugins]\\nactive = git,alias\\n\\n[[alias]]\\n\\n[[[la]]]\\ncommand = list -a\\ndescription = lists papers in lexicographic order\\n\\n[[git]]\\nquiet = True\\nmanual = False\\nforce_color = False\\n''\"},\"loc\":[\"programs\",\"pubs\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.pubs.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pubs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pubs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.pubs\"},\"description\":\"The pubs package to use.\",\"loc\":[\"programs\",\"pubs\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.pyenv.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyenv.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyenv.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable pyenv.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"pyenv\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.pyenv.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyenv.nix>