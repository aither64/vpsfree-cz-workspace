nfi\n\nbuildFlags+=(\"KBUILD_BUILD_TIMESTAMP=$(date -u -d @$SOURCE_DATE_EPOCH)\")\n\ncd $buildRoot\n","depsBuildBuild":["/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0"],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"dontCheckForBrokenSymlinks":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"KRUSTFLAGS":"--remap-path-prefix /nix/store/y3naha70rpjj3kl4grbz3ixpxj14kzwn-rust-lib-src=/","RUST_LIB_SRC":"/nix/store/y3naha70rpjj3kl4grbz3ixpxj14kzwn-rust-lib-src"},"hardeningDisable":["bindnow","format","fortify","stackprotector","pic"],"installFlags":["INSTALL_PATH=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9","INSTALL_MOD_PATH=/05n2ffx0bx7cbs5cpskwv10kvhr5662c2hh43kwqqb2y4gmiifn9"],"installTargets":["install"],"karch":"x86_64","makeFlags":["O=$(buildRoot)","--eval=undefine modules","CC=/nix/store/s2f0mfx0iiap9yxmlfvq0psn26jsbind-gcc-15.3.0/bin/gcc","LD=/nix/store/g2i5zxslx9msaqjy14hdp2af064i9pbv-binutils-2.46/bin/ld","AR=/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0/bin/ar","NM=/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0/bin/nm","STRIP=/nix/store/g2i5zxslx9msaqjy14hdp2af064i9pbv-binutils-2.46/bin/strip","OBJCOPY=/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0/bin/objcopy","OBJDUMP=/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0/bin/objdump","READELF=/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0/bin/readelf","HOSTCC=/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0/bin/cc","HOSTCXX=/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0/bin/c++","HOSTAR=/nix/store/2gjbrb8nwqf1225n3zhca56s2rxrqqhx-binutils-wrapper-2.46/bin/ar","HOSTLD=/nix/store/2gjbrb8nwqf1225n3zhca56s2rxrqqhx-binutils-wrapper-2.46/bin/ld","ARCH=x86_64","CROSS_COMPILE="],"mesonFlags":[],"name":"linux-6.18.57","nativeBuildInputs":["/nix/store/7yaq6zpgwizygk1gayplhd259sr092y9-bison-3.8.2","/nix/store/lmlgg4x8djbs8mcxrk1b299dja91v1mh-flex-2.6.4","/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3","/nix/store/jmajrnh1f681gzzd8cw1zwmljcl9zny0-bc-1.08.2","/nix/store/7l09089ahshxjx4js3zswqk6azhx6ccq-openssl-3.6.5-dev","/nix/store/63yjhcfwaw0q9820w1ngnzg0ad94wxdh-rsync-3.5.0","/nix/store/48zd0j6xb1z8n6sqlz2kwbhl1c7z6zky-gmp-with-cxx-6.3.0-dev","/nix/store/nnkbsv2rfwn0my902cr8hca596xlvv5g-libmpc-1.4.0","/nix/store/jwp5408jxmql5gg91b7rpg6fr38wzx6s-mpfr-4.2.2-dev","/nix/store/f6haxbzaxb7v5d92wscfbrhip2l6l1m4-elfutils-0.194-dev","/nix/store/1hjg44rywjpc52nnhs1z9iba9vgr2s3n-zstd-1.5.7-dev","/nix/store/fxkblyql61smqv7pqg3493k6v9igag79-python3-minimal-3.13.15","/nix/store/244nqjigsdimqc5qvyn7k9657l90rc9b-kmod-31-dev","/nix/store/9pv37l9pfhx6q1h2q1ng2r6nkcny5zq9-hexdump-util-linux-minimal-2.42.3","/nix/store/piivrd3lh89g90plr9faz243pll0jrgm-cpio-2.15","/nix/store/jf59pnvpdy9ydx10gn1amz80lnlhm0a7-pahole-1.31","/nix/store/2k9dj65vyanlvq863ks3ii7cjx82kfng-zlib-1.3.2-dev","/nix/store/khz08fcmpq1rp5lhpkzvqv8icnfykv79-rustc-1.95.0","/nix/store/3jm282k17havs422c4rgsh3lsxajdrxj-rust-bindgen-unwrapped-0.72.1"],"outputChecks":{"dev":{},"modules":{},"out":{}},"outputs":["out","dev","modules"],"patches":["/nix/store/mnlqwys9dxznjcvq4w3s0435s9ql8qv8-bridge-stp-helper.patch","/nix/store/mbz5gln1q4swlzmqs2399br98qjif9kn-request-key-helper.patch","/nix/store/23728y7zgh1jb55kpwxv5qnjbq0ykca6-randstruct-provide-seed-5.19.patch"],"pname":"linux","postInstall":"mkdir -p $dev\ncp vmlinux $dev/\n\nmkdir -p $dev/lib/modules/6.18.57/build/scripts\n# Installing from source dir instead of $buildRoot so as to omit intermediate artifacts.\ncp -rL ../scripts/gdb/ $dev/lib/modules/6.18.57/build/scripts\n# Installing `constants.py` from `$buildRoot` as it's generated.\ncp scripts/gdb/linux/constants.py $dev/lib/modules/6.18.57/build/scripts/gdb/linux\n\nif [ -z \"${dontStrip-}\" ]; then\n  installFlags+=(\"INSTALL_MOD_STRIP=1\")\nfi\nmake modules_install \"${makeFlags[@]}\" \"${installFlags[@]}\"\nunlink $modules/lib/modules/6.18.57/build\n\nmkdir -p $dev/lib/modules/6.18.57/{build,source}\n\n# To save space, exclude a bunch of unneeded stuff when copying.\n(cd .. && rsync --archive --prune-empty-dirs \\\n    --exclude='/build/' \\\n    * $dev/lib/modules/6.18.57/source/)\n\ncd $dev/lib/modules/6.18.57/source\n\ncp $buildRoot/{.config,Module.symvers} $dev/lib/modules/6.18.57/build\nmake modules_prepare \"${makeFlags[@]}\" O=$dev/lib/modules/6.18.57/build\n\n# For reproducibility, removes accidental leftovers from a `cc1` call\n# from a `try-run` call from the Makefile\nrm -f $dev/lib/modules/6.18.57/build/.[0-9]*.d\n\n# Keep some extra files on some arches (powerpc, aarch64)\nfor f in arch/powerpc/lib/crtsavres.o arch/arm64/kernel/ftrace-mod.o; do\n  if [ -f \"$buildRoot/$f\" ]; then\n    mkdir -p \"$(dirname $dev/lib/modules/6.18.57/build/$f)\"\n    cp $buildRoot/$f $dev/lib/modules/6.18.57/build/$f\n  fi\ndone\n\n# !!! No documentation on how much of the source tree must be kept\n# If/when kernel builds fail due to missing files, you can add\n# them here. Note that we may see packages requiring headers\n# from drivers/ in the future; it adds 50M to keep all of its\n# headers on 3.10 though.\n\nchmod u+w -R ..\nbuildArchDir=\"$dev/lib/modules/6.18.57/build/arch\"\n\n# Remove unused arches\nfor d in $(cd arch/; ls); do\n  if [ -d \"$buildArchDir/$d\" ]; then continue; fi\n  if [ -d \"$buildArchDir/arm64\" ] && [ \"$d\" = arm ]; then continue; fi\n  rm -rf arch/$d\ndone\n\n# Remove all driver-specific code (50M of which is headers)\nrm -fR drivers\n\n# Keep all headers\nfind .  -type f -name '*.h' -print0 | xargs -0 -r chmod u-w\n\n# Keep linker scripts (they are required for out-of-tree modules on aarch64)\nfind .  -type f -name '*.lds' -print0 | xargs -0 -r chmod u-w\n\n# Keep root and arch-specific Makefiles\nchmod u-w Makefile arch/*/Makefile*\n\n# Keep rust Makefile\nchmod u-w rust/Makefile\n\n# Keep whole scripts dir\nchmod u-w -R scripts\n\n# Delete everything not kept\nfind . -type f -perm -u=w -print0 | xargs -0 -r rm\n\n# Delete empty directories\nfind -empty -type d -delete\n","postPatch":"# Ensure that depmod gets resolved through PATH\nsed -i Makefile -e 's|= /sbin/depmod|= depmod|'\n\n# Some linux-hardened patches now remove certain files in the scripts directory, so the file may not exist.\n[[ -f scripts/ld-version.sh ]] && patchShebangs scripts/ld-version.sh\n\n# Set randstruct seed to a deterministic but diversified value. Note:\n# we could have instead patched gen-random-seed.sh to take input from\n# the buildFlags, but that would require also patching the kernel's\n# toplevel Makefile to add a variable export. This would be likely to\n# cause future patch conflicts.\nfor file in scripts/gen-randstruct-seed.sh scripts/gcc-plugins/gen-random-seed.sh; do\n  if [ -f \"$file\" ]; then\n    substituteInPlace \"$file\" \\\n      --replace NIXOS_RANDSTRUCT_SEED \\\n      $(echo /nix/store/66sc4ydys5dbj8n5dgglsli2zvjajs8b-linux-6.18.57.tar.xz /1s3bzfisrvrdlla1qr3z074sphpb4cpz4rbacwp56cmp9237lv2y | sha256sum | cut -d ' ' -f 1 | tr -d '\\n')\n    break\n  fi\ndone\n\npatchShebangs scripts\n\n# also patch arch-specific install scripts\nfor i in $(find arch -name install.sh); do\n    patchShebangs \"$i\"\ndone\n\n# unset $src because the build system tries to use it and spams a bunch of warnings\n# see: https://github.com/torvalds/linux/commit/b1992c3772e69a6fd0e3fc81cd4d2820c8b6eca0\nunset src\n","preFixup":"if [ -z \"${dontStrip-}\" -a -e $out/vmlinux ]; then\n  strip -v -S -p $out/vmlinux\nfi\n","preInstall":"installFlags+=(\"-j$NIX_BUILD_CORES\")\nexport HOME=/nix/store/x0vlp6cv13acnqccxa4n37p3nbv059am-installkernel\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"src":"/nix/store/66sc4ydys5dbj8n5dgglsli2zvjajs8