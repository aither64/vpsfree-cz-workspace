\n    [ -n \"$(type -P \"$b\" || true)\" ] && echo \"$b\" && break\n  done\n)\"\nif [ -z \"$browser\" ]; then\n  browser=\"$(type -P xdg-open || true)\"\n  if [ -z \"$browser\" ]; then\n    browser=\"/nix/store/81clf2aq9bbql6cjnxn5xnlahj7lzya6-w3m-0.5.6/bin/w3m\"\n  fi\nfi\nexec \"$browser\" /nix/store/q8my8fpvih8mxh6cx3fz9rrng1xdkpjg-nixos-manual-html/share/doc/nixos/index.html\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"ayqr7wjcnz666fnxkp35lw4h1xyrj23h-w3m-0.5.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"yzkv3bnia5mfsaj8n2nmrw071qfqjawh-nixos-manual-html.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"nixos-help","outputs":{"out":{"path":"pf0m352lc9rz7qwc9nss35rqacz7h3s7-nixos-help"}},"system":"x86_64-linux","version":4},"hvfaxfwg8nf40x5nbxvizq1snjhj0bg6-IPC-Run-20231003.0.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/7s0vhzddx32kh7bjnkiislj0f3hyhjki-IPC-Run-20231003.0.tar.gz"},"inputs":{"drvs":{"3fc7klhja3mn322hjxl4bax4mk3m6h8l-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"nccfw1s0py9wvalrf7s92cfmg7bijj0i-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"IPC-Run-20231003.0.tar.gz","outputs":{"out":{"hash":"sha256-6yW731kT0pF5fvG/6ZjxUTC0VdPtAqrN5oVvCyXk/lc=","method":"f