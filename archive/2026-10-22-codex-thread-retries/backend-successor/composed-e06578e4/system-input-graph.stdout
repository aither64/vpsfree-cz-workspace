l\\\"\"},\"loc\":[\"programs\",\"termite\",\"iconName\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.termite.modifyOtherKeys\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Emit escape sequences for extra keys,\\nlike the modifyOtherKeys resource for\\n{manpage}`xterm(1)`.\\n\",\"loc\":[\"programs\",\"termite\",\"modifyOtherKeys\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.termite.mouseAutohide\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Automatically hide the mouse pointer when you start typing.\\n\",\"loc\":[\"programs\",\"termite\",\"mouseAutohide\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.termite.optionsExtra\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra options that should be added to [options] section.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fullscreen = true\\\"\"},\"loc\":[\"programs\",\"termite\",\"optionsExtra\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.termite.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.termite\"},\"description\":\"The termite package to use.\",\"loc\":[\"programs\",\"termite\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.termite.scrollOnKeystroke\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Scroll to the bottom automatically when a key is pressed.\\n\",\"loc\":[\"programs\",\"termite\",\"scrollOnKeystroke\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.termite.scrollOnOutput\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Scroll to the bottom when the shell generates output.\",\"loc\":[\"programs\",\"termite\",\"scrollOnOutput\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.termite.scrollbackLines\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the number of lines to limit the terminal's scrollback.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"10000\"},\"loc\":[\"programs\",\"termite\",\"scrollbackLines\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"programs.termite.scrollbar\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Scrollbar position.\",\"loc\":[\"programs\",\"termite\",\"scrollbar\"],\"readOnly\":false,\"type\":\"null or one of \\\"off\\\", \\\"left\\\", \\\"right\\\"\"},\"programs.termite.searchWrap\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Search from top again when you hit the bottom.\",\"loc\":[\"programs\",\"termite\",\"searchWrap\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.termite.sizeHints\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Enable size hints. Locks the terminal resizing\\nto increments of the terminal's cell size.\\nRequires a window manager that respects scroll hints.\\n\",\"loc\":[\"programs\",\"termite\",\"sizeHints\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.termite.urgentOnBell\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/termite.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Sets the window as urgent on the terminal bell.\",\"loc\":[\"programs\",\"termite\",\"urgentOnBell\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.tex-fmt.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tex-fmt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tex-fmt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable tex-fmt.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"tex-fmt\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tex-fmt.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tex-fmt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tex-fmt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.tex-fmt\"},\"description\":\"The tex-fmt package to use.\",\"loc\":[\"programs\",\"tex-fmt\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.tex-fmt.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tex-fmt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tex-fmt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/tex-fmt/tex-fmt.toml` on Linux or\\n{file}`$HOME/Library/Application Support/tex-fmt/tex-fmt.toml` on Darwin.\\nSee <https://github.com/WGUNDERWOOD/tex-fmt> and\\n<https://github.com/WGUNDERWOOD/tex-fmt/blob/master/tex-fmt.toml>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  lists = [ ];\\n  tabchar = \\\"space\\\";\\n  tabsize = 2;\\n  wrap = true;\\n}\"},\"loc\":[\"programs\",\"tex-fmt\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.texlive.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/texlive.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/texlive.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable TeX Live.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"texlive\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.texlive.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/texlive.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/texlive.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"tpkgs: { inherit (tpkgs) collection-basic; }\\\"\"},\"description\":\"Extra packages available to TeX Live.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"tpkgs: { inherit (tpkgs) collection-fontsrecommended algorithms; }\\n\"},\"loc\":[\"programs\",\"texlive\",\"extraPackages\"],\"readOnly\":false,\"type\":\"unspecified value\"},\"programs.texlive.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/texlive.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/texlive.nix\"}],\"description\":\"Resulting customized TeX Live package.\",\"loc\":[\"programs\",\"texlive\",\"package\"],\"readOnly\":true,\"type\":\"package\"},\"programs.texlive.packageSet\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/texlive.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/texlive.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.texlive\"},\"description\":\"TeX Live package set to use.\",\"loc\":[\"programs\",\"texlive\",\"packageSet\"],\"readOnly\":false,\"type\":\"unspecified value\"},\"programs.thunderbird.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Thunderbird.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"thunderbird\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.thunderbird.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"description\":\"Resulting Thunderbird package.\",\"loc\":[\"programs\",\"thunderbird\",\"finalPackage\"],\"readOnly\":true,\"type\":\"package\"},\"programs.thunderbird.languagePacks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Thunderbird language packs to install and activate through enterprise\\npolicies.\\n\\nAvailable language codes can be found on the releases page:\\n`https://releases.mozilla.org/pub/thunderbird/releases/${version}/linux-x86_64/xpi/`,\\nreplacing `${version}` with the version of Thunderbird you have. If\\nthe version string of your Thunderbird package differs from the\\nupstream version, override the internal `release` option.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"en-GB\\\"\\n  \\\"de\\\"\\n]\"},\"loc\":[\"programs\",\"thunderbird\",\"languagePacks\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.thunderbird.nativeMessagingHosts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Additional packages containing native messaging hosts that should be\\nmade available to Thunderbird extensions.\\n\",\"loc\":[\"programs\",\"thunderbird\",\"nativeMessagingHosts\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.thunderbird.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.thunderbird\"},\"description\":\"The thunderbird package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.thunderbird-91\"},\"loc\":[\"programs\",\"thunderbird\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.thunderbird.policies\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Thunderbird enterprise policies. See the\\n[list of policies](https://thunderbird.github.io/policy-templates/).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  DisableTelemetry = true;\\n  ExtensionSettings = {\\n    \\\"addoncompatibility@opto.one\\\" = {\\n      install_url = \\\"https://addons.thunderbird.net/thunderbird/downloads/latest/addon-compatibility-check/latest.xpi\\\";\\n      installation_mode = \\\"normal_installed\\\";\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"thunderbird\",\"policies\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.thunderbird.profiles\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"description\":\"Attribute set of Thunderbird profiles.\",\"loc\":[\"programs\",\"thunderbird\",\"profiles\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.thunderbird.profiles.<name>.accountsOrder\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Custom ordering of accounts and local folders in\\nThunderbird's folder pane. The accounts are specified\\nby their name. For declarative accounts, it must be the name\\nof their attribute in `config.accounts.email.accounts` (or\\n`config.programs.thunderbird.profiles.<name>.feedAccounts`\\nfor feed accounts). The local folders name can be found in\\nthe `mail.accountmanager.accounts` Thunderbird preference,\\nfor example with Settings > Config Editor (\\\"account1\\\" by\\ndefault). Enabled accounts and local folders that aren't\\nlisted here appear in an arbitrary order after the ordered\\naccounts.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  [\\n    \\\"my-awesome-account\\\"\\n    \\\"private\\\"\\n    \\\"work\\\"\\n    \\\"rss\\\"\\n    /* Other accounts in arbitrary order */\\n  ]\\n''\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"accountsOrder\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.thunderbird.profiles.<name>.calendarAccountsOrder\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Custom ordering of calendar accounts. The accounts are specified\\nby their name. For declarative accounts, it must be the name\\nof their attribute in `config.accounts.calendar.accounts`.\\nEnabled accounts that aren't listed here appear in an arbitrary\\norder after the ordered accounts.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  [\\n    \\\"my-awesome-account\\\"\\n    \\\"private\\\"\\n    \\\"work\\\"\\n    \\\"holidays\\\"\\n    /* Other accounts in arbitrary order */\\n  ]\\n''\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"calendarAccountsOrder\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.thunderbird.profiles.<name>.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of ‹name› add-on packages to install for this profile.\\n\\nNote that it is necessary to manually enable extensions\\ninside ‹name› after the first installation.\\n\\nTo automatically enable extensions add\\n`\\\"extensions.autoDisableScopes\\\" = 0;`\\nto\\n[{option}`programs.thunderbird.profiles.<profile>.settings`](#opt-programs.thunderbird.profiles._name_.settings)\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  pkgs.some-thunderbird-extension\\n]\\n\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"extensions\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.thunderbird.profiles.<name>.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra preferences to add to {file}`user.js`.\\n\",\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.thunderbird.profiles.<name>.feedAccounts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of feed accounts. Feeds themselves have to be\\nmanaged through Thunderbird's settings. This option allows\\nfeeds to coexist with declaratively managed email accounts.\\n\",\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"feedAccounts\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.thunderbird.profiles.<name>.feedAccounts.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"This feed account's name.\",\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"feedAccounts\",\"<name>\",\"name\"],\"readOnly\":true,\"type\":\"string\"},\"programs.thunderbird.profiles.<name>.isDefault\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether this is a default profile. There must be exactly one\\ndefault profile.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"isDefault\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.thunderbird.profiles.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"This profile's name.\",\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"name\"],\"readOnly\":true,\"type\":\"string\"},\"programs.thunderbird.profiles.<name>.search\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Declarative search engine configuration.\",\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"search\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.thunderbird.profiles.<name>.search.default\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default search engine used in the address bar and search\\nbar.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ddg\\\"\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"search\",\"default\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.thunderbird.profiles.<name>.search.engines\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of search engine configurations. Engines that\\nonly have {var}`metaData` specified will be treated as builtin\\nto Thunderbird.\\n\\nSee [SearchEngine.jsm](https://searchfox.org/mozilla-central/rev/e3f42ec9320748b2aab3d474d1e47075def9000c/toolkit/components/search/SearchEngine.sys.mjs#890-923)\\nin Thunderbird's source for available options. We maintain a\\nmapping to let you specify all options in the referenced link\\nwithout underscores, but it may fall out of date with future\\noptions.\\n\\nNote, {var}`icon` is also a special option added by Home\\nManager to make it convenient to specify absolute icon paths.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  nix-packages = {\\n    name = \\\"Nix Packages\\\";\\n    urls = [{\\n      template = \\\"https://search.nixos.org/packages\\\";\\n      params = [\\n        { name = \\\"type\\\"; value = \\\"packages\\\"; }\\n        { name = \\\"query\\\"; value = \\\"{searchTerms}\\\"; }\\n      ];\\n    }];\\n\\n    icon = \\\"${pkgs.nixos-icons}/share/icons/hicolor/scalable/apps/nix-snowflake.svg\\\";\\n    definedAliases = [ \\\"@np\\\" ];\\n  };\\n\\n  nixos-wiki = {\\n    name = \\\"NixOS Wiki\\\";\\n    urls = [{ template = \\\"https://wiki.nixos.org/w/index.php?search={searchTerms}\\\"; }];\\n    iconMapObj.\\\"16\\\" = \\\"https://wiki.nixos.org/favicon.ico\\\";\\n    definedAliases = [ \\\"@nw\\\" ];\\n  };\\n\\n  bing.metaData.hidden = true;\\n  google.metaData.alias = \\\"@g\\\"; # builtin engines only support specifying one additional alias\\n}\\n\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"search\",\"engines\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (JSON value)\"},\"programs.thunderbird.profiles.<name>.search.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force replace the existing search\\nconfiguration. This is recommended since Thunderbird will\\nreplace the symlink for the search configuration on every\\nlaunch, but note that you'll lose any existing configuration\\nby enabling this.\\n\",\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"search\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.thunderbird.profiles.<name>.search.meta.maintainers\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of maintainers of each module.\\nThis option should be defined at most once per module.\\n\\nThe option value is not a list of maintainers, but an attribute set that maps module file names to lists of maintainers.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.maintainers.alice lib.maintainers.bob ]\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"search\",\"meta\",\"maintainers\"],\"readOnly\":false,\"type\":\"list of lib.maintainers\"},\"programs.thunderbird.profiles.<name>.search.meta.teams\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of team maintainers of each module.\\nThis option should be defined at most once per module.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.teams.acme lib.teams.haskell ]\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"search\",\"meta\",\"teams\"],\"readOnly\":false,\"type\":\"list of lib.teams\"},\"programs.thunderbird.profiles.<name>.search.order\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The order the search engines are listed in. Any engines that\\naren't included in this list will be listed after these in an\\nunspecified order.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"ddg\\\"\\n  \\\"google\\\"\\n]\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"search\",\"order\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.thunderbird.profiles.<name>.search.privateDefault\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default search engine used in the Private Browsing.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ddg\\\"\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"search\",\"privateDefault\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.thunderbird.profiles.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Preferences to add to this profile's\\n{file}`user.js`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"mail.spellcheck.inline\\\" = false;\\n  \\\"mailnews.database.global.views.global.columns\\\" = {\\n    selectCol = {\\n      ordinal = 1;\\n      visible = false;\\n    };\\n    threadCol = {\\n      ordinal = 2;\\n      visible = true;\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"Thunderbird preference (int, bool, string, and also attrs, list, float as a JSON string)\"},\"programs.thunderbird.profiles.<name>.userChrome\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom Thunderbird user chrome CSS.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  /* Hide tab bar in Thunderbird */\\n  #tabs-toolbar {\\n    visibility: collapse !important;\\n  }\\n''\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"userChrome\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.thunderbird.profiles.<name>.userContent\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom Thunderbird user content CSS.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  /* Hide scrollbar on Thunderbird pages */\\n  *{scrollbar-width:none !important}\\n''\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"userContent\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.thunderbird.profiles.<name>.withExternalGnupg\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Allow Thunderbird to use external GnuPG secret keys through\\nGPGME, as used by its documented smartcard and external-key\\nworkflow.\\n\\nThis installs `gpgme` and sets\\n`mail.openpgp.allow_external_gnupg`. Public keys and key\\nacceptance settings still live in Thunderbird's internal\\nOpenPGP key manager.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"thunderbird\",\"profiles\",\"<name>\",\"withExternalGnupg\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.thunderbird.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of Thunderbird preferences to be added to\\nall profiles.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"general.useragent.override\\\" = \\\"\\\";\\n  \\\"privacy.donottrackheader.enabled\\\" = true;\\n}\"},\"loc\":[\"programs\",\"thunderbird\",\"settings\"],\"readOnly\":false,\"type\":\"Thunderbird preference (int, bool, string, and also attrs, list, float as a JSON string)\"},\"programs.timidity.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/timidity.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/timidity.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable timidity, a software MIDI renderer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"timidity\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.timidity.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/timidity.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/timidity.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  soundfont ${pkgs.soundfont-fluid}/share/soundfonts/FluidR3_GM2-2.sf2\\n''\\n\"},\"loc\":[\"programs\",\"timidity\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.timidity.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/timidity.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/timidity.nix\"}],\"description\":\"Resulting package.\",\"loc\":[\"programs\",\"timidity\",\"finalPackage\"],\"readOnly\":true,\"type\":\"package\"},\"programs.timidity.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/timidity.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/timidity.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.timidity\"},\"description\":\"The timidity package to use.\",\"loc\":[\"programs\",\"timidity\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.tint2.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tint2.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tint2.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable tint2, a simple, unobtrusive and light panel for Xorg.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"tint2\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tint2.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tint2.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tint2.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Commands for tint2 that will be add to the {file}`tint2rc`\\nfile.\\n\",\"loc\":[\"programs\",\"tint2\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.tint2.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tint2.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tint2.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.tint2\"},\"description\":\"The tint2 package to use.\",\"loc\":[\"programs\",\"tint2\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.tiny.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tiny.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tiny.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable tiny, a TUI IRC client written in Rust.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"tiny\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tiny.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tiny.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tiny.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.tiny\"},\"description\":\"The tiny package to use.\",\"loc\":[\"programs\",\"tiny\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.tiny.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tiny.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tiny.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/tiny/config.yml`. See\\n<https://github.com/osa1/tiny/blob/master/crates/tiny/config.yml>\\nfor the default configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  servers = [\\n    {\\n      addr = \\\"irc.libera.chat\\\";\\n      port = 6697;\\n      tls = true;\\n      realname = \\\"John Doe\\\";\\n      nicks = [ \\\"tinyuser\\\" ];\\n    }\\n  ];\\n  defaults = {\\n    nicks = [ \\\"tinyuser\\\" ];\\n    realname = \\\"John Doe\\\";\\n    join = [];\\n    tls = true;\\n  };\\n};\\n\"},\"loc\":[\"programs\",\"tiny\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.tirith.allowlist\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tirith.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tirith.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of allowed domains that bypass Tirith analysis.\\nWritten to `$XDG_CONFIG_HOME/tirith/allowlist`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"localhost\\\"\\n]\"},\"loc\":[\"programs\",\"tirith\",\"allowlist\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.tirith.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tirith.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tirith.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Tirith, a shell security monitor.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"tirith\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tirith.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tirith.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tirith.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"tirith\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tirith.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tirith.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tirith.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"tirith\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tirith.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tirith.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tirith.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"tirith\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tirith.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tirith.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tirith.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.tirith\"},\"description\":\"The tirith package to use.\",\"loc\":[\"programs\",\"tirith\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.tirith.policy\":{\"declarations\":[