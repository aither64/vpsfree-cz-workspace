s://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kakoune.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines to add to\\n{file}`$XDG_CONFIG_HOME/kak/kakrc`.\\n\",\"loc\":[\"programs\",\"kakoune\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.kakoune.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kakoune.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kakoune.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Resulting customized kakoune package.\",\"loc\":[\"programs\",\"kakoune\",\"finalPackage\"],\"readOnly\":true,\"type\":\"null or package\"},\"programs.kakoune.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kakoune.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kakoune.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.kakoune-unwrapped\"},\"description\":\"The kakoune-unwrapped package to use.\",\"loc\":[\"programs\",\"kakoune\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.kakoune.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kakoune.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kakoune.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of kakoune plugins to install. To get a list of\\nsupported plugins run:\\n{command}`nix-env -f '<nixpkgs>' -qaP -A kakounePlugins`.\\n\\nRequires `package` to not be set to have effect.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.kakounePlugins.kak-fzf ]\"},\"loc\":[\"programs\",\"kakoune\",\"plugins\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.keepassxc.autostart\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keepassxc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keepassxc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to start KeePassXC automatically on login through the XDG autostart mechanism.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"keepassxc\",\"autostart\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.keepassxc.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keepassxc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keepassxc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable KeePassXC.\\n\\n::: {.note}\\nWhen this flag is set, KeePassXC' builtin native messaging manifest for\\ncommunication with its browser extension is automatically installed.\\nThis conflicts with KeePassXC' builtin installation mechanism. To\\nprevent error messages, either set\\n{option}`programs.keepassxc.settings.Browser.UpdateBinaryPath` to\\n`false`, or untick the checkbox\\n\\n  Application Settings/\\n    Browser Integration/\\n      Advanced/\\n        Update native messaging manifest files at startup\\n\\nin the GUI.\\n:::\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"keepassxc\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.keepassxc.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keepassxc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keepassxc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.keepassxc\"},\"description\":\"The keepassxc package to use.\",\"loc\":[\"programs\",\"keepassxc\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.keepassxc.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keepassxc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keepassxc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/keepassxc/keepassxc.ini`.\\n\\nSee <https://github.com/keepassxreboot/keepassxc/blob/develop/src/core/Config.cpp>\\nfor the full list of options.\\n\\n::: {.note}\\nWhen the settings are non-empty, the configuration file will be linked\\ninto the Nix store and KeePassXC will report an access error for its\\nconfiguration file. This is expected and can not be fixed in a way that\\naligns with Home Manager's principles. See [#8257](https://github.com/nix-community/home-manager/issues/8257) for more details.\\n:::\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  Browser = {\\n    Enabled = true;\\n  };\\n  GUI = {\\n    AdvancedSettings = true;\\n    ApplicationTheme = \\\"dark\\\";\\n    CompactMode = true;\\n    HidePasswords = true;\\n  };\\n  SSHAgent = {\\n    Enabled = true;\\n  };\\n}\"},\"loc\":[\"programs\",\"keepassxc\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.keychain.agents\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keychain.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keychain.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Agents to add.\\n\",\"loc\":[\"programs\",\"keychain\",\"agents\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.keychain.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keychain.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keychain.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable keychain.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"keychain\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.keychain.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keychain.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keychain.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"keychain\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.keychain.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keychain.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keychain.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"keychain\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.keychain.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keychain.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keychain.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"keychain\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.keychain.enableXsessionIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keychain.nix>\",\"url\":\"