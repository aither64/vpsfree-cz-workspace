":{\"_type\":\"literalExpression\",\"text\":\"{\\n  line_length_guide = [\\n    80\\n    100\\n  ];\\n  line_wrapping = true;\\n  open_mode = {\\n    exclusions = [\\n      \\\"**/.git\\\"\\n      \\\"**/.svn\\\"\\n    ];\\n  };\\n  soft_tabs = true;\\n  tab_width = 2;\\n  theme = \\\"solarized_dark\\\";\\n}\"},\"loc\":[\"programs\",\"amp\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.andcli.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/andcli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/andcli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable andcli.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"andcli\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.andcli.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/andcli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/andcli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.andcli\"},\"description\":\"The andcli package to use.\",\"loc\":[\"programs\",\"andcli\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.andcli.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/andcli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/andcli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for andcli. All the details can be found here:\\n<https://github.com/tjblackheart/andcli/blob/7de13cc933eeb23d53558f76fefef226bd531c2c/internal/config/config.go#L16>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  options = {\\n    show_tokens = true;\\n    show_usernames = false;\\n  };\\n}\"},\"loc\":[\"programs\",\"andcli\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.animdl.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/animdl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/animdl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable animdl.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"animdl\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.animdl.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/animdl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/animdl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.animdl\"},\"description\":\"The animdl package to use.\",\"loc\":[\"programs\",\"animdl\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.animdl.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/animdl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/animdl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for animdl. All the available options can be found here:\\n<https://github.com/justfoolingaround/animdl?tab=readme-ov-file#configurations>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  default_player = \\\"mpv\\\";\\n  default_provider = \\\"animixplay\\\";\\n  ffmpeg = {\\n    executable = \\\"ffmpeg\\\";\\n    hls_download = false;\\n    submerge = true;\\n  };\\n  quality_string = \\\"best[subtitle]/best\\\";\\n  site_urls = {\\n    animixplay = \\\"https://www.animixplay.to/\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"animdl\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.anime-downloader.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anime-downloader.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anime-downloader.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable anime-downloader.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"anime-downloader\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.anime-downloader.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anime-downloader.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anime-downloader.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.anime-downloader\"},\"description\":\"The anime-downloader package to use.\",\"loc\":[\"programs\",\"anime-downloader\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.anime-downloader.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anime-downloader.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anime-downloader.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for anime-downloader. All available options can be found here:\\n<https://anime-downlader.readthedocs.io/en/latest/usage/config.html#config-json>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  dl = {\\n    aria2c_for_torrents = false;\\n    chunk_size = \\\"10\\\";\\n    download_dir = \\\".\\\";\\n    external_downloader = \\\"{aria2}\\\";\\n    fallback_qualities = [\\n      \\\"720p\\\"\\n      \\\"480p\\\"\\n      \\\"360p\\\"\\n    ];\\n    file_format = \\\"{anime_title}/{anime_title}_{ep_no}\\\";\\n    force_download = false;\\n    player = null;\\n    provider = \\\"twist.moe\\\";\\n    quality = \\\"1080p\\\";\\n    skip_download = false;\\n    url = false;\\n  };\\n}\"},\"loc\":[\"programs\",\"anime-downloader\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.anki.addons\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Anki add-on packages to install.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  # When the add-on is already available in nixpkgs\\n  pkgs.ankiAddons.anki-connect\\n\\n  # When the add-on is not available in nixpkgs\\n  (pkgs.anki-utils.buildAnkiAddon (finalAttrs: {\\n    pname = \\\"recolor\\\";\\n    version = \\\"3.1\\\";\\n    src = pkgs.fetchFromGitHub {\\n      owner = \\\"AnKing-VIP\\\";\\n      repo = \\\"AnkiRecolor\\\";\\n      rev = finalAttrs.version;\\n      sparseCheckout = [ \\\"src/addon\\\" ];\\n      hash = \\\"sha256-28DJq2l9DP8O6OsbNQCZ0pm4S6CQ3Yz0Vfvlj+iQw8Y=\\\";\\n    };\\n    sourceRoot = \\\"${finalAttrs.src.name}/src/addon\\\";\\n  }))\\n\\n  # When the add-on needs to be configured\\n  pkgs.ankiAddons.passfail2.withConfig {\\n    config = {\\n      again_button_name = \\\"not quite\\\";\\n      good_button_name = \\\"excellent\\\";\\n      toggle_names_textcolors = 1;\\n    };\\n    user_files = ./dir-to-be-merged-into-addon-user-files-dir;\\n  };\\n]\\n\"},\"loc\":[\"programs\",\"anki\",\"addons\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.anki.answerKeys\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Overrides for choosing what keyboard shortcut activates each\\nanswer button. The Anki default will be used for ones without an\\noverride defined.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    ease = 1;\\n    key = \\\"left\\\";\\n  }\\n  {\\n    ease = 2;\\n    key = \\\"up\\\";\\n  }\\n  {\\n    ease = 3;\\n    key = \\\"right\\\";\\n  }\\n  {\\n    ease = 4;\\n    key = \\\"down\\\";\\n  }\\n]\"},\"loc\":[\"programs\",\"anki\",\"answerKeys\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.anki.answerKeys.*.ease\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"description\":\"Number associated with an answer button.\\n\\nBy default, 1 = Again, 2 = Hard, 3 = Good, and 4 = Easy.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"3\"},\"loc\":[\"programs\",\"anki\",\"answerKeys\",\"*\",\"ease\"],\"readOnly\":false,\"type\":\"signed integer\"},\"programs.anki.answerKeys.*.key\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"description\":\"Keyboard shortcut for this answer button. The shortcut should be in\\nthe string format used by <https://doc.qt.io/qt-6/qkeysequence.html>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"3\\\"\"},\"loc\":[\"programs\",\"anki\",\"answerKeys\",\"*\",\"key\"],\"readOnly\":false,\"type\":\"string\"},\"programs.anki.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Anki.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"anki\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.anki.hideBottomBar\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Hide bottom bar during review.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"anki\",\"hideBottomBar\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.anki.hideBottomBarMode\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"When to hide the bottom bar when `hideBottomBar` is enabled.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fullscreen\\\"\"},\"loc\":[\"programs\",\"anki\",\"hideBottomBarMode\"],\"readOnly\":false,\"type\":\"null or one of \\\"fullscreen\\\", \\\"always\\\"\"},\"programs.anki.hideTopBar\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Hide top bar during review.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"anki\",\"hideTopBar\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.anki.hideTopBarMode\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"When to hide the top bar when `hideTopBar` is enabled.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fullscreen\\\"\"},\"loc\":[\"programs\",\"anki\",\"hideTopBarMode\"],\"readOnly\":false,\"type\":\"null or one of \\\"fullscreen\\\", \\\"always\\\"\"},\"programs.anki.language\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"en_US\\\"\"},\"description\":\"Display language. Should be an underscore separated language tag.\\nSee <https://github.com/ankitects/anki/blob/main/pylib/anki/lang.py> for\\nsupported tags.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ja_JP\\\"\"},\"loc\":[\"programs\",\"anki\",\"language\"],\"readOnly\":false,\"type\":\"non-empty string\"},\"programs.anki.legacyImportExport\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Use legacy (pre 2.1.55) import/export handling code.\",\"loc\":[\"programs\",\"anki\",\"legacyImportExport\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.anki.minimalistMode\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Minimalist user interface mode.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"anki\",\"minimalistMode\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.anki.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.anki\"},\"description\":\"The anki package to use.\",\"loc\":[\"programs\",\"anki\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.anki.profiles\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"User 1\\\" = { };\\n}\"},\"description\":\"Anki profiles and their settings.\\nProfiles are primarily intended to be one per person, and are not recommended for splitting up your own content.\\n\",\"loc\":[\"programs\",\"anki\",\"profiles\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.anki.profiles.<name>.default\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Open this profile on startup.\",\"loc\":[\"programs\",\"anki\",\"profiles\",\"<name>\",\"default\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.anki.profiles.<name>.sync.autoSync\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Automatically sync on profile open/close.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"anki\",\"profiles\",\"<name>\",\"sync\",\"autoSync\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.anki.profiles.<name>.sync.autoSyncMediaMinutes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Automatically sync media every X minutes. Set this to 0 to disable\\nperiodic media syncing.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"15\"},\"loc\":[\"programs\",\"anki\",\"profiles\",\"<name>\",\"sync\",\"autoSyncMediaMinutes\"],\"readOnly\":false,\"type\":\"null or (unsigned integer, meaning >=0)\"},\"programs.anki.profiles.<name>.sync.keyFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to a file containing the sync account sync key. This is different from\\nthe account password.\\n\\nTo get the sync key, follow these steps:\\n\\n- Enable this Home Manager module: `programs.anki.enable = true`\\n- Open Anki.\\n- Navigate to the sync settings page. (Tools > Preferences > Syncing)\\n- Log in to your AnkiWeb account.\\n- Select \\\"Yes\\\" to the prompt about saving preferences and syncing.\\n- A Home Manager warning prompt will show. Select \\\"Show details...\\\".\\n- Get your sync key from the message: \\\"syncKey changed from \\\\`None\\\\` to \\\\`<YOUR SYNC KEY WILL BE HERE>\\\\`\\\"\\n\",\"loc\":[\"programs\",\"anki\",\"profiles\",\"<name>\",\"sync\",\"keyFile\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.anki.profiles.<name>.sync.networkTimeout\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Network timeout in seconds (clamped between 30 and 99999).\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"60\"},\"loc\":[\"programs\",\"anki\",\"profiles\",\"<name>\",\"sync\",\"networkTimeout\"],\"readOnly\":false,\"type\":\"null or (unsigned integer, meaning >=0)\"},\"programs.anki.profiles.<name>.sync.syncMedia\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Synchronize audio and images too.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"anki\",\"profiles\",\"<name>\",\"sync\",\"syncMedia\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.anki.profiles.<name>.sync.url\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Custom sync server URL. See <https://docs.ankiweb.net/sync-server.html>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"http://example.com/anki-sync/\\\"\"},\"loc\":[\"programs\",\"anki\",\"profiles\",\"<name>\",\"sync\",\"url\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.anki.profiles.<name>.sync.username\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Sync account username.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"lovelearning@email.com\\\"\"},\"loc\":[\"programs\",\"anki\",\"profiles\",\"<name>\",\"sync\",\"username\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.anki.profiles.<name>.sync.usernameFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to a file containing the sync account username.\",\"loc\":[\"programs\",\"anki\",\"profiles\",\"<name>\",\"sync\",\"usernameFile\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.anki.reduceMotion\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/anki>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/anki\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"descri