uilder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","checkPhase":"# logrotate --debug also checks that users specified in config\n# file exist, but we only have sandboxed users here so brown these\n# out. according to man page that means su, create and createolddir.\n# files required to exist also won't be present, so missingok is forced.\nuser=$(/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/id -un)\ngroup=$(/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/id -gn)\nsed -E -e \"s/\\bsu\\s.*/su $user $group/\" \\\n       -e \"s/\\b((create|createolddir)\\b(\\s+[0-9]+)?).*/\\1 $user $group/\" \\\n       -e \"1imissingok\" -e \"s/\\bnomissingok\\b//\" \\\n    $out > logrotate.conf\n# Since this makes for very verbose builds only show real error.\n# There is no way to control log level, but logrotate hardcodes\n# 'error:' at common log level, so we can use grep, taking care\n# to keep error codes\nset -o pipefail\nif ! /nix/store/dhmd7w654dbxkrgcx2pnc2sv47k3bz8w-logrotate-3.22.0/sbin/logrotate -s logrotate.status \\\n                --debug logrotate.conf 2>&1 \\\n            | ( ! grep \"error:\" ) > logrotate-error; then\n        echo \"Logrotate configuration check failed.\"\n        echo \"The failing configuration (after adjustments to pass tests in sandbox) was:\"\n        printf \"%s\\n\" \"-------\"\n        cat logrotate.conf\n        printf \"%s\\n\" \"-------\"\n        echo \"The error reported by logrotate was as follow:\"\n        printf \"%s\\n\" \"-------\"\n        cat logrotate-error\n        printf \"%s\\n\" \"-------\"\n        echo \"You can disable this check with services.logrotate.checkConfig = false,\"\n        echo \"but if you think it should work please report this failure along with\"\n        echo \"the config file being tested!\"\n        false\nfi\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"","mesonFlags":"","name":"logrotate.conf","nativeBuildInputs":"","out":"/nix/store/19l3bx0zc24ppmbxhvgmp9s89rfycafr-logrotate.conf","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"weekly\nmissingok\nnotifempty\nrotate 4\n\n\"/var/log/btmp\" {\n  create 0660 root utmp\n  monthly\n  minsize 1M\n  rotate 1\n}\n\n\"/var/log/wtmp\" {\n  create 0664 root utmp\n  monthly\n  minsize 1M\n  rotate 1\n}\n\n\"/var/log/nginx/*.log\" {\n  compress\n  delaycompress\n  weekly\n  postrotate\n    [ ! -f /var/run/nginx/nginx.pid ] || kill -USR1 `cat /var/run/nginx/nginx.pid`\n  endscript\n  rotate 26\n  su nginx nginx\n}\n\n\"/var/log/messages\"\n\"/var/log/warn\"\n\"/var/log/mail\"\n\"/var/log/dhcpd\" {\n  compress\n  create\n  nodateext\n  delaycompress\n  daily\n  maxsize 100M\n  missingok\n  notifempty\n  postrotate\n    /nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/bin/systemctl kill --kill-whom=main --signal=HUP syslog.service\n\n  endscript\n  rotate 14\n  sharedscripts\n}\n"},"inputs":{"drvs":{"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}