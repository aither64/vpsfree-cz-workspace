me liblapacke.so.3 $out/lib/liblapacke.so.3\npatchelf --set-rpath \"$(patchelf --print-rpath $out/lib/liblapacke.so.3):/nix/store/nlg0vijaii4b4h8y5z407fsadf8z36ds-openblas-0.3.33/lib\" $out/lib/liblapacke.so.3\n\n  if [ -f \"$out/lib/liblapacke.so.3\" ]; then\n    ln -s $out/lib/liblapacke.so.3 $out/lib/liblapacke.so\n  fi\n\n  cp /nix/store/jh0jb7q3n7xpdsaq4kv2mr6cp1x0s7lj-liblapack-3.12.1/include/lapacke{,_mangling,_config,_utils}.h $dev/include\n\n  cat <<EOF > $dev/lib/pkgconfig/lapacke.pc\nName: lapacke\nVersion: 3\nDescription: LAPACK C implementation\nCflags: -I$dev/include\nLibs: -L$out/lib -llapacke\nEOF\n","mesonFlags":"","name":"lapack-3","nativeBuildInputs":"","out":"/nix/store/0i3nsd1ifv7frfhif4nxcpj0kbnhf0b9-lapack-3","outputs":"out dev","patches":"","pname":"lapack","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","unpackPhase":"src=$PWD","version":"3"},"inputs":{"drvs":{"1j42gmjfx984ws3iv5jw15jwjwyvww1y-liblapack-3.12.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"i4k8vffg2d1qblx4lqi3sr0ni3ikp4w6-openblas-0.3.33.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"lapack-3","outputs":{"dev":{"path":"qdvf5rsmrbk2xmcmcnc9dja4p2ymqbsh-lapack-3-dev"},"out":{"path":"0i3nsd1ifv7frfhif4nxcpj0kbnhf0b9-lapack-3"}},"system":"x86_64-linux","version":4},"gfw3zi66q4q43574pw23is9licl3jh3n-crate-autocfg-1.5.0.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/p