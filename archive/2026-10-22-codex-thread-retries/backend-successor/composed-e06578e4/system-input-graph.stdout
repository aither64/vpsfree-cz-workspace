ion\",\"text\":\"false\"},\"description\":\"Whether to enable quickshell, a flexible QtQuick-based desktop shell toolkit..\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"quickshell\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.quickshell.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/quickshell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/quickshell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.quickshell\"},\"description\":\"The quickshell package to use.\",\"loc\":[\"programs\",\"quickshell\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.quickshell.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/quickshell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/quickshell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable quickshell systemd service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"quickshell\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.quickshell.systemd.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/quickshell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/quickshell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.wayland.systemd.target\"},\"description\":\"The systemd target that will automatically start quickshell.\\n\\nIf you set this to a WM-specific target, make sure that systemd integration for that WM is enabled (e.g. `wayland.windowManager.hyprland.systemd.enable`). **This is typically true by default**.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"hyprland-session.target\\\"\"},\"loc\":[\"programs\",\"quickshell\",\"systemd\",\"target\"],\"readOnly\":false,\"type\":\"string\"},\"programs.qutebrowser.aliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Aliases for commands.\\n\",\"loc\":[\"programs\",\"qutebrowser\",\"aliases\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.qutebrowser.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable qutebrowser.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"qutebrowser\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.qutebrowser.enableDefaultBindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Disable to prevent loading default key bindings.\\n\",\"loc\":[\"programs\",\"qutebrowser\",\"enableDefaultBindings\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.qutebrowser.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra lines added to qutebrowser {file}`config.py` file.\\n\",\"loc\":[\"programs\",\"qutebrowser\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.qutebrowser.greasemonkey\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Greasemonkey userscripts to add to qutebrowser's {file}`greasemonkey`\\ndirectory.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  (pkgs.fetchurl {\\n    url = \\\"https://raw.githubusercontent.com/afreakk/greasemonkeyscripts/1d1be041a65c251692ee082eda64d2637edf6444/youtube_sponsorblock.js\\\";\\n    sha256 = \\\"sha256-e3QgDPa3AOpPyzwvVjPQyEsSUC9goisjBUDMxLwg8ZE=\\\";\\n  })\\n  (pkgs.writeText \\\"some-script.js\\\" ''\\n    // ==UserScript==\\n    // @name  Some Greasemonkey script\\n    // ==/UserScript==\\n  '')\\n]\\n\"},\"loc\":[\"programs\",\"qutebrowser\",\"greasemonkey\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.qutebrowser.keyBindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Key bindings mapping keys to commands in different modes. This setting\\nis a dictionary containing mode names and dictionaries mapping keys to\\ncommands: `{mode: {key: command}}` If you want to map\\na key to another key, check the `keyMappings` setting\\ninstead. For modifiers, you can use either `-` or\\n`+` as delimiters, and these names:\\n\\nControl\\n: `Control`, `Ctrl`\\n\\nMeta\\n: `Meta`, `Windows`, `Mod4`\\n\\nAlt\\n: `Alt`, `Mod1`\\n\\nShift\\n: `Shift`\\n\\nFor simple keys (no `<>`-signs), a capital\\nletter means the key is pressed with Shift. For special keys (with\\n`<>`-signs), you need to explicitly add\\n`Shift-` to match a key pressed with shift. If you\\nwant a binding to do nothing, bind it to the `nop`\\ncommand. If you want a default binding to be passed through to the\\nwebsite, bind it to null. Note that some commands which are only useful\\nfor bindings (but not used interactively) are hidden from the command\\ncompletion. See `:help` for a full list of available\\ncommands. The following modes are available:\\n\\n`normal`\\n: Default mode, where most commands are invoked.\\n\\n`insert`\\n: Entered when an input field is focused on a website, or by\\n  pressing `i` in normal mode. Passes through almost all keypresses\\n  to the website, but has some bindings like\\n  `<Ctrl-e>` to open an external editor.\\n  Note that single keys can't be bound in this mode.\\n\\n`hint`\\n: Entered when `f` is pressed to select links with the keyboard. Note\\n  that single keys can't be bound in this mode.\\n\\n`passthrough`\\n: Similar to insert mode, but passes through all keypresses except\\n  `<Escape>` to leave the mode. It might be\\n  useful to bind `<Escape>` to some other\\n  key in this mode if you want to be able to send an Escape key to\\n  the website as well. Note that single keys can't be bound in this\\n  mode.\\n\\n`command`\\n: Entered when pressing the `:` key in order to enter a command. Note\\n  that single keys can't be bound in this mode.\\n\\n`prompt`\\n: Entered when there's a prompt to display, like for download\\n  locations or when invoked from JavaScript.\\n\\n`yesno`\\n: Entered when there's a yes/no prompt displayed.\\n\\n`caret`\\n: Entered when pressing the `v` mode, used to select text using the\\n  keyboard.\\n\\n`register`\\n: Entered when qutebrowser is waiting for a register name/key for\\n  commands like `:set-mark`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  normal = {\\n    \\\"<Ctrl-v>\\\" = \\\"spawn mpv {url}\\\";\\n    \\\",p\\\" = \\\"spawn --userscript qute-pass\\\";\\n    \\\",l\\\" = ''config-cycle spellcheck.languages [\\\"en-GB\\\"] [\\\"en-US\\\"]'';\\n    \\\"<F1>\\\" = mkMerge [\\n      \\\"config-cycle tabs.show never always\\\"\\n      \\\"config-cycle statusbar.show in-mode always\\\"\\n      \\\"config-cycle scrolling.bar never always\\\"\\n    ];\\n  };\\n  prompt = {\\n    \\\"<Ctrl-y>\\\" = \\\"prompt-yes\\\";\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"qutebrowser\",\"keyBindings\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (null or strings concatenated with \\\" ;; \\\")\"},\"programs.qutebrowser.keyMappings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"This setting can be used to map keys to other keys. When the key used\\nas dictionary-key is pressed, the binding for the key used as\\ndictionary-value is invoked instead. This is useful for global\\nremappings of keys, for example to map Ctrl-[ to Escape. Note that when\\na key is bound (via `bindings.default` or\\n`bindings.commands`), the mapping is ignored.\\n\",\"loc\":[\"programs\",\"qutebrowser\",\"keyMappings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.qutebrowser.loadAutoconfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Load settings configured via the GUI.\\n\",\"loc\":[\"programs\",\"qutebrowser\",\"loadAutoconfig\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.qutebrowser.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.qutebrowser\"},\"description\":\"The qutebrowser package to use.\",\"loc\":[\"programs\",\"qutebrowser\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.qutebrowser.perDomainSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options to set, as in `settings` but per domain.\\nRefer to {option}`settings` for details.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"zoom.us\\\" = {\\n    content = {\\n      autoplay = true;\\n      media.audio_capture = true;\\n      media.video_capture = true;\\n    };\\n  };\\n  \\\"github.com\\\".colors.webpage.darkmode.enabled = false;\\n};\\n\"},\"loc\":[\"programs\",\"qutebrowser\",\"perDomainSettings\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.qutebrowser.quickmarks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Quickmarks to add to qutebrowser's {file}`quickmarks` file.\\nNote that when Home Manager manages your quickmarks, you cannot edit them at runtime.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  nixpkgs = \\\"https://github.com/NixOS/nixpkgs\\\";\\n  home-manager = \\\"https://github.com/nix-community/home-manager\\\";\\n}\\n\"},\"loc\":[\"programs\",\"qutebrowser\",\"quickmarks\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.qutebrowser.searchEngines\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Search engines that can be used via the address bar. Maps a search\\nengine name (such as `DEFAULT`, or\\n`ddg`) to a URL with a `{}`\\nplaceholder. The placeholder will be replaced by the search term, use\\n`{{` and `}}` for literal\\n`{/}` signs. The search engine named\\n`DEFAULT` is used when\\n`url.auto_search` is turned on and something else than\\na URL was entered to be opened. Other search engines can be used by\\nprepending the search engine name to the search term, for example\\n`:open google qutebrowser`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  w = \\\"https://en.wikipedia.org/wiki/Special:Search?search={}&go=Go&ns0=1\\\";\\n  aw = \\\"https://wiki.archlinux.org/?search={}\\\";\\n  nw = \\\"https://wiki.nixos.org/index.php?search={}\\\";\\n  g = \\\"https://www.google.com/search?hl=en&q={}\\\";\\n}\\n\"},\"loc\":[\"programs\",\"qutebrowser\",\"searchEngines\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.qutebrowser.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qutebrowser.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qutebrowser.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options to add to qutebrowser {file}`config.py` file.\\nSee <https://qutebrowser.org/doc/help/settings.html>\\nfor options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  colors = {\\n    hints = {\\n      bg = \\\"#000000\\\";\\n      fg = \\\"#ffffff\\\";\\n    };\\n    tabs.bar.bg = \\\"#000000\\\";\\n  };\\n  tabs.tabs_are_windows = true;\\n}\\n\"},\"loc\":[\"programs\",\"qutebrowser\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.radicle.cli.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.radicle-node\"},\"description\":\"The radicle-node package to use.\",\"loc\":[\"programs\",\"radicle\",\"cli\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.radicle.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Radicle.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"radicle\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.radicle.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Radicle configuration, written to `~/.radicle/config.json.\",\"loc\":[\"programs\",\"radicle\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (JSON value)\"},\"programs.radicle.settings.node.alias\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.home.username\"},\"description\":\"Human readable alias for your node.\\n\\nWhen running 'rad auth' for the first time, you need to use the exact same alias,\\notherwise 'rad auth' will fail because it cannot write the configuration\\nfile in your home directory (which is generated by nix).\\n\",\"loc\":[\"programs\",\"radicle\",\"settings\",\"node\",\"alias\"],\"readOnly\":false,\"type\":\"string\"},\"programs.radicle.settings.node.listen\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Addresses to bind to and listen for inbound connections.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"127.0.0.1:58776\\\"\\n]\"},\"loc\":[\"programs\",\"radicle\",\"settings\",\"node\",\"listen\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.radicle.settings.publicExplorer\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"https://app.radicle.xyz/nodes/$host/$rid$path\\\"\"},\"description\":\"HTTPS URL pattern used to generate links to view content on Radicle via the browser.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"https://radicle.example.com/nodes/seed.example.com/$rid$path\\\"\"},\"loc\":[\"programs\",\"radicle\",\"settings\",\"publicExplorer\"],\"readOnly\":false,\"type\":\"string\"},\"programs.radicle.uri.rad.browser.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"`true` if a suitable public explorer is detected.\\\"\"},\"description\":\"Whether to enable `rad:`-URI handling by web browser\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"radicle\",\"uri\",\"rad\",\"browser\",\"enable\"],\"readOnly\":false,\"type\":\"unspecified value\"},\"programs.radicle.uri.rad.browser.preferredNode\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"iris.radicle.xyz\\\"\"},\"description\":\"The hostname of an instance of `radicle-node`, reachable via HTTPS.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"radicle-node.example.com\\\"\"},\"loc\":[\"programs\",\"radicle\",\"uri\",\"rad\",\"browser\",\"preferredNode\"],\"readOnly\":false,\"type\":\"string\"},\"programs.radicle.uri.rad.vscode.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable `rad:`-URI handling by VSCode.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"radicle\",\"uri\",\"rad\",\"vscode\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.radicle.uri.rad.vscode.extension\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"radicle-ide-plugins-team.radicle\\\"\"},\"description\":\"The unique identifier of the VSCode extension that should handle `rad:`-URIs.\",\"loc\":[\"programs\",\"radicle\",\"uri\",\"rad\",\"vscode\",\"extension\"],\"readOnly\":false,\"type\":\"string\"},\"programs.radicle.uri.web-rad.browser\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Automatically detected browser.\\\"\"},\"description\":\"Name of the XDG Desktop Entry for your browser.\\nLibreWolf, Firefox and Chromium configured via home-manager will\\nbe detected automatically. The value of this option should likely\\nbe the same as the output of\\n`xdg-mime query default x-scheme-handler/https`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"brave.desktop\\\"\"},\"loc\":[\"programs\",\"radicle\",\"uri\",\"web-rad\",\"browser\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.radicle.uri.web-rad.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radicle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radicle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable `web+rad:`-URI handling by web browser.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"radicle\",\"uri\",\"web-rad\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.radio-active.aliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radio-active.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radio-active.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Key/value pairs where the key is name of radio station and value is URL.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"Deep House Lounge\\\" = \\\"http://198.15.94.34:8006/stream\\\";\\n}\"},\"loc\":[\"programs\",\"radio-active\",\"aliases\"],\"readOnly\":false,\"type\":\"attribute set of non-empty string\"},\"programs.radio-active.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radio-active.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radio-active.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Enable installing radio-active and writing configuration file.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"radio-active\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.radio-active.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radio-active.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radio-active.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.radio-active\"},\"description\":\"The radio-active package to use.\",\"loc\":[\"programs\",\"radio-active\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.radio-active.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radio-active.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radio-active.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Declare-able configurations for radio-active written to\\n{file}`$XDG_CONFIG_HOME/radio-active/configs.ini`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  filepath = \\\"/home/{user}/recordings/radioactive/\\\";\\n  filetype = \\\"mp3\\\";\\n  filter = \\\"none\\\";\\n  limit = 41;\\n  loglevel = \\\"debug\\\";\\n  player = \\\"ffplay\\\";\\n  sort = \\\"votes\\\";\\n  volume = 68;\\n}\"},\"loc\":[\"programs\",\"radio-active\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (non-empty string or (nonnegative integer or floating point number, meaning >=0))\"},\"programs.radio-cli.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radio-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/radio-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable radio-cli.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"radio-cli\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.radio-cli.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/radio-cli.nix>\",\"url\":\"https://github.com/nix-community/