h.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/bluetuith.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.bluetuith\"},\"description\":\"The bluetuith package to use.\",\"loc\":[\"programs\",\"bluetuith\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.bluetuith.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/bluetuith.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/bluetuith.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/bluetuith/bluetuith.conf`.\\n\\nSee <https://bluetuith-org.github.io/bluetuith/Configuration.html> for\\ndetails.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  adapter = \\\"hci0\\\";\\n  keybindings = {\\n    Menu = \\\"Alt+m\\\";\\n  };\\n  receive-dir = \\\"/home/user/files\\\";\\n  theme = {\\n    Adapter = \\\"red\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"bluetuith\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.borgmatic.backups\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/borgmatic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/borgmatic.nix\"}],\"description\":\"Borgmatic allows for several named backup configurations,\\neach with its own source directories and repositories.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  personal = {\\n    location = {\\n      sourceDirectories = [ \\\"/home/me/personal\\\" ];\\n      repositories = [ \\\"ssh://myuser@myserver.com/./personal-repo\\\" ];\\n    };\\n  };\\n  work = {\\n    location = {\\n      sourceDirectories = [ \\\"/home/me/work\\\" ];\\n      repositories = [ \\\"ssh://myuser@myserver.com/./work-repo\\\" ];\\n    };\\n  };\\n};\\n\"},\"loc\":[\"programs\",\"borgmatic\",\"backups\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.borgmatic.backups.<name>.consistency.checks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/borgmatic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/borgmatic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Consistency checks to run\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    name = \\\"repository\\\";\\n    frequency = \\\"2 weeks\\\";\\n  }\\n  {\\n    name = \\\"archives\\\";\\n    frequency = \\\"4 weeks\\\";\\n  }\\n  {\\n    name = \\\"data\\\";\\n    frequency = \\\"6 weeks\\\";\\n  }\\n  {\\n    name = \\\"extract\\\";\\n    frequency = \\\"6 weeks\\\";\\n  }\\n];\\n\"},\"loc\":[\"programs\",\"borgmatic\",\"backups\",\"<name>\",\"consistency\",\"checks\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.borgmatic.backups.<name>.consistency.checks.*.frequency\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/borgmatic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/borgmatic.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Frequency of this type of check\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"2 weeks\\\"\"},\"loc\":[\"programs\",\"borgmatic\",\"backups\",\"<name>\",\"consistency\",\"checks\",\"*\",\"frequency\"],\"readOnly\":false,\"type\":\"null or string matching the pattern ([[:digit:]]+ .*)|always\"},\"programs.borgmatic.backups.<name>.consistency.checks.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/borgmatic.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/borgmatic.nix\"}],\"description\":\"Name of consistency check to run.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"repository\\\"\"},\"loc\":[\"programs\",\"borgmatic\",\"b