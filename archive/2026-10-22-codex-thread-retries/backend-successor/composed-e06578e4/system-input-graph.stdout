ion is null\\nthen `source` must be set.\\n\",\"loc\":[\"programs\",\"gradle\",\"initScripts\",\"<name>\",\"text\"],\"readOnly\":false,\"type\":\"null or strings concatenated with \\\"\\\\n\\\"\"},\"programs.gradle.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gradle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gradle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gradle\"},\"description\":\"The gradle package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gradle_7\"},\"loc\":[\"programs\",\"gradle\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.gradle.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gradle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gradle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Key value pairs to write to {file}`gradle.properties` in the Gradle\\nhome directory.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"org.gradle.caching\\\" = true;\\n  \\\"org.gradle.parallel\\\" = true;\\n  \\\"org.gradle.jvmargs\\\" = \\\"-XX:MaxMetaspaceSize=384m\\\";\\n  \\\"org.gradle.home\\\" = pkgs.jdk17;\\n};\\n\"},\"loc\":[\"programs\",\"gradle\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of (string, package, bool, int or float)\"},\"programs.granted.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/granted.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/granted.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable granted.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"granted\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.granted.enableFishIntegr