n\",\"text\":\"true\"},\"description\":\"Whether this file should be generated. This option allows specific\\nfiles to be disabled.\\n\",\"loc\":[\"xdg\",\"dataFile\",\"<name>\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.dataFile.<name>.executable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the execute bit. If `null`, defaults to the mode\\nof the {var}`source` file or to `false`\\nfor files created through the {var}`text` option.\\n\",\"loc\":[\"xdg\",\"dataFile\",\"<name>\",\"executable\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"xdg.dataFile.<name>.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether the target path should be unconditionally replaced\\nby the managed file source. Warning, this will silently\\ndelete the target regardless of whether it is a file or\\nlink.\\n\",\"loc\":[\"xdg\",\"dataFile\",\"<name>\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.dataFile.<name>.ignorelinks\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When `recursive` is enabled, adds the `-ignorelinks` flag to lndir.\\n\\nIt causes lndir to not treat symbolic links in the source directory specially.\\nThe link created in the target directory will point back to the corresponding\\nsymbolic link in the source directory. If that link points to a directory, the\\nresulting target will be a link to the source tree's symlink rather than a\\nrecursively linked directory tree.\\n\",\"loc\":[\"xdg\",\"dataFile\",\"<name>\",\"ignorelinks\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.dataFile.<name>.onChange\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Shell commands to run when file has changed between\\ngenerations. The script will be run\\n*after* the new files have been linked\\ninto place.\\n\\nNote, this code is always run when `recursive` is\\nenabled.\\n\",\"loc\":[\"xdg\",\"dataFile\",\"<name>\",\"onChange\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"xdg.dataFile.<name>.recursive\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If the file source is a directory, then this option\\ndetermines whether the directory should be recursively\\nlinked to the target location. This option has no effect\\nif the source is a file.\\n\\nIf `false` (the default) then the target\\nwill be a symbolic link to the source directory. If\\n`true` then the target will be a\\ndirectory structure matching the source's but whose leaves\\nare symbolic links to the files of the source directory.\\n\",\"loc\":[\"xdg\",\"dataFile\",\"<name>\",\"recursive\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.dataFile.<name>.source\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"description\":\"Path of the source file or directory. If\\n[](#opt-xdg.dataFile._name_.text)\\nis non-null then this option will automatically point to a file\\ncontaining that text.\\n\",\"loc\":[\"xdg\",\"dataFile\",\"<name>\",\"source\"],\"readOnly\":false,\"type\":\"absolute path\"},\"xdg.dataFile.<name>.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"name\"},\"description\":\"Path to target file relative to <varname>xdg.dataHome</varname>.\\n\",\"loc\":[\"xdg\",\"dataFile\",\"<name>\",\"target\"],\"readOnly\":false,\"type\":\"non-empty string\"},\"xdg.dataFile.<name>.text\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Text of the file. If this option is null then\\n[](#opt-xdg.dataFile._name_.source)\\nmust be set.\\n\",\"loc\":[\"xdg\",\"dataFile\",\"<name>\",\"text\"],\"readOnly\":false,\"type\":\"null or strings concatenated with \\\"\\\\n\\\"\"},\"xdg.dataHome\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"~/.local/share\\\"\"},\"description\":\"Absolute path to directory holding application data.\\n\\nSets `XDG_DATA_HOME` for the user if `xdg.enable` is set `true`.\\n\",\"loc\":[\"xdg\",\"dataHome\"],\"readOnly\":false,\"type\":\"absolute path\"},\"xdg.desktopEntries\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Desktop Entries allow applications to be shown in your desktop environment's app launcher.\\n\\nYou can define entries for programs without entries or override existing entries.\\n\\nSee <https://specifications.freedesktop.org/desktop-entry-spec/latest/recognized-keys.html> for more information on options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  firefox = {\\n    categories = [\\n      \\\"Network\\\"\\n      \\\"WebBrowser\\\"\\n    ];\\n    exec = \\\"firefox %U\\\";\\n    genericName = \\\"Web Browser\\\";\\n    mimeType = [\\n      \\\"text/html\\\"\\n      \\\"text/xml\\\"\\n    ];\\n    name = \\\"Firefox\\\";\\n    terminal = false;\\n  };\\n}\"},\"loc\":[\"xdg\",\"desktopEntries\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"xdg.desktopEntries.<name>.actions\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The set of actions made available to application launchers.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"New Window\\\" = {\\n    exec = \\\"${pkgs.firefox}/bin/firefox --new-window %u\\\";\\n  };\\n}\\n\"},\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"actions\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"xdg.desktopEntries.<name>.actions.<name>.exec\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Program to execute, possibly with arguments.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"actions\",\"<name>\",\"exec\"],\"readOnly\":false,\"type\":\"null or string\"},\"xdg.desktopEntries.<name>.actions.<name>.icon\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Icon to display in file manager, menus, etc.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"actions\",\"<name>\",\"icon\"],\"readOnly\":false,\"type\":\"null or string or absolute path\"},\"xdg.desktopEntries.<name>.actions.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"<name>\"},\"description\":\"Name of the action.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"actions\",\"<name>\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"xdg.desktopEntries.<name>.categories\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Categories in which the entry should be shown in a menu.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"categories\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"xdg.desktopEntries.<name>.comment\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Tooltip for the entry.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"comment\"],\"readOnly\":false,\"type\":\"null or string\"},\"xdg.desktopEntries.<name>.exec\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Program to execute, possibly with arguments.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"exec\"],\"readOnly\":false,\"type\":\"null or string\"},\"xdg.desktopEntries.<name>.genericName\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Generic name of the application.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"genericName\"],\"readOnly\":false,\"type\":\"null or string\"},\"xdg.desktopEntries.<name>.icon\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Icon to display in file manager, menus, etc.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"icon\"],\"readOnly\":false,\"type\":\"null or string or absolute path\"},\"xdg.desktopEntries.<name>.mimeType\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The MIME type(s) supported by this application.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"mimeType\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"xdg.desktopEntries.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"description\":\"Specific name of the application.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"xdg.desktopEntries.<name>.noDisplay\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Means \\\"this application exists, but don't display it in the menus\\\".\\nThis can be useful to e.g. associate this application with MIME types.\\n\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"noDisplay\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"xdg.desktopEntries.<name>.prefersNonDefaultGPU\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"If true, the application prefers to be run on a more powerful discrete GPU if available.\\n\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"prefersNonDefaultGPU\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"xdg.desktopEntries.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra key-value pairs to add to the `[Desktop Entry]` section.\\nThis may override other values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  DBusActivatable = \\\"false\\\";\\n  Keywords = \\\"calc;math\\\";\\n}\"},\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"xdg.desktopEntries.<name>.startupNotify\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"If true, it is KNOWN that the application will send a \\\"remove\\\"\\nmessage when started with the `DESKTOP_STARTUP_ID`\\nenvironment variable set. If false, it is KNOWN that the application\\ndoes not work with startup notification at all.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"startupNotify\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"xdg.desktopEntries.<name>.terminal\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether the program runs in a terminal window.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"terminal\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"xdg.desktopEntries.<name>.type\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-desktop-entries.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-desktop-entries.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Application\\\"\"},\"description\":\"The type of the desktop entry.\",\"loc\":[\"xdg\",\"desktopEntries\",\"<name>\",\"type\"],\"readOnly\":false,\"type\":\"one of \\\"Application\\\", \\\"Link\\\", \\\"Directory\\\"\"},\"xdg.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable management of XDG base directories.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"xdg\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.localBinInPath\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to add {option}`xdg.binHome` to {env}`PATH` when\\n{option}`xdg.enable` is enabled.\\n\",\"loc\":[\"xdg\",\"localBinInPath\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.mime.desktopFileUtilsPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-mime.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-mime.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.desktop-file-utils\"},\"description\":\"The desktop-file-utils package to use. Used when running update-desktop-database.\",\"loc\":[\"xdg\",\"mime\",\"desktopFileUtilsPackage\"],\"readOnly\":false,\"type\":\"package\"},\"xdg.mime.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-mime.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-mime.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true if host platform is Linux, false otherwise\"},\"description\":\"Whether to install programs and files to support the\\nXDG Shared MIME-info specification and XDG MIME Applications\\nspecification at\\n<https://specifications.freedesktop.org/shared-mime-info-spec/shared-mime-info-spec-latest.html>\\nand\\n<https://specifications.freedesktop.org/mime-apps-spec/mime-apps-spec-latest.html>,\\nrespectively.\\n\",\"loc\":[\"xdg\",\"mime\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.mime.sharedMimeInfoPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-mime.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-mime.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.shared-mime-info\"},\"description\":\"The shared-mime-info package to use. Used when running update-mime-database.\",\"loc\":[\"xdg\",\"mime\",\"sharedMimeInfoPackage\"],\"readOnly\":false,\"type\":\"package\"},\"xdg.mimeApps.associations.added\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-mime-apps.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-mime-apps.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Defines additional associations of applications with\\nmimetypes, as if the .desktop file was listing this mimetype\\nin the first place.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  mimetype1 = [\\n    \\\"foo1.desktop\\\"\\n    \\\"foo2.desktop\\\"\\n    \\\"foo3.desktop\\\"\\n  ];\\n  mimetype2 = \\\"foo4.desktop\\\";\\n}\"},\"loc\":[\"xdg\",\"mimeApps\",\"associations\",\"added\"],\"readOnly\":false,\"type\":\"attribute set of ((list of string) or ((list of string) or string) convertible to it)\"},\"xdg.mimeApps.associations.removed\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-mime-apps.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-mime-apps.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Removes associations of applications with mimetypes, as if the\\n.desktop file was *not* listing this\\nmimetype in the first place.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  mimetype1 = \\\"foo5.desktop\\\";\\n}\"},\"loc\":[\"xdg\",\"mimeApps\",\"associations\",\"removed\"],\"readOnly\":false,\"type\":\"attribute set of ((list of string) or ((list of string) or string) convertible to it)\"},\"xdg.mimeApps.defaultApplicationPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-mime-apps.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-mime-apps.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Packages whose `.desktop` files will be used to establish default\\nmimetype associations.\\n\\nThese associations are appended to the associations in\\n[](#opt-xdg.mimeApps.defaultApplications). If multiple packages\\nassociate with the same mime type, then the priority among them is\\ndetermined by their order in the list.\\n\\n::: {.note}\\nPassing a large number of packages (for example, the system\\npackage set or all of {option}`home.packages`) will\\nsignificantly slow down builds. Prefer listing only the specific\\npackages whose MIME associations you want to set as defaults.\\n:::\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  <derivation eog-50.1>\\n  <derivation evince-48.4>\\n]\"},\"loc\":[\"xdg\",\"mimeApps\",\"defaultApplicationPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"xdg.mimeApps.defaultApplications\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-mime-apps.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-mime-apps.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The default application to be used for a given mimetype. This\\nis, for instance, the one that will be started when\\ndouble-clicking on a file in a file manager. If the\\napplication is no longer installed, the next application in\\nthe list is attempted, and so on.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  mimetype1 = [\\n    \\\"default1.desktop\\\"\\n    \\\"default2.desktop\\\"\\n  ];\\n}\"},\"loc\":[\"xdg\",\"mimeApps\",\"defaultApplications\"],\"readOnly\":false,\"type\":\"attribute set of ((list of string) or ((list of string) or string) convertible to it)\"},\"xdg.mimeApps.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-mime-apps.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-mime-apps.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to manage {file}`$XDG_CONFIG_HOME/mimeapps.list`.\\n\\nThe generated file is read-only.\\n\",\"loc\":[\"xdg\",\"mimeApps\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.portal.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-portal.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-portal.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Sets which portal backend should be used to provide the implementation\\nfor the requested interface. For details check {manpage}`portals.conf(5)`.\\n\\nThese will be written with the name `$desktop-portals.conf` for\\n`xdg.portal.config.$desktop` and `portals.conf` for\\n`xdg.portal.config.common` as an exception.\\n\\nThese, together with `xdg.portal.configPackages`, will be joined into a\\ndirectory and passed to `xdg-desktop-portal.service` through a\\n`NIXOS_XDG_DESKTOP_PORTAL_CONFIG_DIR` variable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  common = {\\n    default = [\\n      \\\"gtk\\\"\\n    ];\\n  };\\n  pantheon = {\\n    default = [\\n      \\\"pantheon\\\"\\n      \\\"gtk\\\"\\n    ];\\n    \\\"org.freedesktop.impl.portal.Secret\\\" = [\\n      \\\"gnome-keyring\\\"\\n    ];\\n  };\\n  x-cinnamon = {\\n    default = [\\n      \\\"xapp\\\"\\n      \\\"gtk\\\"\\n    ];\\n  };\\n}\"},\"loc\":[\"xdg\",\"portal\",\"config\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (string or ((list of string) or string) convertible to it)\"},\"xdg.portal.configPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-portal.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-portal.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of packages that provide XDG desktop portal configuration, usually in\\nthe form of `share/xdg-desktop-portal/$desktop-portals.conf`.\\n\\nNote that configs in `xdg.portal.config` will be preferred if set.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.gnome.gnome-session ]\"},\"loc\":[\"xdg\",\"portal\",\"configPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"xdg.portal.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-portal.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-portal.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable [XDG desktop integration](https://github.com/flatpak/xdg-desktop-portal).\\n\\nNote, if you installed Home Manager via its NixOS module and\\n'home-manager.useUserPackages' is enabled, make sure to add\\n\\n``` nix\\nenvironment.pathsToLink = [ \\\"/share/xdg-desktop-portal\\\" \\\"/share/applications\\\" ];\\n```\\n\\nto your NixOS configuration so that the portal definitions and DE\\nprovided configurations get linked.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"xdg\",\"portal\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.portal.extraPortals\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-portal.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-portal.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of additional portals that should be added to the environment.\\n\\nThe directory where the portal definitions have been merged together\\n(likely `~/.nix-profile/share/xdg-desktop-portal/portals`) will get\\npassed to `xdg-desktop-portal.service` via the\\n`NIX_XDG_DESKTOP_PORTAL_DIR` environment variable.\\n\\nPortals allow interaction with system, like choosing files or taking\\nscreenshots. At minimum, a desktop portal implementation should be\\nlisted.\\n\",\"loc\":[\"xdg\",\"portal\",\"extraPortals\"],\"readOnly\":false,\"type\":\"list of package\"},\"xdg.portal.xdgOpenUsePortal\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-portal.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-portal.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Sets environment variable `NIXOS_XDG_OPEN_USE_PORTAL` to `1`\\nThis will make `xdg-open` use the portal to open programs, which resolves bugs involving\\nprograms opening inside FHS envs or with unexpected env vars set from wrappers.\\nSee [#160923](https://github.com/NixOS/nixpkgs/issues/160923) for more info.\\n\",\"loc\":[\"xdg\",\"portal\",\"xdgOpenUsePortal\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.stateFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of files to link into the user's XDG\\nstate home.\\n\",\"loc\":[\"xdg\",\"stateFile\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"xdg.stateFile.<name>.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether this file should be generated. This option allows specific\\nfiles to be disabled.\\n\",\"loc\":[\"xdg\",\"stateFile\",\"<name>\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.stateFile.<name>.executable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the execute bit. If `null`, defaults to the mode\\nof the {var}`source` file or to `false`\\nfor files created through the {var}`text` option.\\n\",\"loc\":[\"xdg\",\"stateFile\",\"<name>\",\"executable\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"xdg.stateFile.<name>.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether the target path should be unconditionally replaced\\nby the managed file source. Warning, this will silently\\ndelete the target regardless of whether it is a file or\\nlink.\\n\",\"loc\":[\"xdg\",\"stateFile\",\"<name>\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.stateFile.<name>.ignorelinks\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When `recursive` is enabled, adds the `-ignorelinks` flag to lndir.\\n\\nIt causes lndir to not treat symbolic links in the source directory specially.\\nThe link created in the target directory will point back to the corresponding\\nsymbolic link in the source directory. If that link points to a directory, the\\nresulting target will be a link to the source tree's symlink rather than a\\nrecursively linked directory tree.\\n\",\"loc\":[\"xdg\",\"stateFile\",\"<name>\",\"ignorelinks\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.stateFile.<name>.onChange\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Shell commands to run when file has changed between\\ngenerations. The script will be run\\n*after* the new files have been linked\\ninto place.\\n\\nNote, this code is always run when `recursive` is\\nenabled.\\n\",\"loc\":[\"xdg\",\"stateFile\",\"<name>\",\"onChange\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"xdg.stateFile.<name>.recursive\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If the file source is a directory, then this option\\ndetermines whether the directory should be recursively\\nlinked to the target location. This option has no effect\\nif the source is a file.\\n\\nIf `false` (the default) then the target\\nwill be a symbolic link to the source directory. If\\n`true` then the target will be a\\ndirectory structure matching the source's but whose leaves\\nare symbolic links to the files of the source directory.\\n\",\"loc\":[\"xdg\",\"stateFile\",\"<name>\",\"recursive\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.stateFile.<name>.source\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"description\":\"Path of the source file or directory. If\\n[](#opt-xdg.stateFile._name_.text)\\nis non-null then this option will automatically point to a file\\ncontaining that text.\\n\",\"loc\":[\"xdg\",\"stateFile\",\"<name>\",\"source\"],\"readOnly\":false,\"type\":\"absolute path\"},\"xdg.stateFile.<name>.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"name\"},\"description\":\"Path to target file relative to <varname>xdg.stateHome</varname>.\\n\",\"loc\":[\"xdg\",\"stateFile\",\"<name>\",\"target\"],\"readOnly\":false,\"type\":\"non-empty string\"},\"xdg.stateFile.<name>.text\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Text of the file. If this option is null then\\n[](#opt-xdg.stateFile._name_.source)\\nmust be set.\\n\",\"loc\":[\"xdg\",\"stateFile\",\"<name>\",\"text\"],\"readOnly\":false,\"type\":\"null or strings concatenated with \\\"\\\\n\\\"\"},\"xdg.stateHome\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"~/.local/state\\\"\"},\"description\":\"Absolute path to directory holding application states.\\n\\nSets `XDG_STATE_HOME` for the user if `xdg.enable` is set `true`.\\n\",\"loc\":[\"xdg\",\"stateHome\"],\"readOnly\":false,\"type\":\"absolute path\"},\"xdg.systemDirs.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-system-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-system-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Directory names to add to {env}`XDG_CONFIG_DIRS`\\nin the user session.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"/etc/xdg\\\"\\n]\"},\"loc\":[\"xdg\",\"systemDirs\",\"config\"],\"readOnly\":false,\"type\":\"list of string\"},\"xdg.systemDirs.data\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-system-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-system-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Directory names to add to {env}`XDG_DATA_DIRS`\\nin the user session.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"/usr/share\\\"\\n  \\\"/usr/local/share\\\"\\n]\"},\"loc\":[\"xdg\",\"systemDirs\",\"data\"],\"readOnly\":false,\"type\":\"list of string\"},\"xdg.terminal-exec.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-terminal-exec.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-terminal-exec.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable xdg-terminal-exec, the\\n[proposed](https://gitlab.freedesktop.org/xdg/xdg-specs/-/merge_requests/46)\\nDefault Terminal Execution Specification.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"xdg\",\"terminal-exec\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.terminal-exec.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-terminal-exec.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-terminal-exec.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.xdg-terminal-exec\"},\"description\":\"The xdg-terminal-exec package to use.\",\"loc\":[\"xdg\",\"terminal-exec\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"xdg.terminal-exec.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-terminal-exec.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-terminal-exec.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration options for the Default Terminal Execution Specification.\\n\\nThe keys are the desktop environments that are matched (case-insensitively) against {env}`XDG_CURRENT_DESKTOP`,\\nor `default` which is used when the current desktop environment is not found in the configuration.\\nThe values are a list of terminals' [desktop file IDs](https://specifications.freedesktop.org/desktop-entry-spec/latest/ar01s02.html#desktop-file-id) to try in order of decreasing priority.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  GNOME = [\\n    \\\"com.raggesilver.BlackBox.desktop\\\"\\n    \\\"org.gnome.Terminal.desktop\\\"\\n  ];\\n  default = [\\n    \\\"kitty.desktop\\\"\\n  ];\\n}\"},\"loc\":[\"xdg\",\"terminal-exec\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of list of string\"},\"xdg.userDirs.createDirectories\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable automatic creation of the XDG user directories.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"xdg\",\"userDirs\",\"createDirectories\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.userDirs.desktop\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/Desktop\\\"\"},\"description\":\"The Desktop directory.\",\"loc\":[\"xdg\",\"userDirs\",\"desktop\"],\"readOnly\":false,\"type\":\"null or (string or absolute path convertible to it)\"},\"xdg.userDirs.documents\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/Documents\\\"\"},\"description\":\"The Documents directory.\",\"loc\":[\"xdg\",\"userDirs\",\"documents\"],\"readOnly\":false,\"type\":\"null or (string or absolute path convertible to it)\"},\"xdg.userDirs.download\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/Downloads\\\"\"},\"description\":\"The Downloads directory.\",\"loc\":[\"xdg\",\"userDirs\",\"download\"],\"readOnly\":false,\"type\":\"null or (string or absolute path convertible to it)\"},\"xdg.userDirs.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to manage {file}`$XDG_CONFIG_HOME/user-dirs.dirs`.\\n\\nThe generated file is read-only.\\n\",\"loc\":[\"xdg\",\"userDirs\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.userDirs.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Other user directories.\\n\\nThe key ‘MISC’ corresponds to the user-dirs entry ‘XDG_MISC_DIR’.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  MISC = \\\"${config.home.homeDirectory}/Misc\\\";\\n}\\n\"},\"loc\":[\"xdg\",\"userDirs\",\"extraConfig\"],\"readOnly\":false,\"type\":\"attribute set of (string or absolute path convertible to it)\"},\"xdg.userDirs.music\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/Music\\\"\"},\"description\":\"The Music directory.\",\"loc\":[\"xdg\",\"userDirs\",\"music\"],\"readOnly\":false,\"type\":\"null or (string or absolute path convertible to it)\"},\"xdg.userDirs.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.xdg-user-dirs\"},\"description\":\"The xdg-user-dirs package to use.\",\"loc\":[\"xdg\",\"userDirs\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"xdg.userDirs.pictures\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/Pictures\\\"\"},\"description\":\"The Pictures directory.\",\"loc\":[\"xdg\",\"userDirs\",\"pictures\"],\"readOnly\":false,\"type\":\"null or (string or absolute path convertible to it)\"},\"xdg.userDirs.projects\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/Projects\\\"\"},\"description\":\"The Projects directory.\",\"loc\":[\"xdg\",\"userDirs\",\"projects\"],\"readOnly\":false,\"type\":\"null or (string or absolute path convertible to it)\"},\"xdg.userDirs.publicShare\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/Public\\\"\"},\"description\":\"The Public share directory.\",\"loc\":[\"xdg\",\"userDirs\",\"publicShare\"],\"readOnly\":false,\"type\":\"null or (string or absolute path convertible to it)\"},\"xdg.userDirs.setSessionVariables\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"if lib.versionAtLeast config.home.stateVersion \\\"26.05\\\" then false else true\\n\"},\"description\":\"Whether to set the XDG user dir environment variables, like\\n`XDG_DESKTOP_DIR`.\\n\\n::: {.note}\\nThe recommended way to get these values is via the `xdg-user-dir`\\ncommand or by processing `$XDG_CONFIG_HOME/user-dirs.dirs` directly in\\nyour application.\\n:::\\n\\nThis defaults to `true` for state version < 26.05 and `false` otherwise.\\n\",\"loc\":[\"xdg\",\"userDirs\",\"setSessionVariables\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.userDirs.templates\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/Templates\\\"\"},\"description\":\"The Templates directory.\",\"loc\":[\"xdg\",\"userDirs\",\"templates\"],\"readOnly\":false,\"type\":\"null or (string or absolute path convertible to it)\"},\"xdg.userDirs.videos\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-user-dirs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-user-dirs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/Videos\\\"\"},\"description\":\"The Videos directory.\",\"loc\":[\"xdg\",\"userDirs\",\"videos\"],\"readOnly\":false,\"type\":\"null or (string or absolute path convertible to it)\"},\"xfconf.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xfconf.nix>\",\"url\":\"htt