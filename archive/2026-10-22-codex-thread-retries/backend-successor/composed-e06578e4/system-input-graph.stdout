\\\"#ff57e389\\\"\\n        \\\"#ff62a0ea\\\"\\n        \\\"#ffc061cb\\\"\\n      ];\\n      BgColors = [\\n        \\\"#ff1e1e2e\\\"\\n      ];\\n      Theme = 1;\\n    }\\n  ];\\n  ActiveProfile = 0;\\n}\\n\"},\"loc\":[\"programs\",\"cavalier\",\"settings\",\"general\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.chawan.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chawan.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chawan.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable chawan, A TUI web browser.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"chawan\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.chawan.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chawan.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chawan.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.chawan\"},\"description\":\"The chawan package to use.\",\"loc\":[\"programs\",\"chawan\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.chawan.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chawan.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chawan.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration options for chawan.\\n\\nSee {manpage}`cha-config(5)`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  buffer = {\\n    autofocus = true;\\n    images = true;\\n  };\\n  page = {\\n    C-k = \\\"() => pager.load('ddg:')\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"chawan\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.chromium.commandLineArgs\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of command-line arguments to be passed to Chromium.\\n\\nFor a list of common switches, see\\n[Chrome switches](https://chromium.googlesource.com/chromium/src/+/refs/heads/main/chrome/common/chrome_switches.cc).\\n\\nTo search switches for other components, see\\n[Chromium codesearch](https://source.chromium.org/search?q=file:switches.cc&ss=chromium%2Fchromium%2Fsrc).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--enable-logging=stderr\\\"\\n  \\\"--ignore-gpu-blocklist\\\"\\n]\"},\"loc\":[\"programs\",\"chromium\",\"commandLineArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.chromium.dictionaries\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Chromium dictionaries to install.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  pkgs.hunspellDictsChromium.en_US\\n]\\n\"},\"loc\":[\"programs\",\"chromium\",\"dictionaries\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.chromium.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Chromium.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"chromium\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.chromium.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Chromium extensions to install.\\nTo find the extension ID, check its URL on the\\n[Chrome Web Store](https://chrome.google.com/webstore/category/extensions).\\n\\nTo install extensions outside of the Chrome Web Store set\\n`updateUrl` or `crxPath` and\\n`version` as explained in the\\n[Chrome\\ndocumentation](https://developer.chrome.com/docs/extensions/mv2/external_extensions).\\n\\nWhen using `pkgs.ungoogled-chromium` on Linux, prefer `crxPath` and\\n`version`. The default Chrome Web Store update URL is generally not\\nsufficient there.\\n\\nProprietary Google Chrome on macOS only supports extensions from the\\nChrome Web Store.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  { id = \\\"cjpalhdlnbpafiamejdnhcphjbkeiagm\\\"; } # ublock origin\\n  {\\n    id = \\\"dcpihecpambacapedldabdbpakmachpb\\\";\\n    updateUrl = \\\"https://raw.githubusercontent.com/iamadamdev/bypass-paywalls-chrome/master/updates.xml\\\";\\n  }\\n  {\\n    id = \\\"aaaaaaaaaabbbbbbbbbbcccccccccc\\\";\\n    crxPath = \\\"/home/share/extension.crx\\\";\\n    version = \\\"1.0\\\";\\n  }\\n]\\n\"},\"loc\":[\"programs\",\"chromium\",\"extensions\"],\"readOnly\":false,\"type\":\"list of ((submodule) or string convertible to it)\"},\"programs.chromium.extensions.*.crxPath\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the extension's crx file.\\n\\nProprietary Google Chrome on macOS does not support local\\ncrx installation.\\n\",\"loc\":[\"programs\",\"chromium\",\"extensions\",\"*\",\"crxPath\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.chromium.extensions.*.id\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"The extension's ID from the Chrome Web Store url or the unpacked crx.\\n\",\"loc\":[\"programs\",\"chromium\",\"extensions\",\"*\",\"id\"],\"readOnly\":false,\"type\":\"string matching the pattern [a-zA-Z]{32}\"},\"programs.chromium.extensions.*.updateUrl\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"https://clients2.google.com/service/update2/crx\\\"\"},\"description\":\"URL of the extension's update manifest XML file.\\n\\nProprietary Google Chrome on macOS only supports the Chrome\\nWeb Store update URL.\\n\",\"loc\":[\"programs\",\"chromium\",\"extensions\",\"*\",\"updateUrl\"],\"readOnly\":false,\"type\":\"string\"},\"programs.chromium.extensions.*.version\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The extension's version, required for local installation.\\n\\nProprietary Google Chrome on macOS does not support local\\ncrx installation.\\n\",\"loc\":[\"programs\",\"chromium\",\"extensions\",\"*\",\"version\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.chromium.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Resulting customized Chromium package.\\n\\nThis includes any Home Manager customizations such as\\n`commandLineArgs` or `plasmaSupport`, and can be referenced from\\nother Home Manager options through\\n`config.programs.chromium.finalPackage`.\\n\",\"loc\":[\"programs\",\"chromium\",\"finalPackage\"],\"readOnly\":true,\"type\":\"null or package\"},\"programs.chromium.nativeMessagingHosts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Chromium native messaging hosts to install.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  pkgs.keepassxc\\n]\\n\"},\"loc\":[\"programs\",\"chromium\",\"nativeMessagingHosts\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.chromium.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/chromium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/chromium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.chromium\"},\"description\":\"The Chromium package to use.\",\"loc\":[\"programs\",\"chromium\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.claude-code.agents\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom agents for Claude Code.\\nThe attribute name becomes the agent filename, and the value is either:\\n- Inline content as a string with frontmatter\\n- A path to a file containing the agent content with frontmatter\\nAgents are stored in the {file}`agents/` subdirectory of\\n{option}`programs.claude-code.configDir`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  code-reviewer = ''\\n    ---\\n    name: code-reviewer\\n    description: Specialized code review agent\\n    tools: Read, Edit, Grep\\n    ---\\n\\n    You are a senior software engineer specializing in code reviews.\\n    Focus on code quality, security, and maintainability.\\n  '';\\n  documentation = ./agents/documentation.md;\\n}\\n\"},\"loc\":[\"programs\",\"claude-code\",\"agents\"],\"readOnly\":false,\"type\":\"attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)\"},\"programs.claude-code.agentsDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to a directory containing agent files for Claude Code.\\nAgent files from this directory will be symlinked into the\\n{file}`agents/` subdirectory of\\n{option}`programs.claude-code.configDir`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"./agents\"},\"loc\":[\"programs\",\"claude-code\",\"agentsDir\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.claude-code.commands\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom commands for Claude Code.\\nThe attribute name becomes the command filename, and the value is either:\\n- Inline content as a string\\n- A path to a file containing the command content\\nCommands are stored in the {file}`commands/` subdirectory of\\n{option}`programs.claude-code.configDir`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  changelog = ''\\n    ---\\n    allowed-tools: Bash(git log:*), Bash(git diff:*)\\n    argument-hint: [version] [change-type] [message]\\n    description: Update CHANGELOG.md with new entry\\n    ---\\n    Parse the version, change type, and message from the input\\n    and update the CHANGELOG.md file accordingly.\\n  '';\\n  fix-issue = ./commands/fix-issue.md;\\n  commit = ''\\n    ---\\n    allowed-tools: Bash(git add:*), Bash(git status:*), Bash(git commit:*)\\n    description: Create a git commit with proper message\\n    ---\\n    ## Context\\n\\n    - Current git status: !`git status`\\n    - Current git diff: !`git diff HEAD`\\n    - Recent commits: !`git log --oneline -5`\\n\\n    ## Task\\n\\n    Based on the changes above, create a single atomic git commit with a descriptive message.\\n  '';\\n}\\n\"},\"loc\":[\"programs\",\"claude-code\",\"commands\"],\"readOnly\":false,\"type\":\"attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)\"},\"programs.claude-code.commandsDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to a directory containing command files for Claude Code.\\nCommand files from this directory will be symlinked into the\\n{file}`commands/` subdirectory of\\n{option}`programs.claude-code.configDir`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"./commands\"},\"loc\":[\"programs\",\"claude-code\",\"commandsDir\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.claude-code.configDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.home.homeDirectory}/.claude\\\"\"},\"description\":\"Directory holding Claude Code's configuration files.\\n\\nDefaults to {file}`~/.claude`, matching the upstream\\n{command}`claude` CLI default. The {env}`CLAUDE_CONFIG_DIR`\\nenvironment variable is exported automatically whenever the\\ndirectory differs from this default so the CLI reads\\nconfiguration from the same location.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.xdg.configHome}/claude\\\"\"},\"loc\":[\"programs\",\"claude-code\",\"configDir\"],\"readOnly\":false,\"type\":\"string\"},\"programs.claude-code.context\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Global context for Claude Code.\\n\\nThe value is either:\\n- Inline content as a string\\n- A path to a file containing the content\\n\\nThe configured content is written to\\n{file}`CLAUDE.md` inside {option}`programs.claude-code.configDir`\\n(default {file}`~/.claude/CLAUDE.md`).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"./claude-memory.md\"},\"loc\":[\"programs\",\"claude-code\",\"context\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.claude-code.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Claude Code, Anthropic's official CLI.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"claude-code\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.claude-code.enableMcpIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to integrate the MCP servers config from\\n{option}`programs.mcp.servers` into\\n{option}`programs.claude-code.mcpServers`.\\n\\nNote: Settings defined in {option}`programs.mcp.servers` are merged\\nwith {option}`programs.claude-code.mcpServers`, with Claude Code servers\\ntaking precedence.\\n\",\"loc\":[\"programs\",\"claude-code\",\"enableMcpIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.claude-code.hooks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom hooks for Claude Code.\\nThe attribute name becomes the hook filename, and the value is the hook script content.\\nHooks are stored in the {file}`hooks/` subdirectory of\\n{option}`programs.claude-code.configDir`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  post-commit = ''\\n    #!/usr/bin/env bash\\n    echo \\\"Committed with message: $1\\\"\\n  '';\\n  pre-edit = ''\\n    #!/usr/bin/env bash\\n    echo \\\"About to edit file: $1\\\"\\n  '';\\n}\"},\"loc\":[\"programs\",\"claude-code\",\"hooks\"],\"readOnly\":false,\"type\":\"attribute set of strings concatenated with \\\"\\\\n\\\"\"},\"programs.claude-code.hooksDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to a directory containing hook files for Claude Code.\\nHook files from this directory will be symlinked into the\\n{file}`hooks/` subdirectory of\\n{option}`programs.claude-code.configDir`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"./hooks\"},\"loc\":[\"programs\",\"claude-code\",\"hooksDir\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.claude-code.lspServers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"LSP (Language Server Protocol) servers configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  go = {\\n    args = [\\n      \\\"serve\\\"\\n    ];\\n    command = \\\"gopls\\\";\\n    extensionToLanguage = {\\n      \\\".go\\\" = \\\"go\\\";\\n    };\\n  };\\n  typescript = {\\n    args = [\\n      \\\"--stdio\\\"\\n    ];\\n    command = \\\"typescript-language-server\\\";\\n    extensionToLanguage = {\\n      \\\".js\\\" = \\\"javascript\\\";\\n      \\\".jsx\\\" = \\\"javascriptreact\\\";\\n      \\\".ts\\\" = \\\"typescript\\\";\\n      \\\".tsx\\\" = \\\"typescriptreact\\\";\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"claude-code\",\"lspServers\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.claude-code.marketplaces\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom marketplaces for Claude Code plugins.\\nThe attribute name becomes the marketplace name, and the value is either:\\n- A path to the marketplace directory\\n- The marketplace package, whether a nix package or the output of a fetcher\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  local-marketplace = ./my-local-marketplace;\\n  gh-marketplace = fetchFromGithub {\\n    owner = \\\"some-github-org\\\";\\n    repo = \\\"claude-marketplace\\\";\\n    rev = \\\"8a873a220b8427b25b03ce1a821593a24e098c34\\\";\\n    sha256 = \\\"5c2dce95122b5bb73fa547edabbb6c3061c2d193d11e51faecd4d22659e67279\\\";\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"claude-code\",\"marketplaces\"],\"readOnly\":false,\"type\":\"attribute set of (package or absolute path)\"},\"programs.claude-code.mcpServers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"MCP (Model Context Protocol) servers configuration\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  customTransport = {\\n    customOption = \\\"value\\\";\\n    timeout = 5000;\\n    type = \\\"websocket\\\";\\n    url = \\\"wss://example.com/mcp\\\";\\n  };\\n  database = {\\n    args = [\\n      \\\"-y\\\"\\n      \\\"@bytebase/dbhub\\\"\\n      \\\"--dsn\\\"\\n      \\\"postgresql://user:pass@localhost:5432/db\\\"\\n    ];\\n    command = \\\"npx\\\";\\n    env = {\\n      DATABASE_URL = \\\"postgresql://user:pass@localhost:5432/db\\\";\\n    };\\n    type = \\\"stdio\\\";\\n  };\\n  filesystem = {\\n    args = [\\n      \\\"-y\\\"\\n      \\\"@modelcontextprotocol/server-filesystem\\\"\\n      \\\"/tmp\\\"\\n    ];\\n    command = \\\"npx\\\";\\n    type = \\\"stdio\\\";\\n  };\\n  github = {\\n    type = \\\"http\\\";\\n    url = \\\"https://api.githubcopilot.com/mcp/\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"claude-code\",\"mcpServers\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.claude-code.outputStyles\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom output styles for Claude Code.\\nThe attribute name becomes the base of the output style filename.\\nThe value is either:\\n  - Inline content as a string\\n  - A path to a file\\nIn both cases, the contents will be written to\\n{file}`output-styles/<name>.md` inside\\n{option}`programs.claude-code.configDir`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  concise = ./output-styles/concise.md;\\n  detailed = ''\\n    # Detailed Output Style\\n\\n    Contents will be used verbatim for the detailed output format.\\n  '';\\n}\\n\"},\"loc\":[\"programs\",\"claude-code\",\"outputStyles\"],\"readOnly\":false,\"type\":\"attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)\"},\"programs.claude-code.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.claude-code\"},\"description\":\"The claude-code package to use.\",\"loc\":[\"programs\",\"claude-code\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.claude-code.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of plugins to use when running Claude Code.\\nEach entry is either:\\n- A path to the plugin directory\\n- The plugin package, whether a nix package or the output of a fetcher\\nPlugins are enabled via a `--plugin-dir` argument in the wrapper script.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  ./my-local-plugin\\n  fetchFromGithub {\\n    owner = \\\"some-github-org\\\";\\n    repo = \\\"claude-plugin\\\";\\n    rev = \\\"779a68ebc2a75e4a184d2c87e5a43a758e6458a1\\\";\\n    sha256 = \\\"228fdd7e5908ea1d2f65218ecd9c71e1eefa0834d200d55fbb8bf8b5563acec0\\\";\\n  }\\n]\\n\"},\"loc\":[\"programs\",\"claude-code\",\"plugins\"],\"readOnly\":false,\"type\":\"list of (package or absolute path)\"},\"programs.claude-code.rules\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Modular rule files for Claude Code.\\nThe attribute name becomes the rule filename, and the value is either:\\n- Inline content as a string\\n- A path to a file containing the rule content\\nRules are stored in the {file}`rules/` subdirectory of\\n{option}`programs.claude-code.configDir`. All markdown files in\\nthat directory are automatically loaded as project memory.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  code-style = ''\\n    # Code Style Guidelines\\n\\n    - Use consistent formatting\\n    - Follow language conventions\\n  '';\\n  testing = ''\\n    # Testing Conventions\\n\\n    - Write tests for all new features\\n    - Maintain test coverage above 80%\\n  '';\\n  security = ./rules/security.md;\\n}\\n\"},\"loc\":[\"programs\",\"claude-code\",\"rules\"],\"readOnly\":false,\"type\":\"attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)\"},\"programs.claude-code.rulesDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to a directory containing rule files for Claude Code.\\nRule files from this directory will be symlinked into the\\n{file}`rules/` subdirectory of\\n{option}`programs.claude-code.configDir`. All markdown files in\\nthis directory are automatically loaded as project memory.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"./rules\"},\"loc\":[\"programs\",\"claude-code\",\"rulesDir\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.claude-code.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"JSON configuration for Claude Code settings.json\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  hooks = {\\n    PostToolUse = [\\n      {\\n        hooks = [\\n          {\\n            command = \\\"nix fmt $(jq -r '.tool_input.file_path' <<< '$CLAUDE_TOOL_INPUT')\\\";\\n            type = \\\"command\\\";\\n          }\\n        ];\\n        matcher = \\\"Edit|MultiEdit|Write\\\";\\n      }\\n    ];\\n    PreToolUse = [\\n      {\\n        hooks = [\\n          {\\n            command = \\\"echo 'Running command: $CLAUDE_TOOL_INPUT'\\\";\\n            type = \\\"command\\\";\\n          }\\n        ];\\n        matcher = \\\"Bash\\\";\\n      }\\n    ];\\n  };\\n  includeCoAuthoredBy = false;\\n  model = \\\"claude-3-5-sonnet-20241022\\\";\\n  permissions = {\\n    additionalDirectories = [\\n      \\\"../docs/\\\"\\n    ];\\n    allow = [\\n      \\\"Bash(git diff:*)\\\"\\n      \\\"Edit\\\"\\n    ];\\n    ask = [\\n      \\\"Bash(git push:*)\\\"\\n    ];\\n    defaultMode = \\\"acceptEdits\\\";\\n    deny = [\\n      \\\"WebFetch\\\"\\n      \\\"Bash(curl:*)\\\"\\n      \\\"Read(./.env)\\\"\\n      \\\"Read(./secrets/**)\\\"\\n    ];\\n    disableBypassPermissionsMode = \\\"disable\\\";\\n  };\\n  statusLine = {\\n    command = \\\"input=$(cat); echo \\\\\\\"[$(echo \\\\\\\"$input\\\\\\\" | jq -r '.model.display_name')] 📁 $(basename \\\\\\\"$(echo \\\\\\\"$input\\\\\\\" | jq -r '.workspace.current_dir')\\\\\\\")\\\\\\\"\\\";\\n    padding = 0;\\n    type = \\\"command\\\";\\n  };\\n  theme = \\\"dark\\\";\\n}\"},\"loc\":[\"programs\",\"claude-code\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.claude-code.skills\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/claude-code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/claude-code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom skills for Claude Code.\\n\\nThis option can be either:\\n- An attribute set defining skills\\n- A path to a directory containing skill folders\\n\\nIf an attribute set is used, the attribute name becomes the\\nskill directory name, and the value is either:\\n- Inline content as a string (creates {file}`skills/<name>/SKILL.md`)\\n- A path to a file (creates {file}`skills/<name>/SKILL.md`)\\n- A path to a directory (creates {file}`skills/<name>/` with all files)\\n\\nThis also accepts Nix store paths, for example a skill directory\\nfrom a package.\\n\\nIf a path is used, it is expected to contain one folder per\\nskill name, each containing a {file}`SKILL.md`. The directory is\\nsymlinked into the {file}`skills/` subdirectory of\\n{option}`programs.claude-code.configDir`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  xlsx = ./skills/xlsx/SKILL.md;\\n  data-analysis = ./skills/data-analysis;\\n  pdf-processing = ''\\n    ---\\n    name: pdf-processing\\n    description: Extract text and tables from PDF files, fill forms, merge documents. Use when working with PDF files or when the user mentions PDFs, forms, or document extraction.\\n    ---\\n\\n    # PDF Processing\\n\\n    ## Quick start\\n\\n    Use pdfplumber to extract text from PDFs:\\n\\n    ```python\\n    import pdfplumber\\n\\n    with pdfplumber.open(\\\"document.pdf\\\") as pdf:\\n        text = pdf.pages[0].extract_text()\\n    ```\\n  '';\\n\\n  # A skill can also be a subdirectory within a package source (store path)\\n  beads = \\\"${pkgs.beads.src}/claude-plugin/skills/beads\\\";\\n}\\n\"},\"loc\":[\"programs\",\"claude-code\",\"skills\"],\"readOnly\":false,\"type\":\"(attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path or string)) or absolute path\"},\"programs.clock-rs.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/clock-rs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/clock-rs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable clock-rs.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"clock-rs\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.clock-rs.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/clock-rs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/clock-rs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.clock-rs\"},\"description\":\"The clock-rs package to use.\",\"loc\":[\"programs\",\"clock-rs\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.clock-rs.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/clock-rs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/clock-rs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The configuration file to be used for clock-rs\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"general = {\\n  color = \\\"magenta\\\";\\n  interval = 250;\\n  blink = true;\\n  bold = true;\\n};\\n\\nposition = {\\n  horizontal = \\\"start\\\";\\n  vertical = \\\"end\\\";\\n};\\n\\ndate = {\\n  fmt = \\\"%A, %B %d, %Y\\\";\\n  use_12h = true;\\n  utc = true;\\n  hide_seconds = true;\\n};\\n\"},\"loc\":[\"programs\",\"clock-rs\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.cmus.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/cmus.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/cmus.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Enable cmus, the music player..\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"cmus\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.cmus.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/cmus.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/cmus.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration to add to cmus {file}`rc`.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  set audio_backend = \\\"mpd\\\"\\n  set status_display = \\\"default\\\"\\n''\"},\"loc\":[\"programs\",\"cmus\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.cmus.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/cmus.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/cmus.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.cmus\"},\"description\":\"The cmus package to use.\",\"loc\":[\"programs\",\"cmus\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.cmus.theme\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/cmus.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/cmus.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Select color theme. A list of available color themes can be found\\nhere: <https://github.com/cmus/cmus/tree/master/data>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"gruvbox\\\"\"},\"loc\":[\"programs\",\"cmus\",\"theme\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.codex.context\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/codex.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/codex.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Global context for Codex.\\n\\nThe value is either:\\n- Inline content as a string\\n- A path to a file containing the content\\n\\nThe configured content is written to\\n{file}`CODEX_HOME/AGENTS.md`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  - Always respond with emojis\\n  - Only use git commands when explicitly requested\\n''\\n\"},\"loc\":[\"programs\",\"codex\",\"context\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.codex.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/codex.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/codex.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Lightweight coding agent that runs in your terminal.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"codex\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.codex.enableMcpIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/codex.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/codex.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to integrate the MCP server config from\\n{option}`programs.mcp.servers` into\\n{option}`programs.codex.settings.mcp_servers`.\\n\\nNote: Settings defined in {option}`programs.mcp.servers` are merged\\nwith {option}`programs.codex.settings.mcp_servers`, with settings-based\\nvalues taking precedence.\\n\",\"loc\":[\"programs\",\"codex\",\"enableMcpIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.codex.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/codex.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/codex.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.codex\"},\"description\":\"The codex package to use.\",\"loc\":[\"programs\",\"codex\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.codex.rules\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/codex.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/codex.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Codex rules files to manage under {file}`CODEX_HOME/rules/`.\\n\\nThe attribute name becomes the filename, with a {file}`.rules`\\nextension added automatically. The value is either:\\n- Inline content as a string\\n- A path to an existing rules file\\n\\nThis is useful for declaratively managing persistent\\n`prefix_rule()` definitions, including the default\\n{file}`default.rules` allow-list Codex writes when you accept\\nrecurring approvals interactively.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  default = \\\"prefix_rule(pattern = [\\\\\\\"nix\\\\\\\", \\\\\\\"build\\\\\\\"], decision = \\\\\\\"allow\\\\\\\")\\\\n\\\";\\n  github = ./codex/github.rules;\\n}\\n\"},\"loc\":[\"programs\",\"codex\",\"rules\"],\"readOnly\":false,\"type\":\"attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)\"},\"programs.codex.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/codex.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/codex.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`CODEX_HOME/config.toml` (0.2.0+)\\nor {file}`~/.codex/config.yaml` (<0.2.0). Per default {env}`CODEX_HOME`\\ndefaults to ~/.codex.\\nSee <https://github.com/openai/codex/blob/main/codex-rs/config.md> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  model = \\\"gemma3:latest\\\";\\n  model_provider = \\\"ollama\\\";\\n  model_providers = {\\n    ollama = {\\n      name = \\\"Ollama\\\";\\n      baseURL = \\\"http://localhost:11434/v1\\\";\\n      envKey = \\\"OLLAMA_API_KEY\\\";\\n    };\\n  };\\n  mcp_servers = {\\n    context7 = {\\n      command = \\\"npx\\\";\\n      args = [\\n        \\\"-y\\\"\\n        \\\"@upstash/context7-mcp\\\"\\n      ];\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"codex\",\"settings\"],\"readOnly\":false,\"type\":\"null or TOML value\"},\"programs.codex.skills\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/codex.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/codex.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom skills for Codex.\\n\\nThis option can be either:\\n- An attribute set defining skills\\n- A path to a directory containing skill folders\\n\\nIf an attribute set is used, the attribute name becomes the\\nskill directory name, and the value is either:\\n- Inline content as a string (creates a generated skill directory at {file}`<skills-dir>/<name>/`)\\n- A path to a file (creates a generated skill directory at {file}`<skills-dir>/<name>/`)\\n- A path to a directory (symlinks {file}`<skills-dir>/<name>/` to that directory)\\n\\nIf a path is used, it is expected to contain one folder per\\nskill name, each containing a {file}`SKILL.md`. Each top-level\\nskill entry is symlinked into {file}`<skills-dir>/`, leaving\\n{file}`<skills-dir>/` itself as a normal directory so unmanaged\\nskills can coexist.\\n\\nHome Manager manages skills under {file}`CODEX_HOME/skills`\\n(typically {file}`~/.codex/skills`, or\\n{file}`~/.config/codex/skills` when\\n{option}`home.preferXdgDirectories` is enabled).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  pdf-processing = ''\\n    ---\\n    name: pdf-processing\\n    description: Extract text and tables from PDF files, fill forms, merge documents. Use when working with PDF files or when the user mentions PDFs, forms, or document extraction.\\n    ---\\n\\n    # PDF Processing\\n\\n    ## Quick start\\n\\n    Use pdfplumber to extract text from PDFs:\\n\\n    ```python\\n    import pdfplumber\\n\\n    with pdfplumber.open(\\\"document.pdf\\\") as pdf:\\n        text = pdf.pages[0].extract_text()\\n    ```\\n  '';\\n  data-analysis = ./skills/data-analysis;\\n}\\n\"},\"loc\":[\"programs\",\"codex\",\"skills\"],\"readOnly\":false,\"type\":\"(attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)) or absolute path\"},\"programs.command-not-found.dbPath\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/command-not-found>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/command-not-found\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/nix/var/nix/profiles/per-user/root/channels/nixos/programs.sqlite\\\"\"},\"description\":\"Absolute path to {file}`programs.sqlite`. By\\ndefault this file will be provided by your channel\\n(nixexprs.tar.xz).\\n\",\"loc\":[\"programs\",\"command-not-found\",\"dbPath\"],\"readOnly\":false,\"type\":\"absolute path\"},\"programs.command-not-found.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/command-not-found>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/command-not-found\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable command-not-found hook for interactive shell.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"command-not-found\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.comodoro.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/comodoro.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/comodoro.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Comodoro, a CLI to manage your time.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"comodoro\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.comodoro.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/comodoro.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/comodoro.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.comodoro\"},\"description\":\"The comodoro package to use.\",\"loc\":[\"programs\",\"comodoro\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.comodoro.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/comodoro.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/comodoro.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Comodoro configuration.\\nSee <https://pimalaya.org/comodoro/cli/configuration/> for supported values.\\n\",\"loc\":[\"programs\",\"comodoro\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"programs.cudatext.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/cudatext.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/cudatext.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable cudatext.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"cudatext\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.cudatex