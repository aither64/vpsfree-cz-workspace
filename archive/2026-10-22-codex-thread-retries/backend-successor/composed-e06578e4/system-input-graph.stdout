rnhg8jkgiwqjc1bl7a-mirrors-list","name":"URI-5.36.tar.gz","nativeBuildInputs":["/nix/store/y3sbnb3z49c7xaq66cj5z5wss2v000wq-curl-8.22.0-dev"],"nixpkgsVersion":"26.11","outputChecks":{"out":{}},"outputHash":"sha256-MnGeV0E9tuGEkuEEcHuVwiEN9jdhTFEuc2jJ7DwveDs=","outputHashMode":"flat","outputs":["out"],"patches":[],"postFetch":"","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/xai718x2gpf0kf73zwhhv50likh5c18l-stdenv-linux-no-cc","strictDeps":true,"system":"x86_64-linux","urls":["mirror://cpan/authors/id/O/OA/OALDERS/URI-5.36.tar.gz"]},"system":"x86_64-linux","version":4},"hkc69ig3ahrl4k5s8lkayifxkz48z908-logrotate.conf.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","checkPhase":"# logrotate --debug also checks that users specified in config\n# file exist, but we only have sandboxed users here so brown these\n# out. according to man page that means su, create and createolddir.\n# files required to exist also won't be present, so missingok is forced.\nuser=$(/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/id -un)\ngroup=$(/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/id -gn)\nsed -E -e \"s/\\bsu\\s.*/su $user $group/\" \\\n       -e \"s/\\b((create|createolddir)\\b(\\s+[0-9]+)?).*/\\1 $user $group/\" \\\n       -e \"1imissingok\" -e \"s/\\bnomissingok\\b//\" \\\n    $out > logrotate.conf\n# Since this makes for very verbose builds only show real error.\n# There is no way to control log level, but logrotate hardcodes\n# 'error:' at common log level, so we can use grep, taking care\n# to keep error codes\nset -o pipefail\nif ! /nix/store/dhmd7w654dbxkrgcx2pnc2sv47k3bz8w-logrotate-3.22.0/sbin/logrotate -s logrotate.status \\\n                --debug logrotate.conf 2>&1 \\\n            | ( ! grep \"error:\" ) > logrotate-error; then\n        echo \"Logrotate configuration check failed.\"\n        echo \"The failing configuration (after adjustments to pass tests in sandbox) was:\"\n        printf \"%s\\n\" \"-------\"\n        cat logrotate.conf\n        printf \"%s\\n\" \"-------\"\n        echo \"The error reported by logrotate was as follow:\"\n        printf \"%s\\n\" \"-------\"\n        cat logrotate-error\n        printf \"%s\\n\" \"-------\"\n        echo \"You can disable this check with services.logrotate.checkConfig = false,\"\n        echo \"but if you think it should work please report this failure along with\"\n        echo \"the config file being tested!\"\n        false\nfi\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"","mesonFlags":"","name":"logrotate.conf","nativeBuildInputs":"","out":"/nix/store/56wmqz9i3bx56a1yqibg1wn893yb9n56-logrotate.conf","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"weekly\nmissingok\nnotifempty\nrotate 4\n\n\"/var/log/btmp\" {\n  create 0660 root utmp\n  monthly\n  minsize 1M\n  rotate 1\n}\n\n\"/var/log/wtmp\" {\n  create 0664 root utmp\n  monthly\n  minsize 1M\n  rotate 1\n}\n\n\"/var/log/nginx/*.log\" {\n  compress\n  delaycompress\n  weekly\n  postrotate\n    [ ! -f /var/run/nginx/nginx.pid ] || kill -USR1 `cat /var/run/nginx/nginx.pid`\n  endscript\n  rotate 26\n  su nginx nginx\n}\n"},"inputs":{"drvs":{"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"agpmv3a0ml9k3w3cvswn4674c0x8p6vf-logrotate-3.22.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"logrotate.conf","outputs":{"out":{"path":"56wmqz9i3bx56a1yqibg1wn893yb9n56-logrotate.conf"}},"system":"x86_64-linux","version":4},"hkcnpm7i0qx6vj6kw0nin7ixs0rh4n1h-libxcb-1.17.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildInputs":"/nix/store/fc5gyzzdyfxqcm3cyvmaqaafv87f6lik-libpthread-stubs-0.5 /nix/store/8pg2cj5zz9nssg3ikm3zghgw8a6hzqkf-libxau-1.0.12-dev /nix/store/clddq569s9434k4c23kj0b7jhv84rdcd-libxdmcp-1.1.5-dev /nix/store/3ilg816agfa2nlxxh93889rdc0jqy3fs-xcb-proto-1.17.0","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/q2agjkw5piflac72015f96r0vzp1qwcz-libxcb-1.17.0-dev","doCheck":"","doInstallCheck":"","doc":"/nix/store/5dwfh8fvygg96m4fsgncfpx29j2dxwm6-libxcb-1.17.0-doc","man":"/nix/store