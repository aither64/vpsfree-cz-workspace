modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"gitconfig\\\"\"},\"description\":\"Nix store name for the git configuration text file,\\nwhen generating the configuration text from nix options.\\n\",\"loc\":[\"programs\",\"git\",\"includes\",\"*\",\"contentSuffix\"],\"readOnly\":false,\"type\":\"string\"},\"programs.git.includes.*.contents\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration to include. If empty then a path must be given.\\n\\nThis follows the configuration structure as described in\\n{manpage}`git-config(1)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  commit = {\\n    gpgSign = true;\\n  };\\n  user = {\\n    email = \\\"bob@work.example.com\\\";\\n    name = \\\"Bob Work\\\";\\n    signingKey = \\\"1A2B3C4D5E6F7G8H\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"git\",\"includes\",\"*\",\"contents\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.git.includes.*.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"description\":\"Path of the configuration file to include.\",\"loc\":[\"programs\",\"git\",\"includes\",\"*\",\"path\"],\"readOnly\":false,\"type\":\"string or absolute path\"},\"programs.git.lfs.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Git Large File Storage.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"git\",\"lfs\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.git.lfs.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.git-lfs\"},\"description\":\"The git-lfs package to use.\",\"loc\":[\"programs\",\"git\",\"lfs\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.git.lfs.skipSmudge\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Skip automatic downloading of objects on clone or pull.\\nThis requires a manual {command}`git lfs pull`\\nevery time a new commit is checked out on your repository.\\n\",\"loc\":[\"programs\",\"git\",\"lfs\",\"skipSmudge\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.git.maintenance.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Enable the automatic {command}`git maintenance`.\\n\\nIf you have SSH remotes, set {option}`programs.git.package` to a\\ngit version with SSH support (eg: `pkgs.gitFull`).\\n\\nSee <https://git-scm.com/docs/git-maintenance>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"git\",\"maintenance\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.git.maintenance.repositories\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Repositories on which {command}`git maintenance` should run.\\n\\nShould be a list of absolute paths.\\n\",\"loc\":[\"programs\",\"git\",\"maintenance\",\"repositories\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.git.maintenance.timers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  daily = \\\"Tue..Sun *-*-* 0:53:00\\\";\\n  hourly = \\\"*-*-* 1..23:53:00\\\";\\n  weekly = \\\"Mon 0:53:00\\\";\\n}\"},\"description\":\"Systemd timers to create for scheduled {command}`git maintenance`.\\n\\nKey is passed to `--schedule` argument in {command}`git maintenance run`\\nand value is passed to `Timer.OnCalendar` in `systemd.user.timers`.\\n\",\"loc\":[\"programs\",\"git\",\"maintenance\",\"timers\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.git.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.git\"},\"description\":\"The git package to use. Use {var}`pkgs.gitFull`\\nto gain access to {command}`git send-email` for instance.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gitFull\"},\"loc\":[\"programs\",\"git\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.git.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/git/config`.\\nThis may be either a single attrset of Git settings or an ordered\\nlist of attrset fragments when repeated sections or explicit\\nordering matter.\\n\\nSee {manpage}`git-config(1)` for details.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    core = {\\n      whitespace = \\\"trailing-space,space-before-tab\\\";\\n    };\\n    url = {\\n      \\\"ssh://git@host\\\" = {\\n        insteadOf = \\\"otherhost\\\";\\n      };\\n    };\\n  }\\n  {\\n    credential = {\\n      \\\"https://example.com\\\" = {\\n        helper = \\\"\\\";\\n      };\\n    };\\n  }\\n  {\\n    credential = {\\n      \\\"https://example.com\\\" = {\\n        helper = \\\"oauth\\\";\\n      };\\n    };\\n  }\\n]\"},\"loc\":[\"programs\",\"git\",\"settings\"],\"readOnly\":false,\"type\":\"(attribute set of attribute set of (string or boolean or signed integer or list of (string or boolean or signed integer) or attribute set of (string or boolean or signed integer or list of (string or boolean or signed integer)))) or list of attribute set of attribute set of (string or boolean or signed integer or list of (string or boolean or signed integer) or attribute set of (string or boolean or signed integer or list of (string or boolean or signed integer)))\"},\"programs.git.signing.format\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"if lib.versionAtLeast config.home.stateVersion \\\"25.05\\\" then null else \\\"openpgp\\\"\\n\"},\"description\":\"The signing method to use when signing commits and tags.\\nValid values are `openpgp` (OpenPGP/GnuPG), `ssh` (SSH), and `x509` (X.509 certificates).\\n\",\"loc\":[\"programs\",\"git\",\"signing\",\"format\"],\"readOnly\":false,\"type\":\"null or one of \\\"openpgp\\\", \\\"ssh\\\", \\\"x509\\\"\"},\"programs.git.signing.key\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default signing key fingerprint.\\n\\nSet to `null` to let the signer decide what signing key\\nto use depending on commit’s author.\\n\",\"loc\":[\"programs\",\"git\",\"signing\",\"key\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.git.signing.signByDefault\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether commits and tags should be signed by default.\",\"loc\":[\"programs\",\"git\",\"signing\",\"signByDefault\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.git.signing.signer\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/git.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/git.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to signer binary to use.\",\"loc\":[\"programs\",\"git\",\"signing\",\"signer\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.github-copilot-cli.agents\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/github-copilot-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/github-copilot-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom agents for GitHub Copilot CLI.\\n\\nThis option can either be:\\n- An attribute set defining agents\\n- A path to a directory containing multiple agent files\\n\\nIf an attribute set is used, the attribute name becomes the agent\\nfilename, and the value is either:\\n- Inline content as a string (creates\\n  {file}`${configDir}/agents/<name>.agent.md`)\\n- A path to a file (creates\\n  {file}`${configDir}/agents/<name>.agent.md`)\\n\\nIf a path is used, it is expected to contain agent files. The directory\\nis symlinked to {file}`${configDir}/agents/`.\\n\\nSee <https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-command-reference#custom-agents-reference>\\nfor the documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  code-reviewer = ''\\n    ---\\n    description: High signal code review for logic, security, and test gaps.\\n    tools: [\\\"*\\\"]\\n    ---\\n\\n    Review the current changes and report only actionable findings.\\n  '';\\n  documentation = ./agents/documentation.agent.md;\\n}\\n\"},\"loc\":[\"programs\",\"github-copilot-cli\",\"agents\"],\"readOnly\":false,\"type\":\"(attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path or string)) or absolute path\"},\"programs.github-copilot-cli.configDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/github-copilot-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/github-copilot-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"if config.home.preferXdgDirectories then\\n  \\\"${config.xdg.configHome}/copilot\\\"\\nelse\\n  \\\"${config.home.homeDirectory}/.copilot\\\"\\n\"},\"description\":\"Directory holding Copilot CLI configuration files such as\\n{file}`config.json`, {file}`mcp-config.json`,\\n{file}`lsp-config.json`, and\\n{file}`copilot-instructions.md`.\\n\\nDefaults to `${config.xdg.configHome}/copilot` when\\n{option}`home.preferXdgDirectories` is enabled and to `~/.copilot`\\notherwise. The {env}`COPILOT_HOME` environment variable is exported\\nautomatically whenever the directory differs from the upstream\\ndefault of `~/.copilot`.\\n\\nSee <https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-config-dir-reference#changing-the-location-of-the-configuration-directory>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.xdg.configHome}/copilot\\\"\"},\"loc\":[\"programs\",\"github-copilot-cli\",\"configDir\"],\"readOnly\":false,\"type\":\"string\"},\"programs.github-copilot-cli.context\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/github-copilot-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/github-copilot-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Global instructions for GitHub Copilot CLI.\\n\\nThe value is either:\\n- Inline content as a string\\n- A path to a file containing the content\\n\\nThe configured content is written to\\n{file}`copilot-instructions.md` inside\\n{option}`programs.github-copilot-cli.configDir`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  Review the current workspace before making edits.\\n  Prefer actionable findings over general commentary.\\n''\\n\"},\"loc\":[\"programs\",\"github-copilot-cli\",\"context\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.github-copilot-cli.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/github-copilot-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/github-copilot-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable GitHub Copilot CLI.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"github-copilot-cli\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.github-copilot-cli.enableMcpIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/github-copilot-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/github-copilot-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to integrate the MCP servers config from\\n{option}`programs.mcp.servers` into\\n{option}`programs.github-copilot-cli.mcpServers`.\\n\\nServers defined in {option}`programs.mcp.servers` are merged with\\n{option}`programs.github-copilot-cli.mcpServers`, with the latter\\ntaking precedence. Disabled servers (where `disabled = true`) are\\nexcluded from the generated configuration.\\n\",\"loc\":[\"programs\",\"github-copilot-cli\",\"enableMcpIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.github-copilot-cli.lspServers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/github-copilot-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/github-copilot-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"LSP (Language Server Protocol) server configurations written to\\n{file}`lsp-config.json` inside\\n{option}`programs.github-copilot-cli.configDir`.\\n\\nEach attribute defines a server entry under `lspServers` in the config\\nfile. Supported fields include:\\n- `command` — command used to start the LSP server\\n- `args` — arguments passed to the command\\n- `fileExtensions` — map of file extensions to language IDs\\n- `env` — environment variables for the server process\\n- `rootUri` — server root directory relative to the Git root\\n- `initializationOptions` — custom startup options\\n- `requestTimeoutMs` — request timeout in milliseconds\\n\\nLanguage server packages are not installed automatically. Add them to\\n{option}`home.packages` when needed.\\n\\nSee <https://docs.github.com/en/copilot/how-tos/copilot-cli/customize-copilot/add-lsp-servers>\\nfor the documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  typescript = {\\n    command = \\\"typescript-language-server\\\";\\n    args = [ \\\"--stdio\\\" ];\\n    fileExtensions = {\\n      \\\".ts\\\" = \\\"typescript\\\";\\n      \\\".tsx\\\" = \\\"typescriptreact\\\";\\n      \\\".js\\\" = \\\"javascript\\\";\\n      \\\".jsx\\\" = \\\"javascriptreact\\\";\\n    };\\n  };\\n  python = {\\n    command = lib.getExe' pkgs.pyright \\\"pyright-langserver\\\";\\n    args = [ \\\"--stdio\\\" ];\\n    fileExtensions = {\\n      \\\".py\\\" = \\\"python\\\";\\n      \\\".pyw\\\" = \\\"python\\\";\\n      \\\".pyi\\\" = \\\"python\\\";\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"github-copilot-cli\",\"lspServers\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.github-copilot-cli.mcpServers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/github-copilot-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/github-copilot-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"MCP server configurations written to {file}`mcp-config.json` inside\\n{option}`programs.github-copilot-cli.configDir`.\\n\\nEach attribute defines a server entry under `mcpServers` in the config\\nfile. Supported server types:\\n- `local` — starts a local process via stdio (`command`, optional `args`, `env`)\\n- `http` — connects to a remote HTTP server (`url`, optional `headers`)\\n- `sse` — legacy HTTP with Server-Sent Events (same structure as `http`)\\n\\nThe `tools` field accepts `[\\\"*\\\"]` to enable all tools or a list of\\nspecific tool names.\\n\\nSee <https://docs.github.com/en/copilot/how-tos/copilot-cli/customize-copilot/add-mcp-servers>\\nfor the documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  playwright = {\\n    type = \\\"local\\\";\\n    command = \\\"npx\\\";\\n    args = [ \\\"@playwright/mcp@latest\\\" ];\\n    tools = [ \\\"*\\\" ];\\n  };\\n  context7 = {\\n    type = \\\"http\\\";\\n    url = \\\"https://mcp.context7.com/mcp\\\";\\n    headers = { CONTEXT7_API_KEY = \\\"YOUR-API-KEY\\\"; };\\n    tools = [ \\\"*\\\" ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"github-copilot-cli\",\"mcpServers\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.github-copilot-cli.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/github-copilot-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/github-copilot-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.github-copilot-cli\"},\"description\":\"The github-copilot-cli package to use.\",\"loc\":[\"programs\",\"github-copilot-cli\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.github-copilot-cli.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/github-copilot-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/github-copilot-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`config.json` inside\\n{option}`programs.github-copilot-cli.configDir`.\\n\\nKnown configuration keys include:\\n- `model` — AI model selection\\n- `effortLevel` — reasoning effort for capable models\\n- `theme` — `\\\"default\\\"`, `\\\"dim\\\"`, `\\\"high-contrast\\\"`, or `\\\"colorblind\\\"`\\n- `mouse` — enable mouse support (default: `true`)\\n- `banner` — frequency of animated banner display\\n- `renderMarkdown` — markdown rendering toggle (default: `true`)\\n- `screenReader` — accessibility optimizations (default: `false`)\\n- `autoUpdate` — automatic CLI updates (default: `true`)\\n- `stream` — token-by-token response streaming (default: `true`)\\n- `includeCoAuthoredBy` — agent commit attribution (default: `true`)\\n- `respectGitignore` — exclude gitignored files from file picker\\n- `trusted_folders` — list of pre-approved directory paths\\n- `allowed_urls`, `denied_urls` — URL allowlists/blocklists\\n- `logLevel` — log verbosity\\n- `disableAllHooks` — global hook disable toggle\\n- `hooks` — inline hook definitions\\n- `enabledFeatureFlags` — enable or disable specific feature flags\\n\\nSee <https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-config-dir-reference>\\nfor the documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  autoUpdate = false;\\n  model = \\\"claude-sonnet-4-5\\\";\\n  renderMarkdown = true;\\n  theme = \\\"default\\\";\\n  trusted_folders = [\\n    \\\"/home/user/projects\\\"\\n  ];\\n}\"},\"loc\":[\"programs\",\"github-copilot-cli\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.github-copilot-cli.skills\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/github-copilot-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/github-copilot-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom skills for GitHub Copilot CLI.\\n\\nThis option can be either:\\n- An attribute set defining skills\\n- A path to a directory containing skill folders\\n\\nIf an attribute set is used, the attribute name becomes the skill\\ndirectory name, and the value is either:\\n- Inline content as a string (creates\\n  {file}`${configDir}/skills/<name>/SKILL.md`)\\n- A path to a file (creates\\n  {file}`${configDir}/skills/<name>/SKILL.md`)\\n- A path to a directory (symlinks\\n  {file}`${configDir}/skills/<name>/` to that directory)\\n\\nIf a path is used, it is expected to contain one folder per skill name,\\neach containing a {file}`SKILL.md`. The directory is symlinked to\\n{file}`${configDir}/skills/`.\\n\\nSee <https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-command-reference#skills-reference>\\nfor the documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  data-analysis = ./skills/data-analysis;\\n  release-notes = ''\\n    ---\\n    name: release-notes\\n    description: Draft release notes from commits and pull requests.\\n    ---\\n\\n    Summarize user-visible changes and call out migrations.\\n  '';\\n}\\n\"},\"loc\":[\"programs\",\"github-copilot-cli\",\"skills\"],\"readOnly\":false,\"type\":\"(attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path or string)) or absolute path\"},\"programs.gitui.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gitui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gitui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable gitui, blazing fast terminal-ui for git written in rust.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gitui\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gitui.keyConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gitui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gitui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Key config in Ron file format. This is written to\\n{file}`$XDG_CONFIG_HOME/gitui/key_config.ron`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  exit: Some(( code: Char('c'), modifiers: ( bits: 2,),)),\\n  quit: Some(( code: Char('q'), modifiers: ( bits: 0,),)),\\n  exit_popup: Some(( code: Esc, modifiers: ( bits: 0,),)),\\n''\"},\"loc\":[\"programs\",\"gitui\",\"keyConfig\"],\"readOnly\":false,\"type\":\"absolute path or strings concatenated with \\\"\\\\n\\\"\"},\"programs.gitui.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gitui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gitui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gitui\"},\"description\":\"The gitui package to use.\",\"loc\":[\"programs\",\"gitui\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.gitui.theme\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gitui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gitui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  (\\n    selected_tab: Reset,\\n    command_fg: White,\\n    selection_bg: Blue,\\n    selection_fg: White,\\n    cmdbar_bg: Blue,\\n    cmdbar_extra_lines_bg: Blue,\\n    disabled_fg: DarkGray,\\n    diff_line_add: Green,\\n    diff_line_delete: Red,\\n    diff_file_added: LightGreen,\\n    diff_file_removed: LightRed,\\n    diff_file_moved: LightMagenta,\\n    diff_file_modified: Yellow,\\n    commit_hash: Magenta,\\n    commit_time: LightCyan,\\n    commit_author: Green,\\n    danger_fg: Red,\\n    push_gauge_bg: Blue,\\n    push_gauge_fg: Reset,\\n    tag_fg: LightMagenta,\\n    branch_fg: LightYellow,\\n  )\\n''\"},\"description\":\"Theme in Ron file format. This is written to\\n{file}`$XDG_CONFIG_HOME/gitui/theme.ron`.\\n\",\"loc\":[\"programs\",\"gitui\",\"theme\"],\"readOnly\":false,\"type\":\"absolute path or strings concatenated with \\\"\\\\n\\\"\"},\"programs.gnome-shell.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gnome-shell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gnome-shell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable GNOME Shell customization.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gnome-shell\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gnome-shell.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gnome-shell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gnome-shell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\