This can be a JSON object or a path to a custom JSON file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"[nix]\\\" = {\\n    \\\"editor.tabSize\\\" = 2;\\n  };\\n  \\\"files.autoSave\\\" = \\\"off\\\";\\n}\"},\"loc\":[\"programs\",\"vscodium\",\"profiles\",\"<name>\",\"userSettings\"],\"readOnly\":false,\"type\":\"absolute path or JSON value\"},\"programs.vscodium.profiles.<name>.userTasks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vscodium.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vscodium.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to VSCodium's\\n{file}`tasks.json`.\\nThis can be a JSON object or a path to a custom JSON file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  tasks = [\\n    {\\n      command = \\\"hello\\\";\\n      label = \\\"Hello task\\\";\\n      type = \\\"shell\\\";\\n    }\\n  ];\\n  version = \\\"2.0.0\\\";\\n}\"},\"loc\":[\"programs\",\"vscodium\",\"profiles\",\"<name>\",\"userTasks\"],\"readOnly\":false,\"type\":\"absolute path or JSON value\"},\"programs.w3m.bindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Keybindings for w3m.\\n\\nSee <https://git.sr.ht/~rkta/w3m/tree/master/item/doc/README.keymap> for\\ndocumentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"\\\\\\\";\\\\\\\"\\\" = \\\"MARK_WORD\\\";\\n  C-a = \\\"LINE_BEGIN\\\";\\n  DEL = \\\"CLOSE_TAB\\\";\\n  M-C-j = \\\"SAVE_LINK\\\";\\n  M-TAB = \\\"PREV_LINK\\\";\\n  O = \\\"COMMAND \\\\\\\"SET_OPTION dictprompt='GOTO: '; SET_OPTION dictcommand=file:/cgi-bin/opener.cgi ; DICT_WORD\\\\\\\"\\\";\\n  SPC = \\\"NEXT_PAGE\\\";\\n  UP = \\\"MOVE_UP\\\";\\n  \\\"\\\\\\\\\\\\\\\"\\\" = \\\"REG_MARK\\\";\\n  \\\"\\\\\\\\^\\\" = \\\"LINE_BEGIN\\\";\\n  gg = \\\"BEGIN\\\";\\n}\"},\"loc\":[\"programs\",\"w3m\",\"bindings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.w3m.bookmarks.marks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Bookmark file for w3m.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  archlinux = [\\n    {\\n      name = \\\"aur\\\";\\n      url = \\\"https://aur.archlinux.org/\\\";\\n    }\\n    {\\n      name = \\\"archwiki\\\";\\n      url = \\\"https://wiki.archlinux.org/title/Main_page\\\";\\n    }\\n  ];\\n  nix = [\\n    {\\n      name = \\\"nixos manual\\\";\\n      url = \\\"https://nixos.org/manual/nixos/stable/\\\";\\n    }\\n    {\\n      name = \\\"home-manager manual\\\";\\n      url = \\\"https://nix-community.github.io/home-manager/\\\";\\n    }\\n  ];\\n}\"},\"loc\":[\"programs\",\"w3m\",\"bookmarks\",\"marks\"],\"readOnly\":false,\"type\":\"attribute set of list of (submodule)\"},\"programs.w3m.bookmarks.marks.<name>.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"description\":\"Display name of bookmark.\\n\",\"loc\":[\"programs\",\"w3m\",\"bookmarks\",\"marks\",\"<name>\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"programs.w3m.bookmarks.marks.<name>.*.url\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"description\":\"Destination address of bookmark.\\n\",\"loc\":[\"programs\",\"w3m\",\"bookmarks\",\"marks\",\"<name>\",\"*\",\"url\"],\"readOnly\":false,\"type\":\"string\"},\"programs.w3m.bookmarks.title\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Bookmarks\\\"\"},\"description\":\"Title of the bookmarks page.\\n\",\"loc\":[\"programs\",\"w3m\",\"bookmarks\",\"title\"],\"readOnly\":false,\"type\":\"string\"},\"programs.w3m.cgiBin\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Scripts located in w3m's cgi-bin directory. For security reasons, w3m can\\nonly read scripts from here and {file}`${pkgs.w3m}/libexec/w3m/cgi-bin/`\\n(referenceable as $LIB in w3m). The cgi-bin scripts can be written in any\\nlanguage and have access to the query provided to them through the\\nQUERY_STRING environment variable. A cgi-bin script can send commands\\nback to w3m via stdout with the form \\\"W3m-control: <command>\\\".\\n\\nSee <https://git.sr.ht/~rkta/w3m/tree/master/item/doc/MANUAL.html> for\\nmore information.\\n\\nAs of w3m v0.5.5, the option `cgi_bin` isn't defined by default. If you\\nwant to use any cgi-bin scripts in w3m then set\\n`programs.w3m.settings.cgi_bin`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"search.cgi\\\" = {\\n    text = ''\\n      #!/usr/bin/env sh\\n      \\n      PREFIX=$(echo \\\"$QUERY_STRING\\\" | cut -d ':' -f1)\\n      INPUT=$(echo \\\"$QUERY_STRING\\\" | cut -d ':' -f2-)\\n      \\n      case $PREFIX in\\n        aw) echo \\\"W3m-control: GOTO https://wiki.archlinux.org/index.php?search=$INPUT\\\";;\\n        ddg) echo \\\"W3m-control: GOTO https://lite.duckduckgo.com/lite/?q=$INPUT\\\";;\\n      esac\\n      \\n      echo \\\"W3m-control: DELETE_PREVBUF\\\"\\n    '';\\n  };\\n}\"},\"loc\":[\"programs\",\"w3m\",\"cgiBin\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.w3m.cgiBin.<name>.source\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to script file.\\n\",\"loc\":[\"programs\",\"w3m\",\"cgiBin\",\"<name>\",\"source\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.w3m.cgiBin.<name>.text\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Inline content of script file.\\n\",\"loc\":[\"programs\",\"w3m\",\"cgiBin\",\"<name>\",\"text\"],\"readOnly\":false,\"type\":\"null or strings concatenated with \\\"\\\\n\\\"\"},\"programs.w3m.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the w3m terminal web browser.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"w3m\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.w3m.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra packages available to w3m.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.rdrview pkgs.libsixel ]\"},\"loc\":[\"programs\",\"w3m\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.w3m.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"description\":\"Final W3m package that respects homePage, xdg.enable,\\nand w3mImg2Sixel.\\n\",\"loc\":[\"programs\",\"w3m\",\"finalPackage\"],\"readOnly\":true,\"type\":\"package\"},\"programs.w3m.homePage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"https://duckduckgo.com\\\"\"},\"description\":\"Page w3m opens to if a url isn't provided.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\\${config.xdg.configHome}/w3m/bookmark.html\\\"\"},\"loc\":[\"programs\",\"w3m\",\"homePage\"],\"readOnly\":false,\"type\":\"string\"},\"programs.w3m.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.w3m\"},\"description\":\"The w3m package to use.\",\"loc\":[\"programs\",\"w3m\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.w3m.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings for w3m typically set on the OPTIONS page. The best way to\\nconfigure them is setting them in w3m then nixifying the w3m `config`\\nfile located at either {file}`~/.w3m/config` or\\n{file}`~/$XDG_CONFIG_HOME/w3m/config`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  cgi_bin = \\\"\\\\${config.xdg.configHome}/w3m/cgi-bin\\\";\\n  extbrowser = \\\"firefox\\\";\\n  siteconf_file = \\\"\\\\${config.xdg.configHome}/w3m/siteconf\\\";\\n  tabstop = 4;\\n  urimethodmap = \\\"\\\\${config.xdg.configHome}/w3m/urimethodmap\\\";\\n}\"},\"loc\":[\"programs\",\"w3m\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer)\"},\"programs.w3m.siteconf\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Settings for w3m's siteconf. It allows you to match on a url pattern\\nand do various things like url substitutions, site-specific user agent\\nsettings, specifying charset, and a few others.\\n\\nSee <https://git.sr.ht/~rkta/w3m/tree/master/item/doc/README.siteconf>\\nfor documentation and examples.\\n\\nAs of w3m v0.5.5, siteconf doesn't respect the W3M_DIR environment\\nvariable, so unless `programs.w3m.settings.siteconf_file` is set,\\n`siteconf` will always be at {file}`~/.w3m/siteconf`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    preferences = [\\n      \\\"substitute_url \\\\\\\"https://lite.duckduckgo.com\\\\\\\"\\\"\\n    ];\\n    url = \\\"m!^https://duckduckgo.com/!i\\\";\\n  }\\n  {\\n    preferences = [\\n      \\\"url_charset utf-8\\\"\\n      \\\"substitute_url \\\\\\\"https://eo.wikipedia.org\\\\\\\"\\\"\\n    ];\\n    url = \\\"m!^https://wikipedia.org/! exact\\\";\\n  }\\n]\"},\"loc\":[\"programs\",\"w3m\",\"siteconf\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.w3m.siteconf.*.preferences\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The preferences that w3m can apply to the matched url. Options\\nare: `substitute_url \\\"<destination-url>\\\"`,\\n`url_charset <charset>`, `no_referer_from on|off`,\\n`no_referer_to on|off`, `user_agent \\\"string\\\"`.\\n\",\"loc\":[\"programs\",\"w3m\",\"siteconf\",\"*\",\"preferences\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.w3m.siteconf.*.url\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"description\":\"The url that the preferences should apply to. Can be of the\\nform `<url>`, `m!<regex>!`, `m@<regex>@`, or `/<regex>/` with\\noptional trailing \\\"i\\\" for case insensitive and \\\"exact\\\" for exact\\nmatches.\\n\",\"loc\":[\"programs\",\"w3m\",\"siteconf\",\"*\",\"url\"],\"readOnly\":false,\"type\":\"string\"},\"programs.w3m.urimethodmap\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings for w3m's urimethodmap. It allows you to define custom uri\\nschemes and map them to scripts. Scripts must be in the directory\\ndefined in `programs.w3m.settings.cgi_bin`.\\n\\nAs of w3m v0.5.5, urimethodmap doesn't respect the W3M_DIR environment\\nvariable, so unless `programs.w3m.settings.urimethodmap` is set,\\n`urimethodmap` will always be at {file}`~/.w3m/urimethodmap`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  ddg = \\\"file:/cgi-bin/search.cgi?%s\\\";\\n  help = \\\"file:/$LIB/w3mhelp.cgi?%s\\\";\\n}\"},\"loc\":[\"programs\",\"w3m\",\"urimethodmap\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.w3m.w3mImg2Sixel\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/w3m.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/w3m.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"img2sixel\\\"\"},\"description\":\"The executable and arguments that w3m should execute when using libsixel\\nas the image backend.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"img2sixel -d atkinson\\\"\"},\"loc\":[\"programs\",\"w3m\",\"w3mImg2Sixel\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.wallust.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wallust.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wallust.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Wallust color scheme generator.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"wallust\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.wallust.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wallust.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wallust.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wallust\"},\"description\":\"The wallust package to use.\",\"loc\":[\"programs\",\"wallust\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.wallust.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wallust.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wallust.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/wallust/wallust.toml`.\\nSee <https://explosion-mental.codeberg.page/wallust/config/> for\\ndocumentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  palette = \\\"softdark\\\";\\n}\"},\"loc\":[\"programs\",\"wallust\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.watson.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/watson.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/watson.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable watson, a wonderful CLI to track your time.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"watson\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.watson.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/watson.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/watson.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"watson\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.watson.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/watson.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/watson.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"watson\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.watson.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/watson.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/watson.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"watson\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.watson.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/watson.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/watson.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.watson\"},\"description\":\"The watson package to use.\",\"loc\":[\"programs\",\"watson\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.watson.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/watson.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/watson.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/watson/config` on Linux or\\n{file}`$HOME/Library/Application Support/watson/config` on Darwin.\\n\\nSee <https://github.com/TailorDev/Watson/blob/master/docs/user-guide/configuration.md>\\nfor an example configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  backend = {\\n    url = \\\"https://api.crick.fr\\\";\\n    token = \\\"yourapitoken\\\";\\n  };\\n\\n  options = {\\n    stop_on_start = true;\\n    stop_on_restart = false;\\n    date_format = \\\"%Y.%m.%d\\\";\\n    time_format = \\\"%H:%M:%S%z\\\";\\n    week_start = \\\"monday\\\";\\n    log_current = false;\\n    pager = true;\\n    report_current = false;\\n    reverse_log = true;\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"watson\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.waveterm.bookmarks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waveterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waveterm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Bookmark definitions for WaveTerm. Details about the format and the options\\ncan be found here: <https://docs.waveterm.dev/config#webbookmarks-configuration>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"bookmark@claude\\\" = {\\n    title = \\\"Claude\\\";\\n    url = \\\"https://claude.ai\\\";\\n  };\\n  \\\"bookmark@github\\\" = {\\n    title = \\\"GitHub\\\";\\n    url = \\\"https://github.com\\\";\\n  };\\n  \\\"bookmark@google\\\" = {\\n    title = \\\"Google\\\";\\n    url = \\\"https://www.google.com\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"waveterm\",\"bookmarks\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.waveterm.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waveterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waveterm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable waveterm.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"waveterm\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.waveterm.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waveterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waveterm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.waveterm\"},\"description\":\"The waveterm package to use.\",\"loc\":[\"programs\",\"waveterm\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.waveterm.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waveterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waveterm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for WaveTerm. All available options can be\\nfound here: <https://docs.waveterm.dev/config#configuration-keys>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"app:dismissarchitecturewarning\\\" = false;\\n  \\\"autoupdate:enabled\\\" = false;\\n  \\\"term:fontfamily\\\" = \\\"JuliaMono\\\";\\n  \\\"term:fontsize\\\" = 12.0;\\n  \\\"term:theme\\\" = \\\"my-custom-theme\\\";\\n  \\\"term:transparency\\\" = 0.5;\\n  \\\"window:bgcolor\\\" = \\\"#000000\\\";\\n  \\\"window:blur\\\" = true;\\n  \\\"window:opacity\\\" = 0.5;\\n  \\\"window:reducedmotion\\\" = true;\\n  \\\"window:showhelp\\\" = false;\\n}\"},\"loc\":[\"programs\",\"waveterm\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.waveterm.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waveterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waveterm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"User defined terminal themes. All the details about available options and\\nformat can be found here: <https://docs.waveterm.dev/config#terminal-theming>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  default-dark = {\\n    background = \\\"#00000077\\\";\\n    black = \\\"#757575\\\";\\n    blue = \\\"#85aacb\\\";\\n    brightBlack = \\\"#727272\\\";\\n    brightBlue = \\\"#9ab6cb\\\";\\n    brightCyan = \\\"#b7b8cb\\\";\\n    brightGreen = \\\"#a3dd97\\\";\\n    brightMagenta = \\\"#cc8ecb\\\";\\n    brightRed = \\\"#cc9d97\\\";\\n    brightWhite = \\\"#f0f0f0\\\";\\n    brightYellow = \\\"#cbcaaa\\\";\\n    cmdtext = \\\"#f0f0f0\\\";\\n    cursorAccent = \\\"\\\";\\n    cyan = \\\"#74a7cb\\\";\\n    \\\"display:name\\\" = \\\"Default Dark\\\";\\n    \\\"display:order\\\" = 1;\\n    foreground = \\\"#c1c1c1\\\";\\n    gray = \\\"#8b918a\\\";\\n    green = \\\"#76c266\\\";\\n    magenta = \\\"#cc72ca\\\";\\n    red = \\\"#cc685c\\\";\\n    selectionBackground = \\\"\\\";\\n    white = \\\"#c1c1c1\\\";\\n    yellow = \\\"#cbca9b\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"waveterm\",\"themes\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.waybar.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Waybar.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"waybar\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.waybar.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.waybar\"},\"description\":\"The waybar package to use.\",\"loc\":[\"programs\",\"waybar\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.waybar.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Configuration for Waybar, see <https://github.com/Alexays/Waybar/wiki/Configuration>\\nfor supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  mainBar = {\\n    layer = \\\"top\\\";\\n    position = \\\"top\\\";\\n    height = 30;\\n    output = [\\n      \\\"eDP-1\\\"\\n      \\\"HDMI-A-1\\\"\\n    ];\\n    modules-left = [ \\\"sway/workspaces\\\" \\\"sway/mode\\\" \\\"wlr/taskbar\\\" ];\\n    modules-center = [ \\\"sway/window\\\" \\\"custom/hello-from-waybar\\\" ];\\n    modules-right = [ \\\"mpd\\\" \\\"custom/mymodule#with-css-id\\\" \\\"temperature\\\" ];\\n\\n    \\\"sway/workspaces\\\" = {\\n      disable-scroll = true;\\n      all-outputs = true;\\n    };\\n    \\\"custom/hello-from-waybar\\\" = {\\n      format = \\\"hello {}\\\";\\n      max-length = 40;\\n      interval = \\\"once\\\";\\n      exec = pkgs.writeShellScript \\\"hello-from-waybar\\\" ''\\n        echo \\\"from within waybar\\\"\\n      '';\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"waybar\",\"settings\"],\"readOnly\":false,\"type\":\"(list of (open submodule of (JSON value))) or attribute set of (open submodule of (JSON value))\"},\"programs.waybar.style\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"CSS style of the bar.\\n\\nSee <https://github.com/Alexays/Waybar/wiki/Configuration>\\nfor the documentation.\\n\\nIf the value is set to a path literal, then the path will be used as the css file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  * {\\n    border: none;\\n    border-radius: 0;\\n    font-family: Source Code Pro;\\n  }\\n  window#waybar {\\n    background: #16191C;\\n    color: #AAB2BF;\\n  }\\n  #workspaces button {\\n    padding: 0 5px;\\n  }\\n''\"},\"loc\":[\"programs\",\"waybar\",\"style\"],\"readOnly\":false,\"type\":\"null or absolute path or strings concatenated with \\\"\\\\n\\\"\"},\"programs.waybar.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Waybar systemd integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"waybar\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.waybar.systemd.enableDebug\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable debug logging.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"waybar\",\"systemd\",\"enableDebug\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.waybar.systemd.enableInspect\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Inspect objects and find their CSS classes, experiment with live CSS styles, and lookup the current value of CSS properties.\\n\\nSee <https://developer.gnome.org/documentation/tools/inspector.html>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"waybar\",\"systemd\",\"enableInspect\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.waybar.systemd.targets\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waybar.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waybar.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ config.wayland.systemd.target ]\"},\"description\":\"The systemd targets that will automatically start the Waybar service.\\n\\nWhen setting this value to `[ \\\"sway-session.target\\\" ]`,\\nmake sure to also enable {option}`wayland.windowManager.sway.systemd.enable`,\\notherwise the service may never be started.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"sway-session.target\\\"\\n]\"},\"loc\":[\"programs\",\"waybar\",\"systemd\",\"targets\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.waylogout.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waylogout.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waylogout.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether or not to enable waylogout.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"waylogout\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.waylogout.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waylogout.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waylogout.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.waylogout\"},\"description\":\"The waylogout package to use.\",\"loc\":[\"programs\",\"waylogout\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.waylogout.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/waylogout.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/waylogout.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Default arguments to {command}`waylogout`. An empty set\\ndisables configuration generation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  color = \\\"808080\\\";\\n  effect-blur = \\\"7x4\\\";\\n  poweroff-command = \\\"systemctl poweroff\\\";\\n  reboot-command = \\\"systemctl reboot\\\";\\n  scaling = \\\"fit\\\";\\n  screenshots = true;\\n}\"},\"loc\":[\"programs\",\"waylogout\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or floating point number or signed integer or absolute path or string)\"},\"programs.wayprompt.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wayprompt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wayprompt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Wayprompt, a password-prompter for Wayland.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"wayprompt\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.wayprompt.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wayprompt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wayprompt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wayprompt\"},\"description\":\"The wayprompt package to use.\",\"loc\":[\"programs\",\"wayprompt\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.wayprompt.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wayprompt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wayprompt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for wayprompt written to\\n{file}`$XDG_CONFIG_HOME/wayprompt/config.ini`.\\nSee {manpage}`wayprompt(5)` for a list of available options.\\nNote that colours can be either 6-hex-digit RGB or 8-hex-digit RGBA values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  colours = {\\n    background = \\\"ffffffaa\\\";\\n  };\\n  general = {\\n    font-regular = \\\"sans:size=14\\\";\\n    pin-square-amount = 32;\\n  };\\n}\"},\"loc\":[\"programs\",\"wayprompt\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.wezterm.colorSchemes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wezterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wezterm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of additional color schemes to be written to\\n{file}`$XDG_CONFIG_HOME/wezterm/colors`, where each key is\\ntaken as the name of the corresponding color scheme. See\\n<https://wezfurlong.org/wezterm/config/appearance.html#defining-a-color-scheme-in-a-separate-file>\\nfor more details of the TOML color scheme format.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"myCoolTheme = {\\n  ansi = [\\n    \\\"#222222\\\" \\\"#D14949\\\" \\\"#48874F\\\" \\\"#AFA75A\\\"\\n    \\\"#599797\\\" \\\"#8F6089\\\" \\\"#5C9FA8\\\" \\\"#8C8C8C\\\"\\n  ];\\n  brights = [\\n    \\\"#444444\\\" \\\"#FF6D6D\\\" \\\"#89FF95\\\" \\\"#FFF484\\\"\\n    \\\"#97DDFF\\\" \\\"#FDAAF2\\\" \\\"#85F5DA\\\" \\\"#E9E9E9\\\"\\n  ];\\n  background = \\\"#1B1B1B\\\";\\n  cursor_bg = \\\"#BEAF8A\\\";\\n  cursor_border = \\\"#BEAF8A\\\";\\n  cursor_fg = \\\"#1B1B1B\\\";\\n  foreground = \\\"#BEAF8A\\\";\\n  selection_bg = \\\"#444444\\\";\\n  selection_fg = \\\"#E9E9E9\\\";\\n};\\n\"},\"loc\":[\"programs\",\"wezterm\",\"colorSchemes\"],\"readOnly\":false,\"type\":\"attribute set of (TOML value)\"},\"programs.wezterm.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wezterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wezterm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable wezterm.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"wezterm\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.wezterm.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wezterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wezterm.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"wezterm\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.wezterm.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wezterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wezterm.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"wezterm\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.wezterm.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wezterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wezterm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration written to\\n{file}`$XDG_CONFIG_HOME/wezterm/wezterm.lua`. See\\n<https://wezfurlong.org/wezterm/config/files.html>\\nhow to configure.\\n\\nWhen used together with {option}`settings`, any table returned\\nfrom this Lua code is merged into the generated configuration,\\ntaking precedence over {option}`settings` on conflicts. Note\\nthat this merge is shallow: a key returned here replaces the\\nentire corresponding value from {option}`settings`, so nested\\ntables and arrays are not combined. A {command}`return`\\nstatement is optional — code that directly modifies the\\n{command}`config` variable also works.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"-- Your lua code / config here\\nlocal mylib = require 'mylib';\\nreturn {\\n  usemylib = mylib.do_fun();\\n  font = wezterm.font(\\\"JetBrains Mono\\\"),\\n  font_size = 16.0,\\n  color_scheme = \\\"Tomorrow Night\\\",\\n  hide_tab_bar_if_only_one_tab = true,\\n  default_prog = { \\\"zsh\\\", \\\"--login\\\", \\\"-c\\\", \\\"tmux attach -t dev || tmux new -s dev\\\" },\\n  keys = {\\n    {key=\\\"n\\\", mods=\\\"SHIFT|CTRL\\\", action=\\\"ToggleFullScreen\\\"},\\n  }\\n}\\n\"},\"loc\":[\"programs\",\"wezterm\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.wezterm.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wezterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wezterm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wezterm\"},\"description\":\"The wezterm package to use.\",\"loc\":[\"programs\",\"wezterm\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.wezterm.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/wezterm.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/wezterm.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/wezterm/wezterm.lua` using\\n`lib.generators.toLua`. Values created with\\n`lib.generators.mkLuaInline` are rendered as raw Lua\\nexpressions, which allows embedding wezterm API calls such as\\n`wezterm.font`. See\\n<https://wezfurlong.org/wezterm/config/files.html> for\\navailable options.\\n\\nWhen this option is set, {option}`extraConfig` is still\\nsupported. Any table returned from the extra Lua code is merged\\non top of these settings, so {option}`extraConfig` takes\\nprecedence on conflicts.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  color_scheme = \\\"Catppuccin Mocha\\\";\\n  font_size = 13;\\n  hide_tab_bar_if_only_one_tab = true;\\n  window_padding = {\\n    left = 0;\\n    right = 0;\\n    top = 0;\\n    bottom = 0;\\n  };\\n  font = lib.generators.mkLuaInline ''wezterm.font(\\\"JetBrains Mono\\\")'';\\n}\\n\"},\"loc\":[\"programs\",\"wezterm\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.windsurf.argvSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/windsurf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/windsurf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to Windsurf's\\n{file}`argv.json`.\\nThis can be a JSON object or a path to a custom JSON file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  enable-crash-reporter = false;\\n}\"},\"loc\":[\"programs\",\"windsurf\",\"argvSettings\"],\"readOnly\":false,\"type\":\"absolute path or JSON value\"},\"programs.windsurf.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/windsurf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/windsurf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Windsurf.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"windsurf\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.windsurf.mutableExtensionsDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/windsurf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/windsurf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"(removeAttrs config.programs.windsurf.profiles [ \\\"default\\\" ]) == { }\"},\"description\":\"Whether extensions can be installed or updated manually\\nor by Windsurf. Mutually exclusive to\\nprograms.windsurf.profiles.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"windsurf\",\"mutableExtensionsDir\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.windsurf.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/windsurf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/windsurf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.windsurf\"},\"description\":\"The windsurf package t