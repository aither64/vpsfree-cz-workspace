lameshot.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/flameshot.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.flameshot\"},\"description\":\"The flameshot package to use.\",\"loc\":[\"services\",\"flameshot\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.flameshot.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/flameshot.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/flameshot.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration to use for Flameshot. See\\n<https://github.com/flameshot-org/flameshot/blob/master/flameshot.example.ini>\\nfor available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  General = {\\n    disabledTrayIcon = true;\\n    showStartupLaunchMessage = false;\\n  };\\n}\"},\"loc\":[\"services\",\"flameshot\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"services.fluidsynth.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fluidsynth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fluidsynth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable fluidsynth midi synthesizer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"fluidsynth\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.fluidsynth.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fluidsynth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fluidsynth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra arguments, added verbatim to the fluidsynth command. See\\n{manpage}`fluidsynth.conf(1)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--sample-rate 96000\\\"\\n]\"},\"loc\":[\"services\",\"fluidsynth\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.fluidsynth.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fluidsynth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fluidsynth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.fluidsynth\"},\"description\":\"The fluidsynth package to use.\",\"loc\":[\"services\",\"fluidsynth\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.fluidsynth.soundFont\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fluidsynth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fluidsynth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${pkgs.soundfont-fluid}/share/soundfonts/FluidR3_GM2-2.sf2\\\";\\n\"},\"description\":\"The soundfont file to use, in SoundFont 2 format.\\n\",\"loc\":[\"services\",\"fluidsynth\",\"soundFont\"],\"readOnly\":false,\"type\":\"absolute path\"},\"services.fluidsynth.soundService\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fluidsynth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fluidsynth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pulseaudio\\\"\"},\"description\":\"The systemd sound service to depend on.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pipewire-pulse\\\"\"},\"loc\":[\"services\",\"fluidsynth\",\"soundService\"],\"readOnly\":false,\"type\":\"one of \\\"jack\\\", \\\"pipewire-pulse\\\", \\\"pulseaudio\\\"\"},\"services.fnott.configFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fnott.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fnott.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$XDG_CONFIG_HOME/fnott/fnott.ini\\\"\"},\"description\":\"Path to the configuration file read by fnott.\\n\\nNote that environment variables in the path won't be properly expanded.\\n\\nThe configuration specified under\\n{option}`services.fnott.settings` will be generated and\\nwritten to {file}`$XDG_CONFIG_HOME/fnott/fnott.ini`\\nregardless of this option. This allows using a mutable configuration file\\ngenerated from the immutable one, useful in scenarios where live reloading is desired.\\n\",\"loc\":[\"services\",\"fnott\",\"configFile\"],\"readOnly\":false,\"type\":\"string or absolute path\"},\"services.fnott.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fnott.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fnott.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable fnott, a lightweight Wayland notification daemon for wlroots-based compositors\\n.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"fnott\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.fnott.extraFlags\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fnott.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fnott.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra arguments to use for executing fnott.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"-s\\\"\\n]\"},\"loc\":[\"services\",\"fnott\",\"extraFlags\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.fnott.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fnott.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fnott.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.fnott\"},\"description\":\"The fnott package to use.\",\"loc\":[\"services\",\"fnott\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.fnott.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fnott.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fnott.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/fnott/fnott.ini`.\\n\\nSee\\n{manpage}`fnott.ini(5)` for a list of available options and <https://codeberg.org/dnkl/fnott/src/branch/master/fnott.ini>\\nfor an example configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  low = {\\n    timeout = 5;\\n    title-color = \\\"ffffff\\\";\\n    title-font = \\\"Dina:weight=bold:slant=italic\\\";\\n  };\\n  main = {\\n    notification-margin = 5;\\n  };\\n}\"},\"loc\":[\"services\",\"fnott\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"services.fusuma.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fusuma.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fusuma.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the fusuma systemd service to automatically enable touchpad gesture.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"fusuma\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.fusuma.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fusuma.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fusuma.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.xdotool pkgs.coreutils pkgs.xprop\"},\"description\":\"Extra packages needs to bring to the scope of fusuma service.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs; [ xdotool coreutils xprop ];\\n\"},\"loc\":[\"services\",\"fusuma\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"services.fusuma.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fusuma.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fusuma.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.fusuma\"},\"description\":\"The fusuma package to use.\",\"loc\":[\"services\",\"fusuma\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.fusuma.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/fusuma.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/fusuma.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"YAML config that will override the default fusuma configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  threshold = {\\n    swipe = 0.1;\\n  };\\n  interval = {\\n    swipe = 0.7;\\n  };\\n  swipe = {\\n    \\\"3\\\" = {\\n      left = {\\n        # GNOME: Switch to left workspace\\n        command = \\\"xdotool key ctrl+alt+Right\\\";\\n      };\\n    };\\n  };\\n};\\n\"},\"loc\":[\"services\",\"fusuma\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"services.gammastep.dawnTime\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the time interval of dawn manually.\\nThe times must be specified as HH:MM in 24-hour format.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"6:00-7:45\\\"\"},\"loc\":[\"services\",\"gammastep\",\"dawnTime\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.gammastep.duskTime\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the time interval of dusk manually.\\nThe times must be specified as HH:MM in 24-hour format.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"18:35-20:15\\\"\"},\"loc\":[\"services\",\"gammastep\",\"duskTime\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.gammastep.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Gammastep.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"gammastep\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gammastep.enableVerboseLogging\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable verbose service logging.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"gammastep\",\"enableVerboseLogging\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gammastep.latitude\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Your current latitude, between `-90.0` and\\n`90.0`. Must be provided along with\\nlongitude.\\n\",\"loc\":[\"services\",\"gammastep\",\"latitude\"],\"readOnly\":false,\"type\":\"null or string or floating point number\"},\"services.gammastep.longitude\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Your current longitude, between `-180.0` and\\n`180.0`. Must be provided along with\\nlatitude.\\n\",\"loc\":[\"services\",\"gammastep\",\"longitude\"],\"readOnly\":false,\"type\":\"null or string or floating point number\"},\"services.gammastep.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gammastep\"},\"description\":\"Gammastep derivation to use.\\n\",\"loc\":[\"services\",\"gammastep\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.gammastep.provider\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"manual\\\"\"},\"description\":\"The location provider to use for determining your location. If set to\\n`manual` you must also provide latitude/longitude.\\nIf set to `geoclue2`, you must also enable the global\\ngeoclue2 service.\\n\",\"loc\":[\"services\",\"gammastep\",\"provider\"],\"readOnly\":false,\"type\":\"one of \\\"manual\\\", \\\"geoclue2\\\"\"},\"services.gammastep.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The configuration to pass to Gammastep.\\nAvailable options for Gammastep described in\\n{manpage}`gammastep(1)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  general = {\\n    adjustment-method = \\\"randr\\\";\\n  };\\n  randr = {\\n    screen = 0;\\n  };\\n};\\n\"},\"loc\":[\"services\",\"gammastep\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"services.gammastep.temperature.day\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"5500\"},\"description\":\"Colour temperature to use during the day, between\\n`1000` and `25000` K.\\n\",\"loc\":[\"services\",\"gammastep\",\"temperature\",\"day\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.gammastep.temperature.night\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"3700\"},\"description\":\"Colour temperature to use at night, between\\n`1000` and `25000` K.\\n\",\"loc\":[\"services\",\"gammastep\",\"temperature\",\"night\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.gammastep.tray\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/redshift-gammastep/gammastep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/redshift-gammastep/gammastep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Start the gammastep-indicator tray applet.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"gammastep\",\"tray\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.getmail.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/getmail.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/getmail.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the getmail systemd service to automatically retrieve mail.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"getmail\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.getmail.frequency\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/getmail.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/getmail.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"*:0/5\\\"\"},\"description\":\"The refresh frequency. Check `man systemd.time` for\\nmore information on the syntax. If you use a gpg-agent in\\ncombination with the passwordCommand, keep the poll\\nfrequency below the cache-ttl value (as set by the\\n`default`) to avoid pinentry asking\\npermanently for a password.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"hourly\\\"\"},\"loc\":[\"services\",\"getmail\",\"frequency\"],\"readOnly\":false,\"type\":\"string\"},\"services.getmail.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/getmail.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/getmail.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.getmail6\"},\"description\":\"The getmail package to use.\",\"loc\":[\"services\",\"getmail\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.git-sync.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/git-sync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/git-sync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable git-sync services.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"git-sync\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.git-sync.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/git-sync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/git-sync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.git-sync\"},\"description\":\"The git-sync package to use.\",\"loc\":[\"services\",\"git-sync\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.git-sync.repositories\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/git-sync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/git-sync.nix\"}],\"description\":\"The repositories that should be synchronized.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  xyz = {\\n    path = \\\"${config.home.homeDirectory}/foo/home-manager\\\";\\n    uri = \\\"git@github.com:nix-community/home-manager.git\\\";\\n    interval = 1000;\\n  };\\n}\\n\"},\"loc\":[\"services\",\"git-sync\",\"repositories\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"services.git-sync.repositories.<name>.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/git-sync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/git-sync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra packages available to git-sync.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs; [ git-crypt ]\"},\"loc\":[\"services\",\"git-sync\",\"repositories\",\"<name>\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"services.git-sync.repositories.<name>.interval\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/git-sync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/git-sync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"500\"},\"description\":\"The interval, specified in seconds, at which the synchronization will\\nbe triggered even without filesystem changes.\\n\",\"loc\":[\"services\",\"git-sync\",\"repositories\",\"<name>\",\"interval\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.git-sync.repositories.<name>.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/git-sync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/git-sync.nix\"}],\"description\":\"The path at which to sync the repository\",\"loc\":[\"services\",\"git-sync\",\"repositories\",\"<name>\",\"path\"],\"readOnly\":false,\"type\":\"absolute path\"},\"services.git-sync.repositories.<name>.uri\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/git-sync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/git-sync.nix\"}],\"description\":\"The URI of the remote to be synchronized. This is only used in the\\nevent that the directory does not already exist. See\\n<https://git-scm.com/docs/git-clone#_git_urls>\\nfor the supported URIs.\\n\\nThis option is not supported on Darwin.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"git+ssh://user@example.com:/~[user]/path/to/repo.git\\\"\"},\"loc\":[\"services\",\"git-sync\",\"repositories\",\"<name>\",\"uri\"],\"readOnly\":false,\"type\":\"string\"},\"services.glance.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/glance.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/glance.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable glance.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"glance\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.glance.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/glance.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/glance.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.glance\"},\"description\":\"The glance package to use.\",\"loc\":[\"services\",\"glance\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.glance.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/glance.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/glance.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  pages = [\\n    {\\n      columns = [\\n        {\\n          size = \\\"full\\\";\\n          widgets = [\\n            {\\n              type = \\\"calendar\\\";\\n            }\\n          ];\\n        }\\n      ];\\n      name = \\\"Calendar\\\";\\n    }\\n  ];\\n}\"},\"description\":\"Configuration written to a yaml file that is read by glance. See\\n<https://github.com/glanceapp/glance/blob/main/docs/configuration.md>\\nfor more.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  pages = [\\n    {\\n      columns = [\\n        {\\n          size = \\\"full\\\";\\n          widgets = [\\n            {\\n              type = \\\"calendar\\\";\\n            }\\n            {\\n              location = \\\"London, United Kingdom\\\";\\n              type = \\\"weather\\\";\\n            }\\n          ];\\n        }\\n      ];\\n      name = \\\"Home\\\";\\n    }\\n  ];\\n  server = {\\n    port = 5678;\\n  };\\n}\"},\"loc\":[\"services\",\"glance\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"services.gnome-keyring.components\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gnome-keyring.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gnome-keyring.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The GNOME keyring components to start. If empty then the\\ndefault set of components will be started.\\n\",\"loc\":[\"services\",\"gnome-keyring\",\"components\"],\"readOnly\":false,\"type\":\"list of (one of \\\"pkcs11\\\", \\\"secrets\\\", \\\"ssh\\\")\"},\"services.gnome-keyring.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gnome-keyring.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gnome-keyring.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable GNOME Keyring.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"gnome-keyring\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gnome-keyring.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gnome-keyring.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gnome-keyring.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gnome-keyring\"},\"description\":\"The gnome-keyring package to use.\",\"loc\":[\"services\",\"gnome-keyring\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.gpg-agent.defaultCacheTtl\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the time a cache entry is valid to the given number of\\nseconds.\\n\",\"loc\":[\"services\",\"gpg-agent\",\"defaultCacheTtl\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"services.gpg-agent.defaultCacheTtlSsh\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the time a cache entry used for SSH keys is valid to the\\ngiven number of seconds.\\n\",\"loc\":[\"services\",\"gpg-agent\",\"defaultCacheTtlSsh\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"services.gpg-agent.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable GnuPG private key agent.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"gpg-agent\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gpg-agent.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"services\",\"gpg-agent\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gpg-agent.enableExtraSocket\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable extra socket of the GnuPG key agent (useful for GPG\\nAgent forwarding).\\n\",\"loc\":[\"services\",\"gpg-agent\",\"enableExtraSocket\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gpg-agent.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"services\",\"gpg-agent\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gpg-agent.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"services\",\"gpg-agent\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gpg-agent.enableScDaemon\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Make use of the scdaemon tool. This option has the effect of\\nenabling the ability to do smartcard operations. When\\ndisabled, this option passes\\n{option}`disable-scdaemon` setting to gpg-agent.\\n\",\"loc\":[\"services\",\"gpg-agent\",\"enableScDaemon\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gpg-agent.enableSshSupport\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to use the GnuPG key agent for SSH keys.\\n\",\"loc\":[\"services\",\"gpg-agent\",\"enableSshSupport\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gpg-agent.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"services\",\"gpg-agent\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gpg-agent.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines to append to the gpg-agent\\nconfiguration file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  allow-emacs-pinentry\\n  allow-loopback-pinentry\\n''\"},\"loc\":[\"services\",\"gpg-agent\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"services.gpg-agent.grabKeyboardAndMouse\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Tell the pinentry to grab the keyboard and mouse. This\\noption should in general be used to avoid X-sniffing\\nattacks. When disabled, this option passes\\n{option}`no-grab` setting to gpg-agent.\\n\",\"loc\":[\"services\",\"gpg-agent\",\"grabKeyboardAndMouse\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gpg-agent.maxCacheTtl\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the maximum time a cache entry is valid to n seconds. After this\\ntime a cache entry will be expired even if it has been accessed\\nrecently or has been set using gpg-preset-passphrase. The default is\\n2 hours (7200 seconds).\\n\",\"loc\":[\"services\",\"gpg-agent\",\"maxCacheTtl\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"services.gpg-agent.maxCacheTtlSsh\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the maximum time a cache entry used for SSH keys is valid to n\\nseconds. After this time a cache entry will be expired even if it has\\nbeen accessed recently or has been set using gpg-preset-passphrase.\\nThe default is 2 hours (7200 seconds).\\n\",\"loc\":[\"services\",\"gpg-agent\",\"maxCacheTtlSsh\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"services.gpg-agent.noAllowExternalCache\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Tell Pinentry not to enable features which use an external cache for\\npassphrases.\\n\\nSome desktop environments prefer to unlock all credentials with one\\nmaster password and may have installed a Pinentry which employs an\\nadditional external cache to implement such a policy. By using this\\noption the Pinentry is advised not to make use of such a cache and\\ninstead always ask the user for the requested passphrase.\\n\",\"loc\":[\"services\",\"gpg-agent\",\"noAllowExternalCache\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gpg-agent.pinentry.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The pinentry-gnome3 package to use. Which pinentry interface to use. If not `null`, it sets\\n{option}`pinentry-program` in {file}`gpg-agent.conf`. Beware that\\n`pinentry-gnome3` may not work on non-GNOME systems. You can fix it by\\nadding the following to your configuration:\\n```nix\\nhome.packages = [ pkgs.gcr ];\\n```\\n\",\"loc\":[\"services\",\"gpg-agent\",\"pinentry\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"services.gpg-agent.pinentry.program\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Which program to search for in the configured `pinentry.package`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pinentry-wayprompt\\\"\"},\"loc\":[\"services\",\"gpg-agent\",\"pinentry\",\"program\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.gpg-agent.sshKeys\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Which GPG keys (by keygrip) to expose as SSH keys.\\n\",\"loc\":[\"services\",\"gpg-agent\",\"sshKeys\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"services.gpg-agent.verbose\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gpg-agent.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gpg-agent.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to produce verbose output.\\n\",\"loc\":[\"services\",\"gpg-agent\",\"verbose\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.grobi.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/grobi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/grobi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the grobi display setup daemon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"grobi\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.grobi.executeAfter\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/grobi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/grobi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Commands to be run after an output configuration was\\nchanged. The Nix value declared here will be translated to\\nJSON and written to the {option}`execute_after` key\\nin {file}`$XDG_CONFIG_HOME/grobi.conf`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"setxkbmap dvorak\\\"\\n]\"},\"loc\":[\"services\",\"grobi\",\"executeAfter\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.grobi.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/grobi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/grobi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.grobi\"},\"description\":\"The grobi package to use.\",\"loc\":[\"services\",\"grobi\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.grobi.rules\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/grobi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/grobi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"These are the rules grobi tries to match to the current\\noutput configuration. The rules are evaluated top to bottom,\\nthe first matching rule is applied and processing stops. See\\n<https://github.com/fd0/grobi/blob/master/doc/grobi.conf>\\nfor more information. The Nix value declared here will be\\ntranslated to JSON and written to the {option}`rules`\\nkey in {file}`$XDG_CONFIG_HOME/grobi.conf`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    name = \\\"Home\\\";\\n    outputs_connected = [ \\\"DP-2\\\" ];\\n    configure_single = \\\"DP-2\\\";\\n    primary = true;\\n    atomic = true;\\n    execute_after = [\\n      \\\"${lib.getExe pkgs.xrandr} --dpi 96\\\"\\n      \\\"${pkgs.xmonad-with-packages}/bin/xmonad --restart\\\";\\n    ];\\n  }\\n  {\\n    name = \\\"Mobile\\\";\\n    outputs_disconnected = [ \\\"DP-2\\\" ];\\n    configure_single = \\\"eDP-1\\\";\\n    primary = true;\\n    atomic = true;\\n    execute_after = [\\n      \\\"${lib.getExe pkgs.xrandr} --dpi 120\\\"\\n      \\\"${pkgs.xmonad-with-packages}/bin/xmonad --restart\\\";\\n    ];\\n  }\\n]\\n\"},\"loc\":[\"services\",\"grobi\",\"rules\"],\"readOnly\":false,\"type\":\"list of attribute set of (string or boolean or signed integer or list of string)\"},\"services.gromit-mpx.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Gromit-MPX annotation tool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"gromit-mpx\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.gromit-mpx.hotKey\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"F9\\\"\"},\"description\":\"A keysym or raw keycode that toggles the activation state of\\ngromit-mpx.  Set to `null` to disable the\\nhotkey in which case you'll have to activate gromit-mpx\\nmanually using the command line.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Insert\\\"\"},\"loc\":[\"services\",\"gromit-mpx\",\"hotKey\"],\"readOnly\":false,\"type\":\"null or string or (positive integer, meaning >0)\"},\"services.gromit-mpx.opacity\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"0.75\"},\"description\":\"Opacity of the drawing overlay.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"1.0\"},\"loc\":[\"services\",\"gromit-mpx\",\"opacity\"],\"readOnly\":false,\"type\":\"float between 0.0 and 1.0 (inclusive)\"},\"services.gromit-mpx.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gromit-mpx\"},\"description\":\"The gromit-mpx package to use.\",\"loc\":[\"services\",\"gromit-mpx\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.gromit-mpx.tools\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    color = \\\"red\\\";\\n    device = \\\"default\\\";\\n    size = 5;\\n    type = \\\"pen\\\";\\n  }\\n  {\\n    color = \\\"blue\\\";\\n    device = \\\"default\\\";\\n    modifiers = [\\n      \\\"SHIFT\\\"\\n    ];\\n    size = 5;\\n    type = \\\"pen\\\";\\n  }\\n  {\\n    color = \\\"yellow\\\";\\n    device = \\\"default\\\";\\n    modifiers = [\\n      \\\"CONTROL\\\"\\n    ];\\n    size = 5;\\n    type = \\\"pen\\\";\\n  }\\n  {\\n    arrowSize = 1;\\n    color = \\\"green\\\";\\n    device = \\\"default\\\";\\n    modifiers = [\\n      \\\"2\\\"\\n    ];\\n    size = 6;\\n    type = \\\"pen\\\";\\n  }\\n  {\\n    device = \\\"default\\\";\\n    modifiers = [\\n      \\\"3\\\"\\n    ];\\n    size = 75;\\n    type = \\\"eraser\\\";\\n  }\\n]\"},\"description\":\"Tool definitions for gromit-mpx to use.\\n\",\"loc\":[\"services\",\"gromit-mpx\",\"tools\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"services.gromit-mpx.tools.*.arrowSize\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"If not `null`, automatically draw an arrow\\nat the end of a stroke with the given size.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"2\"},\"loc\":[\"services\",\"gromit-mpx\",\"tools\",\"*\",\"arrowSize\"],\"readOnly\":false,\"type\":\"null or (positive integer, meaning >0)\"},\"services.gromit-mpx.tools.*.color\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"red\\\"\"},\"description\":\"The stroke (or recolor) color of the tool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"#ff00ff\\\"\"},\"loc\":[\"services\",\"gromit-mpx\",\"tools\",\"*\",\"color\"],\"readOnly\":false,\"type\":\"string\"},\"services.gromit-mpx.tools.*.device\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"description\":\"Use this tool with the given xinput device.  The device with\\nthe name default works with any input.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"default\\\"\"},\"loc\":[\"services\",\"gromit-mpx\",\"tools\",\"*\",\"device\"],\"readOnly\":false,\"type\":\"string\"},\"services.gromit-mpx.tools.*.modifiers\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Only activate this tool if the given modifiers are also active.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"SHIFT\\\"\\n]\"},\"loc\":[\"services\",\"gromit-mpx\",\"tools\",\"*\",\"modifiers\"],\"readOnly\":false,\"type\":\"list of (one of \\\"1\\\", \\\"2\\\", \\\"3\\\", \\\"4\\\", \\\"5\\\", \\\"SHIFT\\\", \\\"CONTROL\\\", \\\"ALT\\\", \\\"META\\\")\"},\"services.gromit-mpx.tools.*.size\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"5\"},\"description\":\"The tool size.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"3\"},\"loc\":[\"services\",\"gromit-mpx\",\"tools\",\"*\",\"size\"],\"readOnly\":false,\"type\":\"positive integer, meaning >0\"},\"services.gromit-mpx.tools.*.type\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pen\\\"\"},\"description\":\"Which type of tool this is.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"eraser\\\"\"},\"loc\":[\"services\",\"gromit-mpx\",\"tools\",\"*\",\"type\"],\"readOnly\":false,\"type\":\"one of \\\"pen\\\", \\\"eraser\\\", \\\"recolor\\\"\"},\"services.gromit-mpx.undoKey\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/gromit-mpx.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/gromit-mpx.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"F10\\\"\"},\"description\":\"A keysym or raw keycode that causes gromit-mpx to undo the\\nlast stroke.  Use this key along with the shift key to redo an\\nundone stoke.  Set to `null` to disable the\\nundo hotkey.\\n\",\"loc\":[\"services\",\"gromit-mpx\",\"undoKey\"],\"readOnly\":false,\"type\":\"null or string or (positive integer, meaning >0)\"},\"services.home-manager.autoExpire.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-expire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-expire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the Home Manager expire service that periodically expire your\\nold Home Manager generations.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"home-manager\",\"autoExpire\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.home-manager.autoExpire.frequency\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-expire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-expire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"monthly\\\"\"},\"description\":\"The interval at which the Home Manager auto expire is run.\\n\\nThis value is passed to the systemd timer configuration\\nas the `OnCalendar` option.\\n\\nThe format is described in {manpage}`systemd.time(7)`.\\n\\nOn Darwin, it must be one of: hourly, daily, weekly, monthly, semiannually, annually, which are implemented as defined in {manpage}`systemd.time(7)`.\\n\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"weekly\\\"\"},\"loc\":[\"services\",\"home-manager\",\"autoExpire\",\"frequency\"],\"readOnly\":false,\"type\":\"string\"},\"services.home-manager.autoExpire.store.cleanup\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-expire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-expire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable to cleanup Nix store when the Home Manager expire service runs.\\n\\nIt will use `nix-collect-garbage` to cleanup the store,\\nremoving all unreachable store objects from the current user\\n(i.e.: not only the expired Home Manager generations).\\n\\nThis may not be what you want, this is why this option is disabled\\nby default.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"home-manager\",\"autoExpire\",\"store\",\"cleanup\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.home-manager.autoExpire.store.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-expire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-expire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Options given to `nix-collect-garbage` when the service runs.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"--delete-older-than 30d\\\"\"},\"loc\":[\"services\",\"home-manager\",\"autoExpire\",\"store\",\"options\"],\"readOnly\":false,\"type\":\"string\"},\"services.home-manager.autoExpire.timestamp\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-expire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-expire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"-30 days\\\"\"},\"description\":\"Remove generations older than `TIMESTAMP` where `TIMESTAMP` is\\ninterpreted as in the -d argument of the date tool.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"-7 days\\\"\"},\"loc\":[\"services\",\"home-manager\",\"autoExpire\",\"timestamp\"],\"readOnly\":false,\"type\":\"string\"},\"services.home-manager.autoUpgrade.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-upgrade.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-upgrade.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the Home Manager upgrade service that periodically updates your Nix\\nconfiguration by running `home-manager switch`\\n.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"home-manager\",\"autoUpgrade\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.home-manager.autoUpgrade.flags\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-upgrade.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-upgrade.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra arguments passed to `home-manager switch`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--impure\\\"\\n  \\\"-b\\\"\\n  \\\"hmbak\\\"\\n]\"},\"loc\":[\"services\",\"home-manager\",\"autoUpgrade\",\"flags\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.home-manager.autoUpgrade.flakeDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-upgrade.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-upgrade.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${config.xdg.configHome}/home-manager\\\"\"},\"description\":\"Directory containing flake.nix.\\nAlso check `services.home-manager.autoUpgrade.useFlake` option.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/home/user/dotfiles\\\"\"},\"loc\":[\"services\",\"home-manager\",\"autoUpgrade\",\"flakeDir\"],\"readOnly\":false,\"type\":\"string\"},\"services.home-manager.autoUpgrade.frequency\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-upgrade.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-upgrade.nix\"}],\"description\":\"The interval at which the Home Manager auto upgrade is run.\\nThis value is passed to the systemd timer configuration\\nas the `OnCalendar` option.\\nThe format is described in {manpage}`systemd.time(7)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"weekly\\\"\"},\"loc\":[\"services\",\"home-manager\",\"autoUpgrade\",\"frequency\"],\"readOnly\":false,\"type\":\"string\"},\"services.home-manager.autoUpgrade.preSwitchCommands\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-upgrade.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-upgrade.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"if lib.versionAtLeast config.home.stateVersion \\\"26.05\\\"\\n   || !config.services.home-manager.autoUpgrade.useFlake\\nthen\\n  [ ]\\nelse\\n  [ \\\"nix flake update\\\" ]\\n\"},\"description\":\"Shell commands executed before `home-manager switch`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"${pkgs.gitMinimal}/bin/git pull\\\"\\n  \\\"nix flake update\\\"\\n]\\n\"},\"loc\":[\"services\",\"home-manager\",\"autoUpgrade\",\"preSwitchCommands\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.home-manager.autoUpgrade.useFlake\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/home-manager-auto-upgrade.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/home-manager-auto-upgrade.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to use flake-based Home Manager configuration.\\n\\nFlake URI uses FQDN, long, and short hostnames, and you must configure the corresponding user@host key in `homeConfigurations`. For example: user@hostname or user@host.example.com.\\n\\nAlso check `services.home-manager.autoUpgrade.flakeDir` option.\\n\",\"loc\":[\"services\",\"home-manager\",\"autoUpgrade\",\"useFlake\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.hound.databasePath\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/hound.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/hound.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$XDG_DATA_HOME/hound\\\"\"},\"description\":\"The Hound database path.\",\"loc\":[\"services\",\"hound\",\"databasePath\"],\"readOnly\":false,\"type\":\"absolute path\"},\"services.hound.enable\":{\"declarations\":[{\"name\":\"<h