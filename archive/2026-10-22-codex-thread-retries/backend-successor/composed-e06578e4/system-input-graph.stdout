Expression\",\"text\":\"{ }\"},\"description\":\"Extra configuration options to add to the account section.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  autorefresh = 20;\\n}\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"offlineimap\",\"extraConfig\",\"account\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean)\"},\"accounts.email.accounts.<name>.offlineimap.extraConfig.local\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/offlineimap>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/offlineimap\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra configuration options to add to the local account\\nsection.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  sync_deletes = true;\\n}\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"offlineimap\",\"extraConfig\",\"local\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean)\"},\"accounts.email.accounts.<name>.offlineimap.extraConfig.remote\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/offlineimap>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/offlineimap\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra configuration options to add to the remote account\\nsection.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  expunge = false;\\n  maxconnections = 2;\\n}\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"offlineimap\",\"extraConfig\",\"remote\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean)\"},\"accounts.email.accounts.<name>.offlineimap.postSyncHookCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/offlineimap>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/p