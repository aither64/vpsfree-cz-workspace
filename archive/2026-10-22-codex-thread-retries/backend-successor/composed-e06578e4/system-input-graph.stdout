catch-conflicts-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"4gaqkl0cv4iiiphph3rj88hnv3k8a6gp-python3.14-setuptools-83.0.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"4lv4n0pnxmff695ay8rkggpzjak3dj9f-python-metadata-check-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"a39ysnr0w921df8pfgs1amjlwbnxb3m6-python3.14-pycparser-3.00.drv":{"dynamicOutputs":{},"outputs":["out"]},"bh24jswvl9r4lxbj57vb9ll1r1b16ghf-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"gx3br5hwcasb1qwiwn35cvlbc5v3kh69-pytest-check-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"hqr56gzs7s5j99y18hix0cvjlxx99rq7-pypa-build-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"ksaw14xc0w40cm0m0h27sjdmjh4a7s5r-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"l2bcr3v2q94kn3d61p63b2lp29sj9p4h-python-remove-tests-dir-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"lz0kkmp5nkrhyvymqqsmanbzwmkm1bwb-libffi-3.8.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"qhphrb6v6zmszkvn1fw89hdh4a6ikkgw-python-output-dist-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"qpckizfinpgk8mvl0awxbfw4xykrpshf-python3-3.14.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"svra7wnq5jbh36a4p1myr1if3ss7qh2g-bash-5.3p15.drv":{"dynamicOutputs":{},"outputs":["out"]},"v0xcxpy6c8vwp52mc56y0z992s4zmcxg-python-remove-bin-bytecode-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"wcljc7918qqlcyagkdzv68q5f0spcaqr-python-namespaces-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"wfmkndqrh0c2mqg0blx9rdkzs4ingmcx-wrap-python-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"xzv7asg6ab7v6830my379mx80djmrjk2-python-runtime-deps-check-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"z95w3znb1srcljs4x6igfrbpn9krih7z-python-imports-check-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"python3.14-cffi-2.1.0","outputs":{"dist":{"path":"nssc33j9syv10lbdr56klynjdj9v4i