in/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"nginx.conf","nativeBuildInputs":"/nix/store/9ijhpv6jzkm9yfj86s0nhpq0dl9wzbd8-gixy-0.1.21","out":"/nix/store/j1jvhxfsdzybjfb3qj57i4la4lxmi7ii-nginx.conf","outputs":"out","passAsFile":"buildCommand text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"\n\npid /run/nginx/nginx.pid;\nerror_log stderr;\ndaemon off;\n\n\n\n\n\nevents {\n  \n}\n\n\nhttp {\n  # Load mime types and configure maximum size of the types hash tables.\ninclude /nix/store/xql1i59wn5n0v4hxx1xhji9p6zns8hsi-mailcap-2.1.54/etc/nginx/mime.types;\ntypes_hash_max_size 2688;\n\ninclude /nix/store/smpkfhyjj22b4zy1f0cprzfhr0nimllr-nginx-1.30.6/conf/fastcgi.conf;\ninclude /nix/store/smpkfhyjj22b4zy1f0cprzfhr0nimllr-nginx-1.30.6/conf/uwsgi_params;\n\ndefault_type application/octet-stream;\n\n\n  \n  upstream dev-workspace {\n  server unix:/run/dev-workspaces/router.sock ;\n\n  \n}\n\n\n  \n\n  ssl_protocols TLSv1.2 TLSv1.3;\n  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;\n  \n\n  # Consider https://ssl-config.mozilla.org/#server=nginx&config=intermediate as the lower bound\n\nssl_conf_command Groups \"X25519MLKEM768:X25519:P-256:P-384\";\nssl_session_timeout 1d;\nssl_session_cache shared:SSL:10m;\n# Breaks forward secrecy: https://github.com/mozilla/server-side-tls/issues/135\nssl_session_tickets off;\n# We don't enable insecure ciphers by default, so this allows\n# clients to pick the most performant, per https://github.com/mozilla/server-side-tls/issues/260\nssl_prefer_server_ciphers off;\n\n\n  \n\n  \n\n  \n\n  proxy_redirect          off;\nproxy_connect_timeout   60s;\nproxy_send_timeout      60s;\nproxy_read_timeout      60s;\nproxy_http_version      1.1;\n# don't let clients close the keep-alive connection to upstream. See the nginx blog for details:\n# https://www.nginx.com/blog/avoiding-top-10-nginx-configuration-mistakes/#no-keepalives\nproxy_set_header        \"Connection\" \"\";\ninclude /nix/store/61hf7qsi2f3rxiv19qh2bq1ccw2m7s7p-nginx-recommended-proxy_set_header-headers.conf;\n\n\n  \n\n  \n\n  \n\n  \n\n  \n\n  # $connection_upgrade is used for websocket proxying\n  map $http_upgrade $connection_upgrade {\n      default upgrade;\n      ''      close;\n  }\n  client_max_body_size 10m;\n\n  server_tokens off;\n\n  \n\n  \n\n  server {\n  \n            listen 172.16.106.40:80 ;\n\n  server_name *.workspace.aitherdev.int.vpsfree.cz vpsfree-cz.workspace.aitherdev.int.vpsfree.cz vpsfree-cz-workspace.aitherdev.int.vpsfree.cz;\n\n  location / {\n    return 301 https://$host$request_uri;\n  }\n  \n}\n\n\nserver {\n  \n            listen 172.16.106.40:443 ssl ;\n  server_name *.workspace.aitherdev.int.vpsfree.cz vpsfree-cz.workspace.aitherdev.int.vpsfree.cz vpsfree-cz-workspace.aitherdev.int.vpsfree.cz;\n  http2 on;\n\n  \n  ssl_certificate /var/lib/dev-workspaces/tls/current/server.pem;\nssl_certificate_key /var/lib/dev-workspaces/tls/current/server-key.pem;\n\n  \n  \n  \n\n  auth_basic secured;\nauth_basic_user_file /var/lib/dev-workspaces/auth/htpasswd;\n\n\n  \n\n  \n  \n  location / {\n  proxy_pass http://dev-workspace;\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  proxy_buffering off;\nproxy_read_timeout 1h;\nclient_max_body_size 16m;\nproxy_set_header Authorization \"\";\nproxy_hide_header Strict-Transport-Security;\n\n  include /nix/store/61hf7qsi2f3rxiv19qh2bq1ccw2m7s7p-nginx-recommended-proxy_set_header-headers.conf;\n  \n  \n}\n\n\n  add_header Strict-Transport-Security \"max-age=31536000\" always;\n\n}\n\n\n\nserver {\n  \n            listen 172.16.106.40:80 ;\n  server_name codex-lb.aitherdev.int.vpsfree.cz ;\n  \n  \n  \n  \n  \n  \n\n  \n\n  \n\n  \n  \n  location / {\n  proxy_pass http://127.0.0.1:2455;\n  \n  proxy_http_version 1.1;\nproxy_set_header Upgrade $http_upgrade;\nproxy_set_header Connection $connection_upgrade;\n\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  include /nix/store/61hf7qsi2f3rxiv19qh2bq1ccw2m7s7p-nginx-recommended-proxy_set_header-headers.conf;\n  \n  \n}\n\nlocation = /backend-api/codex {\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  return 403;\n  \n  \n  \n  \n}\n\nlocation = /backend-api/transcribe {\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  return 403;\n  \n  \n  \n  \n}\n\nlocation = /v1 {\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  return 403;\n  \n  \n  \n  \n}\n\nlocation ^~ /backend-api/codex/ {\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  return 403;\n  \n  \n  \n  \n}\n\nlocation ^~ /backend-api/transcribe/ {\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  return 403;\n  \n  \n  \n  \n}\n\nlocation ^~ /v1/ {\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  return 403;\n  \n  \n  \n  \n}\n\n\n  \n}\n\n\n\nserver {\n  \n            listen 172.16.106.40:80 ;\n  server_name kb-cs.aitherdev.int.vpsfree.cz ;\n  \n  \n  \n  \n  \n  \n\n  \n\n  \n\n  \n  \n  location / {\n  proxy_pass http://192.168.123.2:80;\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  include /nix/store/61hf7qsi2f3rxiv19qh2bq1ccw2m7s7p-nginx-recommended-proxy_set_header-headers.conf;\n  \n  \n}\n\n\n  \n}\n\n\n\nserver {\n  \n            listen 172.16.106.40:80 ;\n  server_name kb-en.aitherdev.int.vpsfree.cz ;\n  \n  \n  \n  \n  \n  \n\n  \n\n  \n\n  \n  \n  location / {\n  proxy_pass http://192.168.123.2:80;\n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  include /nix/stor