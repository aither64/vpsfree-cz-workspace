pe\"],\"readOnly\":false,\"type\":\"null or one of \\\"standard\\\", \\\"notification\\\", \\\"symbolic\\\"\"},\"services.cbatticon.lowLevelPercent\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/cbatticon.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/cbatticon.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Low level percentage of the battery in percent (without the\\npercent symbol).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"20\"},\"loc\":[\"services\",\"cbatticon\",\"lowLevelPercent\"],\"readOnly\":false,\"type\":\"null or integer between 0 and 100 (both inclusive)\"},\"services.cbatticon.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/cbatticon.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/cbatticon.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.cbatticon\"},\"description\":\"The cbatticon package to use. Use {var}`pkgs.batticonplus`\\nfor wayland support.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.batticonplus\"},\"loc\":[\"services\",\"cbatticon\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.cbatticon.updateIntervalSeconds\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/cbatticon.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/cbatticon.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Number of seconds between updates of the battery information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"5\"},\"loc\":[\"services\",\"cbatticon\",\"updateIntervalSeconds\"],\"readOnly\":false,\"type\":\"null or (positive integer, meaning >0)\"},\"services.clipcat.ctlSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/clipcat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/clipcat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for clipcatctl. All available options can be found\\nhere: <https://github.com/xrelkd/clipcat?tab=readme-ov-file#configuration>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  {\\n    server_endpoint = \\\"/run/user/<user-id>/clipcat/grpc.sock\\\";\\n    log = {\\n      file_path = \\\"/path/to/log/file\\\";\\n      emit_journald = true;\\n      emit_stdout = false;\\n      emit_stderr = false;\\n      level = \\\"INFO\\\";\\n    };\\n  }\\n''\"},\"loc\":[\"services\",\"clipcat\",\"ctlSettings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"services.clipcat.daemonSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/clipcat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/clipcat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  daemonize = true;\\n}\"},\"description\":\"Configuration settings for clipcatd. All available options can be found\\nhere: <https://github.com/xrelkd/clipcat?tab=readme-ov-file#configuration>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  {\\n    daemonize = true;\\n    max_history = 50;\\n    history_file_path = \\\"/home/<username>/.cache/clipcat/clipcatd-history\\\";\\n    pid_file = \\\"/run/user/<user-id>/clipcatd.pid\\\";\\n    primary_threshold_ms = 5000;\\n    log = {\\n      file_path = \\\"/path/to/log/file\\\";\\n      emit_journald = true;\\n      emit_stdout = false;\\n      emit_stderr = false;\\n      level = \\\"INFO\\\";\\n    };\\n  }\\n''\"},\"loc\":[\"services\",\"clipcat\",\"daemonSettings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"services.clipcat.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/clipcat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/clipcat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable clipcat.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"clipcat\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.clipcat.enableSystemdUnit\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/clipcat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/clipcat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Enable clipcat's Systemd Unit.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"services\",\"clipcat\",\"enableSystemdUnit\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.clipcat.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/clipcat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/clipcat.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"services\",\"clipcat\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.clipcat.menuSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/clipcat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/clipcat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for clipcat-menu. All available options can be found\\nhere: <https://github.com/xrelkd/clipcat?tab=readme-ov-file#configuration>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  {\\n    server_endpoint = \\\"/run/user/<user-id>/clipcat/grpc.sock\\\";\\n    finder = \\\"rofi\\\";\\n    rofi = {\\n      line_length = 100;