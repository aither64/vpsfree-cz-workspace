c_getcwd_path_max=\"no, but it is partly working\" gl_cv_have_unlimited_file_name_length=no gl_cv_func_copy_file_range=no gl_cv_onwards_func_copy_file_range=no\n\n# Build\n#\n# Set SUBDIRS=. to avoid cd'ing to gnulib-tests. Those have\n# compilation issues related to pthread and linux/*.h not\n# being available.\nmake -j $NIX_BUILD_CORES AR=\"tcc -ar\" MAKEINFO=\"true\" SUBDIRS=.\n\n# Install\nmake -j $NIX_BUILD_CORES install MAKEINFO=\"true\" SUBDIRS=.\n\n# Remove documentation not needed in the bootstrap chain.\nrm -rf $out/share/info $out/share/man\n","builder":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","name":"bootstrap-coreutils-musl-9.10","out":"/nix/store/z498zyjm053c83r00qnwgg2pjwgc10d2-bootstrap-coreutils-musl-9.10","passAsFile":"buildCommand","pname":"bootstrap-coreutils-musl","system":"x86_64-linux","version":"9.10"},"inputs":{"drvs":{"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"4hfq6p045k7knv86fc57kq5cnf2djia6-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"54jdq8vp944qn49b18harrbjw34dlxcp-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"bv4a5fw05q4ysq24wy0z06bd5jysq1p2-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"d9hngw468h7b7fpcyx284kqwdgcn3gzy-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"j1aiw0pfh51nyay8zavyx3adq86xdnkl-tinycc-musl-unstable-2025-12-03-compiler.drv":{"dynamicOutputs":{},"outputs":["out"]},"jvn6rxfx2j66k0svyl5njyqzq2nh0v5s-gnutar-musl-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"l6a6rj0gy31gp6k7k80qzn4ni0yvyzgh-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a9pds57ms69gfi2ya-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"x2dafg049vyrb1sm6jkydck0b1da2zab-coreutils-9.10.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"xlhf3ibq6r6qy2myin330ay7qscfzi1g-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-