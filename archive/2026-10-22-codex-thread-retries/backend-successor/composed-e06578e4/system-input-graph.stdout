s = 200;\\n  };\\n}\\n```\\nbecomes:\\n```nushell\\n$env.config.completions.external.enable = true\\n$env.config.completions.external.max_results = 200\\n$env.config.show_banner = false\\n```\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  history = {\\n    format = \\\"sqlite\\\";\\n  };\\n  show_banner = false;\\n}\"},\"loc\":[\"programs\",\"nushell\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (null or (Nushell inline value) or boolean or signed integer or floating point number or string or absolute path or (attribute set of Nushell values) or (list of Nushell values))\"},\"programs.nushell.shellAliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nushell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nushell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set that maps aliases (the top level attribute names in\\nthis option) to command strings or directly to build outputs.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  g = \\\"git\\\";\\n  ll = \\\"ls -l\\\";\\n}\"},\"loc\":[\"programs\",\"nushell\",\"shellAliases\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.nvchecker.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nvchecker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nvchecker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable nvchecker.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nvchecker\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nvchecker.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nvchecker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nvchecker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.nvchecker\"},\"description\":\"The nvchecker package to use.\",\"loc\":[\"programs\",\"nvchecker\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.nvchecker.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nvchecker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nvchecker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"__config__ = {\\n  oldver = \\\"old_ver.json\\\";\\n  newver = \\\"new_ver.json\\\";\\n};\\n\"},\"description\":\"Configuration written to\\n{file}`$HOME/Library/Application Support/nvchecker/nvchecker.toml` (on Darwin) or\\n{file}`$XDG_CONFIG_HOME/nvchecker/nvchecker.toml` (otherwise).\\nSee <https://nvchecker.readthedocs.io/en/stable/usage.html#configuration-files>\\nfor the full list of options.\\n\\nEnvironment variables and `~` are expanded,\\nand relative paths are relative to\\n{file}`${config.home.homeDirectory}/Library/Application Support/nvchecker/nvchecker/` (on Darwin)\\nor {file}`${config.xdg.configHome}/nvchecker/` (otherwise).\\n\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  __config__ = {\\n    keyfile = \\\"keyfile.toml\\\";\\n    newver = \\\"~/separately_placed_newver.json\\\";\\n    oldver = \\\"my_custom_oldver.json\\\";\\n  };\\n  nvchecker = {\\n    github = \\\"lilydjwg/nvchecker\\\";\\n    source = \\\"github\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"nvchecker\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"programs.nvchecker.settings.__config__\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nvchecker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nvchecker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  oldver = \\\"old_ver.json\\\";\\n  newver = \\\"new_ver.json\\\";\\n};\\n\"},\"description\":\"See <https://nvchecker.readthedocs.io/en/stable/usage.html#configuration-files>.\\n\\nEnvironment variables and `~` are expanded,\\nand relative paths are relative to\\n{file}`${config.home.homeDirectory}/Library/Application Support/nvchecker/nvchecker/` (on Darwin)\\nor {file}`${config.xdg.configHome}/nvchecker/` (otherwise).\\n\\n\",\"loc\":[\"programs\",\"nvchecker\",\"settings\",\"__config__\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"programs.nvchecker.settings.__config__.newver\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nvchecker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nvchecker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"new_ver.json\\\"\"},\"description\":\"The file to store 'new' (i.e. available) versions in.\\n\\nEnvironment variables and `~` are expanded,\\nand relative paths are relative to\\n{file}`${config.home.homeDirectory}/Library/Application Support/nvchecker/nvchecker/` (on Darwin)\\nor {file}`${config.xdg.configHome}/nvchecker/` (otherwise).\\n\\n\",\"loc\":[\"programs\",\"nvchecker\",\"settings\",\"__config__\",\"newver\"],\"readOnly\":false,\"type\":\"path\"},\"programs.nvchecker.settings.__config__.oldver\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nvchecker.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nvchecker.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"old_ver.json\\\"\"},\"description\":\"The file to store 'old' (i.e. installed) version information in.\\n\\nEnvironment variables and `~` are expanded,\\nand relative paths are relative to\\n{file}`${config.home.homeDirectory}/Library/Application Support/nvchecker/nvchecker/` (on Darwin)\\nor {file}`${config.xdg.configHome}/nvchecker/` (otherwise).\\n\\n\",\"loc\":[\"programs\",\"nvchecker\",\"settings\",\"__config__\",\"oldver\"],\"readOnly\":false,\"type\":\"path\"},\"programs.nyxt.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nyxt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nyxt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Configuration file for Nyxt, written in the Common Lisp\\nprogramming language.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  (in-package #:nyxt-user)\\n  \\n  (defvar *my-search-engines*\\n    (list\\n     (make-instance 'search-engine\\n                    :name \\\"Google\\\"\\n                    :shortcut \\\"goo\\\"\\n                    #+nyxt-4 :control-url #+nyxt-3 :search-url\\n                    \\\"https://duckduckgo.com/?q=~a\\\")\\n     (make-instance 'search-engine\\n                    :name \\\"MDN\\\"\\n                    :shortcut \\\"mdn\\\"\\n                    #+nyxt-4 :control-url #+nyxt-3 :search-url\\n                    \\\"https://developer.mozilla.org/en-US/search?q=~a\\\")))\\n  \\n  (define-configuration browser\\n    ((restore-session-on-startup-p nil)\\n     (default-new-buffer-url (quri:uri \\\"https://github.com/atlas-engineer/nyxt\\\"))\\n     (external-editor-program (if (member :flatpak *features*)\\n                                  \\\"flatpak-spawn --host emacsclient -r\\\"\\n                                  \\\"emacsclient -r\\\"))\\n     #+nyxt-4\\n     (search-engine-suggestions-p nil)\\n     #+nyxt-4\\n     (search-engines (append %slot-default% *my-search-engines*))\\n     ;; Sets the font for the Nyxt UI (not for webpages).\\n     (theme (make-instance 'theme:theme\\n                           :font-family \\\"Iosevka\\\"\\n                           :monospace-font-family \\\"Iosevka\\\"))\\n     ;; Whether code sent to the socket gets executed.  You must understand the\\n     ;; risks before enabling this: a privileged user with access to your system\\n     ;; can then take control of the browser and execute arbitrary code under your\\n     ;; user profile.\\n     ;; (remote-execution-p t)\\n     ))\\n''\"},\"loc\":[\"programs\",\"nyxt\",\"config\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.nyxt.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nyxt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nyxt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Nyxt.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"nyxt\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.nyxt.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/nyxt.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/nyxt.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.nyxt\"},\"description\":\"The nyxt package to use.\",\"loc\":[\"programs\",\"nyxt\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.obs-studio.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/obs-studio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/obs-studio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable obs-studio.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"obs-studio\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.obs-studio.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/obs-studio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/obs-studio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.obs-studio\"},\"description\":\"The obs-studio package to use.\",\"loc\":[\"programs\",\"obs-studio\",\"package\"],\"readOnly\":false,\"type\":\"pac