x/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"initrd-find-nixos-closure-start","__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","checkPhase":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash -n -O extglob \"$target\"\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"/bin/initrd-find-nixos-closure-start","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"unit-script-initrd-find-nixos-closure-start","nativeBuildInputs":"","out":"/nix/store/a7vcwq5x4fhxab6wqgrh1gdiphridbkq-unit-script-initrd-find-nixos-closure-start","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash\nset -e\n\nset -uo pipefail\nexport PATH=\"/bin:/nix/store/rfdvhfbdhrr2ijcm9vnbydbbw329wswq-util-linux-minimal-2.42.3-bin/bin:/nix/store/i5zhz6fs38cyvvd2wpk1rfqcy0dj9lnk-nixos-init-0.1.0/bin\"\n\n# Figure out what closure to boot\nclosure=\nfor o in $(< /proc/cmdline); do\n    case $o in\n        init=*)\n            IFS=\"=\" read -r -a initParam <<< \"$o\"\n            closure=\"${initParam[1]}\"\n            ;;\n    esac\ndone\n\n# Sanity check\nif [ -z \"${closure:-}\" ]; then\n  echo 'No init= parameter on the kernel command line' >&2\n  exit 1\nfi\n\n# Resolve symlinks in the init parameter. We need this for some boot loaders\n# (e.g. boot.loader.generationsDir).\nclosure=\"$(resolve-in-root /sysroot \"$closure\")\"\n\n# Assume the directory containing the init script is the closure.\nclosure=\"$(dirname \"$closure\")\"\n\nln --symbolic \"$closure\" /nixos-closure\n\n# If we are not booting a NixOS closure (e.g. init=/bin/sh),\n# we don't know what root to prepare so we don't do anything\nif ! [ -x \"/sysroot$(readlink \"/sysroot$closure/prepare-root\" || echo \"$closure/prepare-root\")\" ]; then\n  echo \"NEW_INIT=${initParam[1]}\" > /etc/switch-root.conf\n  echo \"$closure does not look like a NixOS installation - not activating\"\n  exit 0\nfi\necho 'NEW_INIT=' > /etc/switch-root.conf\n\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"8yyldmxg7wc5inpyqjd8v5f19kkw6k0w-nixos-init-0.1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"a7sw3xa7f8ahlfrcf3q7xzy4rhdhvsvh-util-linux-minimal-2.42.3.drv":{"dynamicOutputs":{},"outputs":["bin"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-initrd-find-nixos-closure-start","outputs":{"out":{"path":"a7vcwq5x4fhxab6wqgrh1gdiphridbkq-unit-script-initrd-find-nixos-closure-start"}},"system":"x86_64-linux","version":4},"wyr8lszvwchw2cwrppwlawhh46j71wk1-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/9ddl0gpd6blir4axhsj8wdzv00w4fwk5-source"},"inputs":{"drvs":{"3fc7klhja3mn322hjxl4bax4mk3m6h8l-mirrors-list.drv":