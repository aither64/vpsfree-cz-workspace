\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Signature configuration.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"signature\"],\"readOnly\":false,\"type\":\"submodule\"},\"accounts.email.accounts.<name>.signature.command\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A command that generates a signature.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.writeScript \\\"signature\\\" \\\"echo This is my signature\\\"\\n\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"signature\",\"command\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"accounts.email.accounts.<name>.signature.delimiter\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  --\\n''\"},\"description\":\"The delimiter used between the document and the signature.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"~*~*~*~*~*~*~*~*~*~*~*~\\n\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"signature\",\"delimiter\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.signature.htmlFormat\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether Thunderbird should interpret {option}`text` as an HTML signature.\\n\\nThis maps to Thunderbird's `mail.identity.id_*.htmlSigFormat`\\npreference. The signature content itself is still written through\\n`mail.identity.id_*.htmlSigText`.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"signature\",\"htmlFormat\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.signature.showSignature\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"none\\\"\"},\"description\":\"Method to communicate the signature.\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"signature\",\"showSignature\"],\"readOnly\":false,\"type\":\"one of \\\"append\\\", \\\"attach\\\", \\\"none\\\"\"},\"accounts.email.accounts.<name>.signature.text\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Signature content.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  --\\n  Luke Skywalker\\n  May the force be with you.\\n''\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"signature\",\"text\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.smtp\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The SMTP configuration to use for this account.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"smtp\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"accounts.email.accounts.<name>.smtp.authentication\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The authentication mechanism.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"plain\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"smtp\",\"authentication\"],\"readOnly\":false,\"type\":\"null or string or one of \\\"anonymous\\\", \\\"apop\\\", \\\"clear\\\", \\\"cram_md5\\\", \\\"digest_md5\\\", \\\"gssapi\\\", \\\"login\\\", \\\"ntlm\\\", \\\"plain\\\", \\\"xoauth2\\\"\"},\"accounts.email.accounts.<name>.smtp.host\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"description\":\"Hostname of SMTP server.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"smtp.example.org\\\"\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"smtp\",\"host\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.smtp.port\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The port on which the SMTP server listens. If\\n`null` then the default port is used.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"465\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"smtp\",\"port\"],\"readOnly\":false,\"type\":\"null or 16 bit unsigned integer; between 0 and 65535 (both inclusive)\"},\"accounts.email.accounts.<name>.smtp.tls\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for secure connections.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"smtp\",\"tls\"],\"readOnly\":false,\"type\":\"submodule\"},\"accounts.email.accounts.<name>.smtp.tls.certificatesFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"config.accounts.email.certificatesFile\\\"\"},\"description\":\"Path to file containing certificate authorities that should\\nbe used to validate the connection authenticity. If\\n`null` then the system default is used.\\nNote, if set then the system default may still be accepted.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"smtp\",\"tls\",\"certificatesFile\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"accounts.email.accounts.<name>.smtp.tls.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable TLS/SSL.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"smtp\",\"tls\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.smtp.tls.useStartTls\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to use STARTTLS. This is discouraged and should be avoided if\\npossible. See <https://datatracker.ietf.org/doc/html/rfc8314> for\\nmore.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"smtp\",\"tls\",\"useStartTls\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.thunderbird.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the Thunderbird mail client for this account.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.thunderbird.messageFilters\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of message filters to add to this Thunderbird account configuration.\\n\\nHome Manager writes these to Thunderbird's per-account\\n`msgFilterRules.dat` file under the profile mail server\\ndirectory, for example `ImapMail/<server>/msgFilterRules.dat`.\\n\\nThunderbird does not publish a stable reference for all fields\\nin this file. To migrate existing filters, inspect an existing\\n`msgFilterRules.dat` file and translate each filter block into\\nthis option.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    action = \\\"Mark read\\\";\\n    condition = \\\"ALL\\\";\\n    enabled = true;\\n    name = \\\"Mark as Read on Archive\\\";\\n    type = \\\"128\\\";\\n  }\\n]\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"messageFilters\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"accounts.email.accounts.<name>.thunderbird.messageFilters.*.action\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"description\":\"Action to perform on matched messages.\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"messageFilters\",\"*\",\"action\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.thunderbird.messageFilters.*.actionValue\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Argument passed to the filter action, e.g. a folder path.\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"messageFilters\",\"*\",\"actionValue\"],\"readOnly\":false,\"type\":\"null or string\"},\"accounts.email.accounts.<name>.thunderbird.messageFilters.*.condition\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"description\":\"Condition to match messages against.\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"messageFilters\",\"*\",\"condition\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.thunderbird.messageFilters.*.enabled\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether this filter is currently active.\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"messageFilters\",\"*\",\"enabled\"],\"readOnly\":false,\"type\":\"boolean\"},\"accounts.email.accounts.<name>.thunderbird.messageFilters.*.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Extra settings to apply to the filter\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"messageFilters\",\"*\",\"extraConfig\"],\"readOnly\":false,\"type\":\"null or string\"},\"accounts.email.accounts.<name>.thunderbird.messageFilters.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"description\":\"Name for the filter.\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"messageFilters\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.thunderbird.messageFilters.*.text\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The raw text of the filter.\\nNote that this will override all other options.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"messageFilters\",\"*\",\"text\"],\"readOnly\":false,\"type\":\"null or string\"},\"accounts.email.accounts.<name>.thunderbird.messageFilters.*.type\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"description\":\"Thunderbird filter type bitmask written as the\\n`type=\\\"...\\\"` field in `msgFilterRules.dat`.\\n\\nThunderbird does not publish a stable table for this\\nbitmask. To reuse an existing value, inspect the\\naccount's `msgFilterRules.dat` file and copy the\\n`type=\\\"...\\\"` field from a comparable filter.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"messageFilters\",\"*\",\"type\"],\"readOnly\":false,\"type\":\"string\"},\"accounts.email.accounts.<name>.thunderbird.perIdentitySettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"_: { }\"},\"description\":\"Extra settings to add to each identity of this Thunderbird\\naccount configuration. The {var}`id` given as\\nargument is an automatically generated identifier.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"id: {\\n  \\\"mail.identity.id_${id}.protectSubject\\\" = false;\\n  \\\"mail.identity.id_${id}.autoEncryptDrafts\\\" = false;\\n};\\n\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"perIdentitySettings\"],\"readOnly\":false,\"type\":\"function that evaluates to a(n) attribute set of (boolean or signed integer or string)\"},\"accounts.email.accounts.<name>.thunderbird.profiles\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of Thunderbird profiles for which this account should be\\nenabled. If this list is empty (the default), this account will\\nbe enabled for all declared profiles.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"profile1\\\"\\n  \\\"profile2\\\"\\n]\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"profiles\"],\"readOnly\":false,\"type\":\"list of string\"},\"accounts.email.accounts.<name>.thunderbird.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/thunderbird.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/thunderbird.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"_: { }\"},\"description\":\"Extra settings to add to this Thunderbird account configuration.\\nThe {var}`id` given as argument is an automatically\\ngenerated account identifier.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"id: {\\n  \\\"mail.server.server_${id}.check_new_mail\\\" = false;\\n};\\n\"},\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"thunderbird\",\"settings\"],\"readOnly\":false,\"type\":\"function that evaluates to a(n) attribute set of (boolean or signed integer or string)\"},\"accounts.email.accounts.<name>.userName\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The server username of this account. This will be used as\\nthe SMTP, IMAP, and JMAP user name.\\n\",\"loc\":[\"accounts\",\"email\",\"accounts\",\"<name>\",\"userName\"],\"readOnly\":false,\"type\":\"null or string\"},\"accounts.email.certificatesFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/etc/ssl/certs/ca-certificates.crt\\\"\"},\"description\":\"Path to default file containing certificate authorities that\\nshould be used to validate the connection authenticity. This\\npath may be overridden on a per-account basis.\\n\",\"loc\":[\"accounts\",\"email\",\"certificatesFile\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"accounts.email.maildirBasePath\":{\"declarations\":[{\"name\":\"<home-manager/modules/accounts/email.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/accounts/email.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Maildir\\\"\"},\"description\":\"The base directory for account maildir directories. May be a\\nrelative path (e.g. the user setting this value as \\\"MyMaildir\\\"),\\nin which case it is relative the home directory (e.g. resulting\\nin \\\"~/MyMaildir\\\").\\n\",\"loc\":[\"accounts\",\"email\",\"maildirBasePath\"],\"readOnly\":false,\"type\":\"string\"},\"dbus.packages\":{\"declarations\":[{\"name\":\"<home-manager/modules/dbus.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/dbus.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Packages whose D-Bus configuration files should be included in\\nthe configuration of the D-Bus session-wide message bus. Specifically,\\nfiles in «pkg»/share/dbus-1/services will be included in the user's\\n$XDG_DATA_HOME/dbus-1/services directory.\\n\",\"loc\":[\"dbus\",\"packages\"],\"readOnly\":false,\"type\":\"list of package\"},\"dconf.databases\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/dconf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/dconf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings to write to specific dconf user databases.\\nSee [](#opt-dconf.settings) for details.\\n\",\"loc\":[\"dconf\",\"databases\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of attribute set of (GVariant value)\"},\"dconf.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/dconf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/dconf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings to write to the dconf configuration system.\\n\\nNote that the database is strongly-typed so you need to use the same types\\nas described in the GSettings schema. For example, if an option is of type\\n`uint32` (`u`), you need to wrap the number\\nusing the `lib.hm.gvariant.mkUint32` constructor.\\nOtherwise, since Nix integers are implicitly coerced to `int32`\\n(`i`), it would get stored in the database as such, and GSettings\\nmight be confused when loading the setting.\\n\\nYou might want to use [dconf2nix](https://github.com/gvolpe/dconf2nix)\\nto convert dconf database dumps into compatible Nix expression.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"org/gnome/calculator\\\" = {\\n    button-mode = \\\"programming\\\";\\n    show-thousands = true;\\n    base = 10;\\n    word-size = 64;\\n    window-position = lib.hm.gvariant.mkTuple [100 100];\\n  };\\n}\\n\"},\"loc\":[\"dconf\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (GVariant value)\"},\"editorconfig.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/editorconfig.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/editorconfig.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable EditorConfig home configuration file.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"editorconfig\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"editorconfig.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/editorconfig.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/editorconfig.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$HOME/.editorconfig`.\\n`root = true` is automatically added to the file,\\nit must not be added here.\\nSee <https://editorconfig.org> for documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"*\\\" = {\\n    charset = \\\"utf-8\\\";\\n    end_of_line = \\\"lf\\\";\\n    trim_trailing_whitespace = true;\\n    insert_final_newline = true;\\n    max_line_width = 78;\\n    indent_style = \\\"space\\\";\\n    indent_size = 4;\\n  };\\n};\\n\"},\"loc\":[\"editorconfig\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"fonts.fontconfig.antialiasing\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/fontconfig.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/fontconfig.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to enable font antialiasing.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"fonts\",\"fontconfig\",\"antialiasing\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"fonts.fontconfig.configFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/fontconfig.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/fontconfig.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra font config files that will be added to `~/.config/fontconfig/conf.d/`.\\nFiles are named like `fontconfig/conf.d/{priority}-{label}.conf`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  commit-mono-options = {\\n    enable = true;\\n    priority = 80;\\n    source = \\\"./resources/fontconfig/commit-mono.conf\\\";\\n  };\\n  tamzen = {\\n    enable = true;\\n    label = \\\"tamzen-disable-antialiasing\\\";\\n    priority = 90;\\n    text = ''\\n      <?xml version=\\\"1.0\\\"?>\\n      <!DOCTYPE fontconfig SYSTEM \\\"fonts.dtd\\\">\\n      \\n      <fontconfig>\\n        <description>Disable anti-aliasing for Tamzen since it is a bitmap font</description>\\n        <match target=\\\"pattern\\\">\\n          <test name=\\\"family\\\" compare=\\\"eq\\\" qual=\\\"any\\\">\\n            <string>Tamzen</string>\\n          </test>\\n          <edit name=\\\"antialias\\\" mode=\\\"assign\\\">\\n            <bool>false</bool>\\n          </edit>\\n        </match>\\n      </fontconfig>\\n    '';\\n  };\\n}\"},\"loc\":[\"fonts\",\"fontconfig\",\"configFile\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"fonts.fontconfig.configFile.<name>.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/fontconfig.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/fontconfig.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Whether this font config file should be generated..\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"fonts\",\"fontconfig\",\"configFile\",\"<name>\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"fonts.fontconfig.configFile.<name>.label\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/fontconfig.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/fontconfig.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"<name>\\\"\"},\"description\":\"Label to use for the name of the config file.\",\"loc\":[\"fonts\",\"fontconfig\",\"configFile\",\"<name>\",\"label\"],\"readOnly\":false,\"type\":\"string\"},\"fonts.fontconfig.configFile.<name>.priority\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/fontconfig.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/fontconfig.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"90\"},\"description\":\"Determines the order in which configs are loaded.\\nMust be a value within the range of 0-99, where priority 0 is the highest priority and 99 is the lowest.\\n\",\"loc\":[\"fonts\",\"fontconfig\",\"configFile\",\"<name>\",\"priority\"],\"readOnly\":false,\"type\":\"integer between 0 and 99 (both inclusive)\"},\"fonts.fontconfig.configFi