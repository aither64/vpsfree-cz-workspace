":"","name":"unit-script-network-addresses-eth0-start","nativeBuildInputs":"","out":"/nix/store/pp701x5r7rrasam7pv3jc9i9mdip2q2g-unit-script-network-addresses-eth0-start","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash\nset -e\n\nstate=\"/run/nixos/network/addresses/eth0\"\nmkdir -p \"$(dirname \"$state\")\"\n\nip link set dev \"eth0\" up\n\necho \"192.168.123.2/32\" >> $state\necho -n \"adding address 192.168.123.2/32... \"\nif out=$(ip addr replace \"192.168.123.2/32\" dev \"eth0\" nodad 2>&1); then\n  echo \"done\"\nelse\n  echo \"'ip addr replace \\\"192.168.123.2/32\\\" dev \\\"eth0\\\"' nodad failed: $out\"\n  exit 1\nfi\n\n\nstate=\"/run/nixos/network/routes/eth0\"\nmkdir -p \"$(dirname \"$state\")\"\n\n\n\n# Set the default gateway\n\n\n\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-network-addresses-eth0-start","outputs":{"out":{"path":"pp701x5r7rrasam7pv3jc9i9mdip2q2g-unit-script-network-addresses-eth0-start"}},"system":"x86_64-linux","version":4},"gx3br5hwcasb1qwiwn35cvlbc5v3kh69-pytest-check-hook.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","env":{"out":"/nix/store/0s3rk62sq0iqfmvybfpnd6g5895kv7ra-pytest-check-hook"},"inputs":{"drvs":{"qpckizfinpgk8mvl0awxbfw4xykrpshf-python3-3.14.7.drv":{"dynamicOutputs":{},"outputs":["out"]