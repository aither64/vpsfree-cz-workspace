/nix/store/jwp5408jxmql5gg91b7rpg6fr38wzx6s-mpfr-4.2.2-dev /nix/store/7yaq6zpgwizygk1gayplhd259sr092y9-bison-3.8.2 /nix/store/lmlgg4x8djbs8mcxrk1b299dja91v1mh-flex-2.6.4 /nix/store/jf59pnvpdy9ydx10gn1amz80lnlhm0a7-pahole-1.31 /nix/store/3jm282k17havs422c4rgsh3lsxajdrxj-rust-bindgen-unwrapped-0.72.1 /nix/store/khz08fcmpq1rp5lhpkzvqv8icnfykv79-rustc-1.95.0","out":"/nix/store/6p7i4nkc80krhk9f4a4cz7prqji5a3lb-linux-config-6.18.57","outputs":"out","patches":"/nix/store/mnlqwys9dxznjcvq4w3s0435s9ql8qv8-bridge-stp-helper.patch /nix/store/mbz5gln1q4swlzmqs2399br98qjif9kn-request-key-helper.patch /nix/store/23728y7zgh1jb55kpwxv5qnjbq0ykca6-randstruct-provide-seed-5.19.patch","pname":"linux-config","postPatch":"# Ensure that depmod gets resolved through PATH\nsed -i Makefile -e 's|= /sbin/depmod|= depmod|'\n\n# Some linux-hardened patches now remove certain files in the scripts directory, so the file may not exist.\n[[ -f scripts/ld-version.sh ]] && patchShebangs scripts/ld-version.sh\n\n# Set randstruct seed to a deterministic but diversified value. Note:\n# we could have instead patched gen-random-seed.sh to take input from\n# the buildFlags, but that would require also patching the kernel's\n# toplevel Makefile to add a variable export. This would be likely to\n# cause future patch conflicts.\nfor file in scripts/gen-randstruct-seed.sh scripts/gcc-plugins/gen-random-seed.sh; do\n  if [ -f \"$file\" ]; then\n    substituteInPlace \"$file\" \\\n      --replace NIXOS_RANDSTRUCT_SEED \\\n      $(echo /nix/store/66sc4ydys5dbj8n5dgglsli2zvjajs8b-linux-6.18.57.tar.xz /1s3bzfisrvrdlla1qr3z074sphpb4cpz4rbacwp56cmp9237lv2y | sha256sum | cut -d ' ' -f 1 | tr -d '\\n')\n    break\n  fi\ndone\n\npatchShebangs scripts\n\n# also patch arch-specific install scripts\nfor i in $(find arch -name install.sh); do\n    patchShebangs \"$i\"\ndone\n\n# unset $src because the build system tries to use it and spams a bunch of warnings\n# see: https://github.com/torvalds/linux/commit/b1992c3772e69a6fd0e3fc81cd4d2820c8b6eca0\nunset src\n# Patch kconfig to print \"###\" after every question so that\n# generate-config.pl from the generic builder can answer them.\nsed -e '/fflush(stdout);/i\\printf(\"###\");' -i scripts/kconfig/conf.c\n","preUnpack":"","preferBuiltin":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/66sc4ydys5dbj8n5dgglsli2zvjajs8b-linux-6.18.57.tar.xz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"6.18.57"},"inputs":{"drvs":{"1i08h1g4h5w53gipci9800p6ni79q6l5-pahole-1.31.drv":{"dynamicOutputs":{},"outputs":["out"]},"3anvzhvw4zra05wh0bzcdgncrq3dvqlh-linux-6.18.57.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6sqm0ljjly86331dhma2s0sqkj9sab0b-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"jflz18gn5s741pirwkfg540kr7clrd81-binutils-2.46.drv":{"dynamicOutputs":{},"outputs":["out"]},"lhyghwyrh7gdmsca5jb5xcyf546n4zhh-binutils-wrapper-2.46.drv":{"dynamicOutputs":{},"outputs":["out"]},"md6pzcky6zp5yi9faf22kn8b4vfa7bwp-mpfr-4.2.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"n61p2y23bl4y2h9708d3v5vnhr38zhbd-flex-2.6.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"nnc2fim7zmqkassvk5zbj88nsdsqyvdk-rust-bindgen-unwrapped-0.72.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"s2y0fks0ma5387q0injznz9qq5jcbl7p-libmpc-1.4.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"ss9rn8rmcy4h5i7s4v7bswf1br6yfxdz-gcc-15.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"v0afq7xmhhw3cqgr8fd0kzvw7rpbdd9c-kernel-intermediate-config.drv":{"dynamicOutputs":{},"outputs":["out"]},"vl9d4djy43kd4l04ykx2ghs2k4kspiay-rust-lib-src.drv":{"dynamicOutputs":{},"outputs":["out"]},"w82m46bcz7k78yhfyh0mwlfbrcpqpygf-gmp-with-cxx-6.3.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"wb724da8ag5ig0k6mhf8