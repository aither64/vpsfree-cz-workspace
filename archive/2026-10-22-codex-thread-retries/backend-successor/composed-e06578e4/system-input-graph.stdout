ralExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for tray-tui. All the available options\\ncan be found here: <https://github.com/Levizor/tray-tui/blob/main/config_example.toml>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  columns = 3;\\n  key_map = {\\n    down = \\\"focus_down\\\";\\n    h = \\\"focus_left\\\";\\n    j = \\\"focus_up\\\";\\n    k = \\\"focus_down\\\";\\n    l = \\\"focus_right\\\";\\n    left = \\\"focus_left\\\";\\n    right = \\\"focus_right\\\";\\n    up = \\\"focus_up\\\";\\n  };\\n  sorting = false;\\n}\"},\"loc\":[\"programs\",\"tray-tui\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.trippy.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/trippy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/trippy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable trippy.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"trippy\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.trippy.forceUserConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/trippy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/trippy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whatever to force trippy to use user's config through the -c flag.\\nThis will prevent certain commands such as 'sudo' ignoring\\nthe configured settings. This will only work if you have\\n'programs.<shell>.enable' (bash, zsh, fish, ...), depending\\non your shell.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"trippy\",\"forceUserConfig\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.trippy.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/trippy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/trippy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.trippy\"},\"description\":\"The trippy package to use.\",\"loc\":[\"programs\",\"trippy\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.trippy.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/trippy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/trippy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for trippy. All the available options can be found\\nhere: <https://trippy.rs/reference/configuration/>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  bindings = {\\n    toggle-help = \\\"h\\\";\\n    toggle-help-alt = \\\"?\\\";\\n    toggle-settings = \\\"s\\\";\\n    toggle-settings-dns = \\\"3\\\";\\n    toggle-settings-geoip = \\\"4\\\";\\n    toggle-settings-trace = \\\"2\\\";\\n    toggle-settings-tui = \\\"1\\\";\\n  };\\n  theme-colors = {\\n    bg-color = \\\"black\\\";\\n    border-color = \\\"gray\\\";\\n    tab-text-color = \\\"green\\\";\\n    text-color = \\\"gray\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"trippy\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.ttyper.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ttyper.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ttyper.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable ttyper, a terminal-based typing test.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ttyper\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ttyper.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ttyper.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ttyper.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.ttyper\"},\"description\":\"The ttyper package to use.\",\"loc\":[\"programs\",\"ttyper\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.ttyper.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ttyper.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ttyper.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/ttyper/config.toml`.\\nSee <https://github.com/max-niederman/ttyper> for all available options,\\nincluding supported languages and theme keys.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  default_language = \\\"english200\\\";\\n  theme = {\\n    border_type = \\\"rounded\\\";\\n    prompt_correct = \\\"green\\\";\\n    prompt_incorrect = \\\"red\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"ttyper\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.twitch-tui.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/twitch-tui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/twitch-tui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable twitch-tui.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"twitch-tui\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.twitch-tui.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/twitch-tui.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/twitch-tui.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.twitch-tui\"},\"description\":\"The twitch-tui package to use.\",\"loc\":[\"programs\",\"twitch-tui\",\"package\"],\"readOnly\":false,\"type