efault\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Modes to enable. For custom modes see `man 5 rofi-script`.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"drun\\\"\\n  \\\"emoji\\\"\\n  \\\"ssh\\\"\\n  {\\n    name = \\\"whatnot\\\";\\n    path = lib.getExe pkgs.rofi-whatnot;\\n  }\\n]\\n\"},\"loc\":[\"programs\",\"rofi\",\"modes\"],\"readOnly\":false,\"type\":\"list of (string or (submodule))\"},\"programs.rofi.modes.*.name\":{\"declarations\":[],\"description\":\"Name used to reference the custom mode in the mode list.\",\"loc\":[\"programs\",\"rofi\",\"modes\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"programs.rofi.modes.*.path\":{\"declarations\":[],\"description\":\"Executable path for the custom rofi script mode.\",\"loc\":[\"programs\",\"rofi\",\"modes\",\"*\",\"path\"],\"readOnly\":false,\"type\":\"string\"},\"programs.rofi.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.rofi\"},\"description\":\"The rofi package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.rofi.override { plugins = [ pkgs.rofi-emoji ]; }\"},\"loc\":[\"programs\",\"rofi\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.rofi.pass.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rofi-pass.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rofi-pass.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable rofi integration with password-store.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rofi\",\"pass\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rofi.pass.extraConfig\":{\"declarations\":[{\"name\":\"<home-