it-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"ttfunk","gemPath":"","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-ttfunk-1.7.0","nativeBuildInputs":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9 /nix/store/7whrgb2wib2q83wgbs78xsq9h25lf3aw-make-shell-wrapper-hook","out":"/nix/store/sg6z0ggn1s61wbzrck8i6b3s2wqxz756-ruby3.4-ttfunk-1.7.0","outputs":"out","patches":"","pname":"ttfunk","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"","ruby":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9","src":"/nix/store/35pqyv310mpjijzaks9dbnxybic7rz1j-ttfunk-1.7.0.gem","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","suffix":"1.7.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"1.7.0"},"inputs":{"drvs":{"049faz5h2hlc77kx3f6hvc147xrfc1n5-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"1pl1vm4w5wsg5ij8l7jid9597g6ivwf1-ttfunk-1.7.0.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"pnw6mfj7qybmpx6sg5brx1vzf4q02rjw-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-ttfunk-1.7.0","outputs":{"out":{"path":"sg6z0ggn1s61wbzrck8i6b3s2wqxz756-ruby3.4-ttfunk-1.7.0"}},"system":"x86_64-linux","version":4},"j7d18sh2cswmq89k6r7a9xhxfaipdjhk-bootstrap-coreutils-5.0-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"bootstrap-coreutils-5.0-builder","out":"/nix/store/r7b35ihyrq1m3ax02g80w2k5r1r7grj3-bootstrap-coreutils-5.0-builder","passAsFile":"text","system":"x86_64-linux","text":"# Unpack\nungz --file /nix/store/gg47zajh5pmy3hb3y8a70dmk8yjcrvgd-coreutils-5.0.tar.gz --output coreutils.tar\nuntar --file coreutils.tar\nrm coreutils.tar\ncd coreutils-5.0\n\n# Patch\npatch -Np0 -i /nix/store/9i7n3wp23knjjhfwlcz9kdfkk7l9c7h2-modechange.patch\npatch -Np0 -i /nix/store/slaqid4v26zi8kdxb6gahfg1jl3sk859-mbstate.patch\npatch -Np0 -i /nix/store/vvqf57w4hgpmj2g6i0yv08smbkfyb34i-ls-strcmp.patch\npatch -Np0 -i /nix/store/7ns4z67sizbgbkq0dbcmmyxymv6kqjcs-touch-getdate.patch\npatch -Np0 -i /nix/store/xvaxic53ind0xba3sk0p6y4qqc455ck