],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.feedr\"},\"description\":\"The feedr package to use.\",\"loc\":[\"programs\",\"feedr\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.feedr.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/feedr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/feedr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings for feedr.\\n\\nConfiguration written to\\n{file}`$XDG_CONFIG_HOME/feedr/config.toml`.\\n\\nOptions are listed on the github: <https://github.com/bahdotsh/feedr>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  general = {\\n    max_dashboard_items = 100;\\n    auto_refresh_interval = 0;\\n    refresh_enabled = false;\\n    refresh_rate_limit_delay = 2000;\\n  };\\n\\n  network = {\\n    http_timeout = 15;\\n    user_agent = \\\"Mozilla/5.0 (compatible; Feedr/1.0; +https://github.com/bahdotsh/feedr)\\\";\\n  };\\n\\n  ui = {\\n    tick_rate = 100;\\n    error_display_timeout = 3000;\\n    theme = \\\"dark\\\";\\n    compact_mode = \\\"auto\\\";\\n  };\\n\\n  default_feeds = [\\n    {\\n      url = \\\"https://nixos.org/blog/stories-rss.xml\\\";\\n      category = \\\"NixOS\\\";\\n    }\\n  ];\\n};\\n\"},\"loc\":[\"programs\",\"feedr\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.feh.buttons\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/feh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/feh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Override feh's default mouse button mapping. If you want to disable an\\naction, set its value to null. If you want to bind multiple buttons to\\nan action, set its value to a list.\\nSee <https://man.finalrewind.org/1/feh/#BUTTONS_CONFIG_SYNTAX> for\\ndefault bindings and available commands.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  prev_img = [\\n    3\\n    \\\"C-3\\\"\\n  ];\\n  zoom_in = 4;\\n  zoom_out = \\\"C-4\\\";\\n}\"},\"loc\":[\"programs\",\"feh\",\"buttons\"],\"readOnly\":false,\"type\":\"attribute set of (null or string or signed integer or list of (string or signed integer))\"},\"programs.feh.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/feh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/feh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable feh - a fast and light image viewer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"feh\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.feh.keybindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/feh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/feh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Override feh's default keybindings. If you want to disable a keybinding\\nset its value to null. If you want to bind multiple keys to an action,\\nset its value to a list.\\nSee <https://man.finalrewind.org/1/feh/#KEYS_CONFIG_SYNTAX> for\\ndefault bindings and available commands.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  prev_img = [\\n    \\\"h\\\"\\n    \\\"Left\\\"\\n  ];\\n  zoom_in = \\\"plus\\\";\\n  zoom_out = \\\"minus\\\";\\n}\"},\"loc\":[\"programs\",\"feh\",\"keybindings\"],\"readOnly\":false,\"type\":\"attribute set of (null or string or list of string)\"},\"programs.feh.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/feh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/feh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.feh\"},\"description\":\"The feh package to use.\",\"loc\":[\"programs\",\"feh\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.feh.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/feh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/feh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Define themes for feh.\\nSee <https://man.finalrewind.org/1/feh/#THEMES_CONFIG_SYNTAX> for\\nimportant guidelines and limitations related to theme configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  booth = [\\n    \\\"--full-screen\\\"\\n    \\\"--hide-pointer\\\"\\n    \\\"--slideshow-delay\\\"\\n    \\\"20\\\"\\n  ];\\n  example = [\\n    \\\"--info\\\"\\n    \\\"foo bar\\\"\\n  ];\\n  feh = [\\n    \\\"--image-bg\\\"\\n    \\\"black\\\"\\n  ];\\n  imagemap = [\\n    \\\"-rVq\\\"\\n    \\\"--thumb-width\\\"\\n    \\\"40\\\"\\n    \\\"--thumb-height\\\"\\n    \\\"30\\\"\\n    \\\"--index-info\\\"\\n    \\\"%n\\\\\\\\n%wx%h\\\"\\n  ];\\n  present = [\\n    \\\"--full-screen\\\"\\n    \\\"--sort\\\"\\n    \\\"name\\\"\\n    \\\"--hide-pointer\\\"\\n  ];\\n  webcam = [\\n    \\\"--multiwindow\\\"\\n    \\\"--reload\\\"\\n    \\\"20\\\"\\n  ];\\n}\"},\"loc\":[\"programs\",\"feh\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of list of string\"},\"programs.firefox.darwinDefaultsId\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"org.mozilla.firefox.plist\\\"\"},\"description\":\"The id for the darwin defaults in order to set policies\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"org.mozilla.firefox.plist\\\"\"},\"loc\":[\"programs\",\"firefox\",\"darwinDefaultsId\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.firefox.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Firefox.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"firefox\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.enableGnomeExtensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the GNOME Shell native host connector. Note, you\\nalso need to set the NixOS option\\n`services.gnome.gnome-browser-connector.enable` to\\n`true`.\\n\",\"loc\":[\"programs\",\"firefox\",\"enableGnomeExtensions\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Resulting Firefox package.\",\"loc\":[\"programs\",\"firefox\",\"finalPackage\"],\"readOnly\":true,\"type\":\"null or package\"},\"programs.firefox.languagePacks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The language packs to install. Available language codes can be found\\non the releases page:\\n`https://releases.mozilla.org/pub/firefox/releases/${version}/linux-x86_64/xpi/`,\\nreplacing `${version}` with the version of Firefox you have. If\\nthe version string of your Firefox derivative diverts from the upstream\\nversion, try setting the `release` option.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"en-GB\\\"\\n  \\\"de\\\"\\n]\"},\"loc\":[\"programs\",\"firefox\",\"languagePacks\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.firefox.nativeMessagingHosts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Additional packages containing native messaging hosts that should be\\nmade available to Firefox extensions.\\n\",\"loc\":[\"programs\",\"firefox\",\"nativeMessagingHosts\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.firefox.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.firefox\"},\"description\":\"The Firefox package to use. If state version ≥ 19.09 then\\nthis should be a wrapped Firefox package. For earlier state\\nversions it should be an unwrapped Firefox package.\\nSet to `null` to disable installing Firefox.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.firefox.override {\\n  # See nixpkgs' firefox/wrapper.nix to check which options you can use\\n  nativeMessagingHosts = [\\n    # Gnome shell native connector\\n    pkgs.gnome-browser-connector\\n    # Tridactyl native connector\\n    pkgs.tridactyl-native\\n  ];\\n}\\n\"},\"loc\":[\"programs\",\"firefox\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.firefox.pkcs11Modules\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Additional packages to be loaded as PKCS #11 modules in Firefox.\\n\",\"loc\":[\"programs\",\"firefox\",\"pkcs11Modules\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.firefox.policies\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"[See list of policies](https://mozilla.github.io/policy-templates/).\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  BlockAboutConfig = true;\\n  DefaultDownloadDirectory = \\\"\\\\${home}/Downloads\\\";\\n  ExtensionSettings = {\\n    \\\"uBlock0@raymondhill.net\\\" = {\\n      default_area = \\\"menupanel\\\";\\n      install_url = \\\"https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi\\\";\\n      installation_mode = \\\"force_installed\\\";\\n      private_browsing = true;\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"firefox\",\"policies\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.firefox.profiles\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of Firefox profiles.\\n\\nWhen using Firefox Developer Edition, the profile name should be\\n`dev-edition-default`. You can still set {option}`path` to store the\\nprofile in a custom directory.\\n\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"dev-edition-default\\\" = {\\n    id = 0;\\n    path = config.home.username;\\n\\n    settings = {\\n      \\\"browser.aboutConfig.showWarning\\\" = false;\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"firefox\",\"profiles\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.firefox.profiles.<name>.bookmarks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Declarative bookmarks.\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"bookmarks\"],\"readOnly\":false,\"type\":\"(submodule) or ((list of ((bookmark submodule) or (directory submodule) or value \\\"separator\\\" (singular enum))) or (attribute set of ((bookmark submodule) or (directory submodule) or value \\\"separator\\\" (singular enum))) convertible to it) convertible to it\"},\"programs.firefox.profiles.<name>.bookmarks.configFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Configuration file to define custom bookmarks.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"bookmarks\",\"configFile\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.firefox.profiles.<name>.bookmarks.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force override existing custom bookmarks.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"bookmarks\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.bookmarks.meta.maintainers\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of maintainers of each module.\\nThis option should be defined at most once per module.\\n\\nThe option value is not a list of maintainers, but an attribute set that maps module file names to lists of maintainers.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.maintainers.alice lib.maintainers.bob ]\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"bookmarks\",\"meta\",\"maintainers\"],\"readOnly\":false,\"type\":\"list of lib.maintainers\"},\"programs.firefox.profiles.<name>.bookmarks.meta.teams\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of team maintainers of each module.\\nThis option should be defined at most once per module.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.teams.acme lib.teams.haskell ]\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"bookmarks\",\"meta\",\"teams\"],\"readOnly\":false,\"type\":\"list of lib.teams\"},\"programs.firefox.profiles.<name>.bookmarks.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Custom bookmarks.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    name = \\\"wikipedia\\\";\\n    tags = [ \\\"wiki\\\" ];\\n    keyword = \\\"wiki\\\";\\n    url = \\\"https://en.wikipedia.org/wiki/Special:Search?search=%s&go=Go\\\";\\n  }\\n  {\\n    name = \\\"kernel.org\\\";\\n    url = \\\"https://www.kernel.org\\\";\\n  }\\n  \\\"separator\\\"\\n  {\\n    name = \\\"Nix sites\\\";\\n    toolbar = true;\\n    bookmarks = [\\n      {\\n        name = \\\"homepage\\\";\\n        url = \\\"https://nixos.org/\\\";\\n      }\\n      {\\n        name = \\\"wiki\\\";\\n        tags = [ \\\"wiki\\\" \\\"nix\\\" ];\\n        url = \\\"https://wiki.nixos.org/\\\";\\n      }\\n    ];\\n  }\\n]\\n\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"bookmarks\",\"settings\"],\"readOnly\":false,\"type\":\"(list of ((bookmark submodule) or (directory submodule) or value \\\"separator\\\" (singular enum))) or (attribute set of ((bookmark submodule) or (directory submodule) or value \\\"separator\\\" (singular enum))) convertible to it\"},\"programs.firefox.profiles.<name>.containers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of container configurations. See\\n[Multi-Account\\nContainers](https://support.mozilla.org/en-US/kb/containers)\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  dangerous = {\\n    color = \\\"red\\\";\\n    icon = \\\"fruit\\\";\\n    id = 2;\\n  };\\n  shopping = {\\n    color = \\\"blue\\\";\\n    icon = \\\"cart\\\";\\n    id = 1;\\n  };\\n}\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"containers\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.firefox.profiles.<name>.containers.<name>.color\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pink\\\"\"},\"description\":\"Container color.\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"color\"],\"readOnly\":false,\"type\":\"one of \\\"blue\\\", \\\"turquoise\\\", \\\"green\\\", \\\"yellow\\\", \\\"orange\\\", \\\"red\\\", \\\"pink\\\", \\\"purple\\\", \\\"toolbar\\\"\"},\"programs.firefox.profiles.<name>.containers.<name>.icon\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fruit\\\"\"},\"description\":\"Container icon.\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"icon\"],\"readOnly\":false,\"type\":\"one of \\\"briefcase\\\", \\\"cart\\\", \\\"circle\\\", \\\"dollar\\\", \\\"fence\\\", \\\"fingerprint\\\", \\\"gift\\\", \\\"vacation\\\", \\\"food\\\", \\\"fruit\\\", \\\"pet\\\", \\\"tree\\\", \\\"chill\\\"\"},\"programs.firefox.profiles.<name>.containers.<name>.id\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"Container ID. This should be set to a unique number per container in this profile.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"id\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"programs.firefox.profiles.<name>.containers.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"Container name, e.g., shopping.\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"containers\",\"<name>\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"programs.firefox.profiles.<name>.containersForce\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force replace the existing containers configuration.\\nThis is recommended since Firefox will replace the symlink on\\nevery launch, but note that you'll lose any existing configuration\\nby enabling this.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"containersForce\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Submodule for installing and configuring extensions.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  packages = with pkgs.nur.repos.rycee.firefox-addons; [\\n    ublock-origin\\n  ];\\n  settings.\\\"uBlock0@raymondhill.net\\\".settings = {\\n    selectedFilterLists = [\\n      \\\"ublock-filters\\\"\\n      \\\"ublock-badware\\\"\\n      \\\"ublock-privacy\\\"\\n      \\\"ublock-unbreak\\\"\\n      \\\"ublock-quick-fixes\\\"\\n    ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"extensions\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.firefox.profiles.<name>.extensions.exactPermissions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When enabled,\\n{option}`programs.firefox.profiles.<profile>.extensions.settings.<extensionID>.permissions`\\nmust specify the exact set of permissions that the\\nextension will request.\\n\\nThis means that if the authorized permissions are\\nbroader than what the extension requests, the\\nassertion will fail.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"extensions\",\"exactPermissions\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.extensions.exhaustivePermissions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When enabled, the user must authorize requested\\npermissions for all extensions from\\n{option}`programs.firefox.profiles.<profile>.extensions.packages`\\nin\\n{option}`programs.firefox.profiles.<profile>.extensions.settings.<extensionID>.permissions`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"extensions\",\"exhaustivePermissions\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.extensions.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to override all previous firefox settings.\\n\\nThis is required when using `settings`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"extensions\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.extensions.packages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of ‹name› add-on packages to install for this profile.\\nSome pre-packaged add-ons are accessible from the Nix User Repository.\\nOnce you have NUR installed run\\n\\n```console\\n$ nix-env -f '<nixpkgs>' -qaP -A nur.repos.rycee.firefox-addons\\n```\\n\\nto list the available ‹name› add-ons.\\n\\nNote that it is necessary to manually enable these extensions\\ninside ‹name› after the first installation.\\n\\nTo automatically enable extensions add\\n`\\\"extensions.autoDisableScopes\\\" = 0;`\\nto\\n[{option}`programs.firefox.profiles.<profile>.settings`](#opt-programs.firefox.profiles._name_.settings)\\n\\nOn systems using impermanence, this only prevents\\n‹name› from requiring manual extension approval. It\\ndoes not preserve extension runtime state such as\\nextension UUIDs, logins, local storage, or\\nper-extension data. Persist the ‹name› profile state\\nneeded by your extensions, or configure supported\\nextension settings declaratively with\\n[{option}`programs.firefox.profiles.<profile>.extensions.settings`](#opt-programs.firefox.profiles._name_.extensions.settings).\\n\\nPersisting only the `extensions` directory is generally\\nnot sufficient, because ‹name› stores extension state\\nin other profile files and databases that are managed\\noutside Home Manager.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs.nur.repos.rycee.firefox-addons; [\\n  privacy-badger\\n]\\n\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"extensions\",\"packages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.firefox.profiles.<name>.extensions.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of options for each extension.\\nThe keys of the attribute set consist of the ID of the extension\\nor its UUID wrapped in curly braces.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  # Example with uBlock origin's extensionID\\n  \\\"uBlock0@raymondhill.net\\\".settings = {\\n    selectedFilterLists = [\\n      \\\"ublock-filters\\\"\\n      \\\"ublock-badware\\\"\\n      \\\"ublock-privacy\\\"\\n      \\\"ublock-unbreak\\\"\\n      \\\"ublock-quick-fixes\\\"\\n    ];\\n  };\\n\\n  # Example with Stylus' UUID-form extensionID\\n  \\\"{7a7a4a92-a2a0-41d1-9fd7-1e92480d612d}\\\".settings = {\\n    dbInChromeStorage = true; # required for Stylus\\n  }\\n}\\n\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"extensions\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.firefox.profiles.<name>.extensions.settings.<name>.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Forcibly override any existing configuration for\\nthis extension.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"extensions\",\"settings\",\"<name>\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.extensions.settings.<name>.permissions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Any permissions\\\"\"},\"description\":\"Allowed permissions for this extension. See\\n<https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/manifest.json/permissions>\\nfor a list of relevant permissions.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"activeTab\\\"\\n]\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"extensions\",\"settings\",\"<name>\",\"permissions\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"programs.firefox.profiles.<name>.extensions.settings.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Json formatted options for this extension.\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"extensions\",\"settings\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"programs.firefox.profiles.<name>.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra preferences to add to {file}`user.js`.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.firefox.profiles.<name>.handlers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Declarative handlers configuration for MIME types and URL schemes.\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.firefox.profiles.<name>.handlers.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force replace the existing handlers configuration.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.handlers.meta.maintainers\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of maintainers of each module.\\nThis option should be defined at most once per module.\\n\\nThe option value is not a list of maintainers, but an attribute set that maps module file names to lists of maintainers.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.maintainers.alice lib.maintainers.bob ]\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"meta\",\"maintainers\"],\"readOnly\":false,\"type\":\"list of lib.maintainers\"},\"programs.firefox.profiles.<name>.handlers.meta.teams\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of team maintainers of each module.\\nThis option should be defined at most once per module.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.teams.acme lib.teams.haskell ]\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"meta\",\"teams\"],\"readOnly\":false,\"type\":\"list of lib.teams\"},\"programs.firefox.profiles.<name>.handlers.mimeTypes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set mapping MIME types to their handler configurations.\\n\\nFor a configuration example, see [this file on Firefox’s source code](https://github.com/mozilla-firefox/firefox/blob/c3797cdebac1316dd7168e995e3468c5a597e8d1/uriloader/exthandler/tests/unit/handlers.json).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"application/pdf\\\" = {\\n    action = 2;\\n    ask = false;\\n    handlers = [\\n      {\\n        name = \\\"Okular\\\";\\n        path = \\\"${pkgs.okular}/bin/okular\\\";\\n      }\\n    ];\\n    extensions = [ \\\"pdf\\\" ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.firefox.profiles.<name>.handlers.mimeTypes.<name>.action\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"The action to take for this MIME type / URL scheme. Possible values:\\n- 0: Save file\\n- 1: Always ask\\n- 2: Use helper app\\n- 3: Open in Firefox\\n- 4: Use system default\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"action\"],\"readOnly\":false,\"type\":\"one of 0, 1, 2, 3, 4\"},\"programs.firefox.profiles.<name>.handlers.mimeTypes.<name>.ask\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If true, the user is asked what they want to do with the file.\\nIf false, the action is taken without user intervention.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"ask\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.handlers.mimeTypes.<name>.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of file extensions associated with this MIME type.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"jpg\\\"\\n  \\\"jpeg\\\"\\n]\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"extensions\"],\"readOnly\":false,\"type\":\"list of string matching the pattern ^[^\\\\.].+$\"},\"programs.firefox.profiles.<name>.handlers.mimeTypes.<name>.handlers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"An array of handlers with the first one being the default.\\nIf you don't want to have a default handler, use an empty object for the first handler.\\nOnly valid when action is set to 2 (Use helper app).\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.firefox.profiles.<name>.handlers.mimeTypes.<name>.handlers.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Display name of the handler.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.firefox.profiles.<name>.handlers.mimeTypes.<name>.handlers.*.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the executable to be used.\\n\\nOnly one of 'path' or 'uriTemplate' should be set.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\",\"*\",\"path\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.firefox.profiles.<name>.handlers.mimeTypes.<name>.handlers.*.uriTemplate\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"URI for the application handler.\\n\\nOnly one of 'path' or 'uriTemplate' should be set.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"mimeTypes\",\"<name>\",\"handlers\",\"*\",\"uriTemplate\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.firefox.profiles.<name>.handlers.schemes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set mapping URL schemes to their handler configurations.\\n\\nFor a configuration example, see [this file on Firefox’s source code](https://github.com/mozilla-firefox/firefox/blob/c3797cdebac1316dd7168e995e3468c5a597e8d1/uriloader/exthandler/tests/unit/handlers.json).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  mailto = {\\n    action = 2;\\n    ask = false;\\n    handlers = [\\n      {\\n        name = \\\"Gmail\\\";\\n        uriTemplate = \\\"https://mail.google.com/mail/?extsrc=mailto&url=%s\\\";\\n      }\\n    ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"schemes\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.firefox.profiles.<name>.handlers.schemes.<name>.action\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"The action to take for this MIME type / URL scheme. Possible values:\\n- 0: Save file\\n- 1: Always ask\\n- 2: Use helper app\\n- 3: Open in Firefox\\n- 4: Use system default\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"action\"],\"readOnly\":false,\"type\":\"one of 0, 1, 2, 3, 4\"},\"programs.firefox.profiles.<name>.handlers.schemes.<name>.ask\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If true, the user is asked what they want to do with the file.\\nIf false, the action is taken without user intervention.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"ask\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.handlers.schemes.<name>.handlers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"An array of handlers with the first one being the default.\\nIf you don't want to have a default handler, use an empty object for the first handler.\\nOnly valid when action is set to 2 (Use helper app).\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"handlers\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.firefox.profiles.<name>.handlers.schemes.<name>.handlers.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Display name of the handler.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"handlers\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.firefox.profiles.<name>.handlers.schemes.<name>.handlers.*.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the executable to be used.\\n\\nOnly one of 'path' or 'uriTemplate' should be set.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"handlers\",\"*\",\"path\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.firefox.profiles.<name>.handlers.schemes.<name>.handlers.*.uriTemplate\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"URI for the application handler.\\n\\nOnly one of 'path' or 'uriTemplate' should be set.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"handlers\",\"schemes\",\"<name>\",\"handlers\",\"*\",\"uriTemplate\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.firefox.profiles.<name>.id\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"description\":\"Profile ID. This should be set to a unique number per profile.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"id\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"programs.firefox.profiles.<name>.isDefault\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"true if profile ID is 0\\\"\"},\"description\":\"Whether this is a default profile.\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"isDefault\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"Profile name.\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"programs.firefox.profiles.<name>.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"Profile path.\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"path\"],\"readOnly\":false,\"type\":\"string\"},\"programs.firefox.profiles.<name>.preConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra preferences to add to {file}`user.js`, before\\n[](#opt-programs.firefox.profiles._name_.settings).\\n\\nUse [](#opt-programs.firefox.profiles._name_.extraConfig), unless\\nyou want to overwrite in\\n[](#opt-programs.firefox.profiles._name_.settings), then use this\\noption.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"preConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.firefox.profiles.<name>.search\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Declarative search engine configuration.\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"search\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.firefox.profiles.<name>.search.default\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default search engine used in the address bar and search\\nbar.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ddg\\\"\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"search\",\"default\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.firefox.profiles.<name>.search.engines\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of search engine configurations. Engines that\\nonly have {var}`metaData` specified will be treated as builtin\\nto Firefox.\\n\\nSee [SearchEngine.jsm](https://searchfox.org/mozilla-central/rev/e3f42ec9320748b2aab3d474d1e47075def9000c/toolkit/components/search/SearchEngine.sys.mjs#890-923)\\nin Firefox's source for available options. We maintain a\\nmapping to let you specify all options in the referenced link\\nwithout underscores, but it may fall out of date with future\\noptions.\\n\\nNote, {var}`icon` is also a special option added by Home\\nManager to make it convenient to specify absolute icon paths.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  nix-packages = {\\n    name = \\\"Nix Packages\\\";\\n    urls = [{\\n      template = \\\"https://search.nixos.org/packages\\\";\\n      params = [\\n        { name = \\\"type\\\"; value = \\\"packages\\\"; }\\n        { name = \\\"query\\\"; value = \\\"{searchTerms}\\\"; }\\n      ];\\n    }];\\n\\n    icon = \\\"${pkgs.nixos-icons}/share/icons/hicolor/scalable/apps/nix-snowflake.svg\\\";\\n    definedAliases = [ \\\"@np\\\" ];\\n  };\\n\\n  nixos-wiki = {\\n    name = \\\"NixOS Wiki\\\";\\n    urls = [{ template = \\\"https://wiki.nixos.org/w/index.php?search={searchTerms}\\\"; }];\\n    iconMapObj.\\\"16\\\" = \\\"https://wiki.nixos.org/favicon.ico\\\";\\n    definedAliases = [ \\\"@nw\\\" ];\\n  };\\n\\n  bing.metaData.hidden = true;\\n  google.metaData.alias = \\\"@g\\\"; # builtin engines only support specifying one additional alias\\n}\\n\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"search\",\"engines\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (JSON value)\"},\"programs.firefox.profiles.<name>.search.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force replace the existing search\\nconfiguration. This is recommended since Firefox will\\nreplace the symlink for the search configuration on every\\nlaunch, but note that you'll lose any existing configuration\\nby enabling this.\\n\",\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"search\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefox.profiles.<name>.search.meta.maintainers\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of maintainers of each module.\\nThis option should be defined at most once per module.\\n\\nThe option value is not a list of maintainers, but an attribute set that maps module file names to lists of maintainers.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.maintainers.alice lib.maintainers.bob ]\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"search\",\"meta\",\"maintainers\"],\"readOnly\":false,\"type\":\"list of lib.maintainers\"},\"programs.firefox.profiles.<name>.search.meta.teams\":{\"declarations\":[\"/nix/store/640irzgl08asrnjly4dspdbx8lz3cvqr-source/modules/generic/meta-maintainers.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of team maintainers of each module.\\nThis option should be defined at most once per module.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ lib.teams.acme lib.teams.haskell ]\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"search\",\"meta\",\"teams\"],\"readOnly\":false,\"type\":\"list of lib.teams\"},\"programs.firefox.profiles.<name>.search.order\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The order the search engines are listed in. Any engines that\\naren't included in this list will be listed after these in an\\nunspecified order.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"ddg\\\"\\n  \\\"google\\\"\\n]\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"search\",\"order\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.firefox.profiles.<name>.search.privateDefault\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default search engine used in the Private Browsing.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ddg\\\"\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"search\",\"privateDefault\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.firefox.profiles.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of Firefox preferences.\\n\\nFirefox only supports int, bool, and string types for\\npreferences, but home-manager will automatically\\nconvert all other JSON-compatible values into strings.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"browser.startup.homepage\\\" = \\\"https://nixos.org\\\";\\n  \\\"browser.search.region\\\" = \\\"GB\\\";\\n  \\\"browser.search.isUS\\\" = false;\\n  \\\"distribution.searchplugins.defaultLocale\\\" = \\\"en-GB\\\";\\n  \\\"general.useragent.locale\\\" = \\\"en-GB\\\";\\n  \\\"browser.bookmarks.showMobileBookmarks\\\" = true;\\n  \\\"browser.newtabpage.pinned\\\" = [{\\n    title = \\\"NixOS\\\";\\n    url = \\\"https://nixos.org\\\";\\n  }];\\n}\\n\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (Firefox preference (int, bool, string, and also attrs, list, float as a JSON string))\"},\"programs.firefox.profiles.<name>.userChrome\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom Firefox user chrome CSS.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  /* Hide tab bar in FF Quantum */\\n  @-moz-document url(chrome://browser/content/browser.xul), url(chrome://browser/content/browser.xhtml) {\\n    #TabsToolbar {\\n      visibility: collapse !important;\\n      margin-bottom: 21px !important;\\n    }\\n  \\n    #sidebar-box[sidebarcommand=\\\"treestyletab_piro_sakura_ne_jp-sidebar-action\\\"] #sidebar-header {\\n      visibility: collapse !important;\\n    }\\n  }\\n''\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"userChrome\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.firefox.profiles.<name>.userContent\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefox>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefox\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom Firefox user content CSS.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  /* Hide scrollbar in FF Quantum */\\n  *{scrollbar-width:none !important}\\n''\"},\"loc\":[\"programs\",\"firefox\",\"profiles\",\"<name>\",\"userContent\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.firefoxpwa.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefoxpwa.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefoxpwa.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Progressive Web Apps for Firefox.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"firefoxpwa\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.firefoxpwa.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefoxpwa.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefoxpwa.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.firefoxpwa\"},\"description\":\"The firefoxpwa package to use.\",\"loc\":[\"programs\",\"firefoxpwa\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.firefoxpwa.profiles\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefoxpwa.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefoxpwa.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of profile options. The keys of that attribute set consist of\\nULIDs. A ULID is made of 26 characters, each of which is one of\\n'0123456789ABCDEFGHJKMNPQRSTVWXYZ' (Excluding I, L, O and U). See\\n<https://github.com/ulid/spec?tab=readme-ov-file#canonical-string-representation>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"0123456789ABCDEFGHJKMNPQRSTVWXYZ\\\".sites.\\\"ZYXWVTSRQPNMKJHGFEDCBA9876543210\\\" = {\\n    name = \\\"MDN Web Docs\\\";\\n    url = \\\"https://developer.mozilla.org/\\\";\\n    manifestUrl = \\\"https://developer.mozilla.org/manifest.f42880861b394dd4dc9b.json\\\";\\n    desktopEntry.icon = pkgs.fetchurl {\\n      url = \\\"https://developer.mozilla.org/favicon-192x192.png\\\";\\n      sha256 = \\\"0p8zgf2ba48l2pq1gjcffwzmd9kfmj9qc0v7zpwf2qd54fndifxr\\\";\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"firefoxpwa\",\"profiles\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.firefoxpwa.profiles.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/firefoxpwa.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/firefoxpwa.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"‹name›\\\"\"},\"description\":\"Name of the profile.