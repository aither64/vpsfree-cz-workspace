eclarations\":[{\"name\":\"<home-manager/modules/services/tailscale-systray.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/tailscale-systray.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.tailscale\"},\"description\":\"The tailscale package to use.\",\"loc\":[\"services\",\"tailscale-systray\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.tailscale-systray.theme\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/tailscale-systray.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/tailscale-systray.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Color theme to use for the Tailscale icon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"dark:nobg\\\"\"},\"loc\":[\"services\",\"tailscale-systray\",\"theme\"],\"readOnly\":false,\"type\":\"null or one of \\\"dark\\\", \\\"dark:nobg\\\", \\\"light\\\", \\\"light:nobg\\\"\"},\"services.taskwarrior-sync.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/taskwarrior-sync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/taskwarrior-sync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Taskwarrior periodic sync.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"taskwarrior-sync\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.taskwarrior-sync.frequency\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/taskwarrior-sync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/taskwarrior-sync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"*:0/5\\\"\"},\"description\":\"How often to run `taskwarrior sync`. This\\nvalue is passed to the systemd timer configuration as the\\n`OnCalendar` option. See\\n{manpage}`systemd.time(7)`\\nfor more information about the format.\\n\",\"loc\":[\"services\",\"taskwarrior-sync\",\"frequency\"],\"readOnly\":false,\"type\":\"string\"},\"services.taskwarrior-sync.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/taskwarrior-sync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/taskwarrior-sync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.taskwarrior2\"},\"description\":\"The taskwarrior2 package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.taskwarrior3\"},\"loc\":[\"services\",\"taskwarrior-sync\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.tldr-update.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/tldr-update.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/tldr-update.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Automatic updates for the tldr CLI\\n.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"tldr-update\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.tldr-update.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/tldr-update.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/tldr-update.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.tldr\"},\"description\":\"The tldr package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"tlrc\"},\"loc\":[\"services\",\"tldr-update\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.tldr-update.period\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/tldr-update.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/tldr-update.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"weekly\\\"\"},\"description\":\"Systemd timer period to create for scheduled {command}`tldr --update`.\\n\\nOn Linux this is a string as defined by {manpage}`systemd.time(7)`.\\n\\nOn Darwin, it must be one of: hourly, daily, weekly, monthly, semiannually, annually, which are implemented as defined in {manpage}`systemd.time(7)`.\\n\\n\",\"loc\":[\"services\",\"tldr-update\",\"period\"],\"readOnly\":false,\"type\":\"string\"},\"services.tomat.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/tomat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/tomat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Tomat Pomodoro server.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"tomat\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.tomat.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/tomat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/tomat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.tomat\"},\"description\":\"The tomat package to use.\",\"loc\":[\"services\",\"tomat\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.tomat.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/tomat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/tomat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Tomat configuration.\\nSee <https://github.com/jolars/tomat/blob/main/docs/configuration.md> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  notification = {\\n    enabled = true;\\n  };\\n  sound = {\\n    enabled = true;\\n  };\\n  timer = {\\n    auto_advance = false;\\n    break = 5;\\n    work = 25;\\n  };\\n}\"},\"loc\":[\"services\",\"tomat\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"services.trayer.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/trayer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/trayer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable trayer, the lightweight GTK2+ systray for UNIX desktops.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"trayer\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.trayer.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/trayer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/trayer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.trayer\"},\"description\":\"The trayer package to use.\",\"loc\":[\"services\",\"trayer\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.trayer.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/trayer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/trayer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Trayer configuration as a set of attributes. Further details can be\\nfound in [trayer's README](https://github.com/sargon/trayer-srg/blob/master/README).\\n\\n{var}`SetDockType`\\n: boolean (default: `true`)\\n\\n{var}`SetPartialStrut`\\n: boolean (default: `true`)\\n\\n{var}`align`\\n: one of \\\"left\\\", \\\"right\\\", \\\"center\\\" (default: `\\\"center\\\"`)\\n\\n{var}`alpha`\\n: signed integer (default: `127`)\\n\\n{var}`distance`\\n: signed integer (default: `0`)\\n\\n{var}`distancefrom`\\n: one of \\\"left\\\", \\\"right\\\", \\\"top\\\", \\\"bottom\\\" (default: `\\\"top\\\"`)\\n\\n{var}`edge`\\n: one of \\\"left\\\", \\\"right\\\", \\\"top\\\", \\\"bottom\\\", \\\"none\\\" (default: `\\\"bottom\\\"`)\\n\\n{var}`expand`\\n: boolean (default: `true`)\\n\\n{var}`height`\\n: signed integer (default: `26`)\\n\\n{var}`heighttype`\\n: one of \\\"request\\\", \\\"pixel\\\" (default: `\\\"pixel\\\"`)\\n\\n{var}`iconspacing`\\n: signed integer (default: `0`)\\n\\n{var}`margin`\\n: signed integer (default: `0`)\\n\\n{var}`monitor`\\n: unsigned integer, meaning >=0, or value \\\"primary\\\" (singular enum) (default: `0`)\\n\\n{var}`padding`\\n: signed integer (default: `0`)\\n\\n{var}`tint`\\n: string (default: `\\\"0xFFFFFFFF\\\"`)\\n\\n{var}`transparent`\\n: boolean (default: `false`)\\n\\n{var}`width`\\n: signed integer (default: `100`)\\n\\n{var}`widthtype`\\n: one of \\\"request\\\", \\\"pixel\\\", \\\"percent\\\" (default: `\\\"percent\\\"`)\\n\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  SetDockType = true;\\n  edge = \\\"top\\\";\\n  padding = 6;\\n  tint = \\\"0x282c34\\\";\\n}\"},\"loc\":[\"services\",\"trayer\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (null or string or boolean or signed integer)\"},\"services.trayscale.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/trayscale.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/trayscale.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable An unofficial GUI wrapper around the Tailscale CLI client..\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"trayscale\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.trayscale.hideWindow\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/trayscale.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/trayscale.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to hide the trayscale window on startup.\",\"loc\":[\"services\",\"trayscale\",\"hideWindow\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.trayscale.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/trayscale.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/trayscale.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.trayscale\"},\"description\":\"The trayscale package to use.\",\"loc\":[\"services\",\"trayscale\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.twmn.duration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"3000\"},\"description\":\"The time each notification remains visible, in milliseconds.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"5000\"},\"loc\":[\"services\",\"twmn\",\"duration\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"services.twmn.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable twmn, a tiling window manager notification daemon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"twmn\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.twmn.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra configuration options to add to the twmnd config file. See\\n<https://github.com/sboli/twmn/blob/master/README.md>\\nfor details.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{ main.activation_command = \\\"${pkgs.hello}/bin/hello\\\"; }\"},\"loc\":[\"services\",\"twmn\",\"extraConfig\"],\"readOnly\":false,\"type\":\"attribute set\"},\"services.twmn.host\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"127.0.0.1\\\"\"},\"description\":\"Host address to listen on for notifications.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"laptop.lan\\\"\"},\"loc\":[\"services\",\"twmn\",\"host\"],\"readOnly\":false,\"type\":\"string\"},\"services.twmn.icons.critical\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the critical notifications' icon.\",\"loc\":[\"services\",\"twmn\",\"icons\",\"critical\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"services.twmn.icons.info\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the informative notifications' icon.\",\"loc\":[\"services\",\"twmn\",\"icons\",\"info\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"services.twmn.icons.warning\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to the warning notifications' icon.\",\"loc\":[\"services\",\"twmn\",\"icons\",\"warning\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"services.twmn.port\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"9797\"},\"description\":\"UDP port to listen on for notifications.\",\"loc\":[\"services\",\"twmn\",\"port\"],\"readOnly\":false,\"type\":\"16 bit unsigned integer; between 0 and 65535 (both inclusive)\"},\"services.twmn.screen\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Screen number to display notifications on when using a multi-head\\ndesktop.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"loc\":[\"services\",\"twmn\",\"screen\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"services.twmn.soundCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Command to execute to play a notification's sound.\",\"loc\":[\"services\",\"twmn\",\"soundCommand\"],\"readOnly\":false,\"type\":\"string\"},\"services.twmn.text.color\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"#999999\\\"\"},\"description\":\"Notification's text color. RGB hex and keywords (e.g. `lightgray`)\\nare supported.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"lightgray\\\"\"},\"loc\":[\"services\",\"twmn\",\"text\",\"color\"],\"readOnly\":false,\"type\":\"string\"},\"services.twmn.text.font.family\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Sans\\\"\"},\"description\":\"Notification text's font family.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Noto Sans\\\"\"},\"loc\":[\"services\",\"twmn\",\"text\",\"font\",\"family\"],\"readOnly\":false,\"type\":\"string\"},\"services.twmn.text.font.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The font package to use. Package providing the font to use for the notification text.\\nThis package is only used if `font.package` is not null.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.dejavu_fonts\"},\"loc\":[\"services\",\"twmn\",\"text\",\"font\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"services.twmn.text.font.size\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"13\"},\"description\":\"Notification text's font size.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"42\"},\"loc\":[\"services\",\"twmn\",\"text\",\"font\",\"size\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"services.twmn.text.font.variant\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"medium\\\"\"},\"description\":\"Notification text's font variant.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"heavy\\\"\"},\"loc\":[\"services\",\"twmn\",\"text\",\"font\",\"variant\"],\"readOnly\":false,\"type\":\"one of \\\"oblique\\\", \\\"italic\\\", \\\"ultra-light\\\", \\\"light\\\", \\\"medium\\\", \\\"semi-bold\\\", \\\"bold\\\", \\\"ultra-bold\\\", \\\"heavy\\\", \\\"ultra-condensed\\\", \\\"extra-condensed\\\", \\\"condensed\\\", \\\"semi-condensed\\\", \\\"semi-expanded\\\", \\\"expanded\\\", \\\"extra-expanded\\\", \\\"ultra-expanded\\\"\"},\"services.twmn.text.maxLength\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Maximum length of the text before it is cut and suffixed with \\\"...\\\".\\nNever cuts if `null`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"80\"},\"loc\":[\"services\",\"twmn\",\"text\",\"maxLength\"],\"readOnly\":false,\"type\":\"null or (unsigned integer, meaning >=0)\"},\"services.twmn.window.alwaysOnTop\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable forcing the notification window to always be on top.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"twmn\",\"window\",\"alwaysOnTop\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.twmn.window.animation.bounce.duration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"500\"},