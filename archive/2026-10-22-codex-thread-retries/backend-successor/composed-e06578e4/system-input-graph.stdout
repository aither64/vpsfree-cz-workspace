ervices/darkman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Scripts to run when switching to \\\"dark mode\\\".\\n\\nMultiline strings are interpreted as Bash shell scripts and a shebang is\\nnot required.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  gtk-theme = ''\\n    ${pkgs.dconf}/bin/dconf write \\\\\\n        /org/gnome/desktop/interface/color-scheme \\\"'prefer-dark'\\\"\\n  '';\\n  my-python-script = pkgs.writers.writePython3 \\\"my-python-script\\\" { } ''\\n    print('Do something!')\\n  '';\\n}\\n\"},\"loc\":[\"services\",\"darkman\",\"darkModeScripts\"],\"readOnly\":false,\"type\":\"attribute set of (absolute path or strings concatenated with \\\"\\\\n\\\")\"},\"services.darkman.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/darkman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/darkman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable darkman, a tool that automatically switches dark-mode on and off based on\\nthe time of the day.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"darkman\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.darkman.lightModeScripts\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/darkman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/darkman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Scripts to run when switching to \\\"light mode\\\".\\n\\nMultiline strings are interpreted as Bash shell scripts and a shebang is\\nnot required.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  gtk-theme = ''\\n    ${pkgs.dconf}/bin/dconf write \\\\\\n        /org/gnome/desktop/interface/color-scheme \\\"'prefer-light'\\\"\\n  '';\\n  my-python-script = pkgs.writers.writePython3 \\\"my-python-script\\\" { } ''\\n    print('Do something!')\\n  '';\\n}\\n\"},\"loc\":[\"services\",\"darkman\",\"lightModeScripts\"],\"readOnly\":false,\"type\":\"attribute set of (absolute path or strings concatenated with \\\"\\\\n\\\")\"},\"services.darkman.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/darkman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/darkman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.darkman\"},\"description\":\"The darkman package to use.\",\"loc\":[\"services\",\"darkman\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"services.darkman.scripts\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/darkman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/darkman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Scripts to run when switching modes, placed in\\n{file}`$XDG_DATA_HOME/darkman/`. Each script receives the new mode\\n(`dark` or `light`) as its first argument, allowing a single script\\nto handle both modes.\\n\\nMultiline strings are interpreted as Bash shell scripts and a shebang\\nis not required.\\n\\nThese scripts take precedence over legacy scripts of the same name in\\n{option}`darkModeScripts` and {option}`lightModeScripts`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  gtk-theme = ''\\n    if [ \\\"$1\\\" = \\\"dark\\\" ]; then\\n      ${pkgs.dconf}/bin/dconf write \\\\\\n          /org/gnome/desktop/interface/color-scheme \\\"'prefer-dark'\\\"\\n    else\\n      ${pkgs.dconf}/bin/dconf write \\\\\\n          /org/gnome/desktop/interface/color-scheme \\\"'prefer-light'\\\"\\n    fi\\n  '';\\n}\\n\"},\"loc\":[\"services\",\"darkman\",\"scripts\"],\"readOnly\":false,\"type\":\"attribute set of (absolute path or strings concatenated with \\\"\\\\n\\\")\"},\"services.dar