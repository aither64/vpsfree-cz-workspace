kg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"7.2.1"},"inputs":{"drvs":{"049faz5h2hlc77kx3f6hvc147xrfc1n5-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"3q639a75arad6krdjxcmph58w5q5mq4p-ruby3.4-securerandom-0.3.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"3v5l4g5jnalps9lck0kmqgbv0f6xd7gp-ruby3.4-bigdecimal-3.1.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"4h0rbdjjdyhjsb24b3ynv8img4100sbv-ruby3.4-base64-0.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"7mik398v4ajjx20xxxgqf9xwa3y1rvv2-ruby3.4-connection_pool-2.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"82jm7xfqsajcv2clrz5vhakn0qq3qwgc-ruby3.4-drb-2.2.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"9xxw6x8n885wnmpggngil2h8kj2kfidm-activesupport-7.2.1.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"a28j9v6d3r4nv23f9shmnks403hjdmah-ruby3.4-logger-1.6.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"gg1lf5cdmiqljn1afw3i3qf7i2cp3a39-ruby3.4-minitest-5.25.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"ncdqb4alwf9xpcz0fhlz52w46ganacqd-ruby3.4-i18n-1.14.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"p4j3hnyblc9qawfqb892v8mxwwln6lik-ruby3.4-concurrent-ruby-1.3.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"pnw6mfj7qybmpx6sg5brx1vzf4q02rjw-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"qas52wqv69xkf60i502jhdqx8yv5sn44-ruby3.4-tzinfo-2.0.6.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-act