aerc-config(5)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  messages = {\\n    q = \\\":quit<Enter>\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"aerc\",\"extraBinds\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or attribute set of (strings concatenated with \\\"\\\\n\\\" or attribute set of (values (null, bool, int, string, or float) or a list of values, that will be joined with a comma))\"},\"programs.aerc.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aerc>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aerc\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra lines added to {file}`$HOME/.config/aerc/aerc.conf`.\\n\\nSee {manpage}`aerc-config(5)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  ui = {\\n    sort = \\\"-r date\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"aerc\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or attribute set of (strings concatenated with \\\"\\\\n\\\" or attribute set of (values (null, bool, int, string, or float) or a list of values, that will be joined with a comma))\"},\"programs.aerc.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aerc>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aerc\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.aerc\"},\"description\":\"The aerc package to use.\",\"loc\":[\"programs\",\"aerc\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.aerc.stylesets\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aerc>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aerc\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Stylesets added to {file}`$HOME/.config/aerc/stylesets/`.\\n\\nSee {manpage}`aerc-stylesets(7)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{ default = { ui = { \\\"tab.selected.reverse\\\" = \\\"toggle\\\"; }; }; };\\n\"},\"loc\":[\"programs\",\"aerc\",\"stylesets\"],\"readOnly\":false,\"type\":\"attribute set of (strings concatenated with \\\"\\\\n\\\" or attribute set of (strings concatenated with \\\"\\\\n\\\" or attribute set of (values (null, bool, int, string, or float) or a list of values, that will be joined with a comma)))\"},\"programs.aerc.templates\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aerc>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aerc\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Templates added to {file}`$HOME/.config/aerc/templates/`.\\n\\nSee {manpage}`aerc-templates(7)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{ new_message = \\\"Hello!\\\"; };\\n\"},\"loc\":[\"programs\",\"aerc\",\"templates\"],\"readOnly\":false,\"type\":\"attribute set of strings concatenated with \\\"\\\\n\\\"\"},\"programs.aerospace.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aerospace.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aerospace.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable AeroSpace window manager.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"aerospace\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.aerospace.launchd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aerospace.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aerospace.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Configure the launchd agent to manage the AeroSpace process.\\n\\nThe first time this is enabled, macOS will prompt you to allow this background\\nitem in System Settings.\\n\\nYou can verify the service is running correctly from your terminal.\\nRun: `launchctl list | grep aerospace`\\n\\n- A running process will show a Process ID (PID) and a status of 0, for example:\\n  `12345\\t0\\torg.nix-community.home.aerospace`\\n\\n- If the service has crashed or failed to start, the PID will be a dash and the\\n  status will be a non-zero number, for example:\\n  `-\\t1\\torg.nix-community.home.aerospace`\\n\\nIn case of failure, check the logs with `cat /tmp/aerospace.err.log`.\\n\\nFor more detailed service status, run `launchctl print gui/$(id -u)/org.nix-community.home.aerospace`.\\n\\nNOTE: Enabling this option will configure AeroSpace to **not** manage its own\\nlaunchd agent. Specifically, it will set `start-at-login = false` and\\n`after-login-command = []` in the configuration file, as those are now handled\\nby Home Manager and launchd instead.\\n\",\"loc\":[\"programs\",\"aerospace\",\"launchd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.aerospace.launchd.keepAlive\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aerospace.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aerospace.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether the launchd service should be kept alive.\",\"loc\":[\"programs\",\"aerospace\",\"launchd\",\"keepAlive\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.aerospace.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aerospace.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aerospace.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.aerospace\"},\"description\":\"The aerospace package to use.\",\"loc\":[\"programs\",\"aerospace\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.aerospace.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aerospace.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aerospace.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"AeroSpace configuration, see\\n<https://nikitabobko.github.io/AeroSpace/guide#configuring-aerospace>\\nfor supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  gaps = {\\n    outer = {\\n      bottom = 8;\\n      left = 8;\\n      right = 8;\\n      top = 8;\\n    };\\n  };\\n  mode = {\\n    main = {\\n      binding = {\\n        alt-h = \\\"focus left\\\";\\n        alt-j = \\\"focus down\\\";\\n        alt-k = \\\"focus up\\\";\\n        alt-l = \\\"focus right\\\";\\n      };\\n    };\\n  };\\n  on-window-detected = [\\n    {\\n      \\\"if\\\" = {\\n        app-id = \\\"com.apple.finder\\\";\\n      };\\n      run = \\\"move-node-to-workspace 9\\\";\\n    }\\n    {\\n      check-further-callbacks = true;\\n      \\\"if\\\" = {\\n        app-id = \\\"com.apple.systempreferences\\\";\\n        app-name-regex-substring = \\\"settings\\\";\\n        during-aerospace-startup = true;\\n        window-title-regex-substring = \\\"substring\\\";\\n        workspace = \\\"workspace-name\\\";\\n      };\\n      run = [\\n        \\\"layout floating\\\"\\n        \\\"move-node-to-workspace S\\\"\\n      ];\\n    }\\n  ];\\n}\"},\"loc\":[\"programs\",\"aerospace\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.afew.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/afew.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/afew.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the afew initial tagging script for Notmuch.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"afew\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.afew.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/afew.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/afew.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  [SpamFilter]\\n  [KillThreadsFilter]\\n  [ListMailsFilter]\\n  [ArchiveSentMailsFilter]\\n  [InboxFilter]\\n''\"},\"description\":\"Extra lines added to afew configuration file. Available\\nconfiguration options are described in the afew manual:\\n<https://afew.readthedocs.io/en/latest/configuration.html>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  [SpamFilter]\\n  \\n  [Filter.0]\\n  query = from:pointyheaded@boss.com\\n  tags = -new;+boss\\n  message = Message from above\\n  \\n  [InboxFilter]\\n''\"},\"loc\":[\"programs\",\"afew\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.afew.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/afew.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/afew.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.afew\"},\"description\":\"The afew package to use.\",\"loc\":[\"programs\",\"afew\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.ahoviewer.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ahoviewer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ahoviewer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Configuration settings for ahoviewer. All the available options\\ncan be found editing the preferences in the GUI and looking at\\n$XDG_CONFIG_HOME/ahoviewer/ahoviewer.cfg\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  ZoomMode = \\\"M\\\";\\n  Geometry :\\n  {\\n      x = 964;\\n      y = 574;\\n      w = 948;\\n      h = 498;\\n  };\\n  BooruWidth = 382;\\n  TagViewPosition = 318;\\n  SmartNavigation = true;\\n  StoreRecentFiles = false;\\n  RememberLastFile = false;\\n  SaveThumbnails = false;\\n  AutoOpenArchive = false;\\n  BooruBrowserVisible = true;\\n''\"},\"loc\":[\"programs\",\"ahoviewer\",\"config\"],\"readOnly\":false,\"type\":\"string or absolute path\"},\"programs.ahoviewer.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ahoviewer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ahoviewer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable ahoviewer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ahoviewer\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ahoviewer.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ahoviewer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ahoviewer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.ahoviewer\"},\"description\":\"The ahoviewer package to use.\",\"loc\":[\"programs\",\"ahoviewer\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.ahoviewer.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ahoviewer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ahoviewer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of plugins for ahoviewer.\\n\",\"loc\":[\"programs\",\"ahoviewer\",\"plugins\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.aiac.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aiac.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aiac.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable aiac.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"aiac\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.aiac.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aiac.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aiac.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.aiac\"},\"description\":\"The aiac package to use.\",\"loc\":[\"programs\",\"aiac\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.aiac.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aiac.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aiac.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for aiac. All the available options can be found here:\\n<https://github.com/gofireflyio/aiac/?tab=readme-ov-file#configuration>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  backends = {\\n    localhost = {\\n      type = \\\"ollama\\\";\\n      url = \\\"http://localhost:11434/api\\\";\\n    };\\n    official_openai = {\\n      api_key = \\\"API KEY\\\";\\n      default_model = \\\"gpt-4o\\\";\\n      type = \\\"openai\\\";\\n    };\\n  };\\n  default_backend = \\\"official_openai\\\";\\n}\"},\"loc\":[\"programs\",\"aiac\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.aichat.agents\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aichat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aichat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Agent-specific configurations. See\\n<https://github.com/sigoden/aichat/wiki/Configuration-Guide#agent-specific>\\nfor supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  llama = {\\n    model = \\\"llama3.2:latest\\\";\\n    temperature = 0.5;\\n    use_tools = \\\"web_search\\\";\\n  };\\n  openai = {\\n    agent_prelude = \\\"default\\\";\\n    model = \\\"openai:gpt-4o\\\";\\n    temperature = 0.5;\\n    top_p = 0.7;\\n    use_tools = \\\"fs,web_search\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"aichat\",\"agents\"],\"readOnly\":false,\"type\":\"attribute set of (YAML 1.1 value)\"},\"programs.aichat.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aichat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aichat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable aichat, an All-in-one LLM CLI tool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"aichat\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.aichat.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aichat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aichat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.aichat\"},\"description\":\"The aichat package to use.\",\"loc\":[\"programs\",\"aichat\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.aichat.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aichat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aichat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/aichat/config.yaml`\\non Linux or on Darwin if [](#opt-xdg.enable) is set, otherwise\\n{file}`~/Library/Application Support/aichat/config.yaml`.\\nSee\\n<https://github.com/sigoden/aichat/blob/main/config.example.yaml>\\nfor supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  model = \\\"ollama:mistral-small3.1:latest\\\";\\n  clients = [\\n    {\\n      type = \\\"openai-compatible\\\";\\n      name = \\\"ollama\\\";\\n      api_base = \\\"http://localhost:11434/v1\\\";\\n      models = [\\n        {\\n          name = \\\"mistral-small3.1:latest\\\";\\n          supports_function_calling = true;\\n          supports_vision = true;\\n        }\\n      ];\\n    }\\n  ];\\n}\\n\"},\"loc\":[\"programs\",\"aichat\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.aider-chat.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aider-chat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aider-chat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable aider-chat.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"aider-chat\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.aider-chat.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aider-chat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aider-chat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.aider-chat\"},\"description\":\"The aider-chat package to use.\",\"loc\":[\"programs\",\"aider-chat\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.aider-chat.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aider-chat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aider-chat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for aider-chat. All the available options can be found here:\\n<https://aider.chat/docs/config/aider_conf.html#sample-yaml-config-file>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  architect = true;\\n  auto-accept-architect = false;\\n  cache-prompts = true;\\n  check-model-accepts-settings = false;\\n  dark-mode = true;\\n  dirty-commits = false;\\n  lint = true;\\n  show-model-warnings = false;\\n  verify-ssl = false;\\n}\"},\"loc\":[\"programs\",\"aider-chat\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.airlift.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/airlift.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/airlift.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable airlift.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"airlift\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.airlift.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/airlift.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/airlift.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.airlift\"},\"description\":\"The airlift package to use.\",\"loc\":[\"programs\",\"airlift\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.airlift.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/airlift.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/airlift.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for airlift. All the available options can be found here:\\n<https://artifacthub.io/packages/helm/apache-airflow/airflow?modal=values>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  cluster_config_file = \\\"/path/to/cluster/config.yaml\\\";\\n  dag_path = \\\"/path/to/dags\\\";\\n  extra_volume_mounts = [\\n    \\\"hostPath=/my/cool/path,containerPath=/my/mounted/path,name=a_unique_name\\\"\\n  ];\\n  helm_chart_version = \\\"1.0.0\\\";\\n  helm_values_file = \\\"/path/to/values.yaml\\\";\\n  image = \\\"apache/airflow:2.6.0\\\";\\n  plugin_path = \\\"/path/to/plugins\\\";\\n  port = 8080;\\n  post_start_dag_id = \\\"example_dag_id\\\";\\n  requirements_file = \\\"/path/to/requirements.txt\\\";\\n}\"},\"loc\":[\"programs\",\"airlift\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.alacritty.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/alacritty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/alacritty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Alacritty.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"alacritty\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.alacritty.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/alacritty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/alacritty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.alacritty\"},\"description\":\"The alacritty package to use.\",\"loc\":[\"programs\",\"alacritty\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.alacritty.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/alacritty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/alacritty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/alacritty/alacritty.yml` or\\n{file}`$XDG_CONFIG_HOME/alacritty/alacritty.toml`\\n(the latter being used for alacritty 0.13 and later).\\nSee <https://github.com/alacritty/alacritty/tree/master#configuration>\\nfor more info.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  keyboard = {\\n    bindings = [\\n      {\\n        chars = \\\"\\\\\\\\u000c\\\";\\n        key = \\\"K\\\";\\n        mods = \\\"Control\\\";\\n      }\\n    ];\\n  };\\n  window = {\\n    dimensions = {\\n      columns = 200;\\n      lines = 3;\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"alacritty\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.alacritty.theme\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/alacritty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/alacritty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A theme from the\\n[alacritty-theme](https://github.com/alacritty/alacritty-theme)\\nrepository to import in the configuration.\\nSee <https://github.com/alacritty/alacritty-theme/tree/master/themes>\\nfor a list of available themes.\\nIf you would like to import your own theme, use\\n{option}`programs.alacritty.settings.general.import` or\\n{option}`programs.alacritty.settings.colors` directly.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"solarized_dark\\\"\"},\"loc\":[\"programs\",\"alacritty\",\"theme\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.alacritty.themePackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/alacritty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/alacritty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.alacritty-theme\"},\"description\":\"The alacritty-theme package to use.\",\"loc\":[\"programs\",\"alacritty\",\"themePackage\"],\"readOnly\":false,\"type\":\"package\"},\"programs.algia.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/algia.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/algia.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable algia.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"algia\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.algia.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/algia.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/algia.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.algia\"},\"description\":\"The algia package to use.\",\"loc\":[\"programs\",\"algia\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.algia.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/algia.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/algia.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for algia. All the available options can be found here:\\n<https://github.com/mattn/algia?tab=readme-ov-file#configuration>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  privatekey = \\\"nsecXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\\\";\\n  relays = {\\n    \\\"wss =//relay-jp.nostr.wirednet.jp\\\" = {\\n      read = true;\\n      search = false;\\n      write = true;\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"algia\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.aliae.configLocation\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/aliae.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/aliae.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${config.home.homeDirectory}/.aliae.yaml\"},\"description\":\"Path where aliae should look for its config file. This doesn't override\\nwhere Home-Manager places the generated config file. Changing this option\\ncould prevent aliae from using the settings defined in your Home-Manager\\nconfiguration.\\n\",