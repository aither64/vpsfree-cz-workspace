ds\n  # but since we do not use FHS, they are broken.\n  # And we do not want to hardcode the correct paths\n  # since then every GTK app would pull in gnome-backgrounds.\n  # Let’s just override the broken paths so that people are not confused.\n  [org.gnome.desktop.background]\n  picture-uri=''\n  picture-uri-dark=''\n\n  [org.gnome.desktop.screensaver]\n  picture-uri=''\nEOF\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/z01xbjkqyj0w6v6xxlnl0h2pgvpjwj2c-gsettings-desktop-schemas-50.1.tar.xz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"50.1"},"inputs":{"drvs":{"2i7prvz6cdf1l28g0nb5fybnrhzpzw5k-meson-1.10.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"63zjnxw73yn1avnz9vcsb4hjlsvd0gls-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6ib09qsay7w3ha9b3ccs7qaaks0i7acw-gobject-introspection-wrapped-1.86.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"7n4v03za9ax6a94siq7kc9x15xxsx4gz-gsettings-desktop-schemas-50.1.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"m6b8286d4pf752545lzs6n9q8r3n86c0-ninja-1.13.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"p1g5jzfyxwpv5rn08hvaqz8rgp62xx1y-glib-2.88.3.drv":{"dynamicOutputs":{},"outputs":["dev"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"gsettings-desktop-schemas-50.1","outputs":{"out":{"path":"1qc14bhn0a3awjj1jq7mkgk43jrpviy8-gsettings-desktop-schemas-50.1"}},"system":"x86_64-linux","version":4},"xqxb9q4f0izf8s15d3wqlg06vajd2i8y-tinycc-musl-unstable-2025-12-03-compiler.drv":{"args":["-e","/nix/store/9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh"],"builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","env":