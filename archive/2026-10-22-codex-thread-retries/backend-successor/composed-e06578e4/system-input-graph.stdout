ix-community/home-manager/blob/release-26.05/modules/programs/asciinema.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Enable installing asciinema and writing configuration file.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"asciinema\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.asciinema.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/asciinema.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/asciinema.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.asciinema\"},\"description\":\"The asciinema package to use.\",\"loc\":[\"programs\",\"asciinema\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.asciinema.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/asciinema.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/asciinema.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Declare-able configurations for asciinema written to\\n{file}`$XDG_CONFIG_HOME/asciinema/config.toml`.\\n\\n\\nCheck official docs for available configurations;\\nhttps://docs.asciinema.org/manual/cli/configuration/v3/#config-file\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  notifications = {\\n    command = \\\"tmux display-message \\\\\\\"$TEXT\\\\\\\"\\\";\\n    enable = false;\\n  };\\n  playback = {\\n    next_marker_key = \\\"m\\\";\\n    pause_key = \\\"^p\\\";\\n    speed = 2;\\n    step_key = \\\"s\\\";\\n  };\\n  server = {\\n    url = \\\"https://asciinema.example.com\\\";\\n  };\\n  session = {\\n    add_marker_key = \\\"^x\\\";\\n    capture_env = \\\"SHELL,TERM,USER\\\";\\n    capture_input = true;\\n    command = \\\"/run/current-system/sw/bin/bash -l\\\";\\n    idle_time_limit = 2;\\n    pause_key = \\\"^p\\\";\\n    prefix_key = \\\"^a\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"asciinema\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.ashell.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ashell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ashell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable ashell, a ready to go wayland status bar for hyprland.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ashell\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ashell.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ashell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ashell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.ashell\"},\"description\":\"The ashell package to use.\",\"loc\":[\"programs\",\"ashell\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.ashell.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ashell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ashell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Ashell configuration written to {file}`$XDG_CONFIG_HOME/ashell/config.toml` (0.5.0+)\\nor {file}`$XDG_CONFIG_HOME/ashell/config.yaml` (<0.5.0).\\nFor available settings see\\n<https://github.com/MalpenZibo/ashell?tab=readme-ov-file#configuration>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  modules = {\\n    center = [\\n      \\\"Window Title\\\"\\n    ];\\n    left = [\\n      \\\"Workspaces\\\"\\n    ];\\n    right = [\\n      \\\"SystemInfo\\\"\\n      [\\n        \\\"Clock\\\"\\n        \\\"Privacy\\\"\\n        \\\"Settings\\\"\\n      ]\\n    ];\\n  };\\n  workspaces = {\\n    visibilityMode = \\\"MonitorSpecific\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"ashell\",\"settings\"],\"readOnly\":false,\"type\":\"null or TOML value\"},\"programs.ashell.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ashell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ashell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable ashell systemd service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ashell\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ashell.systemd.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ashell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ashell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.wayland.systemd.target\"},\"description\":\"The systemd target that will automatically start ashell.\\n\\nIf you set this to a WM-specific target, make sure that systemd\\nintegration for that WM is enabled (for example,\\n[](#opt-wayland.windowManager.hyprland.systemd.enable)). This is\\ntypically true by default.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"hyprland-session.target\\\"\"},\"loc\":[\"programs\",\"ashell\",\"systemd\",\"target\"],\"readOnly\":false,\"type\":\"string\"},\"programs.astroid.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/astroid>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/astroid\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Astroid.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"astroid\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.astroid.externalEditor\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/astroid>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/astroid\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"You can use the following variables:\\n\\n`%1`\\n: file name\\n\\n`%2`\\n: server name\\n\\n`%3`\\n: socket ID\\n\\nSee [Customizing editor](https://github.com/astroidmail/astroid/wiki/Customizing-editor)\\non the Astroid wiki.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"nvim-qt -- -c 'set ft=mail' '+set fileencoding=utf-8' '+set ff=unix' '+set enc=utf-8' '+set fo+=w' %1\\\"\"},\"loc\":[\"programs\",\"astroid\",\"externalEditor\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.astroid.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/astroid>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/astroid\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"JSON config that will override the default Astroid configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  poll = {\\n    interval = 0;\\n  };\\n}\"},\"loc\":[\"programs\",\"astroid\",\"extraConfig\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.astroid.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/astroid>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/astroid\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.astroid\"},\"description\":\"The astroid package to use.\",\"loc\":[\"programs\",\"astroid\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.astroid.pollScript\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/astroid>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/astroid\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Script to run to fetch/update mails.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"mbsync gmail\\\"\"},\"loc\":[\"programs\",\"astroid\",\"pollScript\"],\"readOnly\":false,\"type\":\"string\"},\"programs.atool.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atool.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atool.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable atool a commandline archive manager..\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"atool\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.atool.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atool.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atool.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra packages for atool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"# all supported archive backends\\nwith pkgs; [ bzip2 cpio gnutar gzip lhasa lzop p7zip unrar-free unzip xz zip ]\\n\"},\"loc\":[\"programs\",\"atool\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.atool.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atool.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atool.nix\"}],\"description\":\"Final atool package bundled with extraPackages.\\n\",\"loc\":[\"programs\",\"atool\",\"finalPackage\"],\"readOnly\":true,\"type\":\"package\"},\"programs.atool.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atool.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atool.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.atool\"},\"description\":\"The atool package to use.\",\"loc\":[\"programs\",\"atool\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.atool.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atool.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atool.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"atool settings to generate {file}`~/.atoolrc`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  path_unrar = \\\"unrar-free\\\";\\n}\"},\"loc\":[\"programs\",\"atool\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer)\"},\"programs.atuin.daemon.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Atuin daemon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"atuin\",\"daemon\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.atuin.daemon.logLevel\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Verbosity of Atuin daemon logging.\\n\",\"loc\":[\"programs\",\"atuin\",\"daemon\",\"logLevel\"],\"readOnly\":false,\"type\":\"null or one of \\\"trace\\\", \\\"debug\\\", \\\"info\\\", \\\"warn\\\", \\\"error\\\"\"},\"programs.atuin.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable atuin.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"atuin\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.atuin.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\\n\\nIf enabled, this will bind `ctrl-r` to open the Atuin history.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"atuin\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.atuin.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\\n\\nIf enabled, this will bind the up-arrow key to open the Atuin history.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"atuin\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.atuin.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"atuin\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.atuin.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\\n\\nIf enabled, this will bind `ctrl-r` and the up-arrow key to open the\\nAtuin history.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"atuin\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.atuin.flags\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Flags to append to the shell hook.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--disable-up-arrow\\\"\\n  \\\"--disable-ctrl-r\\\"\\n]\"},\"loc\":[\"programs\",\"atuin\",\"flags\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.atuin.forceOverwriteSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When enabled, force overwriting of the Atuin configuration file\\n({file}`$XDG_CONFIG_HOME/atuin/config.toml`).\\nAny existing Atuin configuration will be lost.\\n\\nEnabling this is useful when adding settings for the first time\\nbecause Atuin writes its default config file after every single\\nshell command, which can make it difficult to manually remove.\\n\",\"loc\":[\"programs\",\"atuin\",\"forceOverwriteSettings\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.atuin.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.atuin\"},\"description\":\"The atuin package to use.\",\"loc\":[\"programs\",\"atuin\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.atuin.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/atuin/config.toml`.\\n\\nSee <https://docs.atuin.sh/configuration/config/> for the full list\\nof options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  auto_sync = true;\\n  sync_frequency = \\\"5m\\\";\\n  sync_address = \\\"https://api.atuin.sh\\\";\\n  search_mode = \\\"prefix\\\";\\n}\\n\"},\"loc\":[\"programs\",\"atuin\",\"settings\"],\"readOnly\":false,\"type\":\"Atuin configuration\"},\"programs.atuin.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/atuin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/atuin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Each theme is written to\\n{file}`$XDG_CONFIG_HOME/atuin/themes/theme-name.toml`\\nwhere the name of each attribute is the theme-name\\n\\nSee <https://docs.atuin.sh/guide/theming/> for the full list\\nof options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"my-theme\\\" = {\\n    theme.name = \\\"My Theme\\\";\\n    colors = {\\n      Base = \\\"#000000\\\";\\n      Title = \\\"#FFFFFF\\\";\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"atuin\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (TOML value or absolute path or strings concatenated with \\\"\\\\n\\\")\"},\"programs.autojump.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autojump.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autojump.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable autojump.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"autojump\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.autojump.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autojump.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autojump.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"autojump\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.autojump.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autojump.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autojump.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"autojump\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.autojump.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autojump.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autojump.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"autojump\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.autojump.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autojump.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autojump.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.autojump\"},\"description\":\"The autojump package to use.\",\"loc\":[\"programs\",\"autojump\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.autorandr.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autorandr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autorandr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Autorandr.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"autorandr\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.autorandr.hooks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autorandr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autorandr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Global hook scripts\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  postswitch = {\\n    \\\"notify-i3\\\" = \\\"${pkgs.i3}/bin/i3-msg restart\\\";\\n    \\\"change-background\\\" = readFile ./change-background.sh;\\n    \\\"change-dpi\\\" = ''\\n      case \\\"$AUTORANDR_CURRENT_PROFILE\\\" in\\n        default)\\n          DPI=120\\n          ;;\\n        home)\\n          DPI=192\\n          ;;\\n        work)\\n          DPI=144\\n          ;;\\n        *)\\n          echo \\\"Unknown profile: $AUTORANDR_CURRENT_PROFILE\\\"\\n          exit 1\\n      esac\\n\\n      echo \\\"Xft.dpi: $DPI\\\" | ${lib.getExe pkgs.xrdb} -merge\\n    ''\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"autorandr\",\"hooks\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.autorandr.hooks.postswitch\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autorandr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autorandr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Postswitch hook executed after mode switch.\",\"loc\":[\"programs\",\"autorandr\",\"hooks\",\"postswitch\"],\"readOnly\":false,\"type\":\"attribute set of strings concatenated with \\\"\\\\n\\\"\"},\"programs.autorandr.hooks.predetect\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autorandr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autorandr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Predetect hook executed before autorandr attempts to run xrandr.\\n\",\"loc\":[\"programs\",\"autorandr\",\"hooks\",\"predetect\"],\"readOnly\":false,\"type\":\"attribute set of strings concatenated with \\\"\\\\n\\\"\"},\"programs.autorandr.hooks.preswitch\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autorandr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autorandr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Preswitch hook executed before mode switch.\",\"loc\":[\"programs\",\"autorandr\",\"hooks\",\"preswitch\"],\"readOnly\":false,\"type\":\"attribute set of strings concatenated with \\\"\\\\n\\\"\"},\"programs.autorandr.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/autorandr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/autorandr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.autorandr\"},\"description\":\"The autorandr package to use.\",\"loc\":[\"programs\",\"autorandr\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"progra