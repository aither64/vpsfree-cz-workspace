["/nix/store/xrbwwd9zjvalag6hlxbrvgyb9y1wvfdn-bison-3.8.2","/nix/store/gfkkr23q11kvyz6xxyxz3qbsp1msxdcv-gettext-1.0","/nix/store/q6cpy3g7jva3lsnfzw4v48bb9058gmrp-python3-minimal-3.14.7","/nix/store/m38wglsqnh1mrmj2cmqa3pjb6w4yjxdi-glibc-2.44-25-dev"],"outputChecks":{"out":{}},"outputs":["out"],"patches":["/nix/store/xb11mg2vxj0al4gvh3hfy9wwz0kb1if0-2.44-master.patch","/nix/store/nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch","/nix/store/43lp683anlywwy1m6rv0mrw9m2iv681q-dont-use-system-ld-so-cache.patch","/nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch","/nix/store/llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch","/nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch","/nix/store/001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch","/nix/store/ywdz7fsdiff19745v59snscar3qsgd79-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch","/nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch","/nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch","/nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch"],"pname":"glibc-locales","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n","postInstall":"moveToOutput bin/getent $getent\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/q0lbdx5yv93a3md74kjhm0v2kljjii89-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"# Awful hack: `localedef' doesn't allow the path to `locale-archive'\n# to be overriden, but you *can* specify a prefix, i.e. it will use\n# <prefix>/<path-to-glibc>/lib/locale/locale-archive.  So we use\n# $TMPDIR as a prefix, meaning that the locale-archive is placed in\n# $TMPDIR/nix/store/...-glibc-.../lib/locale/locale-archive.\nLOCALEDEF_FLAGS+=\" --prefix=$TMPDIR\"\n\nexport inst_complocaledir=\"$TMPDIR/\"/nix/store/h4wfwic161kxrr74jlzla5lsm28hgary-glibc-2.44-25/lib/locale\nmkdir -p \"$inst_complocaledir\"\n\necho 'C.UTF-8/UTF-8 \\' >> ../localedata/SUPPORTED\n\n# Hack to allow building of the locales (needed since glibc-2.12)\nsubstituteInPlace ../localedata/Makefile \\\n  --replace-fail '$(rtld-prefix) $(common-objpfx)locale/localedef' 'localedef $(LOCALEDEF_FLAGS)'\n# Check that all locales to be built are supported\necho -n 'en_US.UTF-8/UTF-8 \\\n' \\\n  | sort -u > locales-to-build.txt\ncat ../localedata/SUPPORTED | grep ' \\\\' \\\n  | sort -u > locales-supported.txt\ncomm -13 locales-supported.txt locales-to-build.txt \\\n  > locales-unsupported.txt\nif [[ $(wc -c locales-unsupported.txt) != \"0 locales-unsupported.txt\" ]]; then\n  cat locales-supported.txt\n  echo \"Error: unsupported locales detected:\"\n  cat locales-unsupported.txt\n  echo \"You should choose from the list above the error.\"\n  false\nfi\n\necho SUPPORTED-LOCALES='en_US.UTF-8/UTF-8' > ../localedata/SUPPORTED\n","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"setupHook":"/nix/store/fbsh5pmwsmjj7h2ngslnamm250cv2bnq-locales-setup-hook.sh","src":"/nix/store/jq00nlpdcxgcj5xwx25jibn61a611234-glibc-2.44.tar.xz","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"2.44-25"},"system":"x86_64-linux","version":4},"r8d046xkazgiqdqabivbpwm5f187q7cn-unit-systemd-random-seed.service.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"name=systemd-random-seed.service\nmkdir -p \"$out/$(dirname -- \"$name\")\"\nmv \"$textPath\" \"$out/$name\"\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"unit-systemd-random-seed.service","nativeBuildInputs":"","out":"/nix/store/lnyac9wdwv1ncsfx8wrf0b3g3nvp11qs-unit-systemd-random-seed.service","outputs":"out","passAsFile":"buildCommand text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"[Unit]\n\n[Service]\nEnvironment=\"LOCALE_ARCHIVE=/nix/store/dc427sjs33dci797apv4lvsg1a69szn0-glibc-locales-2.42-100/lib/