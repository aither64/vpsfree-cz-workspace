"},\"wayland.windowManager.wayfire.xwayland.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/wayfire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/wayfire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable XWayland.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"wayfire\",\"xwayland\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.autostart.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-autostart.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-autostart.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable creation of XDG autostart entries.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"xdg\",\"autostart\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.autostart.entries\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-autostart.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-autostart.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Paths to desktop files that should be linked to `XDG_CONFIG_HOME/autostart`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"${pkgs.evolution}/share/applications/org.gnome.Evolution.desktop\\\"\\n]\\n\"},\"loc\":[\"xdg\",\"autostart\",\"entries\"],\"readOnly\":false,\"type\":\"list of absolute path\"},\"xdg.autostart.readOnly\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg-autostart.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg-autostart.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Make `XDG_CONFIG_HOME/autostart` a symlink to a readonly directory so that\\nprograms cannot install arbitrary autostart services.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"xdg\",\"autostart\",\"readOnly\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.binHome\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"~/.local/bin\\\"\"},\"description\":\"Absolute path to directory holding user-specific executables.\\n\\nSets `XDG_BIN_HOME` for the user if `xdg.enable` is set `true`.\\n\",\"loc\":[\"xdg\",\"binHome\"],\"readOnly\":false,\"type\":\"absolute path\"},\"xdg.cacheFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of files to link into the user's XDG\\ncache home.\\n\",\"loc\":[\"xdg\",\"cacheFile\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"xdg.cacheFile.<name>.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether this file should be generated. This option allows specific\\nfiles to be disabled.\\n\",\"loc\":[\"xdg\",\"cacheFile\",\"<name>\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.cacheFile.<name>.executable\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the execute bit. If `null`, defaults to the mode\\nof the {var}`source` file or to `false`\\nfor files created through the {var}`text` option.\\n\",\"loc\":[\"xdg\",\"cacheFile\",\"<name>\",\"executable\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"xdg.cacheFile.<name>.force\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether the target path should be unconditionally replaced\\nby the managed file source. Warning, this will silently\\ndelete the target regardless of whether it is a file or\\nlink.\\n\",\"loc\":[\"xdg\",\"cacheFile\",\"<name>\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.cacheFile.<name>.ignorelinks\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When `recursive` is enabled, adds the `-ignorelinks` flag to lndir.\\n\\nIt causes lndir to not treat symbolic links in the source directory specially.\\nThe link created in the target directory will point back to the corresponding\\nsymbolic link in the source directory. If that link points to a directory, the\\nresulting target will be a link to the source tree's symlink rather than a\\nrecursively linked directory tree.\\n\",\"loc\":[\"xdg\",\"cacheFile\",\"<name>\",\"ignorelinks\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.cacheFile.<name>.onChange\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Shell commands to run when file has changed between\\ngenerations. The script will be run\\n*after* the new files have been linked\\ninto place.\\n\\nNote, this code is always run when `recursive` is\\nenabled.\\n\",\"loc\":[\"xdg\",\"cacheFile\",\"<name>\",\"onChange\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"xdg.cacheFile.<name>.recursive\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If the file source is a directory, then this option\\ndetermines whether the directory should be recursively\\nlinked to the target location. This option has no effect\\nif the source is a file.\\n\\nIf `false` (the default) then the target\\nwill be a symbolic link to the source directory. If\\n`true` then the target will be a\\ndirectory structure matching the source's but whose leaves\\nare symbolic links to the files of the source directory.\\n\",\"loc\":[\"xdg\",\"cacheFile\",\"<name>\",\"recursive\"],\"readOnly\":false,\"type\":\"boolean\"},\"xdg.cacheFile.<name>.source\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"description\":\"Path of the source file or directory. If\\n[](#opt-xdg.cacheFile._name_.text)\\nis non-null then this option will automatically point to a file\\ncontaining that text.\\n\",\"loc\":[\"xdg\",\"cacheFile\",\"<name>\",\"source\"],\"readOnly\":false,\"type\":\"absolute path\"},\"xdg.cacheFile.<name>.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/misc/xdg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/misc/xdg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"name\"},\"description\":\"Path to target file relative to {var}`xdg.cacheHome`.\\n\",\"loc\":[\"xdg\",\"cacheFile\",\"<name>\",\"target\"],\"readOnly\":false,\"type\":\"non-