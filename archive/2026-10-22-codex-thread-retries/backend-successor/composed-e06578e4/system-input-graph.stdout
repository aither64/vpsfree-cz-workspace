m -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"Ascii85 afm hashery ruby-rc4 ttfunk","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"pdf-reader","gemPath":"/nix/store/4jqazcjadrq25z7g706r59payzg9x9aa-ruby3.4-Ascii85-2.0.1 /nix/store/9x70akhf3xrmigjy58wdr39cvaych4fs-ruby3.4-afm-1.0.0 /nix/store/jkm472avczh8hwmh9fdny4x6p4m2v1bd-ruby3.4-hashery-2.1.2 /nix/store/nbh73f1fixn1sqbi0sbzlw43p8xkch84-ruby3.4-ruby-rc4-0.1.5 /nix/store/sg6z0ggn1s61wbzrck8i6b3s2wqxz756-ruby3.4-ttfunk-1.7.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-pdf-reader-2.15.0","nativeBuildInputs":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9 /nix/store/7whrgb2wib2q83wgbs78xsq9h25lf3aw-make-shell-wrapper-hook","out":"/nix/store/xw3smrgw1wh9wdr5dkp8v5bpyi99976l-ruby3.4-pdf-reader-2.15.0","outputs":"out","patches":"","pname":"pdf-reader","propagatedBuildInputs":"/nix/store/4jqazcjadrq25z7g706r59payzg9x9aa-ruby3.4-Ascii85-2.0.1 /nix/store/9x70akhf3xrmigjy58wdr39cvaych4fs-ruby3.4-afm-1.0.0 /nix/store/jkm472avczh8hwmh9fdny4x6p4m2v1bd-ruby3.4-hashery-2.1.2 /nix/store/nbh73f1fixn1sqbi0sbzlw43p8xkch84-ruby3.4-ruby-rc4-0.1.5 /nix/store/sg6z0ggn1s61wbzrck8i6b3s2wqxz756-ruby3.4-ttfunk-1.7.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/4jqazcjadrq25z7g706r59payzg9x9aa-ruby3.4-Ascii85-2.0.1 /nix/store/9x70akhf3xrmigjy58wdr39cvaych4fs-ruby3.4-afm-1.0.0 /nix/store/jkm472avczh8hwmh9fdny4x6p4m2v1bd-ruby3.4-hashery-2.1.2 /nix/store/nbh73f1fixn1sqbi0sbzlw43p8xkch84-ruby3.4-ruby-rc4-0.1.5 /nix/store/sg6z0ggn1s61wbzrck8i6b3s2wqxz756-ruby3.4-ttfunk-1.7.0","ruby":"/nix/store/3rcm37q1arwggzjxzcn