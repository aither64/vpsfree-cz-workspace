A-Z_][0-9A-Za-z_'\\''-]*@' \"$target\"\n  echo Use the more precise '`substitute`' function if this check is in error.\n  exit 1\nfi\nrunHook postCheck\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"1","doInstallCheck":"","dontUnpack":"1","mesonFlags":"","name":"absolute_gir_path.patch","nativeBuildInputs":"","out":"/nix/store/73yz4fj4fgs7zkkv1yp70py82b35wy7f-absolute_gir_path.patch","outputs":"out","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/rzf1nici52cxz44ng0z4k31wm205zbfz-absolute_gir_path.patch","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"qv3ipv0a2wnkq0g0lpvs31h061d61hmx-cairo-1.18.4.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","rzf1nici52cxz44ng0z4k31wm205zbfz-absolute_gir_path.patch","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"absolute_gir_path.patch","outputs":{"out":{"path":"73yz4fj4fgs7zkkv1yp70py82b35wy7f-absolute_gir_path.patch"}},"system":"x86_64-linux","version":4},"6dhvprl7z4jx4rxs03kamxd8l9wa2d2g-python-3.14.4.drv":{"args":["-e","/nix/store/70acbfgbz5cxsx4sqzcnj8qaqhb4i9ay-bash-builder.sh"],"builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","env":{"PATH":"/nix/store/7syvsjbzhbdqhyj5b0ww10aa065563q2-gcc-15.3.0/bin:/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/bin:/nix/store/z8va212wrar5kxwv4ivlalrzasm2clx1-binutils-2.46.0/bin:/nix/store/d49lc4arnlwgiw5i6x12hs912yxkvmpy-gnumake-musl-4.4.1/bin:/nix/store/8rshwxfxypgdc35c4ys7b4yn92i5g7fn-gnupatch-2.5.9/bin:/nix/store/xma9y5ns1idhl5j1pj2mcdrr69bipry3-gnused-4.2/bin:/nix/store/p3v1q7jgdybvzzayn3id03ij2j0yvliv-gnugrep-2.4/bin:/nix/store/qkz127335jxgm1zr92gcp3ah875p5g2v-gawk-5.3.2/bin:/nix/store/sifjanq941n74570cr2vl2ach4jfi5nc-diffutils-3.8/bin:/nix/store/yr5b2xrml9jnakkyki7hnqvhi4ah01n9-findutils-4.10.0/bin:/nix/store/z2i1ia215wn5nv6srxmk6b4wyzrcjyl1-gnutar-1.35/bin:/nix/store/vdy82rmv74lwdr5afy9c2v19na3dq7a4-xz-5.8.3/bin:/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin:/nix/store/z498zyjm053c83r00qnwgg2pjwgc10d2-bootstrap-coreutils-musl-9.10/bin","SHELL":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","buildCommand":"# Unpack\ntar xf /nix/store/vwj66jmx32xbw97zwbajmncp028kb93a-Python-3.14.4.tar.xz\ncd Python-3.14.4\n\n# Patch\npatch -Np1 -i /nix/store/jqin2kzvzrvi30cxda5zp7qz1fanmz7v-no-ldconfig.patch\n\n# Configure\nexport CC=musl-gcc\nexport C_INCLUDE_PATH=\"/nix/store/kswgqi6n5a585pgmyay5kh6n7mj5wvaw-zlib-1.3.2/include\"\nexport LIBRARY_PATH=\"/nix/store/kswgqi6n5a585pgmyay5kh6n7mj5wvaw-zlib-1.3.2/lib\"\nexport LDFLAGS=\"-Wl,-rpath,/nix/store/kswgqi6n5a585pgmyay5kh6n7mj5wvaw-zlib-1.3.2/lib -L/nix/store/kswgqi6n5a585pgmyay5kh6n7mj5wvaw-zlib-1.3.2/lib\"\nexport LD_LIBRARY_PATH=\"$LIBRARY_PATH\"\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --disable-test-modules \\\n  --without-ensurepip \\\n  --without-static-libpython\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install\n\n# Remove lib-dynload extension modules not needed for glibc's build scripts.\n# glibc uses Python only for scripts that import: os, re, subprocess, argparse,\n# pathlib, collections, tempfile.  Following the import chain:\n#   subprocess -> selectors -> math, select, fcntl, _posixsubprocess\n#   pathlib -> grp\n#   tempfile -> random -> _random, bisect -> _bisect\n# Everything else in lib-dynload is dead weight in the bootstrap context.\nfind $out/lib/python*/lib-dynload -name '*.so' \\\n  ! -name '_bisect*' \\\n  ! -name '_posixsubprocess*' \\\n  ! -name '_random*' \\\n  ! -name 'fcntl*' \\\n  ! -name 'grp*' \\\n  ! -name 'math*' \\\n  ! -name 'select*' \\\n  -delete\n\nrm -rf \\\n  $out/lib/python*/ensurepip \\\n  $out/lib/python*/idlelib \\\n  $out/lib/python*/site-packages \\\n  $out/lib/python*/test \\\n  $out/lib/python*/tkinter \\\n  $out/lib/python*/turtledemo \\\n  $out/share/man\n\nrm -f $out/bin/idle* $out/bin/pip*\nfind $out/lib/python* -type d -name __pycache__ -prune -exec rm -rf {} +\nstrip --strip-unneeded $out/bin/python3.14 $out/lib/python*/lib-dynload/*.so || true\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"python-3.14.4","out":"/nix/store/4jn1zwd43wrb0rhqf42sndbz831flhl7-python-3.14.4","passAsFile":"buildCommand","pname":"python","system":"x86_64-linux","version":"3.14.4"},"inputs":{"drvs":{"3zhi7fn92ym1ds0n3yybmjyjvksypi39-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b0xnqkbv7qnbbbc7zhqwahygjf7mc2i-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gsx86gz3hgynhcx7cxsif30zwq0qg80-gcc-15.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gwpvw0ssr7xmfzvy97c6f493fhc2f7r-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"haldh962ah38jwv0i8f72nr68nn7vw9r-Python-3.14.4.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"hxagi71byf79kd6630nkzzslsmmjir34-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"jm8c5a9ysfm3fckryllnl6pd3nm1hd17-bootstrap-coreutils-musl-9.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"l6a6rj0gy31gp6k7k80qzn4ni0yvyzgh-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"rxa4s2hzk608za4lhmrc1xhsd7y3g6ym-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"s2g0la1392ys0bp34d0m38kmlzwi30v1-binutils-2.46.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a