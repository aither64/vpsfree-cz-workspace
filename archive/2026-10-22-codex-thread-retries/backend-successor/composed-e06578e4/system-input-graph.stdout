nfor more information about the format.\\n\",\"loc\":[\"services\",\"mbsync\",\"frequency\"],\"readOnly\":false,\"type\":\"string\"},\"services.mbsync.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mbsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mbsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.isync\"},\"description\":\"The isync package to use.\",\"loc\":[\"services\",\"mbsync\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.mbsync.postExec\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mbsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mbsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"An optional command to run after mbsync executes successfully.\\nThis is useful for running mailbox indexing tools.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\\${pkgs.mu}/bin/mu index\\\"\"},\"loc\":[\"services\",\"mbsync\",\"postExec\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.mbsync.preExec\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mbsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mbsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"An optional command to run before mbsync executes.  This is\\nuseful for creating the directories mbsync is going to use.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"mkdir -p %h/mail\\\"\"},\"loc\":[\"services\",\"mbsync\",\"preExec\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.mbsync.verbose\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mbsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mbsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether mbsync should produce verbose output.\\n\",\"loc\":[\"services\",\"mbsync\",\"verbose\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.megasync.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/megasync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/megasync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Megasync client.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"megasync\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.megasync.forceWayland\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/megasync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/megasync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Force Megasync to run on wayland\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"megasync\",\"forceWayland\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.megasync.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/megasync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/megasync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.megasync\"},\"description\":\"The megasync package to use.\",\"loc\":[\"services\",\"megasync\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.mopidy.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mopidy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mopidy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Mopidy music player daemon.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"mopidy\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.mopidy.extensionPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mopidy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mopidy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Mopidy extensions that should be loaded by the service.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs; [ mopidy-spotify mopidy-mpd mopidy-mpris ]\"},\"loc\":[\"services\",\"mopidy\",\"extensionPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"services.mopidy.extraConfigFiles\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mopidy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mopidy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra configuration files read by Mopidy when the service starts.\\nLater files in the list override earlier configuration files and\\nstructured settings.\\n\",\"loc\":[\"services\",\"mopidy\",\"extraConfigFiles\"],\"readOnly\":false,\"type\":\"list of absolute path\"},\"services.mopidy.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mopidy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mopidy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/mopidy/mopidy.conf`.\\n\\nSee <https://docs.mopidy.com/en/latest/config/> for\\nmore details.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  file = {\\n    media_dirs = [\\n      \\\"$XDG_MUSIC_DIR|Music\\\"\\n      \\\"~/library|Library\\\"\\n    ];\\n    follow_symlinks = true;\\n    excluded_file_extensions = [\\n      \\\".html\\\"\\n      \\\".zip\\\"\\n      \\\".jpg\\\"\\n      \\\".jpeg\\\"\\n      \\\".png\\\"\\n    ];\\n  };\\n\\n  # Please don't put your mopidy-spotify configuration in the public. :)\\n  # Think of your Spotify Premium subscription!\\n  spotify = {\\n    client_id = \\\"CLIENT_ID\\\";\\n    client_secret = \\\"CLIENT_SECRET\\\";\\n  };\\n}\\n\"},\"loc\":[\"services\",\"mopidy\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (Mopidy config value)\"},\"services.mpd-discord-rpc.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd-discord-rpc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd-discord-rpc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the mpd-discord-rpc service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"mpd-discord-rpc\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.mpd-discord-rpc.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd-discord-rpc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd-discord-rpc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.mpd-discord-rpc\"},\"description\":\"The mpd-discord-rpc package to use.\",\"loc\":[\"services\",\"mpd-discord-rpc\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.mpd-discord-rpc.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd-discord-rpc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd-discord-rpc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration included in `config.toml`.\\nFor available options see <https://github.com/JakeStanger/mpd-discord-rpc#configuration>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  format = {\\n    details = \\\"$title\\\";\\n    state = \\\"On $album by $artist\\\";\\n  };\\n  hosts = [\\n    \\\"localhost:6600\\\"\\n  ];\\n}\"},\"loc\":[\"services\",\"mpd-discord-rpc\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"services.mpd-mpris.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd-mpris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd-mpris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable mpd-mpris: An implementation of the MPRIS protocol for MPD.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"mpd-mpris\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.mpd-mpris.mpd.host\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd-mpris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd-mpris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The address where MPD is listening for connections.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"192.168.1.1\\\"\"},\"loc\":[\"services\",\"mpd-mpris\",\"mpd\",\"host\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.mpd-mpris.mpd.network\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd-mpris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd-mpris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The network used to dial to the MPD server. Check\\n<https://golang.org/pkg/net/#Dial>\\nfor available values (most common are \\\"tcp\\\" and \\\"unix\\\")\\n\",\"loc\":[\"services\",\"mpd-mpris\",\"mpd\",\"network\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.mpd-mpris.mpd.password\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd-mpris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd-mpris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The password to connect to MPD.\\n\",\"loc\":[\"services\",\"mpd-mpris\",\"mpd\",\"password\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.mpd-mpris.mpd.port\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd-mpris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd-mpris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The port number where MPD is listening for connections.\\n\",\"loc\":[\"services\",\"mpd-mpris\",\"mpd\",\"port\"],\"readOnly\":false,\"type\":\"null or 16 bit unsigned integer; between 0 and 65535 (both inclusive)\"},\"services.mpd-mpris.mpd.useLocal\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd-mpris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd-mpris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.services.mpd.enable\"},\"description\":\"Whether to configure for the local MPD daemon. If\\n`true` the `network`,\\n`host`, and `port`\\nsettings are ignored.\\n\",\"loc\":[\"services\",\"mpd-mpris\",\"mpd\",\"useLocal\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.mpd-mpris.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd-mpris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd-mpris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.mpd-mpris\"},\"description\":\"The mpd-mpris package to use.\",\"loc\":[\"services\",\"mpd-mpris\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.mpd.dataDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$XDG_DATA_HOME/mpd\\\"\"},\"description\":\"The directory where MPD stores its state, tag cache,\\nplaylists etc.\\n\",\"loc\":[\"services\",\"mpd\",\"dataDir\"],\"readOnly\":false,\"type\":\"absolute path\"},\"services.mpd.dbFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\\${dataDir}/tag_cache\\\"\"},\"description\":\"The path to MPD's database. If set to\\n`null` the parameter is omitted from the\\nconfiguration.\\n\",\"loc\":[\"services\",\"mpd\",\"dbFile\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.mpd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable MPD, the music player daemon.\\n\",\"loc\":[\"services\",\"mpd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.mpd.enableSessionVariables\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to set {env}`MPD_HOST` {env}`MPD_PORT` environment variables\\naccording to {option}`services.mpd.network`.\\n\",\"loc\":[\"services\",\"mpd\",\"enableSessionVariables\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.mpd.extraArgs\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra command-line arguments to pass to MPD.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--verbose\\\"\\n]\"},\"loc\":[\"services\",\"mpd\",\"extraArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.mpd.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra directives added to the end of MPD's configuration\\nfile, {file}`mpd.conf`. Basic configuration\\nlike file location and uid/gid is added automatically to the\\nbeginning of the file. For available options see\\n{manpage}`mpd.conf(5)`.\\n\",\"loc\":[\"services\",\"mpd\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"services.mpd.generatedConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"description\":\"The generated config.\\nCan be used by user as:\\n\\n  configFile.\\\"mpd/mpd.conf\\\".text = config.services.mpd.generatedConfig;\\n\",\"loc\":[\"services\",\"mpd\",\"generatedConfig\"],\"readOnly\":true,\"type\":\"string\"},\"services.mpd.musicDirectory\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${home.homeDirectory}/music    if state version < 22.11\\n${xdg.userDirs.music}          if xdg.userDirs.enable == true\\nundefined                      otherwise\\n\"},\"description\":\"The directory where mpd reads music from.\\n\\nIf [](#opt-xdg.userDirs.enable) is\\n`true` then the defined XDG music directory is used.\\nOtherwise, you must explicitly specify a value.\\n\",\"loc\":[\"services\",\"mpd\",\"musicDirectory\"],\"readOnly\":false,\"type\":\"absolute path or string\"},\"services.mpd.network.listenAddress\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"127.0.0.1\\\"\"},\"description\":\"The address for the daemon to listen on.\\nUse `any` to listen on all addresses.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"any\\\"\"},\"loc\":[\"services\",\"mpd\",\"network\",\"listenAddress\"],\"readOnly\":false,\"type\":\"string\"},\"services.mpd.network.port\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"6600\"},\"description\":\"The TCP port on which the the daemon will listen.\\n\",\"loc\":[\"services\",\"mpd\",\"network\",\"port\"],\"readOnly\":false,\"type\":\"16 bit unsigned integer; between 0 and 65535 (both inclusive)\"},\"services.mpd.network.startWhenNeeded\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Enable systemd socket activation. This is only supported on Linux.\\n\",\"loc\":[\"services\",\"mpd\",\"network\",\"startWhenNeeded\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.mpd.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.mpd\"},\"description\":\"The mpd package to use.\",\"loc\":[\"services\",\"mpd\",\"package\"],\"readOnly\":false,\