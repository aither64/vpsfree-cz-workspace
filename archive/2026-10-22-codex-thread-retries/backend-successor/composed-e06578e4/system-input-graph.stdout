-libksba-1.6.7.tar.bz2","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.6.7"},"inputs":{"drvs":{"334kkxv2cdbavxbw33glc73ycmgz97rs-libksba-1.6.7.tar.bz2.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"jzwacclklik7wjl3pqajq05wk0xr0nm7-gettext-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"wcggwm7vwfy61fwsy7j0psw8scdd6zaf-libgpg-error-1.59.drv":{"dynamicOutputs":{},"outputs":["dev"]},"xv2y3sfvlgay9nrai47mcnag847pyk6l-gcc-wrapper-15.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"libksba-1.6.7","outputs":{"dev":{"path":"cx9a2fjbj6rn2s2awcbyd7p578jbbaqx-libksba-1.6.7-dev"},"info":{"path":"1q7jfgz3mm2zwng4qdcpzl43bpq8cfkf-libksba-1.6.7-info"},"out":{"path":"g2i1ag6knj631rljjfamlz9igbfricgg-libksba-1.6.7"}},"system":"x86_64-linux","version":4},"j3n345fjfih7z96sngf55600v93d7hax-tinycc-bootstrappable-unstable-2024-07-07-source-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"tinycc-bootstrappable-unstable-2024-07-07-source-builder","out":"/nix/store/ydr5rpwkxdx7grbg4g8r49hirzfq2ghg-tinycc-bootstrappable-unstable-2024-07-07-source-builder","passAsFile":"text","system":"x86_64-linux","text":"ungz --file /nix/store/2kx2q1ph63s63dlq0g31sa7wk83w7m0z-tinycc-ea3900f6d5e71776c5cfabcabee317652e3a19ee.tar.gz --output tinycc.tar\nmkdir -p ${out}\ncd ${out}\nuntar --file ${NIX_BUILD_TOP}/tinycc.tar\n\n# Patch\ncd tinycc-ea3900f6d5e71776c5cfabcabee317652e3a19ee\n\ncp /nix/store/rc3p9vwch6l2ljhr5q6a8q8kyfkf4d9y-mes-libc-0.27.1/lib/libtcc1.c lib/libtcc1.c\n\n# Static link by default\nreplace --file libtcc.c --output libtcc.c --match-on \"s->ms_extensions = 1;\" --replace-with \"s->ms_extensions = 1; s->static_link = 1;\"\n\n# TODO: may not need following patches for mes 0.28.\n# Or maybe we don't need tinycc-bootstrappable for mes 0.28?\n\n# mes-libc depends on max_align_t in stddef.h, which is not provided by tinycc-boot\nreplace --file include/stddef.h --output include/stddef.h --match-on \"void *alloca\" --replace-with \"\n  typedef union { long double ld; long long ll; } max_align_t;\n  void *alloca\n\"\n# VLA is broken in mescc 0.27.1. alloca is not available either. Let's just use malloc and leak on x86_64.\nreplace --file x86_64-gen.c --output x86_64-gen.c --match-on \"char _onstack[nb_args], *onstack = _onstack;\" --replace-with \"char *onstack = tcc_malloc(nb_args);\"\n\n# Abort is not provided by mescc\nreplace --file x86_64-gen.c --output x86_64-gen.c --match-on \"abort();\" --replace-with \"/* abort(); */\"\n\n# Work around bug in mescc.\nreplace --file x86_64-gen.c --output x86_64-gen.c --match-on \"g(vtop->c.i & (ll ? 63 : 31));\" --replace-with \"if (ll) g(vtop->c.i & 63); else g(vtop->c.i & 31);\"\n\n# Normally tinycc only performs relocations on the PLT when creating a dynamically-linked executable.\n# This is fine for most targets because a PLT is not generated. But on x86_64 we do generate a PLT and hence\n# we must assure plt->got references are appropriately relocated.\n# This patch is applied even if we aren't targeting x86_64. Because there's no PLT outside x86_64, it's basically a no-op.\nreplace --file tccelf.c --output tccelf.c --match-on \"fill_got(s1);\" --replace-with \"\n{\n  fill_got(s1);\n  relocate_plt(s1);\n}\n\"\n"},"inputs":{"drvs":{"fbaq796w3day6gw5sdvw014v9ppip38q-mes-libc-0.27.1.drv":{