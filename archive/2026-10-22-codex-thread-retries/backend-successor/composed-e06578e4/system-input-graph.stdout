n  \"--test-wrapper=/nix/store/pyy5g65l74ar0vkl7cpz2s06f1cqlw3g-haskell-generic-builder-test-wrapper.sh\"\n  \n)\nexport NIX_GHC_PACKAGE_PATH_FOR_TEST=\"${NIX_GHC_PACKAGE_PATH_FOR_TEST:-$packageConfDir:}\"\n./Setup test  $checkFlags ${checkFlagsArray:+\"${checkFlagsArray[@]}\"}\nrunHook postCheck\n","cmakeFlags":"","compileBuildDriverPhase":"runHook preCompileBuildDriver\n\nfor i in Setup.hs Setup.lhs /nix/store/4mdp8nhyfddh7bllbi7xszz7k9955n79-Setup.hs; do\n  test -f $i && break\ndone\n\necho setupCompileFlags: $setupCompileFlags\nghc $setupCompileFlags --make -o Setup -odir $builddir -hidir $builddir $i\n\nrunHook postCompileBuildDriver\n","configureFlags":"","configurePhase":"runHook preConfigure\n\necho configureFlags: $configureFlags\n./Setup configure $configureFlags 2>&1 | /nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/tee \"$NIX_BUILD_TOP/cabal-configure.log\"\nif grep -E -q -z 'Warning:.*depends on multiple versions' \"$NIX_BUILD_TOP/cabal-configure.log\"; then\n  echo >&2 \"*** abort because of serious configure-time warning from Cabal\"\n  exit 1\nfi\n\n\nrunHook postConfigure\n","configurePlatforms":"","depsBuildBuild":"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"1","doInstallCheck":"","doc":"/nix/store/p4wb8zpqywh62agz3jj4p5h1c8hnk5fw-strict-0.5.1-doc","haddockPhase":"runHook preHaddock\n./Setup haddock --html \\\n  --hoogle \\\n  --quickjump \\\n  --hyperlink-source \\\n  --haddock-option=-j$NIX_BUILD_CORES \\\n  --haddock-option=--no-tmp-comp-dir \\\n  \n\nrunHook postHaddock\n","hardeningDisable":"","installPhase":"runHook preInstall\n\n./Setup copy \nlocal packageConfDir=\"$out/lib/ghc-9.10.3/lib/package.conf.d\"\nlocal packageConfFile=\"$packageConfDir/strict-0.5.1.conf\"\nmkdir -p \"$packageConfDir\"\n./Setup register --gen-pkg-config=$packageConfFile\nif [ -d \"$packageConfFile\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/strict-0.5.1\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"strict-0.5.1","nativeBuildInputs":"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3 /nix/store/svrzimmpgp5b9knw00b7cq6081hwadaz-remove-references-to","out":"/nix/store/9nhzwfngzmpvvsdyjvh5kqkfzi63kgjz-strict-0.5.1","outputs":"out doc","patches":"","pname":"strict","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"echo \"Replace Cabal file with edited version from mirror://hackage/strict-0.5.1/revision/1.cabal.\"\ncp /nix/store/fk61dv31ccxwl35zlxpkzrvh1xcjqbns-strict-0.5.1-r1.cabal strict.cabal\n\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"/nix/store/v0bp4dhsscqiy5m7j7l1d71qc5fff424-assoc-1.1.1      /nix/store/fr4spxyg4ykllhvjisigwwxaz4far06l-hashable-1.5.1.0  /nix/store/di0i5yr1dqx16x5mklqxs6ild4w77v80-these-1.2.1 ","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3.\"\nexport PATH=/nix/store/kg9hwh3pyb3lh41cfs5ym54xy4qymks1-hscolour-1.25/bin:$PATH\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname  --docdir=$doc/share/doc/strict-0.5.1 --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --enable-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --enable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/fsrb31ha52zg847j45yqvbbss2qhks1b-strict-0.5.1.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.5.1"},"inputs":{"drvs":{"0hjx268x0n00idh85p9qrf67bni4kadg-hashable-1.5.1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"3a9mnxb80m3bsrax114w30qaicfqz5yx-strict-0.5.1-r1.cabal.drv":{"dynamicOutputs":{},"outputs":["out"]},"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"7v69i4ixacxjdan9gx0h4j9q0g3jv11k-glibc-locales-2.42-100.drv":{"dynamicOutputs":{},"outputs":["out"]},"9ldpfy7a53085ny16x0a1hqhhcbw3a2z-these-1.2.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"akijim2d5zpmxry2wvsfgw3dv2szv0s7-assoc-1.1.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"d22jg4nh7xm8mdw99p176dw8j35lhrsk-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bas