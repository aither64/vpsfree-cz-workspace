nager-aither.service","outputs":{"out":{"path":"qichq5g997gc65iwf9g3cqr2dkgpv6hy-unit-home-manager-aither.service"}},"system":"x86_64-linux","version":4},"gm72d1wbfqxkadr1zy8ap9bi5rwzi593-options.json.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","baseJSON":"/nix/store/iyc092w3nzbfjhpgs9pgpgg8vjjyzpxk-base.json","buildCommand":"  # Export list of options in different format.\n  dst=$out/share/doc/nixos\n  mkdir -p $dst\n\n  TOUCH_IF_DB=$dst/.used-docbook \\\n  python /nix/store/yar7i652zwjkqsyrrqxaxlk1zl3zlfx8-mergeJSON.py \\\n    --warnings-are-errors \\\n    $baseJSON $optionsPath \\\n    > $dst/options.json\n\nif grep /nixpkgs/nixos/modules $dst/options.json; then\n  echo \"The manual appears to depend on the location of Nixpkgs, which is bad\"\n  echo \"since this prevents sharing via the NixOS channel.  This is typically\"\n  echo \"caused by an option default that refers to a relative path (see above\"\n  echo \"for hints about the offending path).\"\n  exit 1\nfi\n\n  brotli -9 < $dst/options.json > $dst/options.json.br\n\n  mkdir -p $out/nix-support\n  echo \"file json $dst/options.json\" >> $out/nix-support/hydra-build-products\n  echo \"file json-br $dst/options.json.br\" >> $out/nix-support/hydra-build-products\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"options.json","nativeBuildInputs":"/nix/store/41r5x5klzq7kdkh9l43glqnkpz2r4hmx-brotli-1.2.0-dev /nix/store/jy00n3jp5xj8s40n1fbldmkcr5n7avxc-python3-3.13.15","options":"{\"containerDefaults\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"NixOS configuration that is applied to all [{option}`containers`](#test-opt-containers).\\n\",\"loc\":[\"containerDefaults\"],\"readOnly\":false,\"type\":\"module\"},\"containers\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of NixOS configuration modules representing systemd-nspawn containers that can be started during a test.\\n\\nThe configurations are augmented by the [`defaults`](#test-opt-defaults) option.\\n\\nThey are assigned network addresses according to the `nixos/lib/testing/network.nix` module.\\n\\nA few special options are available, that aren't in a plain NixOS configuration. See [Configuring containers](#ssec-nixos-test-nspawn-containers)\\n\",\"loc\":[\"containers\"],\"readOnly\":false,\"type\":\"lazy attribute set of (submodule)\"},\"defaults\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"NixOS configuration that is applied to all [{option}`nodes`](#test-opt-nodes) and [{option}`containers`](#test-opt-containers).\\n\",\"loc\":[\"defaults\"],\"readOnly\":false,\"type\":\"module\"},\"driver\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"set by the test framework\"},\"description\":\"Package containing a script that runs the test.\",\"loc\":[\"driver\"],\"readOnly\":false,\"type\":\"package\"},\"enableDebugHook\":{\"declarations\":[{\"name\":\"nixos/lib/testing/run.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/run.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Halt test execution after any test fail and provide the possibility to\\nhook into the sandbox to connect with either the test driver via\\n`telnet localhost 4444` or with the VMs via SSH and vsocks (see also\\n`sshBackdoor.enable`).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"enableDebugHook\"],\"readOnly\":false,\"type\":\"boolean\"},\"enableOCR\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Optical Character Recognition functionality for\\ntesting graphical programs. See [`Machine objects`](#ssec-machine-objects).\\n\",\"loc\":[\"enableOCR\"],\"readOnly\":false,\"type\":\"boolean\"},\"extraBaseModules\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"NixOS configuration that, like [{option}`defaults`](#test-opt-defaults), is applied to all [{option}`nodes`](#test-opt-nodes) and [{option}`containers`](#test-opt-containers) and can not be undone with [`specialisation.<name>.inheritParentConfig`](https://search.nixos.org/options?show=specialisation.%3Cname%3E.inheritParentConfig&from=0&size=50&sort=relevance&type=packages&query=specialisation).\\n\",\"loc\":[\"extraBaseModules\"],\"readOnly\":false,\"type\":\"module\"},\"extraBaseNodeModules\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"NixOS configuration that, like [{option}`defaults`](#test-opt-defaults), is applied to all [{option}`nodes`](#test-opt-nodes) and can not be undone with [`specialisation.<name>.inheritParentConfig`](https://search.nixos.org/options?show=specialisation.%3Cname%3E.inheritParentConfig&from=0&size=50&sort=relevance&type=packages&query=specialisation).\\n\",\"loc\":[\"extraBaseNodeModules\"],\"readOnly\":false,\"type\":\"module\"},\"extraDriverArgs\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra arguments to pass to the test driver.\\n\\nThey become part of [{option}`driver`](#test-opt-driver) via `wrapProgram`.\\n\",\"loc\":[\"extraDriverArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"extraPythonPackages\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"<function>\"},\"description\":\"Python packages to add to the test driver.\\n\\nThe argument is a Python package set, similar to `pkgs.pythonPackages`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"p: [ p.numpy ]\\n\"},\"loc\":[\"extraPythonPackages\"],\"readOnly\":false,\"type\":\"function that evaluates to a(n) list of package\"},\"globalTimeout\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"3600\"},\"description\":\"A global timeout for the complete test, expressed in seconds.\\nBeyond that timeout, every resource will be killed and released and the test will fail.\\n\\nBy default, we use a 1 hour timeout.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"600\"},\"loc\":[\"globalTimeout\"],\"readOnly\":false,\"type\":\"signed integer\"},\"hostPkgs\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"description\":\"Nixpkgs attrset used outside the nodes.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"import nixpkgs { inherit system config overlays; }\\n\"},\"loc\":[\"hostPkgs\"],\"readOnly\":false,\"type\":\"raw value\"},\"interactive\":{\"declarations\":[{\"name\":\"nixos/lib/testing/interactive.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/interactive.nix\"}],\"description\":\"Tests [can be run interactively](#sec-running-nixos-tests-interactively)\\nusing the program in the test derivation's `.driverInteractive` attribute.\\n\\nWhen they are, the configuration will include anything set in this submodule.\\n\\nYou can set any top-level test option here.\\n\\nExample test module:\\n\\n```nix\\n{ config, lib, ... }: {\\n\\n  nodes.rabbitmq = {\\n    services.rabbitmq.enable = true;\\n  };\\n\\n  # When running interactively ...\\n  interactive.nodes.rabbitmq = {\\n    # ... enable the web ui.\\n    services.rabbitmq.managementPlugin.enable = true;\\n  };\\n}\\n```\\n\\nFor details, see the section about [running tests interactively](#sec-running-nixos-tests-interactively).\\n\",\"loc\":[\"interactive\"],\"readOnly\":false,\"type\":\"submodule\"},\"logLevel\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"info\\\"\"},\"description\":\"Log level for the test driver.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"warning\\\"\"},\"loc\":[\"logLevel\"],\"readOnly\":false,\"type\":\"one of \\\"debug\\\", \\\"info\\\", \\\"warning\\\", \\\"error\\\"\"},\"meta\":{\"declarations\":[{\"name\":\"nixos/lib/testing/meta.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/meta.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The [`meta`](https://nixos.org/manual/nixpkgs/stable/#chap-meta) attributes that will be set on the returned derivations.\\n\\nNot all [`meta`](https://nixos.org/manual/nixpkgs/stable/#chap-meta) attributes are supported, but more can be added as desired.\\n\",\"loc\":[\"meta\"],\"readOnly\":false,\"type\":\"submodule\"},\"meta.broken\":{\"declarations\":[{\"name\":\"nixos/lib/testing/meta.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/meta.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Sets the [`meta.broken`](https://nixos.org/manual/nixpkgs/stable/#var-meta-broken) attribute on the [{option}`test`](#test-opt-test) derivation.\\n\",\"loc\":[\"meta\",\"broken\"],\"readOnly\":false,\"type\":\"boolean\"},\"meta.hydraPlatforms\":{\"declarations\":[{\"name\":\"nixos/lib/testing/meta.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/meta.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"`lib.platforms.linux` only, as the `hydra.nixos.org` build farm does not currently support virtualisation on Darwin.\"},\"description\":\"Sets the [`meta.hydraPlatforms`](https://nixos.org/manual/nixpkgs/stable/#var-meta-hydraPlatforms) attribute on the [{option}`test`](#test-opt-test) derivation.\\n\",\"loc\":[\"meta\",\"hydraPlatforms\"],\"readOnly\":false,\"type\":\"list of raw value\"},\"meta.maintainers\":{\"declarations\":[{\"name\":\"nixos/lib/testing/meta.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/meta.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The [list of maintainers](https://nixos.org/manual/nixpkgs/stable/#var-meta-maintainers) for this test.\\n\",\"loc\":[\"meta\",\"maintainers\"],\"readOnly\":false,\"type\":\"list of raw value\"},\"meta.platforms\":{\"declarations\":[{\"name\":\"nixos/lib/testing/meta.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/meta.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"`lib.platforms.linux ++ lib.platforms.darwin` when no containers are configured; otherwise `lib.platforms.linux`.\\n\"},\"description\":\"Sets the [`meta.platforms`](https://nixos.org/manual/nixpkgs/stable/#var-meta-platforms) attribute on the [{option}`test`](#test-opt-test) derivation.\\n\",\"loc\":[\"meta\",\"platforms\"],\"readOnly\":false,\"type\":\"list of raw value\"},\"meta.timeout\":{\"declarations\":[{\"name\":\"nixos/lib/testing/meta.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/meta.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"3600\"},\"description\":\"The [{option}`test`](#test-opt-test)'s [`meta.timeout`](https://nixos.org/manual/nixpkgs/stable/#var-meta-timeout) in seconds.\\n\",\"loc\":[\"meta\",\"timeout\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"name\":{\"declarations\":[{\"name\":\"nixos/lib/testing/name.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/name.nix\"}],\"description\":\"The name of the test.\\n\\nThis is used in the derivation names of the [{option}`driver`](#test-opt-driver) and [{option}`test`](#test-opt-test) runner.\\n\",\"loc\":[\"name\"],\"readOnly\":false,\"type\":\"string\"},\"node.pkgs\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"`null`, so construct `pkgs` according to the `nixpkgs.*` options as usual.\\n\"},\"description\":\"The Nixpkgs to use for the nodes and containers.\\n\\nSetting this will make the `nixpkgs.*` options read-only, to avoid mistakenly testing with a Nixpkgs configuration that diverges from regular use.\\n\",\"loc\":[\"node\",\"pkgs\"],\"readOnly\":false,\"type\":\"null or Nixpkgs package set\"},\"node.pkgsReadOnly\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"node.pkgs != null\"},\"description\":\"Whether to make the `nixpkgs.*` options read-only. This is only relevant when [`node.pkgs`](#test-opt-node.pkgs) is set.\\n\\nSet this to `false` when any of the [`nodes`](#test-opt-nodes) or [{option}`containers`](#test-opt-containers) need to configure any of the `nixpkgs.*` options. This will slow down evaluation of your test a bit.\\n\",\"loc\":[\"node\",\"pkgsReadOnly\"],\"readOnly\":false,\"type\":\"boolean\"},\"node.specialArgs\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of arbitrary values that will be made available as module arguments during the resolution of module `imports`.\\n\\nNote that it is not possible to override these from within the NixOS configurations. If you argument is not relevant to `imports`, consider setting {option}`defaults._module.args.<name>` instead.\\n\",\"loc\":[\"node\",\"specialArgs\"],\"readOnly\":false,\"type\":\"lazy attribute set of raw value\"},\"nodeDefaults\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"NixOS configuration that is applied to all [{option}`nodes`](#test-opt-nodes).\\n\",\"loc\":[\"nodeDefaults\"],\"readOnly\":false,\"type\":\"module\"},\"nodes\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of NixOS configuration modules representing QEMU vms that can be started during a test.\\n\\nThe configurations are augmented by the [`defaults`](#test-opt-defaults) option.\\n\\nThey are assigned network addresses according to the `nixos/lib/testing/network.nix` module.\\n\\nA few special options are available, that aren't in a plain NixOS configuration. See [Configuring virtual machines](#ssec-nixos-test-qemu-vms)\\n\",\"loc\":[\"nodes\"],\"readOnly\":false,\"type\":\"lazy attribute set of module\"},\"passthru\":{\"declarations\":[{\"name\":\"nixos/lib/testing/run.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/run.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attributes to add to the returned derivations,\\nwhich are not necessarily part of the build.\\n\\nThis is a bit like doing `drv // { myAttr = true; }` (which would be lost by `overrideAttrs`).\\nIt does not change the actual derivation, but adds the attribute nonetheless, so that\\nconsumers of what would be `drv` have more information.\\n\",\"loc\":[\"passthru\"],\"readOnly\":false,\"type\":\"lazy attribute set of raw value\"},\"pythonTestDriverPackage\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"<derivation nixos-test-driver-1.1>\"},\"description\":\"Package containing the python NixOS test driver implemetnation\",\"loc\":[\"pythonTestDriverPackage\"],\"readOnly\":true,\"type\":\"package\"},\"qemu.forceAccel\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to force the use of hardware-accelerated virtualisation.\\nWhen enabled, QEMU will not fall back to the slower software emulation\\n(TCG) and will instead error out if the accelerator is not available.\\n\",\"loc\":[\"qemu\",\"forceAccel\"],\"readOnly\":false,\"type\":\"boolean\"},\"qemu.package\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"hostPkgs.qemu_test\\\"\"},\"description\":\"Which qemu package to use for the virtualisation of [{option}`nodes`](#test-opt-nodes).\",\"loc\":[\"qemu\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"rawTestDerivationArg\":{\"declarations\":[{\"name\":\"nixos/lib/testing/run.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/run.nix\"}],\"description\":\"Argument passed to `mkDerivation` to create the `rawTestDerivation`.\\n\",\"loc\":[\"rawTestDerivationArg\"],\"readOnly\":false,\"type\":\"function that evaluates to a(n) raw value\"},\"requiredFeatures\":{\"declarations\":[{\"name\":\"nixos/lib/testing/run.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/run.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Builder features that are required for running this test.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  cuda = true;\\n  devnet = mkForce false;\\n}\\n\"},\"loc\":[\"requiredFeatures\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of boolean\"},\"requiredFeatures.apple-virt\":{\"declarations\":[{\"name\":\"nixos/lib/testing/run.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/run.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"`true` if built to run on Darwin.\"},\"description\":\"Whether Apple virtualization functionality is required for running this test.\",\"loc\":[\"requiredFeatures\",\"apple-virt\"],\"readOnly\":false,\"type\":\"boolean\"},\"requiredFeatures.devnet\":{\"declarations\":[{\"name\":\"nixos/lib/testing/run.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/run.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"`true` if both VMs and containers are present.\"},\"description\":\"This heuristic setting that assumes that the majority of tests requires VMs and containers\\nto communicate over network. To support such tests, adding \\\"/dev/net\\\" to `nix.settings.extra-sandbox-paths` is necessary.\\n\\nOverride this to `false` if the heuristic is wrong in some cases.\\n\",\"loc\":[\"requiredFeatures\",\"devnet\"],\"readOnly\":false,\"type\":\"boolean\"},\"requiredFeatures.kvm\":{\"declarations\":[{\"name\":\"nixos/lib/testing/run.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/run.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"`true` if built to run on Linux and any virtual machines are specified.\"},\"description\":\"Whether Linux KVM virtualization is required when running this test. Can be disabled to allow emulated execution.\",\"loc\":[\"requiredFeatures\",\"kvm\"],\"readOnly\":false,\"type\":\"boolean\"},\"requiredFeatures.nixos-test\":{\"declarations\":[{\"name\":\"nixos/lib/testing/run.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/run.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Standard requirement for NixOS integration tests\",\"loc\":[\"requiredFeatures\",\"nixos-test\"],\"readOnly\":false,\"type\":\"boolean\"},\"requiredFeatures.uid-range\":{\"declarations\":[{\"name\":\"nixos/lib/testing/run.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/run.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"`true` if containers are present.\"},\"description\":\"Containers use systemd-nspawn, which requires pid 0 inside of the sandbox. `uid-range` enables that.\",\"loc\":[\"requiredFeatures\",\"uid-range\"],\"readOnly\":false,\"type\":\"boolean\"},\"skipLint\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Do not run the linters. This may speed up your iteration cycle, but it is not something you should commit.\\n\",\"loc\":[\"skipLint\"],\"readOnly\":false,\"type\":\"boolean\"},\"skipTypeCheck\":{\"declarations\":[{\"name\":\"nixos/lib/testing/driver.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/driver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Disable type checking. This must not be enabled for new NixOS tests.\\n\\nThis may speed up your iteration cycle, unless you're working on the [{option}`testScript`](#test-opt-testScript).\\n\",\"loc\":[\"skipTypeCheck\"],\"readOnly\":false,\"type\":\"boolean\"},\"sshBackdoor.enable\":{\"declarations\":[{\"name\":\"nixos/lib/testing/nodes.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/nodes.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.enableDebugHook\"},\"description\":\"Whether to turn on the VSOCK-based access to all VMs. This provides an unauthenticated access intended for debugging.\",\"loc\":[\"sshBackdoor\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"test\":{\"declarations\":[{\"name\":\"nixos/lib/testing/run.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/run.nix\"}],\"description\":\"Derivation that runs the test as its \\\"build\\\" process.\\n\\nThis implies that NixOS tests run isolated from the network, making them\\nmore dependable.\\n\",\"loc\":[\"test\"],\"readOnly\":false,\"type\":\"package\"},\"testScript\":{\"declarations\":[{\"name\":\"nixos/lib/testing/testScript.nix\",\"url\":\"https://github.com/NixOS/nixpkgs/blob/master/nixos/lib/testing/testScript.nix\"}],\"description\":\"A series of python declarations and statements that you write to perform\\nthe test.\\n\",\"loc\":[\"testScript\"],\"readOnly\":false,\"type\":\"string or function that evaluates to a(n) string\"}}","out":"/nix/store/0y21ifi0dxmgli7861ins1529lgd79q0-options.json","outputs":"out","passAsFile":"buildCommand options","patches":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"1r89rryy56vgd91c83r7rw961h7xw8ih-brotli-1.2.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"v6d1zsp3i33dj483qv4ryzrkfhf1gyp8-python3-3.13.15.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["iyc092w3nzbfjhpgs9pgpgg8vjjyzpxk-base.json","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","yar7i652zwjkqsyrrqxaxlk1zl3zlfx8-mergeJSON.py"]},"name":"options.json","outputs":{"out":{"path":"0y21ifi0dxmgli7861ins1529lgd79q0-options.json"}},"system":"x86_64-linux","version":4},"gm8zk7p1kcd875kh2ln2s2zvhjsvlnnl-perl5.42.3-TermReadKey-2.38.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/119w10l5ic8izi6igxqpq0wdmccs9mbc-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"AUTOMATED_TESTING":"1","PERL_AUTOINSTALL":"--skipdeps","PERL_USE_UNSAFE_INC":"1","__structuredAttrs":"","buildInputs":"/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","checkTarget":"test","cmakeF