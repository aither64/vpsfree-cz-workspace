ession\",\"text\":\"null\"},\"description\":\"Glyph for the palette. Append a trailing space to separate glyphs.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"palette\",\"glyph\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.macchina.themes.<name>.palette.spacing\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The amount of spacing to leave between each glyph.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"palette\",\"spacing\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"programs.macchina.themes.<name>.palette.type\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Color set to use for the palette. Case-sensitive.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"palette\",\"type\"],\"readOnly\":false,\"type\":\"null or one of \\\"Dark\\\", \\\"Light\\\", \\\"Full\\\"\"},\"programs.macchina.themes.<name>.palette.visible\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to show the palette.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"palette\",\"visible\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.themes.<name>.prefer_small_ascii\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{