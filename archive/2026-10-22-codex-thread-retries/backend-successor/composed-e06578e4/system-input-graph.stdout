ssion\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/grype/config.yaml`.\\nSee <https://oss.anchore.com/docs/reference/grype/configuration/> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  check-for-app-update = false;\\n}\"},\"loc\":[\"programs\",\"grype\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.gurk-rs.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gurk-rs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gurk-rs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable gurk-rs.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gurk-rs\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gurk-rs.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gurk-rs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gurk-rs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gurk-rs\"},\"description\":\"The gurk-rs package to use.\",\"loc\":[\"programs\",\"gurk-rs\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.gurk-rs.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gurk-rs.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gurk-rs.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/gurk/gurk.toml`\\nor {file}`Library/Application Support/gurk/gurk.toml`. Options are\\ndeclared at <https://github.com/boxdot/gurk-rs/blob/main/src/config.rs>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  bell = true;\\n  colored_messages = false;\\n  data_dir = \\\"/home/USERNAME/.local/share/gurk/signal-db\\\";\\n  default_keybindings = true;\\n  first_name_only = false;\\n  keybindings = { };\\n  notifications = true;\\n  show_receipts = true;\\n  user = {\\n    name = \\\"MYNAME\\\";\\n    phone_number = \\\"MYNUMBER\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"gurk-rs\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.halloy.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/halloy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/halloy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable halloy.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"halloy\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.halloy.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/halloy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/halloy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.halloy\"},\"description\":\"The halloy package to use.\",\"loc\":[\"programs\",\"halloy\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.halloy.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/halloy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/halloy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for halloy. All available options can be\\nfound here: <https://halloy.chat/configuration.html>. Note that\\nhalloy requires at least one `server` to be configured, see example.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"buffer.channel.topic\\\" = {\\n    enabled = true;\\n  };\\n  \\\"servers.liberachat\\\" = {\\n    channels = [\\n      \\\"#halloy\\\"\\n    ];\\n    nickname = \\\"halloy-user\\\";\\n    server = \\\"irc.libera.chat\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"halloy\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.halloy.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/halloy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/halloy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Each theme is written to {file}`$XDG_CONFIG_HOME/halloy/themes/NAME.toml`.\\nSee <https://halloy.chat/configuration/themes/index.html> for more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  my-theme = {\\n    general = {\\n      background = \\\"<string>\\\";\\n      border = \\\"<string>\\\";\\n      horizontal_rule = \\\"<string>\\\";\\n      unread_indicator = \\\"<string>\\\";\\n    };\\n    text = {\\n      primary = \\\"<string>\\\";\\n      secondary = \\\"<string>\\\";\\n      tertiary = \\\"<string>\\\";\\n      success = \\\"<string>\\\";\\n      error = \\\"<string>\\\";\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"halloy\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (TOML value or strings concatenated with \\\"\\\\n\\\" or absolute path)\"},\"programs.havoc.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/havoc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/havoc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Havoc terminal.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"havoc\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.havoc.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/havoc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/havoc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.havoc\"},\"description\":\"The havoc package to use.\",\"loc\":[\"programs\",\"havoc\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.havoc.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/havoc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/havoc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/havoc.cfg`. See <https://raw.githubusercontent.com/ii8/havoc/master/havoc.cfg>\\nfor a list of available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  child.program = \\\"bash\\\";\\n  window.opacity = 240;\\n  window.margin = no;\\n  terminal = {\\n    rows = 80;\\n    columns = 24;\\n    scrollback = 2000;\\n  };\\n  bind = {\\n    \\\"C-S-c\\\" = \\\"copy\\\";\\n    \\\"C-S-v\\\" = \\\"paste\\\";\\n    \\\"C-S-r\\\" = \\\"reset\\\";\\n    \\\"C-S-Delete\\\" = \\\"hard reset\\\";\\n    \\\"C-S-j\\\" = \\\"scroll down\\\";\\n    \\\"C-S-k\\\" = \\\"scroll up\\\";\\n    \\\"C-S-Page_Down\\\" = \\\"scroll down page\\\";\\n    \\\"C-S-Page_Up\\\" = \\\"scroll up page\\\";\\n    \\\"C-S-End\\\" = \\\"scroll to bottom\\\";\\n    \\\"C-S-Home\\\" = \\\"scroll to top\\\";\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"havoc\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.helix.defaultEditor\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/helix.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/helix.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to configure {command}`hx` as the default\\neditor using the {env}`EDITOR` and {env}`VISUAL`\\nenvironment variables.\\n\",\"loc\":[\"programs\",\"helix\",\"defaultEditor\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.helix.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/helix.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/helix.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable helix text editor.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"helix\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.helix.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/helix.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/helix.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra lines to be appended to the config file.\\nUse this if you would like to maintain order for helix settings (eg. for minor modes)\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[keys.normal.g] # Reverse Alphabetical Order\\nG = \\\"goto_file_end\\\"\\ng = \\\"goto_file_start\\\"\\n\"},\"loc\":[\"programs\",\"helix\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.helix.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/helix.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/helix.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra packages available to hx.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.marksman ]\"},\"loc\":[\"programs\",\"helix\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.helix.ignores\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/helix.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/helix.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of paths that should be globally ignored for file picker.\\nSupports the usual ignore and negative ignore (unignore) rules used in `.gitignore` files.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\".build/\\\"\\n  \\\"!.gitignore\\\"\\n]\"},\"loc\":[\"programs\",\"helix\",\"ignores\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.helix.languages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/helix.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/helix.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Language specific configuration at\\n{file}`$XDG_CONFIG_HOME/helix/languages.toml`.\\n\\nSee <https://docs.helix-editor.com/languages.html>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  language-server.typescript-language-server = with pkgs.nodePackages; {\\n    command = \\\"${typescript-language-server}/bin/typescript-language-server\\\";\\n    args = [ \\\"--stdio\\\" \\\"--tsserver-path=${typescript}/lib/node_modules/typescript/lib\\\" ];\\n  };\\n\\n  language = [{\\n    name = \\\"rust\\\";\\n    auto-format = false;\\n  }];\\n}\\n\"},\"loc\":[\"programs\",\"helix\",\"languages\"],\"readOnly\":false,\"type\":\"(TOML value) or (list of (TOML value)) convertible to it\"},\"programs.helix.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/helix.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/helix.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.helix\"},\"description\":\"The helix package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.evil-helix\"},\"loc\":[\"programs\",\"helix\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.helix.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/helix.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/helix.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/helix/config.toml`.\\n\\nSee <https://docs.helix-editor.com/configuration.html>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  editor = {\\n    line-number = \\\"relative\\\";\\n    lsp = {\\n      display-messages = true;\\n    };\\n  };\\n  keys = {\\n    normal = {\\n      esc = [\\n        \\\"collapse_selection\\\"\\n        \\\"keep_primary_selection\\\"\\n      ];\\n      space = {\\n        q = \\\":q\\\";\\n        space = \\\"file_picker\\\";\\n        w = \\\":w\\\";\\n      };\\n    };\\n  };\\n  theme = \\\"base16\\\";\\n}\"},\"loc\":[\"programs\",\"helix\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.helix.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/helix.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/helix.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Each theme is written to\\n{file}`$XDG_CONFIG_HOME/helix/themes/theme-name.toml`.\\nWhere the name of each attribute is the theme-name (in the example \\\"base16\\\").\\n\\nSee <https://docs.helix-editor.com/themes.html>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  base16 = let\\n    transparent = \\\"none\\\";\\n    gray = \\\"#665c54\\\";\\n    dark-gray = \\\"#3c3836\\\";\\n    white = \\\"#fbf1c7\\\";\\n    black = \\\"#282828\\\";\\n    red = \\\"#fb4934\\\";\\n    green = \\\"#b8bb26\\\";\\n    yellow = \\\"#fabd2f\\\";\\n    orange = \\\"#fe8019\\\";\\n    blue = \\\"#83a598\\\";\\n    magenta = \\\"#d3869b\\\";\\n    cyan = \\\"#8ec07c\\\";\\n  in {\\n    \\\"ui.menu\\\" = transparent;\\n    \\\"ui.menu.selected\\\" = { modifiers = [ \\\"reversed\\\" ]; };\\n    \\\"ui.linenr\\\" = { fg = gray; bg = dark-gray; };\\n    \\\"ui.popup\\\" = { modifiers = [ \\\"reversed\\\" ]; };\\n    \\\"ui.linenr.selected\\\" = { fg = white; bg = black; modifiers = [ \\\"bold\\\" ]; };\\n    \\\"ui.selection\\\" = { fg = black; bg = blue; };\\n    \\\"ui.selection.primary\\\" = { modifiers = [ \\\"reversed\\\" ]; };\\n    \\\"comment\\\" = { fg = gray; };\\n    \\\"ui.statusline\\\" = { fg = white; bg = dark-gray; };\\n    \\\"ui.statusline.inactive\\\" = { fg = dark-gray; bg = white; };\\n    \\\"ui.help\\\" = { fg = dark-gray; bg = white; };\\n    \\\"ui.cursor\\\" = { modifiers = [ \\\"reversed\\\" ]; };\\n    \\\"variable\\\" = red;\\n    \\\"variable.builtin\\\" = orange;\\n    \\\"constant.numeric\\\" = orange;\\n    \\\"constant\\\" = orange;\\n    \\\"attributes\\\" = yellow;\\n    \\\"type\\\" = yellow;\\n    \\\"ui.cursor.match\\\" = { fg = yellow; modifiers = [ \\\"underlined\\\" ]; };\\n    \\\"string\\\" = green;\\n    \\\"variable.other.member\\\" = red;\\n    \\\"constant.character.escape\\\" = cyan;\\n    \\\"function\\\" = blue;\\n    \\\"constructor\\\" = blue;\\n    \\\"special\\\" = blue;\\n    \\\"keyword\\\" = magenta;\\n    \\\"label\\\" = magenta;\\n    \\\"namespace\\\" = blue;\\n    \\\"diff.plus\\\" = green;\\n    \\\"diff.delta\\\" = yellow;\\n    \\\"diff.minus\\\" = red;\\n    \\\"diagnostic\\\" = { modifiers = [ \\\"underlined\\\" ]; };\\n    \\\"ui.gutter\\\" = { bg = black; };\\n    \\\"info\\\" = blue;\\n    \\\"hint\\\" = dark-gray;\\n    \\\"debug\\\" = dark-gray;\\n    \\\"warning\\\" = yellow;\\n    \\\"error\\\" = red;\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"helix\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (TOML value or absolute path or strings concatenated with \\\"\\\\n\\\")\"},\"programs.hexchat.channels\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configures {file}`$XDG_CONFIG_HOME/hexchat/servlist.conf`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  oftc = {\\n    autojoin = [\\n      \\\"#home-manager\\\"\\n      \\\"#linux\\\"\\n    ];\\n    charset = \\\"UTF-8 (Unicode)\\\";\\n    commands = [\\n      \\\"ECHO Buzz Lightyear sent you a message: 'To Infinity... and Beyond!'\\\"\\n    ];\\n    loginMethod = sasl;\\n    nickname = \\\"my_nickname\\\";\\n    nickname2 = \\\"my_secondchoice\\\";\\n    options = {\\n      acceptInvalidSSLCertificates = false;\\n      autoconnect = true;\\n      bypassProxy = true;\\n      connectToSelectedServerOnly = true;\\n      useGlobalUserInformation = false;\\n      forceSSL = false;\\n    };\\n    password = \\\"my_password\\\";\\n    realName = \\\"my_realname\\\";\\n    servers = [\\n      \\\"irc.oftc.net\\\"\\n    ];\\n    userName = \\\"my_username\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"hexchat\",\"channels\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.hexchat.channels.<name>.autojoin\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Channels list to autojoin on connecting to server.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"#home-manager\\\"\\n  \\\"#linux\\\"\\n  \\\"#nix\\\"\\n]\"},\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"autojoin\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.hexchat.channels.<name>.charset\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Character set.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"UTF-8 (Unicode)\\\"\"},\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"charset\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.hexchat.channels.<name>.commands\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Commands to be executed on connecting to server.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ \\\"ECHO Greetings fellow Nixer! ]\"},\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"commands\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.hexchat.channels.<name>.loginMethod\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The login method. The allowed options are:\\n\\n`null`\\n:  Default\\n\\n`\\\"nickServMsg\\\"`\\n:  NickServ (`/MSG NickServ` + password)\\n\\n`\\\"nickServ\\\"`\\n:  NickServ (`/NICKSERV` + password)\\n\\n`\\\"challengeAuth\\\"`\\n:  Challenge Auth (username + password)\\n\\n`\\\"sasl\\\"`\\n:  SASL (username + password)\\n\\n`\\\"serverPassword\\\"`\\n:  Server password (`/PASS` password)\\n\\n`\\\"saslExternal\\\"`\\n:  SASL EXTERNAL (cert)\\n\\n`\\\"customCommands\\\"`\\n: Use \\\"commands\\\" field for auth. For example\\n  ```nix\\n  commands = [ \\\"/msg NickServ IDENTIFY my_password\\\" ]\\n  ```\\n\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"loginMethod\"],\"readOnly\":false,\"type\":\"null or one of \\\"challengeAuth\\\", \\\"customCommands\\\", \\\"nickServ\\\", \\\"nickServMsg\\\", \\\"sasl\\\", \\\"saslExternal\\\", \\\"serverPassword\\\"\"},\"programs.hexchat.channels.<name>.nickname\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Primary nickname.\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"nickname\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.hexchat.channels.<name>.nickname2\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Secondary nickname.\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"nickname2\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.hexchat.channels.<name>.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Channel options.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  autoconnect = true;\\n  useGlobalUserInformation = true;\\n}\"},\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"options\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"programs.hexchat.channels.<name>.options.acceptInvalidSSLCertificates\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Accept invalid SSL certificates.\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"options\",\"acceptInvalidSSLCertificates\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.hexchat.channels.<name>.options.autoconnect\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Autoconnect to network.\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"options\",\"autoconnect\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.hexchat.channels.<name>.options.bypassProxy\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Bypass proxy.\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"options\",\"bypassProxy\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.hexchat.channels.<name>.options.connectToSelectedServerOnly\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Connect to selected server only.\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"options\",\"connectToSelectedServerOnly\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.hexchat.channels.<name>.options.forceSSL\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Use SSL for all servers.\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"options\",\"forceSSL\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.hexchat.channels.<name>.options.useGlobalUserInformation\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Use global user information.\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"options\",\"useGlobalUserInformation\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.hexchat.channels.<name>.password\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Password to use. Note this password will be readable by all user's\\nin the Nix store.\\n\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"password\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.hexchat.channels.<name>.realName\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Real name. Is used to populate the real name field that appears when\\nsomeone uses the `WHOIS` command on your nick.\\n\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"realName\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.hexchat.channels.<name>.servers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"IRC Server Address List.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"irc.oftc.net\\\"\\n]\"},\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"servers\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.hexchat.channels.<name>.userName\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"User name. Part of your `user@host` hostmask that\\nappears to other on IRC.\\n\",\"loc\":[\"programs\",\"hexchat\",\"channels\",\"<name>\",\"userName\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.hexchat.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable HexChat, a graphical IRC client.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"hexchat\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hexchat.overwriteConfigFiles\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Enables overwriting HexChat configuration files\\n({file}`hexchat.conf`, {file}`servlist.conf`).\\nAny existing HexChat configuration will be lost. Make sure to back up\\nany previous configuration before enabling this.\\n\\nEnabling this setting is recommended, because everytime HexChat\\napplication is closed it overwrites Nix/Home Manager provided\\nconfiguration files, causing:\\n\\n1. Nix/Home Manager provided configuration to be out of sync with\\n   actual active HexChat configuration.\\n2. Nix/Home Manager updates to be blocked until configuration files are\\n   manually removed.\\n\",\"loc\":[\"programs\",\"hexchat\",\"overwriteConfigFiles\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.hexchat.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.hexchat\"},\"description\":\"The hexchat package to use.\",\"loc\":[\"programs\",\"hexchat\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.hexchat.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Configuration for {file}`$XDG_CONFIG_HOME/hexchat/hexchat.conf`, see\\n<https://hexchat.readthedocs.io/en/latest/settings.html#list-of-settings>\\nfor supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  irc_nick1 = \\\"mynick\\\";\\n  irc_username = \\\"bob\\\";\\n  irc_realname = \\\"Bart Simpson\\\";\\n  text_font = \\\"Monospace 14\\\";\\n};\\n\"},\"loc\":[\"programs\",\"hexchat\",\"settings\"],\"readOnly\":false,\"type\":\"null or (attribute set of string)\"},\"programs.hexchat.theme\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hexchat.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hexchat.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Theme package for HexChat. Expects a derivation containing decompressed\\ntheme files. Note, `.hct` files are actually ZIP files,\\nas seen in example.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"source = pkgs.fetchzip {\\n  url = \\\"https://dl.hexchat.net/themes/Monokai.hct#Monokai.zip\\\";\\n  sha256 = \\\"sha256-WCdgEr8PwKSZvBMs0fN7E2gOjNM0c2DscZGSKSmdID0=\\\";\\n  stripRoot = false;\\n};\\n\"},\"loc\":[\"programs\",\"hexchat\",\"theme\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.himalaya.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/himalaya.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/himalaya.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the email client Himalaya CLI.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"himalaya\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.himalaya.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/himalaya.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/himalaya.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.himalaya\"},\"description\":\"The himalaya package to use.\",\"loc\":[\"programs\",\"himalaya\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.himalaya.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/himalaya.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/himalaya.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Himalaya CLI global configuration.\\nSee <https://github.com/pimalaya/himalaya/blob/master/config.sample.toml> for supported values.\\n\",\"loc\":[\"programs\",\"himalaya\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"programs.home-manager.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/home-manager.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/home-manager.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Home Manager.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"home-manager\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.home-manager.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/home-manager.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/home-manager.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.callPackage ../../home-manager { inherit (config.programs.home-manager) path; };\\n\"},\"description\":\"The {command}`home-manager` package.\",\"loc\":[\"programs\",\"home-manager\",\"package\"],\"readOnly\":true,\"type\":\"package\"},\"programs.home-manager.path\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/home-manager.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/home-manager.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default path to use for Home Manager. When\\n`null`, then the {file}`home-manager`\\nchannel, {file}`$HOME/.config/nixpkgs/home-manager`, and\\n{file}`$HOME/.nixpkgs/home-manager` will be attempted.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$HOME/devel/home-manager\\\"\"},\"loc\":[\"programs\",\"home-manager\",\"path\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.hstr.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hstr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hstr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Bash And Zsh shell history suggest box - easily view, navigate, search and\\nmanage your command history.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"hstr\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hstr.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hstr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hstr.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"hstr\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hstr.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hstr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hstr.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"hstr\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hstr.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hstr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hstr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.hstr\"},\"description\":\"The hstr package to use.\",\"loc\":[\"programs\",\"hstr\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.htop.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/htop.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/htop.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable htop.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"htop\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.htop.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/htop.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/htop.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.htop\"},\"description\":\"The htop package to use.\",\"loc\":[\"programs\",\"htop\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.htop.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/htop.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/htop.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration options to add to\\n{file}`$XDG_CONFIG_HOME/htop/htoprc`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  color_scheme = 6;\\n  cpu_count_from_one = 0;\\n  delay = 15;\\n  fields = with config.lib.htop.fields; [\\n    PID\\n    USER\\n    PRIORITY\\n    NICE\\n    M_SIZE\\n    M_RESIDENT\\n    M_SHARE\\n    STATE\\n    PERCENT_CPU\\n    PERCENT_MEM\\n    TIME\\n    COMM\\n  ];\\n  highlight_base_name = 1;\\n  highlight_megabytes = 1;\\n  highlight_threads = 1;\\n} // (with config.lib.htop; leftMeters [\\n  (bar \\\"AllCPUs2\\\")\\n  (bar \\\"Memory\\\")\\n  (bar \\\"Swap\\\")\\n  (text \\\"Zram\\\")\\n]) // (with config.lib.htop; rightMeters [\\n  (text \\\"Tasks\\\")\\n  (text \\\"LoadAverage\\\")\\n  (text \\\"Uptime\\\")\\n  (text \\\"Systemd\\\")\\n]);\\n\"},\"loc\":[\"programs\",\"htop\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or string or list of (signed integer or string))\"},\"programs.hwatch.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hwatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hwatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable hwatch, a modern alternative to the {command}`watch` command\\n.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"hwatch\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hwatch.extraArgs\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hwatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hwatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra command-line arguments to pass to {command}`hwatch`.\\nThese will be used to populate the {env}`HWATCH` environment variable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--exec\\\"\\n  \\\"--precise\\\"\\n]\"},\"loc\":[\"programs\",\"hwatch\",\"extraArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.hwatch.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hwatch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hwatch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.hwatch\"},\"description\":\"The hwatch package to use.\",\"loc\":[\"programs\",\"hwatch\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.hyfetch.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyfetch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyfetch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable hyfetch.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"hyfetch\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hyfetch.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyfetch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyfetch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.hyfetch\"},\"description\":\"The hyfetch package to use.\",\"loc\":[\"programs\",\"hyfetch\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.hyfetch.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyfetch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyfetch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"JSON config for HyFetch\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  color_align = {\\n    mode = \\\"horizontal\\\";\\n  };\\n  mode = \\\"rgb\\\";\\n  preset = \\\"rainbow\\\";\\n}\"},\"loc\":[\"programs\",\"hyfetch\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.hyprlock.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Hyprlock, Hyprland's GPU-accelerated lock screen\\nutility.\\n\\nNote that PAM must be configured to enable hyprlock to perform\\nauthentication. The package installed through home-manager will *not* be\\nable to unlock the session without this configuration.\\n\\nOn NixOS, it can be enabled using:\\n\\n```nix\\nsecurity.pam.services.hyprlock = {};\\n```\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"hyprlock\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hyprlock.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines to add to `~/.config/hypr/hyprlock.conf`.\\n\",\"loc\":[\"programs\",\"hyprlock\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.hyprlock.importantPrefixes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"$\\\"\\n  \\\"bezier\\\"\\n  \\\"monitor\\\"\\n  \\\"size\\\"\\n]\"},\"description\":\"List of prefix of attributes to source at the top of the config.\\n\",\"loc\":[\"programs\",\"hyprlock\",\"importantPrefixes\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.hyprlock.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.hyprlock\"},\"description\":\"The hyprlock package to use.\",\"loc\":[\"programs\",\"hyprlock\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.hyprlock.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Hyprlock configuration written in Nix. Entries with the same key should\\nbe written as lists. Variables' and colors' names should be quoted. See\\n<https://wiki.hypr.land/Hypr-Ecosystem/hyprlock/> for more examples.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  general = {\\n    hide_cursor = true;\\n    ignore_empty_input = true;\\n  };\\n\\n  animations = {\\n    enabled = true;\\n    fade_in = {\\n      duration = 300;\\n      bezier = \\\"easeOutQuint\\\";\\n    };\\n    fade_out = {\\n      duration = 300;\\n      bezier = \\\"easeOutQuint\\\";\\n    };\\n  };\\n\\n  background = [\\n    {\\n      path = \\\"screenshot\\\";\\n      blur_passes = 3;\\n      blur_size = 8;\\n    }\\n  ];\\n\\n  input-field = [\\n    {\\n      size = \\\"200, 50\\\";\\n      position = \\\"0, -80\\\";\\n      monitor = \\\"\\\";\\n      dots_center = true;\\n      fade_on_empty = false;\\n      font_color = \\\"rgb(202, 211, 245)\\\";\\n      inner_color = \\\"rgb(91, 96, 120)\\\";\\n      outer_color = \\\"rgb(24, 25, 38)\\\";\\n      outline_thickness = 5;\\n      placeholder_text = '\\\\'<span foreground=\\\"##cad3f5\\\">Password...</span>'\\\\';\\n      shadow_passes = 2;\\n    }\\n  ];\\n}\\n\"},\"loc\":[\"programs\",\"hyprlock\",\"settings\"],\"readOnly\":false,\"type\":\"Hyprlock configuration value\"},\"programs.hyprlock.sourceFirst\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprlock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprlock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable putting source entries at the top of the configuration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"hyprlock\",\"sourceFirst\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hyprpanel.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprpanel>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprpanel\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable HyprPanel.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"hyprpanel\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hyprpanel.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprpanel>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprpanel\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.hyprpanel\"},\"description\":\"The hyprpanel package to use.\",\"loc\":[\"programs\",\"hyprpanel\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.hyprpanel.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprpanel>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprpanel\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/hyprpanel/config.json`.\\n\\nSee <https://hyprpanel.com/configuration/settings.html#home-manager-module>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"bar.battery.label = true;\\nbar.bluetooth.label = false;\\nbar.clock.format = \\\"%H:%M:%S\\\";\\nbar.layouts = {\\n  \\\"*\\\" = {\\n    left = [\\n      \\\"dashboard\\\"\\n      \\\"workspaces\\\"\\n      \\\"media\\\"\\n    ];\\n    middle = [ \\\"windowtitle\\\" ];\\n    right = [\\n      \\\"volume\\\"\\n      \\\"network\\\"\\n      \\\"bluetooth\\\"\\n      \\\"notifications\\\"\\n    ];\\n  };\\n};\\n\"},\"loc\":[\"programs\",\"hyprpanel\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.hyprpanel.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprpanel>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprpanel\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable HyprPanel systemd integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"hyprpanel\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hyprshot.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprshot.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprshot.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Hyprshot the Hyprland screenshot utility.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"hyprshot\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.hyprshot.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprshot.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprshot.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.hyprshot\"},\"description\":\"The hyprshot package to use.\",\"loc\":[\"programs\",\"hyprshot\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.hyprshot.saveLocation\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/hyprshot.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/hyprshot.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the `$HYPRSHOT_DIR` environment variable to the given location.\\n\\nHypershot will save screenshots to the first expression that resolves:\\n - `$HYPRSHOT_DIR`\\n - `$XDG_PICTURES_DIR`\\n - `$(xdg-user-dir PICTURES)`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$HOME/Pictures/Screenshots\\\"\"},\"loc\":[\"programs\",\"hyprshot\",\"saveLocation\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.i3bar-river.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3bar-river.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3bar-river.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable i3bar-river.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"i3bar-river\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.i3bar-river.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3bar-river.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3bar-river.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.i3bar-river\"},\"description\":\"The i3bar-river package to use.\",\"loc\":[\"programs\",\"i3bar-river\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.i3bar-river.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3bar-river.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3bar-river.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for i3bar-river. All available options can be\\nfound here: <https://github.com/MaxVerevkin/i3bar-river?tab=readme-ov-file#configuration>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  background = \\\"#282828ff\\\";\\n  color = \\\"#ffffffff\\\";\\n  font = \\\"monospace 10\\\";\\n  height = 24;\\n  margin_bottom = 0;\\n  margin_left = 0;\\n  margin_top = 0;\\n  separator = \\\"#9a8a62ff\\\";\\n  \\\"wm.river\\\" = {\\n    max_tag = 0;\\n  };\\n}\"},\"loc\":[\"programs\",\"i3bar-river\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.i3blocks.bars\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3blocks.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3blocks.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to i3blocks config\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  top = {\\n    # The title block\\n    title = {\\n      interval = \\\"persist\\\";\\n      command = \\\"xtitle -s\\\";\\n    };\\n  };\\n  bottom = {\\n    time = {\\n      command = \\\"date +%r\\\";\\n      interval = 1;\\n    };\\n    # Make sure this block comes after the time block\\n    date = lib.hm.dag.entryAfter [ \\\"time\\\" ] {\\n      command = \\\"date +%d\\\";\\n      interval = 5;\\n    };\\n    # And this block after the example block\\n    example = lib.hm.dag.entryAfter [ \\\"date\\\" ] {\\n      command = \\\"echo hi $(date +%s)\\\";\\n      interval = 3;\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"i3blocks\",\"bars\"],\"readOnly\":false,\"type\":\"attribute set of (DAG of attribute set of (INI atom (null, int, bool, string, or float)))\"},\"programs.i3blocks.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3blocks.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3blocks.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable i3blocks i3 status command scheduler.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"i3blocks\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.i3blocks.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3blocks.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3blocks.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.i3blocks\"},\"description\":\"The i3blocks package to use.\",\"loc\":[\"programs\",\"i3blocks\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.i3status-rust.bars\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status-rust.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status-rust.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  default = {\\n    blocks = [\\n      {\\n        alert = 10.0;\\n        block = \\\"disk_space\\\";\\n        info_type = \\\"available\\\";\\n        interval = 60;\\n        path = \\\"/\\\";\\n        warning = 20.0;\\n      }\\n      {\\n        block = \\\"memory\\\";\\n        format = \\\" $icon mem_used_percents \\\";\\n        format_alt = \\\" $icon $swap_used_percents \\\";\\n      }\\n      {\\n        block = \\\"cpu\\\";\\n        interval = 1;\\n      }\\n      {\\n        block = \\\"load\\\";\\n        format = \\\" $icon $1m \\\";\\n        interval = 1;\\n      }\\n      {\\n        block = \\\"sound\\\";\\n      }\\n      {\\n        block = \\\"time\\\";\\n        format = \\\" $timestamp.datetime(f:'%a %d/%m %R') \\\";\\n        interval = 60;\\n      }\\n    ];\\n  };\\n}\"},\"description\":\"Attribute set of i3status-rust bars, each with their own configuration.\\nEach bar {var}`name` generates a config file suffixed with\\nthe bar's {var}`name` from the attribute set, like so:\\n{file}`config-${name}.toml`.\\n\\nThis way, multiple config files can be generated, such as for having a\\ntop and a bottom bar.\\n\\nSee\\n{manpage}`i3status-rust(1)`\\nfor options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"bottom = {\\n  blocks = [\\n    {\\n       block = \\\"disk_space\\\";\\n       path = \\\"/\\\";\\n       info_type = \\\"available\\\";\\n       interval = 60;\\n       warning = 20.0;\\n       alert = 10.0;\\n     }\\n     {\\n       block = \\\"memory\\\";\\n       format_mem = \\\" $icon $mem_used_percents \\\";\\n       format_swap = \\\" $icon $swap_used_percents \\\";\\n     }\\n     {\\n       block = \\\"cpu\\\";\\n       interval = 1;\\n     }\\n     {\\n       block = \\\"load\\\";\\n       interval = 1;\\n       format = \\\" $icon $1m \\\";\\n     }\\n     { block = \\\"sound\\\"; }\\n     {\\n       block = \\\"time\\\";\\n       interval = 60;\\n       format = \\\" $timestamp.datetime(f:'%a %d/%m %R') \\\";\\n     }\\n  ];\\n  settings = {\\n    theme =  {\\n      theme = \\\"solarized-dark\\\";\\n      overrides = {\\n        idle_bg = \\\"#123456\\\";\\n        idle_fg = \\\"#abcdef\\\";\\n      };\\n    };\\n  };\\n  icons = \\\"awesome5\\\";\\n  theme = \\\"gruvbox-dark\\\";\\n};\\n\"},\"loc\":[\"programs\",\"i3status-rust\",\"bars\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.i3status-rust.bars.<name>.blocks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status-rust.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status-rust.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    block = \\\"cpu\\\";\\n  }\\n  {\\n    alert = 10.0;\\n    block = \\\"disk_space\\\";\\n    format = \\\" $icon root: $available.eng(w:2) \\\";\\n    info_type = \\\"available\\\";\\n    interval = 20;\\n    path = \\\"/\\\";\\n    warning = 20.0;\\n  }\\n  {\\n    block = \\\"memory\\\";\\n    format = \\\" $icon $mem_total_used_percents.eng(w:2) \\\";\\n    format_alt = \\\" $icon_swap $swap_used_percents.eng(w:2) \\\";\\n  }\\n  {\\n    block = \\\"sound\\\";\\n    click = [\\n      {\\n        button = \\\"left\\\";\\n        cmd = \\\"pavucontrol\\\";\\n      }\\n    ];\\n  }\\n  {\\n    block = \\\"time\\\";\\n    format = \\\" $timestamp.datetime(f:'%a %d/%m %R') \\\";\\n    interval = 5;\\n  }\\n]\"},\"description\":\"Configuration blocks to add to i3status-rust\\n{file}`config`. See\\n<https://github.com/greshake/i3status-rust/blob/master/blocks.md>\\nfor block options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    block = \\\"disk_space\\\";\\n    path = \\\"/\\\";\\n    info_type = \\\"available\\\";\\n    interval = 60;\\n    warning = 20.0;\\n    alert = 10.0;\\n  }\\n  {\\n    block = \\\"sound\\\";\\n    format = \\\" $icon $output_name {$volume.eng(w:2) |}\\\";\\n    click = [\\n      {\\n        button = \\\"left\\\";\\n        cmd = \\\"pavucontrol --tab=3\\\";\\n      }\\n    ];\\n    mappings = {\\n      \\\"alsa_output.pci-0000_00_1f.3.analog-stereo\\\" = \\\"\\\";\\n      \\\"bluez_sink.70_26_05_DA_27_A4.a2dp_sink\\\" = \\\"\\\";\\n    };\\n  }\\n];\\n\"},\"loc\":[\"programs\",\"i3status-rust\",\"bars\",\"<name>\",\"blocks\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.i3status-rust.bars.<name>.icons\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status-rust.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status-rust.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"none\\\"\"},\"description\":\"The icons set to use. See\\n<https://github.com/greshake/i3status-rust/blob/master/doc/themes.md>\\nfor a list of available icon sets.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"awesome6\\\"\"},\"loc\":[\"programs\",\"i3status-rust\",\"bars\",\"<name>\",\"icons\"],\"readOnly\":false,\"type\":\"string\"},\"programs.i3status-rust.bars.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status-rust.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status-rust.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Any extra options to add to i3status-rust\\n{file}`config`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  theme =  {\\n    theme = \\\"solarized-dark\\\";\\n    overrides = {\\n      idle_bg = \\\"#123456\\\";\\n      idle_fg = \\\"#abcdef\\\";\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"i3status-rust\",\"bars\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.i3status-rust.bars.<name>.theme\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status-rust.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status-rust.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"plain\\\"\"},\"description\":\"The theme to use. See\\n<https://github.com/greshake/i3status-rust/blob/master/doc/themes.md>\\nfor a list of available themes.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"gruvbox-dark\\\"\"},\"loc\":[\"programs\",\"i3status-rust\",\"bars\",\"<name>\",\"theme\"],\"readOnly\":false,\"type\":\"string\"},\"programs.i3status-rust.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status-rust.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status-rust.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable a replacement for i3-status written in Rust.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"i3status-rust\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.i3status-rust.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status-rust.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status-rust.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.i3status-rust\"},\"description\":\"The i3status-rust package to use.\",\"loc\":[\"programs\",\"i3status-rust\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.i3status.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable i3status.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"i3status\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.i3status.enableDefault\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether or not to enable\\nthe default configuration.\\n\",\"loc\":[\"programs\",\"i3status\",\"enableDefault\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.i3status.general\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration to add to i3status {file}`config`\\n`general` section.\\nSee\\n{manpage}`i3status(1)`\\nfor options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  colors = true;\\n  color_good = \\\"#e0e0e0\\\";\\n  color_degraded = \\\"#d7ae00\\\";\\n  color_bad = \\\"#f69d6a\\\";\\n  interval = 1;\\n}\\n\"},\"loc\":[\"programs\",\"i3status\",\"general\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or string)\"},\"programs.i3status.modules\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Modules to add to i3status {file}`config` file.\\nSee\\n{manpage}`i3status(1)`\\nfor options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"disk /\\\" = {\\n    position = 2;\\n    settings = {\\n      format = \\\"/ %avail\\\";\\n    };\\n  };\\n  \\\"volume master\\\" = {\\n    position = 1;\\n    settings = {\\n      device = \\\"pulse:1\\\";\\n      format = \\\"♪ %volume\\\";\\n      format_muted = \\\"♪ muted (%volume)\\\";\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"i3status\",\"modules\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.i3status.modules.<name>.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/i3status.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/i3status.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether or not to enable this module.\\n\",\"loc\":[\"programs\",\"i3status\",\"modules\",\"<name>\",\"enable\"],\"readO