literalExpression\",\"text\":\"false\"},\"description\":\"Whether to listen for and reject all HTTPS connections to this vhost. Useful in\\n[default](#opt-services.nginx.virtualHosts._name_.default)\\nserver blocks to avoid serving the certificate for another vhost. Uses the\\n`ssl_reject_handshake` directive available in nginx versions\\n1.19.4 and above.\\n\",\"loc\":[\"services\",\"strichliste\",\"nginx\",\"virtualHost\",\"rejectSSL\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.strichliste.nginx.virtualHost.reuseport\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Create an individual listening socket .\\nIt is required to specify only once on one of the hosts.\\n\",\"loc\":[\"services\",\"strichliste\",\"nginx\",\"virtualHost\",\"reuseport\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.strichliste.nginx.virtualHost.root\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The path of the web root directory.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/data/webserver/docs\\\"\"},\"loc\":[\"services\",\"strichliste\",\"nginx\",\"virtualHost\",\"root\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"services.strichliste.nginx.virtualHost.serverAliases\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Additional names of virtual hosts served by this virtual host configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"www.example.org\\\"\\n  \\\"example.org\\\"\\n]\"},\"loc\":[\"services\",\"strichliste\",\"nginx\",\"virtualHost\",\"serverAliases\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.strichliste.nginx.virtualHost.serverName\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Name of this virtual host. Defaults to attribute name in virtualHosts.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"example.org\\\"\"},\"loc\":[\"services\",\"strichliste\",\"nginx\",\"virtualHost\",\"serverName\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.strichliste.nginx.virtualHost.sslCertificate\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"description\":\"Path to server SSL certificate.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/var/host.cert\\\"\"},\"loc\":[\"services\",\"strichliste\",\"nginx\",\"virtualHost\",\"sslCertificate\"],\"readOnly\":false,\"type\":\"absolute path\"},\"services.strichliste.nginx.virtualHost.sslCertificateKey\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"description\":\"Path to server SSL certificate key.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/var/host.key\\\"\"},\"loc\":[\"services\",\"strichliste\",\"nginx\",\"virtualHost\",\"sslCertificateKey\"],\"readOnly\":false,\"type\":\"absolute path\"},\"services.strichliste.nginx.virtualHost.sslTrustedCertificate\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to root SSL certificate for stapling and client certificates.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt\\\"\"},\"loc\":[\"services\",\"strichliste\",\"nginx\",\"virtualHost\",\"sslTrustedCertificate\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"services.strichliste.nginx.virtualHost.useACMEHost\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A host of an existing Let's Encrypt certificate to use.\\nThis is useful if you have many subdomains and want to avoid hitting the\\n[rate limit](https://letsencrypt.org/docs/rate-limits).\\nAlternately, you can generate a certificate through {option}`enableACME`.\\n*Note that this option does not create any certificates, nor it does add subdomains to existing ones – you will need to create them manually using [](#opt-security.acme.certs).*\\n\",\"loc\":[\"services\",\"strichliste\",\"nginx\",\"virtualHost\",\"useACMEHost\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.strichliste.packages.backend\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.strichliste\"},\"description\":\"The strichliste package to use.\",\"loc\":[\"services\",\"strichliste\",\"packages\",\"backend\"],\"readOnly\":false,\"type\":\"package\"},\"services.strichliste.packages.frontend\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"<derivation strichliste-frontend-2.0.0>\"},\"description\":\"The strichliste-frontend package to use.\\n\",\"loc\":[\"services\",\"strichliste\",\"packages\",\"frontend\"],\"readOnly\":false,\"type\":\"package\"},\"services.strichliste.settings\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"description\":\"The {file}`strichliste.yaml` configuration as a Nix attribute set.\\n\\nSee the [configuration reference](https://github.com/strichliste/strichliste-backend/blob/v2.0.1/docs/Config.md)\\nfor possible options.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (YAML 1.1 value)\"},\"services.strichliste.settings.account.lower\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"-200000\"},\"description\":\"The credit limit for user accounts.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"loc\":[\"services\",\"strichliste\",\"settings\",\"account\",\"lower\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.strichliste.settings.account.upper\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"200000\"},\"description\":\"The maximum balance on a user account.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"account\",\"upper\"],\"readOnly\":false,\"type\":\"positive integer, meaning >0\"},\"services.strichliste.settings.common.idleTimeout\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"30000\"},\"description\":\"Time until the app returns to the start page.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"common\",\"idleTimeout\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.strichliste.settings.i18n.currency.alpha3\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"description\":\"[ISO 4217] alpha code representing the currency.\\n\\n[ISO 4217]: https://en.wikipedia.org/wiki/ISO_4217#List_of_ISO_4217_currency_codes\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"EUR\\\"\"},\"loc\":[\"services\",\"strichliste\",\"settings\",\"i18n\",\"currency\",\"alpha3\"],\"readOnly\":false,\"type\":\"string\"},\"services.strichliste.settings.i18n.currency.name\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"description\":\"Name of the currency.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Euro\\\"\"},\"loc\":[\"services\",\"strichliste\",\"settings\",\"i18n\",\"currency\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"services.strichliste.settings.i18n.currency.symbol\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"description\":\"Symbol for the currency.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"€\\\"\"},\"loc\":[\"services\",\"strichliste\",\"settings\",\"i18n\",\"currency\",\"symbol\"],\"readOnly\":false,\"type\":\"string\"},\"services.strichliste.settings.i18n.language\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"en\\\"\"},\"description\":\"Language used throughout the app.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"de\\\"\"},\"loc\":[\"services\",\"strichliste\",\"settings\",\"i18n\",\"language\"],\"readOnly\":false,\"type\":\"string\"},\"services.strichliste.settings.i18n.timezone\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.time.timeZone\"},\"description\":\"Timezone used throughout the app, e.g. in the transaction log.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Europe/Berlin\\\"\"},\"loc\":[\"services\",\"strichliste\",\"settings\",\"i18n\",\"timezone\"],\"readOnly\":false,\"type\":\"string\"},\"services.strichliste.settings.payment.boundary.lower\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"-2000\"},\"description\":\"The lowest amount that can be used for payments.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"boundary\",\"lower\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.strichliste.settings.payment.boundary.upper\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"15000\"},\"description\":\"The highest amount that can be used for payment.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"boundary\",\"upper\"],\"readOnly\":false,\"type\":\"positive integer, meaning >0\"},\"services.strichliste.settings.payment.deposit.custom\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to allow custom amounts for deposits.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"deposit\",\"custom\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.strichliste.settings.payment.deposit.enabled\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to allow money deposits.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"deposit\",\"enabled\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.strichliste.settings.payment.deposit.steps\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of selectable deposit amounts.\\n\\nThis should match your most common coins and banknotes.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  0.5\\n  1\\n  2\\n  5\\n  10\\n  20\\n]\"},\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"deposit\",\"steps\"],\"readOnly\":false,\"type\":\"list of (signed integer or floating point number)\"},\"services.strichliste.settings.payment.dispense.custom\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to allow custom spending amounts.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"dispense\",\"custom\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.strichliste.settings.payment.dispense.enabled\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to allow spending money.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"dispense\",\"enabled\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.strichliste.settings.payment.dispense.steps\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of selectable spending amounts.\\n\\nThis should match your most common products.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  0.5\\n  1\\n  2\\n  5\\n  10\\n  20\\n]\"},\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"dispense\",\"steps\"],\"readOnly\":false,\"type\":\"list of (signed integer or floating point number)\"},\"services.strichliste.settings.payment.transaction.enabled\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to allow transactions between user accounts.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"transaction\",\"enabled\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.strichliste.settings.payment.undo.delete\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to allow deleting within the {option}`services.strichliste.settings.payment.undo.timeout` period.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"undo\",\"delete\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.strichliste.settings.payment.undo.enabled\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to allow undoing transactions withing the {option}`services.strichliste.settings.payment.undo.timeout` period.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"undo\",\"enabled\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.strichliste.settings.payment.undo.timeout\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"5 minute\\\"\"},\"description\":\"The time period after creating a transaction in which undoing/deleting remains possible.\\n\\nThe format used is documented in <https://www.php.net/manual/en/dateinterval.createfromdatestring.php>.\\n\",\"loc\":[\"services\",\"strichliste\",\"settings\",\"payment\",\"undo\",\"timeout\"],\"readOnly\":false,\"type\":\"string\"},\"services.strichliste.settings.user.stalePeriod\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"10 day\\\"\"},\"description\":\"Duration after which users are listed as inactive.\\n\\nThe format used is documented in <https://www.php.net/manual/en/dateinterval.createfromdatestring.php>.\\n\\n::: {.tip}\\nThis helps unclutter the user listing by prioritizing active users.\\n:::\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"1 week\\\"\"},\"loc\":[\"services\",\"strichliste\",\"settings\",\"user\",\"stalePeriod\"],\"readOnly\":false,\"type\":\"string\"},\"services.vaultwarden.backupDir\":{\"declarations\":[\"nixos/modules/services/security/vaultwarden/default.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The directory under which vaultwarden will backup its persistent data.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/var/backup/vaultwarden\\\"\"},\"loc\":[\"services\",\"vaultwarden\",\"backupDir\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.vaultwarden.config\":{\"declarations\":[\"nixos/modules/services/security/vaultwarden/default.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  ROCKET_ADDRESS = \\\"::1\\\";\\n  ROCKET_PORT = 8222;\\n}\"},\"description\":\"The configuration of vaultwarden is done through environment variables,\\ntherefore it is recommended to use upper snake case (e.g. {env}`DISABLE_2FA_REMEMBER`).\\n\\nHowever, camel case (e.g. `disable2FARemember`) is also supported:\\nThe NixOS module will convert it automatically to\\nupper case snake case (e.g. {env}`DISABLE_2FA_REMEMBER`).\\nIn this conversion digits (0-9) are handled just like upper case characters,\\nso `foo2` would be converted to {env}`FOO_2`.\\nNames already in this format remain unchanged, so `FOO2` remains `FOO2` if passed as such,\\neven though `foo2` would have been converted to {env}`FOO_2`.\\nThis allows working around any potential future conflicting naming conventions.\\n\\nBased on the attributes passed to this config option an environment file will be generated\\nthat is passed to vaultwarden's systemd service.\\n\\nThe available configuration options can be found in\\n[the environment template file](https://github.com/dani-garcia/vaultwarden/blob/1.37.4/.env.template).\\n\\nSee [](#opt-services.vaultwarden.environmentFile) for how\\nto set up access to the Admin UI to invite initial users.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  DOMAIN = \\\"https://bitwarden.example.com\\\";\\n  SIGNUPS_ALLOWED = false;\\n\\n  # Vaultwarden recommends running behind a reverse proxy, the configureNginx option can be used for that.\\n  ROCKET_ADDRESS = \\\"127.0.0.1\\\";\\n  ROCKET_PORT = 8222;\\n\\n  ROCKET_LOG = \\\"critical\\\";\\n\\n  # This example assumes a mailserver running on localhost,\\n  # thus without transport encryption.\\n  # If you use an external mail server, follow:\\n  #   https://github.com/dani-garcia/vaultwarden/wiki/SMTP-configuration\\n  SMTP_HOST = \\\"127.0.0.1\\\";\\n  SMTP_PORT = 25;\\n  SMTP_SSL = false;\\n\\n  SMTP_FROM = \\\"admin@bitwarden.example.com\\\";\\n  SMTP_FROM_NAME = \\\"example.com Bitwarden server\\\";\\n}\\n\"},\"loc\":[\"services\",\"vaultwarden\",\"config\"],\"readOnly\":false,\"type\":\"attribute set of (null or boolean or signed integer or string)\"},\"services.vaultwarden.configureNginx\":{\"declarations\":[\"nixos/modules/services/security/vaultwarden/default.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to configure nginx to serve VaultWarden.\",\"loc\":[\"services\",\"vaultwarden\",\"configureNginx\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.vaultwarden.configurePostgres\":{\"declarations\":[\"nixos/modules/services/security/vaultwarden/default.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to configure a local PostgreSQL server.\",\"loc\":[\"services\",\"vaultwarden\",\"configurePostgres\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.vaultwarden.dbBackend\":{\"declarations\":[\"nixos/modules/services/security/vaultwarden/default.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"sqlite\\\"\"},\"description\":\"Which database backend vaultwarden will be using.\\n\",\"loc\":[\"services\",\"vaultwarden\",\"dbBackend\"],\"readOnly\":false,\"type\":\"one of \\\"sqlite\\\", \\\"mysql\\\", \\\"postgresql\\\"\"},\"services.vaultwarden.domain\":{\"declarations\":[\"nixos/modules/services/security/vaultwarden/default.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The domain under which VaultWarden will be reachable.\",\"loc\":[\"services\",\"vaultwarden\",\"domain\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.vaultwarden.enable\":{\"declarations\":[\"nixos/modules/services/security/vaultwarden/default.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable vaultwarden.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"vaultwarden\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.vaultwarden.environmentFile\":{\"declarations\":[\"nixos/modules/services/security/vaultwarden/default.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Additional environment file or files as defined in {manpage}`systemd.exec(5)`.\\n\\nSecrets like {env}`ADMIN_TOKEN` and {env}`SMTP_PASSWORD`\\nshould be passed to the service without adding them to the world-readable Nix store.\\n\\nNote that this file needs to be available on the host on which `vaultwarden` is running.\\n\\nAs a concrete example, to make the Admin UI available (from which new users can be invited initially),\\nthe secret {env}`ADMIN_TOKEN` needs to be defined as described\\n[here](https://github.com/dani-garcia/vaultwarden/wiki/Enabling-admin-page):\\n\\n```\\n# Admin secret token, see\\n# https://github.com/dani-garcia/vaultwarden/wiki/Enabling-admin-page\\nADMIN_TOKEN=...copy-paste a unique generated secret token here...\\n```\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/var/lib/vaultwarden.env\\\"\"},\"loc\":[\"services\",\"vaultwarden\",\"environmentFile\"],\"readOnly\":false,\"type\":\"(list of absolute path) or absolute path convertible to it\"},\"services.vaultwarden.package\":{\"declarations\":[\"nixos/modules/services/security/vaultwarden/default.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vaultwarden\"},\"description\":\"The vaultwarden package to use.\",\"loc\":[\"services\",\"vaultwarden\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.vaultwarden.webVaultPackage\":{\"declarations\":[\"nixos/modules/services/security/vaultwarden/default.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vaultwarden.webvault\"},\"description\":\"The webvault package to use.\",\"loc\":[\"services\",\"vaultwarden\",\"webVaultPackage\"],\"readOnly\":false,\"type\":\"package\"},\"services.wyoming.satellite.area\":{\"declarations\":[\"nixos/modules/services/home-automation/wyoming/satellite.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Area to the satellite.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Kitchen\\\"\"},\"loc\":[\"services\",\"wyoming\",\"satellite\",\"area\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.wyoming.satellite.enable\":{\"declarations\":[\"nixos/modules/services/home-automation/wyoming/satellite.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Wyoming Satellite.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"wyoming\",\"satellite\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.wyoming.satellite.extraArgs\":{\"declarations\":[\"nixos/modules/services/home-automation/wyoming/satellite.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra arguments to pass to the executable.\\n\\nCheck `wyoming-satellite --help` for possible options.\\n\",\"loc\":[\"services\",\"wyoming\",\"satellite\",\"extraArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.wyoming.satellite.group\":{\"declarations\":[\"nixos/modules/services/home-automation/wyoming/satellite.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"users\\\"\"},\"description\":\"Group to run wyoming-satellite under.\\n\",\"loc\":[\"services\",\"wyoming\",\"satellite\",\"group\"],\"readOnly\":false,\"type\":\"string\"},\"services.wyoming.satellite.microphone.autoGain\":{\"declarations\":[\"nixos/modules/services/home-automation/wyoming/satellite.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"5\"},\"description\":\"Automatic gain control in dbFS, with 31 being the loudest value. Set to 0 to disable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"15\"},\"loc\":[\"services\",\"wyoming\",\"satellite\",\"microphone\",\"autoGain\"],\"readOnly\":false,\"type\":\"integer between 0 and 31 (both inclusive)\"},\"services.wyoming.satellite.microphone.command\":{\"declarations\":[\"nixos/modules/services/home-automation/wyoming/satellite.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"arecord -r 16000 -c 1 -f S16_LE -t raw\\\"\"},\"description\":\"Program to run for audio input.\\n\",\"loc\":[\"services\",\"wyoming\",\"satellite\",\"microphone\",\"command\"],\"readOnly\":false,\"type\":\"string\"},\"services.wyoming.satellite.microphone.noiseSuppression\":{\"declarations\":[\"nixos/modules/services/home-automation/wyoming/satellite.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"2\"},\"description\":\"Noise suppression level with 4 being the maximum suppression,\\nwhich may cause audio distortion. Set to 0 to disable.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"3\"},\"loc\":[\"services\",\"wyoming\",\"satellite\",\"microphone\",\"noiseSuppression\"],\"readOnly\":false,\"type\":\"integer between 0 and 4 (both inclusive)\"},\"services.wyoming.satellite.name\":{\"declarations\":[\"nixos/modules/services/home-automation/wyoming/satellite.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.networking.hostName\\n\"},\"description\":\"Name of the satellite.\\n\",\"loc\":[\"services\",\"wyoming\",\"satellite\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"services.wyoming.satellite.package\":{\"declarations\":[\"nixos/modules/services/home-automation/wyoming/satellite.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wyoming-satellite\"},\"description\":\"The wyoming-satellite package to use.\",\"loc\":[\"services\",\"wyoming\",\"satellite\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.wyoming.satellite.sound.command\":{\"declarations\":[\"nixos/modules/services/home-automation/wyoming/satellite.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"aplay -r 22050 -c 1 -f S16_LE -t raw\\\"\"},\"description\":\"Program to run for sound output.\\n\",\"loc\":[\"services\",\"wyoming\",\"satellite\",\"sound\",\"command\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.wyoming.satellite.sounds.awake\":{\"declarations\":[\"nixos/mod