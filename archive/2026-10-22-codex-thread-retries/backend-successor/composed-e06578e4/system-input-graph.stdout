er.sway.config.modifier;\\nin lib.mkOptionDefault {\\n  \\\"${modifier}+Return\\\" = \\\"exec ${cfg.config.terminal}\\\";\\n  \\\"${modifier}+Shift+q\\\" = \\\"kill\\\";\\n  \\\"${modifier}+d\\\" = \\\"exec ${cfg.config.menu}\\\";\\n}\\n\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"keybindings\"],\"readOnly\":false,\"type\":\"attribute set of (null or string)\"},\"wayland.windowManager.sway.config.keycodebindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set that assigns keypress to an action using key code.\\nSee <https://i3wm.org/docs/userguide.html#keybindings>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"214\\\" = \\\"exec /bin/script.sh\\\";\\n}\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"keycodebindings\"],\"readOnly\":false,\"type\":\"attribute set of (null or string)\"},\"wayland.windowManager.sway.config.left\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"h\\\"\"},\"description\":\"Home row direction key for moving left.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"config\",\"left\"],\"readOnly\":false,\"type\":\"string\"},\"wayland.windowManager.sway.config.menu\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${pkgs.dmenu}/bin/dmenu_path |