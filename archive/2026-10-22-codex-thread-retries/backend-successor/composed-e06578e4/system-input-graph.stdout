4.2.1"}},"structuredAttrs":{"NIX_MAIN_PROGRAM":"nc","buildInputs":[],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":["-DENABLE_NC=ON","-DCMAKE_C_FLAGS=-DHAVE_GNU_STACK","-DTLS_DEFAULT_CA_FILE=/nix/store/6x3vic5vm4jzp29yna1qkp0xmf3qm35i-nss-cacert-3.126/etc/ssl/certs/ca-bundle.crt","-DBUILD_SHARED_LIBS=ON"],"configureFlags":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":true,"doInstallCheck":false,"env":{"NIX_MAIN_PROGRAM":"nc"},"mesonFlags":[],"name":"libressl-4.2.1","nativeBuildInputs":["/nix/store/v4m910fin3csvzhv8pq6aivvi6ghmzmp-cmake-4.1.6"],"outputChecks":{"bin":{},"dev":{},"man":{},"nc":{},"out":{}},"outputs":["bin","dev","out","man","nc"],"patches":["/nix/store/dni8w9vjbcgnlf847rqk70rym6w6fqnz-a15ea0710398eaeed3be53cf643e80a1e80c981d.patch"],"pname":"libressl","postCheck":"export LD_LIBRARY_PATH=$PREVIOUS_LD_LIBRARY_PATH\n","postFixup":"moveToOutput \"bin/nc\" \"$nc\"\nmoveToOutput \"bin/openssl\" \"$bin\"\nmoveToOutput \"bin/ocspcheck\" \"$bin\"\nmoveToOutput \"share/man/man1/nc.1.gz\" \"$nc\"\n","postPatch":"patchShebangs tests/\n","preCheck":"export PREVIOUS_LD_LIBRARY_PATH=$${ldLibPathEnvName}\nexport LD_LIBRARY_PATH=\"$${ldLibPathEnvName}:$(realpath tls/):$(realpath ssl/):$(realpath crypto/)\"\n# Bail if any shared object has executable stack enabled. This can\n# happen when an object produced from an assmbly file in libcrypto is\n# missing a .note.GNU-stack section. An executable stack is dangerous\n# and unintentional, but without this check the derivation will build\n# and even run if W^X is not enforced; it would fail dangerously.\nobjdump -p **/*.so | awk '\n  BEGIN { res = 0 }\n  /file format/ { file = $1 }\n  /STACK/ { stack = 1; next }\n  stack {\n    if ($0 ~ /flags.*x/) { print file \" has executable stack\"; res = 1 }\n    stack = 0\n  }\n  END { exit res }\n'\n","preConfigure":"rm configure\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"src":"/nix/store/85ca030305kjwx9nmycwvf6pdbdly4km-libressl-4.2.1.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"4.2.1"},"system":"x86_64-linux","version":4},"z22680n4kjd7y7sazj2f4g0rh9i2plip-wit-bindgen-0.46.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildCommand":"mkdir $out\ntar xf \"/nix/store/npmcb72z0sq90kv2mnd70qpd3rc53vl6-crate-wit-bindgen-0.46.0.tar.gz\" -C $out --strip-components=1\n\n# Cargo is happy with largely empty metadata.\nprintf '{\"files\":{},\"package\":\"f17a85883d4e6d00e8a97c586de764dabcc06133f7f1d55dce5cdc070ad7fe59\"}' > \"$out/.cargo-checksum.json\"\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"wit-bindgen-0.46.0","nativeBuildInputs":"","out":"/nix/store/lf9xx7k9il5pm8ph6cjm5x72ns0rw8bb-wit-bindgen-0.46.0","outputs":"out","passAsFile":"buildCommand","patches":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"o