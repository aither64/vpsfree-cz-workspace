VE_GETCWD -DHAVE_GETTIMEOFDAY -DHAVE_INTTYPES_H -DHAVE_ISATTY -DHAVE_LIMITS_H -DHAVE_LOCALE_H -DHAVE_MEMORY_H -DHAVE_MKTEMP -DHAVE_SA_RESTART -DHAVE_SETVBUF -DHAVE_SIGACTION -DHAVE_SIGSETMASK -DHAVE_STDINT_H -DHAVE_STDLIB_H -DHAVE_STRDUP -DHAVE_STRERROR -DHAVE_STRINGS_H -DHAVE_STRING_H -DHAVE_STRTOLL -DHAVE_SYS_FILE_H -DHAVE_SYS_PARAM_H -DHAVE_SYS_RESOURCE_H -DHAVE_SYS_SELECT_H -DHAVE_SYS_STAT_H -DHAVE_SYS_TIMEB_H -DHAVE_SYS_TIME_H -DHAVE_SYS_WAIT_H -DHAVE_TTYNAME -DHAVE_UMASK -DHAVE_UNISTD_H -DHAVE_WAITPID -DMAKE_JOBSERVER -DMAKE_SYMLINKS -DPATH_SEPARATOR_CHAR=':' -DSCCS_GET=\\\"get\\\" -DSTDC_HEADERS -Dsig_atomic_t=int -Dvfork=fork\"\nCC -c src/ar.c\nCC -c src/arscan.c\nCC -c src/commands.c\nCC -c src/default.c\nCC -c src/dir.c\nCC -c src/expand.c\nCC -c src/file.c\nCC -c src/function.c\nCC -c src/getopt.c\nCC -c src/getopt1.c\nCC -c src/guile.c\nCC -c src/hash.c\nCC -c src/implicit.c\nCC -c src/job.c\nCC -c src/load.c\nCC -c src/loadapi.c\nCC -c src/main.c\nCC -c src/misc.c\nCC -c src/output.c\nCC -c src/read.c\nCC -c src/remake.c\nCC -c src/rule.c\nCC -c src/shuffle.c\nCC -c src/signame.c\nCC -c src/strcache.c\nCC -c src/variable.c\nCC -c src/version.c\nCC -c src/vpath.c\nCC -c lib/fnmatch.c\nCC -c lib/glob.c\nCC -c src/remote-stub.c\nCC -c src/posixos.c\n\n# Link\nCC -o make ar.o arscan.o commands.o default.o dir.o expand.o file.o function.o getopt.o getopt1.o guile.o hash.o implicit.o job.o load.o loadapi.o main.o misc.o output.o read.o remake.o rule.o shuffle.o signame.o strcache.o variable.o version.o vpath.o fnmatch.o glob.o remote-stub.o posixos.o\n\n# Check\n./make --version\n\n# Install\nmkdir -p ${out}/bin\ncp ./make ${out}/bin\nchmod 555 ${out}/bin/make\n"},"inputs":{"drvs":{"midrq54p6py7mx6bcnfdf0j0dbashz81-tinycc-bootstrappable-libs-unstable-2024-07-07.drv":{"dynamicOutputs":{},"outputs":["out"]},"whkczx14wnzmkchfys92zgas16rnzqw9-make-4.4.1.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.d