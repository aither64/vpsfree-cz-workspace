"easeIn\",\"curve\"],\"readOnly\":false,\"type\":\"integer between 0 and 40 (both inclusive)\"},\"services.twmn.window.animation.easeIn.duration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1000\"},\"description\":\"The animation duration in milliseconds.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"618\"},\"loc\":[\"services\",\"twmn\",\"window\",\"animation\",\"easeIn\",\"duration\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"services.twmn.window.animation.easeOut\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options for the notification disappearance's animation.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  curve = 19;\\n  duration = 618;\\n}\"},\"loc\":[\"services\",\"twmn\",\"window\",\"animation\",\"easeOut\"],\"readOnly\":false,\"type\":\"submodule\"},\"services.twmn.window.animation.easeOut.curve\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"38\"},\"description\":\"The qt easing-curve animation to use for the animation. See\\n[\\nQEasingCurve documentation](https://doc.qt.io/qt-5/qeasingcurve.html#Type-enum).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"19\"},\"loc\":[\"services\",\"twmn\",\"window\",\"animation\",\"easeOut\",\"curve\"],\"readOnly\":false,\"type\":\"integer between 0 and 40 (both inclusive)\"},\"services.twmn.window.animation.easeOut.duration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1000\"},\"description\":\"The animation duration in milliseconds.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"618\"},\"loc\":[\"services\",\"twmn\",\"window\",\"animation\",\"easeOut\",\"duration\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"services.twmn.window.color\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"#000000\\\"\"},\"description\":\"Notification's background color. RGB hex and keywords (e.g.\\n`lightgray`) are supported.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"lightgray\\\"\"},\"loc\":[\"services\",\"twmn\",\"window\",\"color\"],\"readOnly\":false,\"type\":\"string\"},\"services.twmn.window.height\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"18\"},\"description\":\"Height of the slide bar. Useful to match your tiling window\\nmanager's bar.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"42\"},\"loc\":[\"services\",\"twmn\",\"window\",\"height\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"services.twmn.window.offset.x\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"description\":\"Offset of the notification's slide starting point in pixels on the\\nhorizontal axis (positive is rightward).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"50\"},\"loc\":[\"services\",\"twmn\",\"window\",\"offset\",\"x\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.twmn.window.offset.y\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"description\":\"Offset of the notification's slide starting point in pixels on the\\nvertical axis (positive is upward).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"-100\"},\"loc\":[\"services\",\"twmn\",\"window\",\"offset\",\"y\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.twmn.window.opacity\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"100\"},\"description\":\"The notification window's opacity.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"80\"},\"loc\":[\"services\",\"twmn\",\"window\",\"opacity\"],\"readOnly\":false,\"type\":\"integer between 0 and 100 (both inclusive)\"},\"services.twmn.window.position\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/twmn.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/twmn.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"top_right\\\"\"},\"description\":\"Position of the notification slide. The notification will slide\\nin vertically from the border if placed in\\n`top_center` or `bottom_center`,\\nhorizontally otherwise.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"bottom_left\\\"\"},\"loc\":[\"services\",\"twmn\",\"window\",\"position\"],\"readOnly\":false,\"type\":\"one of \\\"tr\\\", \\\"top_right\\\", \\\"tl\\\", \\\"top_left\\\", \\\"br\\\", \\\"bott