E -DBUILD_STATIC_LIBS:BOOL=FALSE -DBUILD_SHARED_LIBS:BOOL=TRUE -DCMAKE_Fortran_COMPILER:STRING=gfortran -DBUILD_TESTING:BOOL=FALSE -DBINARY:STRING=64 -DNO_AVX512:BOOL=TRUE","configureFlags":"","depsBuildBuild":"/nix/store/2w8k5grzg6rc23xl435r1683qyjj4bpy-gfortran-wrapper-15.3.0 /nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/7h4fvc3y61747i8xqypzb9m37zddj7ss-openblas-0.3.33-dev","doCheck":"1","doInstallCheck":"","hardeningDisable":"stackprotector pic strictoverflow relro bindnow","mesonFlags":"","name":"openblas-0.3.33","nativeBuildInputs":"/nix/store/v4m910fin3csvzhv8pq6aivvi6ghmzmp-cmake-4.1.6","out":"/nix/store/nlg0vijaii4b4h8y5z407fsadf8z36ds-openblas-0.3.33","outputs":"out dev","patches":"/nix/store/9x9mhc53cq5n2war1sw7cw68jyc65a0x-cmake-include-fixes.patch /nix/store/9gp1dcbsgimk40ca7wcw0y8bkcbdyvv1-e3ce4623c299068bbd47c35ee87aab334bac73b1.patch /nix/store/h33h0wkqqd4cqhs9hczh3gsy8vra9pbs-3f6e928d34aca977bd5d4191e6d2c2338a342.patch","pname":"openblas","postInstall":"    # Provide headers in /include directly for compat with some consumers like flint\n    (cd $dev/include && ln -sf openblas/*.h .)\n\n    # Write pkgconfig aliases. Upstream report:\n    # https://github.com/OpenMathLib/OpenBLAS/issues/1740\n    for alias in blas cblas lapack; do\n      cat <<EOF > $out/lib/pkgconfig/$alias.pc\nName: $alias\nVersion: 0.3.33\nDescription: $alias provided by the OpenBLAS package.\nCflags: -I$dev/include\nLibs: -L$out/lib -lopenblas\nEOF\n    done\n\n    # Setup symlinks for blas / lapack\nln -s $out/lib/libopenblas.so $out/lib/libblas.so\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so\nln -s $out/lib/libopenblas.so $out/lib/liblapacke.so\nln -s $out/lib/libopenblas.so $out/lib/libblas.so.3\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so.3\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so.3\nln -s $out/lib/libopenblas.so $out/lib/liblapacke.so.3\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"/nix/store/piik0dwh5gcqnd0yp2dhhd6bvc6x0gcl-check-phase-thread-limit-hook","src":"/nix/store/8s966i8ks25b81iq8agnsmj8bz2zacp3-source","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.3.33"},"inputs":{"drvs":{"97z87yalxicbcxh0jvl2g51zp45n0f1n-check-phase-thread-limit-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"9vfxya30w8ksk99a31gkydqlbmjhw2j3-gfortran-wrapper-15.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"mcpyhlrnzspkilnndql5xxghmp3a4hf0-cmake-4.1.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"nw2kfawkd77gf4hxawm0vjv3155h356w-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"s7yipkz6gn5vw9m54mwf8p8xr2qgcygf-3f6e928d34aca977bd5d4191e6d2c2338a342.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"wrw5hzygkcz75kzgjxr553n7j0djm7yx-e3ce4623c299068bbd47c35ee87aab334bac73b1.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"xv2y3sfvlgay9nrai47mcnag847pyk6l-gcc-wrapper-15.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["9x9mhc53cq5n2war1sw7cw68jyc65a0x-cmake-include-fixes.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"openblas-0.3.33","outputs":{"dev":{"path":"7h4fvc3y61747i8xqypzb9m37zddj7ss-openblas-0.3.33-dev"},"out":{"path":"nlg0vijaii4b4h8y5z407fsadf8z36ds-openblas-0.3.33"}},"system":"x86_64-linux","version":4},"i4qajrdpfqyipkkcqs70m8sdsgq7gv81-crossbeam-utils-0.8.21.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-buil