\\"M-enter\\\";\\n  }\\n  {\\n    command = \\\"None\\\";\\n    key_sequence = \\\"q\\\";\\n  }\\n]\"},\"loc\":[\"programs\",\"spotify-player\",\"keymaps\"],\"readOnly\":false,\"type\":\"list of (TOML value)\"},\"programs.spotify-player.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/spotify-player.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/spotify-player.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.spotify-player\"},\"description\":\"The spotify-player package to use.\",\"loc\":[\"programs\",\"spotify-player\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.spotify-player.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/spotify-player.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/spotify-player.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/spotify-player/app.toml`.\\n\\nSee\\n<https://github.com/aome510/spotify-player/blob/master/docs/config.md#general>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  copy_command = {\\n    args = [ ];\\n    command = \\\"wl-copy\\\";\\n  };\\n  device = {\\n    audio_cache = false;\\n    normalization = false;\\n  };\\n  playback_window_position = \\\"Top\\\";\\n  theme = \\\"default\\\";\\n}\"},\"loc\":[\"programs\",\"spotify-player\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.spotify-player.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/spotify-player.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/spotify-player.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Configuration written to the `themes` field of\\n{file}`$XDG_CONFIG_HOME/spotify-player/theme.toml`.\\n\\nSee\\n<https://github.com/aome510/spotify-player/blob/master/docs/config.md#themes>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    component_style = {\\n      block_title = {\\n        fg = \\\"Magenta\\\";\\n      };\\n      border = { };\\n      current_playing = {\\n        fg = \\\"Green\\\";\\n        modifiers = [\\n          \\\"Bold\\\"\\n        ];\\n      };\\n      page_desc = {\\n        fg = \\\"Cyan\\\";\\n        modifiers = [\\n          \\\"Bold\\\"\\n        ];\\n      };\\n      playback_album = {\\n        fg = \\\"Yellow\\\";\\n      };\\n      playback_artists = {\\n        fg = \\\"Cyan\\\";\\n        modifiers = [\\n          \\\"Bold\\\"\\n        ];\\n      };\\n      playback_metadata = {\\n        fg = \\\"BrightBlack\\\";\\n      };\\n      playback_progress_bar = {\\n        bg = \\\"BrightBlack\\\";\\n        fg = \\\"Green\\\";\\n      };\\n      playback_track = {\\n        fg = \\\"Cyan\\\";\\n        modifiers = [\\n          \\\"Bold\\\"\\n        ];\\n      };\\n      selection = {\\n        modifiers = [\\n          \\\"Bold\\\"\\n          \\\"Reversed\\\"\\n        ];\\n      };\\n      table_header = {\\n        fg = \\\"Blue\\\";\\n      };\\n    };\\n    name = \\\"default2\\\";\\n    palette = {\\n      black = \\\"black\\\";\\n      blue = \\\"blue\\\";\\n      bright_black = \\\"bright_black\\\";\\n      bright_blue = \\\"bright_blue\\\";\\n      bright_cyan = \\\"bright_cyan\\\";\\n      bright_green = \\\"bright_green\\\";\\n      bright_magenta = \\\"bright_magenta\\\";\\n      bright_red = \\\"bright_red\\\";\\n      bright_white = \\\"bright_white\\\";\\n      bright_yellow = \\\"bright_yellow\\\";\\n      cyan = \\\"cyan\\\";\\n      green = \\\"green\\\";\\n      magenta = \\\"magenta\\\";\\n      red = \\\"red\\\";\\n      white = \\\"white\\\";\\n      yellow = \\\"yellow\\\";\\n    };\\n  }\\n]\"},\"loc\":[\"programs\",\"spotify-player\",\"themes\"],\"readOnly\":false,\"type\":\"list of (TOML value)\"},\"programs.sqls.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sqls.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sqls.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable sqls, a SQL language server written in Go.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sqls\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sqls.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sqls.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sqls.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sqls\"},\"description\":\"The sqls package to use.\",\"loc\":[\"programs\",\"sqls\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.sqls.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sqls.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sqls.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/sqls/config.yml`. See\\n<https://github.com/lighttiger2505/sqls#db-configuration>\\nfor supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  connections = [\\n    {\\n      dataSourceName = \\\"root:root@tcp(127.0.0.1:13306)/world\\\";\\n      driver = \\\"mysql\\\";\\n    }\\n  ];\\n  lowercaseKeywords = true;\\n}\"},\"loc\":[\"programs\",\"sqls\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.ssh.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ssh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ssh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable SSH client configuration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ssh\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ssh.enableDefaultConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ssh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ssh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable or not the old default config values.\\nThis option will become deprecated in the future.\\nFor an equivalent, copy and paste the following\\ncode snippet in your config:\\n\\n```nix\\nprograms.ssh.settings.\\\"*\\\" = {\\n  ForwardAgent = false;\\n  AddKeysToAgent = \\\"no\\\";\\n  Compression = false;\\n  ServerAliveInterval = 0;\\n  ServerAliveCountMax = 3;\\n  HashKnownHosts = false;\\n  UserKnownHostsFile = \\\"~/.ssh/known_hosts\\\";\\n  ControlMaster = \\\"no\\\";\\n  ControlPath = \\\"~/.ssh/master-%r@%n:%p\\\";\\n  ControlPersist = \\\"no\\\";\\n};\\n```\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"ssh\",\"enableDefaultConfig\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ssh.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ssh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ssh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration.\\n\",\"loc\":[\"programs\",\"ssh\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.ssh.extraOptionOverrides\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ssh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ssh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra SSH configuration options that take precedence over any\\nhost specific configuration.\\n\",\"loc\":[\"programs\",\"ssh\",\"extraOptionOverrides\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.ssh.includes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ssh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ssh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"File globs of ssh config files that should be included via the\\n`Include` directive.\\n\\nSee\\n{manpage}`ssh_config(5)`\\nfor more information.\\n\",\"loc\":[\"programs\",\"ssh\",\"includes\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.ssh.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ssh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ssh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The openssh package to use. By default, the client provided by your system is used.\",\"loc\":[\"programs\",\"ssh\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.ssh.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ssh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ssh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"OpenSSH client configuration blocks written to\\n{file}`~/.ssh/config`.\\n\\nAttribute names are interpreted as `Host` patterns unless they\\nstart with `Host ` or `Match `, in which case they are written\\nliterally as block headers. If the order of rules matter then\\nuse the DAG functions to express the dependencies as shown in\\nthe example.\\n\\nSee\\n{manpage}`ssh_config(5)`\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"github.com\\\" = {\\n    HostName = \\\"github.com\\\";\\n    User = \\\"git\\\";\\n    IdentityFile = \\\"~/.ssh/github\\\";\\n  };\\n\\n  \\\"Host *.example.org\\\" = lib.hm.dag.entryBefore [ \\\"github.com\\\" ] {\\n    IdentityFile = \\\"~/.ssh/example\\\";\\n    LocalForward = [\\n      {\\n        bind.port = 8080;\\n        host.address = \\\"10.0.0.13\\\";\\n        host.port = 80;\\n      }\\n      \\\"9000 10.0.0.2:90\\\"\\n    ];\\n    DynamicForward = \\\"127.0.0.1:1080\\\";\\n  };\\n\\n  \\\"Match host *.corp exec \\\\\\\"test -f ~/.corp\\\\\\\"\\\" = {\\n    ProxyJump = \\\"bastion\\\";\\n    RemoteForward = {\\n      bind.port = 8081;\\n      host.address = \\\"10.0.0.14\\\";\\n      host.port = 80;\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"ssh\",\"settings\"],\"readOnly\":false,\"type\":\"DAG of open submodule of attribute set of anything\"},\"programs.ssh.settings.<name>.header\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ssh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ssh.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"The attribute name, prefixed with `Host ` unless it already\\nstarts with `Host ` or `Match `.\\n\"},\"description\":\"The literal `Host` or `Match` line that opens this block.\\n\\nBy default this is derived from the attribute name: names\\nstarting with `Host ` or `Match ` are used literally, and\\nall other names are prefixed with `Host `. This default is\\nsuitable for most configurations.\\n\\nSet this only when the header cannot be expressed as the\\nattribute name, e.g. when it carries Nix string context\\n(store paths), or when a stable attribute name is wanted\\nfor {option}`lib.hm.dag` ordering.\\n\",\"loc\":[\"programs\",\"ssh\",\"settings\",\"<name>\",\"header\"],\"readOnly\":false,\"type\":\"string\"},\"programs.starship.configPath\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${config.xdg.configHome}/starship.toml\"},\"description\":\"Relative path to the user's home directory where the Starship config should be stored.\\n\",\"loc\":[\"programs\",\"starship\",\"configPath\"],\"readOnly\":false,\"type\":\"string\"},\"programs.starship.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable starship.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"starship\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.starship.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"starship\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.starship.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"starship\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.starship.enableInteractive\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Only enable starship when the shell is interactive. This option is only\\nvalid for the Fish shell.\\n\\nSome plugins require this to be set to `false` to function correctly.\\n\",\"loc\":[\"programs\",\"starship\",\"enableInteractive\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.starship.enableIonIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableIonIntegration)\"},\"description\":\"Whether to enable Ion integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"starship\",\"enableIonIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.starship.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"starship\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.starship.enableTransience\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"The TransientPrompt feature of Starship replaces previous prompts with a\\ncustom string. This is only a valid option for the Fish shell.\\n\\nFor documentation on how to change the default replacement string and\\nfor more information visit\\nhttps://starship.rs/advanced-config/#transientprompt-and-transientrightprompt-in-cmd\\n\",\"loc\":[\"programs\",\"starship\",\"enableTransience\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.starship.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"starship\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.starship.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra packages available to starship.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.jj-starship ]\"},\"loc\":[\"programs\",\"starship\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.starship.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.starship\"},\"description\":\"The starship package to use.\",\"loc\":[\"programs\",\"starship\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.starship.presets\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Preset files to be merged with settings in order.\\n\\nSee <https://starship.rs/presets/> for the full list of available presets.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"nerd-font-symbols\\\"\\n]\"},\"loc\":[\"programs\",\"starship\",\"presets\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.starship.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/starship.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/starship.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/starship.toml`.\\n\\nSee <https://starship.rs/config/> for the full list\\nof options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  add_newline = false;\\n  format = lib.concatStrings [\\n    \\\"$line_break\\\"\\n    \\\"$package\\\"\\n    \\\"$line_break\\\"\\n    \\\"$character\\\"\\n  ];\\n  scan_timeout = 10;\\n  character = {\\n    success_symbol = \\\"➜\\\";\\n    error_symbol = \\\"➜\\\";\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"starship\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.streamlink.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/streamlink.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/streamlink.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable streamlink.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"streamlink\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.streamlink.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/streamlink.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/streamlink.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.streamlink\"},\"description\":\"The streamlink package to use.\",\"loc\":[\"programs\",\"streamlink\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.streamlink.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/streamlink.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/streamlink.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Streamlink plugins.\\n\\nIf a source is set, the custom plugin will be linked to the data directory.\\n\\nAdditional configuration specific to the plugin, if defined, will be\\nwritten to the config directory, and override global settings.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  custom_plugin = {\\n    src = ./custom_plugin.py;\\n    settings = {\\n      quiet = true;\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"streamlink\",\"plugins\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.streamlink.plugins.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/streamlink.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/streamlink.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration for the specific plugin, written to\\n{file}`$XDG_CONFIG_HOME/streamlink/config.<name>` (linux) or\\n{file}`Library/Application Support/streamlink/config.<name>` (darwin).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  quiet = true;\\n}\"},\"loc\":[\"programs\",\"streamlink\",\"plugins\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or floating point number or string or list of (signed integer or floating point number or string))\"},\"programs.streamlink.plugins.<name>.src\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/streamlink.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/streamlink.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Source of the custom plugin. The value should be a path to the\\nplugin file, or the text of the plugin code. Will be linked to\\n{file}`$XDG_DATA_HOME/streamlink/plugins/<name>.py` (linux) or\\n{file}`Library/Application Support/streamlink/plugins/<name>.py` (darwin).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"./custom_plugin.py\"},\"loc\":[\"programs\",\"streamlink\",\"plugins\",\"<name>\",\"src\"],\"readOnly\":false,\"type\":\"null or absolute path or strings concatenated with \\\"\\\\n\\\"\"},\"programs.streamlink.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/streamlink.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/streamlink.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Global configuration options for streamlink. It will be written to\\n{file}`$XDG_CONFIG_HOME/streamlink/config` (linux) or\\n{file}`Library/Application Support/streamlink/config` (darwin).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  player = \\\"${pkgs.mpv}/bin/mpv\\\";\\n  player-args = \\\"--cache 2048\\\";\\n  player-no-close = true;\\n}\\n\"},\"loc\":[\"programs\",\"streamlink\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or floating point number or string or list of (signed integer or floating point number or string))\"},\"programs.superfile.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable superfile - Pretty fancy and modern terminal file manager.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"superfile\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.superfile.firstUseCheck\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Enables the first time use popup.\\n\",\"loc\":[\"programs\",\"superfile\",\"firstUseCheck\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.superfile.hotkeys\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Hotkey configuration written to {file}`$XDG_CONFIG_HOME/superfile/hotkeys.toml`\\n(linux) or {file}`Library/Application Support/superfile/hotkeys.toml` (darwin), See\\n<https://superfile.netlify.app/configure/custom-hotkeys/> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"confirm = [\\n  \\\"enter\\\"\\n  \\\"right\\\"\\n  \\\"l\\\"\\n];\\n\"},\"loc\":[\"programs\",\"superfile\",\"hotkeys\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.superfile.metadataPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.exiftool\"},\"description\":\"The exiftool package to use.\",\"loc\":[\"programs\",\"superfile\",\"metadataPackage\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.superfile.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.superfile\"},\"description\":\"The superfile package to use.\",\"loc\":[\"programs\",\"superfile\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.superfile.pinnedFolders\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Entries that get added to the pinned panel.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    name = \\\"Nix Store\\\";\\n    location = \\\"/nix/store\\\";\\n  }\\n];\\n\"},\"loc\":[\"programs\",\"superfile\",\"pinnedFolders\"],\"readOnly\":false,\"type\":\"list of (open submodule of (JSON value))\"},\"programs.superfile.pinnedFolders.*.location\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"description\":\"Location of the pinned entry.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/nix/store\\\"\"},\"loc\":[\"programs\",\"superfile\",\"pinnedFolders\",\"*\",\"location\"],\"readOnly\":false,\"type\":\"absolute path\"},\"programs.superfile.pinnedFolders.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Name that will be shown.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Nix Store\\\"\"},\"loc\":[\"programs\",\"superfile\",\"pinnedFolders\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.superfile.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/superfile/config.toml`\\n(linux) or {file}`Library/Application Support/superfile/config.toml` (darwin), See\\n<https://superfile.netlify.app/configure/superfile-config/> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"theme = \\\"catppuccin-frappe\\\";\\ndefault_sort_type = 0;\\ntransparent_background = false;\\n\"},\"loc\":[\"programs\",\"superfile\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.superfile.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Theme files written to {file}`$XDG_CONFIG_HOME/superfile/theme/`\\n(linux) or {file}`Library/Application Support/superfile/theme/` (darwin), See\\n<https://superfile.netlify.app/configure/custom-theme/> for supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"myTheme = {\\n  code_syntax_highlight = \\\"catppuccin-latte\\\";\\n\\n  file_panel_border = \\\"#101010\\\";\\n  sidebar_border = \\\"#101011\\\";\\n  footer_border = \\\"#101012\\\";\\n\\n  gradient_color = [\\n    \\\"#101013\\\"\\n    \\\"#101014\\\"\\n  ];\\n\\n  # ...\\n};\\nmyOtherFavoriteTheme = {\\n  code_syntax_highlight = \\\"catppuccin-mocha\\\";\\n\\n  file_panel_border = \\\"#505050\\\";\\n  sidebar_border = \\\"#505051\\\";\\n  footer_border = \\\"#505052\\\";\\n\\n  gradient_color = [\\n    \\\"#505053\\\"\\n    \\\"#505054\\\"\\n  ];\\n\\n  # ...\\n};\\n\"},\"loc\":[\"programs\",\"superfile\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (TOML value or absolute path)\"},\"programs.superfile.zoxidePackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/superfile.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/superfile.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.zoxide\"},\"description\":\"The zoxide package to use.\",\"loc\":[\"programs\",\"superfile\",\"zoxidePackage\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.swappy.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swappy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swappy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable swappy.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"swappy\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.swappy.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swappy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swappy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.swappy\"},\"description\":\"The swappy package to use.\",\"loc\":[\"programs\",\"swappy\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.swappy.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swappy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swappy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for swappy. All the available options can be found\\nhere: <https://github.com/jtheoof/swappy?tab=readme-ov-file#config>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  Default = {\\n    auto_save = false;\\n    custom_color = \\\"rgba(193,125,17,1)\\\";\\n    early_exit = false;\\n    fill_shape = false;\\n    line_size = 5;\\n    paint_mode = \\\"brush\\\";\\n    save_dir = \\\"$HOME/Desktop\\\";\\n    save_filename_format = \\\"swappy-%Y%m%d-%H%M%S.png\\\";\\n    show_panel = false;\\n    text_font = \\\"sans-serif\\\";\\n    text_size = 20;\\n    transparency = 50;\\n    transparent = false;\\n  };\\n}\"},\"loc\":[\"programs\",\"swappy\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.sway-easyfocus.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sway-easyfocus.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sway-easyfocus.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable sway-easyfocus.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"sway-easyfocus\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.sway-easyfocus.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sway-easyfocus.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sway-easyfocus.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.sway-easyfocus\"},\"description\":\"The sway-easyfocus package to use.\",\"loc\":[\"programs\",\"sway-easyfocus\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.sway-easyfocus.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/sway-easyfocus.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/sway-easyfocus.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for sway-easyfocus. All available options can be found here:\\n<https://github.com/edzdez/sway-easyfocus?tab=readme-ov-file#config-file>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  chars = \\\"fjghdkslaemuvitywoqpcbnxz\\\";\\n  focused_background_color = \\\"285577\\\";\\n  focused_background_opacity = 1.0;\\n  focused_text_color = \\\"ffffff\\\";\\n  font_family = \\\"monospace\\\";\\n  font_size = \\\"medium\\\";\\n  font_weight = \\\"bold\\\";\\n  window_background_color = \\\"d1f21\\\";\\n  window_background_opacity = 0.2;\\n}\"},\"loc\":[\"programs\",\"sway-easyfocus\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.swayimg.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swayimg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swayimg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable swayimg.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"swayimg\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.swayimg.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swayimg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swayimg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.swayimg\"},\"description\":\"The swayimg package to use.\",\"loc\":[\"programs\",\"swayimg\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.swayimg.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swayimg.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swayimg.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/swayimg/config`. See <https://github.com/artemsen/swayimg/blob/master/extra/swayimgrc> for a list of available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  viewer = {\\n    window = \\\"#10000010\\\";\\n    scale = \\\"fill\\\";\\n  };\\n  \\\"info.viewer\\\" = {\\n    top_left = \\\"+name,+format\\\";\\n  };\\n  \\\"keys.viewer\\\" = {\\n    \\\"Shift+r\\\" = \\\"rand_file\\\";\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"swayimg\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.swaylock.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swaylock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swaylock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true  if state version < 23.05 and settings ≠ { },\\nfalse otherwise\\n\"},\"description\":\"Whether to enable swaylock.\\n\\nNote that PAM must be configured to enable swaylock to perform\\nauthentication. The package installed through home-manager\\nwill *not* be able to unlock the session without this\\nconfiguration.\\n\\nOn NixOS, this is by default enabled with the sway module, but\\nfor other compositors it can currently be enabled using:\\n\\n```nix\\nsecurity.pam.services.swaylock = {};\\n```\\n\\nOn non-NixOS, it is easiest to avoid incompatibility involving PAM by\\n\\n1. stopping Home Manager from installing swaylock by setting\\n   {option}`programs.swaylock.package` to `null`; and\\n\\n2. instead installing swaylock from your distribution's repository.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"swaylock\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.swaylock.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swaylock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swaylock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.swaylock\"},\"description\":\"The swaylock package to use.\",\"loc\":[\"programs\",\"swaylock\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.swaylock.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swaylock.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swaylock.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Default arguments to {command}`swaylock`. An empty set\\ndisables configuration generation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  color = \\\"808080\\\";\\n  font-size = 24;\\n  indicator-idle-visible = false;\\n  indicator-radius = 100;\\n  line-color = \\\"ffffff\\\";\\n  show-failed-attempts = true;\\n}\"},\"loc\":[\"programs\",\"swaylock\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or floating point number or signed integer or absolute path or string)\"},\"programs.swayr.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swayr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swayr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the swayr service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"swayr\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.swayr.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swayr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swayr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines to append to the swayr\\nconfiguration file.\\n\",\"loc\":[\"programs\",\"swayr\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.swayr.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swayr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swayr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.swayr\"},\"description\":\"The swayr package to use.\",\"loc\":[\"programs\",\"swayr\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.swayr.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swayr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swayr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration included in `config.toml`.\\nFor available options see <https://git.sr.ht/~tsdh/swayr#swayr-configuration>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"menu = {\\n  executable = \\\"${pkgs.wofi}/bin/wofi\\\";\\n  args = [\\n    \\\"--show=dmenu\\\"\\n    \\\"--allow-markup\\\"\\n    \\\"--allow-images\\\"\\n    \\\"--insensitive\\\"\\n    \\\"--cache-file=/dev/null\\\"\\n    \\\"--parse-search\\\"\\n    \\\"--height=40%\\\"\\n    \\\"--prompt={prompt}\\\"\\n  ];\\n};\\n\\nformat = {\\n  output_format = \\\"{indent}<b>Output {name}</b>    <span alpha=\\\\\\\"20000\\\\\\\">({id})</span>\\\";\\n  workspace_format = \\\"{indent}<b>Workspace {name} [{layout}]</b> on output {output_name}    <span alpha=\\\\\\\"20000\\\\\\\">({id})</span>\\\";\\n  container_format = \\\"{indent}<b>Container [{layout}]</b> <i>{marks}</i> on workspace {workspace_name}    <span alpha=\\\\\\\"20000\\\\\\\">({id})</span>\\\";\\n  window_format = \\\"img:{app_icon}:text:{indent}<i>{app_name}</i> — {urgency_start}<b>“{title}”</b>{urgency_end} <i>{marks}</i> on workspace {workspace_name} / {output_name}    <span alpha=\\\\\\\"20000\\\\\\\">({id})</span>\\\";\\n  indent = \\\"    \\\";\\n  urgency_start = \\\"<span background=\\\\\\\"darkred\\\\\\\" foreground=\\\\\\\"yellow\\\\\\\">\\\";\\n  urgency_end = \\\"</span>\\\";\\n  html_escape = true;\\n};\\n\\nlayout = {\\n  auto_tile = false;\\n  auto_tile_min_window_width_per_output_width = [\\n    [ 800 400 ]\\n    [ 1024 500 ]\\n    [ 1280 600 ]\\n    [ 1400 680 ]\\n    [ 1440 700 ]\\n    [ 1600 780 ]\\n    [ 1680 780 ]\\n    [ 1920 920 ]\\n    [ 2048 980 ]\\n    [ 2560 1000 ]\\n    [ 3440 1200 ]\\n    [ 3840 1280 ]\\n    [ 4096 1400 ]\\n    [ 4480 1600 ]\\n    [ 7680 2400 ]\\n  ];\\n};\\n\\nfocus = {\\n  lockin_delay = 750;\\n};\\n\\nmisc = {\\n  seq_inhibit = false;\\n};\\n\"},\"loc\":[\"programs\",\"swayr\",\"settings\"],\"readOnly\":false,\"type\":\"null or TOML value\"},\"programs.swayr.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swayr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swayr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable swayr systemd integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"swayr\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.swayr.systemd.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/swayr.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/swayr.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.wayland.systemd.target\"},\"description\":\"Systemd target to bind to.\\n\",\"loc\":[\"programs\",\"swayr\",\"systemd\",\"target\"],\"readOnly\":false,\"type\":\"string\"},\"programs.t3code.clientSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/t3code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/t3code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to t3code's {file}`client-settings.json`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  settings = {\\n    favorites = [\\n      {\\n        model = \\\"gpt-5.5\\\";\\n        provider = \\\"codex\\\";\\n      }\\n    ];\\n    sidebarProjectGroupingMode = \\\"repository\\\";\\n    timestampFormat = \\\"locale\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"t3code\",\"clientSettings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.t3code.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/t3code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/t3code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable T3 Code, a minimal web GUI for coding agents.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"t3code\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.t3code.keybindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/t3code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/t3code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Configuration written to t3code's {file}`keybindings.json`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    command = \\\"terminal.toggle\\\";\\n    key = \\\"mod+j\\\";\\n  }\\n  {\\n    command = \\\"terminal.split\\\";\\n    key = \\\"mod+d\\\";\\n    when = \\\"terminalFocus\\\";\\n  }\\n  {\\n    command = \\\"diff.toggle\\\";\\n    key = \\\"mod+d\\\";\\n    when = \\\"!terminalFocus\\\";\\n  }\\n]\"},\"loc\":[\"programs\",\"t3code\",\"keybindings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.t3code.mutableClientSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/t3code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/t3code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether client settings ({file}`client-settings.json`) can be updated by t3code.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"t3code\",\"mutableClientSettings\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.t3code.mutableKeybindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/t3code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/t3code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether user keybindings ({file}`keybindings.json`) can be updated by t3code.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"t3code\",\"mutableKeybindings\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.t3code.mutableUserSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/t3code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/t3code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether user settings ({file}`settings.json`) can be updated by t3code.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"t3code\",\"mutableUserSettings\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.t3code.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/t3code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/t3code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.t3code\"},\"description\":\"The t3code package to install.\\n\",\"loc\":[\"programs\",\"t3code\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.t3code.userSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/t3code.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/t3code.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to t3code's {file}`settings.json`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  enableAssistantStreaming = true;\\n  providerInstances = {\\n    codex = {\\n      config = {\\n        binaryPath = \\\"codex\\\";\\n        customModels = [ ];\\n        enabled = true;\\n        homePath = \\\"\\\";\\n        shadowHomePath = \\\"\\\";\\n      };\\n      driver = \\\"codex\\\";\\n      enabled = true;\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"t3code\",\"userSettings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.taskwarrior.colorTheme\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/taskwarrior.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/taskwarrior.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Either one of the default provided theme as string, or a\\npath to a theme configuration file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"dark-blue-256\\\"\"},\"loc\":[\"programs\",\"taskwarrior\",\"colorTheme\"],\"readOnly\":false,\"type\":\"null or string or absolute path\"},\"programs.taskwarrior.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/taskwarrior.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/taskwarrior.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Key-value configuration written to\\n{file}`$XDG_CONFIG_HOME/task/taskrc`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  confirmation = false;\\n  report.minimal.filter = \\\"status:pending\\\";\\n  report.active.columns = [ \\\"id\\\" \\\"start\\\" \\\"entry.age\\\" \\\"priority\\\" \\\"project\\\" \\\"due\\\" \\\"description\\\" ];\\n  report.active.labels  = [ \\\"ID\\\" \\\"Started\\\" \\\"Age\\\" \\\"Priority\\\" \\\"Project\\\" \\\"Due\\\" \\\"Description\\\" ];\\n  taskd = {\\n    certificate = \\\"/path/to/cert\\\";\\n    key = \\\"/path/to/key\\\";\\n    ca = \\\"/path/to/ca\\\";\\n    server = \\\"host.domain:53589\\\";\\n    credentials = \\\"Org/First Last/cf31f287-ee9e-43a8-843e-e8bbd5de4294\\\";\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"taskwarrior\",\"config\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.taskwarrior.dataLocation\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/taskwarrior.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/taskwarrior.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$XDG_DATA_HOME/task\\\"\"},\"description\":\"Location where Task Warrior will store its data.\\n\\nHome Manager will attempt to create this directory.\\n\",\"loc\":[\"programs\",\"taskwarrior\",\"dataLocation\"],\"readOnly\":false,\"type\":\"string\"},\"programs.taskwarrior.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/taskwarrior.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/taskwarrior.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Task Warrior.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"taskwarrior\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.taskwarrior.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/taskwarrior.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/taskwarrior.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Additional content written at the end of\\n{file}`$XDG_CONFIG_HOME/task/taskrc`.\\n\",\"loc\":[\"programs\",\"taskwarrior\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.taskwarrior.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/taskwarrior.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/taskwarrior.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.taskwarrior2\"},\"description\":\"The taskwarrior2 package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.taskwarrior3\"},\"loc\":[\"programs\",\"taskwarrior\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.tealdeer.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tealdeer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tealdeer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Tealdeer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"tealdeer\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tealdeer.enableAutoUpdates\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tealdeer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tealdeer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable Auto updates.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"tealdeer\",\"enableAutoUpdates\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tealdeer.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tealdeer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tealdeer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.tealdeer\"},\"description\":\"The tealdeer package to use.\",\"loc\":[\"programs\",\"tealdeer\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.tealdeer.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tealdeer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tealdeer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/tealdeer/config.toml` on Linux or\\n{file}`$HOME/Library/Application Support/tealdeer/config.toml` on Darwin.\\nSee <https://tealdeer-rs.github.io/tealdeer/config.html> for more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  display = {\\n    compact = false;\\n    use_pager = true;\\n  };\\n  updates = {\\n    auto_update = false;\\n  };\\n};\\n\"},\"loc\":[\"programs\",\"tealdeer\",\"settings\"],\"readOnly\":false,\"type\":\"null or (open submodule of (TOML value))\"},\"programs.tealdeer.settings.updates\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tealdeer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tealdeer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Tealdeer can refresh the cache automatically when it is outdated.\\nThis behavior can be configured in the updates section.\\n\",\"loc\":[\"programs\",\"tealdeer\",\"settings\",\"updates\"],\"readOnly\":false,\"type\":\"open submodule of (TOML value)\"},\"programs.tealdeer.settings.updates.auto_update\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tealdeer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tealdeer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable auto-update.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"tealdeer\",\"settings\",\"updates\",\"auto_update\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tealdeer.settings.updates.auto_update_interval_hours\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tealdeer.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tealdeer.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"720\"},\"description\":\"Duration, since the last cache update, after which the cache will be refreshed.\\nThis parameter is ignored if {var}`auto_update` is set to `false`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"24\"},\"loc\":[\"programs\",\"tealdeer\",\"settings\",\"updates\",\"auto_update_interval_hours\"],\"readOnly\":false,\"type\":\"positive integer, meaning >0\"},\"programs.television.channels\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/television.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/television.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Each set of channels are written to\\n{file}`$XDG_CONFIG_HOME/television/cable/NAME.toml`\\n\\nSee <https://alexpasmantier.github.io/television/docs/Users/channels>\\nfor options\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  git-diff = {\\n    metadata = {\\n      description = \\\"A channel to select files from git diff commands\\\";\\n      name = \\\"git-diff\\\";\\n      requirements = [\\n        \\\"git\\\"\\n      ];\\n    };\\n    preview = {\\n      command = \\\"git diff HEAD --color=always -- '{}'\\\";\\n    };\\n    source = {\\n      command = \\\"git diff --name-only HEAD\\\";\\n    };\\n  };\\n  git-log = {\\n    metadata = {\\n      description = \\\"A channel to select from git log entries\\\";\\n      name = \\\"git-log\\\";\\n      requirements = [\\n        \\\"git\\\"\\n      ];\\n    };\\n    preview = {\\n      command = \\\"git show -p --stat --pretty=fuller --color=always '{0}'\\\";\\n    };\\n    source = {\\n      command = \\\"git log --oneline --date=short --pretty=\\\\\\\"format:%h %s %an %cd\\\\\\\" \\\\\\\"$@\\\\\\\"\\\";\\n      output = \\\"{split: :0}\\\";\\n    };\\n  };\\n}\"},\"loc\":[\"programs\",\"television\",\"channels\"],\"readOnly\":false,\"type\":\"attribute set of (TOML value)\"},\"programs.television.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/television.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/television.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable television.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"television\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.television.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/television.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/television.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"television\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.television.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/television.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/television.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"television\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.television.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/television.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/television.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"television\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.television.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/television.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/television.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"television\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.television.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/television.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/television.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.television\"},\"description\":\"The television package to use.\",\"loc\":[\"programs\",\"television\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.television.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/television.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/television.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/television/config.toml`.\\nSee <https://github.com/alexpasmantier/television/blob/main/.config/config.toml>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  keybindings = {\\n    quit = [\\n      \\\"esc\\\"\\n      \\\"ctrl-c\\\"\\n    ];\\n  };\\n  tick_rate = 50;\\n  ui = {\\n    show_preview_panel = false;\\n    ui_scale = 120;\\n    use_nerd_font_icons = true;\\n  };\\n}\"},\"loc\":[\"programs\",\"television\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.terminator.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/terminator.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/terminator.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"configuration for terminator.\\n\\nFor a list of all possible options refer to the\\n{manpage}`terminator_config(5)`\\nman page.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  global_config.borderless = true;\\n  profiles.default.background_color = \\\"#002b36\\\";\\n}\\n\"},\"loc\":[\"programs\",\"terminator\",\"config\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.terminator.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/terminator.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/terminator.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable terminator, a tiling terminal emulator.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"terminator\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.terminator.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/terminator.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/terminator.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.terminator\"},\"description\":\"The terminator package to use.\",\"loc\":[\"programs\",\"terminator\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.termite.allowBold\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/termite.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release