nager/blob/release-26.05/modules/programs/lazyworktree.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/lazyworktree/config.yaml`.\\nSee\\n<https://github.com/chmouel/lazyworktree?tab=readme-ov-file#global-configuration-yaml>\\nfor supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  auto_refresh = true;\\n  ci_auto_refresh = false;\\n  disable_pr = false;\\n  fuzzy_finder_input = false;\\n  icon_set = \\\"nerd-font-v3\\\";\\n  layout = \\\"default\\\";\\n  palette_mru = true;\\n  palette_mru_limit = 5;\\n  refresh_interval = 10;\\n  search_auto_select = false;\\n  sort_mode = \\\"switched\\\";\\n  worktree_dir = \\\"~/.local/share/worktrees\\\";\\n}\"},\"loc\":[\"programs\",\"lazyworktree\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.lazyworktree.shellWrapperName\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lazyworktree.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lazyworktree.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"lwt\\\"\"},\"description\":\"Name of the shell wrapper that launches lazyworktree and changes to the\\nselected worktree directory on exit.\\nThis option only has an effect when at least one shell integration\\noption is enabled.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"wt\\\"\"},\"loc\":[\"programs\",\"lazyworktree\",\"shellWrapperName\"],\"readOnly\":false,\"type\":\"string\"},\"programs.ledger.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ledger.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ledger.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable ledger, a double-entry accounting system.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ledger\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ledger.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ledger.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ledger.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration to add to\\n{file}`$XDG_CONFIG_HOME/ledger/ledgerrc`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"--sort date\\n--effective\\n--date-format %Y-%m-%d\\n\"},\"loc\":[\"programs\",\"ledger\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.ledger.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ledger.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ledger.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.ledger\"},\"description\":\"The ledger package to use.\",\"loc\":[\"programs\",\"ledger\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.ledger.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ledger.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ledger.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/ledger/ledgerrc`.\\nSee <https://www.ledger-cli.org/3.0/doc/ledger3.html#Detailed-Option-Description>\\nfor explanation about possible values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  date-format = \\\"%Y-%m-%d\\\";\\n  file = [\\n    \\\"~/finances/journal.ledger\\\"\\n    \\\"~/finances/assets.ledger\\\"\\n    \\\"~/finances/income.ledger\\\"\\n  ];\\n  sort = \\\"date\\\";\\n  strict = true;\\n}\"},\"loc\":[\"programs\",\"ledger\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or string or list of string)\"},\"programs.less.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/less.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/less.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Configuration for {command}`less`, written to\\n{file}`$XDG_CONFIG_HOME/lesskey`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  #command\\n  s        back-line\\n  t        forw-line\\n''\"},\"loc\":[\"programs\",\"less\",\"config\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.less.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/less.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/less.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable less, opposite of more.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"less\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.less.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/less.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/less.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Options to be set via {env}`$LESS`.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  RAW-CONTROL-CHARS = true;\\n  quiet = true;\\n  wheel-lines = 3;\\n}\"},\"loc\":[\"programs\",\"less\",\"options\"],\"readOnly\":false,\"type\":\"(list of string) or (attribute set of (boolean or signed integer or string or list of (boolean or signed integer or string))) convertible to it\"},\"programs.less.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/less.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/r