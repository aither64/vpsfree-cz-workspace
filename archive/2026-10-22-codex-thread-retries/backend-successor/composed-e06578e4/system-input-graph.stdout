e\":{\"_type\":\"literalExpression\",\"text\":\"\\\"hyprland-session.target\\\"\"},\"loc\":[\"services\",\"hyprsunset\",\"systemdTarget\"],\"readOnly\":false,\"type\":\"string\"},\"services.hyprsunset.transitions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/hyprsunset.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/hyprsunset.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Deprecated - Use {option}`services.hyprsunset.settings` instead to manage transitions.\\n\\nSet of transitions for different times of day (e.g., sunrise, sunset)\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  sunrise = {\\n    calendar = \\\"*-*-* 06:00:00\\\";\\n    requests = [\\n      [\\n        \\\"temperature\\\"\\n        \\\"6500\\\"\\n      ]\\n      [\\n        \\\"gamma 100\\\"\\n      ]\\n    ];\\n  };\\n  sunset = {\\n    calendar = \\\"*-*-* 19:00:00\\\";\\n    requests = [\\n      [\\n        \\\"temperature\\\"\\n        \\\"3500\\\"\\n      ]\\n    ];\\n  };\\n}\"},\"loc\":[\"services\",\"hyprsunset\",\"transitions\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"services.hyprsunset.transitions.<name>.calendar\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/hyprsunset.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/hyprsunset.nix\"}],\"description\":\"Deprecated - Use {option}`services.hyprsunset.settings` instead to manage transitions.\\n\\nSystemd calendar expression for when to run this transition.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"*-*-* 06:00:00\\\"\"},\"loc\":[\"services\",\"hyprsunset\",\"transitions\",\"<name>\",\"calendar\"],\"readOnly\":false,\"type\":\"string\"},\"services.hyprsunset.transitions.<name>.requests\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/hyprsunset.nix>\",\"url\":\"https://github.com/nix-comm