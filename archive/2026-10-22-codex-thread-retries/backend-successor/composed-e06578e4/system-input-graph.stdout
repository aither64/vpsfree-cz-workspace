v.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyenv.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\\${config.xdg.dataHome}/pyenv\\\"\"},\"description\":\"The pyenv root directory ({env}`PYENV_ROOT`).\\n\\n::: {.note}\\nThis deviates from upstream, which uses {file}`$HOME/.pyenv`.\\nThe default path in Home Manager is set according to the XDG\\nbase directory specification.\\n:::\\n\",\"loc\":[\"programs\",\"pyenv\",\"rootDirectory\"],\"readOnly\":false,\"type\":\"absolute path\"},\"programs.pylint.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pylint.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pylint.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the pylint Python linter.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"pylint\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.pylint.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pylint.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pylint.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.python3Packages.pylint\"},\"description\":\"The pylint package to use.\",\"loc\":[\"programs\",\"pylint\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.pylint.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pylint.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pylint.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{}\"},\"description\":\"The pylint configuration.\",\"loc\":[\"programs\",\"pylint\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string) or a non-empty list of them)\"},\"programs.pyradio.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable pyradio.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"pyradio\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.pyradio.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.pyradio\"},\"description\":\"The pyradio package to use.\",\"loc\":[\"programs\",\"pyradio\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.pyradio.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Options to add to the PyRadio {file}`config` file.\\nSee <https://github.com/coderholic/pyradio/blob/master/pyradio/config>\\nfor available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  enable_clock = true;\\n  enable_notifications = 0;\\n  player = \\\"mpv\\\";\\n  theme = \\\"dark_16_colors\\\";\\n  time_format = 0;\\n  use_transparency = true;\\n}\"},\"loc\":[\"programs\",\"pyradio\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean)\"},\"programs.pyradio.stations\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Radio stations to add to the {file}`stations.csv` file.\\nIf empty, {file}`stations.csv` defaults to the built-in playlist.\\n\\nTo add a group, add a station with the url set to \\\"-\\\" and the name set\\nto the name of the group. Its order in the list will be where it appears\\nin `pyradio`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    name = \\\"DEF CON Radio (SomaFM)\\\";\\n    url = \\\"https://somafm.com/defcon256.pls\\\";\\n  }\\n  {\\n    name = \\\"Intense Radio - We Love Dance!\\\";\\n    url = \\\"https://secure.live-streams.nl/flac.ogg\\\";\\n  }\\n]\"},\"loc\":[\"programs\",\"pyradio\",\"stations\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.pyradio.stations.*.buffering\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Buffering configuration to apply to the station.\",\"loc\":[\"programs\",\"pyradio\",\"stations\",\"*\",\"buffering\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"programs.pyradio.stations.*.buffering.bitrate\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"128\"},\"description\":\"Bitrate of the stream in kbps (modify only if using MPlayer).\",\"loc\":[\"programs\",\"pyradio\",\"stations\",\"*\",\"buffering\",\"bitrate\"],\"readOnly\":false,\"type\":\"positive integer, meaning >0\"},\"programs.pyradio.stations.*.buffering.seconds\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"description\":\"Number of seconds to buffer the stream.\",\"loc\":[\"programs\",\"pyradio\",\"stations\",\"*\",\"buffering\",\"seconds\"],\"readOnly\":false,\"type\":\"positive integer, meaning >0\"},\"programs.pyradio.stations.*.encoding\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Encoding of the station's metadata block.\",\"loc\":[\"programs\",\"pyradio\",\"stations\",\"*\",\"encoding\"],\"readOnly\":false,\"type\":\"string\"},\"programs.pyradio.stations.*.forceHttp\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If enabled, the connection is forced to use http (note when false it can either use http or https).\",\"loc\":[\"programs\",\"pyradio\",\"stations\",\"*\",\"forceHttp\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.pyradio.stations.*.iconUrl\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"URL of an icon to be shown in desktop notifications.\",\"loc\":[\"programs\",\"pyradio\",\"stations\",\"*\",\"iconUrl\"],\"readOnly\":false,\"type\":\"string\"},\"programs.pyradio.stations.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pyradio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pyradio.nix\"}],\"description\":\"Display name of the radio station.\",\"loc\":[\"programs\",\"pyradio\",\"stations\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"s