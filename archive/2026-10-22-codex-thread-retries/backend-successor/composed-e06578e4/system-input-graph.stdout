s":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"NIX_MAIN_PROGRAM":"openssl"},"makeFlags":["MANDIR=$(man)/share/man","MANSUFFIX=ssl"],"mesonFlags":[],"name":"openssl-3.5.8","nativeBuildInputs":["/nix/store/aajj151ynws8hj2ajkvhv38b2c8sjyw5-make-binary-wrapper-hook","/nix/store/8g4dmf7l8q1mf9w4wfmlcl8gvdgmhb8v-perl-5.42.3","/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh"],"outputChecks":{"bin":{},"debug":{},"dev":{},"doc":{},"man":{},"out":{}},"outputs":["bin","dev","out","man","doc","debug"],"patches":["/nix/store/sq4h6bqjx12v9whvm65pjss25hg1538q-nix-ssl-cert-file.patch","/nix/store/cklrwbwi889pp2fdsswdjvn12sdy5i5j-openssl-disable-kernel-detection.patch","/nix/store/i58agvhx8bmdjlspgkk4m3ylh5348iim-use-etc-ssl-certs.patch"],"pname":"openssl","postFixup":"# Check to make sure the main output and the static runtime dependencies\n# don't depend on perl\nif grep -r '/nix/store/8g4dmf7l8q1mf9w4wfmlcl8gvdgmhb8v-perl-5.42.3' $out $etc; then\n  echo \"Found an erroneous dependency on perl ^^^\" >&2\n  exit 1\nfi\n# cleanup cmake helpers for now (for OpenSSL >= 3.3), only rely on pkg-config.\n# pkg-config gets its paths fixed correctly\nrm -rf $dev/lib/cmake\n","postInstall":"# If we're building dynamic libraries, then don't install static\n# libraries.\nif [ -n \"$(echo $out/lib/*.so $out/lib/*.dylib $out/lib/*.dll)\" ]; then\n    rm \"$out/lib/\"*.a\nfi\n\n# 'etc' is a separate output on static builds only.\netc=$out\nmkdir -p $bin\nmv $out/bin $bin/bin\n\n# c_rehash is a legacy perl script with the same functionality\n# as `openssl rehash`\n# this wrapper script is created to maintain backwards compatibility without\n# depending on perl\nmakeWrapper $bin/bin/openssl $bin/bin/c_rehash \\\n  --add-flags \"rehash\"\n\nmkdir $dev\nmv $out/include $dev/\n\n# remove dependency on Perl at runtime\nrm -r $etc/etc/ssl/misc\n\nrmdir $etc/etc/ssl/{certs,private}\n","postPatch":"patchShebangs Configure\nsubstituteInPlace config --replace '/usr/bin/env' '/nix/store/akjx1x190xlgbfjh6ichvfywncjaz22m-coreutils-9.11/bin/env'\n","preCheck":"patchShebangs util\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"setOutputFlags":false,"src":"/nix/store/2wqx8i0bmavb7l78rhfxn41kjpfkfvz3-openssl-3.5.8.tar.gz","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"3.5.8"},"system":"x86_64-linux","version":4},"4p0rh6rhn8qczxlhllfdihwjs15r80zc-harfbuzz-13.2.1.tar.xz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/xzzvrdxxdvgaf0dv0s06qxvjasaxi1fw-harfbuzz-13.2.1.tar.xz"},"inputs":{"drvs":{"3fc7klhja3mn322hjxl4bax4mk3m6h8l-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"nccfw1s0py9wvalrf7s92cfmg7bijj0i-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"harfbuzz-13.2.1.tar.xz","outputs":{"out":{"hash":"sha256-ZpXaPrfhvgqjCS/k2BQzoztH9FGSWcdZ1ynjqaVcFCk=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":[],"curlOpts":"","curlOptsList":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"downloadToTemp":false,"env":{"SSL_CERT_FILE":"/no-cert-file.crt"}