x0sd-bash-5.3p9/bin/bash\nset -e\n\n# Backwards compatibility\nif [ ! -d /var/lib/postfix ] && [ -d /var/postfix ]; then\n  mkdir -p /var/lib\n  mv /var/postfix /var/lib/postfix\nfi\n\n# All permissions set according /nix/store/lw3m90dv2gj83azq1ngvgl1r5prw3131-postfix-3.11.7/etc/postfix/postfix-files script\nmkdir -p /var/lib/postfix /var/lib/postfix/queue/{pid,public,maildrop}\nchmod 0755 /var/lib/postfix\nchown root:root /var/lib/postfix\n\nrm -rf /var/lib/postfix/conf\nmkdir -p /var/lib/postfix/conf\nchmod 0755 /var/lib/postfix/conf\nln -sf /nix/store/lw3m90dv2gj83azq1ngvgl1r5prw3131-postfix-3.11.7/etc/postfix/postfix-files /var/lib/postfix/conf/postfix-files\nln -sf /nix/store/vyn7pp5g99dy9hj10da2apd6qf0zdw1k-postfix-main.cf /var/lib/postfix/conf/main.cf\nln -sf /nix/store/hc9by64r3zjp0xf7nydx3v4067922x1s-postfix-master.cf /var/lib/postfix/conf/master.cf\n\nln -sf /nix/store/lrh06rgbazrdi4cgn7irz681yyzbbfaj-postfix-aliases /var/lib/postfix/conf/aliases\n/nix/store/lw3m90dv2gj83azq1ngvgl1r5prw3131-postfix-3.11.7/bin/postalias -o -p /var/lib/postfix/conf/aliases\n\n\n\nmkdir -p /var/spool/mail\nchown root:root /var/spool/mail\nchmod a+rwxt /var/spool/mail\nln -sf /var/spool/mail /var/\n\n#Finally delegate to postfix checking remain directories in /var/lib/postfix and set permissions on them\n/nix/store/lw3m90dv2gj83azq1ngvgl1r5prw3131-postfix-3.11.7/bin/postfix set-permissions config_directory=/var/lib/postfix/conf\n\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"a1jwswv1i0gipxa0w2liac867f2d4agq-postfix-aliases.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"g37bv85dz879rac5f2wx2vwz4lxbbw6g-postfix-master.cf.drv":{"dynamicOutputs":{},"outputs":["out"]},"w1lrd0kfkmyach639lcnvfyqch70s5rj-postfix-3.11.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"x0gcn6hxy1xci7jgnm80rjypcfk25sm6-postfix-main.cf.drv":{"dynamicO