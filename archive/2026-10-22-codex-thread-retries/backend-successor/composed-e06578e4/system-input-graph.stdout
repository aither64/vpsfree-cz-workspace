rl\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keychain.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"id_rsa\\\"\\n]\"},\"description\":\"Keys to add to keychain.\\n\",\"loc\":[\"programs\",\"keychain\",\"keys\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.keychain.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/keychain.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/keychain.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.keychain\"},\"description\":\"The keychain package to use.\",\"loc\":[\"programs\",\"keychain\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.khal.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable khal, a CLI calendar application.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"khal\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.khal.locale\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"khal locale settings.\\n\",\"loc\":[\"programs\",\"khal\",\"locale\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.khal.locale.dateformat\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"%x\\\"\"},\"description\":\"khal will display and understand all dates in this format.\\n\\nFormat strings are for Python `strftime`, similarly to\\n{manpage}`strftime(3)`.\\n\\n\",\"loc\":[\"programs\",\"khal\",\"locale\",\"dateformat\"],\"readOnly\":false,\"type\":\"string\"},\"programs.khal.locale.datetimeformat\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"%c\\\"\"},\"description\":\"khal will display and understand all datetimes in this format.\\n\\nFormat strings are for Python `strftime`, similarly to\\n{manpage}`strftime(3)`.\\n\\n\",\"loc\":[\"programs\",\"khal\",\"locale\",\"datetimeformat\"],\"readOnly\":false,\"type\":\"string\"},\"programs.khal.locale.default_timezone\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Default for new events or if khal does not understand the timezone\\nin an ical file.\\nIf `null`, the timezone of your computer will be used.\\n\",\"loc\":[\"programs\",\"khal\",\"locale\",\"default_timezone\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.khal.locale.firstweekday\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"0\"},\"description\":\"The first day of the week, where Monday is 0 and Sunday is 6.\\n\",\"loc\":[\"programs\",\"khal\",\"locale\",\"firstweekday\"],\"readOnly\":false,\"type\":\"integer between 0 and 6 (both inclusive)\"},\"programs.khal.locale.local_timezone\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"khal will show all times in this timezone.\\nIf `null`, the timezone of your computer will be used.\\n\",\"loc\":[\"programs\",\"khal\",\"locale\",\"local_timezone\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.khal.locale.longdateformat\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"%x\\\"\"},\"description\":\"khal will display and understand all dates in this format.\\nIt should contain a year (e.g. `%Y`).\\n\\nFormat strings are for Python `strftime`, similarly to\\n{manpage}`strftime(3)`.\\n\\n\",\"loc\":[\"programs\",\"khal\",\"locale\",\"longdateformat\"],\"readOnly\":false,\"type\":\"string\"},\"programs.khal.locale.longdatetimeformat\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"%c\\\"\"},\"description\":\"khal will display and understand all datetimes in this format.\\nIt should contain a year (e.g. `%Y`).\\n\\nFormat strings are for Python `strftime`, similarly to\\n{manpage}`strftime(3)`.\\n\\n\",\"loc\":[\"programs\",\"khal\",\"locale\",\"longdatetimeformat\"],\"readOnly\":false,\"type\":\"string\"},\"programs.khal.locale.timeformat\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"%X\\\"\"},\"description\":\"khal will display and understand all times in this format.\\n\\nFormat strings are for Python `strftime`, similarly to\\n{manpage}`strftime(3)`.\\n\\n\",\"loc\":[\"programs\",\"khal\",\"locale\",\"timeformat\"],\"readOnly\":false,\"type\":\"string\"},\"programs.khal.locale.unicode_symbols\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"By default khal uses some Unicode symbols (as in \\\"non-ASCII\\\") as\\nindicators for things like repeating events.\\nIf your font, encoding etc. does not support those symbols, set this\\nto false (this will enable ASCII-based replacements).\\n\",\"loc\":[\"programs\",\"khal\",\"locale\",\"unicode_symbols\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.khal.locale.weeknumbers\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"off\\\"\"},\"description\":\"Enable week numbers in calendar and interactive (ikhal) mode.\\nAs those are ISO week numbers, they only work properly if\\n{option}`firstweekday` is set to 0.\\n\",\"loc\":[\"programs\",\"khal\",\"locale\",\"weeknumbers\"],\"readOnly\":false,\"type\":\"one of \\\"off\\\", \\\"left\\\", \\\"right\\\"\"},\"programs.khal.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.khal\"},\"description\":\"The khal package to use.\",\"loc\":[\"programs\",\"khal\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.khal.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khal>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khal\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration options to add to the various sections in the configuration file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  default = {\\n    default_calendar = \\\"Calendar\\\";\\n    timedelta = \\\"5d\\\";\\n  };\\n  view = {\\n    agenda_event_format = \\\"{calendar-color}{cancelled}{start-end-time-style} {title}{repeat-symbol}{reset}\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"khal\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.khard.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khard.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khard.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Khard: an address book for the Unix console.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"khard\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.khard.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khard.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khard.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.khard\"},\"description\":\"The khard package to use.\",\"loc\":[\"programs\",\"khard\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.khard.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khard.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khard.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Khard settings. See\\n<https://khard.readthedocs.io/en/latest/#configuration>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"contact table\\\" = {\\n    display = \\\"formatted_name\\\";\\n    preferred_email_address_type = [\\n      \\\"pref\\\"\\n      \\\"work\\\"\\n      \\\"home\\\"\\n    ];\\n    preferred_phone_number_type = [\\n      \\\"pref\\\"\\n      \\\"cell\\\"\\n      \\\"home\\\"\\n    ];\\n  };\\n  general = {\\n    default_action = \\\"list\\\";\\n    editor = [\\n      \\\"vim\\\"\\n      \\\"-i\\\"\\n      \\\"NONE\\\"\\n    ];\\n  };\\n  vcard = {\\n    private_objects = [\\n      \\\"Jabber\\\"\\n      \\\"Skype\\\"\\n      \\\"Twitter\\\"\\n    ];\\n  };\\n}\"},\"loc\":[\"programs\",\"khard\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of attribute set of (boolean or string or list of string)\"},\"programs.khard.settings.general.default_action\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/khard.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/khard.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"list\\\"\"},\"description\":\"The default action to execute.\",\"loc\":[\"programs\",\"khard\",\"settings\",\"general\",\"default_action\"],\"readOnly\":false,\"type\":\"string\"},\"programs.kickoff.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kickoff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kickoff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable kickoff.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"kickoff\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.kickoff.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/kickoff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/kickoff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.kickoff\"},\"description\":\"The kickoff package to use.\",\"loc\":[\"programs\",\"kickoff\",\"package\"],\"readOnly\":false,\"type\":\"null o