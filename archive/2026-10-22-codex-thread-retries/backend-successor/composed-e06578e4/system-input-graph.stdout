/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9 --build=x86_64-unknown-linux-gnu --host=x86_64-unknown-linux-gnu --disable-dependency-tracking --disable-nls --enable-no-install-program=stdbuf,arch,coreutils,hostname gl_cv_func_getcwd_path_max=\"no, but it is partly working\" gl_cv_have_unlimited_file_name_length=no gl_cv_func_copy_file_range=no gl_cv_onwards_func_copy_file_range=no\n\n# Build\n#\n# Set SUBDIRS=. to avoid cd'ing to gnulib-tests. Those have\n# compilation issues related to pthread and linux/*.h not\n# being available.\nmake -j $NIX_BUILD_CORES AR=\"tcc -ar\" MAKEINFO=\"true\" SUBDIRS=.\n\n# Install\nmake -j $NIX_BUILD_CORES install MAKEINFO=\"true\" SUBDIRS=.\n\n# Remove documentation not needed in the bootstrap chain.\nrm -rf $out/share/info $out/share/man\n","builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","name":"bootstrap-coreutils-musl-9.11","out":"/nix/store/rfv4gzzcgz85wlha9k4s850c9l3k46m2-bootstrap-coreutils-musl-9.11","passAsFile":"buildCommand","pname":"bootstrap-coreutils-musl","system":"x86_64-linux","version":"9.11"},"inputs":{"drvs":{"05z44243pvwk3qrcimv1cf5g3nxi5jjb-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"6f6p45qkd5mhdwvfzgxdydwdpplccvgj-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"8xy9yi1vwp0mc32lz37jgva7hck5j9by-gawk-5.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"a9zsjk7jcksa22bv35f7rhnbkhd71d66-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"aw4a7hi7q0mb2ljazxq0in9f5v4905a5-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"dlh50j2sbcgfdllzb7grqmswrzmazdmj-coreutils-9.11.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"pip5q1b15n46rw6cbmz3jjk8mngqp7aw-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"qcz565439vz47snj3vky7rbdd4ihvxzl-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"rk3s60afwm2lzcsjpsbpdyaa90c21q4z-gnutar-musl-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"xqxb9q4f0izf8