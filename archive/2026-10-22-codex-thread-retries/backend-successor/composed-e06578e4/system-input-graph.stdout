 $perl\nmoveToOutput bin/roff2pdf $perl\nmoveToOutput bin/roff2ps $perl\nmoveToOutput bin/roff2dvi $perl\nmoveToOutput bin/roff2ps $perl\nmoveToOutput bin/roff2html $perl\nmoveToOutput bin/glilypond $perl\nmoveToOutput bin/mmroff $perl\nmoveToOutput bin/roff2x $perl\nmoveToOutput bin/afmtodit $perl\nmoveToOutput bin/gperl $perl\nmoveToOutput bin/chem $perl\nmoveToOutput bin/gpinyin $perl\nmoveToOutput lib/groff/gpinyin $perl\nmoveToOutput bin/grog $perl\nmoveToOutput lib/groff/grog $perl\n\nfind $perl/ -type f -print0 | xargs --null sed -i 's|/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3|/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3|'\n","postPatch":"# POSIX_SHELL_PROG gets replaced with a path to the build bash which doesn't get automatically patched by patchShebangs\nsubstituteInPlace contrib/gdiffmk/gdiffmk.sh \\\n  --replace-fail \"@POSIX_SHELL_PROG@\" \"/bin/sh\"\n","preCheck":"# The neqn-smoke-test fails on nixpkgs because neqn exec's eqn,\n# but eqn, isn't in the PATH in the nixpkgs test env, to remedy\n# that GROFF_BIN_PATH is set as follows:\nexport GROFF_BIN_PATH=.\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/nz9gcn9abrijg1pxv13xflhvpiay31ky-groff-1.24.2.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"1.24.2"},"inputs":{"drvs":{"63zjnxw73yn1avnz9vcsb4hjlsvd0gls-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6g4n5z9fkk1yhavy5la9zp9bk8jfsc2v-groff-1.24.2.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"l225yn472rkgc8370h2z8nrf5x17hdh3-texinfo-7.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"qnl1kmb1fa72iv8s4168g5b2pc75qpm0-autoreconf-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"z2gsgvxwwcd0snpjsl2rpjz3cjq