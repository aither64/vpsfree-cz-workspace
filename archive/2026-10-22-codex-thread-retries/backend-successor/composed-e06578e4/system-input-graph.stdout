ource-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"openssl","__structuredAttrs":"","bin":"/nix/store/ndv550fkbmsfvdxax71d4d5d59x4lq80-openssl-3.6.5-bin","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"shared --libdir=lib --openssldir=etc/ssl enable-ec_nistp_64_gcc_128 enable-ktls","configurePlatforms":"","configureScript":"./Configure linux-x86_64","debug":"/nix/store/7ag2iq9v8ab0gf0lw3jx1say4kgnh48h-openssl-3.6.5-debug","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/7l09089ahshxjx4js3zswqk6azhx6ccq-openssl-3.6.5-dev","doCheck":"1","doInstallCheck":"","doc":"/nix/store/7vhk6c2vg819fl44sj99bp8k3503xy8v-openssl-3.6.5-doc","dontAddStaticConfigureFlags":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","makeFlags":"MANDIR=$(man)/share/man MANSUFFIX=ssl","man":"/nix/store/fnr9mx06brcp7c3dixdn1zr73lf7jgcw-openssl-3.6.5-man","mesonFlags":"","name":"openssl-3.6.5","nativeBuildInputs":"/nix/store/01gh6jng9881dmkwr055p0z3x15jvk8c-make-binary-wrapper-hook /nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3 /nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/kysvfcf8d8v26rr32xfqji8ri2lczlqk-openssl-3.6.5","outputs":"bin dev out man doc debug","patches":"/nix/store/sq4h6bqjx12v9whvm65pjss25hg1538q-nix-ssl-cert-file.patch /nix/store/cklrwbwi889pp2fdsswdjvn12sdy5i5j-openssl-disable-kernel-detection.patch /nix/store/i58agvhx8bmdjlspgkk4m3ylh5348iim-use-etc-ssl-certs.patch","pname":"openssl","postFixup":"# Check to make sure the main output and the static runtime dependencies\n# don't depend on perl\nif grep -r '/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3' $out $etc; then\n  echo \"Found an erroneous dependency on perl ^^^\" >&2\n  exit 1\nfi\n# cleanup cmake helpers for now (for OpenSSL >= 3.3), only rely on pkg-config.\n# pkg-config gets its paths fixed correctly\nrm -rf $dev/lib/cmake\n","postInstall":"# If we're building dynamic libraries, then don't install static\n# libraries.\nif [ -n \"$(echo $out/lib/*.so $out/lib/*.dylib $out/lib/*.dll)\" ]; then\n    rm \"$out/lib/\"*.a\nfi\n\n# 'etc' is a separate output on static builds only.\netc=$out\nmkdir -p $bin\nmv $out/bin $bin/bin\n\n# c_rehash is a legacy perl script with the same functionality\n# as `openssl rehash`\n# this wrapper script is created to maintain backwards compatibility without\n# depending on perl\nmakeWrapper $bin/bin/openssl $bin/bin/c_rehash \\\n  --add-flags \"rehash\"\n\nmkdir $dev\nmv $out/include $dev/\n\n# remove dependency on Perl at runtime\nrm -r $etc/etc/ssl/misc\n\nrmdir $etc/etc/ssl/{certs,private}\n","postPatch":"patchShebangs Configure\nsubstituteInPlace config --replace '/usr/bin/env' '/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/env'\n","preCheck":"patchShebangs util\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","setOutputFlags":"","src":"/nix/store/8zxj0x9qmlm3lnj1rc6j8s3wxbfczs4n-openssl-3.6.5.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"3.6.5"},"inputs":{"drvs":{"00xqad7mnrh1m8k0hzk4slj5jgcsa3is-openssl-3.6.5.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"jzfv1mdbc1gpmmlx04il205rbkww8yjq-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"z2gsgvxw