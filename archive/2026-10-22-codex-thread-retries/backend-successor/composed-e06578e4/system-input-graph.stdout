es.mpdscribble.verbose\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpdscribble.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpdscribble.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"Log level for the mpdscribble daemon.\\n\",\"loc\":[\"services\",\"mpdscribble\",\"verbose\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.mpris-proxy.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpris-proxy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpris-proxy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable a proxy forwarding Bluetooth MIDI controls via MPRIS2 to control media players.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"mpris-proxy\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.mpris-proxy.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/mpris-proxy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/mpris-proxy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.bluez\"},\"description\":\"The bluez package to use.\",\"loc\":[\"services\",\"mpris-proxy\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.muchsync.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.muchsync\"},\"description\":\"The muchsync package to use.\",\"loc\":[\"services\",\"muchsync\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.muchsync.remotes\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Muchsync remotes to synchronise with.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  server = {\\n    frequency = \\\"*:0/10\\\";\\n    remote = {\\n      host = \\\"server.tld\\\";\\n    };\\n  };\\n}\"},\"loc\":[\"services\",\"muchsync\",\"remotes\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"services.muchsync.remotes.<name>.frequency\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"*:0/5\\\"\"},\"description\":\"How often to run {command}`muchsync`. This\\nvalue is passed to the systemd timer configuration as the\\n`OnCalendar` option. See\\n{manpage}`systemd.time(7)`\\nfor more information about the format.\\n\",\"loc\":[\"services\",\"muchsync\",\"remotes\",\"<name>\",\"frequency\"],\"readOnly\":false,\"type\":\"string\"},\"services.muchsync.remotes.<name>.local.checkForModifiedFiles\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Check for locally modified files.\\nWithout this option, muchsync assumes that files in a maildir are\\nnever edited.\\n\\n{option}`checkForModifiedFiles` disables certain\\noptimizations so as to make muchsync at least check the timestamp on\\nevery file, which will detect modified files at the cost of a longer\\nstartup time.\\n\\nThis option is useful if your software regularly modifies the\\ncontents of mail files (e.g., because you are running offlineimap\\nwith \\\"synclabels = yes\\\").\\n\",\"loc\":[\"services\",\"muchsync\",\"remotes\",\"<name>\",\"local\",\"checkForModifiedFiles\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.muchsync.remotes.<name>.local.importNew\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to begin the synchronisation by running\\n{command}`notmuch new` locally.\\n\",\"loc\":[\"services\",\"muchsync\",\"remotes\",\"<name>\",\"local\",\"importNew\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.muchsync.remotes.<name>.remote.checkForModifiedFiles\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Check for modified files on the remote side.\\nWithout this option, muchsync assumes that files in a maildir are\\nnever edited.\\n\\n{option}`checkForModifiedFiles` disables certain\\noptimizations so as to make muchsync at least check the timestamp on\\nevery file, which will detect modified files at the cost of a longer\\nstartup time.\\n\\nThis option is useful if your software regularly modifies the\\ncontents of mail files (e.g., because you are running offlineimap\\nwith \\\"synclabels = yes\\\").\\n\",\"loc\":[\"services\",\"muchsync\",\"remotes\",\"<name>\",\"remote\",\"checkForModifiedFiles\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.muchsync.remotes.<name>.remote.host\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"description\":\"Remote SSH host to synchronize with.\\n\",\"loc\":[\"services\",\"muchsync\",\"remotes\",\"<name>\",\"remote\",\"host\"],\"readOnly\":false,\"type\":\"string\"},\"services.muchsync.remotes.<name>.remote.importNew\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to begin the synchronisation by running\\n{command}`notmuch new` on the remote side.\\n\",\"loc\":[\"services\",\"muchsync\",\"remotes\",\"<name>\",\"remote\",\"importNew\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.muchsync.remotes.<name>.remote.muchsyncPath\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$PATH/muchsync\\\"\"},\"description\":\"Specifies the path to muchsync on the server.\\nOrdinarily, muchsync should be in the default PATH on the server\\nso this option is not required.\\nHowever, this option is useful if you have to install muchsync in\\na non-standard place or wish to test development versions of the\\ncode.\\n\",\"loc\":[\"services\",\"muchsync\",\"remotes\",\"<name>\",\"remote\",\"muchsyncPath\"],\"readOnly\":false,\"type\":\"string\"},\"services.muchsync.remotes.<name>.sshCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ssh -CTaxq\\\"\"},\"description\":\"Specifies a command line to pass to {command}`/bin/sh`\\nto execute a command on another machine.\\n\\nNote that because this string is passed to the shell,\\nspecial characters including spaces may need to be escaped.\\n\",\"loc\":[\"services\",\"muchsync\",\"remotes\",\"<name>\",\"sshCommand\"],\"readOnly\":false,\"type\":\"string\"},\"services.muchsync.remotes.<name>.upload\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/muchsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/muchsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to propagate local changes to the remote.\\n\",\"loc\":[\"services\",\"muchsync\",\"remotes\",\"<name>\",\"upload\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.network-manager-applet.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/network-manager-applet.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/network-manager-applet.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the Network Manager applet (nm-applet).\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"network-manager-applet\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.network-manager-applet.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/network-manager-applet.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/network-manager-applet.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.networkmanagerapplet\"},\"description\":\"The networkmanagerapplet package to use.\",\"loc\":[\"services\",\"network-manager-applet\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.nextcloud-client.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/nextcloud-client.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/nextcloud-client.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Nextcloud Client.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"nextcloud-client\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.nextcloud-client.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/nextcloud-client.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/nextcloud-client.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.nextcloud-client\"},\"description\":\"The nextcloud-client package to use.\",\"loc\":[\"services\",\"nextcloud-client\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.nextcloud-client.startInBackground\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/nextcloud-client.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/nextcloud-client.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to start the Nextcloud client in the background.\",\"loc\":[\"services\",\"nextcloud-client\",\"startInBackground\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.notify-osd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/notify-osd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/notify-osd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable notify-osd.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"notify-osd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.notify-osd.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/notify-osd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/notify-osd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.notify-osd\"},\"description\":\"The notify-osd package to use.\",\"loc\":[\"services\",\"notify-osd\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.ollama.acceleration\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/ollama.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/ollama.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"What interface to use for hardware acceleration.\\n\\n- `null`: default behavior\\n  - if `nixpkgs.config.rocmSupport` is enabled, uses `\\\"rocm\\\"`\\n  - if `nixpkgs.config.cudaSupport` is enabled, uses `\\\"cuda\\\"`\\n  - otherwise defaults to `false`\\n- `false`: disable GPU, only use CPU\\n- `\\\"rocm\\\"`: supported by most modern AMD GPUs\\n  - may require overriding gpu type with `services.ollama.rocmOverrideGfx`\\n    if rocm doesn't detect your AMD gpu\\n- `\\\"cuda\\\"`: supported by most modern NVIDIA GPUs\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"rocm\\\"\"},\"loc\":[\"services\",\"ollama\",\"acceleration\"],\"readOnly\":false,\"type\":\"null or one of false, \\\"rocm\\\", \\\"cuda\\\"\"},\"services.ollama.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/ollama.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/ollama.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable ollama server for local large language models.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"ollama\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.ollama.environmentVariables\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/ollama.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/ollama.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Set arbitrary environment variables for the ollama service.\\n\\nBe aware that these are only seen by the ollama server (systemd service),\\nnot normal invocations like `ollama run`.\\nSince `ollama run` is mostly a shell around the ollama server, this is usually sufficient.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  HIP_VISIBLE_DEVICES = \\\"0,1\\\";\\n  OLLAMA_LLM_LIBRARY = \\\"cpu\\\";\\n}\"},\"loc\":[\"services\",\"ollama\",\"environmentVariables\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"services.ollama.host\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/ollama.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/ollama.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"127.0.0.1\\\"\"},\"description\":\"The host address which the ollama server HTTP interface listens to.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"[::]\\\"\"},\"loc\":[\"services\",\"ollama\",\"host\"],\"readOnly\":false,\"type\":\"string\"},\"services.ollama.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/ollama.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/ollama.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.ollama\"},\"description\":\"The ollama package to use.\",\"loc\":[\"services\",\"ollama\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.ollama.port\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/ollama.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/ollama.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"11434\"},\"description\":\"Which port the ollama server listens to.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"11111\"},\"loc\":[\"services\",\"ollama\",\"port\"],\"readOnly\":false,\"type\":\"16 bit unsigned integer; between 0 and 65535 (both inclusive)\"},\"services.opensnitch-ui.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/opensnitch-ui.n