escription\":\"Which pinentry interface to use. Beware that\\n`pinentry-gnome3` may not work on non-Gnome\\nsystems. You can fix it by adding the following to your\\nsystem configuration:\\n```nix\\nservices.dbus.packages = [ pkgs.gcr ];\\n```\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.pinentry-gnome3\"},\"loc\":[\"programs\",\"rbw\",\"settings\",\"pinentry\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.rclone.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable rclone.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rclone\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rclone.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.rclone\"},\"description\":\"The rclone package to use.\",\"loc\":[\"programs\",\"rclone\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.rclone.remotes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of remote configurations. Each remote consists of regular\\nconfiguration options and optional secrets.\\n\\nSee <https://rclone.org/docs/> for more information on configuring specific\\nremotes.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  b2 = {\\n    config = {\\n      type = \\\"b2\\\";\\n      hard_delete = true;\\n    };\\n    secrets = {\\n      # using sops\\n      account = config.sops.secrets.b2-acc-id.path;\\n      # using agenix\\n      key = config.age.secrets.b2-key.path;\\n    };\\n  };\\n\\n  server.config = {\\n    type = \\\"sftp\\\";\\n    host = \\\"server\\\";\\n    user = \\\"backup\\\";\\n    key_file = \\\"${home.homeDirectory}/.ssh/id_ed25519\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"rclone\",\"remotes\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.rclone.remotes.<name>.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Regular configuration options as described in rclone's documentation\\n<https://rclone.org/docs/>. When specifying options follow the formatting\\nprocess outlined here <https://rclone.org/docs/#config-config-file>, namely:\\n - Remove the leading double-dash (--) from the rclone option name\\n - Replace hyphens (-) with underscores (_)\\n - Convert to lowercase\\n - Use the resulting string as your configuration key\\n\\nFor example, the rclone option \\\"--mega-hard-delete\\\" would use \\\"hard_delete\\\"\\nas the config key.\\n\\nSecurity Note: Always use the {option}`secrets` option for sensitive data\\ninstead of the {option}`config` option to prevent exposing credentials to\\nthe world-readable Nix store.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  type = \\\"mega\\\"; # Required - specifies the remote type\\n  user = \\\"you@example.com\\\";\\n  hard_delete = true;\\n}\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"config\"],\"readOnly\":false,\"type\":\"An attribute set containing a remote type and options.\"},\"programs.rclone.remotes.<name>.mounts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set mapping remote file paths to their corresponding mount\\npoint configurations.\\n\\nFor each entry, to perform the equivalent of\\n`rclone mount remote:path/to/files /path/to/local/mount` — as described in the\\nrclone documentation <https://rclone.org/commands/rclone_mount/> — we create\\na key-value pair like this:\\n`\\\"path/to/files/on/remote\\\" = { ... }`.\\n\\nOn macOS, FUSE mounts additionally require macFUSE\\n(<https://osxfuse.github.io/>) to be installed and its system extension\\napproved. Home Manager does not install macFUSE; rclone will surface\\na runtime error if it is missing.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"path/to/files\\\" = {\\n    enable = true;\\n    mountPoint = \\\"/home/alice/rclone-mount\\\";\\n    options = {\\n      dir-cache-time = \\\"5000h\\\";\\n      poll-interval = \\\"10s\\\";\\n      umask = \\\"002\\\";\\n      user-agent = \\\"Laptop\\\";\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"mounts\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.rclone.remotes.<name>.mounts.<name>.autoMount\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable automatically mounting the remote on login.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"mounts\",\"<name>\",\"autoMount\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rclone.remotes.<name>.mounts.<name>.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable this mount.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"mounts\",\"<name>\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rclone.remotes.<name>.mounts.<name>.logLevel\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the log level. See <https://rclone.org/docs/#logging> for more.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"INFO\\\"\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"mounts\",\"<name>\",\"logLevel\"],\"readOnly\":false,\"type\":\"one of <null>, \\\"ERROR\\\", \\\"NOTICE\\\", \\\"INFO\\\", \\\"DEBUG\\\"\"},\"programs.rclone.remotes.<name>.mounts.<name>.mountPoint\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"A local file path specifying the location of the mount point.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/home/alice/my-remote\\\"\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"mounts\",\"<name>\",\"mountPoint\"],\"readOnly\":false,\"type\":\"string\"},\"programs.rclone.remotes.<name>.mounts.<name>.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of option values passed to the command.\\nTo set a boolean option, assign it `true` or `false`. See\\n<https://nixos.org/manual/nixpkgs/stable/#function-library-lib.cli.toCommandLineShellGNU>\\nfor more details on the format.\\n\\nSome caching options are set by default, namely `vfs-cache-mode = \\\"full\\\"`\\nand `cache-dir`. These can be overridden if desired.\\n\",\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"mounts\",\"<name>\",\"options\"],\"readOnly\":false,\"type\":\"attribute set of (null or boolean or signed integer or floating point number or string)\"},\"programs.rclone.remotes.<name>.secrets\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Sensitive configuration values such as passwords, API keys, and tokens. These\\nmust be provided as file paths to the secrets, which will be read at activation\\ntime.\\n\\nThese values are expanded in a shell context within the rclone-config\\nservice (a systemd user service on Linux, a launchd agent on macOS), so\\nyou can use bash features like command substitution or variable expansion\\n(e.g. \\\"${XDG_RUNTIME_DIR}\\\" on Linux, as used by agenix).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  password = \\\"/run/secrets/password\\\";\\n  api_key = config.age.secrets.api-key.path;\\n}\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"secrets\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.rclone.remotes.<name>.serve\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set mapping remote file paths to their corresponding serve configurations.\\n\\nFor each entry, to perform the equivalent of\\n`rclone serve protocol remote:path/to/files` — as described in the\\nrclone documentation <https://rclone.org/commands/rclone_serve/> — we create\\na key-value pair like this:\\n`\\\"path/to/files/on/remote\\\" = { ... }`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"path/to/files\\\" = {\\n    enable = true;\\n    protocol = \\\"http\\\";\\n    options = {\\n      addr = \\\"127.0.0.1:3000\\\";\\n      dir-cache-time = \\\"5000h\\\";\\n      poll-interval = \\\"10s\\\";\\n      umask = \\\"002\\\";\\n      user-agent = \\\"Laptop\\\";\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"serve\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.rclone.remotes.<name>.serve.<name>.autoStart\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable automatically serving the remote on login.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"serve\",\"<name>\",\"autoStart\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rclone.remotes.<name>.serve.<name>.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable serving this path.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"serve\",\"<name>\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rclone.remotes.<name>.serve.<name>.logLevel\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the log level. See <https://rclone.org/docs/#logging> for more.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"INFO\\\"\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"serve\",\"<name>\",\"logLevel\"],\"readOnly\":false,\"type\":\"one of <null>, \\\"ERROR\\\", \\\"NOTICE\\\", \\\"INFO\\\", \\\"DEBUG\\\"\"},\"programs.rclone.remotes.<name>.serve.<name>.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of option values passed to the command.\\nTo set a boolean option, assign it `true` or `false`. See\\n<https://nixos.org/manual/nixpkgs/stable/#function-library-lib.cli.toCommandLineShellGNU>\\nfor more details on the format.\\n\\nSome caching options are set by default, namely `vfs-cache-mode = \\\"full\\\"`\\nand `cache-dir`. These can be overridden if desired.\\n\",\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"serve\",\"<name>\",\"options\"],\"readOnly\":false,\"type\":\"attribute set of (null or boolean or signed integer or floating point number or string)\"},\"programs.rclone.remotes.<name>.serve.<name>.protocol\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"description\":\"The protocol to use when serving this path.\\nSee <https://rclone.org/commands/rclone_serve> for more.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"http\\\"\"},\"loc\":[\"programs\",\"rclone\",\"remotes\",\"<name>\",\"serve\",\"<name>\",\"protocol\"],\"readOnly\":false,\"type\":\"one of \\\"dlna\\\", \\\"docker\\\", \\\"ftp\\\", \\\"http\\\", \\\"nfs\\\", \\\"restic\\\", \\\"s3\\\", \\\"sftp\\\", \\\"webdav\\\"\"},\"programs.rclone.requiresUnit\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rclone.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rclone.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The name of a systemd user service that must complete before the rclone\\nconfiguration file is written.\\n\\nThis is typically used when secrets are managed by an external provisioner\\nwhose service must run before the secrets are accessible.\\n\\nWhen using sops-nix or agenix, this value is set automatically to\\nsops-nix.service or agenix.service, respectively. Set this manually if you\\nuse a different secret provisioner.\\n\\nRead-only on non-systemd platforms (always null), since this option\\nhas no equivalent ordering primitive outside systemd. On macOS, the\\nconfig-install launchd agent retries on failure (KeepAlive.Crashed),\\nso it will succeed on a subsequent attempt once the secret-provisioner\\nagent has materialized the secret files.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"agenix.service\\\"\"},\"loc\":[\"programs\",\"rclone\",\"requiresUnit\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.readline.bindings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/readline.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/readline.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Readline bindings.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"\\\\\\\\C-h\\\" = \\\"backward-kill-word\\\";\\n}\"},\"loc\":[\"programs\",\"readline\",\"bindings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.readline.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/readline.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/readline.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable readline.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"readline\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.readline.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/readline.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/readline.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Configuration lines appended unchanged to the end of the\\n{file}`~/.inputrc` file.\\n\",\"loc\":[\"programs\",\"readline\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.readline.includeSystemConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/readline.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/readline.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to include the system-wide configuration.\",\"loc\":[\"programs\",\"readline\",\"includeSystemConfig\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.readline.variables\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/readline.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/readline.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Readline customization variable assignments.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  expand-tilde = true;\\n}\"},\"loc\":[\"programs\",\"readline\",\"variables\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean)\"},\"programs.rectangle.defaults\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rectangle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rectangle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Rectangle application defaults. Each attribute name is written as a\\nnative macOS preference key in Rectangle's plist file.\\n\\nWritten to\\n{file}`~/Library/Preferences/com.knollsoft.Rectangle.plist`.\\n\\nSee <https://github.com/rxhanson/Rectangle> for the available\\nsettings and their corresponding preference keys.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  almostMaximizeHeight = 0.9;\\n  almostMaximizeWidth = 0.9;\\n  gapSize = 8.0;\\n  launchOnLogin = true;\\n  windowSnapping = 1;\\n}\"},\"loc\":[\"programs\",\"rectangle\",\"defaults\"],\"readOnly\":false,\"type\":\"attribute set of anything\"},\"programs.rectangle.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rectangle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rectangle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Rectangle window manager.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rectangle\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rectangle.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rectangle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rectangle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.rectangle\"},\"description\":\"The rectangle package to use.\",\"loc\":[\"programs\",\"rectangle\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.rectangle.shortcuts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rectangle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rectangle.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Rectangle keyboard shortcuts. Attribute names are Rectangle action\\nidentifiers (e.g. `leftHalf`, `rightHalf`, `maximize`). Each value\\nspecifies a `keyCode` (macOS virtual key code) and a `modifierFlags`\\nstring naming the modifier combination (e.g. `\\\"ctrl+option+command\\\"`).\\n\\nYou can determine keycodes using an app like: <https://manytricks.com/keycodes/>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  bottomHalf = {\\n    keyCode = 125;\\n    modifierFlags = \\\"ctrl+option+command\\\";\\n  };\\n  center = {\\n    keyCode = 8;\\n    modifierFlags = \\\"ctrl+option+command\\\";\\n  };\\n  leftHalf = {\\n    keyCode = 123;\\n    modifierFlags = \\\"ctrl+option+command\\\";\\n  };\\n  maximize = {\\n    keyCode = 46;\\n    modifierFlags = \\\"ctrl+option+command\\\";\\n  };\\n  rightHalf = {\\n    keyCode = 124;\\n    modifierFlags = \\\"ctrl+option+command\\\";\\n  };\\n  topHalf = {\\n    keyCode = 126;\\n    modifierFlags = \\\"ctrl+option+command\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"rectangle\",\"shortcuts\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.rectangle.shortcuts.<name>.keyCode\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rectangle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rectangle.nix\"}],\"description\":\"macOS virtual key code for this shortcut.\",\"loc\":[\"programs\",\"rectangle\",\"shortcuts\",\"<name>\",\"keyCode\"],\"readOnly\":false,\"type\":\"signed integer\"},\"programs.rectangle.shortcuts.<name>.modifierFlags\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rectangle.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rectangle.nix\"}],\"description\":\"Modifier key combination for this shortcut. One of:\\n- `\\\"shift\\\"` (⇧)\\n- `\\\"ctrl\\\"` (⌃)\\n- `\\\"option\\\"` (⌥)\\n- `\\\"ctrl+option\\\"` (⌃⌥)\\n- `\\\"ctrl+option+shift\\\"` (⌃⌥⇧)\\n- `\\\"command\\\"` (⌘)\\n- `\\\"shift+command\\\"` (⇧⌘)\\n- `\\\"ctrl+option+command\\\"` (⌃⌥⌘)\\n- `\\\"ctrl+option+shift+command\\\"` (⌃⌥⇧⌘)\\n\",\"loc\":[\"programs\",\"rectangle\",\"shortcuts\",\"<name>\",\"modifierFlags\"],\"readOnly\":false,\"type\":\"signed integer or (one of \\\"command\\\", \\\"ctrl\\\", \\\"ctrl+option\\\", \\\"ctrl+option+command\\\", \\\"ctrl+option+shift\\\", \\\"ctrl+option+shift+command\\\", \\\"option\\\", \\\"shift\\\", \\\"shift+command\\\") convertible to it\"},\"programs.retext.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/retext.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/retext.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable retext.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"retext\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.retext.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/retext.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/retext.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.retext\"},\"description\":\"The retext package to use.\",\"loc\":[\"programs\",\"retext\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.retext.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/retext.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/retext.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for retext. All the available options can be found\\nhere: <https://github.com/retext-project/retext/blob/master/configuration.md>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  ColorScheme = {\\n    htmlComments = \\\"#abc\\\";\\n    htmlSymbols = \\\"#ff8800\\\";\\n    htmlTags = \\\"green\\\";\\n  };\\n  General = {\\n    documentStatsEnabled = true;\\n    lineNumbersEnabled = true;\\n    relativeLineNumbers = true;\\n    useWebEngine = true;\\n  };\\n}\"},\"loc\":[\"programs\",\"retext\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.retroarch.cores\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/retroarch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/retroarch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"RetroArch cores to enable. You can provide custom core packages.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  mgba.enable = true;  # Uses pkgs.libretro.mgba\\n  snes9x = {\\n    enable = true;\\n    package = pkgs.libretro.snes9x2010;\\n  };\\n  custom-core = {\\n    enable = true;\\n    package = pkgs.callPackage ./custom-core.nix { };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"retroarch\",\"cores\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.retroarch.cores.<name>.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/retroarch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/retroarch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable RetroArch core.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"retroarch\",\"cores\",\"<name>\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.retroarch.cores.<name>.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/retroarch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/retroarch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.libretro.\\\"‹name›\\\"\"},\"description\":\"The ‹name› package to use.\",\"loc\":[\"programs\",\"retroarch\",\"cores\",\"<name>\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.retroarch.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/retroarch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/retroarch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable RetroArch.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"retroarch\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.retroarch.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/retroarch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/retroarch.nix\"}],\"description\":\"Resulting RetroArch package.\\n\",\"loc\":[\"programs\",\"retroarch\",\"finalPackage\"],\"readOnly\":true,\"type\":\"package\"},\"programs.retroarch.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/retroarch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/retroarch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.retroarch-bare\"},\"description\":\"The retroarch package to use.\",\"loc\":[\"programs\",\"retroarch\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.retroarch.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/retroarch.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/retroarch.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"RetroArch configuration settings.\\n\\nSee <https://github.com/libretro/RetroArch/blob/master/retroarch.cfg>\\nfor available configuration options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  input_max_users = \\\"4\\\";\\n  menu_scale_factor = \\\"0.950000\\\";\\n  netplay_nickname = \\\"username\\\";\\n  video_driver = \\\"vulkan\\\";\\n  video_fullscreen = \\\"true\\\";\\n}\"},\"loc\":[\"programs\",\"retroarch\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.riff.commandLineOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/riff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/riff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Command line arguments to include in the <command>RIFF</command> environment variable.\\n\\nRun <command>riff --help</command> for a full list of options\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--no-adds-only-special\\\"\\n]\"},\"loc\":[\"programs\",\"riff\",\"commandLineOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.riff.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/riff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/riff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Enable the <command>riff</command> diff highlighter.\\nSee <link xlink:href=\\\"https://github.com/walles/riff\\\" />.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"riff\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.riff.enableGitIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/riff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/riff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable git integration for riff.\\n\\nWhen enabled, riff will be configured as git's pager for diff, log, and show commands.\\n\",\"loc\":[\"programs\",\"riff\",\"enableGitIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.riff.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/riff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/riff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.riffdiff\"},\"description\":\"The riffdiff package to use.\",\"loc\":[\"programs\",\"riff\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.rio.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Enable Rio, a terminal built to run everywhere, as a native desktop applications by\\nRust/WebGPU or even in the browsers powered by WebAssembly/WebGPU.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rio\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rio.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.rio\"},\"description\":\"The rio package to use.\",\"loc\":[\"programs\",\"rio\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.rio.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/rio/config.toml`. See\\n<https://raphamorim.io/rio/docs/#configuration-file> for options.\\n\",\"loc\":[\"programs\",\"rio\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.rio.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rio.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rio.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Theme files written to {file}`$XDG_CONFIG_HOME/rio/themes/`. See\\n<https://rioterm.com/docs/config#building-your-own-theme> for\\nsupported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  foobar.colors = {\\n    background = \\\"#282a36\\\";\\n    green = \\\"#50fa7b\\\";\\n    dim-green = \\\"#06572f\\\";\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"rio\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (TOML value or absolute path)\"},\"programs.ripgrep-all.custom_adapters\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Custom adapters that invoke external preprocessing scripts.\\nSee <link xlink:href=\\\"https://github.com/phiresky/ripgrep-all/wiki#custom-adapters\\\"/>.\\n\",\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"programs.ripgrep-all.custom_adapters.*.args\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The output path hint; the placeholders are the same as for rga's `args`\",\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\",\"*\",\"args\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.ripgrep-all.custom_adapters.*.binary\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"description\":\"The path of the binary to run\",\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\",\"*\",\"binary\"],\"readOnly\":false,\"type\":\"absolute path\"},\"programs.ripgrep-all.custom_adapters.*.description\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"description\":\"A description of this adapter; shown in rga's help\",\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\",\"*\",\"description\"],\"readOnly\":false,\"type\":\"string\"},\"programs.ripgrep-all.custom_adapters.*.disabled_by_default\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"If true, the adapter will be disabled by default\",\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\",\"*\",\"disabled_by_default\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.ripgrep-all.custom_adapters.*.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The file extensions this adapter supports\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"pdf\\\"\\n]\"},\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\",\"*\",\"extensions\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.ripgrep-all.custom_adapters.*.match_only_by_mime\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"if --rga-accurate, only match by mime types, ignore extensions completely\",\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\",\"*\",\"match_only_by_mime\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.ripgrep-all.custom_adapters.*.mimetypes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"If not null and --rga-accurate is enabled, mime type matching is used instead of file name matching\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"application/pdf\\\"\\n]\"},\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\",\"*\",\"mimetypes\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"programs.ripgrep-all.custom_adapters.*.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"description\":\"The unique identifier and name of this adapter; must only include a-z, 0-9, _\",\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"programs.ripgrep-all.custom_adapters.*.output_path_hint\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Setting this is useful if the output format is not plain text (.txt) but instead some other format that should be passed to another adapter\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$\\\\${input_virtual_path}.txt.asciipagebreaks\\\"\"},\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\",\"*\",\"output_path_hint\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.ripgrep-all.custom_adapters.*.version\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"The version identifier used to key cache entries; change if the configuration or program changes\",\"loc\":[\"programs\",\"ripgrep-all\",\"custom_adapters\",\"*\",\"version\"],\"readOnly\":false,\"type\":\"signed integer\"},\"programs.ripgrep-all.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable ripgrep-all (rga).\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ripgrep-all\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ripgrep-all.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep-all.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep-all.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.ripgrep-all\"},\"description\":\"The ripgrep-all package to use.\",\"loc\":[\"programs\",\"ripgrep-all\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.ripgrep.arguments\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of arguments to pass to ripgrep. Each item is given to ripgrep as\\na single command line argument verbatim.\\n\\nSee <https://github.com/BurntSushi/ripgrep/blob/master/GUIDE.md#configuration-file>\\nfor an example configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--max-columns-preview\\\"\\n  \\\"--colors=line:style:bold\\\"\\n]\"},\"loc\":[\"programs\",\"ripgrep\",\"arguments\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.ripgrep.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Ripgrep.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ripgrep\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ripgrep.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ripgrep.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ripgrep.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.ripgrep\"},\"description\":\"The ripgrep package to use.\",\"loc\":[\"programs\",\"ripgrep\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.rizin.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rizin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rizin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Rizin.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rizin\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rizin.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rizin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rizin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra run configuration written to {file}`rizinrc`.\\nSee <https://book.rizin.re/src/configuration/initial_scripts.html>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  e asm.bytes=true\\n  e asm.bytes.space=true\\n  b 0x100\\n''\"},\"loc\":[\"programs\",\"rizin\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.rizin.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rizin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rizin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.rizin\"},\"description\":\"The rizin package to use.\",\"loc\":[\"programs\",\"rizin\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.rizin.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rizin.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rizin.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Set of runtime configuration values written to the initial runcommands file.\\nSee <https://book.rizin.re/src/configuration/initial_scripts.html>\\nfor more information and use [](#opt-programs.rizin.extraConfig) to\\nmanually add commands.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"asm.bytes\\\" = true;\\n  \\\"asm.bytes.space\\\" = true;\\n}\"},\"loc\":[\"programs\",\"rizin\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean or floating point number)\"},\"programs.rmpc.config\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rmpc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rmpc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Configuration settings for rmpc in the Rusty Object Notation\\nformat. All available options can be found in the official\\ndocumentation at <https://mierak.github.io/rmpc/next/configuration/>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  (\\n      address: \\\"127.0.0.1:6600\\\",\\n      password: None,\\n      theme: None,\\n      cache_dir: None,\\n      on_song_change: None,\\n      volume_step: 5,\\n      max_fps: 30,\\n      scrolloff: 0,\\n      wrap_navigation: false,\\n      enable_mouse: true,\\n      enable_config_hot_reload: true,\\n      status_update_interval_ms: 1000,\\n      select_current_song_on_change: false,\\n      browser_song_sort: [Disc, Track, Artist, Title],\\n  )\\n''\"},\"loc\":[\"programs\",\"rmpc\",\"config\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.rmpc.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rmpc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rmpc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable rmpc.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rmpc\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rmpc.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rmpc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rmpc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.rmpc\"},\"description\":\"The rmpc package to use.\",\"loc\":[\"programs\",\"rmpc\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.rofi.configPath\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"$XDG_CONFIG_HOME/rofi/config.rasi\\\"\"},\"description\":\"Path where to put generated configuration file.\",\"loc\":[\"programs\",\"rofi\",\"configPath\"],\"readOnly\":false,\"type\":\"non-empty string\"},\"programs.rofi.cycle\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to cycle through the results list.\",\"loc\":[\"programs\",\"rofi\",\"cycle\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.rofi.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Rofi: A window switcher, application launcher and dmenu replacement.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"rofi\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.rofi.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/rofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/rofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Additional configuration to add.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  kb-primary-paste = \\\"Control+V,Shift+Insert\\\";\\n  kb-secondary-paste = \\\"Control+v,Insert\\\";\\n  \\\"run,drun\\\" = {\\n    display-name = \\\"open:\\\";\\n  };\\n}\"},\"loc\":[\