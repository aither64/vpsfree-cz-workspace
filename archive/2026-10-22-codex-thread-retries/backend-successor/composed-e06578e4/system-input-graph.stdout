\"text\":\"\\\"\\\"\"},\"description\":\"Configuration file to be written to theme.scss for setting\\nOnagre's theme. The documentation can be found here:\\n<https://github.com/onagre-launcher/onagre/wiki/Theming>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  .onagre {\\n    --exit-unfocused: false;\\n    height: 250px;\\n    width: 400px;\\n    --font-family: \\\"Iosevka,Iosevka Nerd Font\\\";\\n    font-size: 18px;\\n    background: #151515;\\n    color: #414141;\\n    padding: 10px;\\n  \\n    .container {\\n      .rows {\\n        --height: fill-portion 6;\\n        .row-selected {\\n          color: #ffffff;\\n          --spacing: 3px;\\n        }\\n      }\\n  \\n      .scrollable {\\n        background: #151515;\\n        width: 0;\\n        .scroller {\\n          width: 0;\\n          color: #151515;\\n        }\\n      }\\n    }\\n  }\\n''\"},\"loc\":[\"programs\",\"onagre\",\"style\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.onedrive.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/onedrive.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/onedrive.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable onedrive.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"onedrive\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.onedrive.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/onedrive.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/onedrive.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.onedrive\"},\"description\":\"The onedrive package to use.\",\"loc\":[\"programs\",\"onedrive\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.onedrive.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/onedrive.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/onedrive.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for Onedrive. All available options can be\\nfound at <https://github.com/abraunegg/onedrive/blob/master/config>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  {\\n    check_nomount = \\\"false\\\";\\n    check_nosync = \\\"false\\\";\\n    classify_as_big_delete = \\\"1000\\\";\\n    cleanup_local_files = \\\"false\\\";\\n    disable_notifications = \\\"false\\\";\\n    no_remote_delete = \\\"false\\\";\\n    rate_limit = \\\"0\\\";\\n    resync = \\\"false\\\";\\n    skip_dotfiles = \\\"false\\\";\\n  }\\n''\"},\"loc\":[\"programs\",\"onedrive\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.onlyoffice.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/onlyoffice.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/onlyoffice.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable onlyoffice.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"onlyoffice\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.onlyoffice.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/onlyoffice.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/onlyoffice.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.onlyoffice-desktopeditors\"},\"description\":\"The onlyoffice-desktopeditors package to use.\",\"loc\":[\"programs\",\"onlyoffice\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.onlyoffice.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/onlyoffice.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/onlyoffice.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration settings for Onlyoffice.\\n\\nAll configurable options can be deduced by enabling them through the\\nGUI and observing the changes in ~/.config/onlyoffice/DesktopEditors.conf.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  UITheme = \\\"theme-contrast-dark\\\";\\n  editorWindowMode = false;\\n  forcedRtl = false;\\n  maximized = true;\\n  titlebar = \\\"custom\\\";\\n}\"},\"loc\":[\"programs\",\"onlyoffice\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (atom (null, bool, int, float or string))\"},\"programs.opam.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opam.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opam.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Opam.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"opam\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.opam.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opam.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opam.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"opam\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.opam.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opam.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opam.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"opam\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.opam.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opam.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opam.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"opam\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.opam.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opam.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opam.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.opam\"},\"description\":\"The opam package to use.\",\"loc\":[\"programs\",\"opam\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.opencode.agents\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom agents for opencode.\\n\\nThis option can either be:\\n- An attribute set defining agents\\n- A path to a directory containing multiple agent files\\n\\nIf an attribute set is used, the attribute name becomes the agent filename,\\nand the value is either:\\n- Inline content as a string (creates `opencode/agents/<name>.md`)\\n- A path to a file (creates `opencode/agents/<name>.md`)\\n\\nIf a path is used, it is expected to contain agent files.\\nThe directory is symlinked to {file}`$XDG_CONFIG_HOME/opencode/agents/`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  code-reviewer = ''\\n    # Code Reviewer Agent\\n\\n    You are a senior software engineer specializing in code reviews.\\n    Focus on code quality, security, and maintainability.\\n\\n    ## Guidelines\\n    - Review for potential bugs and edge cases\\n    - Check for security vulnerabilities\\n    - Ensure code follows best practices\\n    - Suggest improvements for readability and performance\\n  '';\\n  documentation = ./agents/documentation.md;\\n}\\n\"},\"loc\":[\"programs\",\"opencode\",\"agents\"],\"readOnly\":false,\"type\":\"(attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)) or absolute path\"},\"programs.opencode.commands\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom commands for opencode.\\n\\nThis option can either be:\\n- An attribute set defining commands\\n- A path to a directory containing multiple command files\\n\\nIf an attribute set is used, the attribute name becomes the command filename,\\nand the value is either:\\n- Inline content as a string (creates `opencode/commands/<name>.md`)\\n- A path to a file (creates `opencode/commands/<name>.md`)\\n\\nIf a path is used, it is expected to contain command files.\\nThe directory is symlinked to {file}`$XDG_CONFIG_HOME/opencode/commands/`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  changelog = ''\\n    # Update Changelog Command\\n\\n    Update CHANGELOG.md with a new entry for the specified version.\\n    Usage: /changelog [version] [change-type] [message]\\n  '';\\n  fix-issue = ./commands/fix-issue.md;\\n  commit = ''\\n    # Commit Command\\n\\n    Create a git commit with proper message formatting.\\n    Usage: /commit [message]\\n  '';\\n}\\n\"},\"loc\":[\"programs\",\"opencode\",\"commands\"],\"readOnly\":false,\"type\":\"(attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)) or absolute path\"},\"programs.opencode.context\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Global context for OpenCode.\\n\\nThe value is either:\\n- Inline content as a string\\n- A path to a file containing the content\\n\\nThe configured content is written to\\n{file}`$XDG_CONFIG_HOME/opencode/AGENTS.md`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  # TypeScript Project Rules\\n\\n  ## External File Loading\\n\\n  CRITICAL: When you encounter a file reference (e.g., @rules/general.md), use your Read tool to load it on a need-to-know basis. They're relevant to the SPECIFIC task at hand.\\n\\n  Instructions:\\n\\n  - Do NOT preemptively load all references - use lazy loading based on actual need\\n  - When loaded, treat content as mandatory instructions that override defaults\\n  - Follow references recursively when needed\\n\\n  ## Development Guidelines\\n\\n  For TypeScript code style and best practices: @docs/typescript-guidelines.md\\n  For React component architecture and hooks patterns: @docs/react-patterns.md\\n  For REST API design and error handling: @docs/api-standards.md\\n  For testing strategies and coverage requirements: @test/testing-guidelines.md\\n\\n  ## General Guidelines\\n\\n  Read the following file immediately as it's relevant to all workflows: @rules/general-guidelines.md.\\n''\\n\"},\"loc\":[\"programs\",\"opencode\",\"context\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\" or absolute path\"},\"programs.opencode.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable opencode.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"opencode\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.opencode.enableMcpIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to integrate the MCP servers config from\\n{option}`programs.mcp.servers` into\\n{option}`programs.opencode.settings.mcp`.\\n\\nNote: Settings defined in {option}`programs.mcp.servers` are merged\\nwith {option}`programs.opencode.settings.mcp`, with OpenCode settings\\ntaking precedence.\\n\",\"loc\":[\"programs\",\"opencode\",\"enableMcpIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.opencode.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra packages available to OpenCode.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.uv ]\"},\"loc\":[\"programs\",\"opencode\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.opencode.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.opencode\"},\"description\":\"The opencode package to use.\",\"loc\":[\"programs\",\"opencode\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.opencode.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/opencode/opencode.json`.\\nSee <https://opencode.ai/docs/config/> for the documentation.\\n\\nNote, `\\\"$schema\\\": \\\"https://opencode.ai/config.json\\\"` is automatically added to the configuration.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  autoshare = false;\\n  autoupdate = true;\\n  model = \\\"anthropic/claude-sonnet-4-20250514\\\";\\n}\"},\"loc\":[\"programs\",\"opencode\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.opencode.skills\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom skills for OpenCode.\\n\\nThis option can be either:\\n- An attribute set defining skills\\n- A path to a directory containing skill folders\\n\\nIf an attribute set is used, the attribute name becomes the\\nskill directory name, and the value is either:\\n- Inline content as a string (creates `opencode/skills/<name>/SKILL.md`)\\n- A path to a file (creates `opencode/skills/<name>/SKILL.md`)\\n- A path to a directory (creates `opencode/skills/<name>/` with all files)\\n\\nThis also accepts Nix store paths, for example a skill directory\\nfrom a package.\\n\\nIf a path is used, it is expected to contain one folder per\\nskill name, each containing a {file}`SKILL.md`. The directory is\\nsymlinked to {file}`$XDG_CONFIG_HOME/opencode/skills/`.\\n\\nSee <https://opencode.ai/docs/skills/> for the documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  git-release = ''\\n    ---\\n    name: git-release\\n    description: Create consistent releases and changelogs\\n    ---\\n\\n    ## What I do\\n\\n    - Draft release notes from merged PRs\\n    - Propose a version bump\\n    - Provide a copy-pasteable `gh release create` command\\n  '';\\n\\n  # A skill can also be a directory containing SKILL.md and other files.\\n  data-analysis = ./skills/data-analysis;\\n\\n  # A skill can also be a subdirectory within a package source (store path)\\n  beads = \\\"${pkgs.beads.src}/claude-plugin/skills/beads\\\";\\n}\\n\"},\"loc\":[\"programs\",\"opencode\",\"skills\"],\"readOnly\":false,\"type\":\"(attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path or string)) or absolute path\"},\"programs.opencode.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom themes for opencode.\\n\\nThis option can either be:\\n- An attribute set defining themes\\n- A path to a directory containing multiple theme files\\n\\nIf an attribute set is used, the attribute name becomes the theme filename,\\nand the value is either:\\n- An attribute set that is converted to a JSON file (creates `opencode/themes/<name>.json`)\\n- A path to a file (creates `opencode/themes/<name>.json`)\\n\\nIf a path is used, it is expected to contain theme files.\\nThe directory is symlinked to {file}`$XDG_CONFIG_HOME/opencode/themes/`.\\n\\nSet `programs.opencode.tui.theme` to enable the custom theme.\\nSee <https://opencode.ai/docs/themes/> for the documentation.\\n\",\"loc\":[\"programs\",\"opencode\",\"themes\"],\"readOnly\":false,\"type\":\"(attribute set of (JSON value or absolute path)) or absolute path\"},\"programs.opencode.tools\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom tools for opencode.\\n\\nThis option can either be:\\n- An attribute set defining tools\\n- A path to a directory containing multiple tool files\\n\\nIf an attribute set is used, the attribute name becomes the tool filename,\\nand the value is either:\\n- Inline content as a string (creates `opencode/tools/<name>.ts`)\\n- A path to a file (creates `opencode/tools/<name>.ts` or `opencode/tools/<name>.js`)\\n\\nIf a path is used, it is expected to contain tool files.\\nThe directory is symlinked to {file}`$XDG_CONFIG_HOME/opencode/tools/`.\\n\\nSee <https://opencode.ai/docs/tools/> for the documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  database-query = ''\\n    import { tool } from \\\"@opencode-ai/plugin\\\"\\n\\n    export default tool({\\n      description: \\\"Query the project database\\\",\\n      args: {\\n        query: tool.schema.string().describe(\\\"SQL query to execute\\\"),\\n      },\\n      async execute(args) {\\n        // Your database logic here\\n        return `Executed query: ${args.query}`\\n      },\\n    })\\n  '';\\n\\n  # Or reference an existing file\\n  api-client = ./tools/api-client.ts;\\n}\\n\"},\"loc\":[\"programs\",\"opencode\",\"tools\"],\"readOnly\":false,\"type\":\"(attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)) or absolute path\"},\"programs.opencode.tui\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"TUI-specific configuration written to {file}`$XDG_CONFIG_HOME/opencode/tui.json`.\\n\\nThis includes theme, keybinds, scroll settings, and other TUI-only options.\\nSee <https://opencode.ai/docs/tui#configure> for the documentation.\\n\\nNote that `\\\"$schema\\\": \\\"https://opencode.ai/tui.json\\\"` is automatically added.\\n\\nSince OpenCode v1.2.15, TUI settings must be in a separate tui.json file.\\nSettings like `theme`, `keybinds`, and `tui` in {option}`programs.opencode.settings`\\nare deprecated and should be moved here.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  keybinds = {\\n    leader = \\\"alt+b\\\";\\n  };\\n  theme = \\\"system\\\";\\n}\"},\"loc\":[\"programs\",\"opencode\",\"tui\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.opencode.web.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable opencode web service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"opencode\",\"web\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.opencode.web.environmentFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Path to a file containing environment variables for the opencode web\\nservice, in the format of an EnvironmentFile as described by\\n{manpage}`systemd.exec(5)` (i.e. `KEY=VALUE` pairs, one per line).\\n\\nThis is the recommended way to set `OPENCODE_SERVER_PASSWORD` without\\nexposing the secret value in the Nix store.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/run/secrets/opencode-web\\\"\"},\"loc\":[\"programs\",\"opencode\",\"web\",\"environmentFile\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"programs.opencode.web.extraArgs\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/opencode.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/opencode.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra arguments to pass to the opencode serve command.\\n\\nThese arguments override the \\\"server\\\" options defined in the configuration file.\\nSee <https://opencode.ai/docs/web/#config-file> for available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--hostname\\\"\\n  \\\"0.0.0.0\\\"\\n  \\\"--port\\\"\\n  \\\"4096\\\"\\n  \\\"--mdns\\\"\\n  \\\"--cors\\\"\\n  \\\"https://example.com\\\"\\n  \\\"--cors\\\"\\n  \\\"http://localhost:3000\\\"\\n  \\\"--print-logs\\\"\\n  \\\"--log-level\\\"\\n  \\\"DEBUG\\\"\\n]\"},\"loc\":[\"programs\",\"opencode\",\"web\",\"extraArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.openstackclient.clouds\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/openstackclient.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/openstackclient.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration needed to connect to one or more clouds.\\n\\nDo not include passwords here as they will be publicly readable in the Nix store.\\nConfiguration written to {file}`$XDG_CONFIG_HOME/openstack/clouds.yaml`.\\nSee <https://docs.openstack.org/python-openstackclient/latest/configuration/index.html#clouds-yaml>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  my-infra = {\\n    auth = {\\n      project_id = \\\"0123456789abcdef0123456789abcdef\\\";\\n      username = \\\"openstack\\\";\\n    };\\n    cloud = \\\"example-cloud\\\";\\n    interface = \\\"internal\\\";\\n    region_name = \\\"XXX\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"openstackclient\",\"clouds\"],\"readOnly\":false,\"type\":\"open submodule of (YAML 1.1 value)\"},\"programs.openstackclient.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/openstackclient.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/openstackclient.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable OpenStack command-line client.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"openstackclient\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.openstackclient.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/openstackclient.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/openstackclient.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.openstackclient\"},\"description\":\"The openstackclient package to use.\",\"loc\":[\"programs\",\"openstackclient\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.openstackclient.publicClouds\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/openstackclient.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/openstackclient.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Public information about clouds.\\n\\nConfiguration written to {file}`$XDG_CONFIG_HOME/openstack/clouds-public.yaml`.\\nSee <https://docs.openstack.org/python-openstackclient/latest/configuration/index.html#clouds-public-yaml>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  example-cloud = {\\n    auth = {\\n      auth_url = \\\"https://identity.cloud.example.com/v2.0\\\";\\n    };\\n  };\\n};\\n\"},\"loc\":[\"programs\",\"openstackclient\",\"publicClouds\"],\"readOnly\":false,\"type\":\"open submodule of (YAML 1.1 value)\"},\"programs.opkssh.enable\":{\"declarations\":[{\"name\":\"<