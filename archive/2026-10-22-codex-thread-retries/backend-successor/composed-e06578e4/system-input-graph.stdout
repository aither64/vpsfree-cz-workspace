ct\\nconfiguration format.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  myproject = {\\n    root = \\\"~/code/myproject\\\";\\n    windows = [\\n      {\\n        editor = {\\n          layout = \\\"main-vertical\\\";\\n          panes = [\\n            {\\n              editor = [\\n                \\\"vim\\\"\\n              ];\\n            }\\n            \\\"guard\\\"\\n          ];\\n        };\\n      }\\n      {\\n        server = \\\"bundle exec rails s\\\";\\n      }\\n      {\\n        logs = \\\"tail -f log/development.log\\\";\\n      }\\n    ];\\n  };\\n}\"},\"loc\":[\"programs\",\"tmux\",\"tmuxinator\",\"projects\"],\"readOnly\":false,\"type\":\"attribute set of (YAML 1.1 value)\"},\"programs.tmux.tmuxp.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tmux.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tmux.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable tmuxp.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"tmux\",\"tmuxp\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.todoman.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/todoman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/todoman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable todoman.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"todoman\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.todoman.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/todoman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/todoman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Text for configuration of todoman.\\nThe syntax is Python.\\n\\nSee [docs](`https://todoman.readthedocs.io/en/stable/man.html#id5`).\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  date_format = \\\"%Y-%m-%d\\\";\\n  time_format = \\\"%H:%M\\\";\\n  default_list = \\\"Personal\\\";\\n  default_due = 48;\\n''\"},\"loc\":[\"programs\",\"todoman\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.todoman.glob\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/todoman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/todoman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"*\\\"\"},\"description\":\"The glob expansion which matches all directories relevant.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"*/*\\\"\"},\"loc\":[\"programs\",\"todoman\",\"glob\"],\"readOnly\":false,\"type\":\"string\"},\"programs.todoman.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/todoman.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/todoman.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.todoman\"},\"description\":\"The todoman package to use.\",\"loc\":[\"programs\",\"todoman\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.tofi.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Tofi, a tiny dynamic menu for Wayland.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"tofi\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.tofi.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.tofi\"},\"description\":\"The tofi package to use.\",\"loc\":[\"programs\",\"tofi\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.tofi.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tofi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tofi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings to be written to the Tofi configuration file.\\n\\nSee <https://github.com/philj56/tofi/blob/master/doc/config>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  background-color = \\\"#000000\\\";\\n  border-width = 0;\\n  font = \\\"monospace\\\";\\n  height = \\\"100%\\\";\\n  num-results = 5;\\n  outline-width = 0;\\n  padding-left = \\\"35%\\\";\\n  padding-top = \\\"35%\\\";\\n  result-spacing = 25;\\n  width = \\\"100%\\\";\\n}\\n\"},\"loc\":[\"programs\",\"tofi\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (string or signed integer or boolean)\"},\"programs.topgrade.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/topgrade.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/topgrade.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable topgrade.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"topgrade\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.topgrade.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/topgrade.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/topgrade.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.topgrade\"},\"description\":\"The topgrade package to use.\",\"loc\":[\"programs\",\"topgrade\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.topgrade.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/topgrade.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/topgrade.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/topgrade.toml`.\\n\\nSee <https://github.com/r-darwish/topgrade/wiki/Step-list> for the full list\\nof options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  commands = {\\n    \\\"Run garbage collection on Nix store\\\" = \\\"nix-collect-garbage\\\";\\n  };\\n  misc = {\\n    assume_yes = true;\\n    cleanup = true;\\n    disable = [\\n      \\\"flutter\\\"\\n      \\\"node\\\"\\n    ];\\n    set_title = false;\\n  };\\n}\"},\"loc\":[\"programs\",\"topgrade\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"programs.translate-shell.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/translate-shell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/translate-shell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable translate-shell.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"translate-shell\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.translate-shell.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/translate-shell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/translate-shell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.translate-shell\"},\"description\":\"The translate-shell package to use.\",\"loc\":[\"programs\",\"translate-shell\",\"package\"],\