\",\"fzf\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.fzf.fileWidgetCommand\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fzf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fzf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The command that gets executed as the source for fzf for the\\nCTRL-T keybinding.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"fd --type f\\\"\"},\"loc\":[\"programs\",\"fzf\",\"fileWidgetCommand\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.fzf.fileWidgetOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fzf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fzf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Command line options for the CTRL-T keybinding.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--preview 'head {}'\\\"\\n]\"},\"loc\":[\"programs\",\"fzf\",\"fileWidgetOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.fzf.historyWidgetOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fzf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fzf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Command line options for the CTRL-R keybinding.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--sort\\\"\\n  \\\"--exact\\\"\\n]\"},\"loc\":[\"programs\",\"fzf\",\"historyWidgetOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.fzf.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fzf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fzf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.fzf\"},\"description\":\"The fzf package to use.\",\"loc\":[\"programs\",\"fzf\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.fzf.tmux.enableShellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fzf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fzf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable setting `FZF_TMUX=1` which causes shell integration to use fzf-tmux\\n.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"fzf\",\"tmux\",\"enableShellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.fzf.tmux.shellIntegrationOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/fzf.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/fzf.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"If {option}`programs.fzf.tmux.enableShellIntegration` is set to `true`,\\nshell integration will use these options for fzf-tmux.\\nSee {command}`fzf-tmux --help` for available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"-d 40%\\\"\\n]\"},\"loc\":[\"programs\",\"fzf\",\"tmux\",\"shellIntegrationOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.gallery-dl.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gallery-dl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gallery-dl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable gallery-dl.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gallery-dl\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gallery-dl.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gallery-dl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gallery-dl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gallery-dl\"},\"description\":\"The gallery-dl package to use.\",\"loc\":[\"programs\",\"gallery-dl\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.gallery-dl.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gallery-dl.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gallery-dl.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/gallery-dl/config.json`. See\\n<https://github.com/mikf/gallery-dl#configuration>\\nfor supported values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  extractor = {\\n    base-directory = \\\"~/Downloads\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"gallery-dl\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.gcc.colors\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gcc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gcc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings for {env}`GCC_COLORS`\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  error = \\\"01;31\\\";\\n}\"},\"loc\":[\"programs\",\"gcc\",\"colors\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.gcc.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gcc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gcc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable {command}`gcc`..\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gcc\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gcc.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gcc.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gcc.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gcc\"},\"description\":\"The gcc package to use.\",\"loc\":[\"programs\",\"gcc\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.gemini-cli.commands\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of custom commands that will be globally available.\\nThe name of the attribute set will be the name of each command.\\nYou may use subdirectories to create namespaced commands, such as `git/fix` becoming `/git:fix`.\\nSee https://github.com/google-gemini/gemini-cli/blob/main/docs/cli/commands.md#custom-commands for more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"changelog = {\\n  prompt =\\n    ''\\n    Your task is to parse the `<version>`, `<change_type>`, and `<message>` from their input and use the `write_file` tool to correctly update the `CHANGELOG.md` file.\\n    '';\\n  description = \\\"Adds a new entry to the project's CHANGELOG.md file.\\\";\\n};\\n\\\"git/fix\\\" = { # Becomes /git:fix\\n  prompt = \\\"Please analyze the staged git changes and provide a code fix for the issue described here: {{args}}.\\\";\\n  description = \\\"Generates a fix for a given GitHub issue.\\\";\\n};\\n\"},\"loc\":[\"programs\",\"gemini-cli\",\"commands\"],\"readOnly\":false,\"type\":\"attribute set of (open submodule of string)\"},\"programs.gemini-cli.commands.<name>.description\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"description\":\"A brief, one-line description of what the command does.\\nThis text will be displayed next to your command in the /help menu.\\nIf you omit this field, a generic description will be generated from the filename.\\n\",\"loc\":[\"programs\",\"gemini-cli\",\"commands\",\"<name>\",\"description\"],\"readOnly\":false,\"type\":\"string\"},\"programs.gemini-cli.commands.<name>.prompt\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"description\":\"The prompt that will be sent to the Gemini model when the command is executed.\\nThis can be a single-line or multi-line string.\\nThe special placeholder {{args}} will be replaced with the text the user typed after the command name.\\n\",\"loc\":[\"programs\",\"gemini-cli\",\"commands\",\"<name>\",\"prompt\"],\"readOnly\":false,\"type\":\"string\"},\"programs.gemini-cli.context\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Global context(s) for gemini-cli.\\n\\nThe attribute name becomes the filename, with a {file}`.md`\\nextension added automatically. Each value is either:\\n- Inline content as a string\\n- A path to a file containing the content\\n\\nThe configured files are written to {file}`~/.gemini/`.\\n\\nNote: You can customize which context file names gemini-cli looks for by setting\\n`settings.context.fileName`. For example:\\n```nix\\nsettings = {\\n  context.fileName = [\\\"AGENTS.md\\\", \\\"CONTEXT.md\\\", \\\"GEMINI.md\\\"];\\n};\\n```\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  GEMINI = ''\\n    # Global Context\\n\\n    You are a helpful AI assistant for software development.\\n\\n    ## Coding Standards\\n\\n    - Follow consistent code style\\n    - Write clear comments\\n    - Test your changes\\n  '';\\n\\n  AGENTS = ./path/to/agents.md;\\n\\n  CONTEXT = ''\\n    Additional context instructions here.\\n  '';\\n}\\n\"},\"loc\":[\"programs\",\"gemini-cli\",\"context\"],\"readOnly\":false,\"type\":\"attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)\"},\"programs.gemini-cli.defaultModel\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The default model to use for the CLI.\\nWill be set as $GEMINI_MODEL when configured.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"gemini-2.5-flash\\\"\"},\"loc\":[\"programs\",\"gemini-cli\",\"defaultModel\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.gemini-cli.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable gemini-cli.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gemini-cli\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gemini-cli.enableMcpIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to integrate the MCP servers config from\\n{option}`programs.mcp.servers` into\\n{option}`programs.gemini-cli.settings.mcpServers`.\\n\\nNote: Any servers already present in\\n{option}`programs.gemini-cli.settings.mcpServers`\\nis not overridden by servers present under the same\\nname in {option}`programs.mcp.servers`\\n\",\"loc\":[\"programs\",\"gemini-cli\",\"enableMcpIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gemini-cli.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gemini-cli\"},\"description\":\"The gemini-cli package to use.\",\"loc\":[\"programs\",\"gemini-cli\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.gemini-cli.policies\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of policy definitions to create in `~/.gemini/policies/`.\\nThe attribute name becomes the filename with `.toml` extension automatically added.\\nThe value can be either an attribute set representing the TOML policy or a path to a TOML file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"my-rules\\\" = {\\n    rule = [\\n      {\\n        toolName = \\\"run_shell_command\\\";\\n        commandPrefix = \\\"git \\\";\\n        decision = \\\"ask_user\\\";\\n        priority = 100;\\n      }\\n    ];\\n  };\\n  \\\"other-rules\\\" = ./path/to/rules.toml;\\n}\\n\"},\"loc\":[\"programs\",\"gemini-cli\",\"policies\"],\"readOnly\":false,\"type\":\"attribute set of (absolute path or TOML value)\"},\"programs.gemini-cli.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"JSON config for gemini-cli\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  context = {\\n    loadMemoryFromIncludeDirectories = true;\\n  };\\n  general = {\\n    preferredEditor = \\\"nvim\\\";\\n    previewFeatures = true;\\n    vimMode = true;\\n  };\\n  ide = {\\n    enabled = true;\\n  };\\n  privacy = {\\n    usageStatisticsEnabled = false;\\n  };\\n  security = {\\n    auth = {\\n      selectedType = \\\"oauth-personal\\\";\\n    };\\n  };\\n  tools = {\\n    autoAccept = false;\\n  };\\n  ui = {\\n    theme = \\\"Default\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"gemini-cli\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.gemini-cli.skills\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gemini-cli.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gemini-cli.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Custom skills for gemini-cli.\\n\\nThis option can be either:\\n- An attribute set defining skills\\n- A path to a directory containing skill folders\\n\\nIf an attribute set is used, the attribute name becomes the\\nskill directory name, and the value is either:\\n- Inline content as a string (creates `~/.gemini/skills/<name>/SKILL.md`)\\n- A path to a file (creates `~/.gemini/skills/<name>/SKILL.md`)\\n- A path to a directory (symlinks `~/.gemini/skills/<name>/` to that directory)\\n\\nIf a path is used, it is expected to contain one folder per\\nskill name, each containing a {file}`SKILL.md`. The directory is\\nsymlinked to {file}`~/.gemini/skills/`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  xlsx = ./skills/xlsx/SKILL.md;\\n  data-analysis = ./skills/data-analysis;\\n  pdf-processing = ''\\n    ---\\n    name: pdf-processing\\n    description: Extract text and tables from PDF files, fill forms, merge documents. Use when working with PDF files or when the user mentions PDFs, forms, or document extraction.\\n    ---\\n\\n    # PDF Processing\\n\\n    ## Quick start\\n\\n    Use pdfplumber to extract text from PDFs:\\n\\n    ```python\\n    import pdfplumber\\n\\n    with pdfplumber.open(\\\"document.pdf\\\") as pdf:\\n        text = pdf.pages[0].extract_text()\\n    ```\\n  '';\\n}\\n\"},\"loc\":[\"programs\",\"gemini-cli\",\"skills\"],\"readOnly\":false,\"type\":\"(attribute set of (strings concatenated with \\\"\\\\n\\\" or absolute path)) or absolute path\"},\"programs.gh-dash.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh-dash.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh-dash.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable GitHub CLI dashboard plugin.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gh-dash\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gh-dash.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh-dash.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh-dash.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gh-dash\"},\"description\":\"The gh-dash package to use.\",\"loc\":[\"programs\",\"gh-dash\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.gh-dash.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh-dash.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh-dash.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/gh-dash/config.yml`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  prSections = [\\n    {\\n      filters = \\\"is:open author:@me\\\";\\n      title = \\\"My Pull Requests\\\";\\n    }\\n  ];\\n}\"},\"loc\":[\"programs\",\"gh-dash\",\"settings\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.gh.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable GitHub CLI tool.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gh\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gh.extensions\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"gh extensions, see <https://cli.github.com/manual/gh_extension>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.gh-eco ]\"},\"loc\":[\"programs\",\"gh\",\"extensions\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.gh.gitCredentialHelper.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable the gh git credential helper.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"gh\",\"gitCredentialHelper\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.gh.gitCredentialHelper.hosts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"https://github.com\\\"\\n  \\\"https://gist.github.com\\\"\\n]\"},\"description\":\"GitHub hosts to enable the gh git credential helper for\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ \\\"https://github.com\\\" \\\"https://github.example.com\\\" ]\\n\"},\"loc\":[\"programs\",\"gh\",\"gitCredentialHelper\",\"hosts\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.gh.hosts\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Host-specific configuration written to {file}`$XDG_CONFIG_HOME/gh/hosts.yml`.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"github.com\\\" = {\\n    user = \\\"<your_username>\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"gh\",\"hosts\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.gh.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.gh\"},\"description\":\"The gh package to use.\",\"loc\":[\"programs\",\"gh\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.gh.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/gh/config.yml`.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  git_protocol = \\\"ssh\\\";\\n\\n  prompt = \\\"enabled\\\";\\n\\n  aliases = {\\n    co = \\\"pr checkout\\\";\\n    pv = \\\"pr view\\\";\\n  };\\n};\\n\"},\"loc\":[\"programs\",\"gh\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of (YAML 1.1 value)\"},\"programs.gh.settings.aliases\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Aliases that allow you to create nicknames for gh commands.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  co = \\\"pr checkout\\\";\\n  pv = \\\"pr view\\\";\\n}\"},\"loc\":[\"programs\",\"gh\",\"settings\",\"aliases\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.gh.settings.editor\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"The editor that gh should run when creating issues, pull requests, etc.\\nIf blank, will refer to environment.\\n\",\"loc\":[\"programs\",\"gh\",\"settings\",\"editor\"],\"readOnly\":false,\"type\":\"string\"},\"programs.gh.settings.git_protocol\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/gh.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/gh.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"https\\\"\"},\"description\":\"The protocol to use when performing Git operations.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"ssh\\\"\"},\"loc\":[\"programs\",\"gh\",\"settings\",\"git_protocol\"],\"readOnly\":false,\"type\":\"string\"},\"programs.ghostty.clearDefaultKeybinds\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ghostty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ghostty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to clear default keybinds.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ghostty\",\"clearDefaultKeybinds\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ghostty.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ghostty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ghostty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Ghostty.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ghostty\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ghostty.enableBashIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ghostty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ghostty.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableBashIntegration)\"},\"description\":\"Whether to enable Bash integration.\\n\\nThis ensures that shell integration works in more scenarios, such as\\nswitching shells within Ghostty. But it is not needed to have shell\\nintegration.\\n\\nSee\\n<https://ghostty.org/docs/features/shell-integration#manual-shell-integration-setup>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"ghostty\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ghostty.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ghostty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ghostty.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\\n\\nThis ensures that shell integration works in more scenarios, such as\\nswitching shells within Ghostty. But it is not needed to have shell\\nintegration.\\n\\nSee\\n<https://ghostty.org/docs/features/shell-integration#manual-shell-integration-setup>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"ghostty\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ghostty.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ghostty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ghostty.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\\n\\nThis ensures that shell integration works in more scenarios, such as\\nswitching shells within Ghostty. But it is not needed to have shell\\nintegration.\\n\\nSee\\n<https://ghostty.org/docs/features/shell-integration#manual-shell-integration-setup>\\nfor more information.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"ghostty\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ghostty.installBatSyntax\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ghostty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ghostty.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"`true` if programs.ghostty.package is not null\"},\"description\":\"Whether to enable installation of Ghostty configuration syntax for bat.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"ghostty\",\"installBatSyntax\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.ghostty.installVimSyntax\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/ghostty.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/ghostty.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable installation of Ghostty configuration syntax for Vim.\",\"ex