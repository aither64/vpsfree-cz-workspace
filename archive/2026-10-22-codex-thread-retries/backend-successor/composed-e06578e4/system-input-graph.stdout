r/modules/programs/pay-respects.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pay-respects.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"pay-respects\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.pay-respects.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pay-respects.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pay-respects.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"pay-respects\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.pay-respects.options\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pay-respects.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pay-respects.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--alias\\\"\\n]\"},\"description\":\"List of options to pass to pay-respects <shell>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--alias\\\"\\n  \\\"f\\\"\\n]\"},\"loc\":[\"programs\",\"pay-respects\",\"options\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.pay-respects.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pay-respects.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pay-respects.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.pay-respects\"},\"description\":\"The pay-respects package to use.\",\"loc\":[\"programs\",\"pay-respects\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.pay-respects.rules\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pay-respects.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pay-respects.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Runtime rule files written to\\n{file}`$XDG_CONFIG_HOME/pay-respects/rules/<name>.toml`.\\n\\nAttribute names map to filenames. For example, setting `rules.cargo = { ... };`\\ncreates {file}`$XDG_CONFIG_HOME/pay-respects/rules/cargo.toml`.\\nThe filename must match the command name, except for `_PR_GENERAL`.\\n\\nSee <https://github.com/iffse/pay-respects/blob/main/rules.md>\\nfor runtime rule syntax and behavior.\\n\\nNote that these rules are only applied when the runtime-rules module is\\navailable to `pay-respects`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  cargo = {\\n    command = \\\"cargo\\\";\\n    match_err = [\\n      {\\n        pattern = [ \\\"run `cargo init` to initialize a new rust project\\\" ];\\n        suggest = [ \\\"cargo init\\\" ];\\n      }\\n    ];\\n  };\\n\\n  _PR_GENERAL = {\\n    match_err = [\\n      {\\n        pattern = [ \\\"permission denied\\\" ];\\n        suggest = [\\n          \\\"#[executable(sudo), !cmd_contains(sudo)]\\\\nsudo {{command}}\\\"\\n        ];\\n      }\\n    ];\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"pay-respects\",\"rules\"],\"readOnly\":false,\"type\":\"attribute set of (TOML value)\"},\"programs.pazi.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/pazi.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/pazi.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable pazi.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"pazi\",\"enable\"],\"read