H":"/nix/store/zvkgr9n5lkaccawfxv7z3iknib1i60px-tinycc-mes-unstable-2025-12-03/bin:/nix/store/4210ig7xwzjjwsab8v2mahmd2hckx6k6-gnumake-4.4.1/bin:/nix/store/azdj57mzy4npxfajhmgv91iz6wzb3686-gnupatch-2.5.9/bin:/nix/store/iavp9755n2x6fl76vgv288wkrn1l4h00-gnused-mes-4.0.9/bin:/nix/store/x0gqa6ksn306k9x91fdyb8k4ci90pn5x-gnugrep-2.4/bin:/nix/store/9i47y99mnryi9ldkalnpr0mp4iijqkwa-gnutar-1.12/bin:/nix/store/6skcsg3yn7afxaf0mkp0d0n4yjyz08s4-gzip-1.2.4/bin:/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin:/nix/store/mr3ikv5qcbjs672v5fsyxhfa6vn0v8f5-bootstrap-coreutils-5.0/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","SHELL":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","buildCommand":"# Unpack\ntar xzf /nix/store/1j3vmqzmlbx2j10q0j061fqychxd7q4i-musl-1.2.6.tar.gz\ncd musl-1.2.6\n\n# Patch\npatch -Np0 -i /nix/store/gg3z1dg2p54gc1zxj0m5a40kzgb0biqm-sigsetjmp.patch\n# tcc does not support complex types\nrm -rf src/complex\n# Configure fails without this\nmkdir -p /dev\n# https://github.com/ZilchOS/bootstrap-from-tcc/blob/2e0c68c36b3437386f786d619bc9a16177f2e149/using-nix/2a3-intermediate-musl.nix\nsed -i 's|/bin/sh|/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash|' \\\n  tools/*.sh\nchmod 755 tools/*.sh\n# patch popen/system to search in PATH instead of hardcoding /bin/sh\nsed -i 's|posix_spawn(&pid, \"/bin/sh\",|posix_spawnp(\\&pid, \"sh\",|' \\\n  src/stdio/popen.c src/process/system.c\nsed -i 's|execl(\"/bin/sh\", \"sh\", \"-c\",|execlp(\"sh\", \"-c\",|'\\\n  src/misc/wordexp.c\n\n# @PLT specifier is not supported by tinycc.\n# Calls do go through PLT regardless.\nsed -i 's|@PLT||' src/math/x86_64/expl.s\nsed -i 's|@PLT||' src/signal/x86_64/sigsetjmp.s\n\n# TODO Implement the required asm constraints 'x' and 't' in tinycc.\n# For now, we just remove code using those constraints. musl automatically\n# polyfills with pure C implementations.\nrm src/math/i386/*.c\nrm src/math/x86_64/*.c\n\n# Configure\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --disable-shared \\\n  CC=tcc\n\n# Build\n# NOTE: parallel build (-j) under tcc here is unstable and broke a previous run.\nmake AR=\"tcc -ar\" RANLIB=true CFLAGS=\"-DSYSCALL_NO_TLS\"\n\n# Install\nmake install\ncp /nix/store/armip90blbpwprlblj1phx0nnqj3xpvx-tinycc-mes-libs-unstable-2025-12-03/lib/libtcc1.a $out/lib\n","builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","name":"musl-1.2.6","out":"/nix/store/7c9flz3laqla3bzfghrxr1w9mf403nk6-musl-1.2.6","passAsFile":"buildCommand","pname":"musl","system":"x86_64-linux","version":"1.2.6"},"inputs":{"drvs":{"05z44243pvwk3qrcimv1cf5g3nxi5jjb-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"59pgig863abfc3p6lmz20vh8gjf2nsv1-musl-1.2.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6f6p45qkd5mhdwvfzgxdydwdpplccvgj-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"7g9biqznf18jyzs1r19hhlbf1jvwyivl-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"9d46md37a38ibk0zxjll9s58sfjf0jb6-tinycc-mes-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"agzpw52wkapzm6z6yjlmf5321gr7ngxd-gnused-mes-4.0.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"qcz565439vz47snj3vky7rbdd4ihvxzl-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"vix3mhga9d9pjgm0smc84w5608k8c7yb-gnumake-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"y0yxb5kxhvzffj19ggf3d7snxrc0xbjb-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zc4i6kv4525v20s2zh7fhxj1gcbcgggq-sigsetjmp.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"zgf0vd9gfdd8qbj1m8a0rdjrgsl6xmds-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"zil1l444xh348yy1hvy5w5f0g2p72f9v-gnupatch-2.5.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["9hvp9axa7zm732xi5j