ctDeps":"","system":"x86_64-linux","text":"#!/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash\nset -e\n\nstate=\"/run/nixos/network/addresses/br0\"\nmkdir -p \"$(dirname \"$state\")\"\n\nip link set dev \"br0\" up\n\necho \"172.16.106.40/24\" >> $state\necho -n \"adding address 172.16.106.40/24... \"\nif out=$(ip addr replace \"172.16.106.40/24\" dev \"br0\" nodad 2>&1); then\n  echo \"done\"\nelse\n  echo \"'ip addr replace \\\"172.16.106.40/24\\\" dev \\\"br0\\\"' nodad failed: $out\"\n  exit 1\nfi\n\n\nstate=\"/run/nixos/network/routes/br0\"\nmkdir -p \"$(dirname \"$state\")\"\n\n\n\n# Set the default gateway\necho -n \"setting br0 as default IPv4 gateway... \"\n\nip -4 route replace default proto static via 172.16.106.1\necho \"done\"\n\n\n\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-network-addresses-br0-start","outputs":{"out":{"path":"9wh734j3drrigva8nd6grs1n0rljkm74-unit-script-network-addresses-br0-start"}},"system":"x86_64-linux","version":4},"4fvfqw0a90wqpd9dd4gmazcp8j3zvlr0-etc-nix-registry.json.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","checkPhase