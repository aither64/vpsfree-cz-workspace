target systemd-halt.service shutdown.target umount.target final.target kexec.target systemd-kexec.service soft-reboot.target systemd-soft-reboot.service systemd-update-utmp.service systemd-ask-password-console.path systemd-ask-password-console.service systemd-ask-password-wall.path systemd-ask-password-wall.service systemd-bootctl@.service systemd-bootctl.socket systemd-creds@.service systemd-creds.socket systemd-pcrlock@.service systemd-pcrlock.socket systemd-tpm2-clear.service slices.target systemd-importd.service machine.slice machines.target systemd-machined.service systemd-nspawn@.service systemd-sysctl.service systemd-machine-id-commit.service dbus-org.freedesktop.timedate1.service systemd-timedated.service dbus-org.freedesktop.locale1.service systemd-localed.service dbus-org.freedesktop.hostname1.service systemd-hostnamed.service systemd-hostnamed.socket dbus-org.freedesktop.portable1.service systemd-portabled.service systemd-exit.service systemd-update-done.service capsule@.service capsule.slice factory-reset.target systemd-factory-reset-request.service systemd-factory-reset-reboot.service user.slice tpm2.target systemd-tpm2-setup-early.service systemd-tpm2-setup.service systemd-tmpfiles-clean.service systemd-tmpfiles-clean.timer systemd-tmpfiles-setup-dev-early.service systemd-tmpfiles-setup-dev.service systemd-tmpfiles-setup.service systemd-oomd.service systemd-oomd.socket systemd-logind.service systemd-user-sessions.service dbus-org.freedesktop.import1.service dbus-org.freedesktop.machine1.service dbus-org.freedesktop.login1.service user@.service user-runtime-dir@.service systemd-journald.socket systemd-journald@.socket systemd-journald-varlink@.socket systemd-journald.service systemd-journald@.service systemd-journal-flush.service systemd-journal-catalog-update.service systemd-journald-sync@.service systemd-journald-audit.socket systemd-journald-dev-log.socket systemd-journalctl.socket systemd-journalctl@.service syslog.socket systemd-coredump.socket systemd-coredump@.service emergency.target emergency.service; do\n  fn=/nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/example/systemd/system/$i\n  if ! [ -e $fn ]; then echo \"missing $fn\"; false; fi\n  if [ -L $fn ]; then\n    target=\"$(readlink \"$fn\")\"\n    if [ ${target:0:3} = ../ ]; then\n      ln -s \"$(readlink -f \"$fn\")\" $out/\n    else\n      cp -pd $fn $out/\n    fi\n  else\n    ln -s $fn $out/\n  fi\ndone\n\n# Copy .wants links, but only those that point to units that\n# we're interested in.\nfor i in sysinit.target.wants sockets.target.wants local-fs.target.wants multi-user.target.wants timers.target.wants factory-reset.target.wants; do\n  fn=/nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/example/systemd/system/$i\n  if ! [ -e $fn ]; then echo \"missing $fn\"; false; fi\n  x=$out/$(basename $fn)\n  mkdir $x\n  for i in $fn/*; do\n    y=$x/$(basename $i)\n    cp -pd $i $y\n    if ! [ -e $y ]; then rm $y; fi\n  done\ndone\n\n# Symlink all units provided listed in systemd.packages.\npackages=\"/nix/store/5np0yidzrnyjbb243hvgqpgpss865p0n-nix-2.34.9 /nix/store/2hc6lqclam28wdnjgd8gjdmw168mlf1a-dbus-1.16.2 /nix/store/yly12cgk8diwbba5pjdr7g0b3hk8db0c-dbus-broker-37 /nix/store/0bmapmnznzaxgx76jhzbznhlwq738g03-util-linux-2.42.3-bin /nix/store/fvxwz94g9mnjmsnx9hpj24r9jng5znzl-util-linux-2.42.3-lastlog\"\n\n# Filter duplicate directories\ndeclare -A unique_packages\nfor k in $packages ; do unique_packages[$k]=1 ; done\n\nfor i in ${!unique_packages[@]}; do\n  for fn in $i/etc/systemd/system/* $i/lib/systemd/system/*; do\n    if ! [[ \"$fn\" =~ .wants$ ]]; then\n      if [[ -d \"$fn\" ]]; then\n        targetDir=\"$out/$(basename \"$fn\")\"\n        mkdir -p \"$targetDir\"\n        /nix/store/smriw9hf43mvqp4v7nrn4d0wgny9yvk0-lndir-1.0.5/bin/lndir \"$fn\" \"$targetDir\"\n      else\n        ln -s $fn $out/\n      fi\n    fi\n  done\ndone\n\n# Symlink units defined by systemd.units where override strategy\n# shall be automatically detected. If