ckage.\\nA more specific path can be set by using settings.runner.runner_executable instead.\\nIncompatible with certain runners, such as wine.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pkgs.cemu\\\"\"},\"loc\":[\"programs\",\"lutris\",\"runners\",\"<name>\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.lutris.runners.<name>.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lutris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lutris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Settings passed directly to lutris for this runner's config at XDG_CONFIG/lutris/runners.\\n\",\"loc\":[\"programs\",\"lutris\",\"runners\",\"<name>\",\"settings\"],\"readOnly\":false,\"type\":\"submodule\"},\"programs.lutris.runners.<name>.settings.runner\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lutris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lutris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Runner specific options.\\nFor references, you must look for the file of said runner on lutris' source code.\\n\",\"loc\":[\"programs\",\"lutris\",\"runners\",\"<name>\",\"settings\",\"runner\"],\"readOnly\":false,\"type\":\"open submodule of (YAML 1.1 value)\"},\"programs.lutris.runners.<name>.settings.runner.runner_executable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lutris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lutris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Specific option to point to a runner executable directly, don't set runner.package if you set this.\\nIncompatible with certain runners such as wine.\\n\",\"loc\":[\"programs\",\"lutris\",\"runners\",\"<name>\",\"settings\",\"runner\",\"runner_executable\"],\"readOnly\":false,\"type\":\"string or absolute path\"},\"programs.lutris.runners.<name>.settings.system\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lutris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lutris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Lutris system options for this runner.\\nReference for system options:\\nhttps://github.com/lutris/lutris/blob/master/lutris/sysoptions.py#L78\\n\",\"loc\":[\"programs\",\"lutris\",\"runners\",\"<name>\",\"settings\",\"system\"],\"readOnly\":false,\"type\":\"open submodule of (YAML 1.1 value)\"},\"programs.lutris.steamPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lutris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lutris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"This must be the same you use for your system, or two instances will conflict,\\nfor example, if you configure steam through the nixos module, a good value is \\\"osConfig.programs.steam.package\\\"\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pkgs.steam or osConfig.programs.steam.package\\\"\"},\"loc\":[\"programs\",\"lutris\",\"steamPackage\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.lutris.winePackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lutris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lutris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of wine packages to be added for lutris to use.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"[ pkgs.wineWow64Packages.full ]\\\"\"},\"loc\":[\"programs\",\"lutris\",\"winePackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.macchina.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable macchina system information fetcher.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"macchina\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.macchina.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.macchina\"},\"description\":\"The macchina package to use.\",\"loc\":[\"programs\",\"macchina\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.macchina.settings.current_shell\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Show the current shell rather than the user's default shell.\",\"loc\":[\"programs\",\"macchina\",\"settings\",\"current_shell\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.settings.disk_space_percentage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Show percentage next to disk space information.\",\"loc\":[\"programs\",\"macchina\",\"settings\",\"disk_space_percentage\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.settings.disks\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Disks to show disk usage for.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"/\\\"\\n  \\\"/home/user\\\"\\n]\"},\"loc\":[\"programs\",\"macchina\",\"settings\",\"disks\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"programs.macchina.settings.interface\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Network interface to use for the LocalIP readout. Omitted when null.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"wlan0\\\"\"},\"loc\":[\"programs\",\"macchina\",\"settings\",\"interface\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.macchina.settings.long_kernel\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Show lengthened kernel output.\",\"loc\":[\"programs\",\"macchina\",\"settings\",\"long_kernel\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.settings.long_shell\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Show lengthened shell output.\",\"loc\":[\"programs\",\"macchina\",\"settings\",\"long_shell\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.settings.long_uptime\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Show lengthened uptime output.\",\"loc\":[\"programs\",\"macchina\",\"settings\",\"long_uptime\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.settings.memory_percentage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Show percentage next to memory information.\",\"loc\":[\"programs\",\"macchina\",\"settings\",\"memory_percentage\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.settings.physical_cores\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Show physical CPU core count rather than logical core count.\",\"loc\":[\"programs\",\"macchina\",\"settings\",\"physical_cores\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.settings.show\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Display only the specified readouts. When null, all readouts are shown.\\nValues are case-sensitive.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"Battery\\\"\\n  \\\"Memory\\\"\\n  \\\"Processor\\\"\\n  \\\"Shell\\\"\\n]\"},\"loc\":[\"programs\",\"macchina\",\"settings\",\"show\"],\"readOnly\":false,\"type\":\"null or (list of (one of \\\"Host\\\", \\\"Machine\\\", \\\"Kernel\\\", \\\"Distribution\\\", \\\"OperatingSystem\\\", \\\"DesktopEnvironment\\\", \\\"WindowManager\\\", \\\"Resolution\\\", \\\"Backlight\\\", \\\"Packages\\\", \\\"LocalIP\\\", \\\"Terminal\\\", \\\"Shell\\\", \\\"Uptime\\\", \\\"Processor\\\", \\\"ProcessorLoad\\\", \\\"Memory\\\", \\\"Battery\\\", \\\"GPU\\\", \\\"DiskSpace\\\"))\"},\"programs.macchina.settings.theme\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Name of the theme to use, without the .toml extension. Case-sensitive.\\nMust correspond to a file in the macchina themes directory, or be defined\\nin {option}`programs.macchina.themes`.\\nOmitted when null.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"Hydrogen\\\"\"},\"loc\":[\"programs\",\"macchina\",\"settings\",\"theme\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.macchina.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of macchina themes. Each entry is written to\\n{file}`$XDG_CONFIG_HOME/macchina/themes/<name>.toml`.\\n\\nTheme names are case-sensitive. A theme defined here can be activated\\nby setting {option}`programs.macchina.settings.theme` to its name.\\n\\nSee <https://github.com/Macchina-CLI/macchina/wiki/Customization>\\nfor details.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  Hydrogen = {\\n    bar = {\\n      glyph = \\\"o\\\";\\n      hide_delimiters = true;\\n      symbol_close = \\\"]\\\";\\n      symbol_open = \\\"[\\\";\\n      visible = true;\\n    };\\n    box = {\\n      border = \\\"plain\\\";\\n      inner_margin = {\\n        x = 1;\\n        y = 0;\\n      };\\n      visible = true;\\n    };\\n    hide_ascii = true;\\n    key_color = \\\"Cyan\\\";\\n    keys = {\\n      backlight = \\\"Brightness\\\";\\n      battery = \\\"Battery\\\";\\n      cpu = \\\"CPU\\\";\\n      cpu_load = \\\"CPU Load\\\";\\n      de = \\\"DE\\\";\\n      disk_space = \\\"Disk Space\\\";\\n      distro = \\\"Distro\\\";\\n      gpu = \\\"GPU\\\";\\n      host = \\\"Host\\\";\\n      kernel = \\\"Kernel\\\";\\n      local_ip = \\\"Local IP\\\";\\n      machine = \\\"Machine\\\";\\n      memory = \\\"Memory\\\";\\n      os = \\\"OS\\\";\\n      packages = \\\"Packages\\\";\\n      resolution = \\\"Resolution\\\";\\n      shell = \\\"Shell\\\";\\n      terminal = \\\"Terminal\\\";\\n      uptime = \\\"Uptime\\\";\\n      wm = \\\"WM\\\";\\n    };\\n    padding = 0;\\n    palette = {\\n      type = \\\"Full\\\";\\n      visible = false;\\n    };\\n    randomize = {\\n      key_color = false;\\n      separator_color = false;\\n    };\\n    separator = \\\">\\\";\\n    separator_color = \\\"White\\\";\\n    spacing = 2;\\n  };\\n}\"},\"loc\":[\"programs\",\"macchina\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.macchina.themes.<name>.bar\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Bar section. Replaces data ranging from 0–100% with visual bars.\\nOmit to exclude the [bar] section entirely.\\n\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"bar\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"programs.macchina.themes.<name>.bar.glyph\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Glyph to use for all bars.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"bar\",\"glyph\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.macchina.themes.<name>.bar.hide_delimiters\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to hide bar delimiters.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"bar\",\"hide_delimiters\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.themes.<name>.bar.symbol_close\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Closing delimiter character. Must be a single character.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"bar\",\"symbol_close\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.macchina.themes.<name>.bar.symbol_open\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Opening delimiter character. Must be a single character.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"bar\",\"symbol_open\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.macchina.themes.<name>.bar.visible\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Whether to show bars.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"bar\",\"visible\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.macchina.themes.<name>.box\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Box section. Renders a box around system information.\\nOmit to exclude the [box] section entirely.\\n\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"box\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"programs.macchina.themes.<name>.box.border\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Border style for the box.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"box\",\"border\"],\"readOnly\":false,\"type\":\"null or one of \\\"plain\\\", \\\"thick\\\", \\\"rounded\\\", \\\"double\\\"\"},\"programs.macchina.themes.<name>.box.inner_margin\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Inner margin between content and the box border.\",\"loc\":[\"programs\",\"macchina\",\"themes\",\"<name>\",\"box\",\"inner_margin\"],\"readOnly\":false,\"type\":\"null or (submodule)\"},\"programs.macchina.themes.<name>.box.inner_margin.x\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/macchina>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/macchina\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"