,\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to automatically wrap the binary with the runtime dependencies of the plugins.\\n\",\"loc\":[\"programs\",\"neovim\",\"autowrapRuntimeDeps\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.coc.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Coc.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"neovim\",\"coc\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.coc.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vimPlugins.coc-nvim\"},\"description\":\"The coc-nvim package to use.\",\"loc\":[\"programs\",\"neovim\",\"coc\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.neovim.coc.pluginConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Script to configure CoC. Must be viml.\",\"loc\":[\"programs\",\"neovim\",\"coc\",\"pluginConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.neovim.coc.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra configuration lines to add to\\n{file}`$XDG_CONFIG_HOME/nvim/coc-settings.json`\\nSee\\n<https://github.com/neoclide/coc.nvim/wiki/Using-the-configuration-file>\\nfor options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  languageserver = {\\n    haskell = {\\n      args = [\\n        \\\"--lsp\\\"\\n      ];\\n      command = \\\"haskell-language-server-wrapper\\\";\\n      filetypes = [\\n        \\\"haskell\\\"\\n        \\\"lhaskell\\\"\\n      ];\\n      rootPatterns = [\\n        \\\"*.cabal\\\"\\n        \\\"stack.yaml\\\"\\n        \\\"cabal.project\\\"\\n        \\\"package.yaml\\\"\\n        \\\"hie.yaml\\\"\\n      ];\\n    };\\n  };\\n  \\\"suggest.disableKind\\\" = true;\\n  \\\"suggest.enablePreselect\\\" = false;\\n  \\\"suggest.enablePreview\\\" = true;\\n  \\\"suggest.noselect\\\" = true;\\n}\"},\"loc\":[\"programs\",\"neovim\",\"coc\",\"settings\"],\"readOnly\":false,\"type\":\"JSON value\"},\"programs.neovim.defaultEditor\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to configure {command}`nvim` as the default\\neditor using the {env}`EDITOR` and {env}`VISUAL`\\nenvironment variables.\\n\",\"loc\":[\"programs\",\"neovim\",\"defaultEditor\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Neovim.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"neovim\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Custom vimrc lines.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  set nobackup\\n''\"},\"loc\":[\"programs\",\"neovim\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.neovim.extraLuaPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"ps: [ ]\"},\"description\":\"The extra Lua packages required for your plugins to work.\\nThis option accepts a function that takes a Lua package set as an argument,\\nand selects the required Lua packages from this package set.\\nSee the example for more info.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"luaPkgs: with luaPkgs; [ luautf8 ]\"},\"loc\":[\"programs\",\"neovim\",\"extraLuaPackages\"],\"readOnly\":false,\"type\":\"function that evaluates to a(n) list of package\"},\"programs.neovim.extraName\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra name appended to the wrapper package name.\\n\",\"loc\":[\"programs\",\"neovim\",\"extraName\"],\"readOnly\":false,\"type\":\"string\"},\"programs.neovim.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra packages available to nvim.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.shfmt ]\"},\"loc\":[\"programs\",\"neovim\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.neovim.extraPython3Packages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"ps: [ ]\"},\"description\":\"The extra Python 3 packages required for your plugins to work.\\nThis option accepts a function that takes a Python 3 package set as an argument,\\nand selects the required Python 3 packages from this package set.\\nSee the example for more info.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pyPkgs: with pyPkgs; [ python-language-server ]\"},\"loc\":[\"programs\",\"neovim\",\"extraPython3Packages\"],\"readOnly\":false,\"type\":\"function that evaluates to a(n) list of package\"},\"programs.neovim.extraWrapperArgs\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Extra arguments to be passed to the neovim wrapper.\\nThis option sets environment variables required for building and running binaries\\nwith external package managers like mason.nvim.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--suffix\\\"\\n  \\\"LIBRARY_PATH\\\"\\n  \\\":\\\"\\n  \\\"${lib.makeLibraryPath [ pkgs.stdenv.cc.cc pkgs.zlib ]}\\\"\\n  \\\"--suffix\\\"\\n  \\\"PKG_CONFIG_PATH\\\"\\n  \\\":\\\"\\n  \\\"${lib.makeSearchPathOutput \\\"dev\\\" \\\"lib/pkgconfig\\\" [ pkgs.stdenv.cc.cc pkgs.zlib ]}\\\"\\n]\\n\"},\"loc\":[\"programs\",\"neovim\",\"extraWrapperArgs\"],\"readOnly\":false,\"type\":\"list of string\"},\"programs.neovim.finalPackage\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"description\":\"Resulting customized neovim package.\",\"loc\":[\"programs\",\"neovim\",\"finalPackage\"],\"readOnly\":true,\"type\":\"package\"},\"programs.neovim.generatedConfigViml\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"description\":\"Generated vimscript config.\\n\",\"loc\":[\"programs\",\"neovim\",\"generatedConfigViml\"],\"readOnly\":true,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.neovim.generatedConfigs\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Generated configurations with as key their language (set via type).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  viml = ''\\n    \\\" Generated by home-manager\\n    map <leader> ,\\n  '';\\n\\n  lua = ''\\n    -- Generated by home-manager\\n    vim.opt.background = \\\"dark\\\"\\n  '';\\n}\\n\"},\"loc\":[\"programs\",\"neovim\",\"generatedConfigs\"],\"readOnly\":true,\"type\":\"attribute set of strings concatenated with \\\"\\\\n\\\"\"},\"programs.neovim.initLua\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Content to be added to {file}`init.lua`.\\n\\nAutomatically contains the [advised plugin config](https://nixos.org/manual/nixpkgs/stable/#neovim-custom-configuration)\\n\\nTo specify the order, use `lib.mkOrder`, `lib.mkBefore`, `lib.mkAfter`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"let\\n    nvimEarlyInit = lib.mkOrder 500 \\\"set rtp+=vim.opt.rtp:prepend('/home/user/myplugin')\\\";\\n    nvimLateInit = lib.mkAfter \\\"vim.opt.signcolumn = 'auto:1-3'\\\";\\nin\\n    lib.mkMerge [ nvimEarlyInit nvimLateInit ];\\n\"},\"loc\":[\"programs\",\"neovim\",\"initLua\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.neovim.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.neovim-unwrapped\"},\"description\":\"The neovim package to use.\",\"loc\":[\"programs\",\"neovim\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.neovim.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of vim plugins to install optionally associated with\\nconfiguration to be placed in init.vim.\\n\\nThis option is mutually exclusive with {var}`configure`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs.vimPlugins;\\n[\\n  yankring\\n  vim-nix\\n  { plugin = vim-startify;\\n    config = \\\"let g:startify_change_to_vcs_root = 0\\\";\\n  }\\n]\\n\"},\"loc\":[\"programs\",\"neovim\",\"plugins\"],\"readOnly\":false,\"type\":\"list of (package or (submodule))\"},\"programs.neovim.plugins.*.config\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Script to configure this plugin. The scripting language should match type.\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"config\"],\"readOnly\":false,\"type\":\"null or strings concatenated with \\\"\\\\n\\\"\"},\"programs.neovim.plugins.*.optional\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Don't load by default (load with :packadd)\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"optional\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.plugins.*.plugin\":{\"declarations\":[],\"description\":\"The plugin package to use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vimPlugins.nvim-treesitter\"},\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"plugin\"],\"readOnly\":false,\"type\":\"package\"},\"programs.neovim.plugins.*.runtime\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Set of files that have to be linked in nvim config folder.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"ftplugin/c.vim\\\" = {\\n    text = \\\"setlocal omnifunc=v:lua.vim.lsp.omnifunc\\\";\\n  };\\n}\"},\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"runtime\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"programs.neovim.plugins.*.runtime.<name>.enable\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether this file should be generated. This option allows specific\\nfiles to be disabled.\\n\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"runtime\",\"<name>\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.plugins.*.runtime.<name>.executable\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Set the execute bit. If `null`, defaults to the mode\\nof the {var}`source` file or to `false`\\nfor files created through the {var}`text` option.\\n\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"runtime\",\"<name>\",\"executable\"],\"readOnly\":false,\"type\":\"null or boolean\"},\"programs.neovim.plugins.*.runtime.<name>.force\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether the target path should be unconditionally replaced\\nby the managed file source. Warning, this will silently\\ndelete the target regardless of whether it is a file or\\nlink.\\n\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"runtime\",\"<name>\",\"force\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.plugins.*.runtime.<name>.ignorelinks\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"When `recursive` is enabled, adds the `-ignorelinks` flag to lndir.\\n\\nIt causes lndir to not treat symbolic links in the source directory specially.\\nThe link created in the target directory will point back to the corresponding\\nsymbolic link in the source directory. If that link points to a directory, the\\nresulting target will be a link to the source tree's symlink rather than a\\nrecursively linked directory tree.\\n\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"runtime\",\"<name>\",\"ignorelinks\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.plugins.*.runtime.<name>.onChange\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Shell commands to run when file has changed between\\ngenerations. The script will be run\\n*after* the new files have been linked\\ninto place.\\n\\nNote, this code is always run when `recursive` is\\nenabled.\\n\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"runtime\",\"<name>\",\"onChange\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.neovim.plugins.*.runtime.<name>.recursive\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"If the file source is a directory, then this option\\ndetermines whether the directory should be recursively\\nlinked to the target location. This option has no effect\\nif the source is a file.\\n\\nIf `false` (the default) then the target\\nwill be a symbolic link to the source directory. If\\n`true` then the target will be a\\ndirectory structure matching the source's but whose leaves\\nare symbolic links to the files of the source directory.\\n\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"runtime\",\"<name>\",\"recursive\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.plugins.*.runtime.<name>.source\":{\"declarations\":[],\"description\":\"Path of the source file or directory. If\\n[](#opt-programs.neovim.plugins._.runtime._name_.text)\\nis non-null then this option will automatically point to a file\\ncontaining that text.\\n\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"runtime\",\"<name>\",\"source\"],\"readOnly\":false,\"type\":\"absolute path\"},\"programs.neovim.plugins.*.runtime.<name>.target\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"name\"},\"description\":\"Path to target file relative to {var}`xdg.configHome/nvim`.\\n\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"runtime\",\"<name>\",\"target\"],\"readOnly\":false,\"type\":\"non-empty string\"},\"programs.neovim.plugins.*.runtime.<name>.text\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Text of the file. If this option is null then\\n[](#opt-programs.neovim.plugins._.runtime._name_.source)\\nmust be set.\\n\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"runtime\",\"<name>\",\"text\"],\"readOnly\":false,\"type\":\"null or strings concatenated with \\\"\\\\n\\\"\"},\"programs.neovim.plugins.*.type\":{\"declarations\":[],\"default\":{\"_type\":\"literalExpression\",\"text\":\"if lib.versionAtLeast config.home.stateVersion \\\"26.05\\\" then \\\"lua\\\" else \\\"viml\\\"\\n\"},\"description\":\"Language used in config. Configurations are aggregated per-language.\",\"loc\":[\"programs\",\"neovim\",\"plugins\",\"*\",\"type\"],\"readOnly\":false,\"type\":\"one of \\\"lua\\\", \\\"viml\\\", \\\"teal\\\", \\\"fennel\\\" or string\"},\"programs.neovim.sideloadInitLua\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Enable to avoid writing the content of {var}`initLua` to the default\\nlocation {file}`$XDG_CONFIG_HOME/nvim/init.lua` and load it through\\nneovim wrapper arguments instead.\\n\\n\\nThis is useful if you want to manage your own {file}`init.lua` imperatively.\\n\",\"loc\":[\"programs\",\"neovim\",\"sideloadInitLua\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.viAlias\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Symlink {command}`vi` to {command}`nvim` binary.\\n\",\"loc\":[\"programs\",\"neovim\",\"viAlias\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.vimAlias\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Symlink {command}`vim` to {command}`nvim` binary.\\n\",\"loc\":[\"programs\",\"neovim\",\"vimAlias\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.neovim.vimdiffAlias\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/neovim>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/neovim\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Alias {command}`vimdiff` to {command}`nvim -d`.\\n\",\"loc\":[\"programs\",\"neovim\",\"v