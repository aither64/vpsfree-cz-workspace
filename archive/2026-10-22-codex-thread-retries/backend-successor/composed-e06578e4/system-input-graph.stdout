).\\n\\nSee {manpage}`qalc(1)` for the full list of available settings\\nand their accepted values.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  General = {\\n    colorize = 1;\\n    precision = 10;\\n    save_definitions_on_exit = 0;\\n    save_mode_on_exit = 1;\\n  };\\n  Mode = {\\n    angle_unit = 1;\\n    calculate_as_you_type = 1;\\n    max_deci = -1;\\n    min_deci = 0;\\n    number_base = 10;\\n  };\\n}\"},\"loc\":[\"programs\",\"qalculate\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"programs.qcal.defaultNumDays\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qcal.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qcal.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"30\"},\"description\":\"Default number of days to show calendar entries for\",\"loc\":[\"programs\",\"qcal\",\"defaultNumDays\"],\"readOnly\":false,\"type\":\"positive integer, meaning >0\"},\"programs.qcal.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qcal.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qcal.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable qcal, a CLI calendar application.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"qcal\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.qcal.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/qcal.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/qcal.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.qcal\"},\"description\":\"The qcal package to use.\",\"loc\":[\"programs\",\"qcal\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.qcal.timezo