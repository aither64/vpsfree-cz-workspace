\nmkdir -p $bin\nmv $out/bin $bin/bin\n\n# c_rehash is a legacy perl script with the same functionality\n# as `openssl rehash`\n# this wrapper script is created to maintain backwards compatibility without\n# depending on perl\nmakeWrapper $bin/bin/openssl $bin/bin/c_rehash \\\n  --add-flags \"rehash\"\n\nmkdir $dev\nmv $out/include $dev/\n\n# remove dependency on Perl at runtime\nrm -r $etc/etc/ssl/misc\n\nrmdir $etc/etc/ssl/{certs,private}\n","postPatch":"patchShebangs Configure\nsubstituteInPlace config --replace '/usr/bin/env' '/nix/store/2gfxiwls9hbgwdwcy43mprchwsq36mg6-coreutils-9.11/bin/env'\n","preCheck":"patchShebangs util\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"setOutputFlags":false,"src":"/nix/store/2wqx8i0bmavb7l78rhfxn41kjpfkfvz3-openssl-3.5.8.tar.gz","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"3.5.8"},"system":"x86_64-linux","version":4},"lqx91q2khs5xrb42p1lirxvnwdh23sg5-memmem.drv":{"args":["--verbose","--strict","--file","/nix/store/ghagr53sgba3ky2abavpl333s244l5cn-memmem-builder"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin:/nix/store/53zd871rgpcvi7qmqkffxhzaiq0is7k4-mescc-tools-1.9.1/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","name":"memmem","out":"/nix/store/f3y8gdqc9fhd7cz97dw4vrc3ml53sgks-memmem","system":"x86_64-linux"},"inputs":{"drvs":{"7syw1g6xr2zqzv38cpfq043pz9n8qffy-memmem-builder.drv":{"dynamicOutputs":{},"outputs":["out"]},"pz3m6g7iabylyazm40p363y8795vybf9-mescc-tools-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["ou