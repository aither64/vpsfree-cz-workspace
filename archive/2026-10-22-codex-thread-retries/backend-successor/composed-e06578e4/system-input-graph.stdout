7q8dsalcai1iapmxzs2ilvnk3m8vvl-zlib-1.3.2-dev/include\nLIB          = /nix/store/kfw5hkcr4mzfbk891xaif8zq452093kz-zlib-1.3.2/lib\nOLD_ZLIB     = False\nGZIP_OS_CODE = AUTO_DETECT\nUSE_ZLIB_NG  = False\nZLIB_INCLUDE = /nix/store/g67q8dsalcai1iapmxzs2ilvnk3m8vvl-zlib-1.3.2-dev/include\nZLIB_LIB     = /nix/store/kfw5hkcr4mzfbk891xaif8zq452093kz-zlib-1.3.2/lib\nEOF\n# We need to do this because the bootstrap doesn't have a static libpthread\nsed -i 's,\\(libswanted.*\\)pthread,\\1,g' Configure\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"setOutputFlags":false,"setupHook":"/nix/store/dm81j9qdcdr4c458pqbc9wvq9ymgzk4m-setup-hook.sh","src":"/nix/store/m2qam71fmv9f8vyliw7741lr87mbxcwk-perl-5.42.3.tar.gz","stdenv":"/nix/store/ibyj3qs750igfnivfcl638clyrgmjmv3-bootstrap-stage1-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"5.42.3"},"system":"x86_64-linux","version":4},"gpynpz921rm1g39wb4544fgv946a1ikn-crate-itoa-1.0.11.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/776l56smb7rm82vp7qm02pi4hfgpja2p-crate-itoa-1.0.11.tar.gz"},"inputs":{"drvs":{"3fc7klhja3mn322hjxl4bax4mk3m6h8l-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"nccfw1s0py9wvalrf7s92cfmg7bijj0i-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"crate-itoa-1.0.11.tar.gz","outputs":{"out":{"hash":"sha256-SfHxSHMzVFRQDVlhHxz0pLD3hvmsEfQxKnjkzyVmaVs=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/jnyfsf2mp08d1xy