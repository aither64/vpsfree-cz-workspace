{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lutris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lutris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The wine/proton package to set as the default for lutris.\\nIt must still be set under proton/winePackages.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"pkgs.proton-ge-bin\\\"\"},\"loc\":[\"programs\",\"lutris\",\"defaultWinePackage\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.lutris.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lutris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lutris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable lutris..\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"lutris\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.lutris.extraPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lutris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lutris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of packages to pass as extraPkgs to lutris.\\nPlease note runners are not detected properly this way, use a proper option for those.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"with pkgs; [mangohud winetricks gamescope gamemode umu-launcher]\\\"\"},\"loc\":[\"programs\",\"lutris\",\"extraPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"programs.lutris.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/lutris.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/lutris.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.lutris\"},\"