iteralExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Additional content written at the end of\\n{file}`~/.tmate.conf`.\\n\",\"loc\":[\"programs\",\"tmate\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"programs.tmate.host\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tmate.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tmate.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Tmate server address.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"tmate.io\\\"\"},\"loc\":[\"programs\",\"tmate\",\"host\"],\"readOnly\":false,\"type\":\"null or string\"},\"programs.tmate.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tmate.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tmate.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.tmate\"},\"description\":\"The tmate package to use.\",\"loc\":[\"programs\",\"tmate\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"programs.tmate.port\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tmate.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tmate.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Tmate server port.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"2222\"},\"loc\":[\"programs\",\"tmate\",\"port\"],\"readOnly\":false,\"type\":\"null or 16 bit unsigned integer; between 0 and 65535 (both inclusive)\"},\"programs.tmate.rsaFingerprint\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/tmate.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/tmate.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Tmate server RSA key fingerprint.\",\"example\