ion\",\"text\":\"-74.3\"},\"loc\":[\"services\",\"wlsunset\",\"latitude\"],\"readOnly\":false,\"type\":\"null or string or floating point number or signed integer\"},\"services.wlsunset.longitude\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wlsunset.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wlsunset.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Your current longitude, between `-180.0` and\\n`180.0`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"12.5\"},\"loc\":[\"services\",\"wlsunset\",\"longitude\"],\"readOnly\":false,\"type\":\"null or string or floating point number or signed integer\"},\"services.wlsunset.output\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wlsunset.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wlsunset.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Name of output to use, by default all outputs are used.\\n\",\"loc\":[\"services\",\"wlsunset\",\"output\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.wlsunset.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wlsunset.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wlsunset.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wlsunset\"},\"description\":\"The wlsunset package to use.\",\"loc\":[\"services\",\"wlsunset\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.wlsunset.sunrise\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wlsunset.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wlsunset.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The time when the sun rises (in 24 hour format).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"06:30\\\"\"},\"loc\":[\"services\",\"wlsunset\",\"sunrise\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.wlsunset.sunset\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wlsunset.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wlsunset.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The time when the sun sets (in 24 hour format).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"18:00\\\"\"},\"loc\":[\"services\",\"wlsunset\",\"sunset\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.wlsunset.systemdTarget\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wlsunset.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wlsunset.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.wayland.systemd.target\"},\"description\":\"Systemd target to bind to.\\n\",\"loc\":[\"services\",\"wlsunset\",\"systemdTarget\"],\"readOnly\":false,\"type\":\"string\"},\"services.wlsunset.temperature.day\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wlsunset.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wlsunset.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"6500\"},\"description\":\"Colour temperature to use during the day, in Kelvin (K).\\nThis value must be greater than `temperature.night`.\\n\",\"loc\":[\"services\",\"wlsunset\",\"temperature\",\"day\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.wlsunset.temperature.night\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wlsunset.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wlsunset.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"4000\"},\"description\":\"Colour temperature to use during the night, in Kelvin (K).\\nThis value must be smaller than `temperature.day`.\\n\",\"loc\":[\"services\",\"wlsunset\",\"temperature\",\"night\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.wluma.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wluma.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wluma.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Enable wluma, a service for automatic brightness adjustment.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"wluma\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.wluma.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wluma.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wluma.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wluma\"},\"description\":\"The wluma package to use.\",\"loc\":[\"services\",\"wluma\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.wluma.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wluma.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wluma.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration to use for wluma. See\\n<https://github.com/maximbaz/wluma/blob/main/config.toml>\\nfor available options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  als = {\\n    iio = {\\n      path = \\\"\\\";\\n      thresholds = {\\n        \\\"0\\\" = \\\"night\\\";\\n        \\\"20\\\" = \\\"dark\\\";\\n        \\\"250\\\" = \\\"normal\\\";\\n        \\\"500\\\" = \\\"bright\\\";\\n        \\\"80\\\" = \\\"dim\\\";\\n        \\\"800\\\" = \\\"outdoors\\\";\\n      };\\n    };\\n  };\\n}\"},\"loc\":[\"services\",\"wluma\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"services.wluma.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wluma.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wluma.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Wluma systemd integration\",\"loc\":[\"services\",\"wluma\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.wluma.systemd.target\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wluma.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wluma.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"config.wayland.systemd.target\"},\"description\":\"The systemd target that will automatically start the Wluma service.\\n\\nWhen setting this value to `\\\"sway-session.target\\\"`,\\nmake sure to also enable {option}`wayland.windowManager.sway.systemd.enable`,\\notherwise the service may never be started.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"sway-session.target\\\"\"},\"loc\":[\"services\",\"wluma\",\"systemd\",\"target\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.wob.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wob.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wob.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable wob.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"wob\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.wob.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wob.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wob.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wob\"},\"description\":\"The wob package to use.\",\"loc\":[\"services\",\"wob\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"services.wob.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wob.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wob.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to {file}`$XDG_CONFIG_HOME/wob/wob.ini`.\\nSee {manpage}`wob.ini(5)` for documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"\\\" = {\\n    border_size = 10;\\n    height = 50;\\n  };\\n  \\\"output.foo\\\" = {\\n    name = \\\"DP-1\\\";\\n  };\\n  \\\"style.muted\\\" = {\\n    background_color = \\\"032cfc\\\";\\n  };\\n}\"},\"loc\":[\"services\",\"wob\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of section of an INI file (attrs of INI atom (null, bool, int, float or string))\"},\"services.wob.systemd\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wob.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wob.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable systemd service and socket for wob.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"wob\",\"systemd\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.wpaperd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wpaperd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wpaperd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable wpaperd.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"wpaperd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.wpaperd.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wpaperd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wpaperd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wpaperd\"},\"description\":\"The wpaperd package to use.\",\"loc\":[\"services\",\"wpaperd\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"services.wpaperd.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/wpaperd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/wpaperd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/wpaperd/wallpaper.toml`.\\nSee <https://github.com/danyspin97/wpaperd#wallpaper-configuration>\\nfor the full list of options.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  DP-2 = {\\n    path = \\\"/home/foo/Pictures/Anime\\\";\\n    sorting = \\\"descending\\\";\\n  };\\n  eDP-1 = {\\n    apply-shadow = true;\\n    path = \\\"/home/foo/Pictures/Wallpaper\\\";\\n  };\\n}\"},\"loc\":[\"services\",\"wpaperd\",\"settings\"],\"readOnly\":false,\"type\":\"TOML value\"},\"services.xcape.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xcape.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xcape.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable xcape.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"xcape\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.xcape.mapExpression\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xcape.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xcape.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The value has the grammar `Key[|OtherKey]`.\\n\\nThe list of key names is found in the header file\\n{file}`X11/keysymdef.h` (remove the\\n`XK_` prefix). Note that due to limitations\\nof X11 shifted keys must be specified as a shift key\\nfollowed by the key to be pressed rather than the actual\\nname of the character. For example to generate \\\"{\\\" the\\nexpression `Shift_L|bracketleft` could be\\nused (assuming that you have a key with \\\"{\\\" above \\\"[\\\").\\n\\nYou can also specify keys in decimal (prefix #), octal (#0),\\nor hexadecimal (#0x). They will be interpreted as keycodes\\nunless no corresponding key name is found.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  Control_L = \\\"Control_L|O\\\";\\n  Shift_L = \\\"Escape\\\";\\n}\"},\"loc\":[\"services\",\"xcape\",\"mapExpression\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"services.xcape.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xcape.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xcape.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.xcape\"},\"description\":\"The xcape package to use.\",\"loc\":[\"services\",\"xcape\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.xcape.timeout\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xcape.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xcape.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"If you hold a key longer than this timeout, xcape will not\\ngenerate a key event. Default is 500 ms.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"500\"},\"loc\":[\"services\",\"xcape\",\"timeout\"],\"readOnly\":false,\"type\":\"null or signed integer\"},\"services.xembed-sni-proxy.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xembed-sni-proxy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xembed-sni-proxy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable XEmbed SNI Proxy.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"xembed-sni-proxy\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.xembed-sni-proxy.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xembed-sni-proxy.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xembed-sni-proxy.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.kdePackages.plasma-workspace\"},\"description\":\"The plasma-workspace package to use.\",\"loc\":[\"services\",\"xembed-sni-proxy\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.xidlehook.detect-sleep\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable detecting when the system wakes up from a suspended state and resetting the idle timer.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"xidlehook\",\"detect-sleep\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.xidlehook.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable xidlehook systemd service.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"xidlehook\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.xidlehook.environment\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Extra environment variables to be exported in the script.\\nThese options are passed unescaped as `export name=value`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  primary-display = \\\"$(xrandr | awk '/ primary/{print $1}')\\\";\\n}\"},\"loc\":[\"services\",\"xidlehook\",\"environment\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"services.xidlehook.not-when-audio\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Disable locking when audio is playing.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"xidlehook\",\"not-when-audio\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.xidlehook.not-when-fullscreen\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Disable locking when a fullscreen application is in use.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"xidlehook\",\"not-when-fullscreen\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.xidlehook.once\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable running the program once and exiting.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"xidlehook\",\"once\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.xidlehook.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.xidlehook\"},\"description\":\"The xidlehook package to use.\",\"loc\":[\"services\",\"xidlehook\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.xidlehook.timers\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"A set of commands to be executed after a specific idle timeout.\\nThe commands specified in `command` and `canceller`\\nare passed escaped to the script.\\nTo use or re-use environment variables that are script-dependent, specify them\\nin the `environment` section.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  {\\n    delay = 60;\\n    command = \\\"xrandr --output \\\\\\\"$PRIMARY_DISPLAY\\\\\\\" --brightness .1\\\";\\n    canceller = \\\"xrandr --output \\\\\\\"$PRIMARY_DISPLAY\\\\\\\" --brightness 1\\\";\\n  }\\n  {\\n    delay = 120;\\n    command = \\\"${pkgs.writeShellScript \\\"my-script\\\" ''\\n      # A complex script to run\\n    ''}\\\";\\n  }\\n]\\n\"},\"loc\":[\"services\",\"xidlehook\",\"timers\"],\"readOnly\":false,\"type\":\"list of (submodule)\"},\"services.xidlehook.timers.*.canceller\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Command executed when the user becomes active again.\\nThis is only executed if the next timer has not been reached.\\nPath to executables are accepted.\\nThe command is automatically escaped.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"${pkgs.libnotify}/bin/notify-send \\\"Idle\\\" \\\"Resuming activity\\\"\\n\"},\"loc\":[\"services\",\"xidlehook\",\"timers\",\"*\",\"canceller\"],\"readOnly\":false,\"type\":\"string\"},\"services.xidlehook.timers.*.command\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Command executed after the idle timeout is reached.\\nPath to executables are accepted.\\nThe command is automatically escaped.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"${pkgs.libnotify}/bin/notify-send \\\"Idle\\\" \\\"Sleeping in 1 minute\\\"\\n\"},\"loc\":[\"services\",\"xidlehook\",\"timers\",\"*\",\"command\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.xidlehook.timers.*.delay\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xidlehook.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xidlehook.nix\"}],\"description\":\"Time before executing the command.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"60\"},\"loc\":[\"services\",\"xidlehook\",\"timers\",\"*\",\"delay\"],\"readOnly\":false,\"type\":\"unsigned integer, meaning >=0\"},\"services.xscreensaver.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xscreensaver.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xscreensaver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable XScreenSaver.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"xscreensaver\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.xscreensaver.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xscreensaver.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xscreensaver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.xscreensaver\"},\"description\":\"The xscreensaver package to use.\",\"loc\":[\"services\",\"xscreensaver\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.xscreensaver.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xscreensaver.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xscreensaver.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"The settings to use for XScreenSaver.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  fadeTicks = 20;\\n  lock = false;\\n  mode = \\\"blank\\\";\\n}\"},\"loc\":[\"services\",\"xscreensaver\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of (boolean or signed integer or string)\"},\"services.xsettingsd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xsettingsd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xsettingsd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable xsettingsd.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"xsettingsd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.xsettingsd.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/xsettingsd.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/xsettingsd.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.xsettingsd\"},\"description\":\"The xsettingsd package to use.\",\"loc\":[\"services\",\"xsettingsd\",\