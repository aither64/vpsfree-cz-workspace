lse\"},\"loc\":[\"programs\",\"vivid\",\"enableBashIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vivid.enableFishIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vivid.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vivid.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableFishIntegration)\"},\"description\":\"Whether to enable Fish integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"vivid\",\"enableFishIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vivid.enableNushellIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vivid.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vivid.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableNushellIntegration)\"},\"description\":\"Whether to enable Nushell integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"vivid\",\"enableNushellIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vivid.enableZshIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vivid.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vivid.nix\"}],\"default\":{\"_type\":\"literalMD\",\"text\":\"[](#opt-home.shell.enableZshIntegration)\"},\"description\":\"Whether to enable Zsh integration.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",\"vivid\",\"enableZshIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vivid.filetypes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vivid.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vivid.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Filetype database for vivid. You can find an example config at:\\n<https://github.com/sharkdp/vivid/blob/master/config/filetypes.yml>.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  text = {\\n    licenses = [\\n      \\\"LICENCE\\\"\\n      \\\"COPYRIGHT\\\"\\n    ];\\n    special = [\\n      \\\"CHANGELOG.md\\\"\\n      \\\"CODE_OF_CONDUCT.md\\\"\\n      \\\"CONTRIBUTING.md\\\"\\n    ];\\n    todo = [\\n      \\\"TODO.md\\\"\\n      \\\"TODO.txt\\\"\\n    ];\\n  };\\n}\"},\"loc\":[\"programs\",\"vivid\",\"filetypes\"],\"readOnly\":false,\"type\":\"YAML 1.1 value\"},\"programs.vivid.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vivid.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vivid.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.vivid\"},\"description\":\"The vivid package to use.\",\"loc\":[\"programs\",\"vivid\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"programs.vivid.themes\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vivid.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vivid.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"An attribute set of vivid themes.\\nEach value can either be a path to a theme file or an attribute set\\ndefining the theme directly (which will be converted from Nix to YAML).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  ayu = builtins.fetchurl {\\n    url = \\\"https://raw.githubusercontent.com/NearlyTRex/Vivid/refs/heads/master/themes/ayu.yml\\\";\\n    hash = \\\"sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\\\";\\n  };\\n\\n  mocha = builtins.fetchurl {\\n    url = \\\"https://raw.githubusercontent.com/NearlyTRex/Vivid/refs/heads/master/themes/catppuccin-mocha.yml\\\";\\n    hash = \\\"sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\\\";\\n  };\\n\\n  my-custom-theme = {\\n    colors = {\\n      blue = \\\"0000ff\\\";\\n    };\\n    core = {\\n      directory = {\\n        foreground = \\\"blue\\\";\\n        font-style = \\\"bold\\\";\\n      };\\n    };\\n  };\\n}\\n\"},\"loc\":[\"programs\",\"vivid\",\"themes\"],\"readOnly\":false,\"type\":\"attribute set of (absolute path or YAML 1.1 value)\"},\"programs.vscode.argvSettings\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vscode>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vscode\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to Visual Studio Code's\\n{file}`argv.json`.\\nThis can be a JSON object or a path to a custom JSON file.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  enable-crash-reporter = false;\\n}\"},\"loc\":[\"programs\",\"vscode\",\"argvSettings\"],\"readOnly\":false,\"type\":\"absolute path or JSON value\"},\"programs.vscode.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vscode>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vscode\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Visual Studio Code.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vscode\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vscode.haskell.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vscode/haskell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vscode/haskell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Haskell integration for Visual Studio Code.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"vscode\",\"haskell\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vscode.haskell.hie.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vscode/haskell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vscode/haskell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable Haskell IDE engine integration.\",\"loc\":[\"programs\",\"vscode\",\"haskell\",\"hie\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.vscode.haskell.hie.executablePath\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vscode/haskell.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vscode/haskell.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"${pkgs.hie-nix.hies}/bin/hie-wrapper\\\"\"},\"description\":\"The path to the Haskell IDE Engine executable.\\n\\nBecause hie-nix is not packaged in Nixpkgs, you need to add it as an\\noverlay or set this option. Example overlay configuration:\\n\\n```nix\\nnixpkgs.overlays = [\\n  (self: super: { hie-nix = import ~/src/hie-nix {}; })\\n]\\n\\n```\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"(import ~/src/haskell-ide-engine {}).hies + \\\"/bin/hie-wrapper\\\";\\n\"},\"loc\":[\"programs\",\"vscode\",\"haskell\",\"hie\",\"executablePath\"],\"readOnly\":false,\"type\":\"absolute path\"},\"programs.vscode.mutableExtensionsDir\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/vscode>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/vscode\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"(removeAttrs config.programs.vscode.profiles [ \\\"default\\\" ]) == { }\"},\"description\":\"Whether extensions can be installed or updated manually\\nor by Visual Studio Code. Mutually exclusive to\\nprograms.vscode.profiles.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"programs\",