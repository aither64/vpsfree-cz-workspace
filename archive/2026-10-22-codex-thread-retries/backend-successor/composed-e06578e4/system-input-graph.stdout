emoving linger for missing user $user\" >&2\n        rm -- \"$user\"\n    fi\ndone\n\nif (( ${#nonLingeringUserNames[*]} > 0 )); then\n    /nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/bin/loginctl disable-linger \"${nonLingeringUserNames[@]}\"\nfi\nif (( ${#lingeringUserNames[*]} > 0 )); then\n    /nix/store/kmzlca218j6j1ar292fxj7707qzypij8-systemd-260.5/bin/loginctl enable-linger \"${lingeringUserNames[@]}\"\nfi\n\n\n"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"zdc0b6xvx8xz9pa1sqw2ja88ac0zkyrg-systemd-260.5.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-linger-users-start","outputs":{"out":{"path":"lkrbccaz0v4v114nx3b9hn56mqnqk48y-unit-script-linger-users-start"}},"system":"x86_64-linux","version":4},"vmm3nb8rf4f6c307in7zr2hmilzk6lcl-perl5.42.3-File-Which-1.27.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/119w10l5ic8izi6igxqpq0wdmccs9mbc-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"AUTOMATED_TESTING":"1","PERL_AUTOINSTALL":"--skipdeps","PERL_USE_UNSAFE_INC":"1","__structuredAttrs":"","buildInputs":"/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","checkTarget":"test","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","devdoc":"/nix/store/f2njshwn00gs9yyrmw2v9dysk0x805m0-perl5.42.3-File-Which-1.27-devdoc","doCheck":"1","doInstallCheck":"","enableParallelBuilding":"","fullperl":"/nix/store/llas6flzd287