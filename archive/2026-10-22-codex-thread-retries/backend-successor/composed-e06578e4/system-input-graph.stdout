\n# Regenerate the depmod map files.  Be sure to pass an explicit\n# kernel version number, otherwise depmod will use `uname -r'.\nif test -w $out/lib/modules/$kernelVersion; then\n    rm -f $out/lib/modules/$kernelVersion/modules.!(builtin*|order*)\n    /nix/store/7hb639qc0cgc215kr10pgg6r3z0xrfk2-kmod-31/bin/depmod -b $out -C $out/etc/depmod.d -a $kernelVersion\nfi\n","preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":false,"system":"x86_64-linux"},"system":"x86_64-linux","version":4},"235q8xj5fy4smyynkb5w35jbkc5r0zdq-perl-5.42.3-env.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/9lrzpy4c3kbv01bf59c7cvf58z65mzs1-perl-5.42.3-env"},"inputs":{"drvs":{"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"hsz17sk88mwprzflwi0glmffygl6y8di-perl5.42.3-File-Slurp-9999.32.drv":{"dynamicOutputs":{},"outputs":["out"]},"jzfv1mdbc1gpmmlx04il205rbkww8yjq-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"xv2y3sfvlgay9nrai47mcnag847pyk6l-gcc-wrapper-15.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"z2gsgvxwwcd0snpjsl2rpjz3cjqm3nqg-perl-5.42.3.drv":{"dynamicOutputs":{},"outputs":["man","out"]},"zgpvmcpxaz5fi29ylhsm89zawxw6786c-builder.pl.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"perl-5.42.3-env","outputs":{"out":{"path":"9lrzpy4c3kbv01bf59c7cvf58z65mzs1-perl-5.42.3-env"}},"structuredAttrs":{"NIX_MAIN_PROGRAM":"perl","allowSubstitutes":false,"buildCommand":"/nix/store/llas6flzd2875r7zzhhvwnynwqi349