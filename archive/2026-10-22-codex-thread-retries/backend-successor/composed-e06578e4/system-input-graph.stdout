ms.org/gems/pdf-reader-2.15.0.gem"]},"system":"x86_64-linux","version":4},"jzwacclklik7wjl3pqajq05wk0xr0nm7-gettext-1.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildInputs":"/nix/store/nryj4175dwkdp9kana7x791mhc7k6kh0-bash-5.3p9-dev","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"--disable-csharp","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","doc":"/nix/store/h4f67q7zpaj8dxdsmaa38vjp4gjzbi66-gettext-1.0-doc","enableParallelBuilding":"1","enableParallelChecking":"","enableParallelInstalling":"1","gettextNeedsLdflags":"","info":"/nix/store/9c5c0nz666kjhpk0bwmgmhb9h114h9mb-gettext-1.0-info","man":"/nix/store/433mv2s8skyrwl07szq1llrkfz0klyc8-gettext-1.0-man","mesonFlags":"","name":"gettext-1.0","nativeBuildInputs":"/nix/store/vrnwkpz9sbpsc3mf1vp69ahhrjn82618-update-autotools-gnu-config-scripts-hook","out":"/nix/store/r6cl7zk1vhckkbnrjvvgf5ah1a23s090-gettext-1.0","outputs":"out man doc info","patches":"/nix/store/p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff /nix/store/yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch","pname":"gettext","postPatch":"# Older versions of gettext come with a copy of `extern-inline.m4` that is not compatible with clang 18.\n# When a project uses gettext + autoreconfPhase, autoreconfPhase will invoke `autopoint -f`, which will\n# replace whatever (probably compatible) version of `extern-inline.m4` with one that probalby won’t work\n# because `autopoint` will copy the autoconf macros from the project’s required version of gettext.\n# Fixing this requires replacing all the older copies of the problematic file with a new one.\n#\n# This is ugly, but it avoids requiring workarounds in every package using gettext and autoreconfPhase.\ndeclare -a oldFiles=($(tar tf gettext-tools/autotools/archive.dir.tar | grep '^gettext-0\\.[19].*/extern-inline.m4'))\noldFilesDir=$(mktemp -d)\nfor oldFile in \"${oldFiles[@]}\"; do\n  mkdir -p \"$oldFilesDir/$(dirname \"$oldFile\")\"\n  cp -a gettext-tools/gnulib-m4/extern-inline.m4 \"$oldFilesDir/$oldFile\"\ndone\ntar uf gettext-tools/autotools/archive.dir.tar --owner=0 --group=0 --numeric-owner -C \"$oldFilesDir\" \"${oldFiles[@]}\"\n\nsubstituteAllInPlace gettext-runtime/src/gettext.sh.in\nsubstituteInPlace gettext-tools/projects/KDE/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/projects/GNOME/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/src/project-id --replace \"/bin/pwd\" pwd\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHooks":"/nix/store/v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash /nix/store/ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","src":"/nix/store/n4lwy41bnpq1fsqsrf5fac3m7vmhk6sr-gettext-1.0.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"1.0"},"inputs":{"drvs":{"09wib2vw6rcq0xic54hkhl8rysy51xij-update-autotools-gnu-config-scripts-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"ik8rnisbr067lv0hlw46c81rcrnzlv1l-gettext-1.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","v9034cqc4h5bm10z4vz3n1q2n55