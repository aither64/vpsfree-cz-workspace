ckage\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.picom\"},\"description\":\"The picom package to use.\",\"loc\":[\"services\",\"picom\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.picom.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Picom settings. Use this option to configure Picom settings not exposed\\nin a NixOS option or to bypass one. For the available options see the\\nCONFIGURATION FILES section at `picom(1)`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"blur =\\n  { method = \\\"gaussian\\\";\\n    size = 10;\\n    deviation = 5.0;\\n  };\\n\"},\"loc\":[\"services\",\"picom\",\"settings\"],\"readOnly\":false,\"type\":\"libconfig configuration. The format consists of an attributes\\nset (called a group) of settings. Each setting can be a scalar type\\n(boolean, integer, floating point number or string), a list of\\nscalars or a group itself\\n\"},\"services.picom.shadow\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Draw window shadows.\\n\",\"loc\":[\"services\",\"picom\",\"shadow\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.picom.shadowExclude\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of conditions of windows that should have no shadow.\\nSee `picom(1)` man page for more examples.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"window_type *= 'menu'\\\"\\n  \\\"name ~= 'Firefox$'\\\"\\n  \\\"focused = 1\\\"\\n]\"},\"loc\":[\"services\",\"picom\",\"shadowExclude\"],\"readOnly\":false,\"type\":\"list of string\"},\"services.picom.shadowOffsets\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  -15\\n  -15\\n]\"},\"description\":\"Left and right offset for shadows (in pixels).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  -10\\n  -15\\n]\"},\"loc\":[\"services\",\"picom\",\"shadowOffsets\"],\"readOnly\":false,\"type\":\"pair of signed integer\"},\"services.picom.shadowOpacity\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"0.75\"},\"description\":\"Window shadows opacity.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"0.8\"},\"loc\":[\"services\",\"picom\",\"shadowOpacity\"],\"readOnly\":false,\"type\":\"integer or floating point number between 0 and 1 (both inclusive)\"},\"services.picom.vSync\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Enable vertical synchronization.\\n\",\"loc\":[\"services\",\"picom\",\"vSync\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.picom.wintypes\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/picom.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/picom.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  popup_menu = { opacity = config.services.picom.menuOpacity; };\\n  dropdown_menu = { opacity = config.services.picom.menuOpacity; };\\n}\\n\"},\"description\":\"Rules for specific window types.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"loc\":[\"services\",\"picom\",\"wintypes\"],\"readOnly\":false,\"type\":\"attribute set\"},\"services.pimsync.configFile\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pimsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pimsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Optional configuration file to use instead of the default file\\n({file}`$XDG_CONFIG_HOME/pimsync/pimsync.conf`).\\n\",\"loc\":[\"services\",\"pimsync\",\"configFile\"],\"readOnly\":false,\"type\":\"null or absolute path\"},\"services.pimsync.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pimsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pimsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable pimsync.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"pimsync\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.pimsync.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pimsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pimsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.pimsync\"},\"description\":\"The pimsync package to use.\",\"loc\":[\"services\",\"pimsync\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.pimsync.verbosity\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pimsync.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pimsync.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"warn\\\"\"},\"description\":\"The verbosity in which pimsync should log.\",\"loc\":[\"services\",\"pimsync\",\"verbosity\"],\"readOnly\":false,\"type\":\"one of \\\"trace\\\", \\\"debug\\\", \\\"info\\\", \\\"warn\\\", \\\"error\\\"\"},\"services.pipewire.clientConfigs\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Set of configuration files for the PipeWire client library.\\n\\nEvery item in this attrset becomes a separate drop-in file in\\n{file}`$XDG_CONFIG_HOME/pipewire/client.conf.d/`.\\n\\nSee the [PipeWire wiki][wiki] for examples.\\n\\n[wiki]: https://gitlab.freedesktop.org/pipewire/pipewire/-/wikis/Config-client\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"10-no-resample\\\" = {\\n    \\\"stream.properties\\\" = {\\n      \\\"resample.disable\\\" = true;\\n    };\\n  };\\n}\"},\"loc\":[\"services\",\"pipewire\",\"clientConfigs\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"services.pipewire.configPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of packages that provide PipeWire configurations, in the form of\\n{file}`share/pipewire/*/*.conf` files.\\n\\nLV2 dependencies will be picked up from config packages automatically\\nvia `passthru.requiredLv2Packages`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  (pkgs.writeTextDir \\\"share/pipewire/pipewire.conf.d/10-loopback.conf\\\" ''\\n    context.modules = [\\n      {\\n        name = libpipewire-module-loopback\\n        args = {\\n          node.description = \\\"Scarlett Focusrite Line 1\\\"\\n          capture.props = {\\n            audio.position = [ FL ]\\n            stream.dont-remix = true\\n            node.target = \\\"alsa_input.usb-Focusrite_Scarlett_Solo_USB_Y7ZD17C24495BC-00.analog-stereo\\\"\\n            node.passive = true\\n          }\\n          playback.props = {\\n            node.name = \\\"SF_mono_in_1\\\"\\n            media.class = \\\"Audio/Source\\\"\\n            audio.position = [ MONO ]\\n          }\\n        }\\n      }\\n    ]\\n  '')\\n]\"},\"loc\":[\"services\",\"pipewire\",\"configPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"services.pipewire.configs\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Set of configuration files for the PipeWire server.\\n\\nEvery item in this attrset becomes a separate drop-in file in\\n{file}`$XDG_CONFIG_HOME/pipewire/pipewire.conf.d/`.\\n\\nSee `man pipewire.conf` for details, and the [PipeWire wiki] for\\nexamples.\\n\\n[pipewire wiki]: https://gitlab.freedesktop.org/pipewire/pipewire/-/wikis/Config-PipeWire\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"10-clock-rate\\\" = {\\n    \\\"context.properties\\\" = {\\n      \\\"default.clock.rate\\\" = 44100;\\n    };\\n  };\\n  \\\"11-no-upmixing\\\" = {\\n    \\\"stream.properties\\\" = {\\n      \\\"channelmix.upmix\\\" = false;\\n    };\\n  };\\n}\"},\"loc\":[\"services\",\"pipewire\",\"configs\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"services.pipewire.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable PipeWire configurations.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"pipewire\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.pipewire.extraLadspaPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of packages that provide LADSPA plugins, in the form of\\n{file}`lib/ladspa/*` files.\\n\\nLADSPA dependencies will be picked up from config packages automatically\\nvia `passthru.requiredLadspaPackages`, so they don't need to be set here.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.noisetorch-ladspa ]\"},\"loc\":[\"services\",\"pipewire\",\"extraLadspaPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"services.pipewire.extraLv2Packages\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of packages that provide LV2 plugins, in the form of\\n{file}`lib/lv2/*` files.\\n\\nLV2 dependencies will be picked up from config packages automatically\\nvia `passthru.requiredLv2Packages`, so they don't need to be set here.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[ pkgs.lsp-plugins ]\"},\"loc\":[\"services\",\"pipewire\",\"extraLv2Packages\"],\"readOnly\":false,\"type\":\"list of package\"},\"services.pipewire.jackConfigs\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Set of configuration files for the PipeWire JACK server and client\\nlibrary.\\n\\nEvery item in this attrset becomes a separate drop-in file in\\n{file}`$XDG_CONFIG_HOME/pipewire/jack.conf.d/`.\\n\\nSee the [PipeWire wiki] for examples.\\n\\n[pipewire wiki]: https://gitlab.freedesktop.org/pipewire/pipewire/-/wikis/Config-JACK\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"20-hide-midi\\\" = {\\n    \\\"jack.properties\\\" = {\\n      \\\"jack.show-midi\\\" = false;\\n    };\\n  };\\n}\"},\"loc\":[\"services\",\"pipewire\",\"jackConfigs\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"services.pipewire.pulseConfigs\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Set of configuration files for the PipeWire PulseAudio server.\\n\\nEvery item in this attrset becomes a separate drop-in file in\\n{file}`$XDG_CONFIG_HOME/pipewire/pipewire-pulse.conf.d/`.\\n\\nSee `man pipewire-pulse.conf` for details, and the [PipeWire wiki] for\\nexamples.\\n\\n[pipewire wiki]: https://gitlab.freedesktop.org/pipewire/pipewire/-/wikis/Config-PulseAudio\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"15-force-s16-info\\\" = {\\n    \\\"pulse.rules\\\" = [\\n      {\\n        actions = {\\n          quirks = [\\n            \\\"force-s16-info\\\"\\n          ];\\n        };\\n        matches = [\\n          {\\n            \\\"application.process.binary\\\" = \\\"my-broken-app\\\";\\n          }\\n        ];\\n      }\\n    ];\\n  };\\n}\"},\"loc\":[\"services\",\"pipewire\",\"pulseConfigs\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"services.pipewire.wireplumber.configPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of packages that provide WirePlumber configurations, in the form\\nof {file}`share/wireplumber/*/*.conf` files.\\n\\nLV2 dependencies will be picked up from config packages automatically\\nvia `passthru.requiredLv2Packages`.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  (pkgs.writeTextDir \\\"share/wireplumber/wireplumber.conf.d/10-bluez.conf\\\" ''\\n    monitor.bluez.properties = {\\n      bluez5.roles = [ a2dp_sink a2dp_source bap_sink bap_source hsp_hs hsp_ag hfp_hf hfp_ag ]\\n      bluez5.codecs = [ sbc sbc_xq aac ]\\n      bluez5.enable-sbc-xq = true\\n      bluez5.hfphsp-backend = \\\"native\\\"\\n    }\\n  '')\\n]\"},\"loc\":[\"services\",\"pipewire\",\"wireplumber\",\"configPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"services.pipewire.wireplumber.configs\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Set of configuration files for the WirePlumber daemon.\\n\\nEvery item in this attrset becomes a separate drop-in file in\\n{file}`$XDG_CONFIG_HOME/wireplumber/wireplumber.conf.d/`.\\n\\nSee the [NixOS option] for details.\\n\\n[nixos option]: https://search.nixos.org/options?channel=25.11&type=options&show=services.pipewire.wireplumber.extraConfig\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  log-level-debug = {\\n    \\\"context.properties\\\" = {\\n      \\\"log.level\\\" = \\\"D\\\";\\n    };\\n  };\\n  wh-1000xm3-ldac-hq = {\\n    \\\"monitor.bluez.rules\\\" = [\\n      {\\n        actions = {\\n          update-props = {\\n            \\\"bluez5.a2dp.ldac.quality\\\" = \\\"hq\\\";\\n          };\\n        };\\n        matches = [\\n          {\\n            \\\"device.name\\\" = \\\"~bluez_card.*\\\";\\n            \\\"device.product.id\\\" = \\\"0x0cd3\\\";\\n            \\\"device.vendor.id\\\" = \\\"usb:054c\\\";\\n          }\\n        ];\\n      }\\n    ];\\n  };\\n}\"},\"loc\":[\"services\",\"pipewire\",\"wireplumber\",\"configs\"],\"readOnly\":false,\"type\":\"attribute set of (JSON value)\"},\"services.pipewire.wireplumber.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable WirePlumber configurations.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"pipewire\",\"wireplumber\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.pipewire.wireplumber.scriptPackages\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"List of packages that provide WirePlumber scripts, in the form of\\n{file}`share/wireplumber/scripts/*/*.lua` files.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  (pkgs.writeTextDir \\\"share/wireplumber/scripts/test/hello-world.lua\\\" ''\\n    print(\\\"Hello, world!\\\")\\n  '')\\n]\"},\"loc\":[\"services\",\"pipewire\",\"wireplumber\",\"scriptPackages\"],\"readOnly\":false,\"type\":\"list of package\"},\"services.pipewire.wireplumber.scripts\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pipewire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pipewire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Set of lua scripts to be used by WirePlumber configuration files.\\n\\nEvery item in this attrset becomes a separate drop-in file in\\n{file}`$XDG_DATA_HOME/wireplumber/scripts/`.\\n\\nSee the [NixOS option] for details.\\n\\n[nixos option]: https://search.nixos.org/options?channel=25.11&type=options&show=services.pipewire.wireplumber.extraScripts\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"test/hello-world.lua\\\" = ''\\n    print(\\\"Hello, world!\\\")\\n  '';\\n}\"},\"loc\":[\"services\",\"pipewire\",\"wireplumber\",\"scripts\"],\"readOnly\":false,\"type\":\"attribute set of strings concatenated with \\\"\\\\n\\\"\"},\"services.pizauth.accounts\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Pizauth accounts that should be configured\",\"loc\":[\"services\",\"pizauth\",\"accounts\"],\"readOnly\":false,\"type\":\"attribute set of (submodule)\"},\"services.pizauth.accounts.<name>.authUri\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"description\":\"The OAuth2 server's authentication URI.\\n\",\"loc\":[\"services\",\"pizauth\",\"accounts\",\"<name>\",\"authUri\"],\"readOnly\":false,\"type\":\"string\"},\"services.pizauth.accounts.<name>.clientId\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"description\":\"The OAuth2 client ID.\\n\",\"loc\":[\"services\",\"pizauth\",\"accounts\",\"<name>\",\"clientId\"],\"readOnly\":false,\"type\":\"string\"},\"services.pizauth.accounts.<name>.clientSecret\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"The OAuth2 client secret.\\n\",\"loc\":[\"services\",\"pizauth\",\"accounts\",\"<name>\",\"clientSecret\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.pizauth.accounts.<name>.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Additional configuration that will be added to the account configuration. See pizauth.conf(5) for available options.\\n\",\"loc\":[\"services\",\"pizauth\",\"accounts\",\"<name>\",\"extraConfig\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.pizauth.accounts.<name>.loginHint\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"An optional login hint for the account provider.\\n\",\"loc\":[\"services\",\"pizauth\",\"accounts\",\"<name>\",\"loginHint\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.pizauth.accounts.<name>.name\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"description\":\"Unique identifier of the account. This is set to the\\nattribute name of the account configuration.\\n\",\"loc\":[\"services\",\"pizauth\",\"accounts\",\"<name>\",\"name\"],\"readOnly\":true,\"type\":\"string\"},\"services.pizauth.accounts.<name>.scopes\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"The scopes which the OAuth2 token will give access to. Optional.\\nNote that Office365 requires the non-standard \\\"offline_access\\\" scope to be specified in order for pizauth to be able to operate successfully.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"https://outlook.office365.com/IMAP.AccessAsUser.All\\\"\\n  \\\"https://outlook.office365.com/SMTP.Send\\\"\\n  \\\"offline_access\\\"\\n]\"},\"loc\":[\"services\",\"pizauth\",\"accounts\",\"<name>\",\"scopes\"],\"readOnly\":false,\"type\":\"null or (list of string)\"},\"services.pizauth.accounts.<name>.tokenUri\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"description\":\"The OAuth2 server's token URI.\\n\",\"loc\":[\"services\",\"pizauth\",\"accounts\",\"<name>\",\"tokenUri\"],\"readOnly\":false,\"type\":\"string\"},\"services.pizauth.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Pizauth, a commandline OAuth2 authentication daemon\\n.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"pizauth\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.pizauth.extraConfig\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Additional global configuration. See pizauth.conf(5) for a available options.\",\"loc\":[\"services\",\"pizauth\",\"extraConfig\"],\"readOnly\":false,\"type\":\"null or string\"},\"services.pizauth.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/pizauth.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/pizauth.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.pizauth\"},\"description\":\"The pizauth package to use.\",\"loc\":[\"services\",\"pizauth\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.plan9port.fontsrv.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/plan9port.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/plan9port.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the Plan 9 file system access to host fonts.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"services\",\"plan9port\",\"fontsrv\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.plan9port.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/plan9port.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/plan9port.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.plan9port\"},\"description\":\"The plan9port package to use.\",\"loc\":[\"services\",\"plan9port\",\"package\"],\"readOnly\":false,\"type\":\"package\"},\"services.plan9port.plumber.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/plan9port.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/plan9port.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\"