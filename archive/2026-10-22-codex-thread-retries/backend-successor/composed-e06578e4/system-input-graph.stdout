sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Extra configuration lines to add to ~/.config/sway/config.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"extraConfig\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"wayland.windowManager.sway.extraConfigEarly\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Like extraConfig, except lines are added to ~/.config/sway/config before all other configuration.\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"extraConfigEarly\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"wayland.windowManager.sway.extraOptions\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[ ]\"},\"description\":\"Command line arguments passed to launch Sway. Please DO NOT report\\nissues if you use an unsupported GPU (proprietary drivers).\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--verbose\\\"\\n  \\\"--debug\\\"\\n  \\\"--unsupported-gpu\\\"\\n  \\\"--my-next-gpu-wont-be-nvidia\\\"\\n]\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"extraOptions\"],\"readOnly\":false,\"type\":\"list of string\"},\"wayland.windowManager.sway.extraSessionCommands\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"\\\"\"},\"description\":\"Shell commands executed just before Sway is started.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"''\\n  export SDL_VIDEODRIVER=wayland\\n  # needs qt5.qtwayland in systemPackages\\n  export QT_QPA_PLATFORM=wayland\\n  export QT_WAYLAND_DISABLE_WINDOWDECORATION=\\\"1\\\"\\n  # Fix for some Java AWT applications (e.g. Android Studio),\\n  # use this if they aren't displayed properly:\\n  export _JAVA_AWT_WM_NONREPARENTING=1\\n''\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"extraSessionCommands\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\"\\\\n\\\"\"},\"wayland.windowManager.sway.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"${pkgs.sway}\"},\"description\":\"Sway package to use. Will override the options\\n'wrapperFeatures', 'extraSessionCommands', and 'extraOptions'.\\nSet to `null` to not add any Sway package to your\\npath. This should be done if you want to use the NixOS Sway\\nmodule to install Sway. Beware setting to `null` will also disable\\nreloading Sway when new config is activated.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"wayland.windowManager.sway.swaynag.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/swaynag.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/swaynag.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable configuration of swaynag, a lightweight error bar for sway.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"swaynag\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.sway.swaynag.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/swaynag.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/swaynag.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Configuration written to\\n{file}`$XDG_CONFIG_HOME/swaynag/config`.\\n\\nSee\\n{manpage}`swaynag(5)`\\nfor a list of available options and an example configuration.\\nNote, configurations declared under `<config>`\\nwill override the default type values of swaynag.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  \\\"<config>\\\" = {\\n    edge = \\\"bottom\\\";\\n    font = \\\"Dina 12\\\";\\n  };\\n\\n  green = {\\n    edge = \\\"top\\\";\\n    background = \\\"00AA00\\\";\\n    text = \\\"FFFFFF\\\";\\n    button-background = \\\"00CC00\\\";\\n    message-padding = 10;\\n  };\\n}\\n\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"swaynag\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of attribute set of (Swaynag config atom (null, bool, int, float, str))\"},\"wayland.windowManager.sway.systemd.dbusImplementation\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"dbus\\\"\"},\"description\":\"The D-Bus implementation used on the system.\\nThis affects which tool is used to import environment variables when starting the Sway session.\\nOn NixOS, this should match the value of the option [`services.dbus.implementation` (NixOS)](https://nixos.org/manual/nixos/stable/options#opt-services.dbus.implementation).\\nWhen set to `dbus`, `dbus-update-activation-environment --systemd <variables>` is run.\\nOtherwise, when set to `broker`, `systemctl --user import-environment <variables>` is run.\\nSee <https://github.com/swaywm/sway/wiki#systemd-and-dbus-activation-environments> for more documentation.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"broker\\\"\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"systemd\",\"dbusImplementation\"],\"readOnly\":false,\"type\":\"one of \\\"dbus\\\", \\\"broker\\\"\"},\"wayland.windowManager.sway.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable {file}`sway-session.target` on\\nsway startup. This links to\\n{file}`graphical-session.target`.\\nSome important environment variables will be imported to systemd\\nand dbus user environment before reaching the target, including\\n* {env}`DISPLAY`\\n* {env}`WAYLAND_DISPLAY`\\n* {env}`SWAYSOCK`\\n* {env}`XDG_CURRENT_DESKTOP`\\n* {env}`XDG_SESSION_TYPE`\\n* {env}`NIXOS_OZONE_WL`\\n* {env}`XCURSOR_THEME`\\n* {env}`XCURSOR_SIZE`\\nYou can extend this list using the `systemd.variables` option.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.sway.systemd.extraCommands\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"systemctl --user reset-failed\\\"\\n  \\\"systemctl --user start sway-session.target\\\"\\n  \\\"swaymsg -mt subscribe '[]' || true\\\"\\n  \\\"systemctl --user stop sway-session.target\\\"\\n]\"},\"description\":\"Extra commands to run after D-Bus activation.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"systemd\",\"extraCommands\"],\"readOnly\":false,\"type\":\"list of string\"},\"wayland.windowManager.sway.systemd.variables\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"DISPLAY\\\"\\n  \\\"WAYLAND_DISPLAY\\\"\\n  \\\"SWAYSOCK\\\"\\n  \\\"XDG_CURRENT_DESKTOP\\\"\\n  \\\"XDG_SESSION_TYPE\\\"\\n  \\\"NIXOS_OZONE_WL\\\"\\n  \\\"XCURSOR_THEME\\\"\\n  \\\"XCURSOR_SIZE\\\"\\n]\"},\"description\":\"Environment variables imported into the systemd and D-Bus user environment.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"--all\\\"\\n]\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"systemd\",\"variables\"],\"readOnly\":false,\"type\":\"list of string\"},\"wayland.windowManager.sway.systemd.xdgAutostart\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable autostart of applications using\\n{manpage}`systemd-xdg-autostart-generator(8)`\\n.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"systemd\",\"xdgAutostart\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.sway.wrapperFeatures\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Attribute set of features to enable in the wrapper.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  gtk = true;\\n}\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"wrapperFeatures\"],\"readOnly\":false,\"type\":\"submodule\"},\"wayland.windowManager.sway.wrapperFeatures.base\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to make use of the base wrapper to execute extra session commands and prepend a\\ndbus-run-session to the sway command.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"wrapperFeatures\",\"base\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.sway.wrapperFeatures.gtk\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to make use of the wrapGAppsHook wrapper to execute sway with required environment\\nvariables for GTK applications.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"wrapperFeatures\",\"gtk\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.sway.xwayland\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/i3-sway/sway.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/i3-sway/sway.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Enable xwayland, which is needed for the default configuration of sway.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"sway\",\"xwayland\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.wayfire.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/wayfire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/wayfire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable Wayfire, a wayland compositor based on wlroots.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"wayfire\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.wayfire.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/wayfire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/wayfire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"pkgs.wayfire\"},\"description\":\"The wayfire package to use. Set to `null` to not add any wayfire package to your path.\\nThis should be done if you want to use the NixOS wayfire module to install wayfire.\\n\",\"loc\":[\"wayland\",\"windowManager\",\"wayfire\",\"package\"],\"readOnly\":false,\"type\":\"null or package\"},\"wayland.windowManager.wayfire.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/wayfire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/wayfire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs.wayfirePlugins; [ wf-shell ]\"},\"description\":\"Additional plugins to use with wayfire\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"with pkgs.wayfirePlugins; [\\n  wcm\\n  wf-shell\\n  wayfire-plugins-extra\\n];\\n\"},\"loc\":[\"wayland\",\"windowManager\",\"wayfire\",\"plugins\"],\"readOnly\":false,\"type\":\"list of package\"},\"wayland.windowManager.wayfire.settings\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/wayfire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/wayfire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"{ }\"},\"description\":\"Wayfire configuration written in Nix.\\n\\nSee <https://github.com/WayfireWM/wayfire/wiki/Configuration>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  command = {\\n    binding_terminal = \\\"alacritty\\\";\\n    command_terminal = \\\"alacritty\\\";\\n  };\\n  core = {\\n    plugins = \\\"command expo cube\\\";\\n  };\\n}\"},\"loc\":[\"wayland\",\"windowManager\",\"wayfire\",\"settings\"],\"readOnly\":false,\"type\":\"open submodule of attribute set of attribute set of (string or absolute path or boolean or signed integer or floating point number)\"},\"wayland.windowManager.wayfire.settings.core.plugins\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/wayfire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/wayfire.nix\"}],\"description\":\"Load the specified plugins\",\"loc\":[\"wayland\",\"windowManager\",\"wayfire\",\"settings\",\"core\",\"plugins\"],\"readOnly\":false,\"type\":\"strings concatenated with \\\" \\\"\"},\"wayland.windowManager.wayfire.systemd.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/wayfire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/wayfire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Whether to enable {file}`wayfire-session.target` on\\nwayfire startup. This links to {file}`graphical-session.target`}.\\nSome important environment variables will be imported to systemd\\nand D-Bus user environment before reaching the target, including\\n- `DISPLAY`\\n- `WAYLAND_DISPLAY`\\n- `XDG_CURRENT_DESKTOP`\\n- `NIXOS_OZONE_WL`\\n- `XCURSOR_THEME`\\n- `XCURSOR_SIZE`\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"wayland\",\"windowManager\",\"wayfire\",\"systemd\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"wayland.windowManager.wayfire.systemd.extraCommands\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/wayfire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/wayfire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"systemctl --user stop wayfire-session.target\\\"\\n  \\\"systemctl --user start wayfire-session.target\\\"\\n]\"},\"description\":\"Extra commands to be run after D-Bus activation.\",\"loc\":[\"wayland\",\"windowManager\",\"wayfire\",\"systemd\",\"extraCommands\"],\"readOnly\":false,\"type\":\"list of string\"},\"wayland.windowManager.wayfire.systemd.variables\":{\"declarations\":[{\"name\":\"<home-manager/modules/services/window-managers/wayfire.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/services/window-managers/wayfire.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"DISPLAY\\\"\\n  \\\"WAYLAND_DISPLAY\\\"\\n  \\\"XDG_CURRENT_DESKTOP\\\"\\n  \\\"NIXOS_OZONE_WL\\\"\\n  \\\"XCURSOR_THEME\\\"\\n  \\\"XCURSOR_SIZE\\\"\\n]\"},\"description\":\"Environment variables to be imported in the systemd & D-Bus user\\nenvironment.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"[\\n  \\\"-all\\\"\\n]\"},\"loc\":[\"wayland\",\"windowManager\",\"wayfire\",\"systemd\",\"variables\"],\"readOnly\":false,\"type\