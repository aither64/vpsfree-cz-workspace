lib-1.3.2-dev /nix/store/mhy634114a25wmcc6l64kzwi2cgyqsc3-sqlite-3.51.2-dev","buildPhase":"runHook preBuild\n\nsed -i 's|nss_dist_dir=\"$dist_dir\"|nss_dist_dir=\"'$out'\"|;s|nss_dist_obj_dir=\"$obj_dir\"|nss_dist_obj_dir=\"'$out'\"|' build.sh\n./build.sh -v --opt --with-nspr=/nix/store/460plj4x9mdb3b8qa4fajsmvz39yq2lf-nspr-4.40-dev/include:/nix/store/gaf40dri3fffq7qynvx4kblf7x4gs637-nspr-4.40/lib --system-sqlite --enable-legacy-db --target x64 -Dhost_arch=x64 -Duse_system_zlib=1 --enable-libpkix -j $NIX_BUILD_CORES\n\nrunHook postBuild\n","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/yh2c6wgd2q1p7b761v4vln0qr8c22wjp-nss-3.112.5-dev","doCheck":"","doInstallCheck":"","installPhase":"runHook preInstall\n\nrm -rf $out/private\nfind $out -name \"*.TOC\" -delete\nmv $out/public $out/include\n\nln -s lib $out/lib64\n\n# Upstream issue: https://bugzilla.mozilla.org/show_bug.cgi?id=530672\n# https://gitweb.gentoo.org/repo/gentoo.git/plain/dev-libs/nss/files/nss-3.32-gentoo-fixups.patch?id=af1acce6c6d2c3adb17689261dfe2c2b6771ab8a\nNSS_MAJOR_VERSION=`grep \"NSS_VMAJOR\" lib/nss/nss.h | awk '{print $3}'`\nNSS_MINOR_VERSION=`grep \"NSS_VMINOR\" lib/nss/nss.h | awk '{print $3}'`\nNSS_PATCH_VERSION=`grep \"NSS_VPATCH\" lib/nss/nss.h | awk '{print $3}'`\nPREFIX=\"$out\"\n\nmkdir -p $out/lib/pkgconfig\nsed -e \"s,%prefix%,$PREFIX,\" \\\n    -e \"s,%exec_prefix%,$PREFIX,\" \\\n    -e \"s,%libdir%,$PREFIX/lib64,\" \\\n    -e \"s,%includedir%,$dev/include/nss,\" \\\n    -e \"s,%NSS_VERSION%,$NSS_MAJOR_VERSION.$NSS_MINOR_VERSION.$NSS_PATCH_VERSION,g\" \\\n    -e \"s,%NSPR_VERSION%,4.16,g\" \\\n    pkg/pkg-config/nss.pc.in > $out/lib/pkgconfig/nss.pc\nchmod 0644 $out/lib/pkgconfig/nss.pc\n\nsed -e \"s,@prefix@,$PREFIX,\" \\\n    -e \"s,@MOD_MAJOR_VERSION@,$NSS_MAJOR_VERSION,\" \\\n    -e \"s,@MOD_MINOR_VERSION@,$NSS_MINOR_VERSION,\" \\\n    -e \"s,@MOD_PATCH_VERSION@,$NSS_PATCH_VERSION,\" \\\n    pkg/pkg-config/nss-config.in > $out/bin/nss-config\nchmod 0755 $out/bin/nss-config\n\ninstallManPage doc/nroff/*\n","man":"/nix/store/amv6ilbvihy1vjh4z1qmf4c7sq5ldr16-nss-3.112.5-man","mesonFlags":"","name":"nss-3.112.5","nativeBuildInputs":"/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3 /nix/store/jl5zl7fan8qvlyc8hl5sl48q4l00yzm4-ninja-1.13.2 /nix/store/a2k53h27j1ldaflgw0bihnmxn4kzvrg8-python3-3.13.15-env /nix/store/in3nqj51pch28k23pj7b0g19m7jamfpa-install-shell-files","out":"/nix/store/drjp55ma7i0kw6cv8km2hy2iqsqgif3b-nss-3.112.5","outputs":"out dev tools man","patches":"/nix/store/6w94vq4d02h3fkvnpr4qmy6npzfd5sd2-85_security_load_3.85+.patch /nix/store/a5skdyvh7a4iap5bpvlrxfq68y330xli-fix-cross-compilation.patch","pname":"nss","postFixup":"moveToOutput bin \"$tools\"\nmoveToOutput bin/nss-config \"$dev\"\nmoveToOutput lib/libcrmf.a \"$dev\" # needed by firefox, for example\nrm -f \"$out\"/lib/*.a\n\nrunHook postInstall\n","postInstall":"# Replace built-in trust with p11-kit connection\nln -sf /nix/store/m5xp1zkb0pbxlhglclq425sx0sfbcyys-p11-kit-0.26.2/lib/pkcs11/p11-kit-trust.so $out/lib/libnssckbi.so\n","postPatch":"patchShebangs .\n\nfor f in coreconf/config.gypi build.sh; do\n  substituteInPlace \"$f\" --replace \"/usr/bin/env\" \"/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/env\"\ndone\n\nsubstituteInPlace coreconf/config.gypi --replace \"/usr/bin/grep\" \"/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin/env grep\"\n","propagatedBuildInputs":"/nix/store/460plj4x9mdb3b8qa4fajsmvz39yq2lf-nspr-4.40-dev","propagatedNativeBuildInputs":"","src":"/nix/store/9jzzx8r3mdwbjr6f1a6vr4cn4idcbnwd-source","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDep