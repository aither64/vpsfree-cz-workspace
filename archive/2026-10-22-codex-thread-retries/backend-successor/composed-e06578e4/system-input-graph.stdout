fault\":{\"_type\":\"literalExpression\",\"text\":\"if lib.versionAtLeast config.home.stateVersion \\\"25.11\\\" then { } else { PASSWORD_STORE_DIR = \\\"$XDG_DATA_HOME/password-store\\\"; }\\n\"},\"description\":\"The `pass` environment variables dictionary.\\n\\nSee the \\\"Environment variables\\\" section of\\n{manpage}`pass(1)`\\nand the extension man pages for more information about the\\navailable keys.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"{\\n  PASSWORD_STORE_DIR = \\\"$\\\\{config.xdg.dataHome\\\\}/password-store\\\";\\n  PASSWORD_STORE_KEY = \\\"12345678\\\";\\n  PASSWORD_STORE_CLIP_TIME = \\\"60\\\";\\n}\\n\"},\"loc\":[\"programs\",\"password-store\",\"settings\"],\"readOnly\":false,\"type\":\"attribute set of string\"},\"programs.patdiff.enable\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/patdiff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/patdiff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable the {command}`patdiff` differ.\\nSee <https://opensource.janestreet.com/patdiff/>\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"loc\":[\"programs\",\"patdiff\",\"enable\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.patdiff.enableGitIntegration\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/patdiff.nix>\",\"url\":\"https://github.com/nix-community/home-manager/blob/release-26.05/modules/programs/patdiff.nix\"}],\"default\":{\"_type\":\"literalExpression\",\"text\":\"false\"},\"description\":\"Whether to enable git integration for patdiff.\\n\\nWhen enabled, patdiff will be configured as git's external diff tool.\\n\",\"loc\":[\"programs\",\"patdiff\",\"enableGitIntegration\"],\"readOnly\":false,\"type\":\"boolean\"},\"programs.patdiff.package\":{\"declarations\":[{\"name\":\"<home-manager/modules/programs/patdiff.nix>\",\"url\":\"https://github.com/nix-commun