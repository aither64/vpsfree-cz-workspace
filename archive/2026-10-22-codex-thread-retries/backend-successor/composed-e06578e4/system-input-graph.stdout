ncher\nmoveToOutput bin/gtk-launch \"$out\"\n# Broadway daemon\nmoveToOutput bin/broadwayd \"$out\"\n\n# TODO: patch glib directly\nfor f in $dev/bin/gtk-encode-symbolic-svg; do\n  wrapProgram $f --prefix XDG_DATA_DIRS : \"/nix/store/hd953f5ip68fv4v1dniwqdqk2ckr56r8-shared-mime-info-2.4/share\"\ndone\nGTK_PATH=\"${out:?}/lib/gtk-3.0/3.0.0/immodules/\" ${dev:?}/bin/gtk-query-immodules-3.0 > \"${out:?}/lib/gtk-3.0/3.0.0/immodules.cache\"\n","postPatch":"# See https://github.com/NixOS/nixpkgs/issues/132259\nsubstituteInPlace meson.build \\\n  --replace \"x11_enabled = false\" \"\"\n\n# this conditional gates the installation of share/gsettings-schemas/.../glib-2.0/schemas/gschemas.compiled.\nsubstituteInPlace meson.build \\\n  --replace 'if not meson.is_cross_build()' 'if true'\n\nfiles=(\n  build-aux/meson/post-install.py\n  demos/gtk-demo/geninclude.py\n  gdk/broadway/gen-c-array.py\n  gdk/gen-gdk-gresources-xml.py\n  gtk/cursor/dnd-copy.png\n  gtk/gen-gtk-gresources-xml.py\n  gtk/gen-rc.py\n  gtk/gentypefuncs.py\n)\n\nchmod +x ${files[@]}\npatchShebangs ${files[@]}\n","propagatedBuildInputs":"/nix/store/gjyzl00h59iqk2sk35qxcsm92bix35dz-at-spi2-core-2.60.7-dev /nix/store/gjyzl00h59iqk2sk35qxcsm92bix35dz-at-spi2-core-2.60.7-dev /nix/store/81m2dk5q89amcgd2zsrzqad6ah1mr8vv-cairo-1.18.4-dev /nix/store/4z7x3563mcg0whqads5wa149hsvy6c44-expat-2.8.5-dev /nix/store/1v37xwhb7apkk75lcwn3zpfapm6vc4km-fribidi-1.0.17-dev /nix/store/rqcmmqacd2v13h5zibr6463h2c0yf4cm-gdk-pixbuf-2.44.8-dev /nix/store/d0vv6yniq5vhdm7dg7nvnpbinrkcr36y-glib-2.88.3-dev /nix/store/1qc14bhn0a3awjj1jq7mkgk43jrpviy8-gsettings-desktop-schemas-50.1 /nix/store/s1jbv67n1284qz7pzdswj90py59iqgw8-libice-1.1.2-dev /nix/store/h43qzlmwx97ncvlajn9rbaxiwjlkbiz2-libsm-1.2.6-dev /nix/store/mnglsb8qg28xylph2kjn4z0pxamn3lx1-libxcomposite-0.4.7-dev /nix/store/ppvdyxcwk3nb9im1fl81n4bblx16a9pa-libxcursor-1.2.3-dev /nix/store/xjdcip8bjilhyn0w3h0ic9n4q0jmy6ib-libxdamage-1.1.7-dev /nix/store/ihycnsbl35qxjybiray9vg5nil6banah-libxfi