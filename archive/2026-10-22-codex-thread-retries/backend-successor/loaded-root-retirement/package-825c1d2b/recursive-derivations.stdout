h=/nix/store/f75aywwsd4qy38800bpzb1xmx1ngqymg-simdutf-6.5.0/lib","--shared-sqlite","--shared-sqlite-libpath=/nix/store/p774nkfb6frncliffdsyppg93n3cpb4b-sqlite-3.51.2/lib","--shared-uvwasi","--shared-uvwasi-libpath=/nix/store/mi7n5jkmjlycsshfn140m8adm4j13cr7-uvwasi-0.0.23/lib","--shared-zlib","--shared-zlib-libpath=/nix/store/l68i51npb6nlxi6z18gvgb45dz3xr5yp-zlib-1.3.2/lib","--shared-zstd","--shared-zstd-libpath=/nix/store/am2hi8dgk0qfngq41nvr4835m19b68j8-zstd-1.5.7/lib"],"configurePlatforms":[],"configureScript":"/nix/store/xqnbm0vgqcq9b1b54c80qj9s0qhbwa08-python3-3.13.15/bin/python3.13 configure.py","depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":true,"doInstallCheck":false,"dontDisableStatic":true,"dontUseNinjaBuild":true,"dontUseNinjaCheck":true,"dontUseNinjaInstall":true,"enableParallelBuilding":true,"enableParallelChecking":false,"enableParallelInstalling":true,"env":{"NINJA":"TERM=dumb ninja","NIX_MAIN_PROGRAM":"node"},"mesonFlags":[],"moveToDev":false,"name":"nodejs-slim-24.19.0","nativeBuildInputs":["/nix/store/v2i3m4k78qypvizq4igm1izik677c47p-install-shell-files","/nix/store/60z9n8f7cczph0klb7ny1mikhd8m1vkl-ninja-1.13.2","/nix/store/ginjcfdxm2lxqa0inajhbir7395wnvwx-pkgconf-wrapper-2.5.1","/nix/store/xqnbm0vgqcq9b1b54c80qj9s0qhbwa08-python3-3.13.15"],"outputChecks":{"corepack":{"disallowedReferences":["libv8","npm"]},"dev":{},"libv8":{"disallowedReferences":["out","npm","corepack"]},"npm":{"disallowedReferences":["libv8","corepack"]},"out":{"disallowedReferences":["libv8","npm","corepack"]}},"outputs":["out","libv8","npm","corepack","dev"],"patches":["/nix/store/j4p9lc7z8hi4g40cpqpj3qxb9a7bvanp-configure-armv6-vfpv2.patch","/nix/store/igz0qnjkvwi4f2mn7i13h3ndxl9n5ryi-node-npm-build-npm-package-logic.patch","/nix/store/57n0csr7hpdd0y91ljxpiwlfw7fsx3kl-use-correct-env-in-tests.patch","/nix/store/p2mhv95s89kaqmdynhz6y6asalf8y4dh-bin-sh-node-run-v22.patch","/nix/store/3za8p3x3hjfr1a9b1lc3z4aapp9sm2ja-use-nix-codesign.patch","/nix/store/nf5qia29mzasf2idq21pldcbxyxgwdjy-869d0cbca3b0b5e594b3254869a34d549664e089.patch?full_index=1"],"pname":"nodejs-slim","postConfigure":"","postFixup":"HOST_PATH=$out/bin patchShebangs --host $out $corepack $npm\n\nfor dir in \"$npm/lib/node_modules/npm/man/\"*; do\n  mkdir -p $npm/share/man/$(basename \"$dir\")\n  for page in \"$dir\"/*; do\n    ln -rs $page $npm/share/man/$(basename \"$dir\")\n  done\ndone\n","postInstall":"mkdir -p $dev/bin\ncp out/Release/{bytecode_builtins_list_generator,mksnapshot,torque,node_js2c,gen-regexp-special-case} $dev/bin\n\n$out/bin/node --completion-bash > node.bash\ninstallShellCompletion node.bash\n\n\nmkdir -p $npm/share/bash-completion/completions\nln -s $npm/lib/node_modules/npm/lib/utils/completion.sh \\\n  $npm/share/bash-completion/completions/npm\n\n# install the missing headers for node-gyp\n# TODO: use propagatedBuildInputs instead of copying headers.\ncp -r /nix/store/6fw0jqyxd1hcs1h7jgpw5jbmr01rzhsn-ada-3.4.4/include/* /nix/store/fks4cgmhydqxs4vqdmqdms775qw9h6m3-brotli-1.2.0-dev/include/* /nix/store/xndxc5hizqpdl8gzkidvzc4yh0jgndi0-c-ares-1.34.8-dev/include/* /nix/store/7d9dcvf8v7mdw1d6qkzywqkx5zcpwf0m-llhttp-9.4.3-dev/include/* /nix/store/b9y01aknbnqrglnrg6x31ncnjfvyn221-libuv-1.52.1-dev/include/* /nix/store/v87pkvz8m4w5dfgimw1gzv3lsc8baf1d-merve-1.2.2/include/* /nix/store/xk7x0m6n0yhs9p6dmhxlah0v625fs332-nghttp2-1.69.0-dev/include/* /nix/store/hbnl13kyqd616w0dpvcq4v4kpd9gnf5a-nghttp3-1.15.0-dev/include/* /nix/store/qmsk1djpcw923mhqn8qr82jpf5jhmcby-ngtcp2-1.22.1-dev/include/* /nix/store/6snylzb0haf89m5xwkc7x9vvinkcmj41-openssl-3.6.3-dev/include/* /nix/store/fvvqz9jrzgx01bjair7sipbmf8kw4j3n-simdjson-4.6.4/include/* /nix/store/f75aywwsd4qy38800bpzb1xmx1ngqymg-simdutf-6.5.0/include/* /nix/store/nabvcs2dqhnfckjv0vb5v6hx5m404l5x-sqlite-3.51.2-dev/include/* /nix/store/mi7n5jkmjlycsshfn140m8adm4j13cr7-uvwasi-0.0.23/include/* /nix/store/0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev/include/* /nix/store/n0adwsx0sxhrfq6x32zm2is31xzhaf5y-zstd-1.5.7-dev/include/* $out/include/node\n\n# assemble a static v8 library and put it in the 'libv8' output\nmkdir -p $libv8/lib\npushd out/Release/obj\nfind . -path \"**/torque_*/**/*.o\" -or -path \"**/v8*/**/*.o\" \\\n  -and -not -name \"torque.*\" \\\n  -and -not -name \"mksnapshot.*\" \\\n  -and -not -name \"gen-regexp-special-case.*\" \\\n  -and -not -name \"bytecode_builtins_list_generator.*\" \\\n  | sort -u >files\ntest -s files # ensure that the list is not empty\n$AR -cqs $libv8/lib/libv8.a @files\npopd\n\n# copy v8 headers\ncp -r deps/v8/include $libv8/\n\n# create a pkgconfig file for v8\nmajor=$(grep V8_MAJOR_VERSION deps/v8/include/v8-version.h | cut -d ' ' -f 3)\nminor=$(grep V8_MINOR_VERSION deps/v8/include/v8-version.h | cut -d ' ' -f 3)\npatch=$(grep V8_PATCH_LEVEL deps/v8/include/v8-version.h | cut -d ' ' -f 3)\nmkdir -p $libv8/lib/pkgconfig\ncat > $libv8/lib/pkgconfig/v8.pc << EOF\nName: v8\nDescription: V8 JavaScript Engine\nVersion: $major.$minor.$patch\nLibs: -L$libv8/lib -lv8 -pthread -licui18n -licuuc\nCflags: -I$libv8/include\nEOF\ncp -r $out/include $dev/include\n","postPatch":"substituteInPlace tools/install.py \\\n  --replace-fail '  corepack_files(options, action)' \"  oip=options.install_path;options.install_path='$corepack';corepack_files(options, action);options.install_path=oip\" \\\n  --replace-fail '  npm_files(options, action)' \"  oip=options.install_path;options.install_path='$npm';npm_files(options, action);options.install_path=oip\"\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"setOutputFlags":false,"setupHook":"/nix/store/ay9ps6p97mf12nybf9d4r3nyina81b87-setup-hook.sh","src":"/nix/store/7w9s1sbk3zf9x41g1fqmcjp5rxd7anap-node-v24.19.0.tar.xz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps"