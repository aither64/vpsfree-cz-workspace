ts","man"],"patches":["/nix/store/l72fh575sg53gsvndaz7sw0b996h57cc-search-paths.patch"],"pname":"kbd","postInstall":"substituteInPlace $out/bin/unicode_{start,stop} \\\n  --replace-fail /usr/bin/tty /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/tty\n\nmoveToOutput bin/unicode_start $scripts\nmoveToOutput bin/unicode_stop $scripts\n","postPatch":"# Renaming keymaps with name clashes, because loadkeys just picks\n# the first keymap it sees. The clashing names lead to e.g.\n# \"loadkeys no\" defaulting to a norwegian dvorak map instead of\n# the much more common qwerty one.\npushd data/keymaps/i386\nmv qwertz/cz{,-qwertz}.map\nmv olpc/es{,-olpc}.map\nmv olpc/pt{,-olpc}.map\nmv fgGIod/trf{,-fgGIod}.map\nmv colemak/{en-latin9,colemak}.map\npopd\n","preConfigure":"# Perl and Bash only used during build time\npatchShebangs --build contrib/\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"src":"/nix/store/592smawrsjbsg0hl1vfqjyfz2nydgp9v-kbd","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"2.9.0"},"system":"x86_64-linux","version":4},"l9j90v4nlsfd1zgmxhz6y4f4nrjnnlr0-gnupatch-2.5.9-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"gnupatch-2.5.9-builder","out":"/nix/store/jmxskfr3aj6ih0k90lwmxj9z2jjrzh90-gnupatch-2.5.9-builder","passAsFile":"text","system":"x86_64-linux","text":"# Unpack\nungz --file /nix/store/q9qicy85fzbs1fzn98hl231bah798m48-patch-2.5.9.tar.gz --output patch.tar\nuntar --file patch.tar\nrm patch.tar\ncd patch-2.5.9\n\n# Configure\ncatm config.h\n\n# Build\nalias CC=\"tcc -B /nix/store/rayh0cq2ik1xyw2hclrkdn7c67lppg2r-tinycc-mes-libs-unstable-2025-12-03/lib -I. -DHAVE_DECL_GETENV -DHAVE_DECL_MALLOC -DHAVE_DIRENT_H -DHAVE_LIMITS_H -DHAVE_GETEUID -DHAVE_MKTEMP -DPACKAGE_BUGREPORT= -Ded_PROGRAM=\\\"/nullop\\\" -Dmbstate_t=int -DRETSIGTYPE=int -DHAVE_MKDIR -DHAVE_RMDIR -DHAVE_FCNTL_H -DPACKAGE_NAME=\\\"patch\\\" -DPACKAGE_VERSION=\\\"2.5.9\\\" -DHAVE_MALLOC -DHAVE_REALLOC -DSTDC_HEADERS -DHAVE_STRING_H -DHAVE_STDLIB_H -DHAVE_VPRINTF\"\nCC -c addext.c\nCC -c argmatch.c\nCC -c backupfile.c\nCC -c basename.c\nCC -c dirname.c\nCC -c getopt.c\nCC -c getopt1.c\nCC -c inp.c\nCC -c maketime.c\nCC -c partime.c\nCC -c patch.c\nCC -c pch.c\nCC -c quote.c\nCC -c quotearg.c\nCC -c quotesys.c\nCC -c util.c\nCC -c version.c\nCC -c xmalloc.c\nCC -c error.c\n\n# Link\nCC -o patch addext.o argmatch.o backupfile.o basename.o dirname.o getopt.o getopt1.o inp.o maketime.o partime.o patch.o pch.o quote.o quotearg.o quotesys.o util.o version.o xmalloc.o error.o\n\n# Check\n./patch --version\n\n# Install\nmkdir -p ${out}/bin\ncp ./patch ${out}/bin\nchmod 555 ${out}/bin/patch\n"},"inputs":{"drvs":{"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"m2khnp0iw665w7zjkyvil62v5wjlbl8i-patch-2.5.9.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"gnupatch-2.5.9-builder","outputs":{"out":{"path":"jmxskfr3aj6ih0k90lwmxj9z2jjrzh90-gnupatch-2.5.9-builder"}},"system":"x86_64-linux","version":4},"lar0z6rwhk1kig1rzhirmgvl9zs1z6b6-python3.14-bootstrap-packaging-26.2.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15