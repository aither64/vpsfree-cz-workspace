:"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/9vy0gvgx8ngp8hpv3d3qknqvg0hi2lbw-musl-1.2.5-dev","doCheck":"","doInstallCheck":"","dontAddStaticConfigureFlags":"1","dontDisableStatic":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"stackprotector","mesonFlags":"","name":"musl-1.2.5","nativeBuildInputs":"/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/js6d7zycpib525xbd1dqimvcb2gg1yxl-musl-1.2.5","outputs":"out bin dev debug","patches":"/nix/store/mdmbvb93z195n3bij8pa838v3safw346-300-relative.patch /nix/store/72fpjkqigm2ssmzsajvcar5g8vb86q4n-CVE-2025-26519_0.patch /nix/store/54zx02rd8drmrcq3i69y93srfxs5dnjf-CVE-2025-26519_1.patch /nix/store/fhs9vjjjgzpq70dzf7jwl5ipr9zhbbkl-CVE-2026-6042.patch /nix/store/alsk597agykwgmiljv54cxs1ykah2ryj-CVE-2026-40200.patch /nix/store/ym7qvxyrjvqqp5y9mfmgs909k410w6gk-stdio-skip-empty-iovec-when-buffering-is-disabled.patch","pname":"musl","postInstall":"# Not sure why, but link in all but scsi directory as that's what uclibc/glibc do.\n# Apparently glibc provides scsi itself?\n(cd $dev/include && ln -s $(ls -d /nix/store/zkbb7r81giw7k0lhax3cwyl0l97dcskf-linux-headers-6.18.7/include/* | grep -v \"scsi$\") .)\n\n\n\n# Create 'ldd' symlink, builtin\nln -s $out/lib/libc.so $bin/bin/ldd\n\n# (impure) cc wrapper around musl for interactive usuage\nfor i in musl-gcc musl-clang ld.musl-clang; do\n  moveToOutput bin/$i $dev\ndone\nmoveToOutput lib/musl-gcc.specs $dev\nsubstituteInPlace $dev/bin/musl-gcc \\\n  --replace $out/lib/musl-gcc.specs $dev/lib/musl-gcc.specs\n\n# provide 'iconv' utility, using just-built headers, libc/ldso\n$CC /nix/store/2bim63kxh3vi6ka6inclfpba9rsjj6v9-iconv.c -o $bin/bin/iconv \\\n  -I$dev/include \\\n  -L$out/lib -Wl,-rpath=$out/lib \\\n  -lc \\\n  -B $out/lib \\\n  -Wl,-dynamic-linker=$(ls $out/lib/ld-*)\n# Create 'libc.musl-$arch' symlink\nln -rs $out/lib/libc.so $out/lib/libc.musl-x86_64.so.1\ninstall -D /nix/store/5rcakigix8xmpkmcx90a083pkf8v0gwp-sys-queue.h $dev/include/sys/queue.h\ninstall -D /nix/store/byib83r321c1fjgdk37kai1q1zxncra7-sys-cdefs.h $dev/include/sys/cdefs.h\ninstall -D /nix/store/rnay1kyfxqvjhmk0bfj7g85q6zskk1xy-sys-tree.h $dev/include/sys/tree.h\n","postPatch":"substituteInPlace configure \\\n  --replace -fno-unwind-tables \"\" \\\n  --replace -fno-asynchronous-unwind-tables \"\"\n","preBuild":"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","src":"/nix/store/mp8mmm58idwnlcla8fb2d3289q9m2b26-musl-1.2.5.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.2.5"},"inputs":{"drvs":{"30bgfv25b4lmz2jz0v8p4gg3iq9wdrpd-sys-cdefs.h.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"869myhc3wb9f62m8q5j0qq151ia5jrb4-CVE-2025-26519_0.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"8fkwm1q463d4pnxy9vwx179gybmc9n4r-musl-1.2.5.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"ccl72c6xlyq3jw0x42qypwj2v0dpk1l4-CVE-2026-6042.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"kpss7vh1ma7wd4lrhrfnchsap2fm9ah3-CVE-2025-26519_1.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"qf8rj25cm5igakvwdzas5x56r6ws5k3s-linux-headers-6.18.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"v69f6ijsjgi8wkfjvgdxhsk1fy55j700-iconv.c.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"wr8n4fd5yg1rwlwz8f564pyfnn99mkp7-sys-tree.h.drv":{"dynamicOutputs":{},"outputs":["out"]},"xwypnci1nz2w260f8cvfjiflv0vdpmzs-CVE-2026-40200.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"yqw1hjbni8s73h59ph7gqpf59jfnbk3b-300-relative.patch.drv":{"dynamicOutputs":{},"ou