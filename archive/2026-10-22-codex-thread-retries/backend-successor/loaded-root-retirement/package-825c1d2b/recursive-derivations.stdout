ags\nghc $setupCompileFlags --make -o Setup -odir $builddir -hidir $builddir $i\n\nrunHook postCompileBuildDriver\n","configureFlags":"","configurePhase":"runHook preConfigure\n\necho configureFlags: $configureFlags\n./Setup configure $configureFlags 2>&1 | /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/tee \"$NIX_BUILD_TOP/cabal-configure.log\"\nif grep -E -q -z 'Warning:.*depends on multiple versions' \"$NIX_BUILD_TOP/cabal-configure.log\"; then\n  echo >&2 \"*** abort because of serious configure-time warning from Cabal\"\n  exit 1\nfi\n\n\nrunHook postConfigure\n","configurePlatforms":"","depsBuildBuild":"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","doc":"/nix/store/syyr8xnkggxfvdccw8jdman7xq8pgdhd-integer-logarithms-1.0.5-doc","haddockPhase":"runHook preHaddock\n./Setup haddock --html \\\n  --hoogle \\\n  --quickjump \\\n  --hyperlink-source \\\n  --haddock-option=-j$NIX_BUILD_CORES \\\n  --haddock-option=--no-tmp-comp-dir \\\n  \n\nrunHook postHaddock\n","hardeningDisable":"","installPhase":"runHook preInstall\n\n./Setup copy \nlocal packageConfDir=\"$out/lib/ghc-9.10.3/lib/package.conf.d\"\nlocal packageConfFile=\"$packageConfDir/integer-logarithms-1.0.5.conf\"\nmkdir -p \"$packageConfDir\"\n./Setup register --gen-pkg-config=$packageConfFile\nif [ -d \"$packageConfFile\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/integer-logarithms-1.0.5\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"integer-logarithms-1.0.5","nativeBuildInputs":"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3 /nix/store/hbbp1a8sr589ycaqjyx1ck8gd4bxmfx1-remove-references-to","out":"/nix/store/lqw65h2xj0xff4k20gi520klamvvyh9g-integer-logarithms-1.0.5","outputs":"out doc","patches":"","pname":"integer-logarithms","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":" ","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3.\"\nexport PATH=/nix/store/ncws3231mq7lz6wqyyg2p7gmz6fcvikf-hscolour-1.25/bin:$PATH\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname  --docdir=$doc/share/doc/integer-logarithms-1.0.5 --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --enable-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --disable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/zmvhl3linbbvmdypxh82jkkwzcarj464-integer-logarithms-1.0.5.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.0.5"},"inputs":{"drvs":{"1gbawc48yci42lbjjgipkg2335ax539g-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"31crzmq8yc1nlj0wjfh9afjwpkc86vpj-glibc-locales-2.42-67.drv":{"dynamicOutputs":{},"outputs":["out"]},"4by2ygk033w4hyngk9cx8ygjppk8s4ix-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"hn9gyhy5qq58isa8922b5y608skrvplj-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"ljxjrcrrir1x4laqb6dkc59hg2a4pd6y-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]},"rxgmq7is7q17sqfv771jsx9zl66gjg9p-integer-logarithms-1.0.5.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["4mdp8nhyfddh7bllbi7xszz7k9955n79-Setup.hs","907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"integer-logarithms-1.0.5","outputs":{"doc":{"path":"syyr8xnkggxfvdccw8jdman7xq8pgdhd-integer-logarithms-1.0.5-doc"},"out":{"path":"lqw65h2xj0xff4k20gi520klamvvyh9g-integer-logarithms-1.0.5"}},"system":"x86_64-linux","version":4},"sxlbn3vjbnxp6nmbmlk2g36fsjywbbdz-bash53-010.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"builtin:fetchurl","executable":"","impureEnvVars":"http_p