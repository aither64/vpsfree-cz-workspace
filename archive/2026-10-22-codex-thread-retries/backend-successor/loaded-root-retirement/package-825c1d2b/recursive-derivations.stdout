atch","7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch","f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch","mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch","nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch","r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch","xb11mg2vxj0al4gvh3hfy9wwz0kb1if0-2.44-master.patch","ywdz7fsdiff19745v59snscar3qsgd79-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch"]},"name":"glibc-2.44-25","outputs":{"bin":{"path":"srvyqaf88njyqsrs1ajz3hznvdqq8hlw-glibc-2.44-25-bin"},"debug":{"path":"n9ngv70q5a964va3cxfrpcp6nh6n6xxa-glibc-2.44-25-debug"},"dev":{"path":"m38wglsqnh1mrmj2cmqa3pjb6w4yjxdi-glibc-2.44-25-dev"},"getent":{"path":"vmrimyiw0gkkdfx959h7n5p4zsggan9q-glibc-2.44-25-getent"},"out":{"path":"h4wfwic161kxrr74jlzla5lsm28hgary-glibc-2.44-25"},"static":{"path":"d8wz7lxwlkxncvmhp9f4f7xsfnslfsmm-glibc-2.44-25-static"}},"structuredAttrs":{"BASH_SHELL":"/bin/sh","NIX_CFLAGS_COMPILE":"","NIX_HARDENING_ENABLE":"bindnow format libcxxhardeningfast pic relro stackclashprotection strictflexarrays1 strictoverflow zerocallusedregs","NIX_NO_SELF_RPATH":true,"buildInputs":["/nix/store/ggggdaqvaxkimbzx5p6knxr2nlqlqqnl-linux-headers-7.2"],"builder":"/nix/store/h1ikzxwsf6dc1jlijjcrzwxzanhlw9xj-bash-static-5.3/bin/bash","cmakeFlags":[],"configureFlags":["-C","--enable-add-ons","--sysconfdir=/etc","--enable-stack-protector=strong","--enable-bind-now","--with-headers=/nix/store/ggggdaqvaxkimbzx5p6knxr2nlqlqqnl-linux-headers-7.2/include","--disable-profile","--enable-fortify-source","--enable-static-pie","--enable-cet=permissive","--enable-kernel=3.10.0"],"depsBuildBuild":["/nix/store/m2cn95jx5z7g9f36pd1c9ivl1m0jvlk3-bootstrap-stage2-gcc-wrapper-16.2.0"],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"enableCETRuntimeDefault":false,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"BASH_SHELL":"/bin/sh","NIX_CFLAGS_COMPILE":"","NIX_NO_SELF_RPATH":true,"is64bit":true,"linuxHeaders":"/nix/store/ggggdaqvaxkimbzx5p6knxr2nlqlqqnl-linux-headers-7.2"},"hardeningDisable":["fortify","stackprotector","strictflexarrays3"],"installFlags":["sysconfdir=$(out)/etc"],"is64bit":true,"linuxHeaders":"/nix/store/ggggdaqvaxkimbzx5p6knxr2nlqlqqnl-linux-headers-7.2","makeFlags":["OBJCOPY=objcopy","zonedir=/usr/share/zoneinfo","BUILD_LDFLAGS=-Wl,-rpath,/nix/store/jy5andm0x4137hxbalsr5wsabdhkpf5a-bootstrap-stage0-glibc-minimal-bootstrap/lib","OBJDUMP=/nix/store/j7vnbsigyas7fk82zxjk35k2c17bkc2x-binutils-2.46/bin/objdump","user-defined-trusted-dirs=/nix/store/g60m3aky9f59wgy1gi0y06xwmbw19d6m-xgcc-16.2.0-libgcc/lib"],"mesonFlags":[],"name":"glibc-2.44-25","nativeBuildInputs":["/nix/store/1dd9abw73i9vg3f44xq6swwpcvs8v99m-bison-3.8.2","/nix/store/3crlja9khxng6pxgk07zkxbmcgh3l7q6-gettext-1.0","/nix/store/faa0ii0gh53fy8g6hj0b0gvb0yc5736s-python3-minimal-3.14.7","/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh"],"outputChecks":{"bin":{},"debug":{},"dev":{},"getent":{},"out":{},"static":{}},"outputs":["out","bin","dev","static","getent","debug"],"patches":["/nix/store/xb11mg2vxj0al4gvh3hfy9wwz0kb1if0-2.44-master.patch","/nix/store/nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch","/nix/store/43lp683anlywwy1m6rv0mrw9m2iv681q-dont-use-system-ld-so-cache.patch","/nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch","/nix/store/llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch","/nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch","/nix/store/001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch","/nix/store/ywdz7fsdiff19745v59snscar3qsgd79-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch","/nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch","/nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch","/nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch"],"pname":"glibc","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n\n# Apparently --bindir is not respected.\nmakeFlagsArray+=(\"bindir=$bin/bin\" \"sbindir=$bin/sbin\" \"rootsbindir=$bin/sbin\")\n","postInstall":"moveToOutput bin/getent $getent\necho SUPPORTED-LOCALES=C.UTF-8/UTF-8 > ../localedata/SUPPORTED\n# Don't install C.utf-8 into the archive, but into $out/lib/locale: on non-NixOS\n# systems with an empty /usr/lib/locale/locale-archive, glibc would fall back to\n# $libdir/locale/C.utf-8 instead of the locale archive of pkgs.glibc. See also #347965.\nmake -j${NIX_BUILD_CORES:-1} localedata/install-locale-files\n\ntest -f $out/etc/ld.so.cache && rm $out/etc/ld.so.cache\n\nif test -n \"$linuxHeaders\"; then\n    # Include the Linux kernel headers in Glibc, except the `scsi'\n    # subdirectory, which Glibc provides itself.\n    (cd $dev/include && \\\n     ln -sv $(ls -d $linuxHeaders/include/* | grep -v scsi\\$) .)\nfi\n\n# Fix for NIXOS-54 (ldd not working on x86_64).  Make a symlink\n# \"lib64\" to \"lib\".\nif test -n \"$is64bit\"; then\n    ln -s lib $out/lib64\nfi\n\n# Get rid of more unnecessary stuff.\nrm -rf $out/var $bin/bin/sln\n\n# Backwards-compatibility to fix e.g.\n# \"configure: error: Pthreads are required to build libgomp\" during `gcc`-build\n# because it's not actually needed anymore to link against `pthreads` since\n# it's now part of `libc.so.6` itself, but the gcc build breaks if\n# this doesn't work.\nln -sf $out/lib/libpthread.so.0 $out/lib/libpthread.so\nln -sf $out/lib/librt.so.1 $out/lib/librt.so\nln -sf $out/lib/libdl.so.2 $out/lib/libdl.so\ntest -f $out/lib/libutil.so.1 && ln -sf $out/lib/libutil.so.1 $out/lib/libutil.so\ntouch $out/lib/libpthread.a\n\n# Put libraries for static linking in a separate output.  Note\n# that libc_nonshared.a and libpthread_nonshared.a are required\n# for dynamically-linked applications.\nmkdir -p $static/lib\nmv $out/lib/*.a $static/lib\nmv $static/lib/lib*_nonshared.a $out/lib\n# If libutil.so.1 is missing, libutil.a is required.\ntest -f $out/lib/libutil.so.1 || mv $static/lib/libutil.a $out/lib\n# Some of *.a files are linker scripts where moving broke the paths.\nsed \"/^GROUP/s|$out/lib/lib|$static/lib/lib|g\" \\\n  -i \"$static\"/lib/*.a\n\n# Work around a Nix bug: hard links across outputs cause a build failure.\ncp $bin/bin/getconf $bin/bin/getconf_\nmv $bin/bin/getconf_ $bin/bin/getconf\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/q0lbdx5yv93a3md74kjhm0v2kljjii89-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","profilingLibraries":false,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"src":"/nix/store/jq00nlpdcxgcj5xwx25jibn61a611234-glibc-2.44.tar.xz","stdenv":"/nix/store/8pylj88ihyqp933ybfbhsassy1211cmi-bootstrap-stage2-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"2.44-25"},"system":"x86_64-linux","version":4},"09nhpis7hhk3phvxky28gdza5g3ll7i6-tagged-0.8.9.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/18ffd7k45xjzibl1sv6mxs3vxqf5k7h2-tagged-0.8.9.tar.gz"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"fipldvf4rvwd547anz21awdm06xvvl8d-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"tagged-0.8.9.tar.gz","outputs":{"out":{"hash":"sha256-barYjrtBS6alVtKJjSy+dlDkJ2AQ46bu2Tna9UuVZ4Q=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":[],"curlOpts":"","curlOptsList":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTar