ore/bndhxf3fp3x7p0ixs2f6r441d4q6bz88-gettext-1.0-info","man":"/nix/store/0p5j5qahzx2hyf1h6q6mkrbd855sf20x-gettext-1.0-man","out":"/nix/store/3crlja9khxng6pxgk07zkxbmcgh3l7q6-gettext-1.0"},"inputs":{"drvs":{"16g0x91v52js38zvkjz8h6sp4ks3av8j-bash-static-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"46ab0snw56v2g9pmjalxis4603dhc19q-bootstrap-stage1-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"nj35isk0c7v87ihw955pznx2czs68bfa-update-autotools-gnu-config-scripts-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"qdxi09q6gmn375g9wvn0cvh6idysagqi-bash-5.3p15.drv":{"dynamicOutputs":{},"outputs":["dev"]},"zdbga6f8g5jysvhngmnjlwmj674bzds2-gettext-1.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash","yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch"]},"name":"gettext-1.0","outputs":{"doc":{"path":"19zyamazllxiai1s94aa5xvgbrs5zzil-gettext-1.0-doc"},"info":{"path":"bndhxf3fp3x7p0ixs2f6r441d4q6bz88-gettext-1.0-info"},"man":{"path":"0p5j5qahzx2hyf1h6q6mkrbd855sf20x-gettext-1.0-man"},"out":{"path":"3crlja9khxng6pxgk07zkxbmcgh3l7q6-gettext-1.0"}},"structuredAttrs":{"am_cv_func_iconv_works":"yes","buildInputs":["/nix/store/pyq99pgxs41q3wgi2ma1cqrx2wga9b7m-bash-5.3p15-dev"],"builder":"/nix/store/h1ikzxwsf6dc1jlijjcrzwxzanhlw9xj-bash-static-5.3/bin/bash","cmakeFlags":[],"configureFlags":["--disable-csharp"],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"enableParallelBuilding":true,"enableParallelChecking":false,"enableParallelInstalling":true,"env":{"am_cv_func_iconv_works":"yes","gettextNeedsLdflags":false},"gettextNeedsLdflags":false,"makeFlags":[],"mesonFlags":[],"name":"gettext-1.0","nativeBuildInputs":["/nix/store/6k071jxxkgpdlxc2dkfy5irivjm7gfag-update-autotools-gnu-config-scripts-hook"],"outputChecks":{"doc":{},"info":{},"man":{},"out":{}},"outputs":["out","man","doc","info"],"patches":["/nix/store/p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff","/nix/store/yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch"],"pname":"gettext","postPatch":"# Older versions of gettext come with a copy of `extern-inline.m4` that is not compatible with clang 18.\n# When a project uses gettext + autoreconfPhase, autoreconfPhase will invoke `autopoint -f`, which will\n# replace whatever (probably compatible) version of `extern-inline.m4` with one that probalby won’t work\n# because `autopoint` will copy the autoconf macros from the project’s required version of gettext.\n# Fixing this requires replacing all the older copies of the problematic file with a new one.\n#\n# This is ugly, but it avoids requiring workarounds in every package using gettext and autoreconfPhase.\ndeclare -a oldFiles=($(tar tf gettext-tools/autotools/archive.dir.tar | grep '^gettext-0\\.[19].*/extern-inline.m4'))\noldFilesDir=$(mktemp -d)\nfor oldFile in \"${oldFiles[@]}\"; do\n  mkdir -p \"$oldFilesDir/$(dirname \"$oldFile\")\"\n  cp -a gettext-tools/gnulib-m4/extern-inline.m4 \"$oldFilesDir/$oldFile\"\ndone\ntar uf gettext-tools/autotools/archive.dir.tar --owner=0 --group=0 --numeric-owner -C \"$oldFilesDir\" \"${oldFiles[@]}\"\n\nsubstituteAllInPlace gettext-runtime/src/gettext.sh.in\nsubstituteInPlace gettext-tools/projects/KDE/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/projects/GNOME/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/src/project-id --replace \"/bin/pwd\" pwd\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"setupHooks":["/nix/store/v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash","/nix/store/ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh"],"src":"/nix/store/n4lwy41bnpq1fsqsrf5fac3m7vmhk6sr-gettext-1.0.tar.gz","stdenv":"/nix/store/ibyj3qs750igfnivfcl638clyrgmjmv3-bootstrap-stage1-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"1.0"},"system":"x86_64-linux","version":4},"pknmpsljyynirbqlwhpcc1y64lv2d6jh-python3.13-docutils-0.22.4.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"LANG":"C.UTF-8","NIX_MAIN_PROGRAM":"docutils","__structuredAttrs":"","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","catchConflicts":"1","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","disallowedReferences":"","dist":"/nix/store/hh5dlnj0708k4q2d3bw5frdslzlj6chb-python3.13-docutils-0.22.4-dist","doCheck":"","doInstallCheck":"","dontWrapPythonPrograms":"","installCheckPhase":"runHook preCheck\n/nix/store/xqnbm0vgqcq9b1b54c80qj9s0qhbwa08-python3-3.13.15/bin/python3.13 test/alltests.py\nrunHook postCheck\n","mesonFlags":"","name":"python3.13-docutils-0.22.4","nativeBuildInputs":"/nix/store/xqnbm0vgqcq9b1b54c80qj9s0qhbwa08-python3-3.13.15 /nix/store/5g13zd8ms701h04a82y1brayqxh9nk0v-wrap-python-hook /nix/store/zfcpa64668dhrrbjmq1q50zhb675m0ca-ensure-newer-sources-hook /nix/store/88lxmqypi6y0djdxwyj2im24zk4z5c70-python-remove-tests-dir-hook /nix/store/ywy55ablrpc4siz82vn302k45sw8zapa-python-catch-conflicts-hook /nix/store/0mqmb5vz0plds3b8d6kyp0mzbkj7bv07-python-remove-bin-bytecode-hook /nix/store/z08ffd16vd6rk21hmrc0212yfyvpsid5-pypa-build-hook.sh /nix/store/hx2znyng8lnwnlh0xb2l3vjbrvqfziv1-python-runtime-deps-check-hook.sh /nix