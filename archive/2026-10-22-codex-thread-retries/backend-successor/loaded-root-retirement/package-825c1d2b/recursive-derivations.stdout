IX_MIRRORS_xfce","NIX_MIRRORS_xorg"],"mesonFlags":[],"mirrorsFile":"/nix/store/k5hgcxgm81frncasqlhf6qvdzrrh3b5l-mirrors-list","name":"crate-portable-atomic-util-0.2.4.tar.gz","nativeBuildInputs":["/nix/store/hn66yigjhfvxcnmd6pr5nagf4x3kz952-curl-8.21.0-dev"],"nixpkgsVersion":"26.05","outputChecks":{"out":{}},"outputHash":"d8a2f0d8d040d7848a709caf78912debcc3f33ee4b3cac47d73d1e1069e83507","outputHashAlgo":"sha256","outputHashMode":"flat","outputs":["out"],"patches":[],"postFetch":"","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://static.crates.io/crates/portable-atomic-util/0.2.4/download"]},"system":"x86_64-linux","version":4},"babdzfz8s93w82zqkjyycbyljjyfyi7q-pythoncheck.sh.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"pythoncheck.sh","__structuredAttrs":"","allowSubstitutes":"","buildCommand":"# On darwin a script cannot be used as an interpreter in a shebang but\n# there doesn't seem to be a limit to the size of shebang and multiple\n# arguments to the interpreter are allowed.\nif [[ -n \"\" ]] && isScript $interpreter\nthen\n  wrapperInterpreterLine=$(head -1 \"$interpreter\" | tail -c+3)\n  # Get first word from the line (note: xargs echo remove leading spaces)\n  wrapperInterpreter=$(echo \"$wrapperInterpreterLine\" | xargs echo | cut -d \" \" -f1)\n\n  if isScript $wrapperInterpreter\n  then\n    echo \"error: passed interpreter ($interpreter) is a script which has another script ($wrapperInterpreter) as an interpreter, which is not supported.\"\n    exit 1\n  fi\n\n  # This should work as long as wrapperInterpreter is a shell, which is\n  # the case for programs wrapped with makeWrapper, like\n  # python3.withPackages etc.\n  interpreterLine=\"$wrapperInterpreterLine $interpreter\"\nelse\n  interpreterLine=$interpreter\nfi\n\necho \"#! $interpreterLine\" > $out\ncat \"$contentPath\" >> $out\n\nchmod +x $out\n\n# Relocate executable\n# Wrap it if makeWrapperArgs are specified\nmv $out tmp\n  mkdir -p $out/$(dirname \"/bin/pythoncheck.sh\")\n  mv tmp $out//bin/pythoncheck.sh\nif [ -n \"${makeWrapperArgs+${makeWrapperArgs[@]}}\" ]; then\n    wrapProgram $out//bin/pythoncheck.sh ${makeWrapperArgs[@]}\nfi\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","content":"exec /nix/store/34zamrwmzg8i492gccdsavs6q8if754a-python3.13-flake8-7.3.0/bin/flake8 --show-source --ignore E501 \"$1\"\n","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","interpreter":"/nix/store/ww21sq59scy3kfz9vsnvjcixwyf06hvk-dash-0.5.13.3/bin/dash","makeWrapperArgs":"","mesonFlags":"","name":"pythoncheck.sh","nativeBuildInputs":"/nix/store/hxzjnjwzvwn5ak0hkp5q7jhxvk86f24p-make-binary-wrapper-hook","out":"/nix/store/jkz5qzmdh34x5l9c2fyr4qsbjf581c8b-pythoncheck.sh","outputs":"out","passAsFile":"buildCommand content","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"5r4cwm9fq5c0s3hyyjzri1279jim16w4-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs