n/Compress-Raw-Bzip2 -type f -exec chmod a-x {} +\n\nrm -rf cpan/IO-Compress\nmkdir -p cpan/IO-Compress\n\ntar --strip-components=1 -C cpan/IO-Compress -xf /nix/store/5q7xqjml453ckx9sk2plzbjxf6bkrqg9-IO-Compress-2.220.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/IO-Compress -type f -exec chmod a-x {} +\n\nrm -rf cpan/Archive-Tar\nmkdir -p cpan/Archive-Tar\n\ntar --strip-components=1 -C cpan/Archive-Tar -xf /nix/store/53yp48jf1rnbf978f1dql94j9128zi1l-Archive-Tar-3.12.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Archive-Tar -type f -exec chmod a-x {} +\n# Perl's build system uses the src variable, and its value may end up in\n# the output in some cases (when cross-compiling).\nunset src\n","preConfigure":"cat > config.over <<EOF\nosvers=\"gnulinux\"\nmyuname=\"nixpkgs\"\nmyhostname=\"nixpkgs\"\ncf_by=\"nixpkgs\"\ncf_time=\"$(date -d \"@$SOURCE_DATE_EPOCH\")\"\nEOF\n\n# Compress::Raw::Zlib should use our zlib package instead of the one\n# included with the distribution\ncat > ./cpan/Compress-Raw-Zlib/config.in <<EOF\nBUILD_ZLIB   = False\nINCLUDE      = /nix/store/0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev/include\nLIB          = /nix/store/l68i51npb6nlxi6z18gvgb45dz3xr5yp-zlib-1.3.2/lib\nOLD_ZLIB     = False\nGZIP_OS_CODE = AUTO_DETECT\nUSE_ZLIB_NG  = False\nZLIB_INCLUDE = /nix/store/0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev/include\nZLIB_LIB     = /nix/store/l68i51npb6nlxi6z18gvgb45dz3xr5yp-zlib-1.3.2/lib\nEOF\n","propagatedBuildInputs":"/nix/store/k5j2kwjcap1zgdh4xn1fvvlsrzy55g1i-libxcrypt-4.5.2","propagatedNativeBuildInputs":"","setOutputFlags":"","setupHook":"/nix/store/dm81j9qdcdr4c458pqbc9wvq9ymgzk4m-setup-hook.sh","src":"/nix/store/mhcbhc42ymmh2laf6yr0m2jimr07y8z0-perl-5.42.0.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"5.42.0"},"inputs":{"drvs":{"19j2rnyyj1lmmkg7klik1qhidzrlqi47-glibc-2.42-67.dr