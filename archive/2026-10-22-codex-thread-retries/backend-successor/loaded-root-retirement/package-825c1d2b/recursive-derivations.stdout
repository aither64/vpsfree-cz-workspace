echo \"codex-package: missing required executable: $1\" >&2\n    exit 1\n  fi\n}\n\nfor executable in codex codex-code-mode-host logs_client; do\n  require_executable \"$source/bin/$executable\"\ndone\nrequire_executable /nix/store/pvh5hvndqbhr9l89ikd7gkqbgjvkf1vq-ripgrep-15.1.0/bin/rg\nrequire_executable /nix/store/kxcgm56aqlvgffr88i2d76zhiklxj3r7-bubblewrap-0.11.2/bin/bwrap\n\n\nmkdir -p \"$out/bin\" \"$runtime\"\n# Daemon package copies reject escaping links, including directory links.\ncp -RL --preserve=mode,timestamps \"$source/.\" \"$runtime/\"\nfind \"$runtime\" -type d -exec chmod u+w {} +\nmkdir -p \"$runtime/codex-resources\" \"$runtime/codex-path\"\ncp -L --remove-destination /nix/store/pvh5hvndqbhr9l89ikd7gkqbgjvkf1vq-ripgrep-15.1.0/bin/rg \"$runtime/codex-path/rg\"\ncp -L --remove-destination /nix/store/kxcgm56aqlvgffr88i2d76zhiklxj3r7-bubblewrap-0.11.2/bin/bwrap \"$runtime/codex-resources/bwrap\"\n\ncp --remove-destination /nix/store/b1zb3ifss4yfqqbai825csw42r1zdy1i-codex-package.json \"$runtime/codex-package.json\"\nif [ -n \"$(find \"$runtime\" -type l -print -quit)\" ]; then\n  echo \"codex-package: runtime root still contains a symlink\" >&2\n  exit 1\nfi\n\nmakeWrapper \"$runtime/bin/codex\" \"$out/bin/codex\" \\\n  --prefix PATH : /nix/store/kxcgm56aqlvgffr88i2d76zhiklxj3r7-bubblewrap-0.11.2/bin\n\nfor executable in codex-code-mode-host logs_client; do\n  ln -s \"$runtime/bin/$executable\" \"$out/bin/$executable\"\ndone\nln -s /nix/store/6lr04n3vlvvxxn8b5f4q1m631mqw401c-codex-linked-input/share \"$out/share\"\n"},"inputs":{"drvs":{"6pn84ab6847fv5y8mcva19sjbaq96d9l-codex-linked-input.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"i99fj6w3lhxyf966ri5i1c0bd13kh155-ripgrep-15.1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"sm4r8ha8ky13n0c8apijrz0i982b1zz7-codex-package.j