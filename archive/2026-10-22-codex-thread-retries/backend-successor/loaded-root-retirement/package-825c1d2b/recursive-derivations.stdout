Disable":"","installPhase":"runHook preInstall\n\n./Setup copy \nlocal packageConfDir=\"$out/lib/ghc-9.10.3/lib/package.conf.d\"\nlocal packageConfFile=\"$packageConfDir/typed-process-0.2.13.0.conf\"\nmkdir -p \"$packageConfDir\"\n./Setup register --gen-pkg-config=$packageConfFile\nif [ -d \"$packageConfFile\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/typed-process-0.2.13.0\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"typed-process-0.2.13.0","nativeBuildInputs":"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3 /nix/store/hbbp1a8sr589ycaqjyx1ck8gd4bxmfx1-remove-references-to /nix/store/9cclyqmrzvwh1l1d559hg2jcbnnz8bmp-hspec-discover-2.11.17","out":"/nix/store/pmv00y6d62hn3mh05bxxbvrr8wc2sjf0-typed-process-0.2.13.0","outputs":"out doc","patches":"","pname":"typed-process","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"/nix/store/pssw0kz4lh2w4b4zvc3853fxq7h02y0x-async-2.2.6       /nix/store/wspmfy6bmbrwkgfqp8gy1ldavl6fndc4-unliftio-core-0.2.1.0","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3.\"\nexport PATH=/nix/store/ncws3231mq7lz6wqyyg2p7gmz6fcvikf-hscolo