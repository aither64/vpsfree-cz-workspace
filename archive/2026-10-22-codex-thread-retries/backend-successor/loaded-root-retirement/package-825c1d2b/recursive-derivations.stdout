1czfwm8h41i705hf4a1gispq-musl-1.2.6/lib/libtcc1.a ./libtcc1.a\n\ntcc \\\n  -B /nix/store/km6izy2mps05hgn54byk9vav7lmkazil-tinycc-musl-unstable-2025-12-03-libs/lib \\\n  -DC2STR \\\n  -o c2str \\\n  conftest.c\n./c2str include/tccdefs.h tccdefs_.h\n\ntcc -v \\\n  -static \\\n  -o tcc-musl \\\n  -D TCC_TARGET_X86_64=1 \\\n  -D CONFIG_TCCDIR=\\\"\\\" \\\n  -D CONFIG_TCC_CRTPREFIX=\\\"{B}\\\" \\\n  -D CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\" \\\n  -D CONFIG_TCC_LIBPATHS=\\\"{B}\\\" \\\n  -D CONFIG_TCC_SYSINCLUDEPATHS=\\\"/nix/store/8vaxvk541czfwm8h41i705hf4a1gispq-musl-1.2.6/include\\\" \\\n  -D TCC_LIBGCC=\\\"libc.a\\\" \\\n  -D TCC_LIBTCC1=\\\"libtcc1.a\\\" \\\n  -D CONFIG_TCC_STATIC=1 \\\n  -D CONFIG_USE_LIBGCC=1 \\\n  -D TCC_VERSION=\\\"0.9.27\\\" \\\n  -D ONE_SOURCE=1 \\\n  -D TCC_MUSL=1 \\\n  -D CONFIG_TCC_PREDEFS=1 \\\n  -D CONFIG_TCC_SEMLOCK=0 \\\n  -D CONFIG_TCC_BACKTRACE=0 \\\n  -B . \\\n  -B /nix/store/km6izy2mps05hgn54byk9vav7lmkazil-tinycc-musl-unstable-2025-12-03-libs/lib \\\n  tcc.c\n# libtcc1.a\nrm -f libtcc1.a\ntcc -c -D HAVE_CONFIG_H=1 lib/libtcc1.c\ntcc -ar cr libtcc1.a libtcc1.o\n\n# Rebuild tcc-musl with itself\n./tcc-musl \\\n  -v \\\n  -static \\\n  -o tcc-musl \\\n  -D TCC_TARGET_X86_64=1 \\\n  -D CONFIG_TCCDIR=\\\"\\\" \\\n  -D CONFIG_TCC_CRTPREFIX=\\\"{B}\\\" \\\n  -D CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\" \\\n  -D CONFIG_TCC_LIBPATHS=\\\"{B}\\\" \\\n  -D CONFIG_TCC_SYSINCLUDEPATHS=\\\"/nix/store/8vaxvk541czfwm8h41i705hf4a1gispq-musl-1.2.6/include\\\" \\\n  -D TCC_LIBGCC=\\\"libc.a\\\" \\\n  -D TCC_LIBTCC1=\\\"libtcc1.a\\\" \\\n  -D CONFIG_TCC_STATIC=1 \\\n  -D CONFIG_USE_LIBGCC=1 \\\n  -D TCC_VERSION=\\\"0.9.27\\\" \\\n  -D ONE_SOURCE=1 \\\n  -D TCC_MUSL=1 \\\n  -D CONFIG_TCC_PREDEFS=1 \\\n  -D CONFIG_TCC_SEMLOCK=0 \\\n  -D CONFIG_TCC_BACKTRACE=0 \\\n  -B . \\\n  -B /nix/store/8vaxvk541czfwm8h41i705hf4a1gispq-musl-1.2.6/lib \\\n  tcc.c\n# libtcc1.a\nrm -f libtcc1.a\n./tcc-musl -c -D HAVE_CONFIG_H=1 lib/libtcc1.c\n./tcc-musl -c -D HAVE_CONFIG_H=1 lib/alloca.S\n./tcc-musl -ar cr libtcc1.a libtcc1.o alloca.o\n\n# Install\ninstall -D tcc-musl $out/bin/tcc\ninstall -Dm444 libtcc1.a $out/lib/libtcc1.a\n","builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","name":"tinycc-musl-unstable-2025-12-03","out":"/nix/store/yr2zlb7xa6mjiyfl44aai4632cm8a8pp-tinycc-musl-unstable-2025-12-03","passAsFile":"buildCommand","pname":"tinycc-musl","system":"x86_64-linux","version":"unstable-2025-12-03"},"inputs":{"drvs":{"05z44243pvwk3qrcimv1cf5g3nxi5jjb-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"6f6p45qkd5mhdwvfzgxdydwdpplccvgj-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"7g9biqznf18jyzs1r19hhlbf1jvwyivl-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"d1simrxi41d15h88m043y00yd400fpd4-cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"hyz2fh44bhyj16rypvs556g2rr9sycv1-musl-1.2.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"lgd7h63qh3mjndrhj3q41h8g2xn1bar9-tinycc-musl-unstable-2025-12-03-compiler.drv":{"dynamicOutputs":{},"outputs":["out"]},"qcz565439vz47snj3vky7rbdd4ihvxzl-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"whq0s6ghclpnf52df7f03msah0fqr4vs-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zil1l444xh348yy1hvy5w5f0g2p72f9v-gnupatch-2.5.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh","caakpwmdf9gpgdinaqrikc7vr8y62mf6-static-link.patch"]},"name":"tinycc-musl-unstable-2025-12-03","outputs":{"out":{"path":"yr2zlb7xa6mjiyfl44aai4632cm8a8pp-tinycc-musl-unstable-2025-12-03"}},"system":"x86_64-linux","version":4},"s2v565by6pwdavbfwgd0s3a9gaksi3nx-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/sto