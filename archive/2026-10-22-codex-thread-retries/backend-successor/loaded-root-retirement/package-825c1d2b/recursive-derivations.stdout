share/workspace-portal/codex-models.json\"\ntest \"$(sha256sum \"$out/share/workspace-portal/codex-models.json\" | cut -d' ' -f1)\" = 049042aaadcf2f19722fa1e893f926d2bdbd4d0ff092d80704ff4256e2a45fb1\ntest \"$(\"$out/libexec/codex/libexec/codex/bin/codex\" --version)\" = \"codex-cli 0.163.0\"\nmkdir -p \"$TMPDIR/agent-team-state\" \"$TMPDIR/agent-team-workspace\"\nprintf '{\"schema\":1}\\n' | /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/env -i PATH=/empty HOME=\"$TMPDIR\" \\\n  \"$out/bin/workspace-portal\" agent-teams registration \\\n  --package-root \"$out\" \\\n  --state-root \"$TMPDIR/agent-team-state\" \\\n  --workspace \"$TMPDIR/agent-team-workspace\" \\\n  >\"$TMPDIR/agent-team-registration.json\"\n/nix/store/4q7k51hkcbi3zxqphp42wmlpn6c1a5j3-python3-3.13.15-env/bin/python3 - \"$TMPDIR/agent-team-registration.json\" <<'PY'\nimport json\nimport re\nimport sys\n\nwith open(sys.argv[1], encoding=\"utf-8\") as source:\n    registration = json.load(source)\nassert set(registration) == {\n    \"argv\", \"digest\", \"policy\", \"required_native_child_threads\", \"schema\", \"states\"\n}\nassert registration[\"schema\"] == 1\nassert registration[\"policy\"] == 1\nassert re.fullmatch(r\"[0-9a-f]{64}\", registration[\"digest\"])\nassert isinstance(registration[\"argv\"], list)\nassert isinstance(registration[\"states\"], list) and registration[\"states\"] == []\nassert 0 <= registration[\"required_native_child_threads\"] <= 64\nPY\ntest -f \"$out/share/dev-workspace/agent-teams.json\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/development/designer-high.toml\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/development/designer-xhigh.toml\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/development/implementer-high.toml\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/development/implementer-xhigh.toml\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/development/reviewer-high.toml\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/development/reviewer-xhigh.toml\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/development/team_lead-high.toml\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/development/team_lead-xhigh.toml\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/solo/team_lead-high.toml\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/solo/team_lead-xhigh.toml\"\n\ntest -f \"$out/share/dev-workspace/agent-teams/utilities/verification_watcher-low.toml\"\n\nwrapped=\"$out/libexec/workspace-portal/.dev-session-wrapped\"\nif ! head -n 1 \"$wrapped\" | grep -Eq '^#! */nix/store/'; then\n  echo \"wrapped helper has a non-store interpreter: $wrapped\" >&2\n  exit 1\nfi\nwrapped=\"$out/libexec/.workspace-host-wrapped\"\nif ! head -n 1 \"$wrapped\" | grep -Eq '^#! */nix/store/'; then\n  echo \"wrapped helper has a non-store interpreter: $wrapped\" >&2\n  exit 1\nfi\n\n\ntest -d \"$out/share/codex/skills/dev-session-documentation\"\n\ntest -d \"$out/share/codex/skills/dev-session-monitor\"\n\ntest -d \"$out/share/codex/skills/update-codex-web\"\n\ntest -d \"$out/share/codex/skills/update-dev-workspace-codex\"\n\n/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/env -i PATH=/empty HOME=\"$TMPDIR\" \\\n  \"$out/libexec/workspace-portal/dev-session\" --help >/dev/null\n/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/env -i PATH=/empty HOME=\"$TMPDIR\" \\\n  \"$out/bin/workspace-host\" --help >/dev/null\n/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/env -i PATH=/empty HOME=\"$TMPDIR\" \\\n  \"$out/bin/dev-session\" --help >/dev/null\nif /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/env -i PATH=/empty HOME=\"$TMPDIR\" \\\n  DEV_WORKSPACE_ACTIVATION_ALIASES=HOSTILE_WORKSPACE_ACTIVATION \\\n  HOSTILE_WORKSPACE_ACTIVATION=1 \\\n  \"$out/bin/workspace-host\" _activate >\"$TMPDIR/hostile-activation\" 2>&1; then\n  echo \"ambient activation alias bypassed the packaged wrapper\" >&2\n  exit 1\nfi\ngrep -q 'workspace activation is privat