 set a compiler that is different from the build one.\nsed -i \"$rbConfig\" \\\n  -e 's/CONFIG\\[\"CC\"\\] = \"\\(.*\\)\"/CONFIG[\"CC\"] = if ENV[\"CC\"].nil? || ENV[\"CC\"].empty? then \"\\1\" else ENV[\"CC\"] end/' \\\n  -e 's/CONFIG\\[\"CXX\"\\] = \"\\(.*\\)\"/CONFIG[\"CXX\"] = if ENV[\"CXX\"].nil? || ENV[\"CXX\"].empty? then \"\\1\" else ENV[\"CXX\"] end/'\n\n# Remove unnecessary external intermediate files created by gems\nextMakefiles=$(find $out/lib/ruby/gems/3.4.0 -name Makefile)\nfor makefile in $extMakefiles; do\n  make -C \"$(dirname \"$makefile\")\" distclean\ndone\nfind \"$out/lib/ruby/gems/3.4.0\" \\( -name gem_make.out -o -name mkmf.log -o -name exts.mk \\) -delete\n# Bundler tries to create this directory\nmkdir -p $out/nix-support\ncat > $out/nix-support/setup-hook <<EOF\naddGemPath() {\n  addToSearchPath GEM_PATH \\$1/lib/ruby/gems/3.4.0\n}\naddRubyLibPath() {\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0/x86_64-linux\n}\n\naddEnvHooks \"$hostOffset\" addGemPath\naddEnvHooks \"$hostOffset\" addRubyLibPath\nEOF\n# Prevent the docs from being included in the closure\nsed -i \"s|\\$(DESTDIR)$devdoc|\\$(datarootdir)/\\$(RI_BASE_NAME)|\" $rbConfig\nsed -i \"s|'--with-ridir=$devdoc/share/ri'||\" $rbConfig\n\n# Add rbconfig shim so ri can find docs\nmkdir -p $devdoc/lib/ruby/site_ruby\ncp /nix/store/wq7zxvl223s5s97y3dhc3gkyk5d6dw0w-rbconfig.rb $devdoc/lib/ruby/site_ruby/rbconfig.rb\n","postPatch":"sed -i configure.ac -e '/config.guess/d'\ncp --remove-destination /nix/store/g5qbbj4cmzq1133lnvmaxanrlxl0k7ac-autoconf-2.73/share/autoconf/build-aux/config.{guess,sub} tool/\n","postUnpack":"rm -rf $sourceRoot/{lib,test}/rubygems*\ncp -r /nix/store/vnpyl3jwdqmbjyk2d5qnabfdx3d125w5-rubygems-3.7.2/lib/rubygems* $sourceRoot/lib\n","preConfigure":"# rdoc creates XDG_DATA_DIR (defaulting to $HOME/.local/share) even if\n# it's not going to be used.\nexport HOME=$TMPDIR\n","preInstall":"# Ruby installs gems here itself now.\nmkdir -pv \"$out/lib/ruby/gems/3.4.0\"\nexport GEM_HOME=\"$out/lib/ruby/gems/3.4.0\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/h459yblgc82az0vy3brjh5wc1452f8fw-ruby-3.4.9.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"3.4.9"},"inputs":{"drvs":{"16mjl83l917l0j1kr9ab2w7bi25mk91z-libyaml-0.2.5.drv":{"dynamicOutputs":{},"outputs":["dev"]},"3g4lhn00qsrx31p8ds4gi9x001pvpsl7-ruby-3.4.9.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"5n2k8nv60xzr2j7g43w5f70g0gk68y70-gdbm-1.26.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8s14cb1d61vsrqdi76cycsz9lsb8hlk6-cargo-deps-vendor.drv":{"dynamicOutputs":{},"outputs":["out"]},"alvcpiffvnsd7gqrls7lmf39na76ycsj-autoreconf-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"dpj8y984lwqgc67l0z56dqk68b6ldxxs-rustc-wrapper-1.95.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"gdv273rpxrziz61dmbar27ii82avhcx7-autoconf-2.73.drv":{"dynamicOutputs":{},"outputs":["out"]},"h3i2dcxkc55a6fyw8y14bgwdl2q49gdx-groff-1.24.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"hn9gyhy5qq58isa8922b5y608skrvplj-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"li1l8q7krl78jypcn9ppi7c84cgs8gm6-cargo-setup-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"m7jdsdmzw3787z88bj0czg6wrainp2q9-libffi-3.8.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"pcq7h71gd9h6ni8js4c98hd8q20vd5a0-ncurses-6.6.drv":{"dynamicOutputs":{},"outputs":["dev"]},"pxxyvipnw51s6ghwq7aj37l175ssy80a-rubygems-3.7.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"r4h8yax7i8q29c1p4b8xn6kff5bvg96f-openssl-3.6.3.drv":{"dynamicOutputs":{},"outputs":["dev"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"wmvirw16qv2j6b1v1114mpy25hmm2kpf-readline-8.3p3.drv":