config gets its paths fixed correctly\nrm -rf $dev/lib/cmake\n","postInstall":"# If we're building dynamic libraries, then don't install static\n# libraries.\nif [ -n \"$(echo $out/lib/*.so $out/lib/*.dylib $out/lib/*.dll)\" ]; then\n    rm \"$out/lib/\"*.a\nfi\n\n# 'etc' is a separate output on static builds only.\netc=$out\nmkdir -p $bin\nmv $out/bin $bin/bin\n\n# c_rehash is a legacy perl script with the same functionality\n# as `openssl rehash`\n# this wrapper script is created to maintain backwards compatibility without\n# depending on perl\nmakeWrapper $bin/bin/openssl $bin/bin/c_rehash \\\n  --add-flags \"rehash\"\n\nmkdir $dev\nmv $out/include $dev/\n\n# remove dependency on Perl at runtime\nrm -r $etc/etc/ssl/misc\n\nrmdir $etc/etc/ssl/{certs,private}\n","postPatch":"patchShebangs Configure\nsubstituteInPlace config --replace '/usr/bin/env' '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/env'\n","preCheck":"patchShebangs util\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","setOutputFlags":"","src":"/nix/store/28gjcxgpb8wznqc5dn45s5xrnbvvf2v7-openssl-3.6.3.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"3.6.3"},"inputs":{"drvs":{"5r4cwm9fq5c0s3hyyjzri1279jim16w4-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"dnz4fqzcnwyfhq2qx2m4c63qiw8kp70a-perl-5.42.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"hlvd7d7nqwwz7qaaknn59al6yvcb6vkr-openssl-3.6.3.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["cklrwbwi889pp2fdsswdjvn12sdy5i5j-openssl-disable-kernel-detection.patch","i58agvhx8bmdjlspgkk4m3ylh5348iim-use-etc-ssl-certs.patc