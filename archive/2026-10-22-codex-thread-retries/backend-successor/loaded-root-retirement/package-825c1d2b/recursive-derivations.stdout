{"NIX_CFLAGS_COMPILE":"","NIX_MAIN_PROGRAM":"perl"},"mesonFlags":[],"name":"perl-5.42.3","nativeBuildInputs":[],"outputChecks":{"devdoc":{},"man":{},"out":{"disallowedReferences":["/nix/store/j1938gsbvbhkyz4kbmvjk56r479mkw3s-gcc-wrapper-16.2.0"]}},"outputs":["out","man","devdoc"],"patches":["/nix/store/6dd4aj4q0n602yg42cqz46g76plb7wif-no-sys-dirs.patch","/nix/store/2nr8kyh8x11fqppcqp0wmp82wmqbp007-CVE-2026-15534-1.patch","/nix/store/431crcjyjs4w8p1ifvqnpp9sqsv62wrd-CVE-2026-15534-2.patch"],"pname":"perl","postConfigure":"","postInstall":"# Remove dependency between \"out\" and \"man\" outputs.\nrm \"$out\"/lib/perl5/*/*/.packlist\n\n# Remove dependencies on glibc and gcc\nsed \"/ *libpth =>/c    libpth => ' ',\" \\\n  -i \"$out\"/lib/perl5/*/*/Config.pm\n# TODO: removing those paths would be cleaner than overwriting with nonsense.\nsubstituteInPlace \"$out\"/lib/perl5/*/*/Config_heavy.pl \\\n  --replace \"/nix/store/m38wglsqnh1mrmj2cmqa3pjb6w4yjxdi-glibc-2.44-25-dev\" /no-such-path \\\n  --replace \"/nix/store/j1938gsbvbhkyz4kbmvjk56r479mkw3s-gcc-wrapper-16.2.0\" /no-such-path \\\n  --replace \"/nix/store/5q6bdxkp7lc70gn9mnf4yiybrx8ry5xq-gcc-16.2.0\" /no-such-path \\\n  --replace \"/no-such-path\" /no-such-path \\\n  --replace \"$man\" /no-such-path\n","postPatch":"substituteInPlace dist/PathTools/Cwd.pm \\\n  --replace \"/bin/pwd\" \"$(type -P pwd)\"\n# Perl's build system uses the src variable, and its value may end up in\n# the output in some cases (when cross-compiling).\nunset src\n","preConfigure":"cat > config.over <<EOF\nosvers=\"gnulinux\"\nmyuname=\"nixpkgs\"\nmyhostname=\"nixpkgs\"\ncf_by=\"nixpkgs\"\ncf_time=\"$(date -d \"@$SOURCE_DATE_EPOCH\")\"\nEOF\n\n# Compress::Raw::Zlib should use our zlib package instead of the one\n# included with the distribution\ncat > ./cpan/Compress-Raw-Zlib/config.in <<EOF\nBUILD_ZLIB   = False\nINCLUDE      = /nix/store/879xd5x23lfd4l93jz71yaz06wa15yc1-zlib-1.3.2-dev/include\nLIB          = /nix/store/wgw25d181h0qks7qsfp1bh