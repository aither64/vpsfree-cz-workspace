:{},"outputs":["out"]},"bh24jswvl9r4lxbj57vb9ll1r1b16ghf-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"f8277qraih0507w24118ad1k7vzq0rn8-perl-5.42.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"f9d7s2fm0nrhi3r63vazddir6ir38dca-git-2.55.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"jkqaz2bc776ybwr47zmjfc4ih8ilgjx0-t7703-ignore-ls-total.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"lqjkrn09xnbzaqvb4km9ysqqlp8s650n-openssl-3.5.8.drv":{"dynamicOutputs":{},"outputs":["dev"]},"nqdcl1i3fq49d3qi239k786xgkdgrf5p-gettext-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"ryxzbcgnv9mjn5rkkcql8krp6q250q6f-darwin-unicode-filename-fix.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"sk7ccmm8710phwmpsfy062phismgs20j-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"svra7wnq5jbh36a4p1myr1if3ss7qh2g-bash-5.3p15.drv":{"dynamicOutputs":{},"outputs":["out"]},"v1c9carq3wcfg6fhmz8p5kx3y8j5qyw4-gnused-4.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"wknlplsjcd45mwrwc8v52nqpnbkymddl-expat-2.8.5.drv":{"dynamicOutputs":{},"outputs":["dev"]},"x9zn82ng0zy4jp23zjsg3yahf11iyvx4-uname.drv":{"dynamicOutputs":{},"outputs":["out"]},"z3bqa110qv6g32817l9nb478ckbpmlbc-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["85ax0pclk9prgkp8d7m6n6q1g7v5m58j-git-send-email-honor-PATH.patch","j6vpikcvv4ry0pwalvpz1m65k2wckavl-docbook2texi.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","xprdd33cnqprwk19lxi57h907fz7xic2-git-sh-i18n.patch"]},"name":"git-minimal-2.55.0","outputs":{"debug":{"path":"8ml8xggmlg4zicv7nzly15apdy0a1wiy-git-minimal-2.55.0-debug"},"out":{"path":"hm6ihawx1sk1jpsdzb2i4psy2v5p1mhy-git-minimal-2.55.0"}},"structuredAttrs":{"NIX_LDFLAGS":"-lgcc_s","NIX_MAIN_PROGRAM":"git","buildInputs":["/nix/store/aph5dkajglxjn9642bp0h3x7cwzijr52-curl-8.22.0-dev","/nix/store/hc6mxys4iyawmwiyaixkcl9izjrqmr2q-openssl-3.5.8-dev","/nix/store/8lakizcqh0jxzlv45mvinyd749kpji7y-zlib-ng-2.3.3-dev","/nix/store/2g8d8m8r7i7bi00rm56fbk99scd7303z-expat-2.8.5-dev","/nix/store/2fhx5hvmnmg9cxm00fd0nv3xyl4kkp8v-glibc-iconv-2.44","/nix/store/rxgngn06ihrwh52bfi4vmm0i2ds69wsj-bash-interactive-5.3p15-dev"],"builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","cmakeFlags":[],"configureFlags":["ac_cv_prog_CURL_CONFIG=/nix/store/aph5dkajglxjn9642bp0h3x7cwzijr52-curl-8.22.0-dev/bin/curl-config"],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"NIX_LDFLAGS":"-lgcc_s","NIX_MAIN_PROGRAM":"git"},"installCheckFlags":["DEFAULT_TEST_TARGET=prove","PERL_PATH=/nix/store/8g4dmf7l8q1mf9w4wfmlcl8gvdgmhb8v-perl-5.42.3/bin/perl","debug="],"installCheckTarget":"test","installFlags":["NO_INSTALL_HARDLINKS=1"],"makeFlags":["prefix=${out}","ZLIB_NG=1","SHELL_PATH=/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","NO_PERL=1","NO_PYTHON=1","sysconfdir=/etc","NO_RUST=YesPlease"],"mesonFlags":[],"name":"git-minimal-2.55.0","nativeBuildInputs":["/nix/store/c1yzzjwarqi4z90wyc8yr787fiwlwssb-uname","/nix/store/gfkkr23q11kvyz6xxyxz3qbsp1msxdcv-gettext-1.0","/nix/store/8g4dmf7l8q1mf9w4wfmlcl8gvdgmhb8v-perl-5.42.3","/nix/store/5imzg4hlah4jhnxyrd03d7ymsmms9jaj-make-shell-wrapper-hook","/nix/store/b9izmrfjp0qnnyahdwwrzdwi87s1h179-pkg-config-wrapper-0.29.2","/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh"],"outputChecks":{"debug":{},"out":{"disallowedReferences":[]}},"outputs":["out","debug"],"patches":["/nix/store/j6vpikcvv4ry0pwalvpz1m65k2wckavl-docbook2texi.patch","/nix/store/xprdd33cnqprwk19lxi57h907fz7xic2-git-sh-i18n.patch","/nix/store/85ax0pclk9prgkp8d7m6n6q1g7v5m58j-git-send-email-honor-PATH.patch","/nix/store/k7c6k6zwjh9fgzm9fazn9l1qm6wnv0cy-t7703-ignore-ls-total.patch","/nix/store/xf1lm1n1lj6prcalhi1mnglfwndvc81l-darwin-unicode-filename-fix.patch"],"pname":"git-minimal","postBuild":"# Set up the flags array for make in the same way as for the main build\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelBuilding:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags buildFlags\nechoCmd 'build flags' \"${flagsArray[@]}\"\nmake -C contrib/subtree \"${flagsArray[@]}\" all \nunset flagsArray\n","postInstall":"# Set up the flags array for make in the same way as for the main install\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelInstalling:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags installFlags\nechoCmd 'install flags' \"${flagsArray[@]}\"\n\n# Install git-subtree.\nmake -C contrib/subtree \"${flagsArray[@]}\" install \nrm -rf contrib/subtree\n\n# Install contrib stuff.\nmkdir -p $out/share/git\ncp -a contrib $out/share/git/\nmkdir -p $out/share/bash-completion/completions\nln -s $out/share/git/contrib/completion/git-prompt.sh $out/share/bash-completion/completions/\n\n# grep is a runtime dependency, need to patch so that it's found\nsubstituteInPlace $out/libexec/git-core/git-sh-setup \\\n    --replace ' grep' ' /nix/store/3668q0d9zhc5n9l2pnyvpd44kz9bjsjm-gnugrep-3.12/bin/grep' \\\n    --replace ' egrep' ' /nix/store/3668q0d9zhc5n9l2pnyvpd44kz9bjsjm-gnugrep-3.12/bin/egrep'\n\n# Fix references to the perl, sed, awk and various coreutil binaries used by\n# shell scripts that git calls (e.g. filter-branch)\nSCRIPT=\"$(cat <<'EOS'\n  BEGIN{\n    @a=(\n      '/nix/store/3668q0d9zhc5n9l2pnyvpd44kz9bjsjm-gnugrep-3.12/bin/grep', '/nix/store/1ggxndc1gd5061j5hqprhnhx9p30yilv-gnused-4.10/bin/sed', '/nix/store/63g104xwbzfpcq0h7c99w19m6j9ly3p1-gawk-5.4.1/bin/awk',\n      '/nix/store/2gfxiwls9hbgwdwcy43mprchwsq36mg6-coreutils-9.11/bin/cut', '/nix/store/2gfxiwls9hbgwdwcy43mprchwsq36mg6-coreutils-9.11/bin/basename', '/nix/store/2gfxiwls9hbgwdwcy43mprchwsq36mg6-coreutils-9.11/bin/dirname',\n      '/nix/store/2gfxiwls9hbgwdwcy43mprchwsq36mg6-coreutils-9.11/bin/wc', '/nix/store/2gfxiwls9hbgwdwcy43mprchwsq36mg6-coreutils-9.11/bin/tr'\n      \n    );\n  }\n  foreach $c (@a) {\n    $n=(split(\"/\", $c))[-1];\n    s|(?<=[^#][^/.-])\\b${n}(?=\\s)|${c}|g\n  }\nEOS\n)\"\nperl -0777 -i -pe \"$SCRIPT\" \\\n  $out/libexec/git-core/git-{sh-setup,filter-branch,merge-octopus,mergetool,quiltimport,request-pull,submodule,subtree,web--browse}\n\n\n# Also put git-http-backend into $PATH, so that we can use smart\n# HTTP(s) transports for pushing\nln -s $out/libexec/git-core/git-http-backend $out/bin/git-http-backend\nrm $out/libexec/git-core/git-svn\nrm $out/libexec/git-core/git-send-email\nfor prog in bin/gitk libexec/git-core/git-gui; do\n  rm \"$out/$prog\"\ndone\nunset flagsArray\n","postPatch":"# Fix references to gettext introduced by ./git-sh-i18n.patch\nsubstituteInPlace git-sh-i18n.sh \\\n    --subst-var-by gettext /nix/store/gfkkr23q11kvyz6xxyxz3qbsp1msxdcv-gettext-1.0\nsubstituteInPlace contrib/credential/libsecret/Makefile \\\n    --replace-fail 'pkg-config' \"$PKG_CONFIG\"\n# ensure we are using the correct shell when executing the test scripts\npatchShebangs t/*.sh\n","preBuild":"makeFlags+=( perllibdir=$out/$(perl -MConfig -wle 'print substr $Config{installsitelib}, 1 + length $Config{siteprefixexp}') )\n","preInstall":"","preInstallCheck":"# Some tests break with high concurrency\n# https://github.com/NixOS/nixpkgs/pull/403237\nif ((NIX_BUILD_CORES > 32)); then\n  NIX_BUILD_CORES=32\nfi\n\ninstallCheckFlags+=(\n  GIT_PROVE_OPTS=\"--jobs $NIX_BUILD_CORES --failures --state=failed,save\"\n  GIT_TEST_INSTALLED=$out/bin\n  NO_SVN_TESTS=y\n)\n\nfunction disable_test {\n  local test=$1 pattern=$2\n  if [ $# -eq 1 ]; then\n    mv t/{,skip-}$test.sh || true\n  else\n    sed -i t/$test.sh \\\n      -e \"/^\\s*test_expect_.*$pattern/,/^\\s*' *\\$/{s/^/: #/}\"\n  fi\n}\n\n# Shared permissions are forbidden in sandbox builds:\nsubstituteInPlace t/test-lib.sh \\\n  --replace \"test_set_prereq POSIXPERM\" \"\"\n# TODO: Investigate while these still fail (without POSIXPERM):\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'shared overrides system'\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'init honors global core.sharedRepository'\n# Tested to fail: 2.46.0\ndisable_test t1301-shared-repo\n# /build/git-2.44.0/contrib/completion/git-completion.bash: line 452: compgen: command not found\ndisable_test t9902-completion\n# Disable sendmail tests\ndisable_test t9001-send-email\n# Flaky tests:\ndisable_test t0027-auto-crlf\ndisable_test t1451-fsck-buffer\ndisable_test t5319-multi-pack-index\ndisable_test t6421-merge-partial-clone\ndisable_test t7504-commit-msg-hook\ndisable_test t5515-fetch-merge-logic\ndisable_test t4104-apply-boundary\ndisable_test t7002-mv-sparse-checkout\ndisable_test t4122-apply-symlink-inside\ndisable_test t7513-interpret-trailers\ndisable_test t2200-add-update\n\n# Fails when run with GIT_TEST_INSTALLED, that is, when we're testing an\n# installed package rather than the build output prior to installation.\n# This test is fragile when testing an installed package even in Nix's\n# otherwise clean build environment, upstream haven't been keen on patching\n# individual failures when they crop up, and nobody has yet managed to\n# rewrite the test to be less fragile.\n#\n# See in particular the below messages and discussions around them:\n# https://lore.kernel.org/git/xmqqect7fhnp.fsf@gitster.g/\n# https://lore.kernel.org/git/20251201031040.1120091-1-brianmlyles@gmail.com/\ndisable_test t1517-outside-repo\n\n# Fails reproducibly on ZFS on Linux with formD normalization\ndisable_test t0021-conversion\ndisable_test t3910-mac-os-precompose\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"src":"/nix/store/pad3p4y8amwrv3aaqh43b63b4dcv65j7-git-2.55.0