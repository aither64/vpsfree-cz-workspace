an pages\ninstall -vDm644 -t \"$out/share/man/man3\" ../doc/*.3\ninstall -vDm644 -t \"$out/share/man/man7\" ../doc/*.7\n","postPatch":"substituteInPlace CMakeLists.txt \\\n  --replace '$'{prefix}/'$'{CMAKE_INSTALL_LIBDIR} '$'{CMAKE_INSTALL_FULL_LIBDIR} \\\n  --replace '$'{prefix}/'$'{CMAKE_INSTALL_INCLUDEDIR} '$'{CMAKE_INSTALL_FULL_INCLUDEDIR}\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/g5s3sgig2w7f9z8kdpnf01pv4y9nkmr1-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"4.3.5"},"inputs":{"drvs":{"5bfdrlf4lim2l2p4naq9jvaf93x4mifp-libsodium-1.0.22-unstable-2026-04-09.drv":{"dynamicOutputs":{},"outputs":["dev"]},"5z8sj1169xaps07s9yw780fvznwn8yqy-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"dfryfwhqa5z0if686dc6r833mrr4byvw-cmake-4.1.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"n1k0yzsha6vazld6smj052ps1qy4kkmp-xmlto-0.0.29.drv":{"dynamicOutputs":{},"outputs":["out"]},"n2g11f5b1dzh8yi8v1lhqdzp8bd4qjks-zeromq-fix-cmake-4-2.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"r4z7h6b9ymg981f43wqg3yz4pzqnh9yj-asciidoc-10.2.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"v8qg73wyzrzbzqcnf7v9c2q7wwf2jrh8-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"w2hkwmwn43y9p2sayqdw7rrnap8rlm96-zeromq-fix-cmake-4-1.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"xkgxcwsdkgf9dw5ji2hrw39400cvw6x6-cacheline_undefined.patch.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"zeromq-4.3.5","outputs":{"out":{"path":"vsp6m1b4jpisz927k57n14pqqyrq2b6z-zeromq-4.3.5"}},"system":"x86_64-linux","version":4},"md6m8nd2w2l70nrzybbs7z87ml7iw1qq-IO-HTML-1.004.tar