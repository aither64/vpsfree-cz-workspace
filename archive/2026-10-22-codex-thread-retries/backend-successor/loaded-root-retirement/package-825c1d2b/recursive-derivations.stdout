ut}/lib/lex/nceucform\ninstall -Dm 444 nrform ${out}/lib/lex/nrform\ninstall -Dm 444 libl.a ${out}/lib/libl.a\n"},"inputs":{"drvs":{"0ibwnm5f9q4r7j2d6v3239wgk59yn0xx-heirloom-devtools-070527.tar.bz2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6c9czp98fd8gahfd13lkqhpq30ygckqm-lex_remove_wchar.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"m7qhh4k03ymh4myrj8nnanzgr2pcx5pp-yacc_remove_wchar.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"heirloom-devtools-070527-builder","outputs":{"out":{"path":"wn8dww255jjh5f1ldn9bgv08306zmzwi-heirloom-devtools-070527-builder"}},"system":"x86_64-linux","version":4},"bvzg0d622kybqjixak41y409cmwi6chp-attr-2.6.0.tar.gz.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"builtin:fetchurl","executable":"","impureEnvVars":"http_proxy https_proxy ftp_proxy all_proxy no_proxy","name":"attr-2.6.0.tar.gz","out":"/nix/store/is9qrfj8i2k7dhzqkmxwrmbvvl6q5k9r-attr-2.6.0.tar.gz","outputHash":"sha256-1C+jdFExgLtIyxGkZpb0iCQOUST/HmrYiwq/9waYVhI=","outputHashAlgo":"","outputHashMode":"flat","preferLocalBuild":"1","system":"builtin","unpack":"","url":"https://download.savannah.gnu.org/releases/attr/attr-2.6.0.tar.gz","urls":"https://download.savannah.gnu.org/releases/attr/attr-2.6.0.tar.gz"},"inputs":{"drvs":{},"srcs":[]},"name":"attr-2.6.0.tar.gz","outputs":{"out":{"hash":"sha256-1C+jdFExgLtIyxGkZpb0iCQOUST/HmrYiwq/9waYVhI=","method":"flat"}},"system":"builtin","version":4},"bw1lz0b4ci7cfrb42sl1s478lgl9aqiw-m4-1.4.21.tar.bz2.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-build