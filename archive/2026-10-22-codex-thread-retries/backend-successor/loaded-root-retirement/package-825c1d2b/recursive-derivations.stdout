:"moveToOutput bin/getent $getent\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/xidgjdv05b8yz6w6qrhk4mmjxm4l2zjf-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"# Awful hack: `localedef' doesn't allow the path to `locale-archive'\n# to be overriden, but you *can* specify a prefix, i.e. it will use\n# <prefix>/<path-to-glibc>/lib/locale/locale-archive.  So we use\n# $TMPDIR as a prefix, meaning that the locale-archive is placed in\n# $TMPDIR/nix/store/...-glibc-.../lib/locale/locale-archive.\nLOCALEDEF_FLAGS+=\" --prefix=$TMPDIR\"\n\nexport inst_complocaledir=\"$TMPDIR/\"/nix/store/m07h00fl6538s4gavrp66a20ka4hg7fy-glibc-2.42-67/lib/locale\nmkdir -p \"$inst_complocaledir\"\n\necho 'C.UTF-8/UTF-8 \\' >> ../localedata/SUPPORTED\n\n# Hack to allow building of the locales (needed since glibc-2.12)\nsubstituteInPlace ../localedata/Makefile \\\n  --replace-fail '$(rtld-prefix) $(common-objpfx)locale/localedef' 'localedef $(LOCALEDEF_FLAGS)'\n","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHook":"/nix/store/imajxs8ia8lnfmdb604bkfwi1cmhdfpw-locales-setup-hook.sh","src":"/nix/store/6zxixmszg0vbhpaa8rxwfr05by9axj68-glibc-2.42.tar.xz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.42-67"},"inputs":{"drvs":{"19j2rnyyj1lmmkg7klik1qhidzrlqi47-glibc-2.42-67.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"2757jjsm9afpx810y3vkzckfvniin27l-python3-minimal-3.13.15.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8i1kfmj40d27683j4k36rwkwvsf43awq-locales-setup-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"8injyx1z38allpqjwycg8c7dm9r93mzk-libidn2-2.3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"c3294jpzknddczcp860hfcvwhs3amh8a-gettext-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"jp7ziv1mndz8w6vq5l20fyhg5qdscxm2-gcc-wrapper-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"kzc6jva8wiidkffxmxf05k9kxc65bjwy-binutils-2.46.drv":{"dynamicOutputs":{},"outputs":["out"]},"qf8rj25cm5igakvwdzas5x56r6ws5k3s-linux-headers-6.18.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"wcx8fa94g739rn59s54iym8bh5lzxdlc-glibc-2.42.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"x1w0jlgrzalamm5a6s5gz2s4llsh8yq2-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch","0mb1pqwqkz9sk1fwgn897zlwzhhgfpbf-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch","0swhhq4hf4vjsxndsqxs2can3mcsn2ca-0002-resolv-More-types-as-unknown-in-ns_sprintrrf-CVE-202.patch","43b9m8jsp2sybz9n2yfjs5fpcv2x5ir3-2.42-master.patch","4i53m3qfc9lj43bnq4bs6kbdkw6ljj67-0003-resolv-Fix-buffer-overreads-in-ns_sprintrrf-CVE-2026.patch","628jb27r7gyzblzn11d77nl5264ih86b-0001-resolv-Check-for-inet_ntop-failure-in