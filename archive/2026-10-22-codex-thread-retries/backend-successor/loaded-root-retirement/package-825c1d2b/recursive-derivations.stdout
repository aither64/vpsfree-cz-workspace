le-build-nscd \\\n  --disable-profile \\\n  --disable-timezone-tools \\\n  --disable-mathvec\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES INSTALL_UNCOMPRESSED=yes install\nln -s $(ls -d /nix/store/kxg2gx616qp44cnz3by3gnzhacky8jbg-linux-headers-6.5.6/include/* | grep -v scsi\\$) $out/include/\nfind $out/{bin,sbin,lib,libexec} -type f -exec strip --strip-unneeded {} + || true\n\n# localedef + iconv() are never invoked downstream of this glibc\nrm -rf $out/share/i18n $out/lib/gconv $out/share/locale\nrm -rf $out/bin $out/sbin\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"glibc-2.44","out":"/nix/store/51f6105iiff1b0rnn89nklj6va4rmhqz-glibc-2.44","passAsFile":"buildCommand","pname":"glibc","system":"x86_64-linux","version":"2.44"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"0dpycpy1hz7sccz9w6a9vc22zfzc17hd-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"4v0g1x9x1izfr6wfg94lixbd066s4m46-linux-headers-6.5.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"5qsfr7wfv9fnbk79s85v1gs759r2rw78-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"648r1hrzmrn9kdc76wkqhaihyv40ay36-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6v8bjfwdcw75b9hv7gzl0jyfljdlc3vw-binutils-2.47.drv":{"dynamicOutputs":{},"outputs":["out"]},"7bg3dch8qxhmy79pgbfz72fxjg90bzw7-python-3.14.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"8c42z8g8lzfzkcq9ww9s0kyzsmz39hyb-gnugrep-static-3.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"8xy9yi1vwp0mc32lz37jgva7hck5j9by-gawk-5.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"94bm7xzyjwb2jr289cljc5wdjccxv1yk-glibc-2.44.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"aw4a7hi7q0mb2ljazxq0in9f5v4905a5-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"bjfpxb6q4p4dxn2r8h5p337hn1vf444n-findutils-4.11.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"pip5q1b15n46rw6cbmz3jjk8mngqp7aw-gnused-4.2.drv