I{} --delimiter='\\n' \\\n  filterdiff \\\n  --include={} \\\n  --strip=0 \\\n   \\\n  --clean \"$out\" > \"$tmpfile\"\n\nif [ ! -s \"$tmpfile\" ]; then\n  echo \"error: Normalized patch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://git.alpinelinux.org/aports/plain/main/elfutils/musl-strndupa.patch?id=2e3d4976eeffb4704cf83e2cc3306293b7c7b2e9"]},"system":"x86_64-linux","version":4},"200n6nl9ykx5d3lhbjpvxm9f3b81pb23-gnumake-4.4.1-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"gnumake-4.4.1-builder","out":"/nix/store/qdycs2z57maflbgk9fm4y118rxva132a-gnumake-4.4.1-builder","passAsFile":"text","system":"x86_64-linux","text":"# Unpack\nungz --file /nix/store/0avnvyc7pkcr4pjqws7hwpy87m6wlnjc-make-4.4.1.tar.gz --output make.tar\nuntar --file make.tar\nrm make.tar\ncd make-4.4.1\n\n# Patch\npatch -Np1 -i /nix/store/2k52bklbjhhq47dn35gm833vlh06fgfn-0001-No-impure-bin-sh.patch\npatch -Np1 -i /nix/store/6cc64ayl3fd2nc28ffw47cqsqi2bg1sn-0002-remove-impure-dirs.patch\npatch -Np1 -i /nix/store/9bsy65vc7cqbphmsvkph5rpcsqly30kj-0003-tinycc-support.patch\n\n# Configure\ncatm src/config.h src/mkconfig.h src/mkcustom.h\ncp lib/glob.in.h lib/glob.h\ncp lib/fnmatch.in.h lib/fnmatch.h\n\n# Compile\nalias CC=\"tcc -B /nix/store/a5rfrhplpv4wly6mmvwphi2cxh8jjj6i-tinycc-bootstrappable-libs-unstable-2024-07-07/lib -I./src -I./lib -DHAVE_CONFIG_H -DMAKE_MAINTAINER_MODE -DLIBDIR=\\\"/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib\\\" -DLOCALEDIR=\\\"/fake-locale\\\" -DPOSIX=1 -DNO_OUTPUT_SYNC=1 -DO_TMPFILE=020000000 -DFILE_TIMESTAMP_HI_RES=0 -DHAVE_ALLOCA -DHAVE_ALLOCA_H -DHAVE_ATEXIT -DHAVE_DECL_BSD_SIGNAL=0 -DHAVE_DECL_GETLOADAVG=0 -DHAVE_DECL_SYS_SIGLIST=0 -DHAVE_DECL__SYS_SIGLIST=0 -DHAVE_DECL___SYS_SIGLIST=0 -DHAVE_DIRENT_H -DHAVE_DUP2 -DHAVE_FCNTL_H -DHAVE_FDOPEN -DHAVE_GETCWD -DHAVE_GETTIMEOFDAY -DHAVE_INTTYPES_H -DHAVE_ISATTY -DHAVE_LIMITS_H -DHAVE_LOCALE_H -DHAVE_MEMORY_H -DHAVE_MKTEMP -DHAVE_SA_RESTART -DHAVE_SETVBUF -DHAVE_SIGACTION -DHAVE_SIGSETMASK -DHAVE_STDINT_H -DHAVE_STDLIB_H -DHAVE_STRDUP -DHAVE_STRERROR -DHAVE_STRINGS_H -DHAVE_STRING_H -DHAVE_STRTOLL -DHAVE_SYS_FILE_H -DHAVE_SYS_PARAM_H -DHAVE_SYS_RESOURCE_H -DHAVE_SYS_SELECT_H -DHAVE_SYS_STAT_H -DHAVE_SYS_TIMEB_H -DHAVE_SYS_TIME_H -DHAVE_SYS_WAIT_H -DHAVE_TTYNAME -DHAVE_UMASK -DHAVE_UNISTD_H -DHAVE_WAITPID -DMAKE_JOBSERVER -DMAKE_SYMLINKS -DPATH_SEPARATOR_CHAR=':' -DSCCS_GET=\\\"get\\\" -DSTDC_HEADERS -Dsig_atomic_t=int -Dvfork=fork\"\nCC -c src/ar.c\nCC -c src/arscan.c\nCC -c src/commands.c\nCC -c src/default.c\nCC -c src/dir.c\nCC -c src/expand.c\nCC -c src/file.c\nCC -c src/function.c\nCC -c src/getopt.c\nCC -c src/getopt1.c\nCC -c src/guile.c\nCC -c src/hash.c\nCC -c src/implicit.c\nCC -c src/job.c\nCC -c src/load.c\nCC -c src/loadapi.c\nCC -c src/main.c\nCC -c src/misc.c\nCC -c src/output.c\nCC -c src/read.c\nCC -c src/remake.c\nCC -c src/rule.c\nCC -c src/sh