85ax0pclk9prgkp8d7m6n6q1g7v5m58j-git-send-email-honor-PATH.patch","/nix/store/k7c6k6zwjh9fgzm9fazn9l1qm6wnv0cy-t7703-ignore-ls-total.patch","/nix/store/fzzc79ndlidjp84dx1mxr4ir8sgi3msm-expect-gui--askyesno-failure-in-t1517.patch","/nix/store/0dgxd1ys4s0d4g2mikfizk2dw5cvrjl1-osxkeychain-link-rust_lib.patch"],"pname":"git","postBuild":"# Set up the flags array for make in the same way as for the main build\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelBuilding:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray buildFlags buildFlagsArray\nechoCmd 'build flags' \"${flagsArray[@]}\"\n# Need to build the main Git documentation before building the\n# contrib/subtree documentation, as the latter depends on the\n# asciidoc.conf file created by the former.\nmake -C Documentation PERL_PATH=/nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0/bin/perl \"${flagsArray[@]}\"\nmake -C contrib/subtree \"${flagsArray[@]}\" all doc\nmake -C contrib/diff-highlight \"${flagsArray[@]}\"\nunset flagsArray\n","postInstall":"# Set up the flags array for make in the same way as for the main install\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelInstalling:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray installFlags installFlagsArray\nechoCmd 'install flags' \"${flagsArray[@]}\"\n\n# Install git-subtree.\nmake -C contrib/subtree \"${flagsArray[@]}\" install install-doc\nrm -rf contrib/subtree\n\n# Install contrib stuff.\nmkdir -p $out/share/git\ncp -a contrib $out/share/git/\nmkdir -p $out/share/bash-completion/completions\nln -s $out/share/git/contrib/completion/git-prompt.sh $out/share/bash-completion/completions/\n\n# grep is a runtime dependency, need to patch so that it's found\nsubstituteInPlace $out/libexec/git-core/git-sh-setup \\\n    --replace ' grep' ' /nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin/grep' \\\n    --replace ' egrep' ' /nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin/egrep'\n\n# Fix references to the perl, sed, awk and various coreutil binaries used by\n# shell scripts that git calls (e.g. filter-branch)\nSCRIPT=\"$(cat <<'EOS'\n  BEGIN{\n    @a=(\n      '/nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin/grep', '/nix/store/svl89366pvzz5s3myh1fjniz9l0x17fh-gnused-4.10/bin/sed', '/nix/store/m7wg7cj2vw3n6a0pcl3fzbqfm0qsawmd-gawk-5.4.1/bin/awk',\n      '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/cut', '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/basename', '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/dirname',\n      '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/wc', '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/tr'\n      , '/nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0/bin/perl'\n    );\n  }\n  foreach $c (@a) {\n    $n=(split(\"/\", $c))[-1];\n    s|(?<=[^#][^/.-])\\b${n}(?=\\s)|${c}|g\n  }\nEOS\n)\"\nperl -0777 -i -pe \"$SCRIPT\" \\\n  $out/libexec/git-core/git-{sh-setup,filter-branch,merge-octopus,mergetool,quiltimport,request-pull,submodule,subtree,web--browse}\n\n\n# Also put git-http-backend into $PATH, so that we can use smart\n# HTTP(s) transports for pushing\nln -s $out/libexec/git-core/git-http-backend $out/bin/git-http-backend\nln -s $out/share/git/contrib/git-jump/git-jump $out/bin/git-jump\n# wrap perl commands\nmakeWrapper \"$out/share/git/contrib/credential/netrc/git-credential-netrc.perl\" $out/libexec/git-core/git-credential-netrc \\\n            --set PERL5LIB   \"$out/lib/perl5/site_perl:/nix/store/yvxj18wrfjd1nfsid988lc9ixhzi174m-perl5.42.0-libwww-perl-6.72/lib/perl5/site_perl:/nix/store/a9k3m5n456klvh23lrj3q8yr547zm9zb-perl5.42.0-URI-5.21/lib/perl5/site_perl:/nix/store/dzllx5lks09a7nkd1xg78fypv2mvp8hc-perl5.42.0-TermReadKey-2.38/lib/perl5/site_perl\"\n# ideally unneeded, but added for backwards compatibility\nln -s $out/libexec/git-core/git-credential-netrc $out/bin/\n\nwrapProgram $out/libexec/git-core/git-cvsimport \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/yvxj18wrfjd1nfsid988lc9ixhzi174m-perl5.42.0-libwww-perl-6.72/lib/perl5/site_perl:/nix/store/a9k3m5n456klvh23lrj3q8yr547zm9zb-perl5.42.0-URI-5.21/lib/perl5/site_perl:/nix/store/dzllx5lks09a7nkd1xg78fypv2mvp8hc-perl5.42.0-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-archimport \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/yvxj18wrfjd1nfsid988lc9ixhzi174m-perl5.42.0-libwww-perl-6.72/lib/perl5/site_perl:/nix/store/a9k3m5n456klvh23lrj3q8yr547zm9zb-perl5.42.0-URI-5.21/lib/perl5/site_perl:/nix/store/dzllx5lks09a7nkd1xg78fypv2mvp8hc-perl5.42.0-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-instaweb \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/yvxj18wrfjd1nfsid988lc9ixhzi174m-perl5.42.0-libwww-perl-6.72/lib/perl5/site_perl:/nix/store/a9k3m5n456klvh23lrj3q8yr547zm9zb-perl5.42.0-URI-5.21/lib/perl5/site_perl:/nix/store/dzllx5lks09a7nkd1xg78fypv2mvp8hc-perl5.42.0-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-cvsexportcommit \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/yvxj18wrfjd1nfsid988lc9ixhzi174m-perl5.42.0-libwww-perl-6.72/lib/perl5/site_perl:/nix/store/a9k3m5n456klvh23lrj3q8yr547zm9zb-perl5.42.0-URI-5.21/lib/perl5/site_perl:/nix/store/dzllx5lks09a7nkd1xg78fypv2mvp8hc-perl5.42.0-TermReadKey-2.38/lib/perl5/site_perl\"\n\n# gzip (and optionally bzip2, xz, zip) are runtime dependencies for\n# gitweb.cgi, need to patch so that it's found\nsed -i -e \"s|'compressor' => \\['gzip'|'compressor' => ['/nix/store/2722ncq58c1amdv6g6nv5d1wvab30p0r-gzip-1.14/bin/gzip'|\" \\\n    $out/share/gitweb/gitweb.cgi\n# Give access to CGI.pm and friends (was removed from perl core in 5.22)\nfor p in /nix/store/0xh4c4lwpji5qk6g8ykrnk6crg2ghidi-perl5.42.0-CGI-4.59 /nix/store/4mzmx837vrpkmfl1p20xnzqbf6i9cw7m-perl5.42.0-HTML-Parser-3.81 /nix/store/g5as98krv347sxvnhj32zmk6yjl70l6r-perl5.42.0-CGI-Fast-2.16 /nix/store/0c06gwsqg8myflxlgp7ghf1kynay2xpa-perl5.42.0-FCGI-0.82 /nix/store/mq49hv45ixrdf439sjjh4dxzi353pakd-perl5.42.0-FCGI-ProcManager-0.28 /nix/store/hpfyw95b5jsfy82gmmzc2ykgk6m04jrr-perl5.42.0-HTML-TagCloud-0.38; do\n    sed -i -e \"/use CGI /i use lib \\\"$p/lib/perl5/site_perl\\\";\" \\\n        \"$out/share/gitweb/gitweb.cgi\"\ndone\nrm $out/libexec/git-core/git-svn\n# wrap git-send-email\nwrapProgram $out/libexec/git-core/git-send-email \\\n             --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/szjv0yn8lsbsa1wlwljjyhga3w3yn0w0-perl5.42.0-libnet-3.15/lib/perl5/site_perl:/nix/store/rjp276df0zhsj8n7cby0b2c2p38syxp6-perl5.42.0-Net-SMTP-SSL-1.04/lib/perl5/site_perl:/nix/store/cvbv2sy440wsxdy4qih07zs9dxbgaway-perl5.42.0-IO-Socket-SSL-2.083/lib/perl5/site_perl:/nix/store/2zxi6qwachad8jl4yihzmsnnw4jz1w6i-perl5.42.0-Net-SSLeay-1.92/lib/perl5/site_perl:/nix/store/05639sga8mh1pdqxr1qh2ad4k3g4lcbc-perl5.42.0-Authen-SASL-2.1900/lib/perl5/site_perl:/nix/store/3z3kh4xaphd7ch6z8v4ba8mby4hbk8r3-perl5.42.0-Digest-HMAC-1.05/lib/perl5/site_perl\"\n# Install man pages\nmake \"${flagsArray[@]}\" install install-html \\\n  -C Documentation\nfor prog in bin/gitk libexec/git-core/git-gui; do\n  rm \"$out/$prog\"\ndone\nunset flagsArray\n","postPatch":"# Fix references to gettext introduced by ./git-sh-i18n.patch\nsubstituteInPlace git-sh-i18n.sh \\\n    --subst-var-by gettext /nix/store/db8cwzsgxv3lijvf18kqvjjbylm5hrpi-gettext-1.0\nsubstituteInPlace contrib/credential/libsecret/Makefile \\\n    --replace-fail 'pkg-config' \"$PKG_CONFIG\"\n# ensure we are using the correct shell when executing the test scripts\npatchShebangs t/*.sh\n","preBuild":"makeFlagsArray+=( perllibdir=$out/$(perl -MConfig -wle 'print substr $Config{installsitelib}, 1 + length $Config{siteprefixexp}') )\n","preInstall":"","preInstallCheck":"# Some tests break with high concurrency\n# https://github.com/NixOS/nixpkgs/pull/403237\nif ((NIX_BUILD_CORES > 32)); then\n  NIX_BUILD_CORES=32\nfi\n\ninstallCheckFlagsArray+=(\n  GIT_PROVE_OPTS=\"--jobs $NIX_BUILD_CORES --failures --state=failed,save\"\n  GIT_TEST_INSTALLED=$out/bin\n  NO_SVN_TESTS=y\n)\n\nfunction disable_test {\n  local test=$1 pattern=$2\n  if [ $# -eq 1 ]; then\n    mv t/{,skip-}$test.sh || true\n  else\n    sed -i t/$test.sh \\\n      -e \"/^\\s*test_expect_.*$pattern/,/^\\s*' *\\$/{s/^/: #/}\"\n  fi\n}\n\n# Shared permissions are forbidden in sandbox builds:\nsubstituteInPlace t/test-lib.sh \\\n  --replace \"test_set_prereq POSIXPERM\" \"\"\n# TODO: Investigate while these still fail (without POSIXPERM):\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'shared overrides system'\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'init honors global core.sharedRepository'\n# Tested to fail: 2.46.0\ndisable_test t1301-shared-repo\n# /build/git-2.44.0/contrib/completion/git-completion.bash: line 452: compgen: command not found\ndisable_test t9902-completion\n# Flaky tests:\ndisable_test t0027-auto-crlf\ndisable_test t1451-fsck-buffer\ndisable_test t5319-multi-pack-index\ndisable_test t6421-merge-partial-clone\ndisable_test t7504-commit-msg-hook\ndisable_test t5515-fetch-merge-logic\ndisable_test t4104-apply-boundary\ndisable_test t7002-mv-sparse-checkout\ndisable_test t4122-apply-symlink-inside\ndisable_test t7513-interpret-trailers\ndisable_test t2200-add-update\n\n# Fails reproducibly on ZFS on Linux with formD normalization\ndisable_test t0021-conversion\ndisable_test t3910-mac-os-precompose\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"src":"/nix/store/drcyzlalnx264vlmp2js5vp2kkvyn132-git-2.54.0.tar.xz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":false,"stripDebugList":["lib","libexec","bin","share/git/contrib/credential"],"system":"x86_64-linux","version":"2.54.0"},"system":"x86_64-linux","version":4},"3