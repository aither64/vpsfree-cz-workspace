x-gnu vax-unknown-linux-gnu x86_64-unknown-linux-gnu xscale-unknown-linux-gnu; do\n  mkdir \"$NIX_BUILD_TOP/build-$target\"\n  env -C \"$NIX_BUILD_TOP/build-$target\" \\\n    \"$configureScript\" $configureFlags \"${configureFlagsArray[@]}\" \\\n    --enable-gas --program-prefix \"$target-\"  --target \"$target\"\ndone\n","postInstall":"for target in aarch64-unknown-linux-gnu alpha-unknown-linux-gnu arm-unknown-linux-gnu avr-unknown-linux-gnu cris-unknown-linux-gnu hppa-unknown-linux-gnu i686-unknown-linux-gnu ia64-unknown-linux-gnu m68k-unknown-linux-gnu mips-unknown-linux-gnu mips64-unknown-linux-gnu msp430-unknown-linux-gnu powerpc-unknown-linux-gnu powerpc64-unknown-linux-gnu s390-unknown-linux-gnu sparc-unknown-linux-gnu vax-unknown-linux-gnu x86_64-unknown-linux-gnu xscale-unknown-linux-gnu; do\n  make -C \"$NIX_BUILD_TOP/build-$target/gas\" -j\"$NIX_BUILD_CORES\" \\\n    $makeFlags \"${makeFlagsArray[@]}\" $installFlags \"${installFlagsArray[@]}\" \\\n    install-exec-bindir\ndone\nln -s $out/bin/x86_64-unknown-linux-gnu-as $out/bin/as\n","preConfigure":"# Clear the default library search path.\nif test \"$noSysDirs\" = \"1\"; then\n    echo 'NATIVE_LIB_DIRS=' >> ld/configure.tgt\nfi\n\n# Use symlinks instead of hard links to save space (\"strip\" in the\n# fixup phase strips each hard link separately).\nfor i in binutils/Makefile.in gas/Makefile.in ld/Makefile.in gold/Makefile.in; do\n    sed -i \"$i\" -e 's|ln |ln -s |'\ndone\n\nconfigureScript=\"$PWD/configure\"\nmkdir $NIX_BUILD_TOP/build\ncd $NIX_BUILD_TOP/build\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/wjzms5d0j9k9sam69yh8mrfp3jp89pcd-binutils-with-gold-2.46.tar.bz2","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.46"},"inputs":{"drvs":{"65hxay6ibjzxxsq6ixsm1nn7jj8kwalx-binutils-with-gold-2.46.tar.bz2.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.dr