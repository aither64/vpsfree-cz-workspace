uts":{},"outputs":["out"]},"rkr6s0ww4igwg3mbam8dcm547sa1cci5-bash-5.3p15.drv":{"dynamicOutputs":{},"outputs":["dev"]},"zdbga6f8g5jysvhngmnjlwmj674bzds2-gettext-1.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash","yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch"]},"name":"gettext-1.0","outputs":{"doc":{"path":"9ydra3glmsg6grbzw56kmcz200cqgjvh-gettext-1.0-doc"},"info":{"path":"mfxldlqh6pl120p8sq4lrci7yy8pj2hb-gettext-1.0-info"},"man":{"path":"i08xiz710yrsm3klnz7w2s2c3p4bcd29-gettext-1.0-man"},"out":{"path":"v6ni4zf9xn5wh4sasv1dq50530haw7g7-gettext-1.0"}},"structuredAttrs":{"buildInputs":["/nix/store/wdbliysr0jvar6gxj7plpmr2cj378q5b-bash-5.3p15-dev"],"builder":"/nix/store/h1ikzxwsf6dc1jlijjcrzwxzanhlw9xj-bash-static-5.3/bin/bash","cmakeFlags":[],"configureFlags":["--disable-csharp"],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"enableParallelBuilding":true,"enableParallelChecking":false,"enableParallelInstalling":true,"env":{"gettextNeedsLdflags":false},"gettextNeedsLdflags":false,"makeFlags":[],"mesonFlags":[],"name":"gettext-1.0","nativeBuildInputs":["/nix/store/8jipq1ilcy5p16zlfky92qhjknfz7858-update-autotools-gnu-config-scripts-hook"],"outputChecks":{"doc":{},"info":{},"man":{},"out":{}},"outputs":["out","man","doc","info"],"patches":["/nix/store/p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff","/nix/store/yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch"],"pname":"gettext","postPatch":"# Older versions of gettext come with a copy of `extern-inline.m4` that is not compatible with clang 18.\n# When a project uses gettext + autoreconfPhase, autoreconfPhase will invoke `autopoint -f`, which will\n# replace whatever (probably compatible) version of `extern-inline.m4` with one that probalby won’t work\n# because `autopoint` will copy the autoconf macros from the project’s required version of gettext.\n# Fixing this requires replacing all the older copies of the problematic file with a new one.\n#\n# This is ugly, but it avoids requiring workarounds in every package using gettext and autoreconfPhase.\ndeclare -a oldFiles=($(tar tf gettext-tools/autotools/archive.dir.tar | grep '^gettext-0\\.[19].*/extern-inline.m4'))\noldFilesDir=$(mktemp -d)\nfor oldFile in \"${oldFiles[@]}\"; do\n  mkdir -p \"$oldFilesDir/$(dirname \"$oldFile\")\"\n  cp -a gettext-tools/gnulib-m4/extern-inline.m4 \"$oldFilesDir/$oldFile\"\ndone\ntar uf gettext-tools/autotools/archive.dir.tar --owner=0 --group=0 --numeric-owner -C \"$oldFilesDir\" \"${oldFiles[@]}\"\n\nsubstituteAllInPlace gettext-runtime/src/gettext.sh.in\nsubstituteInPlace gettext-tools/projects/KDE/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/projects/GNOME/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/src/project-id --replace \"/bin/pwd\" pwd\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"setupHooks":["/nix/store/v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash","/nix/store/ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh"],"src":"/nix/store/n4lwy41bnpq1fsqsrf5fac3m7vmhk6sr-gettext-1.0.tar.gz","stdenv":"/nix/store/8qwxbj0f1582qdkr2w5j3rfdx8mw1bj7-bootstrap-stage3-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"1.0"},"system":"x86_64-linux","version":4},"cq45hy0ay4rf7g6hsnrv0rjpzp0mc33k-git-2.54.0.tar.xz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l