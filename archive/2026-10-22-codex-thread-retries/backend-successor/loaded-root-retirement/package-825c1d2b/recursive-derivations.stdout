\nexport CPLUS_INCLUDE_PATH=\"$C_INCLUDE_PATH\"\n\n# Avoid \"Link tests are not allowed after GCC_NO_EXECUTABLES\"\nexport lt_cv_shlibpath_overrides_runpath=yes\nexport ac_cv_func_memcpy=yes\nexport ac_cv_func_strerror=yes\n\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-native-system-header-dir=/nix/store/a2vic34l7rx2vyxysp7wlqd196pm4gzx-tinycc-musl-unstable-2025-12-03-libs/include \\\n  --with-build-sysroot=/nix/store/a2vic34l7rx2vyxysp7wlqd196pm4gzx-tinycc-musl-unstable-2025-12-03-libs/include \\\n  --enable-checking=release \\\n  --disable-bootstrap \\\n  --disable-decimal-float \\\n  --disable-dependency-tracking \\\n  --disable-libatomic \\\n  --disable-libcilkrts \\\n  --disable-libgomp \\\n  --disable-libitm \\\n  --disable-libmudflap \\\n  --disable-libquadmath \\\n  --disable-libsanitizer \\\n  --disable-libssp \\\n  --disable-libvtv \\\n  --disable-lto \\\n  --disable-lto-plugin \\\n  --disable-multilib \\\n  --disable-nls \\\n  --disable-plugin \\\n  --disable-threads \\\n  --enable-languages=c \\\n  --enable-static \\\n  --disable-shared \\\n  --enable-threads=single \\\n  --disable-libstdcxx-pch \\\n  --disable-build-with-cxx\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"gcc-4.6.4","out":"/nix/store/9yjbcvlq2j6xmdmljvznc7xrdaizy4iw-gcc-4.6.4","passAsFile":"buildCommand","pname":"gcc","system":"x86_64-linux","version":"4.6.4"},"inputs":{"drvs":{"37zapxlhmx12r050xsjw39n4vw3nck3a-mpc-1.0.3.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"4hfq6p045k7knv86fc57kq5cnf2djia6-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b0xnqkbv7qnbbbc7zhqwahygjf7mc2i-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gwpvw0ssr7