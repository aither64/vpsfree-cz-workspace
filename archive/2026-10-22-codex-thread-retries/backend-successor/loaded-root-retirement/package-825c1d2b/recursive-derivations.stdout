out/default.script\"\n\nCONFIG_FEATURE_FANCY_ECHO y\nCONFIG_FEATURE_SH_MATH y\nCONFIG_FEATURE_SH_MATH_64 y\nCONFIG_FEATURE_TEST_64 y\n\nCONFIG_ASH y\nCONFIG_ASH_OPTIMIZE_FOR_SIZE y\n\nCONFIG_ASH_ALIAS y\nCONFIG_ASH_BASH_COMPAT y\nCONFIG_ASH_CMDCMD y\nCONFIG_ASH_ECHO y\nCONFIG_ASH_GETOPTS y\nCONFIG_ASH_INTERNAL_GLOB y\nCONFIG_ASH_JOB_CONTROL y\nCONFIG_ASH_PRINTF y\nCONFIG_ASH_TEST y\n\nCONFIG_CROSS_COMPILER_PREFIX \"\"\nCONFIG_FEATURE_UTMP n\nCONFIG_FEATURE_WTMP n\n\nEOF\n\nmake oldconfig\n\nrunHook postConfigure\n","debug":"/nix/store/isfv8rnl74hi9rm7l29snzs6srar37ix-busybox-1.37.0-debug","depsBuildBuild":"/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"format fortify","makeFlags":"SKIP_STRIP=y","mesonFlags":"","name":"busybox-1.37.0","nativeBuildInputs":"/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/csshf3ycx2wsxjaqrva1vr8rwgp382jw-busybox-1.37.0","outputs":"out debug","patches":"/nix/store/7wpjbl21q85z0vrqdx4c7lxg6n4rgwh7-busybox-in-store.patch /nix/store/ix0srl7w9s21y5bnpp4q8gmg7jwvjynd-fix-aarch64-sha1.patch /nix/store/221bb8kxaxp50dprlgw4m9qll0x3djd4-CVE-2023-39810.patch /nix/store/7kidyfd8x0fn46y1610yqknjbh5rffib-CVE-2026-26157_CVE-2026-26158.patch /nix/store/ivhl0vw16larnp208maq278bhzspf4qm-CVE-2026-26157_CVE-2026-26158-2.patch /nix/store/569ibvaqi0fxpxc2xndsi6dvfnqkasgf-busybox-1.37-fix-syslogd.patch /nix/store/qcp6w5nlqy2m4l2xj8sa07q3fpj4riz5-build-system-buffer-overflow.patch /nix/store/2asd10s4bxhpz6ylwc52m7di7xb3kwia-CVE-2025-60876.patch","pname":"busybox","postConfigure":"makeFlagsArray+=(\"CC=cc -isystem /nix/store/9vy0gvgx8ngp8hpv3d3qknqvg0hi2lbw-musl-1.2.5-dev/include -B/nix/st