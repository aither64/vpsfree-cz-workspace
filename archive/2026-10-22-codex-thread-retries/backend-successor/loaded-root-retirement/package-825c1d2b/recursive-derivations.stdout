its to make t/porting/exec-bit.t happy.\nfind cpan/IO-Compress -type f -exec chmod a-x {} +\n\nrm -rf cpan/Archive-Tar\nmkdir -p cpan/Archive-Tar\n\ntar --strip-components=1 -C cpan/Archive-Tar -xf /nix/store/53yp48jf1rnbf978f1dql94j9128zi1l-Archive-Tar-3.12.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Archive-Tar -type f -exec chmod a-x {} +\n# Perl's build system uses the src variable, and its value may end up in\n# the output in some cases (when cross-compiling).\nunset src\n","preConfigure":"cat > config.over <<EOF\nosvers=\"gnulinux\"\nmyuname=\"nixpkgs\"\nmyhostname=\"nixpkgs\"\ncf_by=\"nixpkgs\"\ncf_time=\"$(date -d \"@$SOURCE_DATE_EPOCH\")\"\nEOF\n\n# Compress::Raw::Zlib should use our zlib package instead of the one\n# included with the distribution\ncat > ./cpan/Compress-Raw-Zlib/config.in <<EOF\nBUILD_ZLIB   = False\nINCLUDE      = /nix/store/dm105zcla9j2lj0mjjzz2in3v0a3wal3-zlib-1.3.2-dev/include\nLIB          = /nix/store/a75c31a1m4s2j1wqpnlakjglzq2hnryz-zlib-1.3.2/lib\nOLD_ZLIB     = False\nGZIP_OS_CODE = AUTO_DETECT\nUSE_ZLIB_NG  = False\nZLIB_INCLUDE = /nix/store/dm105zcla9j2lj0mjjzz2in3v0a3wal3-zlib-1.3.2-dev/include\nZLIB_LIB     = /nix/store/a75c31a1m4s2j1wqpnlakjglzq2hnryz-zlib-1.3.2/lib\nEOF\n# We need to do this because the bootstrap doesn't have a static libpthread\nsed -i 's,\\(libswanted.*\\)pthread,\\1,g' Configure\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setOutputFlags":"","setupHook":"/nix/store/dm81j9qdcdr4c458pqbc9wvq9ymgzk4m-setup-hook.sh","src":"/nix/store/mhcbhc42ymmh2laf6yr0m2jimr07y8z0-perl-5.42.0.tar.gz","stdenv":"/nix/store/wqz1q99z5ypzn2mp85xnbg1l0f209b19-bootstrap-stage1-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"5.42.0"},"inputs":{"drvs":{"3fiaam5rvj8yfacngwr7p9vs11zd8n5g-Compress-Raw-Zlib-2.222.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"4y9kzg6h4wxyfpvw3ml99ia9cgn8p6n7-perl-5.42.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"7