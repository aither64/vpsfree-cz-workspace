ry\n# instead of relying on it being in the environment\nsubstituteInPlace src/swtpm_localca/swtpm_localca.c \\\n  --replace \\\n    '# define CERTTOOL_NAME \"gnutls-certtool\"' \\\n    '# define CERTTOOL_NAME \"/nix/store/sdh3dziwjkhzfa95gkxmv190vv5kj5fn-gnutls-3.8.13-bin/bin/certtool\"' \\\n  --replace \\\n    '# define CERTTOOL_NAME \"certtool\"' \\\n    '# define CERTTOOL_NAME \"/nix/store/sdh3dziwjkhzfa95gkxmv190vv5kj5fn-gnutls-3.8.13-bin/bin/certtool\"'\n\nsubstituteInPlace tests/common --replace \\\n    'CERTTOOL=gnutls-certtool;;' \\\n    'CERTTOOL=certtool;;'\n\n# Fix error on macOS:\n# stat: invalid option -- '%'\n# This is caused by the stat program not being the BSD version,\n# as is expected by the test\nsubstituteInPlace tests/common tests/sed-inplace --replace \\\n    'if [[ \"$(uname -s)\" =~ (Linux|CYGWIN_NT-) ]]; then' \\\n    'if [[ \"$(uname -s)\" =~ (Linux|Darwin|CYGWIN_NT-) ]]; then'\n\n# Otherwise certtool seems to pick up the system language on macOS,\n# which might cause a test to fail\nsubstituteInPlace tests/test_swtpm_setup_create_cert --replace \\\n    '$CERTTOOL' \\\n    'LC_ALL=C.UTF-8 $CERTTOOL'\n\nsubstituteInPlace tests/test_tpm2_swtpm_cert --replace \\\n    'certtool' \\\n    'LC_ALL=C.UTF-8 certtool'\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/wvff7n0icv2p3x8diafh0chkqdkha4wx-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.10.1"},"inputs":{"drvs":{"12akz8ffzspfwgkg5lx05hy3ygh1bqm4-glib-2.88.3.drv":{"dynamicOutputs":{},"outputs":["dev"]},"2v0aljvlswcx6i2mxvp444gi5wx45wpd-retry-nwwrite.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"4rasdd1biymhlnh1656c7xxr8ylm890b-socat-1.8.1.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"5al2i2y4n8dc18maikq52zhkj75033d5-netstat-net-tools-2.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"5z8sj1169xaps07s9yw780fvznwn8yqy-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outp