n linked with musl it is.\nln -s /nix/store/7c9flz3laqla3bzfghrxr1w9mf403nk6-musl-1.2.6/lib/libtcc1.a ./libtcc1.a\n\ntcc \\\n  -B /nix/store/armip90blbpwprlblj1phx0nnqj3xpvx-tinycc-mes-libs-unstable-2025-12-03/lib \\\n  -DC2STR \\\n  -o c2str \\\n  conftest.c\n./c2str include/tccdefs.h tccdefs_.h\n\ntcc -v \\\n  -static \\\n  -o tcc-musl \\\n  -D TCC_TARGET_X86_64=1 \\\n  -D CONFIG_TCCDIR=\\\"\\\" \\\n  -D CONFIG_TCC_CRTPREFIX=\\\"{B}\\\" \\\n  -D CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\" \\\n  -D CONFIG_TCC_LIBPATHS=\\\"{B}\\\" \\\n  -D CONFIG_TCC_SYSINCLUDEPATHS=\\\"/nix/store/7c9flz3laqla3bzfghrxr1w9mf403nk6-musl-1.2.6/include\\\" \\\n  -D TCC_LIBGCC=\\\"libc.a\\\" \\\n  -D TCC_LIBTCC1=\\\"libtcc1.a\\\" \\\n  -D CONFIG_TCC_STATIC=1 \\\n  -D CONFIG_USE_LIBGCC=1 \\\n  -D TCC_VERSION=\\\"0.9.27\\\" \\\n  -D ONE_SOURCE=1 \\\n  -D TCC_MUSL=1 \\\n  -D CONFIG_TCC_PREDEFS=1 \\\n  -D CONFIG_TCC_SEMLOCK=0 \\\n  -D CONFIG_TCC_BACKTRACE=0 \\\n  -B . \\\n  -B /nix/store/armip90blbpwprlblj1phx0nnqj3xpvx-tinycc-mes-libs-unstable-2025-12-03/lib \\\n  tcc.c\n# libtcc1.a\nrm -f libtcc1.a\ntcc -c -D HAVE_CONFIG_H=1 lib/libtcc1.c\ntcc -ar cr libtcc1.a libtcc1.o\n\n# Rebuild tcc-musl with itself\n./tcc-musl \\\n  -v \\\n  -static \\\n  -o tcc-musl \\\n  -D TCC_TARGET_X86_64=1 \\\n  -D CONFIG_TCCDIR=\\\"\\\" \\\n  -D CONFIG_TCC_CRTPREFIX=\\\"{B}\\\" \\\n  -D CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\" \\\n  -D CONFIG_TCC_LIBPATHS=\\\"{B}\\\" \\\n  -D CONFIG_TCC_SYSINCLUDEPATHS=\\\"/nix/store/7c9flz3laqla3bzfghrxr1w9mf403nk6-musl-1.2.6/include\\\" \\\n  -D TCC_LIBGCC=\\\"libc.a\\\" \\\n  -D TCC_LIBTCC1=\\\"libtcc1.a\\\" \\\n  -D CONFIG_TCC_STATIC=1 \\\n  -D CONFIG_USE_LIBGCC=1 \\\n  -D TCC_VERSION=\\\"0.9.27\\\" \\\n  -D ONE_SOURCE=1 \\\n  -D TCC_MUSL=1 \\\n  -D CONFIG_TCC_PREDEFS=1 \\\n  -D CONFIG_TCC_SEMLOCK=0 \\\n  -D CONFIG_TCC_BACKTRACE=0 \\\n  -B . \\\n  -B /nix/store/7c9flz3laqla3bzfghrxr1w9mf403nk6-musl-1.2.6/lib \\\n  tcc.c\n# libtcc1.a\nrm -f libtcc1.a\n./tcc-musl -c -D HAVE_CONFIG_H=1 lib/libtcc1.c\n./tcc-musl -c -D HAVE_CONFIG_H=1 lib/alloca.S\n./tcc-musl -ar cr libtcc1.a libtcc1.o alloca.o\n\n# Install\ninstall -D tcc-musl $out/bin/tcc\ninstall -Dm444 libtcc1.a $out/lib/libtcc1.a\n","builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","name":"tinycc-musl-unstable-2025-12-03","out":"/nix/store/dc4vnj9nypgrbn6v0wkp22ns8wcyssgx-tinycc-musl-unstable-2025-12-03","passAsFile":"buildCommand","pname":"tinycc-musl","system":"x86_64-linux","version":"unstable-2025-12-03"},"inputs":{"drvs":{"05z44243pvwk3qrcimv1cf5g3nxi5jjb-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"6f6p45qkd5mhdwvfzgxdydwdpplccvgj-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"7g9biqznf18jyzs1r19hhlbf1jvwyivl-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"9d46md37a38ibk0zxjll9s58sfjf0jb6-tinycc-mes-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"d1simrxi41d15h88m043y00yd400fpd4-cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"jhnpyml16ir8hlv92jnkbag81hhjjvg5-musl-1.2.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"qcz565439vz47snj3vky7rbdd4ihvxzl-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"y0yxb5kxhvzffj19ggf3d7snxrc0xbjb-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zil1l444xh348yy1hvy5w5f0g2p72f9v-gnupatch-2.5.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh","caakpwmdf9gpgdinaqrikc7vr8y62mf6-static-link.patch"]},"name":"tinycc-musl-unstable-2025-12-03","outputs":{"out":{"path":"dc4vnj9nypgrbn6v0wkp22ns8wcyssgx-tinycc-musl-unstable-2025-12-03"}},"system":"x86_64-linux","version":4},"jmipgj33jada4w5fahqn4d50j55psx27-perl5.42.0-YAML-Tiny-1.74.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/119w10l