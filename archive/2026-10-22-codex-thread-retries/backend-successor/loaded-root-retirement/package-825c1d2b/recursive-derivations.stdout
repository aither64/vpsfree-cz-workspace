nputs":"/nix/store/dmpn2sl84sqf9fskr16qwp4pbs5nm729-linux-headers-6.18.7","builder":"/nix/store/pzpmwj3agpmlkjfq0g62r2zxa7qysdya-bash-static-5.3/bin/bash","cmakeFlags":"","configureFlags":"-C --enable-add-ons --sysconfdir=/etc --enable-stack-protector=strong --enable-bind-now --without-headers --disable-profile --enable-fortify-source --enable-static-pie","depsBuildBuild":"/nix/store/ivc27wlllh66np1cxclmhzgz8szcmgil-bootstrap-stage4-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","extraNativeBuildInputs":"/nix/store/m07h00fl6538s4gavrp66a20ka4hg7fy-glibc-2.42-67","installFlags":"sysconfdir=$(out)/etc","installPhase":"mkdir -p \"$out/lib/locale\" \"$out/share/i18n\"\ncp -v \"$TMPDIR/$NIX_STORE/\"*\"/lib/locale/locale-archive\" \"$out/lib/locale\"\ncp -v ../localedata/SUPPORTED \"$out/share/i18n/SUPPORTED\"\n","is64bit":"1","linuxHeaders":"","makeFlags":"OBJCOPY=objcopy BUILD_LDFLAGS=-Wl,-rpath,/nix/store/m07h00fl6538s4gavrp66a20ka4hg7fy-glibc-2.42-67/lib OBJDUMP=/nix/store/2xjbix8nyd1vn3q9dpywrjvcdcybigb8-binutils-patchelfed-ld-2.46/bin/objdump localedata/install-locales localedir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/locale","mesonFlags":"","name":"glibc-locales-2.42-67","nativeBuildInputs":"/nix/store/znr5k5q69yivzf293wx2ylzr50advi0v-bison-3.8.2 /nix/store/82szsmdi42lrp4sn3g08s9qj43g9b1ic-gettext-1.0 /nix/store/c7876106hl3qjqjkggkgsajzxg3w330j-python3-minimal-3.13.15 /nix/store/2rgc5gn3a2qids4bhjaq2g1l1r2i1637-glibc-2.42-67-dev","out":"/nix/store/njs84skjz242z3m58dwq8j89n1rz5hw3-glibc-locales-2.42-67","outputs":"out","patches":"/nix/store/43b9m8jsp2sybz9n2yfjs5fpcv2x5ir3-2.42-master.patch /nix/store/nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch /nix/store/b1w7zbvm39ff1i52iyjggyvw2rdxz104-dont-use-system-ld-so-cache.patch /nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch /nix/store/llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch /nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch /nix/store/001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch /nix/store/0mb1pqwqkz9sk1fwgn897zlwzhhgfpbf-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch /nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch /nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch /nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch /nix/store/628jb27r7gyzblzn11d77nl5264ih86b-0001-resolv-Check-for-inet_ntop-failure-in-ns_sprintrrf.patch /nix/store/0swhhq4hf4vjsxndsqxs2can3mcsn2ca-0002-resolv-More-types-as-unknown-in-ns_sprintrrf-CVE-202.patch /nix/store/4i53m3qfc9lj43bnq4bs6kbdkw6ljj67-0003-resolv-Fix-buffer-overreads-in-ns_sprintrrf-CVE-2026.patch","pname":"glibc-locales","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n","postInstall":"moveToOutput bin/getent $getent\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/xidgjdv05b8yz6w6qrhk4mmjxm4l2zjf-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"# Awful hack: `localedef' doesn't allow the path to `locale-archive'\n# to be overriden, but you *can* specify a prefix, i.e. it will use\n# <prefix>/<path-to-glibc>/lib/locale/locale-archive.  So we use\n# $TMPDIR as a prefix, meaning that the locale-archive is placed in\n# $TMPDIR/nix/store/...-glibc-.../lib/locale/locale-archive.\nLOCALEDEF_FLAGS+=\" --prefix=$TMPDIR\"\n\nexport inst_complocaledir=\"$TMPDIR/\"/nix/store/m07h00fl6538s4gavrp66a20ka4hg7fy-glibc-2.42-67/lib/locale\nmkdir -p \"$inst_complocaledir\"\n\necho 'C.UTF-8/UTF-8 \\' >> ../localedata/SUPPORTED\n\n# Hack to allow building of the locales (needed since glibc-2.12)\nsubstituteInPlace ../localedata/Makefile \\\n  --replace-fail '$(rtld-prefix) $(common-objpfx)locale/localedef' 'localedef $(LOCALEDEF_FLAGS)'\n","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHook":"/nix/store/axb00baach2v6d35zgk8i42d5jpmwv8b-locales-setup-hook.sh","src":"/nix/store/6zxixmszg0vbhpaa8rxwfr05by9axj68-glibc-2.42.tar.xz","stdenv":"/nix/store/q9gadi885qsqdkrz962mcgga62hl6p48-bootstrap-stage4-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.42-67"},"inputs":{"drvs":{"19j2rnyyj1lmmkg7klik1qhidzrlqi47-glibc-2.42-67.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"4dyiv92spydrz2b1padv3psysmb987zp-gettext-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"8a6z99ckv3s7np4pw221skdiqm7927lg-locales-setup-hook.sh.drv":{"dynamicO