ion":"","destinationDir":".","name":"gnupatch-2.5.9-builder","out":"/nix/store/19af8r5m9q5l7did1vz8qbzlmr11afq2-gnupatch-2.5.9-builder","passAsFile":"text","system":"x86_64-linux","text":"# Unpack\nungz --file /nix/store/q9qicy85fzbs1fzn98hl231bah798m48-patch-2.5.9.tar.gz --output patch.tar\nuntar --file patch.tar\nrm patch.tar\ncd patch-2.5.9\n\n# Configure\ncatm config.h\n\n# Build\nalias CC=\"tcc -B /nix/store/armip90blbpwprlblj1phx0nnqj3xpvx-tinycc-mes-libs-unstable-2025-12-03/lib -I. -DHAVE_DECL_GETENV -DHAVE_DECL_MALLOC -DHAVE_DIRENT_H -DHAVE_LIMITS_H -DHAVE_GETEUID -DHAVE_MKTEMP -DPACKAGE_BUGREPORT= -Ded_PROGRAM=\\\"/nullop\\\" -Dmbstate_t=int -DRETSIGTYPE=int -DHAVE_MKDIR -DHAVE_RMDIR -DHAVE_FCNTL_H -DPACKAGE_NAME=\\\"patch\\\" -DPACKAGE_VERSION=\\\"2.5.9\\\" -DHAVE_MALLOC -DHAVE_REALLOC -DSTDC_HEADERS -DHAVE_STRING_H -DHAVE_STDLIB_H -DHAVE_VPRINTF\"\nCC -c addext.c\nCC -c argmatch.c\nCC -c backupfile.c\nCC -c basename.c\nCC -c dirname.c\nCC -c getopt.c\nCC -c getopt1.c\nCC -c inp.c\nCC -c maketime.c\nCC -c partime.c\nCC -c patch.c\nCC -c pch.c\nCC -c quote.c\nCC -c quotearg.c\nCC -c quotesys.c\nCC -c util.c\nCC -c version.c\nCC -c xmalloc.c\nCC -c error.c\n\n# Link\nCC -o patch addext.o argmatch.o backupfile.o basename.o dirname.o getopt.o getopt1.o inp.o maketime.o partime.o patch.o pch.o quote.o quotearg.o quotesys.o util.o version.o xmalloc.o error.o\n\n# Check\n./patch --version\n\n# Install\nmkdir -p ${out}/bin\ncp ./patch ${out}/bin\nchmod 555 ${out}/bin/patch\n"},"inputs":{"drvs":{"m2khnp0iw665w7zjkyvil62v5wjlbl8i-patch-2.5.9.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"y0yxb5kxhvzffj19ggf3d7snxrc0xbjb-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name