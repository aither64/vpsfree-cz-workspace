0/bin:/nix/store/r04s6g51v2002prayd855xazjrsiszlb-binutils-2.47/bin:/nix/store/06gvqpadb2w24pazjb87m2jd2j24h0v2-gnumake-musl-4.4.1/bin:/nix/store/2afl43wwm3bp41aqr9d6233zghmqwahm-gnused-4.2/bin:/nix/store/x0gqa6ksn306k9x91fdyb8k4ci90pn5x-gnugrep-2.4/bin:/nix/store/nsxim2jqwz8s411zrljn11f64cmz9928-gawk-5.4.1/bin:/nix/store/8sn2nxrzlp4y2bn0s55pjlrdjmapyzkl-diffutils-3.8/bin:/nix/store/1694ha2msax6nrx00bhg2ybrpqfmkqq4-findutils-4.11.0/bin:/nix/store/x7y50xlwjp75hyqrq6038krray7schys-gnutar-1.35/bin:/nix/store/6skcsg3yn7afxaf0mkp0d0n4yjyz08s4-gzip-1.2.4/bin:/nix/store/j2iasjpk34gbcwl725zdbgrmaj2vggbb-bzip2-1.0.8/bin:/nix/store/fjy092g1x515rnpv33bjx00hxfbp67h9-xz-5.8.3/bin:/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin:/nix/store/rfv4gzzcgz85wlha9k4s850c9l3k46m2-bootstrap-coreutils-musl-9.11/bin","SHELL":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","buildCommand":"# Unpack\ntar xf /nix/store/chw5kxp89wq3wkc37f6fr8wiw4yc7paj-gcc-16.2.0.tar.xz\ntar xf /nix/store/71p7vjw19g2vrh25i3mpi1656byvzj3w-gmp-6.3.0.tar.xz\ntar xf /nix/store/92vinq6gfq5afkjc870g6y301mmf1vqq-mpfr-4.2.2.tar.xz\ntar xf /nix/store/zd9927kzcygs4p4fzc43d4wkdqdm4h72-mpc-1.4.1.tar.xz\ncd gcc-16.2.0\n\nln -s ../gmp-6.3.0 gmp\nln -s ../mpfr-4.2.2 mpfr\nln -s ../mpc-1.4.1 mpc\n\n# Patch\n# force musl even if host triple is gnu\nsed -i 's|\"os/gnu-linux\"|\"os/generic\"|' libstdc++-v3/configure.host\n\n# Configure\nexport CC=\"gcc -Wl,-dynamic-linker -Wl,/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib/libc.so\"\nexport CXX=\"g++ -Wl,-dynamic-linker -Wl,/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib/libc.so\"\nexport CFLAGS=\"-O1\"\nexport CXXFLAGS=\"-O1\"\nexport CFLAGS_FOR_TARGET=\"-O0 -Wl,-dynamic-linker -Wl,/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib/libc.so\"\nexport CXXFLAGS_FOR_TARGET=\"$CFLAGS_FOR_TARGET\"\nexport LIBRARY_PATH=\"/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib\"\n\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-native-system-header-dir=/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/include \\\n  --with-sysroot=/ \\\n  --enable-languages=c,c++ \\\n  --enable-checking=release \\\n  --enable-static \\\n  --disable-shared \\\n  --disable-bootstrap \\\n  --disable-dependency-tracking \\\n  --disable-libsanitizer \\\n  --disable-libssp \\\n  --disable-libgomp \\\n  --disable-libquadmath \\\n  --disable-libitm \\\n  --disable-libvtv \\\n  --disable-libatomic \\\n  --disable-libstdcxx-pch \\\n  --disable-lto \\\n  --disable-multilib \\\n  --disable-nls \\\n  --disable-plugin \\\n  --without-isl\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n\n# Header installation tools retain build-time bash and sed unnecessarily.\nrm -rf $out/libexec/gcc/*/*/install-tools $out/lib/gcc/*/*/install-tools\n\n# libstdc++ gdb pretty-printers + man pages are unused downstream.\nrm -rf $out/share/gcc-*/python $out/share/man $out/share/info\n\nif [ -d \"$out/lib64\" ]; then\n  shopt -s dotglob\n  for lib in $out/lib64/*; do\n    mv --no-clobber \"$lib\" \"$out/lib/\"\n  done\n  shopt -u dotglob\n  rm -rf \"$out/lib64\"\n  ln -s lib \"$out/lib64\"\nfi\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"gcc-16.2.0","out":"/nix/store/76n6dww7rhwzbhxfwad13rhl4v9pa7jm-gcc-16.2.0","passAsFile":"buildCommand","pname":"gcc","system":"x86_64-linux","version":"16.2.0"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"0dpycpy1hz7sccz9w6a9vc22zfzc17hd-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"1hgh3ynq1lsicaxr0r5pdbvkbbhb0vrr-gmp-6.3.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"5qsfr7wfv9fnbk79s85v1gs759r2rw78-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"6v8bjfwdcw75b9hv7gzl0jyfljdlc3vw-binutils-2.47.drv":{"dynamicOutputs":{},"outputs":["out"]},"6xh4gnmais0bg7