90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/include\"\nexport CPLUS_INCLUDE_PATH=\"$C_INCLUDE_PATH\"\nexport LIBRARY_PATH=\"/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib\"\n\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-native-system-header-dir=/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/include \\\n  --with-build-sysroot=/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6 \\\n  --enable-languages=c,c++ \\\n  --enable-checking=release \\\n  --disable-bootstrap \\\n  --disable-dependency-tracking \\\n  --disable-libgomp \\\n  --disable-libmudflap \\\n  --disable-libquadmath \\\n  --disable-libssp \\\n  --disable-libstdcxx-pch \\\n  --disable-lto \\\n  --disable-multilib \\\n  --disable-nls \\\n  --disable-libsanitizer \\\n  --disable-shared\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"gcc-cxx-4.6.4","out":"/nix/store/rallc5g097f59id8rn7y879j6r6ycvhj-gcc-cxx-4.6.4","passAsFile":"buildCommand","pname":"gcc-cxx","system":"x86_64-linux","version":"4.6.4"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"37zapxlhmx12r050xsjw39n4vw3nck3a-mpc-1.0.3.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6v8bjfwdcw75b9hv7gzl0jyfljdlc3vw-binutils-2.47.drv":{"dynamicOutputs":{},"outputs":["out"]},"8xy9yi1vwp0mc32lz37jgva7hck5j9by-gawk-5.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"aw4a7hi7q0mb2ljazxq0in9f5v4905a5-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"bjfpxb6q4p4dxn2r8h5p337hn1vf444n-findutils-4.11.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"cxpi1vdfflr3zh9xhgsqz44vqjk0jfk8-mpfr-2.4.2.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"ia4sjsi3cl16751r14yfv92603830nnn-gmp-4.3.2.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"iznl7h2nv8rfmq9m6w