,"name":"pytest-hook","nativeBuildInputs":[],"outputChecks":{"out":{}},"outputs":["out"],"patches":[],"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"stdenv":"/nix/store/xai718x2gpf0kf73zwhhv50likh5c18l-stdenv-linux-no-cc","strictDeps":true,"system":"x86_64-linux","text":"pytestcachePhase() {\n    find $out -name .pytest_cache -type d -exec rm -rf {} +\n}\nappendToVar preDistPhases pytestcachePhase\n\n# pytest generates it's own bytecode files to improve assertion messages.\n# These files similar to cpython's bytecode files but are never laoded\n# by python interpreter directly. We remove them for a few reasons:\n# - files are non-deterministic: https://github.com/NixOS/nixpkgs/issues/139292\n#   (file headers are generatedt by pytest directly and contain timestamps)\n# - files are not needed after tests are finished\npytestRemoveBytecodePhase () {\n    # suffix is defined at:\n    #    https://github.com/pytest-dev/pytest/blob/7.2.1/src/_pytest/assertion/rewrite.py#L51-L53\n    find $out -name \"*-pytest-*.py[co]\" -delete\n}\nappendToVar preDistPhases pytestRemoveBytecodePhase\n"},"system":"x86_64-linux","version":4},"26kg9wajp4v56dqm4v85g5481fv686ss-ensure-newer-sources-hook.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","env":{"out":"/nix/store/x1f9skkpjginqvay1gpf8liwi72p0hdm-ensure-newer-sources-hook"},"inputs":{"drvs":{"j3ryfazxvcr28i8hrac08xvbpa06p75i-ensure-newer-sources-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"svra7wnq5jbh36a4p1myr1if3ss7qh2g-bash-5.3p15.drv":{"dynamicOutputs":{},"outputs":["out"]},"vhbs2wdxyq6abggm0qza7d62h16hdkj3-stdenv-linux-no-cc.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ensure-newer-so