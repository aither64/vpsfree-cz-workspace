MAP\t/nix/var/nix/profiles/default/bin\t/nix/var/nix/profiles/default/share/man\" >> src/man_db.conf.in\n\n# Add mandb locations for the above\necho \"MANDB_MAP\t/nix/var/nix/profiles/default/share/man\t/var/cache/man/nixpkgs\" >> src/man_db.conf.in\n","preConfigure":"./bootstrap --no-git --gnulib-srcdir=/nix/store/pir73cc0nvg51xr7rpm0z8w3b6yk1jz7-gnulib-20241001 --gen\nconfigureFlagsArray+=(\"--with-sections=1 n l 8 3 0 2 5 4 9 6 7\")\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/6kz444k9yjlacfhrbw84qrbw1mk7vjgw-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.13.1"},"inputs":{"drvs":{"1vj2zqqdc9izhzl9adm83xs75097zirc-gzip-1.14.drv":{"dynamicOutputs":{},"outputs":["out"]},"3bkl4yqj9z2vyd4ginlzfh6cv8x8997j-flex-2.6.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"5n2k8nv60xzr2j7g43w5f70g0gk68y70-gdbm-1.26.drv":{"dynamicOutputs":{},"outputs":["dev"]},"5z8sj1169xaps07s9yw780fvznwn8yqy-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"9a8hhc7dn0dp542x4b649xvl4bjckmvs-gnulib-20241001.drv":{"dynamicOutputs":{},"outputs":["out"]},"bcym5142y4c40f8jrwn7b08mm2gm2pnq-zstd-1.5.7.drv":{"dynamicOutputs":{},"outputs":["bin","dev"]},"c3294jpzknddczcp860hfcvwhs3amh8a-gettext-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"dlp8kg7a8yrmjabh7gms37qpk6m9xqjm-util-linux-minimal-2.42.2.drv":{"dynamicOutputs":{},"outputs":["bin"]},"gdv273rpxrziz61dmbar27ii82avhcx7-autoconf-2.73.drv":{"dynamicOutputs":{},"outputs":["out"]},"gpi71pjf9vw182lnjjzfzzgc5a20scgi-libpipeline-1.5.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"h3i2dcxkc55a6fyw8y14bgwdl2q49gdx-groff-1.24.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"m6frfx8phnwl2fslhimwf998ccwls5gq-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"myrmw8d03a74scgvdr0a982nzb0i7a5s-glibc-iconv-2.42.drv":{"dynamicOutputs"