\nif [ ! -s \"$tmpfile\" ]; then\n  echo \"error: Normalized patch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://github.com/docbook/xslt10-stylesheets/commit/07631601e6602bc49b8eac3aab9d2b35968d3e7a.patch"]},"system":"x86_64-linux","version":4},"3ff9aq5jx5hs2fdl2yfqpl1nh7dfkh68-zlib-1.3.2.tar.xz.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"builtin:fetchurl","executable":"","impureEnvVars":"http_proxy https_proxy ftp_proxy all_proxy no_proxy","name":"zlib-1.3.2.tar.xz","out":"/nix/store/18agc3vzx1yqx1hz807wa4iflsy02ifw-zlib-1.3.2.tar.xz","outputHash":"sha256-16BlR4Ok2lKdG7eTt62cMxgCCvd2Z7yuNfldDkKnkvM=","outputHashAlgo":"","outputHashMode":"flat","preferLocalBuild":"1","system":"builtin","unpack":"","url":"https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.xz","urls":"https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.xz"},"inputs":{"drvs":{},"srcs":[]},"name":"zlib-1.3.2.tar.xz","outputs":{"out":{"hash":"sha256-16BlR4Ok2lKdG7eTt62cMxgCCvd2Z7yuNfldDkKnkvM=","method":"flat"}},"system":"builtin","version":4},"3fiaam5rvj8yfacngwr7p9vs11zd8n5g-Compress-Raw-Zlib-2.222.tar.gz.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"builtin:fetchurl","