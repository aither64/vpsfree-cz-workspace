720ssrdivgzvw-ncurses-6.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ncurses-6.6","outputs":{"dev":{"path":"dgvn2c174c1fy0lcfyx0hzq76qn6jmnn-ncurses-6.6-dev"},"man":{"path":"ck6vw204rkhgay9bvbn9bmv19lrqyqhc-ncurses-6.6-man"},"out":{"path":"hzqwc6pv8sb9qrwivc4h42cr811gs1mk-ncurses-6.6"}},"structuredAttrs":{"buildInputs":[],"builder":"/nix/store/10dxp0qxqxxsyiljrh2kp0xqhz6arhcx-bash-5.3p15/bin/bash","cmakeFlags":[],"configureFlags":["--with-shared","--enable-pc-files","--enable-symlinks","--with-manpage-format=normal","--disable-stripping","--with-versioned-syms","--without-debug","cf_cv_type_of_bool=bool","--build=x86_64-unknown-linux-gnu","--host=x86_64-unknown-linux-gnu"],"configurePlatforms":["build","host"],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{},"mesonFlags":[],"name":"ncurses-6.6","nativeBuildInputs":["/nix/store/3j39dy6iz8qiims0lkiip2w2jj0im2if-update-autotools-gnu-config-scripts-hook","/nix/store/b9izmrfjp0qnnyahdwwrzdwi87s1h179-pkg-config-wrapper-0.29.2"],"outputChecks":{"dev":{},"man":{},"out":{}},"outputs":["out","dev","man"],"patches":[],"pname":"ncurses","postInstall":"rm \"$out\"/lib/*.a\n# Determine what suffixes our libraries have\nsuffix=\"$(awk -F': ' 'f{print $3; f=0} /default library suffix/{f=1}' config.log)\"\nlibs=\"$(ls $dev/lib/pkgconfig | tr ' ' '\\n' | sed \"s,\\(.*\\)$suffix\\.pc,\\1,g\")\"\nsuffixes=\"$(echo \"$suffix\" | awk '{for (i=1; i < length($0); i++) {x=substr($0, i+1, length($0)-i); print x}}')\"\n\n# Get the path to the config util\ncfg=$(basename $dev/bin/ncurses*-config)\n\n# symlink the full suffixed include directory\nln -svf . $dev/include/ncurses$suffix\n\nfor newsuffix in $suffixes \"\"; do\n  # Create a non-abi versioned config util links\n  ln -svf $cfg $dev/bin/ncurses$newsuffix-config\n\n  # Allow for end users who #include <ncurses?w/*.h>\n  ln -svf . $dev/include/ncurses$newsuffix\n\n  for library in $libs; do\n    for dylibtype in so dll dylib; do\n      if [ -e \"$out/lib/lib${library}$suffix.$dylibtype\" ]; then\n        ln -svf lib${library}$suffix.$dylibtype $out/lib/lib$library$newsuffix.$dylibtype\n        ln -svf lib${library}$suffix.$dylibtype.6 $out/lib/lib$library$newsuffix.$dylibtype.6\n        if [ \"ncurses\" = \"$library\" ]\n        then\n          # make libtinfo symlinks\n          ln -svf lib${library}$suffix.$dylibtype $out/lib/libtinfo$newsuffix.$dylibtype\n          ln -svf lib${library}$suffix.$dylibtype.6 $out/lib/libtinfo$newsuffix.$dylibtype.6\n        fi\n      fi\n    done\n    for statictype in a dll.a la; do\n      if [ -e \"$out/lib/lib${library}$suffix.$statictype\" ]; then\n        ln -svf lib${library}$suffix.$statictype $out/lib/lib$library$newsuffix.$statictype\n        if [ \"ncurses\" = \"$library\" ]\n        then\n          # make libtinfo symlinks\n          ln -svf lib${library}$suffix.$statictype $out/lib/libtinfo$newsuffix.$statictype\n        fi\n      fi\n    done\n    ln -svf ${library}$suffix.pc $dev/lib/pkgconfig/$library$newsuffix.pc\n  done\ndone\n\n# add pkg-config aliases for libraries that are built-in to libncurses(w)\nfor library in tinfo tic; do\n  for suffix in \"\" w; do\n    ln -svf ncurses$suffix.pc $dev/lib/pkgconfig/$library$suffix.pc\n  done\ndone\n\n# move some utilities to $bin\n# these programs are used at runtime and don't really belong in $dev\nmoveToOutput \"bin/clear\" \"$out\"\nmoveToOutput \"bin/reset\" \"$out\"\nmoveToOutput \"bin/tabs\" \"$out\"\nmoveToOutput \"bin/tic\" \"$out\"\nmoveToOutput \"bin/tput\" \"$out\"\nmoveToOutput \"bin/tset\" \"$out\"\nmoveToOutput \"bin/captoinfo\" \"$out\"\nmoveToOutput \"bin/infotocap\" \"$out\"\nmoveToOutput \"bin/infocmp\" \"$out\"\n","postPatch":"sed -i '1i #include <stdbool.h>' include/curses.h.in\n","preConfigure":"export PKG_CONFIG_LIBDIR=\"$dev/lib/pkgconfig\"\nmkdir -p \"$PKG_CONFIG_LIBDIR\"\nconfigureFlags+=(\n  \"--libdir=$out/lib\"\n  \"--includedir=$dev/include\"\n  \"--bindir=$dev/bin\"\n  \"--mandir=$man/share/man\"\n  \"--with-pkg-config-libdir=$PKG_CONFIG_LIBDIR\"\n)\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":false,"setOutputFlags":false,"src":"/nix/store/1hkx09zxzwwhqwnr5rdi7r2v7jbiki00-ncurses-6.6.tar.gz","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"6.6"},"system":"x86_64-linux","version":4},"197bmhqc62fnmij7hi0gdz64xgir4nk6-tmux-3.6a.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"tmux","__structuredAttrs":"","buildInputs":"/nix/store/8cyxkapwg2r784bg1zjgznxj9ir3ysjd-ncurses-6.6-dev /nix/store/s9phy6v5n9sb0lp7gdz874hx02s5alaz-libevent-2.1.13-dev /nix/store/2h2dw9rzlrs2xyi46parmpcxpzgiz4dh-systemd-minimal-libs-260.2-dev /nix/store/2iqpv8xym5hqb48py37gab2n2m2pv63n-utf8proc-2.11.3 /nix/store/3a1nicxmjajbpna6jxg4zxmkdgs38qra-libutempter-1.2.3","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"--sysconfdir=/etc --localstatedir=/var --enable-systemd --enable-sixel --enable-utempter --enable-utf8proc","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"