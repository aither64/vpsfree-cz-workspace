etc\n\n# rust-lld is the name rustup uses for its bundled lld, so that it\n# doesn't conflict with any system lld.  This is not an\n# appropriate default for Nixpkgs, where there is no rust-lld.\nsubstituteInPlace compiler/rustc_target/src/spec/*/*.rs \\\n  --replace-quiet '\"rust-lld\"' '\"lld\"'\n\nrm -rf src/llvm\n\n# Useful debugging parameter\n# export VERBOSE=1\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"setOutputFlags":false,"setupHooks":"/nix/store/skyp8xs2584fkc44ki1cim9ag55wbi68-setup-hook.sh","src":"/nix/store/rjla2n2jag8m7n8f2515s3rb74g985af-rustc-1.98.1-src.tar.gz","stdenv":"/nix/store/rplwbx3hgs4wzc9hcs6r3cgp9r048fgl-stdenv-linux","strictDeps":true,"stripDebugList":["bin"],"system":"x86_64-linux","version":"1.98.1"},"system":"x86_64-linux","version":4},"xjkkh2xc1myf9fj7ywk5zc6bbvjgfg6k-crate-colorchoice-1.0.4.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/mnn3lydf2grr1yrz107y4i69y5jf2j10-crate-colorchoice-1.0.4.tar.gz"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"fipldvf4rvwd547anz21awdm06xvvl8d-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"crate-colorchoice-1.0.4.tar.gz","outputs":{"out":{"hash":"sha256-sFth3FESy7F+S2zWF5DZhF0TiINWORYky+fkHv6sHnU=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags"