":{"drvs":{"1vgxf29abq71i0mh3m5839my4664jfmh-tinycc-mes-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"waf4kczw67cway08qchwrcz38fih4y63-tinycc-mes-boot-chain-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"tinycc-mes-chain-unstable-2025-12-03-builder","outputs":{"out":{"path":"xwyi18mfkbn61by2viy6n7j8dzf88sai-tinycc-mes-chain-unstable-2025-12-03-builder"}},"system":"x86_64-linux","version":4},"09aln9yisls20di7x9wj1kiwhbp2gmm1-oputc.drv":{"args":["--verbose","--strict","--file","/nix/store/0vhlmlg7zbvh2if5f0qmkhllhbsz8h8d-oputc-builder"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin:/nix/store/53zd871rgpcvi7qmqkffxhzaiq0is7k4-mescc-tools-1.9.1/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","name":"oputc","out":"/nix/store/69q9hr049js0j3pv2wgwp1fhgdhfpyds-oputc","system":"x86_64-linux"},"inputs":{"drvs":{"pz3m6g7iabylyazm40p363y8795vybf9-mescc-tools-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"xk5gc7f6j4h9hcx2z3in2cz12knwmj1a-oputc-builder.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":[]},"name":"oputc","outputs":{"out":{"path":"69q9hr049js0j3pv2wgwp1fhgdhfpyds-oputc"}},"system":"x86_64-linux","version":4},"09d60qm2zsaynsl70arr35zj055zdzl3-glibc-2.44-25.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5