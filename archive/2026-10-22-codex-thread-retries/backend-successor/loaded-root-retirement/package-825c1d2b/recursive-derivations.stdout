gs echo remove leading spaces)\n  wrapperInterpreter=$(echo \"$wrapperInterpreterLine\" | xargs echo | cut -d \" \" -f1)\n\n  if isScript $wrapperInterpreter\n  then\n    echo \"error: passed interpreter ($interpreter) is a script which has another script ($wrapperInterpreter) as an interpreter, which is not supported.\"\n    exit 1\n  fi\n\n  # This should work as long as wrapperInterpreter is a shell, which is\n  # the case for programs wrapped with makeWrapper, like\n  # python3.withPackages etc.\n  interpreterLine=\"$wrapperInterpreterLine $interpreter\"\nelse\n  interpreterLine=$interpreter\nfi\n\necho \"#! $interpreterLine\" > $out\ncat \"$contentPath\" >> $out\n\nchmod +x $out\n\n# Relocate executable\n# Wrap it if makeWrapperArgs are specified\nmv $out tmp\n  mkdir -p $out/$(dirname \"/bin/pythoncheck.sh\")\n  mv tmp $out//bin/pythoncheck.sh\nif [ -n \"${makeWrapperArgs+${makeWrapperArgs[@]}}\" ]; then\n    wrapProgram $out//bin/pythoncheck.sh ${makeWrapperArgs[@]}\nfi\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","content":"exec /nix/store/34zamrwmzg8i492gccdsavs6q8if754a-python3.13-flake8-7.3.0/bin/flake8 --show-source --ignore E501,W503 \"$1\"\n","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","interpreter":"/nix/store/ww21sq59scy3kfz9vsnvjcixwyf06hvk-dash-0.5.13.3/bin/dash","makeWrapperArgs":"","mesonFlags":"","name":"pythoncheck.sh","nativeBuildInputs":"/nix/store/hxzjnjwzvwn5ak0hkp5q7jhxvk86f24p-make-binary-wrapper-hook","out":"/nix/store/z0c2bs1gbzr8yir78c2d63f9jhk1nfx4-pythoncheck.sh","outputs":"out","passAsFile":"buildCommand content","patches":"","preferLocalBuild":"1","propagatedBuildInputs":