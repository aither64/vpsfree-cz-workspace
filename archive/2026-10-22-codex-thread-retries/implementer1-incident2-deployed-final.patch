+			f.restart(t)
+			if lost {
+				unknown := f.request(context.Background(), planDeliveryID, "plan-turn", "same")
+				if unknown.Code != http.StatusServiceUnavailable {
+					t.Fatal("unknown was replayed", unknown.Code)
+				}
