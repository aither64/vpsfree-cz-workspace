+	roster, err := store.Load("example", "thread-1")
+	if err != nil && !os.IsNotExist(err) {
+		return nil, nil, err
+	}
+	if roster != nil {
+		for _, member := range roster.Members {
+			threads = append(threads, codex.ThreadMetadata{ID: member.Thread, Cwd: c.cwd, Source: "vscode"})
