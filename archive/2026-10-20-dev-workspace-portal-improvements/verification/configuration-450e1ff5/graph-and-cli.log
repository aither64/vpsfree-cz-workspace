NAME
    generation - Manage built machine generations

SYNOPSIS

    confctl [global options] generation ls [-a arg|--attr arg] [-l|--local] [-r|--remote] [-t arg|--tag arg] [machine-pattern [generation-pattern]]

    confctl [global options] generation rm [--gc|--collect-garbage] [--max-concurrent-gc n] [-a arg|--attr arg] [-l|--local] [-r|--remote] [-t arg|--tag arg] [-y|--yes] [machine-pattern [generation-pattern|old]]

    confctl [global options] generation rotate [--gc|--collect-garbage] [--max-concurrent-gc n] [-a arg|--attr arg] [-l|--local] [-r|--remote] [-t arg|--tag arg] [-y|--yes] [machine-pattern]

COMMANDS
    ls     - List machine generations
    rm     - Remove machine generations
    rotate - Auto-remove old machine generations

NAME
    confctl - Nix deployment configuration management tool


SYNOPSIS
    confctl [global options] command [command options] [arguments...]


GLOBAL OPTIONS
    -c, --color=arg - Toggle color mode (default: auto)
    --help          - Show this message


COMMANDS
    add             - Add a new machine
    build           - Build target systems
    changelog       - Changelog between deployed and configured swpins
    collect-garbage - Run nix-collect-garbage to deleted unreachable store paths
    cssh            - Open ClusterSSH
    deploy          - Deploy target systems
    diff            - Diff between deployed and configured swpins
    gen-data        - Generate data files
    generation      - Manage built machine generations
    health-check    - Run machine health-checks
    help            - Shows a list of commands or help for one command
    init            - Create a new configuration
    inputs          - Manage flake inputs (replacement for swpins in flake
                      configs)
    ls              - List configured machines
    migrate         - Migration helpers
    rediscover      - Update cluster machine list with contents of cluster/
    rename          - Rename an existing machine
    runtime-kernels - Manage node runtime kernel versions
    ssh             - Run command over SSH
    status          - Check machine status
    swpins          - Manage software pins
    test-connection - Test SSH connection
