From 8bb317b9359deb4a98219aa6387396cf3fa2d014 Mon Sep 17 00:00:00 2001
From: Jakub Skokan <jakub.skokan@havefun.cz>
Date: Tue, 20 Oct 2026 22:41:53 +0200
Subject: [PATCH 05/13] portal: publish session membership before optional
 enrichment

Keep the first session list usable while Git, activity or cluster readers
are slow. Publish validated membership independently and retain measured
cluster counts only for the same observation identity.

An additive known-count flag distinguishes unknown from measured zero.
The integer fallback keeps older assets usable, while routine loading is
silent and real failures retain their existing warning grace period.
---
 docs/workspace-portal.md                      |  9 ++-
 .../web/index_cluster_contract_test.cjs       | 15 ++++
 portal/internal/web/index_loading_test.go     | 40 +++++++++++
 portal/internal/web/operation_state.go        |  6 +-
 portal/internal/web/server.go                 | 71 ++++++++++++++-----
 portal/internal/web/server_test.go            | 20 ++++++
 portal/internal/web/static/app.js             | 19 +++--
 7 files changed, 154 insertions(+), 26 deletions(-)
 create mode 100644 portal/internal/web/index_cluster_contract_test.cjs

diff --git a/docs/workspace-portal.md b/docs/workspace-portal.md
index 39eb426..752858b 100644
--- a/docs/workspace-portal.md
+++ b/docs/workspace-portal.md
@@ -349,8 +349,13 @@ confirmed pair.
 
 Browser refresh timings come from codex-web's `conversation/assets/refresh.js`.
 That policy contains resource intervals, deadlines, retry backoff and notice
-delays. Background refreshes keep the last values visible. Initial loading
-appears after 750 ms and manual older-history loading after 250 ms. Refresh
+delays. Background refreshes keep the last values visible. Initial transcript loading
+appears after 750 ms and manual older-history loading after 250 ms. Routine index
+status loading is silent, and membership is published before optional repository,
+activity and cluster enrichment. The additive `runningClustersKnown` display flag distinguishes unknown counts
+from measured zero; older assets keep the integer `runningClusters` fallback.
+An absent flag retains legacy numeric behavior. Unknown counts do not grant
+controls or generate notifications. Refresh
 failures appear after 30 continuous visible seconds; returning to a hidden tab
 or restoring a page starts a fresh grace period. Access errors and failures of
 user actions appear immediately.
diff --git a/portal/internal/web/index_cluster_contract_test.cjs b/portal/internal/web/index_cluster_contract_test.cjs
new file mode 100644
index 0000000..6a78170
--- /dev/null
+++ b/portal/internal/web/index_cluster_contract_test.cjs
@@ -0,0 +1,15 @@
+"use strict";
+const assert = require("node:assert/strict");
+const {indexClusterPresentation} = require("./static/app.js");
+  for (const count of [0, 2]) {
+    const legacy = indexClusterPresentation({runningClusters: count});
+    const measured = indexClusterPresentation({runningClusters: count, runningClustersKnown: true});
+    assert.deepEqual(legacy, measured);
+    assert.equal(measured.hidden, count === 0);
+    assert.equal(measured.text, `${count} running clusters`);
+  }
+  const unknown = {runningClusters:0, runningClustersKnown:false};
+  // Baseline assets hide the integer fallback; new assets clear any stale text.
+  assert.equal(unknown.runningClusters === 0, true);
+  assert.deepEqual(indexClusterPresentation(unknown), {text:"", title:"", hidden:true});
+  assert.equal(indexClusterPresentation({...unknown, clusterNotice:"Genuine failure"}).hidden, false);
