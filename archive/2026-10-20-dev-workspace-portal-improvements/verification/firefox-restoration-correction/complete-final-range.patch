+	transcript := codex.Transcript{Entries: []codex.TranscriptEntry{agent, user, {Kind: "userMessage", Text: "Team assignment from lead to implementer0:\n\nWork."}, {Kind: "userMessage", Text: "hidden envelope", DisplayText: &empty}}}
