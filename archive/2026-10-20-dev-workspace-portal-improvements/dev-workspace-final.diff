diff --git a/portal/internal/web/submission_loss_test.go b/portal/internal/web/submission_loss_test.go
new file mode 100644
index 0000000..fefb7cb
--- /dev/null
+++ b/portal/internal/web/submission_loss_test.go
@@ -0,0 +1,96 @@
+package web
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/aither64/codex-web/codex"
+)
+
+// The transport fixture retains the same native idempotency contract as Codex:
+// repeated identical IDs return a receipt; mismatched input refuses.
+type responseLossCodex struct {
+	*browserContractCodex
+	mu       sync.Mutex
+	receipts map[string]codex.SendReceipt
+}
+
+func (c *responseLossCodex) Send(ctx context.Context, thread, message, id, action string) (codex.SendReceipt, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if receipt, ok := c.receipts[id]; ok {
+		return receipt, nil
+	}
+	receipt, err := c.browserContractCodex.Send(ctx, thread, message, id, action)
+	if err == nil {
+		c.receipts[id] = receipt
+	}
+	return receipt, err
+}
+
+func TestPortalSendResponseLossAndHTTPRestartReconcileOriginalAttempt(t *testing.T) {
+	server := newTestServer(t)
+	defer server.Close()
+	prepareInteractiveConversation(t, server, "example")
+	controller := &browserContractCodex{transcript: codex.Transcript{ThreadID: "thread-1", Status: "idle", CollaborationMode: "default"}}
+	server.config.Codex = &responseLossCodex{browserContractCodex: controller, receipts: make(map[string]codex.SendReceipt)}
+	handler := server.Handler()
+	// Execute the actual handler and then lose its response on the wire. Native
+	// acceptance and the retained submission ledger survive the HTTP restart.
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, r)
+		if recorder.Code != http.StatusAccepted {
+			t.Errorf("initial handler: %d %s", recorder.Code, recorder.Body.String())
+		}
+		conn, _, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		_ = conn.Close()
+	}))
+	const body = `{"message":"Response-loss fixture","clientUserMessageId":"12c12a7b-1898-4d29-85b4-012345678901"}`
+	send := func(base string, retry bool) (*http.Response, error) {
+		content := body
+		if retry {
+			content = strings.TrimSuffix(content, "}") + `,"retry":true}`
+		}
+		request, err := http.NewRequest(http.MethodPost, base+"/api/sessions/example/message", strings.NewReader(content))
+		if err != nil {
+			t.Fatal(err)
+		}
+		request.Header.Set("Origin", server.config.BaseURL)
+		request.Header.Set("Content-Type", "application/json")
+		return http.DefaultClient.Do(request)
+	}
+	response, err := send(upstream.URL, false)
+	if err == nil {
+		response.Body.Close()
+		t.Fatal("fixture did not lose the response")
+	}
+	upstream.Close()
+	restarted := httptest.NewServer(handler)
+	defer restarted.Close()
+	for range 2 {
+		response, err = send(restarted.URL, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		data, readErr := io.ReadAll(response.Body)
+		response.Body.Close()
+		if readErr != nil || response.StatusCode != http.StatusAccepted || !strings.Contains(string(data), "12c12a7b-1898-4d29-85b4-012345678901") {
+			t.Fatalf("retry: %v %d %s", readErr, response.StatusCode, data)
+		}
+	}
+	controller.mu.Lock()
+	defer controller.mu.Unlock()
+	if controller.sendCount != 1 {
+		t.Fatalf("response loss created %d native turns", controller.sendCount)
+	}
+}
diff --git a/portal/internal/web/team_add_contract_test.cjs b/portal/internal/web/team_add_contract_test.cjs
new file mode 100644
index 0000000..8f497a6
--- /dev/null
+++ b/portal/internal/web/team_add_contract_test.cjs
@@ -0,0 +1,36 @@
+"use strict";
+const fs = require("node:fs"), vm = require("node:vm"), assert = require("node:assert/strict");
+(async () => {
+  const source = fs.readFileSync("static/app.js", "utf8");
+  const start = source.indexOf('  document.addEventListener("submit", async (event) => {\n    const form = event.target.closest("[data-direct-team-form]");');
+  const end = source.indexOf('  document.addEventListener("change", (event) => {', start);
+  assert(start > 0 && end > start);
+  let submit, release, fail = false, requests = [], refreshes = 0;
+  const controls = [{disabled:false}], status = {}, form = {
+    dataset:{action:"add"}, elements:{role:{value:"implementer"}, model:{value:"model-1"}, effort:{value:"xhigh"}},
+    querySelector: () => status, querySelectorAll: () => controls,
+  };
+  const context = {interactive:true, models:[{model:"model-1", supportedReasoningEfforts:[{reasoningEffort:"xhigh"}]}],
+    document:{addEventListener: (type, callback) => {if (type === "submit") submit = callback;}},
+    updateAddMemberEligibility: () => {}, refreshSessionDetails: () => {refreshes++;},
+    directTeamRequest: async body => {requests.push({...body}); await new Promise(resolve => {release = resolve;}); if (fail) throw new Error("fixture failure");},
+    setTimeout: () => {throw new Error("Add must not reload/reset the form");},
+  };
+  vm.runInNewContext(source.slice(start, end), context);
+  const event = {target:{closest: () => form}, preventDefault(){}};
+  const pending = submit(event); await submit(event);
+  assert.equal(requests.length,1); assert(controls[0].disabled);
+  // A delayed response cannot retarget the already captured request.
+  form.elements.effort.value = "low";
+  release(); await pending;
+  assert.equal(requests[0].reasoningEffort,"xhigh"); assert.equal(form.elements.effort.value,"xhigh");
+  assert.equal(form.elements.model.value,"model-1"); assert.equal(form.elements.role.value,"implementer");
+  assert(!controls[0].disabled); assert.equal(refreshes,1);
+  const next = submit(event); release(); await next;
+  assert.equal(requests.length,2); assert.deepEqual(requests[1],requests[0]);
+  fail = true; const failure = submit(event); release(); await failure;
+  assert.equal(form.elements.effort.value,"xhigh"); assert.equal(status.textContent,"fixture failure");
+  assert(!controls[0].disabled); assert(!form.dataset.teamSubmitting);
+  form.elements.effort.value = "unsupported"; await submit(event); assert.equal(requests.length,3);
+  console.log("Add-member captured settings, duplicate submit and sequential/error retention passed.");
+})().catch(error => {console.error(error); process.exitCode=1;});
