          user_namespace_map: userns_map,
          kind: kind,
          vps_id: 0,
          ns_id: 0,
          count: userns.size
        ))
      end
    end

    ret
  end

  $user_lifecycle_create_namespace_hook = true
end

puts JSON.dump(status: true)

