COMMAND: set -euo pipefail
api_dir="$(systemctl show -p WorkingDirectory --value vpsadmin-api)"
api_root="$(dirname "$api_dir")"
tmp_rb="$(mktemp /tmp/vpsadmin-storage-XXXX.rb)"
trap 'rm -f "$tmp_rb"' EXIT

cat > "$tmp_rb" <<'RUBY'
ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.find(1)
User.current = user
UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)


vps = Vps.find(1)
target_node = Node.find(101)
attrs = {
  start: true,
  expiration_date: nil,
  reason: "same-node replace integration",
  preserve_backups: nil,
  preserve_backup_history: nil
}
attrs.delete_if { |_k, v| v.nil? }

chain_class = TransactionChains::Vps::Replace.chain_for(vps, target_node)
chain, replaced_vps = chain_class.fire(vps, target_node, attrs)

puts JSON.dump(chain_id: chain.id, replaced_vps_id: replaced_vps.id)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
