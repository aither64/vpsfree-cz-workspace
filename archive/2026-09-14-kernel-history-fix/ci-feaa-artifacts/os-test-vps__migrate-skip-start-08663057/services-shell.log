START: 2026-09-14 12:45:29 +0200
COMMAND: set -euo pipefail
api_dir="$(systemctl show -p WorkingDirectory --value vpsadmin-api)"
api_root="$(dirname "$api_dir")"
tmp_rb="$(mktemp /tmp/vpsadmin-storage-XXXX.rb)"
trap 'rm -f "$tmp_rb"' EXIT

cat > "$tmp_rb" <<'RUBY'
ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.find(1)
User.current = user
UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)


vps = Vps.find(1)
node = Node.find(102)
migration_chain = TransactionChains::Vps::Migrate.chain_for(vps, node)

if true
  hooks = HaveAPI::Hooks.hooks || {}
  unless hooks[migration_chain] && hooks[migration_chain][:post_start]
    migration_chain.has_hook(:post_start)
  end

  migration_chain.connect_hook(:post_start) do |ret, chain:, **|
    tx = Transaction.find(chain.last_id)
    unless tx.handle == Transactions::Vps::Start.t_type
      raise "expected last transaction to be vps_start, got handle=#{tx.handle}"
    end

    tx.update!(input: '{bad-json')
    ret
  end
end

chain, = migration_chain.fire(
  vps,
  node,
  maintenance_window: false,
  cleanup_data: true,
  no_start: false,
  skip_start: true,
  send_mail: false
)

puts JSON.dump(chain_id: chain.id)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
END: 2026-09-14 12:45:36 +0200
