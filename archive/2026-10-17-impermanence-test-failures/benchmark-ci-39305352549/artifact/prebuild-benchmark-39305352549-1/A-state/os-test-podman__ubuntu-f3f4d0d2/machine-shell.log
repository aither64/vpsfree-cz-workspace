'\ \ echo\ 1\ \>\ \"\$event/enable\"'
'done'
'functions\=\'security_capable\''
'\#\ Return-only\ probes\ also\ support\ compiler-specialized\ static\ helpers\;'
'\#\ do\ not\ fetch\ arguments\ from\ clones\ with\ potentially\ changed\ ABIs.'
'helpers\=\$\(awk\ \'\$2\ \~\ /\^\[tT\]\$/\ \&\&\ \$3\ \~\ /\^seccomp_\(set_mode_filter\|prepare_user_filter\|prepare_filter\)\(\[.\]\(isra\|constprop\)\[.\]\[0-9\]+\)\*\$/\ \{\ print\ \$3\ \}\'\ /proc/kallsyms\)'
'for\ function\ in\ \$functions\ \$helpers\;\ do'
