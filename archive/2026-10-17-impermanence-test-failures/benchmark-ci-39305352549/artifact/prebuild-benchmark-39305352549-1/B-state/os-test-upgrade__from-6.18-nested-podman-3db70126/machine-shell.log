  test -d "$root" || continue
  find "$root" -path '*user.limited/ct.limited/cpu.stat' -o -path '*user.limited/ct.limited/memory.events' -o -path '*user.limited/ct.limited/memory.oom_control' | while read file; do
    echo "=== $file ==="
    cat "$file"
  done
done
true
