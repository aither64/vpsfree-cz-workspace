  osctl -j ct show systemd-ebpf |
    ruby -rjson -e 'puts JSON.parse($stdin.read).fetch("init_pid")'
)"
rel="$(sed -n 's/^[0-9]*:://p' "/proc/$init_pid/cgroup" | sed -n '1p')"
