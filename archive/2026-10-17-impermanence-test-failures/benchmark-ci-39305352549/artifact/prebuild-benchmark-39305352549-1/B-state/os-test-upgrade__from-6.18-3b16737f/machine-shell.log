COMMAND: set +e
date -Ins
cat /proc/uptime /proc/loadavg
cat /run/upgrade-probe-1-cpu.log
for pid in $(pgrep -f 'osctld-ct-runner$|^osctld: tank:limited runner:|^/bin/upgrade-resource-probe'); do
