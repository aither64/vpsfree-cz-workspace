  ps -p "$pid" -o pid,ppid,etimes,time,stat,wchan:24,args
  cat /proc/$pid/stat /proc/$pid/schedstat /proc/$pid/cgroup
  grep -E '^(State|VmRSS|Sig|Cpus_allowed_list)' /proc/$pid/status
