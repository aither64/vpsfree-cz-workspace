+++ b/tests/suite/zfs/boot-modes.nix
@@ -0,0 +1,114 @@
+import ../../make-test.nix (
+  { pkgs }:
+  let
+    guestConfig =
+      zfsBuiltin:
+      { config, pkgs, ... }:
+      {
+        boot.zfsBuiltin = zfsBuiltin;
+        environment.systemPackages = with pkgs; [
+          kmod
+          coreutils
+          findutils
+          gnugrep
+        ];
+        environment.etc = {
+          "zfs-boot-mode-module-package".text =
+            let
+              package =
+                if config.boot.zfsBuiltin then config.boot.kernelPackage else config.boot.kernelPackages.zfs;
+            in
+            "${package}\n";
+          "zfs-boot-mode-kernel-release".text = "${config.boot.kernelPackage.modDirVersion}\n";
+        };
+      };
+  in
+  {
+    name = "zfs-boot-modes";
+    description = "Default-kernel ZFS boot and data operations with builtin and external modules";
+    tags = [ "ci" ];
+
+    # Keep normal kernel selection in both configurations. Metadata parity is
+    # checked separately; these guests exercise the resulting boot artifacts.
+    machines = {
+      builtin_zfs = import ../../machines/vpsadminos/with-tank.nix {
+        inherit pkgs;
+        config = guestConfig true;
+      };
+      external_zfs = import ../../machines/vpsadminos/with-tank.nix {
+        inherit pkgs;
+        config = guestConfig false;
+      };
+    };
+
+    testScript = ''
+      describe 'default-kernel ZFS packaging' do
+        { builtin: builtin_zfs, external: external_zfs }.each do |mode, host|
+          it "boots and preserves data through ZFS operations with the #{mode} ZFS package" do
+            host.start
+            host.wait_for_osctl_pool('tank')
+            host.succeeds('test -d /sys/module/zfs/parameters')
+            # The retained default kernel supplies loadable in-tree ZFS.
+            # Check configured resolver provenance; this does not identify the
+            # bytes of the already-loaded module.
+            host.succeeds("grep -q '^zfs ' /proc/modules")
+            _, provenance = host.succeeds(<<~'SH')
+              set -eu
+              package=$(cat /etc/zfs-boot-mode-module-package)
+              release=$(cat /etc/zfs-boot-mode-kernel-release)
+              test "$(uname -r)" = "$release"
+              test "$(readlink -f -- "$package")" = "$package"
+              module_dir="$package/lib/modules/$release"
+              test -d "$module_dir"
+              printf 'Expected module package: %s\nKernel release: %s\n' "$package" "$release"
+
+              tmp=$(mktemp -d)
+              trap 'rm -rf -- "$tmp"' EXIT
+              find "$module_dir" -name 'zfs.ko*' -print > "$tmp/candidates"
+              test "$(wc -l < "$tmp/candidates")" -eq 1
+              IFS= read -r candidate < "$tmp/candidates"
+              module=$(readlink -f -- "$candidate")
+              case "$module" in
+                "$package"/*) ;;
+                *) printf 'Module escapes expected package: %s\n' "$module" >&2; exit 1 ;;
+              esac
+              test -f "$module"
+              case "$(basename -- "$candidate")" in
+                zfs.ko|zfs.ko.xz) ;;
+                *) printf 'Unsupported module format: %s\n' "$candidate" >&2; exit 1 ;;
+              esac
+              selected=$(modinfo -b /run/booted-system/kernel-modules -k "$release" -n zfs)
+              selected=$(readlink -f -- "$selected")
+              printf 'Expected module: %s\nmodinfo module: %s\n' "$module" "$selected"
+              test "$selected" = "$module"
+              printf 'Configured module provider resolution matches selected output\n'
+            SH
+            puts "#{mode} ZFS provenance:\n#{provenance}"
+
+            host.all_succeed(
+              'zfs create tank/boot-mode-source',
+              'printf zfs-boot-mode-payload > /tank/boot-mode-source/payload',
+              'zfs snapshot tank/boot-mode-source@saved',
+              'zfs clone tank/boot-mode-source@saved tank/boot-mode-clone',
+              'cmp /tank/boot-mode-source/payload /tank/boot-mode-clone/payload',
+              'printf changed > /tank/boot-mode-source/payload',
+              'zfs rollback tank/boot-mode-source@saved',
+              'zfs send tank/boot-mode-source@saved | zfs receive tank/boot-mode-received',
+              'cmp /tank/boot-mode-source/payload /tank/boot-mode-received/payload',
+            )
+            %w[source clone received].each do |copy|
+              expect(host.succeeds("cat /tank/boot-mode-#{copy}/payload")[1]).to eq('zfs-boot-mode-payload')
+            end
+            host.all_succeed(
+              'zfs destroy tank/boot-mode-clone',
+              'zfs destroy -r tank/boot-mode-received',
+              'zfs destroy -r tank/boot-mode-source',
+            )
+            puts "#{mode} ZFS payload operations and cleanup completed"
+            host.stop
+          end
+        end
+      end
+    '';
+  }
+)
diff --git a/tests/zfs-package-parity-check.nix b/tests/zfs-package-parity-check.nix
new file mode 100644
index 000000000..e8b33020e
--- /dev/null
+++ b/tests/zfs-package-parity-check.nix
@@ -0,0 +1,99 @@
+{ pkgs, makeSystem }:
+let
+  inherit (pkgs) lib;
+  availableKernels = import ../os/packages/linux/available-kernels.nix { inherit lib; };
+
+  metadata = package: {
+    source = builtins.unsafeDiscardStringContext package.src.drvPath;
+    patches = map (patch: builtins.unsafeDiscardStringContext (toString patch)) package.patches;
+  };
+
+  checkSelection =
+    {
+      name,
+      kernelVersion ? null,
+    }:
+    let
+      makeConfig =
+        builtin:
+        (makeSystem {
+          modules = [
+            {
+              system.stateVersion = "26.05";
+              boot = {
+                zfsBuiltin = builtin;
+              }
+              # The default case must exercise normal kernel selection.
+              // lib.optionalAttrs (kernelVersion != null) { inherit kernelVersion; };
+            }
+          ];
+        }).config;
+
+      builtin = makeConfig true;
+      external = makeConfig false;
+      selectedVersion = builtin.boot.kernelVersion;
+      expectedVersion =
+        if kernelVersion == null then availableKernels.stableKernelVersion else kernelVersion;
+      tuple = availableKernels.kernels.${selectedVersion}.zfs;
+      expected = metadata {
+        src = pkgs.fetchFromGitHub {
+          owner = "vpsfreecz";
+          repo = "zfs";
+          inherit (tuple) rev sha256;
+        };
+        patches = tuple.patches or [ ];
+      };
+      builtinPackage = metadata builtin.boot.zfsBuiltinPkg;
+      externalPackage = metadata external.boot.kernelPackages.zfs;
+    in
+    {
+      inherit
+        name
+        selectedVersion
+        expected
+        builtinPackage
+        externalPackage
+        ;
+      assertions = [
+        (lib.assertMsg (
+          builtin.boot.zfsBuiltin && !external.boot.zfsBuiltin
+        ) "${name}: fixture did not select both ZFS modes")
+        (lib.assertMsg (selectedVersion == expectedVersion) "${name}: unexpected builtin kernel selection")
+        (lib.assertMsg (
+          external.boot.kernelVersion == selectedVersion
+        ) "${name}: ZFS mode changes kernel selection")
+        (lib.assertMsg (
+          builtinPackage == expected
+        ) "${name}: builtin ZFS differs from the declared source or ordered patches")
+        (lib.assertMsg (
+          externalPackage == expected
+        ) "${name}: external ZFS differs from the declared source or ordered patches")
+        (lib.assertMsg (
+          builtinPackage == externalPackage
+        ) "${name}: builtin and external ZFS source or ordered patches differ")
+      ];
+    };
+
+  selections = [
+    (checkSelection { name = "default"; })
+  ]
+  ++ map (
+    kernelVersion:
+    checkSelection {
+      name = kernelVersion;
+      inherit kernelVersion;
+    }
+  ) (builtins.attrNames availableKernels.kernels);
+  assertions = lib.concatMap (selection: selection.assertions) selections;
+in
+# Only force package metadata. Kernel/module outputs must not become inputs to
+# this check or be realized while evaluating it (run with IFD disabled).
+builtins.deepSeq assertions (
+  pkgs.runCommand "zfs-package-parity"
+    {
+      passthru.evaluation = map (selection: removeAttrs selection [ "assertions" ]) selections;
+    }
+    ''
+      touch "$out"
+    ''
+)
