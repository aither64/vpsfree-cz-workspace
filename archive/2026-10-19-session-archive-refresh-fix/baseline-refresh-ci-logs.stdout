archive	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:12.7597351Z # If not running interactively, don't do anything
archive	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:12.7597642Z [ -z "$PS1" ] && return
archive	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:12.7597782Z 
