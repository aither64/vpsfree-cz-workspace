creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2295063Z # System-wide .bashrc file for interactive bash(1) shells.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2295287Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2295464Z # To enable the settings / commands in this file for login shells as well,
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2295839Z # this file has to be sourced in /etc/profile.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2296032Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2296156Z # If not running interactively, don't do anything
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2296438Z [ -z "$PS1" ] && return
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2296566Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2296723Z # check the window size after each command and, if necessary,
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2297087Z # update the values of LINES and COLUMNS.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2297414Z shopt -s checkwinsize
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2297552Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2297753Z # set variable identifying the chroot you work in (used in the prompt below)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2298178Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2298718Z     debian_chroot=$(cat /etc/debian_chroot)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2298969Z fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2299062Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2299232Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2299641Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2300037Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2300357Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2300633Z fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2300740Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2300925Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2301316Z # If this is an xterm set the title to user@host:dir
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2301596Z #case "$TERM" in
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2301788Z #xterm*|rxvt*)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2302070Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2302390Z #    ;;
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2302802Z #*)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2302986Z #    ;;
