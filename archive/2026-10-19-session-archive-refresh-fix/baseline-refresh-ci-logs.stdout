creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2305388Z #  fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2305633Z #fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2305771Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2305875Z # sudo hint
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2306220Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2306825Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2307108Z     if [ -x /usr/bin/sudo ]; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2307336Z 	cat <<-EOF
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2307618Z 	To run a command as administrator (user "root"), use "sudo <command>".
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2307962Z 	See "man sudo_root" for details.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2308209Z 	
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2308371Z 	EOF
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2308533Z     fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2308704Z     esac
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2308874Z fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2308971Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2309109Z # if the command-not-found package is installed, use it
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2309569Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2309994Z 	function command_not_found_handle {
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2310309Z 	        # check because c-n-f could've been removed in the meantime
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2310771Z                 if [ -x /usr/lib/command-not-found ]; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2311245Z 		   /usr/lib/command-not-found -- "$1"
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2311678Z                    return $?
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2312187Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2313670Z 		   /usr/share/command-not-found/command-not-found -- "$1"
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2313981Z                    return $?
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2314189Z 		else
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2314397Z 		   printf "%s: command not found\n" "$1" >&2
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2314661Z 		   return 127
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2314844Z 		fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2315021Z 	}
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2315184Z fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:37:15.2324003Z 
