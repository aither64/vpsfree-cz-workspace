api_dir="$(systemctl show -p WorkingDirectory --value vpsadmin-api)"
api_root="$(dirname "$api_dir")"
tmp_rb="$(mktemp /tmp/vpsadmin-storage-XXXX.rb)"
trap 'rm -f "$tmp_rb"' EXIT

cat > "$tmp_rb" <<'RUBY'
ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.find(1)
User.current = user
UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)


vps = Vps.find(1)
dip = DatasetInPool.find(3)
mount = Mount.create!(
  vps: vps,
  dataset_in_pool: dip,
  dst: '/mnt/external',
  mount_opts: '--bind',
  umount_opts: '-f',
  mount_type: 'bind',
  mode: 'rw',
  user_editable: false,
  confirmed: Mount.confirmed(:confirmed),
  enabled: true,
  master_enabled: true
)

puts JSON.dump(
  mount_id: mount.id,
  dataset_in_pool_id: mount.dataset_in_pool_id
)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
END: 2026-06-03 14:59:56 +0200
ELAPSED: 2.98s
STATUS: 0
OUTPUT:
{"mount_id":2,"dataset_in_pool_id":3}
---

START: 2026-06-03 14:59:56 +0200
COMMAND: set -euo pipefail
api_dir="$(systemctl show -p WorkingDirectory --value vpsadmin-api)"
api_root="$(dirname "$api_dir")"
tmp_rb="$(mktemp /tmp/vpsadmin-storage-XXXX.rb)"
trap 'rm -f "$tmp_rb"' EXIT

cat > "$tmp_rb" <<'RUBY'
ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.find(1)
User.current = user
UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)


vps = Vps.find(1)
target_node = Node.find(102)
attrs = {
  start: true,
  expiration_date: nil,
  reason: "replace descendants integration"
}
attrs.delete_if { |_k, v| v.nil? }

chain_class = TransactionChains::Vps::Replace.chain_for(vps, target_node)
chain, replaced_vps = chain_class.fire(vps, target_node, attrs)

puts JSON.dump(chain_id: chain.id, replaced_vps_id: replaced_vps.id)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
END: 2026-06-03 14:59:59 +0200
ELAPSED: 3.77s
STATUS: 0
OUTPUT:
{"chain_id":11,"replaced_vps_id":2}
---

