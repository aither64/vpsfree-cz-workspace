  require 'timeout'

  Timeout.timeout(20) do
    socket = Socket.new(:INET, :STREAM)
    socket.bind(Socket.sockaddr_in(0, "192.168.11.11"))
    socket.connect(Socket.sockaddr_in(8080, "192.168.11.10"))

    begin
