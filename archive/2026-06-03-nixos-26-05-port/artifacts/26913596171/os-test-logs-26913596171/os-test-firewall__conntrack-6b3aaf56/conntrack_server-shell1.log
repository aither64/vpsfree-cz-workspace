START: 2026-06-03 22:03:03 +0200
COMMAND: ip netns exec client ruby - <<'RUBY' >/tmp/tcp-hold-8080.log 2>&1 &
  require 'socket'
  require 'timeout'

  Timeout.timeout(20) do
    socket = Socket.new(:INET, :STREAM)
    socket.bind(Socket.sockaddr_in(0, "192.168.11.11"))
    socket.connect(Socket.sockaddr_in(8080, "192.168.11.10"))

    begin
      puts socket.readpartial(4096).strip
    sleep 15
  ensure
    socket.close
  end
end
RUBY
