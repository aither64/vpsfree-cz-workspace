network = Network.find_or_initialize_by(address: '198.51.100.0', prefix: 24)
network.assign_attributes(
  label: 'Storage Export Net',
  ip_version: 4,
  role: :private_access,
  managed: true,
  split_access: :no_access,
  split_prefix: 32,
  purpose: :export,
  primary_location: location
)
