    file_name: dl.file_name,
    size: dl.size,
    sha256sum: dl.sha256sum,
    format: dl.format,
    confirmed: dl.confirmed,
    url: dl.url
  )
end

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
