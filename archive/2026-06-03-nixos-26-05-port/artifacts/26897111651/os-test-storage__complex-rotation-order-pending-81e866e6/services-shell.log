'\'\\\ \\\ \\\'id\\\',\\\ s.id,\''
'\'\\\ \\\ \\\'snapshot_in_pool_id\\\',\\\ sip.id,\''
'\'\\\ \\\ \\\'name\\\',\\\ s.name,\''
'\'\\\ \\\ \\\'history_id\\\',\\\ s.history_id\''
'\'\\\)\''
'\'FROM\\\ snapshot_in_pools\\\ sip\''
