    state: migration.state,
    started_at: migration.started_at,
    finished_at: migration.finished_at,
    chain_id: migration.transaction_chain_id
  }
end

puts JSON.dump(rows)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
