ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.find(1)
User.current = user
UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)


netif = NetworkInterface.find(2)
chain, updated = TransactionChains::NetworkInterface::Update.fire(netif, {enable: false})

puts JSON.dump(chain_id: chain.id, netif_id: updated.id)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
END: 2026-06-03 15:07:50 +0200
