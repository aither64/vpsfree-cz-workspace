trap 'rm -f "$tmp_rb"' EXIT

cat > "$tmp_rb" <<'RUBY'
ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.unscoped.find(2)
puts JSON.dump(
  id: user.id,
  login: user.login,
  password: user.password,
  object_state: user.object_state,
  environment_user_config_count: user.environment_user_configs.count,
  user_cluster_resource_count: user.user_cluster_resources.count,
  personal_package_count: user.cluster_resource_packages.where(label: 'Personal package').count
)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
