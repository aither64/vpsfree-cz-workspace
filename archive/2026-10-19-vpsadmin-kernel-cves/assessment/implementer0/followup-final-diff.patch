+    def corrective_boot_after_uncertainty(assessments)
+      last_unsafe = assessments.rindex do |point|
+        %w[affected unknown].include?(point.dig('assessment', 'state'))
+      end
+      suffix = assessments[(last_unsafe + 1)..]
+      return unless suffix.all? do |point|
+        %w[fixed unaffected unreachable mitigated].include?(point.dig('assessment', 'state'))
+      end
+
+      cutoff = parse_time(assessments[last_unsafe]['observed_before'])
+      return unless cutoff
+
+      suffix.each do |point|
+        next unless point['event_type'] == 'boot' && point.dig('assessment', 'state') == 'fixed'
+
+        # A reported release change or a fixed current sample is not a corrective boot.
+        boot_release = point.dig('security_evidence', 'kernel', 'booted_release')
+        next unless version_rule_result('reported_release' => boot_release)['state'] == 'fixed'
+
+        upper = parse_time(point['observed_before'])
+        next unless upper && upper > cutoff
+
+        exact = parse_time(point['effective_at']) if point['confidence'] == 'exact'
+        if exact
+          return point if exact > cutoff && exact <= upper
+        else
+          lower = parse_time(point['observed_after'])
+          return point.merge('effective_at' => nil) if lower && lower >= cutoff && lower < upper
+        end
+      end
+      nil
+    end
+
