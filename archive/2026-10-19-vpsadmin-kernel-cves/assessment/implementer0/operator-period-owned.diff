+      claim = @advisory.platform.fetch('operator_node_exclusions', {})[node['node_id'].to_s]
+      return unless claim && claim['node_name'] == node['node_name'] && claim['node_role'] == node['node_role']
+
+      since = history_required_since(node)
+      return unless since && since <= @evidence_time &&
+                    parse_time(claim['valid_from']) <= since &&
+                    parse_time(claim['valid_through']) >= @evidence_time
+
+      evidence = [current_security_evidence(node)]
+      events = Array(node.dig('kernel', 'history')).sort_by do |event|
+        [event['observed_before'].to_s, event['id'].to_i]
+      end
+      baseline = events.reverse.find do |event|
+        observed = parse_time(event['observed_before'])
+        observed && observed <= since
+      end
+      events.each do |event|
+        observed = parse_time(event['observed_before'])
+        next unless event == baseline || (observed && observed > since && observed <= @evidence_time)
+
+        evidence << exact_event_evidence(node, event)
+      end
+      conflict = evidence.filter_map do |snapshot|
+        kernel = snapshot['kernel']
+        next unless kernel.is_a?(Hash)
+
+        configuration_options(snapshot, kernel)&.[](claim['option'])
+      end.find { |value| %w[y m].include?(value) }
+      if conflict
+        return unknown("operator attestation conflicts with exact #{claim['option']}=#{conflict} " \
+                       "configuration for node #{node['node_id']} (#{node['node_name']})")
+      end
+
+      not_affected(nil, "operator attestation excludes node #{node['node_id']} " \
+                        "(#{node['node_name']}, #{node['node_role']}): necessary #{claim['option']}=n " \
+                        "throughout #{since.utc.iso8601}..#{@evidence_time.utc.iso8601}; " \
+                        "#{claim['reason']} Source: #{claim['source']}")
+    end
+
     def corrective_boot_after_uncertainty(assessments)
       last_unsafe = assessments.rindex do |point|
         %w[affected unknown].include?(point.dig('assessment', 'state'))
