{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vpsFree.cz security advisory dossier",
  "type": "object",
  "required": [
    "schema_version",
    "cve",
    "name",
    "version_rules",
    "platform",
    "impact",
    "texts"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "cve": { "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
    "name": { "type": "string", "minLength": 1 },
    "node_notes": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["en", "cs"],
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n]+$"
          },
          "cs": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "version_rules": { "type": "object", "minProperties": 1 },
    "platform": {
      "type": "object",
      "required": [
        "configuration_assessed",
        "history_required_since",
        "affected_node_roles",
        "required_options",
        "required_sysctls",
        "accepted_kernel_builds",
        "accepted_livepatches",
        "accepted_ebpf_programs"
      ],
      "properties": {
        "configuration_assessed": { "const": true },
        "required_options": {
          "type": "object",
          "propertyNames": { "pattern": "^CONFIG_[A-Z0-9_]+$" },
          "additionalProperties": { "enum": ["enabled", "disabled", "y", "m", "n"] }
        },
        "required_sysctls": {
          "type": "object",
          "propertyNames": {
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        },
        "history_required_since": { "type": "string", "format": "date-time" },
        "affected_node_roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "accepted_kernel_builds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reported_release",
              "booted_release",
              "kernel_source_revision",
              "vpsadminos_revision",
              "config_digest",
              "deployment_digest",
              "fix_state"
            ],
            "properties": {
              "reported_release": { "type": "string", "minLength": 1 },
              "booted_release": { "type": "string", "minLength": 1 },
              "kernel_source_revision": { "type": "string", "minLength": 1 },
              "vpsadminos_revision": { "type": "string", "minLength": 1 },
              "config_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "deployment_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "fix_state": { "enum": ["affected", "fixed"] }
            },
            "additionalProperties": false
          }
        },
        "accepted_livepatches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "patch_version",
              "kernel_version",
              "kernel_source_revision",
              "vpsadminos_revision"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "patch_version": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "number" }
                ]
              },
              "kernel_version": { "type": "string", "minLength": 1 },
              "kernel_source_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "vpsadminos_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "additionalProperties": false
          }
        },
        "affected_livepatches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "patch_version",
              "kernel_version",
              "kernel_source_revision",
              "vpsadminos_revision"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "patch_version": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "number" }
                ]
              },
              "kernel_version": { "type": "string", "minLength": 1 },
              "kernel_source_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "vpsadminos_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "additionalProperties": false
          }
        },
        "accepted_ebpf_programs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "revision", "digest", "hooks"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "minLength": 1 },
              "hooks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "impact": { "type": "object" },
    "texts": { "type": "object" }
  },
  "allOf": [{
    "if": { "properties": { "schema_version": { "const": 1 } } },
    "then": {
      "properties": {
        "platform": { "not": { "required": ["affected_livepatches"] } }
      }
    }
  }],
  "additionalProperties": true
}
