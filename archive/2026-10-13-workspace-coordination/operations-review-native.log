justify-self: start; }\n .badge.archived { color: var(--muted); }\n .badge.warning { color: var(--warning); border-color: #66532e; }\n .badge.danger { color: var(--danger); border-color: #713b46; }\ndiff --git a/portal/internal/web/templates/index.html b/portal/internal/web/templates/index.html\nindex 402f75e..2542a6c 100644\n--- a/portal/internal/web/templates/index.html\n+++ b/portal/internal/web/templates/index.html\n@@ -5,7 +5,7 @@\n   <meta charset=\"utf-8\">\n   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n   <title>Workspace</title>\n-  <link rel=\"stylesheet\" href=\"/static/style.css?v=6\">\n+  <link rel=\"stylesheet\" href=\"/static/style.css?v=12\">\n   <link rel=\"stylesheet\" href=\"/codex/assets/uploads.css?v=3\">\n </head>\n <body data-index data-index-generated-at=\"{{.IndexGeneratedAt}}\">\n@@ -36,6 +36,7 @@\n   <main class=\"page index-page\">\n     {{if .Error}}<p class=\"notice error\">{{.Error}}</p>{{end}}\n     <p id=\"index-status-warning\" class=\"notice warning\" hidden></p>\n+    <p data-coordination-warning class=\"notice warning\" role=\"status\" hidden></p>\n     <section class=\"panel new-session\">\n       <div><p class=\"eyebrow\">Start work</p><h2>New session</h2><p class=\"muted\">Codex will decide which repositories the request affects. From {{.HostLabel}}, use <code>dev-session start &lt;short-name&gt;</code>.</p></div>\n       <form id=\"new-session-form\" method=\"post\" action=\"/sessions\" class=\"stack\">\n@@ -91,7 +92,8 @@\n   </div>\n   <template id=\"session-card-template\">{{template \"session-card\"}}</template>\n   <script src=\"/static/preparation.js?v=3\" defer></script>\n-  <script src=\"/static/app.js?v=37\" defer></script>\n+  <script src=\"/static/app.js?v=38\" defer></script>\n+  <script src=\"/static/coordination.js?v=2\" defer></script>\n </body>\n </html>\n {{end}}\n@@ -100,6 +102,7 @@\n <button class=\"sidebar-menu-toggle quiet\" type=\"button\" popovertarget=\"sidebar-menu\" title=\"Workspace menu\" aria-label=\"Workspace menu\"><span aria-hidden=\"true\">⋮</span></button>\n <nav id=\"sidebar-menu\" class=\"sidebar-menu\" popover=\"auto\" aria-label=\"Workspace navigation\">\n   <a href=\"/automatic-archival\" autofocus>Automatic archival</a>\n+  <a href=\"/operations\">Operations</a>\n </nav>\n {{end}}\n \n@@ -136,5 +139,6 @@\n   <span data-session-repositories>{{with .}}{{len .Repositories}} repositories{{end}}</span>\n   <span class=\"cluster-summary\" data-session-clusters hidden></span>\n   <span class=\"badge warning\" data-session-lifecycle hidden></span>\n+  <span class=\"badge reserved\" data-session-reservation hidden></span>\n </a>\n {{end}}\ndiff --git a/portal/internal/web/templates/session.html b/portal/internal/web/templates/session.html\nindex 8aa67dd..2306767 100644\n--- a/portal/internal/web/templates/session.html\n+++ b/portal/internal/web/templates/session.html\n@@ -125,6 +125,7 @@\n       {{end}}\n \n       <section id=\"handoff\" class=\"tab-panel {{if not .Session.Codex.ThreadID}}active{{end}}\" role=\"tabpanel\" aria-labelledby=\"session-tab-handoff\">\n+        <p><a href=\"/operations\">View operations</a></p>\n         <div class=\"section-heading\"><h2>Handoff</h2></div>\n         {{if not .Session.Codex.ThreadID}}<p class=\"notice warning\">This session has no shared Codex conversation. Start new sessions with <code>dev-session start &lt;short-name&gt;</code>.</p>{{end}}\n         {{if .Session.ForkedFrom}}<p>Forked from <a href=\"/{{.Session.ForkedFrom}}/\">{{.Session.ForkedFrom}}</a>.</p>{{end}}\npackage main\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/aither64/codex-web/codex\"\n\t\"github.com/aither64/dev-workspace/portal/internal/session\"\n\t\"github.com/aither64/dev-workspace/portal/internal/teamruntime\"\n\t\"github.com/aither64/dev-workspace/portal/internal/workspacecodex\"\n)\n\n// Private transport only. Ruby owns outbox persistence and admission locks.\n// It saves options before sending, and always retries the same native identity.\nfunc coordinationNotify(args []string) error {\n\tif len(args) != 2 || args[0] != \"--request\" {\n\t\treturn errors.New(\"coordination-notify requires --request FILE\")\n\t}\n\tf, err := os.Open(args[1])\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer f.Close()\n\tinfo, err := f.Stat()\n\tif err != nil {\n\t\treturn err\n\t}\n\tif !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Size() > 262144 {\n\t\treturn errors.New(\"invalid private notification request\")\n\t}\n\tvar request struct {\n\t\tSchema        int                `json:\"schema\"`\n\t\tAction        string             `json:\"action\"`\n\t\tWorkspace     string             `json:\"workspace\"`\n\t\tSlug          string             `json:\"slug\"`\n\t\tSocket        string             `json:\"socket\"`\n\t\tThread        string             `json:\"thread\"`\n\t\tStateRoot     string             `json:\"stateRoot\"`\n\t\tText          string             `json:\"text\"`\n\t\tMessageID     string             `json:\"messageId\"`\n\t\tActionContext string             `json:\"actionContext\"`\n\t\tOptions       *codex.TurnOptions `json:\"options\"`\n\t}\n\td := json.NewDecoder(io.LimitReader(f, 262145))\n\td.DisallowUnknownFields()\n\tif err = d.Decode(&request); err != nil {\n\t\treturn err\n\t}\n\tif err = d.Decode(new(any)); err != io.EOF {\n\t\treturn errors.New(\"trailing notification input\")\n\t}\n\tif request.Schema != 1 || !session.ValidSlug(request.Slug) || request.Thread == \"\" {\n\t\treturn errors.New(\"invalid notification identity\")\n\t}\n\tsummary, err := session.Find(request.Workspace, request.Slug)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif summary.Archived || summary.Codex.ThreadID != request.Thread || summary.Codex.SocketPath != request.Socket {\n\t\treturn errors.New(\"notification owner changed or archived\")\n\t}\n\tclient := newCodexClient(request.Socket, request.Workspace, request.StateRoot)\n\tdefer client.Close()\n\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)\n\tdefer cancel()\n\tmetadata, err := client.ReadThreadMetadata(ctx, request.Thread, true)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif metadata.ID != request.Thread || metadata.Cwd != filepath.Join(request.Workspace, \"work\", request.Slug) {\n\t\treturn errors.New(\"native conversation identity differs\")\n\t}\n\tif request.Action == \"verify\" {\n\t\treturn json.NewEncoder(os.Stdout).Encode(map[string]any{\"schema\": 1, \"verified\": true})\n\t}\n\tif request.Action == \"prepare\" {\n\t\tsettings, err := client.ReadThreadSettings(ctx, request.Thread)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tinstructions := \"\"\n\t\tstore, err := teamruntime.NewStore(request.StateRoot, request.Workspace)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\troster, err := store.Load(request.Slug, request.Thread)\n\t\tif err == nil {\n\t\t\tinstructions = roster.LeadInstructions\n\t\t} else if !errors.Is(err, os.ErrNotExist) {\n\t\t\treturn err\n\t\t}\n\t\toptions := codex.TurnOptions{Model: settings.Model, ReasoningEffort: settings.ReasoningEffort,\n\t\t\tThreadPolicy: workspacecodex.LeadThreadPolicy(request.Slug, request.Workspace, instructions)}\n\t\treturn json.NewEncoder(os.Stdout).Encode(map[string]any{\"schema\": 1, \"options\": options})\n\t}\n\tif request.Action != \"send\" || request.Options == nil || request.MessageID == \"\" || request.Text == \"\" || request.ActionContext == \"\" {\n\t\treturn errors.New(\"invalid notification send\")\n\t}\n\treceipt, found, err := client.ReconcileSendWithOptions(ctx, request.Thread, request.Text, request.MessageID, request.ActionContext, *request.Options)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif !found {\n\t\treceipt, err = client.SendWithOptions(ctx, request.Thread, request.Text, request.MessageID, request.ActionContext, *request.Options)\n\t}\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn json.NewEncoder(os.Stdout).Encode(map[string]any{\"schema\": 1, \"receipt\": receipt})\n}\n","exit_code":0,"status":"completed"}}
