{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc 'git log --reverse --format=full --stat fea04c6..fbbffee && cat portal/internal/web/static/coordination.js portal/internal/web/coordination_browser_test.cjs'","aggregated_output":"commit ba5d88bf6bddf1f6036be9fa3d54b1dedb2c75ca\nAuthor: Jakub Skokan <jakub.skokan@havefun.cz>\nCommit: Jakub Skokan <jakub.skokan@havefun.cz>\n\n    coordination: serialize approved merges and deployments\n    \n    Keep development work independent while admitting short resource claims\n    through a deterministic durable queue. Retain machine reservations across\n    deployed review and iteration, and preserve uncertain attempts for exact\n    reconciliation instead of replaying mutations.\n    \n    Retain reviewed sources, native notification identity and package contracts\n    so independent systemd workers survive workspace self-deployment. New private\n    schema-1 state fences pre-contract package selection; ordinary manifests and\n    existing submission ledgers remain unchanged.\n\n README.md                                          |    2 +\n docs/coordination-operations.md                    |  154 +++\n docs/coordination.md                               |  165 +++\n flake.nix                                          |    7 +-\n libexec/dev-session                                |   39 +-\n libexec/workspace-archive-cleanup.rb               |   15 +-\n libexec/workspace-auto-archive.rb                  |    6 +\n libexec/workspace-coordination-command.rb          |   77 ++\n libexec/workspace-coordination-execution.rb        |  901 ++++++++++++++\n libexec/workspace-coordination-host.rb             |  411 +++++++\n libexec/workspace-coordination.rb                  | 1243 ++++++++++++++++++++\n libexec/workspace-host                             |  174 ++-\n nix/coordination-contract.json                     |    1 +\n nix/coordination-empty.json                        |    1 +\n nix/systemd/workspace-coordinator.service          |   13 +\n nix/workspace-portal.nix                           |   39 +\n portal/cmd/workspace-portal/coordination.go        |  115 ++\n portal/cmd/workspace-portal/coordination_test.go   |  138 +++\n portal/cmd/workspace-portal/main.go                |    2 +\n portal/internal/teamruntime/runtime.go             |    2 +-\n portal/internal/teamruntime/runtime_test.go        |    1 +\n portal/internal/workspacecodex/lead_policy.go      |    5 +-\n portal/internal/workspacecodex/lead_policy_test.go |    2 +-\n test/dev_session/lifecycle_commands_test.rb        |   85 ++\n test/support/coordination_capacity_fixture.rb      |   20 +\n test/workspace_coordination_systemd_test.rb        |  107 ++\n test/workspace_coordination_test.rb                |  983 ++++++++++++++++\n .../workspace_host/agent_team_registration_test.rb |    4 +\n test/workspace_host/archive_recovery_test.rb       |    4 +-\n test/workspace_host/live_switch_test.rb            |  220 ++++\n 30 files changed, 4904 insertions(+), 32 deletions(-)\n\ncommit fbbffee68b586c10070da86508a4a47360ca47ed\nAuthor: Jakub Skokan <jakub.skokan@havefun.cz>\nCommit: Jakub Skokan <jakub.skokan@havefun.cz>\n\n    portal: show operations page and reservation badges\n    \n    Expose bounded read-only coordination status through the workspace menu\n    so sessions can identify deployment owners and distinguish resource waits\n    from uncertain execution or notification delivery. Mark session cards with\n    held machine reservations, including idle review and recovery.\n    \n    Retain the last successful display on read failures and stop hidden page\n    requests. Preserve authenticated routes and safe DOM rendering.\n\n README.md                                         |   5 +\n docs/coordination.md                              |  11 +-\n docs/workspace-portal.md                          |  11 ++\n nix/workspace-portal.nix                          |   2 +\n portal/internal/web/coordination.go               |  61 +++++++++++\n portal/internal/web/coordination_browser_test.cjs | 107 ++++++++++++++++++++\n portal/internal/web/coordination_test.go          |  45 +++++++++\n portal/internal/web/server.go                     |   8 ++\n portal/internal/web/static/app.js                 |   1 +\n portal/internal/web/static/coordination.js        | 117 ++++++++++++++++++++++\n portal/internal/web/static/style.css              |   1 +\n portal/internal/web/templates/index.html          |   8 +-\n portal/internal/web/templates/operations.html     |  25 +++++\n portal/internal/web/templates/session.html        |   1 +\n 14 files changed, 399 insertions(+), 4 deletions(-)\n\"use strict\";\n\n(() => {\n  const panel = document.querySelector(\"[data-coordination]\");\n  if (!panel && !document.querySelector(\"[data-session-list]\")) return;\n  const warning = document.querySelector(\"[data-coordination-warning]\");\n  const labels = {waiting_approval: \"Waiting for approval\", waiting_dependency: \"Waiting for an earlier operation\",\n    waiting_resource: \"Queued\", ready: \"Ready to run\", claimed: \"Starting\", running: \"Running\",\n    needs_refresh: \"Preparation needed\", reconciling: \"Recovery required\", succeeded: \"Completed\",\n    failed: \"Failed\", canceled: \"Canceled\", requested: \"Queued\", held: \"Reserved for deployment\",\n    deployed_review: \"Reserved through review and iteration\", blocked_recovery: \"Reserved for recovery\",\n    closing: \"Checking completion\", released: \"Released\"};\n  const node = (tag, text) => { const element = document.createElement(tag); element.textContent = text; return element; };\n  const link = (url, text) => {\n    const element = node(\"a\", text);\n    try { if (new URL(url).protocol === \"https:\") element.href = url; } catch (_) { /* malformed status link */ }\n    return element;\n  };\n  let lastPayload = null, unavailable = false, paused = document.hidden, active = null, timer = null;\n\n  function renderBadges() {\n    if (!lastPayload) return;\n    const holders = new Map(lastPayload.workspaces.flatMap(workspace => workspace.reservationHolders)\n      .map(holder => [holder.slug, holder.machines]));\n    for (const card of document.querySelectorAll(\"[data-session-slug]\")) {\n      const badge = card.querySelector(\"[data-session-reservation]\");\n      if (!badge) continue;\n      const machines = holders.get(card.dataset.sessionSlug) || [];\n      badge.hidden = machines.length === 0;\n      badge.textContent = machines.length === 1 ? \"Machine reserved\" : `${machines.length} machines reserved`;\n      const description = machines.map(machine => `${machine.machine}: ${labels[machine.state]}`).join(\"; \");\n      badge.title = description + (unavailable ? \". Reservation status is unavailable.\" : \"\");\n      badge.setAttribute(\"aria-label\", badge.title);\n    }\n  }\n\n  function renderOperations(payload) {\n    if (!panel) return;\n    const content = document.createDocumentFragment();\n    let count = 0;\n    for (const workspace of payload.workspaces) {\n      const owners = new Map(workspace.owners.map(owner => [owner.id, owner]));\n      if (workspace.suspended) content.append(node(\"p\", \"Scheduling is suspended.\"));\n      for (const reservation of workspace.reservations) {\n        if (reservation.state === \"released\") continue;\n        const row = node(\"p\", `${reservation.machine}: ${labels[reservation.state] || reservation.state}. `);\n        const owner = owners.get(reservation.ownerId);\n        if (owner) row.append(link(owner.portalUrl, owner.slug));\n        content.append(row); count++;\n      }\n      for (const blocker of workspace.foreignReservations) {\n        const row = node(\"p\", `${blocker.machine}: ${labels[blocker.state] || blocker.state}. `);\n        row.append(link(blocker.portalUrl, \"Owning session\")); content.append(row); count++;\n      }\n      for (const job of workspace.jobs) {\n        const row = node(\"p\", `${job.kind.replaceAll(\"_\", \" \")}: ${labels[job.state] || job.state} (${job.id.slice(0, 8)}). `);\n        const owner = owners.get(job.ownerId);\n        if (owner) row.append(link(owner.portalUrl, owner.slug));\n        if (job.state === \"needs_refresh\") row.append(node(\"span\", \" The owning agent must prepare and verify a fresh snapshot.\"));\n        if (job.reason?.portalUrl) row.append(link(job.reason.portalUrl, \"Blocking session\"));\n        content.append(row); count++;\n      }\n      for (const event of workspace.notifications) {\n        if (event.state === \"delivered\") continue;\n        content.append(node(\"p\", `Agent notification: ${event.state === \"held\" ? \"held\" : \"awaiting delivery or receipt reconciliation\"}.`)); count++;\n      }\n      if (workspace.counts && Object.entries(workspace.counts).some(([key, total]) => total > workspace[key].length)) {\n        content.append(node(\"p\", \"This view shows up to 128 records of each kind. The session command provides the full history.\"));\n      }\n    }\n    if (!count) content.append(node(\"p\", \"No coordinated operations or machine reservations.\"));\n    panel.replaceChildren(content);\n  }\n\n  async function refresh() {\n    if (paused || active) return;\n    const controller = new AbortController();\n    active = controller;\n    const deadline = setTimeout(() => controller.abort(), 10000);\n    try {\n      const response = await fetch(\"/api/coordination\", {cache: \"no-store\", signal: controller.signal});\n      if (!response.ok) throw new Error(\"Operations are unavailable.\");\n      const payload = await response.json();\n      if (active !== controller || controller.signal.aborted) return;\n      if (!Array.isArray(payload.workspaces) || payload.workspaces.some(workspace => !Array.isArray(workspace.reservationHolders))) {\n        throw new Error(\"Reservation status is unavailable.\");\n      }\n      renderOperations(payload);\n      lastPayload = payload; unavailable = false;\n      renderBadges();\n      warning.hidden = true; warning.textContent = \"\";\n    } catch (_) {\n      if (active !== controller || paused) return;\n      unavailable = true;\n      renderBadges();\n      warning.textContent = lastPayload ? \"Reservation status is unavailable. Last known status remains shown.\" : \"Reservation status is unavailable.\";\n      warning.hidden = false;\n    } finally {\n      clearTimeout(deadline);\n      if (active === controller) {\n        active = null;\n        if (!paused) timer = setTimeout(refresh, 5000);\n      }\n    }\n  }\n  function pause() {\n    paused = true; clearTimeout(timer);\n    if (active) active.abort();\n    active = null;\n  }\n  function resume() { paused = document.hidden; clearTimeout(timer); if (!paused) refresh(); }\n  document.addEventListener(\"session-list-updated\", renderBadges);\n  document.addEventListener(\"visibilitychange\", () => document.hidden ? pause() : resume());\n  window.addEventListener(\"pagehide\", pause);\n  window.addEventListener(\"pageshow\", resume);\n  refresh();\n})();\nconst test = require('node:test');\nconst assert = require('node:assert/strict');\nconst vm = require('node:vm');\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst source = fs.readFileSync(path.join(__dirname, 'static/coordination.js'), 'utf8');\nconst settle = async () => { for (let i = 0; i < 12; i++) await Promise.resolve(); };\n\nfunction harness(operations = false) {\n  class Element {\n    constructor() { this.children = []; this.value = ''; this.hidden = true; this.dataset = {}; }\n    set textContent(value) { this.value = value; this.children = []; }\n    get textContent() { return this.value + this.children.map(child => child.textContent).join(''); }\n    append(child) { this.children.push(child); }\n    replaceChildren(...children) { this.value = ''; this.children = children; }\n    setAttribute(key, value) { this[key] = value; }\n  }\n  const panel = new Element(), warning = new Element(), cards = [], requests = [], timers = new Map();\n  const docListeners = new Map(), windowListeners = new Map();\n  let nextTimer = 0;\n  const document = {\n    hidden: false,\n    querySelector: selector => ({'[data-coordination]': operations ? panel : null,\n      '[data-coordination-warning]': warning, '[data-session-list]': operations ? null : {}})[selector],\n    querySelectorAll: () => cards,\n    createElement: () => new Element(), createDocumentFragment: () => new Element(),\n    addEventListener: (name, action) => docListeners.set(name, action),\n  };\n  function addCard(slug) {\n    const badge = new Element();\n    cards.push({dataset: {sessionSlug: slug}, querySelector: () => badge});\n    return badge;\n  }\n  const badge = addCard('holder'), unrelated = addCard('other');\n  vm.runInNewContext(source, {document, URL, AbortController,\n    window: {addEventListener: (name, action) => windowListeners.set(name, action)},\n    fetch: (url, options) => new Promise((resolve, reject) => requests.push({url, ...options, resolve, reject})),\n    setTimeout: (action, delay) => { const id = ++nextTimer; timers.set(id, {action, delay}); return id; },\n    clearTimeout: id => timers.delete(id),\n  });\n  return {panel, warning, badge, unrelated, requests, addCard,\n    respond: async (payload, index = requests.length - 1) => { requests[index].resolve({ok: true, json: async () => payload}); await settle(); },\n    fail: async () => { requests.at(-1).resolve({ok: false}); await settle(); },\n    tick: async () => { const entry = [...timers].find(([, timer]) => timer.delay === 5000); assert.ok(entry, 'poll is scheduled'); timers.delete(entry[0]); entry[1].action(); await settle(); },\n    dispatch: name => docListeners.get(name)(),\n    hide: () => { document.hidden = true; docListeners.get('visibilitychange')(); },\n    show: () => { document.hidden = false; docListeners.get('visibilitychange')(); },\n    leave: () => windowListeners.get('pagehide')(),\n    pollCount: () => [...timers.values()].filter(timer => timer.delay === 5000).length,\n  };\n}\nfunction payload(machines = [{machine: 'fixture:machine', state: 'deployed_review'}]) {\n  return {schema: 1, workspaces: [{owners: [], jobs: [], reservations: [], foreignReservations: [], notifications: [],\n    reservationHolders: machines.length ? [{ownerId: 'owner', slug: 'holder', portalUrl: 'https://workspace.test/holder/', machines}] : []}]};\n}\n\ntest('failed reads retain reservations, refreshed cards inherit badges, and confirmed release removes them', async () => {\n  const h = harness();\n  assert.equal(h.requests.length, 1);\n  assert.equal(h.requests[0].url, '/api/coordination');\n  await h.respond(payload());\n  assert.equal(h.badge.hidden, false);\n  assert.equal(h.badge.textContent, 'Machine reserved');\n  assert.match(h.badge['aria-label'], /fixture:machine.*review/);\n  assert.equal(h.unrelated.hidden, true);\n  await h.tick(); await h.fail();\n  assert.equal(h.badge.hidden, false);\n  assert.equal(h.warning.hidden, false);\n  const refreshed = h.addCard('holder'); h.dispatch('session-list-updated');\n  assert.equal(refreshed.hidden, false);\n  assert.match(refreshed.title, /unavailable/);\n  await h.tick(); await h.respond(payload([]));\n  assert.equal(h.badge.hidden, true);\n  assert.equal(refreshed.hidden, true);\n  assert.equal(h.warning.hidden, true);\n});\n\ntest('hidden and navigated pages abort reads and reject late responses from an earlier page lifetime', async () => {\n  const h = harness();\n  h.hide(); assert.equal(h.requests[0].signal.aborted, true);\n  assert.equal(h.pollCount(), 0);\n  h.show(); assert.equal(h.requests.length, 2);\n  await h.respond(payload([{machine: 'fixture:one', state: 'held'}, {machine: 'fixture:two', state: 'blocked_recovery'}]), 1);\n  assert.equal(h.badge.textContent, '2 machines reserved');\n  await h.respond(payload([]), 0);\n  assert.equal(h.badge.hidden, false);\n  assert.equal(h.badge.textContent, '2 machines reserved');\n  await h.tick(); h.leave();\n  assert.equal(h.requests.at(-1).signal.aborted, true);\n  await h.respond(payload([]));\n  assert.equal(h.badge.hidden, false);\n  assert.equal(h.pollCount(), 0);\n});\n\ntest('Operations preserves active-first history and keeps its successful display after a failed refresh', async () => {\n  const h = harness(true), data = payload();\n  data.workspaces[0].jobs = [\n    {id: 'active-123', kind: 'merge', state: 'running'},\n    {id: 'done-456', kind: 'profile_activate', state: 'succeeded'},\n  ];\n  await h.respond(data);\n  assert.ok(h.panel.textContent.indexOf('Running') < h.panel.textContent.indexOf('Completed'));\n  const before = h.panel.textContent;\n  await h.tick(); await h.fail();\n  assert.equal(h.panel.textContent, before);\n  assert.equal(h.warning.hidden, false);\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"cat docs/coordination.md docs/coordination-operations.md && rg -n 'coordination|test|Documentation|operations' README.md docs/workspace-portal.md && cat libexec/workspace-coordination-command.rb\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc 'cat portal/internal/web/coordination.go portal/internal/web/coordination_test.go portal/internal/web/templates/operations.html && git diff fea04c6 fbbffee -- portal/internal/web/server.go portal/internal/web/templates/index.html portal/internal/web/templates/session.html portal/internal/web/static/app.js portal/internal/web/static/style.css nix/workspace-portal.nix && cat portal/cmd/workspace-portal/coordination.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"cat docs/coordination.md docs/coordination-operations.md && rg -n 'coordination|test|Documentation|operations' README.md docs/workspace-portal.md && cat libexec/workspace-coordination-command.rb\"","aggregated_output":"# Coordinated workspace operations\n\nThe user-profile coordinator schedules three operations: fast-forward Git\nintegration, machine activation and workspace profile activation. Sessions keep\ntheir own branches, reviews and conversations. They prepare independently and\nsubmit exact reviewed snapshots under existing user authorization.\n\nBuilds, input updates, rebases, conflict resolution and verification run before\nresource claims. An admitted worker holds only the resources its mutation needs.\nDifferent repository targets and machines can proceed concurrently. Eligible work\nuses FIFO order; waiting on approval or dependencies does not block unrelated work.\n\n## Machine ownership during review\n\nA reservation belongs to a session and physical machine. It survives successful\ndeployment, idle agents, browser closure, UI review, feedback and repeated fixes.\nIt also covers workspace profile selection on that machine. Other sessions can\nbuild and merge while their deployment waits.\n\nNormal release requires every exact final owned feature head to be integrated,\nall deployed input revisions to be integrated, settled operations and deliveries,\nunchanged live identities, and an explicit declaration that deployment and review\nwork is finished. Integration alone does not release a machine. Deployment or\nreview does not supply merge approval.\n\nArchive and deletion retain deployed or uncertain reservations as recovery\nblockers. Revival preserves ownership. An uncertain effect retains its execution\nclaim too; a dead process, failed SSH command or timeout cannot prove no effect.\nThe first implementation refuses exceptional release without integration. Resolve\nit through an explicitly authorized, reviewed recovery operation rather than\nediting or deleting the ledger.\n\n## Session commands\n\nCommands select the registered workspace normally and require the exact slug:\n\n```text\ndev-session coordination status SESSION --as-is --json\ndev-session coordination prepare SESSION --as-is --request FILE --json\ndev-session coordination approve SESSION --as-is --request FILE --json\ndev-session coordination reserve SESSION --as-is --request FILE --json\ndev-session coordination submit SESSION --as-is --request FILE --json\ndev-session coordination refresh SESSION JOB --as-is --request FILE --json\ndev-session coordination cancel SESSION JOB --as-is --request FILE --json\ndev-session coordination reconcile SESSION JOB --as-is --json\ndev-session coordination finish SESSION RESERVATION --as-is --request FILE --json\nworkspace-host coordination status --json\n```\n\nJSON requests use `schema: 1` and a caller-generated lowercase UUID `requestId`.\nAn exact retry returns its retained receipt; changing input under the same ID\nrefuses. Updates use `expectedRevision`. Exit 0 reports acceptance or status, not\nnecessarily successful execution. Exit 2 means invalid input, 3 stale evidence or\nbaseline, 4 missing authorization or ownership, 5 recovery required, and 75 a\ntemporary admission conflict.\n\nPreparation takes `kind`, session evidence (`kind`, `path`, SHA-256 `sha256`), and\nthe registered `repository` for a merge or catalog `target` for a machine. Profile\npreparation uses the session's registered workspace branch. Evidence lives under\nthe owning session's active tracking directory. Preparation retains committed\nsources, artifacts and a content-addressed snapshot; it returns that snapshot.\n\nApproval records `kind` (`merge` or `deploy`), exact `scope`, `reviewedSnapshot`,\nand `source: {kind: \"user_instruction\", reference, quote}`. Merge scope entries\ncontain `repository` and full `target` ref. Deployment entries contain canonical\n`machine`, `actions` (`switch`, `profile_activate`) and `reboot: false`. Quote the\nactual user direction. An optional `iterationScope` must be explicitly authorized;\nthe prepared snapshot's `changeScope` must match it. A digest without an existing\nowner-prepared snapshot cannot become an approval.\n\nA reservation request contains `target`, `mode` (`deploy_first` or `integrated`),\n`approvalId` and `integrationObligations` (`repository`, full `target`). Current\nregistrations are also frozen as obligations. Removing a registration cannot\nerase them. Reservations are requested near the first prepared deployment, and\nare granted only with its eligible first operation.\n\nSubmission contains `kind`, `dependsOn`, `approvalId`, `reservationId` and the\ncomplete returned `snapshot`. Dependencies name earlier jobs of the same owner.\nMerge-only jobs use a null reservation. A null approval stores waiting work and\ncannot execute. `refresh` supplies `expectedRevision`, a fresh snapshot and its\napplicable approval; it cannot replace an admitted or uncertain attempt.\n\n`workspace-host switch --source PATH` prepares outside locks, finds an exact\nretained approved profile snapshot and machine reservation, submits it once and\nwaits outside locks. It preserves an existing job's dependency graph. If another\ndeployment is pending, use explicit submission to specify order. This command\ncannot manufacture review or approval. Coordinated source selection requires a\nclean committed source; `workspace-host prepare --source PATH --json` can also\ninspect a local source before it is committed.\n\n## Completion and cumulative deployments\n\n`finish` takes `expectedRevision`, `deploymentWorkFinished: true`, a nonempty\nacceptance `evidence` reference and `finalHeads` entries with `repository`, full\n`target` and exact `head`. Those heads must match current owned registrations and\nbe contained in freshly fetched targets. Unregistered inputs use their sealed\ncatalog `defaultTarget` and canonical clone; the coordinator proves their actual\ndeployed revisions are already integrated. It never invents feature registrations\nfor unchanged dependencies.\n\nCompletion retains both proof categories. The machine frontier records final\nowned heads and actual deployed unowned revisions separately for system and\nprofile activation. Later prepared deployments must include those integrated\nchanges. Immediately before machine activation, the worker also fetches the\nconfiguration repository target and proves that the prepared source includes it. An older prepared deployment returns `needs_refresh` rather than undoing\npreviously completed work.\n\nRebased deployed features need exact reviewed replacement lineage in\n`finish.replacements`. It binds the repository/target, deployed and final ranges,\napplicable integration approval and a checksummed independent review receipt.\nSee [operations and recovery](coordination-operations.md). Original deployed\nartifacts and source roots remain retained.\n\n## Runtime and compatibility\n\nRuby owns a private schema-1 ledger under the selected runtime's state root.\nTransactions atomically replace fsynced JSON under one short mutex. Commands and\nphysical-lock waits run outside that mutex. Workers publish separate immutable\nattempt requests and phase/result receipts. Each runs in an independent systemd\nservice, so restarting the portal or coordinator does not stop it.\n\nPackage candidates must support the retained coordination contract, adapters and\nmachine mappings. Old packages that ignore coordination state cannot be selected\nonce that state exists. Profile failure after selection recovers forward to the\nsame approved candidate; the original machine reservation remains held.\n\nThe installed `coordination.json` catalog comes from optional `coordinationConfig`\nin `lib.mkPackage`. It owns immutable adapter executables, exact machine selectors,\naliases, canonical SSH repositories, full default targets and flake `inputPaths`.\nInput mappings are keyed by source repository and contain lists of input paths.\nThe separate extension catalog and session manifest formats remain unchanged.\nThe pure Ruby `lib.coordinationCommandLibrary` is also used by packaged adapters\nfor bounded protocol capture and diagnostics; it does not import the ledger.\n\nThe Operations page is an authenticated, bounded, read-only view. It shows\nmachine ownership, blocked jobs and notification delivery separately. An idle\nowner still reserves its machine. The workspace menu links to `/operations`\nbeside Automatic archival. It shows active and completed jobs, active first.\nSession-list badges mark held machine reservations, including review and recovery;\nqueued requests and brief execution claims do not receive badges. Ownership is\nmatched to the retained active or archived session incarnation. The portal's\n`reservationHolders` summary covers all current holders before history truncation.\nVisible pages refresh every five seconds. Failed reads preserve the last known\nstatus with a warning; a successful read confirms when a badge can disappear.\n\nNotifications use the existing Codex submission ledger, exact retained thread,\nmodel, effort and lead policy. Busy threads receive steering; idle threads receive\na new turn. The coordinator preserves message IDs and reconciles lost replies.\nEach snapshot has one retained notification per reported state; repeated resource\nwaits or reconciliation reuse that event. Native options and receipts live in\nimmutable checksummed artifacts, so large retained instructions do not fill the\noperation ledger. Retries verify and load the original options.\nA crash after recording submission but before the native RPC can leave delivery\nambiguous. That event remains visible and retries only reconciliation; it never\ncreates another message ID or conversation to escape the ambiguity.\n\nSelected-package registration reconciles services under the transition lock and\nrefuses a pending package transition or held machine review reservation before\nchanging the registry. Private profile activation still requires its exact claim.\nManaged lead and member technical bindings point to the installed guide without\nchanging retained role instructions, model, effort or access.\n\nLifecycle preparation runs outside the ledger mutex. Publication of a new\nordinary journal or archive cleanup sidecar checks capacity and binds its exact\noperation while holding that mutex. Competing admissions cannot consume the\nchecked space before publication. Existing bindings remain recoverable at the\nadmission ceiling.\n\nThe guarantees cover cooperating commands in one user runtime. The local operator\nis trusted; arbitrary external Git, confctl, SSH and old store binaries can bypass\ncoordination. Remote clients remain subject to the portal's authentication and\nauthorization rules.\n# Coordination operations and recovery\n\nRead [the coordination contract](coordination.md) before operating its ledger.\nThe selected package installs both guides. Run `workspace-host coordination guide`\nto read them from any checkout, including an unmerged deploy-first rollout.\nStatus reads do not reconcile, schedule or mutate anything. Use session commands\nfor exact owned operations; keep all recovery evidence and roots.\n\n## Agent waiting\n\nPrepare and verify work independently. Request a machine only near the first\nprepared deployment. Submit approved work, then continue other useful work.\nWhen a resource is busy and nothing else remains, keep the turn waiting using an\ninterruptible tool wait of at most 60 seconds. Reread status when the coordinator\nsteers the conversation. Do not end a turn solely because another session owns a\nresource, ask the user to resume it, or redeploy around the reservation.\n\nOn `needs_refresh`, refresh the branch or input baseline, resolve conflicts,\nrepeat the required verification and review, record any preserved approval proof,\nand prepare a new snapshot. The coordinator does not decide conflict semantics.\nUse a new request ID and current revision to refresh the unclaimed job.\n\n## Interrupted execution\n\nRead `dev-session coordination status` and identify the exact attempt. The\nprivate attempt directory retains `request.json`, `phase.json`, `result.json` and\n`worker.lock`; logs are diagnostic only. The systemd unit is\n`workspace-operation-ATTEMPT.service`. A running worker refuses manual\nreconciliation. A retained exited unit is distinct from a running process.\n\nRun `reconcile` on the original job. Git recovery proves exact remote ancestry.\nThe coordinator launches safe reconciliation in independent\n`workspace-reconcile-ATTEMPT.service` units after a worker exits. Network probes\nand forward recovery never run in the scheduler. A stalled probe retains its\noriginal claim; other resources and notification delivery can continue. Failed\nprobes wait at least 30 seconds before another attempt. State\nchanges wake it immediately; a five-second tick covers missed wake signals.\nUnprovable effects stay blocked and require operator evidence.\nA local fast-forward with a failed push stays in place and holds its claim until\nthe remote effect is resolved. Profile recovery can complete only the original\nselected candidate and saved preparation. Machine recovery requires the adapter's\nverified receipt and both live-system/profile identities. Ambiguous rollback or\npartial publication keeps the reservation and claim. Do not replay activation or\nuse a fresh job to hide the original uncertainty.\n\nArchive and deletion hold notifications and deployed ownership. Coordination\nreceipts bind each ordinary lifecycle journal to exact owner incarnations.\nCompletion persists before journal removal; retries after an interrupted removal\nare idempotent. Revival freezes its archive association before tracking changes. Explicit revival\nreconnects the same owner but does not resolve its deployment blocker. A recreated\nslug has no claim to the previous owner's resources. An exceptional release or\ntransfer needs a separate reviewed operation with exact user direction and live\nevidence; there is no force-release command.\n\n## Reviewed rebase lineage\n\nFor each deployed nonancestor head, `finish.replacements` contains:\n\n```json\n{\n  \"repository\": \"example\", \"target\": \"refs/heads/master\",\n  \"from\": \"DEPLOYED_SHA\", \"fromBase\": \"OLD_BASE_SHA\",\n  \"to\": \"FINAL_SHA\", \"toBase\": \"NEW_BASE_SHA\",\n  \"relation\": \"patch_equivalent\", \"approvalId\": \"UUID\",\n  \"evidence\": {\"kind\": \"review\", \"path\": \"work/SESSION/lineage.json\", \"sha256\": \"HEX\"}\n}\n```\n\nThe session review receipt binds `schema: 1`, `ownerId`, `reservationId`, this exact\ntuple in `mapping`, `decision: \"accepted\"`, the independent `reviewer` identity and checksummed\n`artifacts` for `range_diff`, `verification` and `migration_review`. Each artifact\nhas `kind`, `path` and `sha256`. The lead records the independently reviewed result\nunder the normal mandatory-review procedure; the receipt is not a reviewer\nauthentication service.\n\n`patch_equivalent` requires matching ordered stable patch IDs for ordinary\nnonmerge commits, retained range-diff evidence and reviewed migration behavior.\n`reviewed_change` requires a new integration approval for the final prepared\nsnapshot, explicit deployed-state compatibility review and a later successful\ndeployment of the replacement. Both ranges must belong to the same owned\nrepository and configured target. The replacement must be its current exact\nfinal head and already integrated. Unused, conflicting and intermediate mappings\nrefuse. Retain the original deployed source and artifact history.\n\n## First installation and threadless maintenance\n\nA pre-contract installed package cannot create managed coordination state.\nUse the reviewed candidate's private `coordination-bootstrap` with explicit\nsource, registered workspace/session, exact predecessor profile token and request.\n`--prepare` returns the retained source and a complete request containing the\nmachine snapshot and profile artifact. Preparation builds and copies outside\nclaims. Execute the returned request from the exact candidate, retaining the\nreturned source. It admits a threadless bootstrap owner and machine reservation,\nthen runs machine activation followed by profile activation in independent\nservices. An exact execution retry recovers the original jobs.\n\nThe bootstrap owner has no notification destination and cannot submit new\nunattended work. Later `status`, `reconcile`, `cancel` and `finish` can select its\nalready retained UUID with `--bootstrap-owner OWNER`. The active tracking\nincarnation must still match. The selector cannot create an owner, approve or\nsubmit jobs, or waive integration and completion proofs. Archived owners must be\nexplicitly revived first.\n\nProfile changes remain forward-only after selection. Preserve the supported\ncoordination contract when preparing a recovery package. System recovery follows\nthe configuration owner's deployment procedure. Neither recovery nor bootstrap\nauthorizes a reboot or default-branch integration.\n\n## Suspension and resumption\n\n`workspace-host suspend` refuses active mutation workers and holds queued work\nand reservations. `workspace-host resume` restores services from the exact\nselected generation before enabling claims and delivery. It preserves all queued\nstate and does not select a package or release a machine. If suspension fails\nafter holding the ledger, it restores services and the prior suspension flag;\nfailed compensation keeps suspension visible and requires `resume`.\n\n## Capacity and retained evidence\n\nProtocol stdout remains complete within its bound, normally 256 KiB. Prepared\nNix environment parsing has a separate 16 MiB bound; large Git diffs are hashed\nas streams. Preparation and worker diagnostics retain at most 4 MiB per operation with an initial section\nand a tail, and continue draining after the cap. Private logs use mode 0600 and\nnever prove an outcome. Ledger/portal errors are bounded UTF-8 text.\n\nThe ledger has a 16 MiB limit, with at least 2 MiB reserved for recovery and a\nconservative budget for outstanding results and cancellation/completion writes.\nAdmission checks the prospective ledger, including the new records and receipt,\nplus the remaining growth of every pending job, undelivered notification and\nunreleased reservation. Notification allowances survive job completion. Worker\nresults, reasons and request receipts have 16 KiB encoded JSON bounds; deployment\nhistory allows one unknown-to-applied disposition per attempt. Completion accounts\nfor actual coverage and contracts, integration proofs and both frontier projections.\nNative notification options and receipts use the existing checksummed artifact\nstore. The ledger retains their identifiers and a bounded event envelope.\nPersisted file limits include the trailing newline. A result, artifact or native\nrequest must fit its complete file bound before publication.\nWorker requests seal the current operation; refresh history and prior results\nstay in the ledger. Admission checks the complete worker envelope before taking\na resource claim. An oversized snapshot returns `needs_refresh` without an\nattempt, so its owner can reduce it and refresh the job.\nThose recovery requests may use the reserve after normal admission fills, and\nhave a 16 KiB request bound. Existing request IDs remain idempotent at capacity. New preparation/admission requires\nat least 1 GiB of free space. Capacity refusal preserves existing authority.\nThis release retains source closures, artifacts, receipts and referenced roots;\nit bounds individual logs and admission, not lifetime disk usage. Automatic\nsource/history pruning is deferred. Never delete an unresolved reservation or\nreceipt to make room.\n\nA claim without `request.json` predates any worker launch but still requires\noperator recovery; this release does not automatically redispatch it. Likewise,\n`finish` retains full integration proofs even when deployment was canceled before\nactivation. Early release without integration is deferred; lifecycle abandonment\nor separately reviewed exceptional recovery remains required.\ndocs/workspace-portal.md:20:  \"sshHost\": \"build-host.example.test\",\ndocs/workspace-portal.md:22:    \"hostname\": \"workspace.example.test\",\ndocs/workspace-portal.md:23:    \"aliases\": [\"old-workspace.example.test\"]\ndocs/workspace-portal.md:77:creation or lifecycle operations and detects a concurrent edit before replacement.\ndocs/workspace-portal.md:112:First-time cluster setup and maintenance recovery remain CLI operations.\ndocs/workspace-portal.md:471:New archive operations also seal a private cleanup sidecar. Finish these through\ndocs/workspace-portal.md:562:The workspace menu links to **Operations** at `/operations`. This read-only\ndocs/workspace-portal.md:568:the previous display with a warning. The coordination contract owns reservation\ndocs/workspace-portal.md:578:legacy tracking and pending automatic operations remain visible. The overview\ndocs/workspace-portal.md:734:changes are committed and quick checks pass, before long integration tests.\ndocs/workspace-portal.md:798:operations and team mutations share the runtime lock, so an active lifecycle\ndocs/workspace-portal.md:1132:The NixOS smoke test in `nix/tests/host-module-idempotency.nix` covers\ndocs/workspace-portal.md:1136:VM tests after mandatory review; package and focused checks run on every push\ndocs/workspace-portal.md:1168:These HTTP operations retain generation, runtime and lifecycle admission checks\ndocs/workspace-portal.md:1197:that ceiling. Providers own their internal shutdown budgets and test them against\nREADME.md:6:its own Codex build, so one profile generation always contains a tested portal\nREADME.md:14:## Documentation\nREADME.md:30:The [coordination guide](docs/coordination.md) covers queued merges, persistent\nREADME.md:31:machine review reservations and [operations/recovery](docs/coordination-operations.md).\nREADME.md:102:  \"sshHost\": \"build-host.example.test\",\nREADME.md:104:    \"hostname\": \"workspace.example.test\",\nREADME.md:105:    \"aliases\": [\"old-workspace.example.test\"]\nREADME.md:139:operations and invalidates its cache even when the RPC response is lost. Reads\nREADME.md:382:Run the package checks and host smoke test with:\nREADME.md:389:launchers. The flake supplies their build and test dependencies.\nREADME.md:394:nix develop --command go -C portal test -mod=readonly ./internal/teamruntime\nREADME.md:400:On a configured workspace host, focused portal WebUI tests must use an absent\nREADME.md:401:test catalog through `DEV_WORKSPACES_CODEX_PROVIDERS`. Otherwise their disposable,\nREADME.md:406:and manual dispatch, it also runs a small NixOS VM test for activation,\nREADME.md:408:feature-branch VM tests after mandatory review. The VM job requires KVM\n# frozen_string_literal: true\n\nrequire 'digest'\nrequire 'open3'\nrequire 'thread'\n\nmodule WorkspaceCoordination\n  # Drain both streams even after reaching a bound. Logs never decide whether\n  # a mutation happened, and an output limit never kills an activation.\n  class Command\n    class Log\n      FIRST = 1024 * 1024\n      TAIL = 3 * 1024 * 1024 - 128\n\n      def initialize\n        @first, @tail, @bytes = ''.b, ''.b, 0\n        @mutex = Mutex.new\n      end\n\n      def append(stream, bytes)\n        @mutex.synchronize do\n          value = \"[#{stream}] \".b + bytes.b\n          @bytes += value.bytesize\n          keep = [FIRST - @first.bytesize, value.bytesize].min\n          @first << value.byteslice(0, keep) if keep > 0\n          rest = value.byteslice(keep, value.bytesize - keep)\n          @tail << rest if rest\n          @tail = @tail.byteslice(-TAIL, TAIL) if @tail.bytesize > TAIL\n        end\n      end\n\n      def bytes\n        marker = @bytes > FIRST + TAIL ? \"\\n[diagnostics truncated; #{@bytes} bytes drained]\\n\" : ''\n        @first + marker.b + @tail\n      end\n    end\n\n    def self.run(argv, env: {}, cwd: nil, input: '', limit: 262_144, log: nil, digest: false)\n      diagnostics = log || Log.new\n      output, error, overflow = ''.b, ''.b, false\n      hash = Digest::SHA256.new\n      options = cwd ? {chdir: cwd} : {}\n      status = nil\n      Open3.popen3(env, *argv, **options) do |stdin, stdout, stderr, waiter|\n        writer = Thread.new do\n          begin\n            stdin.write(input.to_s)\n          rescue Errno::EPIPE\n            # The child's status supplies the failure evidence.\n          ensure\n            stdin.close\n          end\n        end\n        readers = [Thread.new do\n          while (chunk = stdout.read(16_384))\n            if digest\n              hash.update(chunk)\n            elsif output.bytesize + chunk.bytesize <= limit\n              output << chunk\n            else\n              overflow = true\n            end\n          end\n        end, Thread.new do\n          while (chunk = stderr.read(16_384))\n            diagnostics.append('stderr', chunk)\n            error << chunk.byteslice(0, [4096 - error.bytesize, chunk.bytesize].min) if error.bytesize < 4096\n          end\n        end]\n        writer.value\n        readers.each(&:value)\n        status = waiter.value\n      end\n      [digest ? \"sha256:#{hash.hexdigest}\" : output.force_encoding(Encoding::UTF_8), error.force_encoding(Encoding::UTF_8).scrub, status, overflow]\n    end\n  end\nend\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc 'cat portal/internal/web/coordination.go portal/internal/web/coordination_test.go portal/internal/web/templates/operations.html && git diff fea04c6 fbbffee -- portal/internal/web/server.go portal/internal/web/templates/index.html portal/internal/web/templates/session.html portal/internal/web/static/app.js portal/internal/web/static/style.css nix/workspace-portal.nix && cat portal/cmd/workspace-portal/coordination.go'","aggregated_output":"package web\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"time\"\n)\n\n// The runtime reader is authoritative. GET never reconciles or claims jobs.\nfunc (s *Server) coordinationAPI(w http.ResponseWriter, r *http.Request, slug string) {\n\tif r.Method != http.MethodGet {\n\t\tw.WriteHeader(http.StatusMethodNotAllowed)\n\t\treturn\n\t}\n\tctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)\n\tdefer cancel()\n\tvar command *exec.Cmd\n\tif slug == \"\" {\n\t\tcommand = exec.CommandContext(ctx, filepath.Join(s.config.PackageRoot, \"bin/workspace-host\"), \"coordination\", \"status\", \"--json\", \"--portal\", \"--workspace\", s.config.WorkspaceName)\n\t} else {\n\t\tcommand = exec.CommandContext(ctx, s.config.DevSession, \"--workspace\", s.config.WorkspaceName, \"coordination\", \"status\", slug, \"--as-is\", \"--json\", \"--portal\")\n\t}\n\tout := boundedCoordinationBuffer{limit: 1024 * 1024}\n\tdiagnostic := boundedCoordinationBuffer{limit: 4096, truncate: true}\n\tcommand.Stdout, command.Stderr = &out, &diagnostic\n\tcommand.Dir = s.config.Workspace\n\tif err := command.Run(); err != nil {\n\t\ts.writeError(w, r, http.StatusServiceUnavailable, \"Operations cannot be read: \"+diagnostic.String())\n\t\treturn\n\t}\n\tif !json.Valid(out.Bytes()) {\n\t\ts.writeError(w, r, http.StatusServiceUnavailable, \"Operations returned an invalid response.\")\n\t\treturn\n\t}\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Write(out.Bytes())\n}\n\ntype boundedCoordinationBuffer struct {\n\tbytes.Buffer\n\tlimit    int\n\ttruncate bool\n}\n\nfunc (b *boundedCoordinationBuffer) Write(p []byte) (int, error) {\n\tif b.Len()+len(p) > b.limit {\n\t\tif b.truncate {\n\t\t\tn := len(p)\n\t\t\tb.Buffer.Write(p[:b.limit-b.Len()])\n\t\t\treturn n, nil\n\t\t}\n\t\treturn 0, fmt.Errorf(\"operations response exceeds its limit\")\n\t}\n\treturn b.Buffer.Write(p)\n}\npackage web\n\nimport (\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc TestOperationsNavigationDoesNotReadOrEmbedStatus(t *testing.T) {\n\tserver := newTestServer(t)\n\tdefer server.Close()\n\tserver.config.DevSession = filepath.Join(t.TempDir(), \"unavailable-dev-session\")\n\tfor _, path := range []string{\"/\", \"/operations\"} {\n\t\tresponse := httptest.NewRecorder()\n\t\tserver.Handler().ServeHTTP(response, httptest.NewRequest(http.MethodGet, path, nil))\n\t\tif response.Code != http.StatusOK {\n\t\t\tt.Fatalf(\"%s: %d: %s\", path, response.Code, response.Body.String())\n\t\t}\n\t\tbody := response.Body.String()\n\t\tif path == \"/\" {\n\t\t\tif !strings.Contains(body, `href=\"/operations\"`) || !strings.Contains(body, \"data-session-reservation\") || strings.Contains(body, \"data-coordination aria-live\") {\n\t\t\t\tt.Fatalf(\"index does not link to the separate status page: %s\", body)\n\t\t\t}\n\t\t} else if !strings.Contains(body, \"data-coordination aria-live\") || !strings.Contains(body, `href=\"/\"`) {\n\t\t\tt.Fatalf(\"Operations page lacks status or workspace navigation: %s\", body)\n\t\t}\n\t}\n\tdirectory := filepath.Join(server.config.Workspace, \"work\", \"example\")\n\tif err := os.MkdirAll(directory, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor name, content := range map[string]string{\"portal.yml\": \"schema: 1\\nslug: example\\n\", \"plan.md\": \"# Plan\\n\", \"state.md\": \"---\\nlifecycle: active\\n---\\n\"} {\n\t\tif err := os.WriteFile(filepath.Join(directory, name), []byte(content), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tresponse := httptest.NewRecorder()\n\tserver.Handler().ServeHTTP(response, httptest.NewRequest(http.MethodGet, \"/example/\", nil))\n\tif response.Code != http.StatusOK || !strings.Contains(response.Body.String(), \"View operations\") || strings.Contains(response.Body.String(), \"data-coordination aria-live\") {\n\t\tt.Fatalf(\"session handoff still embeds status: %d: %s\", response.Code, response.Body.String())\n\t}\n}\n{{define \"operations\"}}\n<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Operations · {{.DisplayLabel}}</title>\n  <link rel=\"stylesheet\" href=\"/static/style.css?v=12\">\n</head>\n<body data-operations>\n  <header class=\"topbar\">\n    <div><p class=\"eyebrow\">{{.DisplayLabel}}</p><h1>Operations</h1></div>\n    <a href=\"/\">Back to workspace</a>\n  </header>\n  <main class=\"page\">\n    <p data-coordination-warning class=\"notice warning\" role=\"status\" hidden></p>\n    <section class=\"panel\" aria-label=\"Coordinated operations\">\n      <p>Machine reservations stay with their owning session during review and feedback.</p>\n      <div data-coordination aria-live=\"polite\">Loading operations…</div>\n    </section>\n  </main>\n  <script src=\"/static/coordination.js?v=2\" defer></script>\n</body>\n</html>\n{{end}}\ndiff --git a/nix/workspace-portal.nix b/nix/workspace-portal.nix\nindex af66eba..4521ac0 100644\n--- a/nix/workspace-portal.nix\n+++ b/nix/workspace-portal.nix\n@@ -16,11 +16,13 @@\n   nodejs,\n   nix,\n   openssl,\n+  openssh,\n   python3,\n   ruby,\n   routerSocket,\n   systemd,\n   teamConfig ? null,\n+  coordinationConfig ? null,\n   tmux,\n   userNamespace ? \"d