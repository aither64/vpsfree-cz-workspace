n_diagnostics)\n+        raise Error, 'workspace preparation protocol output exceeds its bound' if overflow\n+      else\n+        stdout, stderr, status = Open3.capture3(*argv)\n+      end\n       unless status.success?\n         detail = stderr.strip.empty? ? stdout.strip : stderr.strip\n         raise Error, \"command failed: #{argv.map(&:shellescape).join(' ')}#{detail.empty? ? '' : \"\\n#{detail}\"}\"\ndiff --git a/nix/systemd/workspace-coordinator.service b/nix/systemd/workspace-coordinator.service\nnew file mode 100644\nindex 0000000..fc98b8d\n--- /dev/null\n+++ b/nix/systemd/workspace-coordinator.service\n@@ -0,0 +1,13 @@\n+[Unit]\n+Description=Development workspace operation coordinator\n+After=network.target\n+\n+[Service]\n+Type=simple\n+ExecStart=%h/.local/state/dev-workspaces/profile/bin/workspace-host run-coordinator\n+Restart=on-failure\n+RestartSec=5s\n+UMask=0077\n+\n+[Install]\n+WantedBy=default.target\ndiff --git a/portal/cmd/workspace-portal/main.go b/portal/cmd/workspace-portal/main.go\nindex 9965602..d098908 100644\n--- a/portal/cmd/workspace-portal/main.go\n+++ b/portal/cmd/workspace-portal/main.go\n@@ -121,6 +121,8 @@ func run(args []string) error {\n \tswitch args[0] {\n \tcase \"serve\":\n \t\treturn serve(args[1:])\n+\tcase \"coordination-notify\":\n+\t\treturn coordinationNotify(args[1:])\n \tcase \"router\":\n \t\treturn routeWorkspaces(args[1:])\n \tcase \"session\":\ndiff --git a/portal/internal/teamruntime/runtime.go b/portal/internal/teamruntime/runtime.go\nindex 887758f..623a6da 100644\n--- a/portal/internal/teamruntime/runtime.go\n+++ b/portal/internal/teamruntime/runtime.go\n@@ -227,7 +227,7 @@ func memberPolicy(workspace, slug string, member Member) (codex.ThreadPolicy, er\n \tif !session.ValidSlug(slug) || workspace == \"\" || member.Address == \"\" {\n \t\treturn codex.ThreadPolicy{}, errors.New(\"member policy has incomplete session identity\")\n \t}\n-\tidentity := fmt.Sprintf(\"This Codex conversation is bound to development