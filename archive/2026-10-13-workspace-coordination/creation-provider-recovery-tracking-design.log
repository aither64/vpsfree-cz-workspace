    def write_portal_manifest(slug, manifest, expected_contents: nil)
      path = portal_file(slug)
      validate_work_directory!(slug)
      validate_portal_manifest!(manifest, slug, path)
      data = YAML.dump(manifest)
      if data.bytesize > PORTAL_MANIFEST_MAX_SIZE
        raise Error, "portal manifest exceeds #{PORTAL_MANIFEST_MAX_SIZE / (1024 * 1024)} MiB: #{path}"
      end
      raise Error, "portal manifest is a symlink: #{path}" if File.symlink?(path)
      if path_exists?(path) && !File.file?(path)
        raise Error, "portal manifest is not a file: #{path}"
      end

      temporary = File.join(File.dirname(path), ".portal.yml.#{$$}.tmp")
      raise Error, "temporary portal manifest already exists: #{temporary}" if path_exists?(temporary)

      begin
        File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o644) do |file|
          file.write(data)
          file.flush
          file.fsync
        end
        if expected_contents && read_bounded_file(path, 'portal manifest', max_size: PORTAL_MANIFEST_MAX_SIZE) != expected_contents
          raise Error, "portal manifest changed during artifact registration: #{slug}; retry"
        end
        File.rename(temporary, path)
        fsync_directory(File.dirname(path))
      ensure
        File.unlink(temporary) if path_exists?(temporary)
      end
    end

