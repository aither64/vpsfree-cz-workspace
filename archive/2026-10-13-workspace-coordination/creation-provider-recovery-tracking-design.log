		}
		roster, err := store.Load(receipt.Request.Slug, proof.ThreadID)
		if err != nil {
			return fmt.Errorf("load direct team roster: %w", err)
		}
		if err := rosterMatchesDirectTeam(*roster, *receipt.DirectTeam); err != nil {
			return err
		}
	}

	return nil
}

