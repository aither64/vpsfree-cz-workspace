    def resolve_portal_fork_settings(source_thread_id, model:, effort:)
      unless @portal_command && !@portal_command.empty?
        return [model, effort] unless @require_runtime

        raise Error, 'workspace-portal is required to validate Codex settings'
      end

      command = [
        *@portal_command,
        'thread',
        'resolve-fork-settings',
        '--thread-id',
        source_thread_id
      ]
      command += ['--socket', @codex_socket] if @codex_socket
      command += ['--model', model] if model
      command += ['--effort', effort] if effort
      stdout, _stderr, _status = @command_runner.capture(command)
      settings = JSON.parse(stdout)
      unless settings.is_a?(Hash) &&
             settings['model'].is_a?(String) && !settings['model'].empty? &&
             settings['reasoningEffort'].is_a?(String) &&
             !settings['reasoningEffort'].empty?
        raise Error, 'workspace-portal returned invalid Codex settings'
      end
      [settings.fetch('model'), settings.fetch('reasoningEffort')]
    rescue JSON::ParserError => e
      raise Error, "workspace-portal returned invalid JSON: #{e.message}"
    end

    def name_portal_thread(slug, thread_id)
      command = [
        *@portal_command,
        'thread',
        'set-name',
        '--thread-id',
        thread_id,
        '--name',
        slug
      ]
      command += ['--socket', @codex_socket] if @codex_socket
      @command_runner.capture(command)
    rescue CommandError => e
      @err.puts "warning: unable to name shared Codex thread: #{e.message}"
    end

    def send_portal_goal(slug, thread_id, goal_file, start_unmaterialized:)
      command = [
        *@portal_command,
        'thread',
        'ensure-initial',
        '--thread-id',
        thread_id,
        '--cwd',
        work_dir(slug),
        '--input-file',
        File.expand_path(goal_file)
      ]
      command << '--start-unmaterialized' if start_unmaterialized
      command += ['--socket', @codex_socket] if @codex_socket
      @command_runner.capture(command)
    end

    def require_portal_thread_materialized(slug, thread_id)
      command = [
        *@portal_command,
        'thread',
        'require-materialized',
        '--thread-id',
        thread_id,
        '--cwd',
        work_dir(slug)
      ]
      command += ['--socket', @codex_socket] if @codex_socket
      @command_runner.capture(command)
    end

	# Direct teams are package-owned projections of the immutable catalog. The
	# returned object is a complete snapshot, not a capability token: creation
	# journals retain it verbatim so later package changes cannot alter staff,
	# addresses, lead settings, or specialist settings during recovery.
	def resolve_current_direct_team!(team, model: nil, effort: nil)
	  unless team.is_a?(String) && team.match?(SAFE_PART) && @portal_command && !@portal_command.empty?
		raise Error, 'direct team selection requires the installed workspace portal'
	  end
	  if [model, effort].compact.length == 1
		raise Error, '--model and --effort must be selected together for a direct team'
	  end
	  portal = File.realpath(@portal_command.first)
	  package = File.dirname(File.dirname(portal))
	  command = [*@portal_command, 'team-preset', '--package-root', package, '--team', team]
	  if model
		command.concat(['--model', model, '--effort', effort])
		command.concat(['--socket', @codex_socket]) if @codex_socket
	  end
	  stdout, _stderr, _status = @command_runner.capture(command)
	  preset = JSON.parse(stdout)
	  raise Error, 'workspace-portal returned an invalid direct team preset' unless valid_direct_team_preset?(preset)

	  preset
	rescue Errno::ENOENT, Errno::EACCES, Errno::ELOOP => e
	  raise Error, "cannot resolve installed workspace portal package: #{e.message}"
	rescue JSON::ParserError => e
	  raise Error, "workspace-portal returned invalid direct team preset JSON: #{e.message}"
	end

	def load_direct_team_preset!(path)
	  raise Error, 'direct team preset path must be absolute' unless path.is_a?(String) && path.start_with?(File::SEPARATOR)
	  preset = read_private_json_object(path, 'direct team preset', max_size: 64 * 1024, mode: 0o600)
	  raise Error, 'direct team preset is invalid' unless valid_direct_team_preset?(preset)

	  preset
	rescue JSON::ParserError => e
	  raise Error, "invalid direct team preset: #{e.message}"
	end

	def apply_direct_team_preset!(slug, root_thread_id, preset)
	  raise Error, 'workspace-portal is required to create a direct team' unless @portal_command && !@portal_command.empty?
	  raise Error, 'direct team creation has an invalid root thread' unless root_thread_id.is_a?(String) && root_thread_id.match?(/\A[0-9A-Za-z-]+\z/)
	  raise Error, 'direct team preset is invalid' unless valid_direct_team_preset?(preset)

	  snapshot = Tempfile.new(['dev-session-direct-team-', '.json'])
	  snapshot.chmod(0o600)
	  snapshot.write(JSON.generate(preset))
	  snapshot.write("\n")
	  snapshot.flush
	  snapshot.fsync
	  command = [
		*@portal_command, 'team', 'apply-preset',
		'--user-state-root', @workspace_state_root,
		'--workspace', workspace,
		'--session-slug', slug,
		'--root-thread-id', root_thread_id,
		'--cwd', work_dir(slug),
		'--preset-file', snapshot.path
	  ]
	  command += ['--socket', @codex_socket] if @codex_socket
	  stdout, _stderr, _status = creation_capture(command)
	  result = JSON.parse(stdout)
	  unless result.is_a?(Hash) && result['rootThreadId'] == root_thread_id && result['slug'] == slug
		raise Error, 'workspace-portal returned an invalid direct team roster'
	  end
	  stdout
	rescue JSON::ParserError => e
	  raise Error, "workspace-portal returned invalid direct team roster JSON: #{e.message}"
	ensure
	  snapshot&.close!
	end

    def codex_metadata(thread_id)
      metadata = { 'thread_id' => thread_id }
      if @codex_socket && !@codex_socket.empty? && @codex_version && !@codex_version.empty?
        metadata['socket_path'] = @codex_socket
        metadata['client_version'] = @codex_version
      end
      metadata
    end

    def require_current_codex_provenance!(slug, manifest, thread_id)
      return unless thread_id && codex_provenance_configured?
      return if manifest.dig('codex', 'socket_path') == @codex_socket

      raise Error,
            "recorded Codex endpoint belongs to another runtime; " \
            "start a new session instead: #{slug}"
    end

    def session_codex_provenance_matches?(session, thread_id)
      session.codex_thread_id == thread_id &&
        session.codex_socket_path == @codex_socket
    end

    def codex_provenance_configured?
      @codex_socket && !@codex_socket.empty? && @codex_version && !@codex_version.empty?
    end

    def seed_goal(slug, goal_file)
      goal = read_goal(goal_file)
      seed_tracking_file(
        plan_file(slug), [plan_skeleton(slug), previous_plan_skeleton(slug)],
        "## Goal\n\n", "#{goal}\n\n", 'plan'
      )
      seed_tracking_file(
        state_file(slug), [state_skeleton(slug), previous_state_skeleton(slug)],
        "## Status\n\n", "- Session created with an initial request.\n\n", 'state'
      )
    end

    def seed_tracking_file(path, templates, marker, insertion, label)
      content = File.read(path)
      templates.each do |empty|
        seeded = empty.sub(marker, "#{marker}#{insertion}")
        return if content == seeded
        next unless content == empty

        atomic_replace(path, seeded)
        return
      end
      raise Error, "#{label} cannot be reconciled with the creation journal: #{path}"
    end

    def read_goal(goal_file)
      path = File.expand_path(goal_file)
      data = File.open(path, File::RDONLY | File::NOFOLLOW) do |file|
        stat = file.stat
        current = File.lstat(path)
        unless stat.file? && !current.symlink? && stat.dev == current.dev &&
               stat.ino == current.ino
          raise Error, "goal file is not a stable regular file: #{path}"
        end
        file.read(MAX_MESSAGE_BYTES + 1)
      end
      if data.bytesize > MAX_MESSAGE_BYTES
        raise Error, "goal file exceeds #{MAX_MESSAGE_BYTES.to_s.reverse.scan(/.{1,3}/).join(',').reverse} bytes"
      end

      goal = data.force_encoding(Encoding::UTF_8)
      raise Error, 'goal file is not valid UTF-8' unless goal.valid_encoding?

      goal = goal.strip
      raise Error, 'goal file is empty' if goal.empty?

      goal
    rescue Errno::ELOOP
      raise Error, "goal file is a symlink: #{path}"
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "cannot read goal file #{path}: #{e.message}"
    end

    def normalize_goal_text(value)
      raise Error, 'initial request is not text' unless value.is_a?(String)
      if value.bytesize > MAX_MESSAGE_BYTES
        raise Error,
              "initial request exceeds #{MAX_MESSAGE_BYTES.to_s.reverse.scan(/.{1,3}/).join(',').reverse} bytes"
      end

      goal = value.dup.force_encoding(Encoding::UTF_8)
      raise Error, 'initial request is not valid UTF-8' unless goal.valid_encoding?

      goal = goal.strip
      raise Error, 'the initial request cannot be empty' if goal.empty?

      goal
    end

    def update_portal_repository(
      slug,
      name:,
      project:,
      github:,
      branch:,
      base_sha:,
      default_branch:
    )
      manifest = ensure_portal_manifest(slug)
      repository = {
        'name' => name,
        'project' => project,
        'github' => github,
        'branch' => branch,
        'default_branch' => default_branch.delete_prefix('origin/'),
        'initial_base_sha' => base_sha
      }.reject { |_key, value| value.nil? || value.empty? }

      repositories = manifest.fetch('repositories', [])
      index = repositories.index { |item| item.is_a?(Hash) && item['name'] == name }
      index ? repositories[index] = repository : repositories << repository
      manifest['repositories'] = repositories.sort_by { |item| item.fetch('name', '') }
      write_portal_manifest(slug, manifest)
    end

    def github_repository(remote)
      match = remote.match(
        %r{\A(?:git@github\.com:|ssh://git@github\.com/|https?://github\.com/)([^/]+/[^/]+?)(?:\.git)?\z}
      )
      match && match[1]
    end

