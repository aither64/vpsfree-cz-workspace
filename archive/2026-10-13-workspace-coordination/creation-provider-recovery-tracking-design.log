    def ensure_tracking_files(slug, allow_uncommitted_revive: false)
      if path_exists?(work_dir(slug))
        validate_work_directory!(slug)
        validate_tracking_files!(slug)
        if archived_slug_known?(slug) && !committed_path?('HEAD', File.join('work', slug, 'state.md')) &&
           !allow_uncommitted_revive && !valid_uncommitted_revive?(slug)
          raise Error, "archived slug cannot be reused: #{archive_dir(slug)}"
        end
        ensure_worktree_group!(slug, create: true)
        return
      end

      archived = archive_dir(slug)
      if archived_slug_known?(slug)
        raise Error, "archived slug cannot be reused: #{archived}"
      end

      ensure_directory!(File.join(workspace, 'work'), 'work root', create: true)
      ensure_directory!(work_dir(slug), 'work directory', create: true)
      ensure_worktree_group!(slug, create: true)
      write_once(plan_file(slug), plan_skeleton(slug))
      write_once(state_file(slug), state_skeleton(slug))
    end

    def ensure_fork_tracking_files(slug)
      if archived_slug_known?(slug)
        raise Error, "archived slug cannot be reused: #{archive_dir(slug)}"
      end

      ensure_directory!(File.join(workspace, 'work'), 'work root', create: true)
      ensure_directory!(work_dir(slug), 'work directory', create: true)
      validate_work_directory!(slug)
      cleanup_fork_writer_temporaries!(slug)
      ensure_worktree_group!(slug, create: true)
      ensure_fork_tracking_file!(plan_file(slug), plan_skeleton(slug), 'plan.md')
      ensure_fork_tracking_file!(state_file(slug), state_skeleton(slug), 'state.md')
      allowed = %w[plan.md portal.yml state.md]
      unexpected = Dir.children(work_dir(slug)).sort - allowed
      unless unexpected.empty?
        raise Error,
              "incomplete fork has unexpected tracking files: #{unexpected.join(', ')}"
      end
    end

    def cleanup_fork_writer_temporaries!(slug)
      directory = work_dir(slug)
      removed = false
      Dir.children(directory).sort.each do |name|
        match = name.match(/\A\.(plan\.md|state\.md|portal\.yml)\.[0-9]+\.tmp\z/)
        next unless match

        path = File.join(directory, name)
        stat = File.lstat(path)
        permissions = stat.mode & 0o777
        unless stat.file? && stat.uid == Process.euid &&
               permissions == (permissions & 0o644)

