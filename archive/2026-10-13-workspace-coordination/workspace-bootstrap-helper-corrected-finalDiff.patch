+  machines.aitherdev = {
+    id = "vpsfree:aitherdev";
+    aliases = [
+      "aitherdev.int.vpsfree.cz"
+      "cz.vpsfree/machines/aitherdev"
+    ];
+    adapter = "confctl";
+    configurationRepository = "vpsfree-cz-configuration";
+    selector = "cz.vpsfree/machines/aitherdev";
