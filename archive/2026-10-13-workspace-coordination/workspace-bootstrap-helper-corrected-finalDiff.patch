+  profileMachine = "vpsfree:aitherdev";
+  repositories =
+    builtins.listToAttrs (
+      map
+        (project: {
+          name = project;
+          value = {
+            remote = "git@github.com:vpsfreecz/${project}.git";
+            defaultTarget = "refs/heads/${targets.${project} or "master"}";
+          };
+        })
+        [
+          "vpsadminos"
