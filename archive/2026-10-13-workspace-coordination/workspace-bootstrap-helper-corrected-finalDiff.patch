+    )
+    // {
+      workspace = {
+        remote = "git@github.com:aither64/vpsfree-cz-workspace.git";
+        defaultTarget = "refs/heads/master";
+      };
+      dev-workspace = {
+        remote = "git@github.com:aither64/dev-workspace.git";
+        defaultTarget = "refs/heads/master";
+        inputPaths.workspace = [
+          [
+            "vpsfree-dev-workspace"
