+    assert_equal 2, sends.length
+    assert_equal sends.first.slice('messageId', 'text', 'thread', 'actionContext', 'options', 'payloadDigest'), sends.last.slice('messageId', 'text', 'thread', 'actionContext', 'options', 'payloadDigest')
