+++ b/portal/internal/web/static/coordination.js
@@ -0,0 +1,62 @@
+"use strict";
+
+(() => {
+  const panel = document.querySelector("[data-coordination]");
+  if (!panel) return;
+  const slug = document.body.dataset.session;
+  const endpoint = slug ? `/api/sessions/${encodeURIComponent(slug)}/coordination` : "/api/coordination";
+  const labels = {waiting_approval: "Waiting for approval", waiting_dependency: "Waiting for an earlier operation",
+    waiting_resource: "Queued", ready: "Ready to run", claimed: "Starting", running: "Running",
+    needs_refresh: "Preparation needed", reconciling: "Recovery required", succeeded: "Completed",
+    failed: "Failed", canceled: "Canceled", requested: "Queued", held: "Reserved for deployment",
+    deployed_review: "Reserved through review and iteration", blocked_recovery: "Reserved for recovery",
+    closing: "Checking completion", released: "Released"};
+  const node = (tag, text) => { const element = document.createElement(tag); element.textContent = text; return element; };
+  const link = (url, text) => {
+    const element = node("a", text);
+    try { if (new URL(url).protocol === "https:") element.href = url; } catch (_) { /* malformed status link */ }
+    return element;
+  };
+  async function refresh() {
+    try {
+      const response = await fetch(endpoint, {cache: "no-store"});
+      if (!response.ok) throw new Error("Operations are unavailable. Their reservations remain held.");
+      const payload = await response.json();
+      const workspaces = payload.workspaces || [payload];
+      const content = document.createDocumentFragment();
+      let count = 0;
+      for (const workspace of workspaces) {
+        const owners = new Map(workspace.owners.map(owner => [owner.id, owner]));
+        if (workspace.suspended) content.append(node("p", "Scheduling is suspended."));
+        for (const reservation of workspace.reservations) {
+          if (reservation.state === "released") continue;
+          const row = node("p", `${reservation.machine}: ${labels[reservation.state] || reservation.state}. `);
+          const owner = owners.get(reservation.ownerId);
+          if (owner) row.append(link(owner.portalUrl, owner.slug));
+          content.append(row); count++;
+        }
+        for (const blocker of workspace.foreignReservations) {
+          const row = node("p", `${blocker.machine}: ${labels[blocker.state] || blocker.state}. `);
+          row.append(link(blocker.portalUrl, "Owning session")); content.append(row); count++;
+        }
+        for (const job of workspace.jobs) {
+          const row = node("p", `${job.kind.replaceAll("_", " ")}: ${labels[job.state] || job.state} (${job.id.slice(0, 8)}). `);
+          if (job.state === "needs_refresh") row.append(node("span", "The owning agent must prepare and verify a fresh snapshot."));
+          if (job.reason?.portalUrl) row.append(link(job.reason.portalUrl, "Blocking session"));
+          content.append(row); count++;
+        }
+        for (const event of workspace.notifications) {
+          if (event.state === "delivered") continue;
+          content.append(node("p", `Agent notification: ${event.state === "held" ? "held" : "awaiting delivery or receipt reconciliation"}.`)); count++;
+        }
+        if (workspace.counts && Object.entries(workspace.counts).some(([key, total]) => total > workspace[key].length)) {
+          content.append(node("p", "This view shows up to 128 records of each kind. The session command provides the full history."));
+        }
+      }
+      if (!count) content.append(node("p", "No coordinated operations or machine reservations."));
+      panel.replaceChildren(content);
+    } catch (error) { panel.replaceChildren(node("p", error.message)); }
+    finally { setTimeout(refresh, 5000); }
+  }
+  refresh();
+})();
