+    def fence(workspace, slug, command, owner_ids: nil)
+      transaction do |data|
+        owners = data['owners'].values.select { |owner| owner['workspace'] == workspace && owner['slug'] == slug && (!owner_ids || owner_ids.include?(owner['id'])) }
