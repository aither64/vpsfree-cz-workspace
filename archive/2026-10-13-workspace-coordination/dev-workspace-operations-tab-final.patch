+    git('init', '--bare', '--initial-branch=master', @remote)
+    seed = File.join(@tmp, 'seed')
+    git('clone', @remote, seed)
+    git('-C', seed, 'config', 'user.name', 'Fixture')
+    git('-C', seed, 'config', 'user.email', 'fixture@example.test')
