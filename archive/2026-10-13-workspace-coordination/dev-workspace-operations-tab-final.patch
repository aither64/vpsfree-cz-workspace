+		if err := os.WriteFile(filepath.Join(directory, name), []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	identity, err := session.ObservationIdentity(server.config.Workspace, "example", directory, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	check := func() {
