    def name_portal_thread(slug, thread_id)
      command = [
        *@portal_command,
        'thread',
        'set-name',
        '--thread-id',
        thread_id,
        '--name',
        slug
      ]
      command += ['--socket', @codex_socket] if @codex_socket
      @command_runner.capture(command)
    rescue CommandError => e
      @err.puts "warning: unable to name shared Codex thread: #{e.message}"
