    def create_portal_thread(
      slug,
      persisted_thread_id: nil,
      recover_creating: false,
      recover_archived: false,
      model: nil,
      effort: nil,
      lead_instructions: nil
    )
      unless @portal_command && !@portal_command.empty?
        @err.puts 'warning: workspace-portal is unavailable; starting an unshared Codex session'
        return nil
      end

      conversation_started = creation_progress_begin('conversation')
      environment = session_environment(slug)
      command = [*@portal_command, 'thread', 'create', '--user-state-root', @workspace_state_root]
      THREAD_ENV_ARGUMENTS.each do |name, argument|
        command += [argument, environment.fetch(name)] if environment.key?(name)
      end
      command << '--require-runtime' if environment[ENV_REQUIRE_RUNTIME] == '1'
      command += ['--thread-id', persisted_thread_id] if persisted_thread_id
      command << '--recover-creating' if recover_creating
      command << '--recover-archived' if recover_archived
      command += ['--model', model] if model
      command += ['--effort', effort] if effort
      command += ['--lead-instructions', lead_instructions] if lead_instructions
      stdout, _stderr, _status = creation_capture(command)
      result = JSON.parse(stdout)
      thread_id = result['threadId']
      unless thread_id.is_a?(String) && thread_id.match?(/\A[0-9A-Za-z-]+\z/)
        raise Error, 'workspace-portal returned an invalid Codex thread id'
      end

      creation_progress_finish('conversation', conversation_started)
      thread_id
    rescue JSON::ParserError => e
      raise Error, "workspace-portal returned invalid JSON: #{e.message}"
    end

