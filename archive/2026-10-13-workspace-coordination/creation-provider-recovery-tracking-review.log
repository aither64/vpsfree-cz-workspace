    def validate_creation_tracking_files!(slug)
      requirements = {
        plan_file(slug) => [
          "# #{slug}", '## Goal', '## Affected repositories', '## Approach',
          '## Compatibility and deployment', '## Testing plan'
        ],
        state_file(slug) => [
          "---\nlifecycle: active\n---", "# #{slug}", '## Repositories',
          '## Status', '## Commands run', '## Results', '## Open questions',
          '## Cleanup'
        ]
      }
      requirements.each do |path, markers|
        content = read_bounded_file(path, File.basename(path))
        missing = markers.reject { |marker| content.include?(marker) }
        next if missing.empty?

        raise Error, "tracking file is incomplete and cannot be reconciled: #{path}"
      end
    end

    def atomic_replace(path, content)
      raise Error, "tracking file is a symlink: #{path}" if File.symlink?(path)
      raise Error, "tracking path is not a file: #{path}" unless File.file?(path)

      directory = File.dirname(path)
      temporary = File.join(directory, ".#{File.basename(path)}.#{$$}.tmp")
      raise Error, "temporary tracking file already exists: #{temporary}" if path_exists?(temporary)

      begin
        File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o644) do |file|
          file.write(content)
          file.flush
          file.fsync
        end
        File.rename(temporary, path)
        fsync_directory(directory)
      ensure
        File.unlink(temporary) if path_exists?(temporary)
      end
    end

