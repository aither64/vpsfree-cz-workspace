        'methodSha256' => Digest::SHA256.hexdigest(new_method), 'ordinaryTransitionLock' => true)
    elsif ARGV.empty?
      exit DevSession::CLI.new(arguments, env: environment).run
    else
      raise 'use --inspect or no arguments'
    end
  end
end
end

