    def instance_argument(argv, command)
      raise Error, "#{command} requires one workspace name" unless argv.length == 1
      entry = registry.find(argv.fetch(0))
      raise Error, "workspace is not registered: #{argv.fetch(0)}" unless entry
      entry
    end

    def instance_runtime(entry)
      root = File.join(@runtime, entry.fetch('name'))
      {
        root: root,
        portal: File.join(root, 'portal.sock'),
        codex: File.join(root, 'app-server.sock'),
        tmux: File.join(root, 'tmux.sock'),
        authority: File.join(root, 'authority')
      }
    end

    def quarantine_instance_runtime(entry)
      root = instance_runtime(entry).fetch(:root)
      return nil unless File.exist?(root) || File.symlink?(root)

      raise Error, "workspace runtime is a symlink: #{root}" if File.symlink?(root)
      stat = File.stat(root)
      unless stat.directory? && stat.uid == Process.euid
        raise Error, "workspace runtime is not an owned directory: #{root}"
      end
      FileUtils.mkdir_p(@runtime, mode: 0o700)
      retired = File.join(@runtime, ".retired-#{entry.fetch('name')}-#{Process.pid}")
      if File.exist?(retired) || File.symlink?(retired)
        raise Error, "retired workspace runtime already exists: #{retired}"
      end
      File.rename(root, retired)
      retired
    end

    def restore_instance_runtime(retired, entry)
      root = instance_runtime(entry).fetch(:root)
      raise Error, "workspace runtime was recreated during rollback: #{root}" if File.exist?(root)

      File.rename(retired, root)
    end

    def discard_retired_runtime(retired)
      return unless retired

      FileUtils.remove_entry_secure(retired)
    rescue SystemCallError => e
      @err.puts "warning: unable to remove retired workspace runtime #{retired}: #{e.message}"
      when 'stop'
        run_stop
      when 'recover-stale'
        run_single_slug { |runner, slug, opts| runner.recover_stale(slug, as_is: opts[:as_is]) }
      when 'archive'
        run_archive
      when 'auto-archive'
        run_auto_archive
      when 'delete'
        run_delete
      when 'revive'
        run_revive
      when 'list'
        run_list
      when 'validate'
        runner.validate
      when 'current'
        run_current
      when 'url'
        run_url
      when 'worktree'
        run_worktree
      when 'artifact'
        run_artifact
      when 'team'
        run_team
      else
        raise Error, "unknown command: #{command}"
      end
    end

    def with_transition_lock(mode, read_only: false)
      FileUtils.mkdir_p(File.dirname(@transition_lock), mode: 0o700) unless read_only
      raise Error, "transition lock is a symlink: #{@transition_lock}" if File.symlink?(@transition_lock)
      flags = read_only ? File::RDONLY : File::RDWR | File::CREAT
      file = begin
        File.open(@transition_lock, flags, 0o600)
      rescue Errno::ENOENT
        raise Error, "transition lock is missing: #{@transition_lock}" if read_only

        raise
      end
      file.flock(mode)
      yield
    ensure
      file&.close
    end

    def with_lifecycle_transition(&block)
      unless @transition_lock
        validate_host_generation!
        return yield
      end

      with_transition_lock(File::LOCK_SH) do
        validate_host_generation!
        block.call
      end
    end

    def validate_host_generation!
      begin
        WorkspaceProviderAdmission.require!(@env, @workspace, @codex_socket) unless @provider_read_only
      rescue StandardError => e
        raise Error, e.message
      end
      return unless @host_profile || @expected_host_generation || @expected_host_profile_token
      unless @host_profile && @expected_host_generation && @expected_host_profile_token &&
             @expected_host_profile_token.match?(/\A[0-9a-f]{64}\z/) &&
             File.symlink?(@host_profile) &&
             File.realpath(@host_profile) == File.realpath(@expected_host_generation) &&
             profile_link_token(@host_profile) == @expected_host_profile_token
        raise SupersededGenerationError,
              'workspace command belongs to a superseded package generation; rerun it'
      end
    rescue Errno::ENOENT, Errno::EACCES, Errno::ELOOP
      raise SupersededGenerationError, 'workspace package generation cannot be verified; rerun the command'
    end

