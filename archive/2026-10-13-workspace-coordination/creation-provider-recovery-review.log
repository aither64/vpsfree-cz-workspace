    def creation_receipt_options(id, evidence, expected_source:, expected_source_thread:, expected_source_identity:, team_binding: nil)
      values = [id, evidence, expected_source, expected_source_thread, expected_source_identity]
      return nil if values.all?(&:nil?)
      unless id.is_a?(String) && id.match?(/\A[0-9a-f]{64}\z/) &&
             evidence.is_a?(String) && evidence.start_with?('/')
        raise Error, 'creation receipt requires a valid ID and absolute evidence path'
      end
      binding_digest = nil
	  if team_binding
		binding_match = team_binding.is_a?(String) && AGENT_TEAM_BINDING_PATTERN.match(team_binding)
		unless binding_match && team_binding.bytesize <= 32 * 1024
		  raise Error, 'agent team binding is invalid'
		end
		binding_digest = binding_match[1]
      end
      source_values = [expected_source, expected_source_thread, expected_source_identity]
      unless source_values.all?(&:nil?) ||
             valid_part?(expected_source) && expected_source_thread.is_a?(String) &&
               expected_source_thread.match?(/\A[0-9A-Za-z-]+\z/) &&
               expected_source_identity.is_a?(String) &&
               expected_source_identity.match?(/\A[0-9a-f]{64}\z/)
        raise Error, 'creation source expectation is incomplete'
      end
      directory = File.dirname(evidence)
      unless File.directory?(directory) && !File.symlink?(directory) &&
             File.stat(directory).mode & 0o777 == 0o700
        raise Error, 'creation evidence directory must be private'
      end
      {
        'receipt_id' => id, 'evidence' => evidence,
        'source' => expected_source, 'source_thread' => expected_source_thread,
        'source_identity' => expected_source_identity,
        'agent_team_binding' => team_binding,
        'agent_team_binding_digest' => binding_digest
      }.compact
    end

    # Called only under creation-then-slug locks. Compact mappings never reserve
    # a name and live in a separate directory, so this scan stays bounded.
    def guard_portal_preparation_reservation!(slug, receipt)
      return unless @workspace_state_root
      workspace_id = "#{File.basename(workspace)}-#{Digest::SHA256.hexdigest(workspace)[0, 16]}"
      root = File.join(@workspace_state_root, 'portal', workspace_id)
      pending = File.join(root, 'session-preparations')
      if path_exists?(pending)
        unless File.directory?(pending) && !File.symlink?(pending) && File.stat(pending).mode & 0o777 == 0o700
          raise Error, 'portal session preparation directory must be private'
        end
        files = Dir.children(pending).reject { |name| name.start_with?('.') && name.end_with?('.tmp') }
        raise Error, 'too many unfinished portal session preparations' if files.length > 512
        files.each do |name|
          unless name.match?(/\A[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\.json\z/)
            raise Error, 'invalid portal preparation filename'
          end
          record_path = File.join(pending, name)
          raise Error, 'portal session preparation is a symlink' if File.symlink?(record_path)
          record = read_private_json_object(record_path, 'portal session preparation', max_size: 2 * (12 * MAX_MESSAGE_BYTES + 16_384) + 16_384, mode: 0o600)
          unless record['schema'] == 1 && record['workspace'] == workspace && record['requestId'] == name.delete_suffix('.json') &&
                 record['receiptId'].is_a?(String) && record['receiptId'].match?(/\A[0-9a-f]{64}\z/) &&
                 record['inputVersion'] == 1 && record['inputDigest'].is_a?(String) && record['inputDigest'].match?(/\A[0-9a-f]{64}\z/) &&
                 %w[accepting running paused failed handed_off terminal].include?(record['state'])
            raise Error, 'invalid portal session preparation identity'
          end
          next if record['state'] == 'terminal' || record['slug'] != slug
          unless record['epoch'].is_a?(String) && record['epoch'].match?(/\A[0-9a-f]{64}\z/) && record['handoff'].is_a?(Hash) && record.dig('handoff', 'slug') == slug
            raise Error, 'invalid portal preparation reservation'
          end
          unless receipt && receipt['receipt_id'] == record['receiptId']
            raise Error, "session name is reserved by an accepted portal request: #{slug}"
          end
        end
      end
      receipt_path = File.join(root, 'creations', "#{slug}.json")
      return unless path_exists?(receipt_path)
      raise Error, 'portal creation receipt is a symlink' if File.symlink?(receipt_path)
      current = read_private_json_object(receipt_path, 'portal creation receipt', max_size: 12 * MAX_MESSAGE_BYTES + 16_384, mode: 0o600)
      unless [1, 2, 3].include?(current['schema']) && current['workspace'] == workspace && current['request'].is_a?(Hash) && current.dig('request', 'slug') == slug &&
             current['receiptId'].is_a?(String) && current['receiptId'].match?(/\A[0-9a-f]{64}\z/) &&
             %w[running paused failed ready conflict cancelled].include?(current['state'])
        raise Error, 'invalid portal creation reservation'
      end
      return if %w[ready conflict cancelled].include?(current['state'])
      unless receipt && receipt['receipt_id'] == current['receiptId']
        raise Error, "session creation belongs to another portal request: #{slug}"
      end
    end

    def verify_creation_source!(receipt)
      slug = receipt.fetch('source')
      with_slug_lock(slug) do
        reject_conflicting_lifecycle_journal!(slug)
        manifest = load_portal_manifest(portal_file(slug), required: true)
        require_expected_creation_source!(receipt, slug, manifest)
      end
    end

    def require_expected_creation_source!(receipt, slug, manifest)
      return unless receipt
      stat = File.lstat(work_dir(slug))
      identity = Digest::SHA256.hexdigest([
        work_dir(slug), stat.dev, stat.ino, stat.ctime.to_i, stat.ctime.nsec,
        manifest.dig('codex', 'thread_id')
      ].join("\0"))
      unless stat.directory? && receipt['source'] == slug &&
             manifest.dig('codex', 'thread_id') == receipt.fetch('source_thread') &&
             identity == receipt.fetch('source_identity') &&
             (!manifest.key?('creation') || manifest.dig('creation', 'state') == 'ready' &&
               (!manifest.dig('creation', 'goal_sha256') || manifest.dig('creation', 'initial_goal_sent')))
        raise Error, 'source session changed since creation was accepted'
      end
      require_creationless_retained_ready!(slug, manifest) unless manifest.key?('creation')
    end

    def prepare_portal_creation_receipt!(receipt, slug, kind, goal:, model:, effort:, team_binding: nil, direct_team: nil)
      return unless receipt
      path = receipt.fetch('evidence') + '.request'
      history = require_current_portal_creation!(receipt, slug, model:, effort:, direct_team:)
      binding = {
        'schema' => direct_team ? 3 : (team_binding ? 2 : 1), 'workspace' => workspace, 'slug' => slug, 'kind' => kind,
        'receipt_id' => receipt.fetch('receipt_id'), 'deletion_history_sha256' => history,
        'source_thread' => receipt['source_thread'],
        'source_identity' => receipt['source_identity'],
        'goal_sha256' => goal && Digest::SHA256.hexdigest(goal),
        'model' => model, 'effort' => effort
      }
	  if team_binding
		binding['agent_team_binding'] = team_binding
		binding['agent_team_binding_digest'] = receipt.fetch('agent_team_binding_digest')
	  end
	  binding['direct_team'] = direct_team if direct_team
      if path_exists?(path)
        unless read_private_json_object(
          path, 'creation request binding', max_size: 16 * 1024, mode: 0o600
        ) == binding
          raise Error, 'creation receipt does not match the recorded CLI request'
        end
      else
        if slug_state_exists?(slug) || path_exists?(creation_journal_file(slug)) ||
           path_exists?(fork_journal_file(slug)) || path_exists?(start_journal_file(slug))
          raise Error, 'existing session creation belongs to another request'
        end
      end
      write_creation_journal(path, binding, create: true) unless path_exists?(path)
      receipt['binding'] = binding
	  receipt['direct_team'] = direct_team if direct_team
    rescue JSON::ParserError => e
      raise Error, "invalid creation request binding: #{e.message}"
    end

    # The current receipt is mandatory even after a CLI binding exists. Its
    # disappearance or replacement ends a worker queued before cache retirement.
    def require_current_portal_creation!(receipt, slug, model:, effort:, direct_team: nil)
      path = File.join(File.dirname(receipt.fetch('evidence')), "#{slug}.json")
      current = read_private_json_object(
        path, 'creation receipt', max_size: 12 * MAX_MESSAGE_BYTES + 16_384, mode: 0o600,
        missing_error: 'creation request is no longer current; start a new request'
      )
      expected_schema = direct_team ? 3 : (receipt['agent_team_binding'] ? 2 : 1)
      unless current.is_a?(Hash) && current['schema'] == expected_schema && current['workspace'] == workspace &&
             current['receiptId'] == receipt.fetch('receipt_id') && current['request'].is_a?(Hash) &&
             current['request']['slug'] == slug && current['deletionHistorySha256'].is_a?(String) &&
             current['deletionHistorySha256'].match?(/\A[0-9a-f]{64}\z/)
        raise Error, 'creation request is no longer current; start a new request'
      end
      if expected_schema == 2
		validate_current_managed_portal_receipt!(current, receipt, slug, model:, effort:)
		receipt['agent_team_catalog_digest'] = current.fetch('request').fetch('catalogDigest')
	  elsif expected_schema == 3
		validate_current_direct_portal_receipt!(current, receipt, slug, model:, effort:, direct_team:)
      end
      history = current.fetch('deletionHistorySha256')
      if receipt['binding'] && receipt['binding']['deletion_history_sha256'] != history
        raise Error, 'creation receipt does not match the recorded CLI request'
      end
      if completed_removal_history(slug) != history
        raise Error, 'this creation request ended when the session was deleted; start a new request'
      end
      history
    rescue JSON::ParserError => e
      raise Error, "invalid creation receipt: #{e.message}"
    def write_portal_creation_evidence!(receipt, slug, selected)
      evidence_started = creation_progress_begin('evidence')
      manifest = load_portal_manifest(portal_file(slug), required: true)
      binding = receipt.fetch('binding')
      unless selected && selected.codex_thread_id == manifest.dig('codex', 'thread_id') &&
             manifest.dig('creation', 'state') == 'ready' &&
             (!manifest.dig('creation', 'goal_sha256') || manifest.dig('creation', 'initial_goal_sent'))
        raise Error, 'cannot prove creation completed for the recorded conversation'
      end
      stat = File.lstat(work_dir(slug))
      evidence = {
        'schema' => 1, 'workspace' => workspace, 'slug' => slug,
        'receiptId' => receipt.fetch('receipt_id'),
        'threadId' => selected.codex_thread_id,
        'sourceThreadId' => receipt['source_thread'].to_s,
        'goalSha256' => binding['goal_sha256'].to_s,
        'model' => binding['model'].to_s, 'effort' => binding['effort'].to_s,
        'trackingDevice' => stat.dev, 'trackingInode' => stat.ino
      }
	  if receipt['agent_team_binding']
		identity = selected.identity_token
		catalog_digest = receipt['agent_team_catalog_digest']
		unless identity.is_a?(String) && identity.match?(/\A[0-9a-f]{64}\z/) &&
		       catalog_digest.is_a?(String) && catalog_digest.match?(/\A[0-9a-f]{64}\z/) &&
		       receipt['agent_team_binding_digest'].is_a?(String) &&
		       receipt['agent_team_binding_digest'].match?(/\A[0-9a-f]{64}\z/)
		  raise Error, 'managed creation evidence has incomplete identity'
		end
		evidence.merge!(
		  'schema' => 2,
		  'agentTeamBindingDigest' => receipt.fetch('agent_team_binding_digest'),
		  'catalogDigest' => catalog_digest,
		  'creationIdentity' => identity,
		  'removalEpoch' => receipt.fetch('binding').fetch('deletion_history_sha256')
		)
	  end
	  if receipt['direct_team']
		preset = receipt.fetch('direct_team')
		unless valid_direct_team_preset?(preset)
		  raise Error, 'direct creation evidence has an invalid preset'
		end
		evidence.merge!(
		  'schema' => 3,
		  'catalogDigest' => preset.fetch('catalogDigest'),
		  'teamDigest' => preset.fetch('teamDigest'),
		  'team' => preset.fetch('id')
		)
	  end
      write_creation_journal(receipt.fetch('evidence'), evidence, create: false)
      creation_progress_finish('evidence', evidence_started)
    end

    def creation_journal_file(slug)
      root = File.join(workspace, 'worktrees')
      ensure_directory!(root, 'worktrees root', create: true)
      lock_root = File.join(root, '.locks')
      ensure_directory!(lock_root, 'dev-session lock directory', create: true)
      File.join(lock_root, "#{slug}.creation.json")
    end

    def fork_journal_file(slug)
      File.join(File.dirname(creation_journal_file(slug)), "#{slug}.fork.json")
    end

    def start_journal_file(slug)
      File.join(File.dirname(creation_journal_file(slug)), "#{slug}.start.json")
    end

    def load_start_journal(slug)
      path = start_journal_file(slug)
      return nil unless path_exists?(path)
      raise Error, "start journal is a symlink: #{path}" if File.symlink?(path)
      raise Error, "start journal is not a file: #{path}" unless File.file?(path)

      journal = JSON.parse(File.read(path))
      unless journal.is_a?(Hash) && journal.keys.sort ==
             %w[schema slug state tmux_identity].sort &&
             journal['schema'] == 1 && journal['slug'] == slug &&
             journal['state'] == 'creating' &&
             journal['tmux_identity'].is_a?(String) &&
             journal['tmux_identity'].match?(/\A[0-9a-f]{64}\z/)
        raise Error, "invalid start journal #{path}"
      end
      journal
    rescue JSON::ParserError => e
      raise Error, "invalid start journal #{path}: #{e.message}"
    end

    def prepare_start_journal!(slug, preferred_identity: nil)
      if (journal = load_start_journal(slug))
        if preferred_identity && journal.fetch('tmux_identity') != preferred_identity
          raise Error, "start journal does not match creation identity for #{slug}"
        end
        return journal
      end
      identity = preferred_identity || SecureRandom.hex(32)
      unless identity.match?(/\A[0-9a-f]{64}\z/)
        raise Error, "invalid tmux creation identity for #{slug}"
      end
      journal = {
        'schema' => 1,
        'slug' => slug,
        'state' => 'creating',
        'tmux_identity' => identity
      }
      write_creation_journal(start_journal_file(slug), journal, create: true)
      journal
    end


