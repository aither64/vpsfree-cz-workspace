    def validate_current_direct_portal_receipt!(current, receipt, slug, model:, effort:, direct_team:)
      root_required = %w[
        attempt deletionHistorySha256 directTeam effort model phase receiptId request
        schema startedAt state updatedAt validated workspace
      ]
      root_allowed = root_required + %w[error goal]
      request = current['request']
      unless current.keys.all? { |key| root_allowed.include?(key) } &&
             (root_required - current.keys).empty? && current['schema'] == 3 &&
             current['workspace'] == workspace && current['receiptId'] == receipt.fetch('receipt_id') &&
             current['deletionHistorySha256'].is_a?(String) && current['deletionHistorySha256'].match?(/\A[0-9a-f]{64}\z/) &&
             current['attempt'].is_a?(Integer) && current['attempt'].positive? &&
             [true, false].include?(current['validated']) &&
             %w[running paused failed ready conflict].include?(current['state']) &&
             valid_direct_team_preset?(current['directTeam']) && current['directTeam'] == direct_team &&
             valid_agent_team_persisted_scalar?(model) && valid_agent_team_persisted_scalar?(effort) &&
             current['model'] == model && current['effort'] == effort && request.is_a?(Hash)
        raise Error, 'direct team creation request is no longer current; start a new request'
      end
      required = if request['kind'] == 'new'
                   %w[kind slug goal team catalogDigest]
                 elsif request['kind'] == 'plan'
                   %w[kind slug source sourceThreadId sourceIdentity planTurnId planSha256 team catalogDigest]
                 else
                   []
                 end
	  allowed = required.dup
	  allowed << 'planText' if request['kind'] == 'plan'
	  # An explicit lead override remains in the accepted browser request as
	  # provenance. Its resolved, immutable values live in directTeam.
	  allowed.concat(%w[model effort])
      unless required.any? && request.keys.all? { |key| allowed.include?(key) } &&
             (required - request.keys).empty? && request['slug'] == slug &&
             request['team'] == direct_team['id'] && request['catalogDigest'] == direct_team['catalogDigest']
        raise Error, 'direct team creation request is no longer current; start a new request'
      end
    end

    # The browser receipt is a separate authority from Ruby's journal. Keep
    # the schema-2 shape exact so an added field, duplicate key, or changed
