    def capture(argv, allow_failure: false, env: nil, pass_fds: [], input: nil)
      command = argv.map(&:to_s)
      command = ['timeout', '--signal=TERM', '--kill-after=5s', "#{@timeout}s", *command] if @timeout
      descriptor_options = pass_fds.to_h do |file|
        descriptor = file.fileno
        [descriptor, descriptor]
      end
	  descriptor_options[:stdin_data] = input unless input.nil?
      arguments = env ? [env, *command] : command
      arguments << descriptor_options unless descriptor_options.empty?
      if env && env[CREATION_PROGRESS_ENV] == '1'
        descriptor_options.delete(:stdin_data)
        stdout, stderr, status = capture_progress(arguments, input)
      else
        stdout, stderr, status = Open3.capture3(*arguments)
      end

      unless allow_failure || status.success?
        raise CommandError.new(argv, status, stdout, stderr)
      end

      [stdout, stderr, status]
    end

    def capture_progress(arguments, input)
      Open3.popen3(*arguments) do |stdin, stdout, stderr, process|
        readers = []
        begin
          writer = Thread.new do
            begin
              stdin.write(input) unless input.nil?
            rescue Errno::EPIPE
              # The child may reject the request before reading input.
            ensure
              stdin.close
            end
          end
          output = Thread.new { stdout.read }
          errors = Thread.new do
            decoder = CreationProgressDecoder.new(@err)
            begin
              loop { decoder.feed(stderr.readpartial(16 * 1024)) }
            rescue EOFError
              decoder.finish
            end
          end
          readers = [writer, output, errors]
          readers.each { |thread| thread.report_on_exception = false }
          status = process.value
          writer.value
          [output.value, errors.value, status]
        ensure
          if process.alive?
            Process.kill('TERM', process.pid) rescue Errno::ESRCH
          end
          [stdin, stdout, stderr].each { |pipe| pipe.close unless pipe.closed? }
          readers.each(&:join)
        end
      end
    end

