      required = %w[schema slug goal_sha256 run_codex state model effort direct_team]
      creating = journal['state'] == 'creating'
      ready = journal['state'] == 'ready'
      expected_keys = creating ? required + ['tmux_identity'] : required
      unless journal.keys.sort == expected_keys.sort && journal['slug'] == slug &&
             journal['run_codex'] == true && (creating || ready) &&
             (!creating || journal['tmux_identity'].is_a?(String) && journal['tmux_identity'].match?(/\A[0-9a-f]{64}\z/)) &&
             journal['goal_sha256'].is_a?(String) && journal['goal_sha256'].match?(/\A[0-9a-f]{64}\z/) &&
             valid_direct_team_preset?(journal['direct_team']) &&
             journal['model'] == journal.dig('direct_team', 'leadModel') &&
             journal['effort'] == journal.dig('direct_team', 'leadEffort')
        raise Error, "invalid direct team creation journal #{path}"
      end
      return nil if ready && goal_file.nil?

      goal_sha256 = goal_file && Digest::SHA256.hexdigest(read_goal(goal_file))
      unless journal['goal_sha256'] == goal_sha256
        raise Error, "direct team creation journal goal does not match #{path}"
      end
      journal
    rescue JSON::ParserError => e
      raise Error, "invalid direct team creation journal #{path}: #{e.message}"
    end

    def frozen_direct_team_lead_instructions(slug, root_thread_id)
      if direct_team_state_present?(slug)
        listing = JSON.parse(team(slug, action: 'list'))
        roster = listing['roster']
