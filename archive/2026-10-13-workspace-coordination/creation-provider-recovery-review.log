        end
        saved = roster['leadInstructions']
        if saved
          unless saved.is_a?(String) && !saved.empty? && saved.bytesize <= 4096 &&
                 saved.valid_encoding? && !saved.include?("\0")
            raise Error, "direct team lead instructions are invalid: #{slug}"
          end
          return saved
        end
      end

      path = creation_journal_file(slug)
      return nil unless path_exists?(path)

      journal = read_private_json_object(
        path, 'direct team creation journal', max_size: 64 * 1024, mode: 0o600
      )
      return nil unless journal['schema'] == 3

      required = %w[schema slug goal_sha256 run_codex state model effort direct_team]
      unless journal.keys.sort == required.sort && journal['slug'] == slug &&
             journal['state'] == 'ready' && journal['run_codex'] == true &&
             journal['goal_sha256'].is_a?(String) && journal['goal_sha256'].match?(/\A[0-9a-f]{64}\z/) &&
             valid_direct_team_preset?(journal['direct_team']) &&
