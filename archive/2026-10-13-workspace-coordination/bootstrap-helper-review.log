              "kb-cleanup",
              "kb-contract-build",
              "kb-contract-fetch",
              "kb-contract-manifest",
              "kb-contract-reconcile",
              "kb-page",
              "kb-release",
              "kb-stage"
            ]' \
          ${testPackage}/share/dev-workspace/extensions.json >/dev/null
          ${pkgs.jq}/bin/jq -e '
