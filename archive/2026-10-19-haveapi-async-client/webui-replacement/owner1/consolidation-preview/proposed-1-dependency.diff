@@ -1,4 +1,5 @@
 import fs from 'node:fs';
+import { createHash } from 'node:crypto';
 import path from 'node:path';
 import { fileURLToPath } from 'node:url';
 
@@ -17,12 +18,36 @@ const requiredPaths = [
   'src/routes/router.tsx',
   'src/lib/api/haveapi.ts',
   'UI_REDESIGN.md',
+  'vendor/haveapi-client-provenance.json',
 ];
 const excludedDirectories = new Set([
   '.git', '.vite', 'artifacts', 'dist', 'node_modules', 'output',
   'playwright-report', 'work',
 ]);
 
+function checkHaveApiPackage(root) {
+  const provenance = JSON.parse(fs.readFileSync(path.join(root, 'vendor/haveapi-client-provenance.json'), 'utf8'));
+  const manifest = JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8'));
+  const lock = JSON.parse(fs.readFileSync(path.join(root, 'package-lock.json'), 'utf8'));
+  const filename = `haveapi-client-${provenance.source.commit}.tgz`;
+  if (!/^[a-f0-9]{40}$/.test(provenance.source.commit) || provenance.artifact.filename !== filename) {
+    throw new Error('HaveAPI archive filename must bind its full source commit');
+  }
+  const dependency = `file:vendor/${filename}`;
+  const locked = lock.packages['node_modules/haveapi-client'];
+  if (manifest.dependencies['haveapi-client'] !== dependency ||
+      lock.packages[''].dependencies['haveapi-client'] !== dependency || locked.resolved !== dependency ||
+      locked.version !== provenance.version || locked.integrity !== provenance.artifact.integrity) {
+    throw new Error('HaveAPI dependency, lock and provenance disagree');
+  }
+  const bytes = fs.readFileSync(path.join(root, 'vendor', filename));
+  if (bytes.length !== provenance.artifact.bytes ||
+      createHash('sha256').update(bytes).digest('hex') !== provenance.artifact.sha256 ||
+      `sha512-${createHash('sha512').update(bytes).digest('base64')}` !== locked.integrity) {
+    throw new Error('HaveAPI archive bytes do not match their locked integrity and provenance');
+  }
+}
+
 export function checkPackageSource(root) {
   const absoluteRoot = path.resolve(root);
   const failures = [];
@@ -52,6 +77,11 @@ export function checkPackageSource(root) {
   }
 
   walk(absoluteRoot);
+  try {
+    checkHaveApiPackage(absoluteRoot);
+  } catch (error) {
+    failures.push(error.message);
+  }
   if (failures.length) throw new Error(failures.join('\n'));
   return { requiredFiles: requiredPaths.length };
 }
