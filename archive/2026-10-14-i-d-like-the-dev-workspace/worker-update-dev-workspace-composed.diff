+
+  def fault(point)
+    error = @faults[point]&.shift
+    raise error if error
+  end
+
+  def provider_helper(entry, action, **)
+    @calls << ['helper', action]
+    fault(['helper', action])
+    return {'schema' => 1, 'workspace' => entry.fetch('root'), 'threads' => [], 'loaded' => [], 'blockers' => []} if %w[inventory capture].include?(action)
+    {'verified' => true}
