+        step: diagnostic.fetch(:step), elapsedMs: elapsed.clamp(0, 86_400_000),
+        exception: provider_failure_class(error),
+        errno: errno.is_a?(Integer) && errno.between?(0, 65535) ? errno : 'unavailable',
+        frames:
+      }
