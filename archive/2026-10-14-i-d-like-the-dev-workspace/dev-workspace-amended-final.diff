+func TestAttentionBaselineDeferredCompletionAndNewerTurn(t *testing.T) {
+	now := time.Now()
+	o := attentionFixture()
+	b, emit := reduceAttention(attentionBaseline{}, o, now)
+	if emit || b.Event != nil {
+		t.Fatal("first idle observation manufactured completion")
+	}
