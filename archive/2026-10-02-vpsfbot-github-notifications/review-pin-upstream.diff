diff --git a/.github/workflows/integration-tests.yml b/.github/workflows/integration-tests.yml
index 7581bf6..70dc61f 100644
--- a/.github/workflows/integration-tests.yml
+++ b/.github/workflows/integration-tests.yml
@@ -1,6 +1,13 @@
 name: Integration Tests
 
 on:
+  workflow_dispatch:
+    inputs:
+      stop_on_failure:
+        description: Stop scheduling after the first unexpected result
+        required: true
+        default: false
+        type: boolean
   push:
     paths:
       - .github/workflows/integration-tests.yml
@@ -26,7 +33,7 @@ jobs:
 
     steps:
       - name: Checkout bot
-        uses: actions/checkout@v6
+        uses: actions/checkout@v7
         with:
           fetch-depth: 1
 
@@ -51,38 +58,72 @@ jobs:
 
           find "$gcroot_dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
 
+      - name: Prepare test state
+        id: prepare-tests
+        uses: vpsfreecz/vpsadminos/.github/actions/prepare-test-state@staging
+
       - name: Run tests
         id: run-tests
         timeout-minutes: 320
         shell: bash
+        env:
+          STOP_ON_FAILURE: ${{ github.event.inputs.stop_on_failure || 'false' }}
         run: |
           set -o pipefail
-          rm -rf /tmp/os-test-runner
-          ./test-runner.sh test -f --jobs auto \
-            -t ci \
-            --state-dir /tmp/os-test-runner \
-            | tee test.log
+
+          args=(
+            test
+            -f
+            --jobs auto
+            -t ci
+            --state-dir "$TEST_RUNNER_STATE_DIR"
+          )
+
+          if [[ "$STOP_ON_FAILURE" == "true" ]]; then
+            args+=(--stop-on-failure)
+          fi
+
+          ./test-runner.sh "${args[@]}" | tee test.log
+
+      - name: Upload full test logs
+        id: upload-test-logs
+        if: >-
+          (failure() || cancelled()) &&
+          steps.prepare-tests.outcome == 'success' &&
+          steps.run-tests.outcome != 'skipped'
+        uses: vpsfreecz/vpsadminos/.github/actions/upload-test-logs@staging
+        with:
+          name: vpsfree-irc-bot-test-logs-${{ github.run_id }}
+          paths: |
+            ${{ steps.prepare-tests.outputs.state-directory }}/**/*.log
+            ${{ steps.prepare-tests.outputs.state-directory }}/**/*.txt
 
       - name: Evaluate test results
-        if: always()
+        if: >-
+          always() &&
+          steps.prepare-tests.outcome == 'success' &&
+          steps.run-tests.outcome != 'skipped'
         uses: vpsfreecz/vpsadminos/.github/actions/evaluate-test-results@staging
         with:
           log-file: test.log
 
       - name: Summarise test logs
-        if: always()
+        if: >-
+          always() &&
+          steps.prepare-tests.outcome == 'success' &&
+          steps.run-tests.outcome != 'skipped'
         uses: vpsfreecz/vpsadminos/.github/actions/summarise-test-logs@staging
         with:
-          logs-root: /tmp/os-test-runner
+          logs-root: ${{ steps.prepare-tests.outputs.state-directory }}
 
-      - name: Upload full test logs
-        if: failure()
-        uses: vpsfreecz/vpsadminos/.github/actions/upload-test-logs@staging
+      - name: Cleanup test state
+        if: always()
+        uses: vpsfreecz/vpsadminos/.github/actions/cleanup-test-state@staging
         with:
-          name: vpsfree-irc-bot-test-logs-${{ github.run_id }}
-          paths: |
-            /tmp/os-test-runner/**/*.log
-            /tmp/os-test-runner/**/*.txt
+          state-directory: ${{ steps.prepare-tests.outputs.state-directory }}
+          prepare-outcome: ${{ steps.prepare-tests.outcome }}
+          test-outcome: ${{ steps.run-tests.outcome }}
+          upload-outcome: ${{ steps.upload-test-logs.outcome }}
 
       - name: Cleanup per-user Nix gcroots
         if: always()
