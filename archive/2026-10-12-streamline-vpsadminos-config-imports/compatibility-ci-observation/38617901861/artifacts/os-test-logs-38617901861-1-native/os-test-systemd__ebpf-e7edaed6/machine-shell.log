init_pid="$(
  osctl -j ct show systemd-ebpf |
    ruby -rjson -e 'puts JSON.parse($stdin.read).fetch("init_pid")'
)"
rel="$(sed -n 's/^[0-9]*:://p' "/proc/$init_pid/cgroup" | sed -n '1p')"
test -n "$rel"
host_cgroup2=/sys/fs/cgroup
ct_cgroup="$host_cgroup2$rel"
test -d "$ct_cgroup"
rm -f /run/systemd-ebpf-fdleak/effective.ready   /run/systemd-ebpf-fdleak/effective.stop   /run/systemd-ebpf-fdleak/effective.out   /run/systemd-ebpf-fdleak/effective.rc   /run/systemd-ebpf-fdleak/effective.pid   /run/systemd-ebpf-fdleak/effective.cgroup
printf '%s\n' "$ct_cgroup" >/run/systemd-ebpf-fdleak/effective.cgroup
(
  /nix/store/0z48n6blj24l8chyvs5p20a9s592h93k-systemd-ebpf-fd-leak-probe-1/bin/systemd-ebpf-fd-leak-probe hold-host-cgroup-egress-link     "$ct_cgroup"     /run/systemd-ebpf-fdleak/effective.ready     /run/systemd-ebpf-fdleak/effective.stop     >/run/systemd-ebpf-fdleak/effective.out 2>&1
  echo $? >/run/systemd-ebpf-fdleak/effective.rc
) </dev/null >/dev/null 2>&1 &
echo $! >/run/systemd-ebpf-fdleak/effective.pid
END: 2026-10-14 21:54:06 +0200
