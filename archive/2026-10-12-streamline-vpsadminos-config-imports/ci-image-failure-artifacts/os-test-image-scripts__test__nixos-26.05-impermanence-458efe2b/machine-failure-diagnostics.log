\$4\ \}\'\ \|' '\ \ \ \ head\ -n\ 16\ \|' '\ \ \ \ while\ read\ -r\ pool\ id\ pid\;\ do' '\ \ \ \ \ \ section\ \"\$pool:\$id\ network\ \(init\ \$pid\)\"' '\ \ \ \ \ \ timeout\ 5\ nsenter\ -t\ \"\$pid\"\ -n\ --\ sh\ -c\ \\' '\ \ \ \ \ \ \ \ \'ip\ -o\ link\ show\;\ ip\ -4\ addr\ show\;\ ip\ -6\ addr\ show\;\ ip\ -4\ route\ show\ table\ all\;\ ip\ -6\ route\ show\ table\ all\'\ 2\>\&1' '\ \ \ \ \ \ section\ \"\$pool:\$id\ guest\ resolver/network/package\ identity\ \(init\ \$pid\)\"' '\ \ \ \ \ \ \#\ Resolve\ absolute\ symlinks\ inside\ the\ guest\ root\ as\ well.' '\ \ \ \ \ \ timeout\ 2\ nsenter\ -t\ \"\$pid\"\ -m\ -r\ --\ /bin/sh\ -c\ \\' '\ \ \ \ \ \ \ \ \'PATH\=/run/current-system/sw/bin:/usr/sbin:/usr/bin:/sbin:/bin' '\ \ \ \ \ \ \ \ \ for\ file\ in\ /etc/os-release\ /etc/resolv.conf\ /etc/nsswitch.conf\ /etc/network/interfaces\ /etc/network/interfaces.d/\*\;\ do' '\ \ \ \ \ \ \ \ \ \ \ \[\ -r\ \"\$file\"\ \]\ \|\|\ continue' '\ \ \ \ \ \ \ \ \ \ \ printf\ \"\\n---\ \%s\ ---\\n\"\ \"\$file\"' '\ \ \ \ \ \ \ \ \ \ \ cat\ \"\$file\"' '\ \ \ \ \ \ \ \ \ done' '\ \ \ \ \ \ \ \ \ printf\ \"\\n---\ DHCP\ client\ executables\ ---\\n\"' '\ \ \ \ \ \ \ \ \ for\ client\ in\ dhcpcd\ dhclient\ udhcpc\;\ do\ command\ -v\ \"\$client\"\;\ done' '\ \ \ \ \ \ \ \ \ if\ command\ -v\ dpkg-query\ \>/dev/null\ 2\>\&1\;\ then' '\ \ \ \ \ \ \ \ \ \ \ printf\ \"\\n---\ DHCP/network/resolver\ package\ status\ ---\\n\"' '\ \ \ \ \ \ \ \ \ \ \ dpkg-query\ -s\ ifupdown\ dhcpcd-base\ isc-dhcp-client\ udhcpc\ systemd-resolved' '\ \ \ \ \ \ \ \ \ fi\'\ 2\>\&1' '\ \ \ \ \ \ printf\ \'guest\ resolver/network/package\ snapshot\ status\=\%s\\n\'\ \"\$\?\"' '\ \ \ \ \ \ \#\ Correct\ DHCP\ configuration\ and\ an\ installed\ client\ do\ not\ explain' '\ \ \ \ \ \ \#\ a\ missing\ lease.\ Keep\ the\ service\'s\ original\ startup\ error\ too.' '\ \ \ \ \ \ \#\ Do\ not\ filter\ by\ boot\ ID:\ an\ invalidated\ proc\ bind\ can\ change\ it.' '\ \ \ \ \ \ section\ \"\$pool:\$id\ guest\ networking\ journal\ \(