diff --git a/tests/fixtures/nixos-container-persistence.nix b/tests/fixtures/nixos-container-persistence.nix
new file mode 100644
index 000000000..ca568cfea
--- /dev/null
+++ b/tests/fixtures/nixos-container-persistence.nix
@@ -0,0 +1,45 @@
+# Immutable sources shared by the pure check and registered upgrade suite.
+{
+  system,
+  nixpkgs ? null,
+  nixpkgsUnstable ? null,
+  impermanence ? null,
+}:
+let
+  lock = builtins.fromJSON (builtins.readFile ../../flake.lock);
+  fetch = locked: builtins.fetchTree ({ type = "github"; } // locked);
+  fromLock = name: fetch lock.nodes.${lock.nodes.root.inputs.${name}}.locked;
+  release = source: {
+    inherit source;
+    lib = (import (source + "/lib")) // {
+      nixosSystem = args: import (source + "/nixos/lib/eval-config.nix") (args // { inherit system; });
+    };
+  };
+  oldMetadata = {
+    owner = "vpsfreecz";
+    repo = "vpsadminos";
+    rev = "1150e37b1cc997b1728f2fda806a3433ef55b798";
+    narHash = "sha256-PdZ1g1KtuxL/3T1E01jKhj3Npmkd4G8EJIzS0OSiaMA=";
+  };
+in
+{
+  releases = {
+    "25.11" =
+      release
+        (fetch {
+          owner = "NixOS";
+          repo = "nixpkgs";
+          rev = "b6018f87da91d19d0ab4cf979885689b469cdd41";
+          narHash = "sha256-twXPFqFsrrY5r28Zh7Homgcp2gUMBgQ6WDS98Q/3xFI=";
+        }).outPath;
+    "26.05" = release (if nixpkgs == null then (fromLock "nixpkgs").outPath else nixpkgs.outPath);
+    unstable = release (
+      if nixpkgsUnstable == null then (fromLock "nixpkgsUnstable").outPath else nixpkgsUnstable.outPath
+    );
+  };
+  impermanenceModule =
+    (if impermanence == null then (fromLock "impermanence").outPath else impermanence.outPath)
+    + "/nixos.nix";
+  oldSource = (fetch oldMetadata).outPath;
+  inherit oldMetadata;
+}
diff --git a/tests/fixtures/nixos-persistence-guests.nix b/tests/fixtures/nixos-persistence-guests.nix
new file mode 100644
index 000000000..163b08ac4
--- /dev/null
+++ b/tests/fixtures/nixos-persistence-guests.nix
@@ -0,0 +1,192 @@
+# Prepared generations share every definition/input at the old-to-new boundary.
+{ system, source }:
+let
+  fixtures = import ./nixos-container-persistence.nix { inherit system; };
+  rawPath =
+    release:
+    if release == "unstable" then "unstable/vpsadminos.nix" else "stable/vpsadminos-${release}.nix";
+  definitions =
+    release: layout: challenge: failure:
+    {
+      lib,
+      pkgs,
+      modulesPath,
+      ...
+    }:
+    {
+      imports = [
+        (modulesPath + "/virtualisation/container-config.nix")
+        fixtures.impermanenceModule
+      ];
+      system.stateVersion = "22.11";
+      networking.hostName = "persistence-fixture";
+      networking.firewall.enable = false;
+      systemd.sysusers.enable = false;
+      services.userborn.enable = false;
+      nix.settings.experimental-features = [
+        "nix-command"
+        "flakes"
+      ];
+      environment.systemPackages = [
+        pkgs.jq
+        pkgs.util-linux
+      ];
+      users.groups.preservation-test = { };
+      users.users.preservation-test = {
+        isSystemUser = true;
+        group = "preservation-test";
+      };
+      users.groups.a-preservation-test = lib.mkIf challenge { };
+      users.users.a-preservation-test = lib.mkIf challenge {
+        isSystemUser = true;
+        group = "a-preservation-test";
+      };
+      environment.persistence.${
+        if layout == "root" then
+          "/root-storage"
+        else if layout == "declared" then
+          "/guest-backing"
+        else
+          "/persistent"
+      } =
+        {
+          hideMounts = true;
+          directories = [
+            {
+              directory = "/var/lib/nixos";
+              mode = "0710";
+            }
+            "/var/log"
+            {
+              directory = "/var/lib/preservation-test";
+              user = "preservation-test";
+              group = "preservation-test";
+              mode = "0750";
+            }
+          ];
+          files = [ "/etc/machine-id" ];
+        };
+      fileSystems = lib.mkMerge [
+        (lib.mkIf (layout == "declared") {
+          "/guest-backing" = {
+            device = "/persistent/backing";
+            fsType = "none";
+            options = [
+              "bind"
+              "x-gvfs-hide"
+            ];
+            neededForBoot = true;
+          };
+        })
+        (lib.mkIf (failure == "missing" || failure == "wrong-backing") {
+          "/required-storage" = {
+            device = "/persistent/required";
+            fsType = "none";
+            options = [ "bind" ];
+            neededForBoot = true;
+          };
+        })
+      ];
+      systemd.mounts = lib.mkMerge [
+        (lib.mkIf (layout == "dependent") [
+          {
+            what = "/var/lib/nixos/usr";
+            where = "/usr";
+            type = "none";
+            options = "bind,x-gvfs-hide";
+          }
+        ])
+        (lib.mkIf (failure != null) (
+          lib.mkForce [
+            {
+              what =
+                if failure == "missing" || failure == "wrong-backing" then
+                  "/required-storage/absent-state"
+                else
+                  "/persistent/var/lib/nixos";
+              where = "/var/lib/nixos";
+              type = "none";
+              # MS_BIND|MS_REMOUNT requires a live mount. The negative test unmounts
+              # this target in a private namespace, giving a real deterministic error.
+              options = if failure == "bind" then "bind,remount" else "bind,x-gvfs-hide";
+            }
+          ]
+        ))
+      ];
+    };
+  make =
+    release: layout: base: challenge: failure:
+    (fixtures.releases.${release}.lib.nixosSystem {
+      inherit system;
+      modules = [
+        (import (base + "/os/lib/nixos-container/${rawPath release}"))
+        (definitions release layout challenge failure)
+      ];
+    }).config.system.build.toplevel;
+  expectedRelease = release: fixtures.releases.${release}.lib.trivial.release;
+  generations = release: layout: {
+    oldInitial = make release layout fixtures.oldSource false null;
+    oldChallenge = make release layout fixtures.oldSource true null;
+    newInitial = make release layout source false null;
+    newChallenge = make release layout source true null;
+  };
