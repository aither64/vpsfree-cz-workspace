             expect(exec_guest.call('nixos-version')).to start_with('${guests.expectedRelease variant.release}')
             exec_guest.call('nix-store --load-db < ${registration}/registration')
             ${lib.optionalString (variant.layout != "fresh") ''
@@ -152,7 +182,7 @@ import ../../make-test.nix (
