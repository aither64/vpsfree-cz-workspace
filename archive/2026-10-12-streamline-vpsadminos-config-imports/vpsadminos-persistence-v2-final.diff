diff --git a/tests/nixos-container-eval.sh b/tests/nixos-container-eval.sh
new file mode 100644
index 000000000..943206f95
--- /dev/null
+++ b/tests/nixos-container-eval.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "${BASH_SOURCE[0]}")/.."
+
+nix eval --impure --json --file tests/nixos-container-modules-eval.nix
+nix eval --impure --json --file tests/nixos-container-templates-eval.nix
+nix eval --impure --json --file tests/nixos-container-standalone-eval.nix
+nix eval --impure --json --file tests/nixos-container-persistence-eval.nix
+
+error_log=$(mktemp)
+activation_snippet=$(mktemp)
+trap 'rm -f "$error_log" "$activation_snippet"' EXIT
+nix eval --impure --raw --file tests/nixos-container-persistence-eval.nix \
+  --apply 'checks: checks.shellFixture' > "$activation_snippet"
+bash tests/nixos-container-persistence-shell.sh "$activation_snippet"
+for release in 21.11 99.99 26_05 unstable ''; do
+  if nix eval --impure --json --file tests/nixos-container-unsupported-eval.nix \
+    --apply "select: select \"$release\"" 2>"$error_log"; then
+    echo "Unsupported release $release unexpectedly succeeded" >&2
+    exit 1
+  fi
+  error_text=$(cat "$error_log")
+  for expected in \
+    "unsupported stable NixOS release '$release'" \
+    'Known stable releases: 22.11, 23.05, 23.11, 24.05, 24.11, 25.05, 25.11, 26.05' \
+    'Update the vpsadminos input' \
+    'nixosModules.containerUnstable'; do
+    if [[ "$error_text" != *"$expected"* ]]; then
+      cat "$error_log" >&2
+      echo "Missing unsupported-release guidance: $expected" >&2
+      exit 1
+    fi
+  done
+done
diff --git a/tests/nixos-container-modules-eval.nix b/tests/nixos-container-modules-eval.nix
new file mode 100644
index 000000000..6f96a7e33
--- /dev/null
+++ b/tests/nixos-container-modules-eval.nix
@@ -0,0 +1,192 @@
+# Run with nix eval --impure --json --file tests/nixos-container-modules-eval.nix.
+# Historical inputs use real option declarations, not a modern lib with a
+# substituted release string. Fetch failures are distinct from assertion errors.
+let
+  vpsadminos = builtins.getFlake (toString ../.);
+  lib = vpsadminos.inputs.nixpkgs.lib;
+  fixtures = import ./fixtures/nixos-container-releases.nix { inherit vpsadminos; };
+  modules = vpsadminos.nixosModules;
+  releases = [
+    "22.11"
+    "23.05"
+    "23.11"
+    "24.05"
+    "24.11"
+    "25.05"
+    "25.11"
+    "26.05"
+  ];
+  alias = release: "container_${lib.replaceStrings [ "." ] [ "_" ] release}";
+  nameservers = [
+    "1.1.1.1"
+    "2606:4700:4700::1111"
+  ];
+  check = name: condition: if condition then true else throw "NixOS container check failed: ${name}";
+
+  # Exercise every selector leaf without pretending these are historical NixOS
+  # evaluations. The real release evaluations below verify option compatibility.
+  moduleArgs = {
+    inherit lib;
+    config = {
+      fileSystems = { };
+      systemd.mounts = [ ];
+      systemd.sysusers.enable = false;
+      services.userborn.enable = false;
+    };
+    options.boot.specialFileSystems.type.getSubOptions = _: { };
+    utils = {
+      fsNeededForBoot = _: false;
+      pathsNeededForBoot = [ ];
+    };
+    pkgs = {
+      iproute2 = "/iproute2";
+      bash = "/bash";
+    };
+  };
+  moduleValue = module: builtins.toJSON (module moduleArgs);
+  selectedValue =
+    selector: release:
+    moduleValue (
+      builtins.head
+        (selector {
+          lib = lib // {
+            trivial = lib.trivial // {
+              inherit release;
+              version = "${release}pre-git";
+            };
+          };
+        }).imports
+    );
+  unknownReleases = [
+    "21.11"
+    "99.99"
+    "26_05"
+    "unstable"
+    ""
+  ];
+
+  evaluate =
+    nixpkgs: module:
+    nixpkgs.lib.nixosSystem {
+      system = "x86_64-linux";
+      modules = [
+        module
+        { system.stateVersion = "22.11"; }
+      ];
+    };
+  configuration =
+    evaluated:
+    let
+      c = evaluated.config;
+    in
+    {
+      release = c.system.nixos.release;
+      stateVersion = c.system.stateVersion;
+      isContainer = c.boot.isContainer;
+      initScript = c.boot.loader.initScript.enable;
+      nameservers = c.networking.nameservers;
+      resolved =
+        if lib.versionAtLeast c.system.nixos.release "26.05" then
+          c.services.resolved.settings.Resolve.FallbackDNS
+        else
+          c.services.resolved.fallbackDns;
+      networkingSetup = c.systemd.services.networking-setup.serviceConfig.ExecStart;
+      oomd = c.systemd.services.systemd-oomd.enable;
+      audit = c.systemd.sockets.systemd-journald-audit.enable;
+      runKeys = c.boot.specialFileSystems."/run/keys".fsType;
+      toplevel = c.system.build.toplevel.drvPath;
+    };
+  # This exact import is reused for each guest release, with stateVersion fixed.
+  stableImport = modules.containerStable;
+  realReleaseCheck =
+    release: nixpkgs:
+    let
+      explicit = configuration (evaluate nixpkgs modules.containers.${release});
+      automatic = configuration (evaluate nixpkgs stableImport);
+      generic = configuration (evaluate nixpkgs modules.container);
+      underscore = configuration (evaluate nixpkgs modules.${alias release});
+    in
+    check "real ${release} guest and unchanged stable import" (
+      nixpkgs.lib.trivial.release == release
+      && automatic == explicit
+      && generic == explicit
+      && underscore == explicit
+      && automatic.release == release
+      && automatic.stateVersion == "22.11"
+      && automatic.isContainer
+      && automatic.initScript
+      && automatic.nameservers == nameservers
+      && automatic.resolved == nameservers
+      && !automatic.oomd
+      && !automatic.audit
+      && automatic.runKeys == "tmpfs"
+    );
+  stable = fixtures."26.05";
+  unstable = fixtures.unstable;
+  rawStable = import ../os/lib/nixos-container/stable/vpsadminos.nix;
+  rawUnstable = import ../os/lib/nixos-container/unstable/vpsadminos.nix;
+in
+{
+  exports = check "exact grouped keys, derived aliases, and no containerAuto" (
+    builtins.attrNames modules.containers == releases
+    && !(modules ? containerAuto)
+    && lib.all (release: modules ? ${alias release}) releases
+  );
+  selectorMatrix = builtins.listToAttrs (
+    map (
+      release:
+      let
+        original = moduleValue (import (../os/lib/nixos-container/stable + "/vpsadminos-${release}.nix"));
+      in
+      {
+        name = release;
+        value = check "selector and aliases for ${release}" (
+          moduleValue modules.containers.${release} == original
+          && selectedValue modules.containerStable release == original
+          && selectedValue modules.container release == original
+          && moduleValue modules.${alias release} == original
+        );
+      }
+    ) releases
+  );
+  unsupported = check "unknown releases fail during import selection" (
+    lib.all (
+      release:
+      !(builtins.tryEval (
+        builtins.deepSeq
+          (modules.containerStable {
+            lib = lib // {
+              trivial = lib.trivial // {
+                inherit release;
+              };
+            };
+          }).imports
+          true
+      )).success
+    ) unknownReleases
+  );
+  realReleases = lib.genAttrs [ "24.11" "25.11" "26.05" ] (
+    release: realReleaseCheck release fixtures.${release}
+  );
+  guestLibrary = check "24.11 guest is distinct from captured 26.05 input" (
+    lib.trivial.release == "26.05" && fixtures."24.11".lib.trivial.release == "24.11"
+  );
+  legacy = check "legacy latest stable and unstable exports retain raw behavior" (
+    configuration (evaluate stable vpsadminos.nixosConfigurations.container)
+    == configuration (evaluate stable rawStable)
+    &&
+      configuration (evaluate stable vpsadminos.nixosConfigurations.containerStable)
+      == configuration (evaluate stable rawStable)
+    &&
+      configuration (evaluate unstable vpsadminos.nixosConfigurations.containerUnstable)
+      == configuration (evaluate unstable rawUnstable)
+    &&
+      configuration (evaluate unstable modules.containerUnstable)
+      == configuration (evaluate unstable rawUnstable)
+  );
+  # Literal quoted and guest-nixpkgs interpolated lookups must both import a leaf.
+  groupedSyntax = check "quoted and interpolated release keys" (
+    configuration (evaluate stable modules.containers."26.05")
+    == configuration (evaluate stable modules.containers.${stable.lib.trivial.release})
+  );
+}
diff --git a/tests/nixos-container-persistence-eval.nix b/tests/nixos-container-persistence-eval.nix
new file mode 100644
index 000000000..b3adad2f3
--- /dev/null
+++ b/tests/nixos-container-persistence-eval.nix
@@ -0,0 +1,239 @@
+# Evaluate generated activation text without building or mounting anything.
+let
+  vpsadminos = builtins.getFlake (toString ../.);
+  fixtures = import ./fixtures/nixos-container-releases.nix { inherit vpsadminos; };
+  lib = vpsadminos.inputs.nixpkgs.lib;
+  baselineDirectory = builtins.getEnv "VPSADMINOS_PERSISTENCE_BASELINE";
+  rawPath =
+    release:
+    if release == "unstable" then "unstable/vpsadminos.nix" else "stable/vpsadminos-${release}.nix";
+  raw = release: import (../os/lib/nixos-container + "/${rawPath release}");
+  persistence = {
+    imports = [ vpsadminos.inputs.impermanence.nixosModules.impermanence ];
+    environment.persistence."/persistent" = {
+      hideMounts = true;
+      directories = [
+        "/var/lib/nixos"
+        "/var/log"
+      ];
+    };
+  };
+  evaluate =
+    release: module: extra:
+    (fixtures.${release}.lib.nixosSystem {
+      system = "x86_64-linux";
+      modules = [
+        module
+        {
+          system.stateVersion = "22.11";
+          fileSystems."/" = {
+            device = "none";
+            fsType = "tmpfs";
+          };
+        }
+      ]
+      ++ extra;
+    }).config;
+  check = label: condition: if condition then true else throw "Persistence check failed: ${label}";
+  contains = needle: text: lib.hasInfix (builtins.unsafeDiscardStringContext needle) text;
+  matches = needle: text: lib.filter (contains needle) (lib.splitString "\n" text);
+  position =
+    needle: text:
+    let
+      lines = lib.splitString "\n" text;
+      numbered = lib.imap0 (index: line: { inherit index line; }) lines;
+    in
+    (lib.findFirst (entry: contains needle entry.line) { index = -1; } numbered).index;
+  forceScript = c: builtins.deepSeq c.system.activationScripts.script true;
+  failed = c: !(builtins.tryEval (forceScript c)).success;
+  manualBind = source: target: {
+    what = source;
+    where = target;
+    type = "none";
+    options = "bind,x-gvfs-hide";
+  };
+  script = c: c.system.activationScripts.script;
+  checkRelease =
+    release:
+    let
+      ordinary = evaluate release (raw release) [ ];
+      persisted = evaluate release (raw release) [ persistence ];
+      standaloneFile = builtins.toFile "vpsadminos-persistence-${release}.nix" (
+        builtins.readFile (../os/lib/nixos-container + "/${rawPath release}")
+      );
+      standalone = evaluate release (import standaloneFile) [ persistence ];
+      current = script persisted;
+      upstreamSource = "source ${persisted.system.build.earlyMountScript}";
+      step = "#### Activation script snippet vpsadminosPersistedState:";
+      alternative =
+        backend:
+        evaluate release (raw release) [
+          persistence
+          {
+            systemd.sysusers.enable = backend == "sysusers";
+            services.userborn.enable = backend == "userborn";
+          }
+        ];
+      baseline = extra: evaluate release (import (baselineDirectory + "/${rawPath release}")) extra;
+      ancestry = evaluate release (raw release) [
+        {
+          systemd.mounts = [
+            (manualBind "/persistent/state" "/var/lib/nixos")
+            (manualBind "/var/lib/nixos/log" "/var/log")
+          ];
+        }
+      ];
+      crossPhase = evaluate release (raw release) [
+        {
+          systemd.mounts = [
+            (manualBind "/persistent/state" "/var/lib/nixos")
+            (manualBind "/var/lib/nixos/store" "/nix")
+          ];
+        }
+      ];
+      cycle = evaluate release (raw release) [
+        {
+          systemd.mounts = [
+            (manualBind "/var/log/state" "/var/lib/nixos")
+            (manualBind "/var/lib/nixos/log" "/var/log")
+          ];
+        }
+      ];
+      duplicate = evaluate release (raw release) [
+        persistence
+        {
+          boot.specialFileSystems."/var/lib/nixos" = {
+            device = "/another/state";
+            fsType = "none";
+            options = [ "bind" ];
+          };
+        }
+      ];
+      relative = evaluate release (raw release) [
+        {
+          systemd.mounts = [ (manualBind "relative/state" "/var/lib/nixos") ];
+        }
+      ];
+      direct = evaluate release (raw release) [
+        {
+          fileSystems."/var/log" = {
+            device = "/direct/log";
+            fsType = "none";
+            options = [ "bind" ];
+          };
+        }
+      ];
+    in
+    {
+      actualRelease = persisted.system.nixos.release;
+      legacyOrder = check "${release} specialfs -> persisted state -> users" (
+        position upstreamSource current >= 0
+        && position step current >= 0
+        && position "-update-users-groups.pl" current >= 0
+        && position upstreamSource current < position step current
+        && position step current < position "-update-users-groups.pl" current
+        && persisted.system.activationScripts.vpsadminosPersistedState.deps == [ "specialfs" ]
+        && builtins.elem "vpsadminosPersistedState" persisted.system.activationScripts.users.deps
+        && builtins.length (matches "specialMount()" current) == 1
+        && builtins.length (matches upstreamSource current) == 1
+      );
+      preservedUnits = check "${release} bindings and options remain in systemd units" (
+        lib.all
+          (target: lib.any (m: m.where == target && m.options == "bind,x-gvfs-hide") persisted.systemd.mounts)
+          [
+            "/var/lib/nixos"
+            "/var/log"
+          ]
+        && !(persisted.boot.specialFileSystems ? "/var/lib/nixos")
+        && !(persisted.boot.specialFileSystems ? "/var/log")
+      );
+      standalone = check "${release} copied raw file retains complete activation behavior" (
+        script standalone == current
+      );
+      dry = check "${release} dry activation has no preparation or mount work" (
+        !contains "vpsadminosMountPersistedState" persisted.system.dryActivationScript
+        && !contains "mount -t" persisted.system.dryActivationScript
+        && contains "-update-users-groups.pl" persisted.system.dryActivationScript
+      );
+      ordinary = check "${release} no selected bindings" (
+        !(ordinary.system.activationScripts ? vpsadminosPersistedState)
+        && !builtins.elem "vpsadminosPersistedState" ordinary.system.activationScripts.users.deps
+        && forceScript ordinary
+      );
+      ancestry =
+        let
+          statePosition = position (lib.escapeShellArgs [
+            "/persistent/state"
+            "/var/lib/nixos"
+          ]) (script ancestry);
+          logPosition = position (lib.escapeShellArgs [
+            "/var/lib/nixos/log"
+            "/var/log"
+          ]) (script ancestry);
+        in
+        check "${release} selected source ancestry determines order" (
+          statePosition >= 0 && logPosition >= 0 && statePosition < logPosition
+        );
+      topology = check "${release} generated scripts force topology errors" (
+        failed crossPhase && failed cycle && failed duplicate && failed relative
+      );
+      directFilesystem = check "${release} direct filesystem definitions stay upstream" (
+        !(direct.system.activationScripts ? vpsadminosPersistedState)
+        && direct.boot.specialFileSystems."/var/log".device == "/direct/log"
+        && forceScript direct
+      );
+      alternatives = lib.genAttrs [ "sysusers" "userborn" ] (
+        backend:
+        let
+          c = alternative backend;
+        in
+        check "${release} ${backend} retains original promotion and users shape" (
+          !(c.system.activationScripts ? vpsadminosPersistedState)
+          && c.system.activationScripts.users == ""
+          && c.boot.specialFileSystems."/var/lib/nixos".device == "/persistent/var/lib/nixos"
+          && c.boot.specialFileSystems."/var/log".device == "/persistent/var/log"
+          && forceScript c
+        )
+      );
+      priorV2 =
+        if baselineDirectory == "" then
+          "not requested"
+        else
+          check "${release} ordinary and alternate scripts exactly match prior v2" (
+            script ordinary == script (baseline [ ])
+            && ordinary.system.dryActivationScript == (baseline [ ]).system.dryActivationScript
+            &&
+              lib.all
+                (
+                  backend:
+                  let
+                    old = baseline [
+                      persistence
+                      {
+                        systemd.sysusers.enable = backend == "sysusers";
+                        services.userborn.enable = backend == "userborn";
+                      }
+                    ];
+                    c = alternative backend;
+                  in
+                  script c == script old && c.system.dryActivationScript == old.system.dryActivationScript
+                )
+                [
+                  "sysusers"
+                  "userborn"
+                ]
+          );
+    };
+in
+{
+  releases = lib.genAttrs [ "25.11" "26.05" "unstable" ] checkRelease;
+  latestStable = check "latest stable is self-contained and equivalent to 26.05" (
+    builtins.readFile ../os/lib/nixos-container/stable/vpsadminos.nix
+    == builtins.readFile ../os/lib/nixos-container/stable/vpsadminos-26.05.nix
+  );
+  # The shell harness reads this actual generated snippet and substitutes only
+  # its configured source/destination arguments with temporary fixture paths.
+  shellFixture =
+    (evaluate "26.05" (raw "26.05") [ persistence ])
+    .system.activationScripts.vpsadminosPersistedState.text;
+}
diff --git a/tests/nixos-container-persistence-shell.sh b/tests/nixos-container-persistence-shell.sh
new file mode 100644
index 000000000..41d866c4a
--- /dev/null
+++ b/tests/nixos-container-persistence-shell.sh
@@ -0,0 +1,124 @@
+#!/usr/bin/env bash
+# Command doubles exercise the actual generated activation snippet. No mounts
+# or account operations are performed; all filesystem changes stay in fixtures.
+set -euo pipefail
+snippet=$1
+fixture_root=$(mktemp -d)
+trap 'rm -rf "$fixture_root"' EXIT
+
+for scenario in fresh existing_metadata missing_backing root_backing failed_bind matching_live wrong_live failed_lookup failed_mount_lookup wrong_result source_file; do
+  case_root="$fixture_root/$scenario"
+  backing="$case_root/backing storage"
+  source="$backing/state"
+  target="$case_root/state target"
+  log_source="$backing/log"
+  log_target="$case_root/log target"
+  mkdir -p "$backing"
+  before_metadata=
+  case "$scenario" in
+    existing_metadata)
+      mkdir "$source"
+      chmod 0710 "$source"
+      printf 'existing data\n' > "$source/payload"
+      before_metadata=$(stat -c '%u:%g:%a:%i' "$source")
+      ;;
+    matching_live)
+      mkdir "$source"
+      ln -s "$source" "$target"
+      touch "$case_root/mounted-state"
+      ;;
+    wrong_live)
+      mkdir "$case_root/wrong"
+      ln -s "$case_root/wrong" "$target"
+      touch "$case_root/mounted-state"
+      ;;
+    missing_backing) rmdir "$backing" ;;
+    source_file) touch "$source" ;;
+    failed_mount_lookup) mkdir "$target" ;;
+  esac
+
+  # Replace only the configured call arguments, including paths with spaces.
+  sed \
+    -e "s|/persistent/var/lib/nixos|'$source'|g" \
+    -e "s|/persistent/var/log|'$log_source'|g" \
+    -e "s|/var/lib/nixos|'$target'|g" \
+    -e "s|/var/log|'$log_target'|g" \
+    "$snippet" > "$case_root/activation.sh"
+  bash -n "$case_root/activation.sh"
+
+  # Run in a child shell so the actual explicit exit can prevent the allocator
+  # marker, even with NixOS's non-fatal ERR trap and conditional helper calls.
+  set +e
+  (
+    set +e
+    umask 0022
+    _status=0
+    trap '_status=1' ERR
+    findmnt() {
+      local path="${*: -1}"
+      [ "$scenario" != failed_lookup ] || return 1
+      if [ "$path" = / ] || [ "$scenario" = root_backing ] || [ "$scenario" = missing_backing ]; then
+        printf '1\n'
+      else
+        printf '42\n'
+      fi
+    }
+    mountpoint() {
+      local path="${*: -1}"
+      [ "$scenario" != failed_mount_lookup ] || return 1
+      if [ "$path" = "$case_root/state target" ]; then
+        test -f "$case_root/mounted-state" || return 32
+      else
+        test -f "$case_root/mounted-log" || return 32
+      fi
+    }
+    mount() {
+      printf '%s\n' "$*" >> "$case_root/mount-calls"
+      [ "$scenario" != failed_bind ] || return 1
+      local from="${*: -2:1}" to="${*: -1}" options="$4"
+      if [[ "$options" != remount,* ]]; then
+        rmdir "$to" || return 1
+        if [ "$scenario" = wrong_result ]; then
+          ln -s "$case_root/backing storage" "$to" || return 1
+        else
+          ln -s "$from" "$to" || return 1
+        fi
+        if [ "$to" = "$case_root/state target" ]; then touch "$case_root/mounted-state"; else touch "$case_root/mounted-log"; fi
+      fi
+    }
+    . "$case_root/activation.sh"
+    touch "$case_root/allocator-reached"
+  ) > "$case_root/output" 2>&1
+  status=$?
+  set -e
+  case "$scenario" in
+    fresh|existing_metadata|matching_live)
+      [ "$status" = 0 ] && [ -f "$case_root/allocator-reached" ] || { cat "$case_root/output"; exit 1; }
+      [ "$source" -ef "$target" ] && [ "$log_source" -ef "$log_target" ]
+      [ "$(wc -l < "$case_root/mount-calls")" = 2 ]
+      if [ "$scenario" = matching_live ]; then
+        [[ "$(head -n 1 "$case_root/mount-calls")" == *'remount,bind,x-gvfs-hide'* ]]
+      else
+        [[ "$(head -n 1 "$case_root/mount-calls")" == *'-o bind,x-gvfs-hide'* ]]
+      fi
+      ;;
+    *)
+      [ "$status" != 0 ] && [ ! -f "$case_root/allocator-reached" ] || { cat "$case_root/output"; exit 1; }
+      case "$scenario" in
+        wrong_live|missing_backing|root_backing|failed_lookup|failed_mount_lookup|source_file) [ ! -f "$case_root/mount-calls" ] ;;
+      esac
+      ;;
+  esac
+  if [ "$scenario" = existing_metadata ]; then
+    [ "$before_metadata" = "$(stat -c '%u:%g:%a:%i' "$source")" ]
+    [ "$(cat "$source/payload")" = 'existing data' ]
+  fi
+  if [ "$scenario" = fresh ]; then
+    [ "$(stat -c '%a' "$source")" = 755 ]
+  fi
+  if [ "$scenario" = wrong_live ]; then
+    [ ! -e "$source" ]
+    [ "$target" -ef "$case_root/wrong" ]
+  fi
+  printf 'PASS %s\n' "$scenario"
+done
