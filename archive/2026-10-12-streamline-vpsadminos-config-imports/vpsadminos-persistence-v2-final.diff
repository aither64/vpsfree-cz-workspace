diff --git a/os/lib/nixos-container/stable/vpsadminos-25.11.nix b/os/lib/nixos-container/stable/vpsadminos-25.11.nix
index 85e0f0f22..0d75d64ab 100644
--- a/os/lib/nixos-container/stable/vpsadminos-25.11.nix
+++ b/os/lib/nixos-container/stable/vpsadminos-25.11.nix
@@ -21,6 +21,121 @@ let
     mkForce
     ;
 
+  legacyUsers = !config.systemd.sysusers.enable && !config.services.userborn.enable;
+  bootSpecialFileSystemOpts = options.boot.specialFileSystems.type.getSubOptions { };
+  bootNeededFileSystems = lib.pipe config.fileSystems [
+    (lib.filterAttrs (_: v: utils.fsNeededForBoot v))
+    (builtins.mapAttrs (
+      path: v:
+      lib.warnIf (v.autoFormat || v.autoResize || v.encrypted.enable || v.overlay.workdir != null)
+        "fileSystems.${path} has options set that are not supported by boot.specialFileSystems."
+        (lib.intersectAttrs bootSpecialFileSystemOpts v)
+    ))
+  ];
+  bootNeededBindMounts = lib.filter (
+    mount:
+    (mount.enable or true)
+    && mount ? where
+    && mount ? what
+    && (mount.type or null) == "none"
+    && builtins.elem "bind" (lib.splitString "," (mount.options or ""))
+    && builtins.elem mount.where utils.pathsNeededForBoot
+  ) config.systemd.mounts;
+  isPersistedState =
+    mount:
+    legacyUsers
+    && builtins.elem mount.where [
+      "/var/lib/nixos"
+      "/var/log"
+    ];
+  persistedStateMounts = map (mount: {
+    device = mount.what;
+    mountPoint = mount.where;
+    options = lib.splitString "," (mount.options or "");
+    depends = [ ];
+  }) (lib.filter isPersistedState bootNeededBindMounts);
+  persistedStatePaths = map (mount: mount.mountPoint) persistedStateMounts;
+  remainingSpecialMounts = builtins.attrValues config.boot.specialFileSystems;
+  crossPhaseMounts = lib.concatMap (
+    moved:
+    map (remaining: "${moved.mountPoint} -> ${remaining.mountPoint}") (
+      lib.filter (utils.fsBefore moved) remainingSpecialMounts
+    )
+  ) persistedStateMounts;
+  persistedStateOrder = lib.toposort utils.fsBefore persistedStateMounts;
+  orderedPersistedState =
+    if !lib.all (mount: lib.hasPrefix "/" mount.device) persistedStateMounts then
+      throw "vpsAdminOS persisted state binds require absolute directory sources."
+    else if builtins.length persistedStatePaths != builtins.length (lib.unique persistedStatePaths) then
+      throw "vpsAdminOS persisted state binds have duplicate destinations: ${lib.concatStringsSep ", " persistedStatePaths}"
+    else if
+      lib.any (path: builtins.hasAttr path config.boot.specialFileSystems) persistedStatePaths
+    then
+      throw "vpsAdminOS persisted state binds also have a special filesystem definition; remove the duplicate definition for ${lib.concatStringsSep ", " persistedStatePaths}."
+    else if crossPhaseMounts != [ ] then
+      throw "vpsAdminOS cannot mount persisted state after specialfs: ${lib.concatStringsSep ", " crossPhaseMounts}. Remove the dependency on a moved state bind."
+    else if !(persistedStateOrder ? result) then
+      throw "vpsAdminOS persisted state bind dependency cycle: ${lib.concatStringsSep ", " persistedStatePaths}"
+    else
+      persistedStateOrder.result;
+
+  persistedStateScript = ''
+    # Abort in the activation shell: its ERR trap alone permits later users.
+    vpsadminosMountPersistedState() {
+      local source="$1" target="$2" options="$3" ancestor="$1" backing rootBacking sourceBacking mountStatus mounted=false
+      while [ ! -e "$ancestor" ]; do
+        ancestor=$(dirname -- "$ancestor") || return 1
+      done
+      [ -d "$ancestor" ] || { printf 'vpsAdminOS: state source ancestor is not a directory: %s\n' "$ancestor" >&2; return 1; }
+      backing=$(findmnt --noheadings --output ID --target "$ancestor") || return 1
+      rootBacking=$(findmnt --noheadings --output ID --target /) || return 1
+      [ -n "$backing" ] && [ -n "$rootBacking" ] && [ "$backing" != "$rootBacking" ] || {
+        printf 'vpsAdminOS: state source requires an available non-root backing mount: %s\n' "$source" >&2
+        return 1
+      }
+      if [ -e "$target" ]; then
+        if mountpoint -q -- "$target"; then
+          mounted=true
+          [ "$source" -ef "$target" ] || {
+            printf 'vpsAdminOS: state destination has a different mounted source: %s\n' "$target" >&2
+            return 1
+          }
+        else
+          mountStatus=$?
+          # util-linux returns 32 for a directory that is not a mountpoint.
+          [ "$mountStatus" -eq 32 ] || return 1
+        fi
+      fi
+      # mkdir -p leaves existing parents and their metadata untouched.
+      if [ ! -d "$source" ]; then
+        mkdir -p -m 0755 -- "$source" || return 1
