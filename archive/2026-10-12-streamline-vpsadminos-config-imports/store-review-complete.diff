index 000000000..0fa80a1bc
--- /dev/null
+++ b/tests/nixos-container-persistence-check.nix
@@ -0,0 +1,50 @@
+{
+  pkgs,
+  source,
+  system,
+  nixpkgs,
+  nixpkgsUnstable,
+  impermanence,
+}:
+let
+  fixtures = import ./fixtures/nixos-container-persistence.nix {
+    inherit
+      system
+      nixpkgs
+      nixpkgsUnstable
+      impermanence
+      ;
+  };
+  evaluation = import ./nixos-container-persistence-eval.nix {
+    inherit source system;
+    inherit (pkgs) lib;
+    inherit (fixtures) oldSource impermanenceModule;
+    fixtures = fixtures.releases;
+  };
+  shellFixtures = pkgs.lib.mapAttrs (name: fixture: {
+    snippet = pkgs.writeText "persistent-specialfs-${name}.sh" fixture.snippet;
+    inherit (fixture) earlyMountScript;
+  }) evaluation.shellFixtures;
+in
+builtins.deepSeq evaluation.assertions (
+  pkgs.runCommand "nixos-container-persistence"
+    {
+      nativeBuildInputs = [
+        pkgs.bash
+        pkgs.coreutils
+        pkgs.util-linux
+        pkgs.gnused
+        pkgs.gawk
+      ];
+      passthru = { inherit evaluation shellFixtures; };
+    }
+    ''
+      ${pkgs.lib.concatMapStringsSep "\n" (name: ''
+        bash ${./nixos-container-persistence-shell.sh} ${shellFixtures.${name}.snippet} ${
+          shellFixtures.${name}.earlyMountScript
+        } ${name}
+      '') (builtins.attrNames shellFixtures)}
+      mkdir "$out"
+      cp ${pkgs.writeText "persistence-evaluation.json" (builtins.toJSON evaluation.assertions)} "$out/evaluation.json"
+    ''
+)
diff --git a/tests/nixos-container-persistence-eval.nix b/tests/nixos-container-persistence-eval.nix
new file mode 100644
index 000000000..0cd99f9c1
--- /dev/null
+++ b/tests/nixos-container-persistence-eval.nix
@@ -0,0 +1,314 @@
+# Explicit inputs keep this evaluator usable in normal pure flake checks.
+{
+  source,
+  fixtures,
+  oldSource,
+  impermanenceModule,
+  lib,
+  system,
+}:
+let
+  rawPath =
+    release:
+    if release == "unstable" then "unstable/vpsadminos.nix" else "stable/vpsadminos-${release}.nix";
+  raw = base: release: import (base + "/os/lib/nixos-container/${rawPath release}");
+  evaluate =
+    release: module: extra:
+    (fixtures.${release}.lib.nixosSystem {
+      inherit system;
+      modules = [
+        module
+        {
+          system.stateVersion = "22.11";
+          fileSystems."/" = {
+            device = "none";
+            fsType = "tmpfs";
+          };
+        }
+      ]
+      ++ extra;
+    }).config;
+  persistence = {
+    imports = [ impermanenceModule ];
+    environment.persistence."/persistent" = {
+      hideMounts = true;
+      directories = [
+        "/var/lib/nixos"
+        "/var/log"
+      ];
+    };
+  };
+  bind = what: where: {
+    inherit what where;
+    type = "none";
+    options = "bind,x-gvfs-hide";
+  };
+  manual = mounts: { systemd.mounts = mounts; };
+  contains = needle: text: lib.hasInfix (builtins.unsafeDiscardStringContext needle) text;
+  position =
+    needle: text:
+    (lib.findFirst (entry: contains needle entry.line) { index = -1; } (
+      lib.imap0 (index: line: { inherit index line; }) (lib.splitString "\n" text)
+    )).index;
+  count = needle: text: builtins.length (lib.filter (contains needle) (lib.splitString "\n" text));
+  before =
+    first: second: text:
+    position first text >= 0 && position second text >= 0 && position first text < position second text;
+  check = label: condition: if condition then true else throw "Persistence check failed: ${label}";
+  script = c: c.system.activationScripts.script;
+  mounts = c: c.system.build.earlyMountScript.text;
+  force = c: builtins.deepSeq [ (script c) (mounts c) c.system.dryActivationScript ] true;
+  checkRelease =
+    release:
+    let
+      current = extra: evaluate release (raw source release) extra;
+      baseline = extra: evaluate release (raw oldSource release) extra;
+      ordinary = current [ ];
+      persisted = current [ persistence ];
+      copied = builtins.toFile "vpsadminos-persistence-${release}.nix" (
+        builtins.readFile (source + "/os/lib/nixos-container/${rawPath release}")
+      );
+      standalone = evaluate release (import copied) [ persistence ];
+      alternative =
+        base: backend:
+        evaluate release (raw base release) [
+          persistence
+          {
+            systemd.sysusers.enable = backend == "sysusers";
+            services.userborn.enable = backend == "userborn";
+          }
+        ];
+      ancestry = current [
+        (manual [
+          (bind "/persistent/state" "/var/lib/nixos")
+          (bind "/var/lib/nixos/log" "/var/log")
+        ])
+      ];
+      dependent = current [
+        (manual [
+          (bind "/persistent/state" "/var/lib/nixos")
+          (bind "/var/lib/nixos/usr" "/usr")
+        ])
+      ];
+      root = current [ (manual [ (bind "/root-state/nixos" "/var/lib/nixos") ]) ];
+      declared = current [
+        (manual [ (bind "/custom/backing/state" "/var/lib/nixos") ])
+        {
+          fileSystems."/custom/backing" = {
+            device = "/host/custom";
+            fsType = "none";
+            options = [ "bind" ];
+            neededForBoot = true;
+          };
+        }
+      ];
+      nearPrefix = current [
+        (manual [ (bind "/custom/backing-other/state" "/var/lib/nixos") ])
+        {
+          fileSystems."/custom/backing" = {
+            device = "/host/custom";
+            fsType = "none";
+            options = [ "bind" ];
+            neededForBoot = true;
+          };
+        }
+      ];
+      nonBind = current [
+        (manual [ (bind "/custom/backing/state" "/var/lib/nixos") ])
+        {
+          fileSystems."/custom/backing" = {
+            device = "tmpfs";
+            fsType = "tmpfs";
+            neededForBoot = true;
+          };
+        }
+      ];
+      cycle = current [
+        (manual [
+          (bind "/var/log/state" "/var/lib/nixos")
+          (bind "/var/lib/nixos/log" "/var/log")
+        ])
+      ];
+      # The upstream builder selects .result directly, so a deliberate cycle
+      # produces a hard missing-attribute error that tryEval cannot catch.
+      # Inspect the same pinned upstream topology without building its script.
+      cycleUtils = import (fixtures.${release}.source + "/nixos/lib/utils.nix") {
+        config = cycle;
+        lib = fixtures.${release}.lib;
+        pkgs = import fixtures.${release}.source { inherit system; };
+      };
+      cycleOrder = fixtures.${release}.lib.toposort cycleUtils.fsBefore (
+        builtins.attrValues cycle.boot.specialFileSystems
+      );
+      forced = current [
+        persistence
+        { system.activationScripts.specialfs = lib.mkForce "guest-specialfs"; }
+      ];
+      direct = current [
+        {
+          fileSystems."/var/log" = {
+            device = "/direct/log";
+            fsType = "none";
+            options = [ "bind" ];
+          };
+        }
+      ];
+      old = baseline [ persistence ];
+      upstreamSource = "source ${persisted.system.build.earlyMountScript}";
+    in
+    {
+      actualRelease = persisted.system.nixos.release;
+      legacyOrder = check "${release} global specialfs before real allocator" (
+        before upstreamSource "-update-users-groups.pl" (script persisted)
+        && builtins.elem "specialfs" persisted.system.activationScripts.users.deps
+        && count upstreamSource (script persisted) == 1
+        && count "specialMount()" (script persisted) == 1
+        && force persisted
+      );
+      promotion = check "${release} complete promotion and units/options" (
+        mounts persisted == mounts old
+        &&
+          lib.all
+            (
+              target:
+              persisted.boot.specialFileSystems.${target}.options == [
+                "bind"
+                "x-gvfs-hide"
+              ]
+              && lib.any (m: m.where == target && m.options == "bind,x-gvfs-hide") persisted.systemd.mounts
+            )
+            [
+              "/var/lib/nixos"
+              "/var/log"
+            ]
+      );
+      standalone = check "${release} copied self-contained file" (script standalone == script persisted);
+      dry = check "${release} dry omits mounts and prep" (
+        !contains "vpsadminosPrepareStateDirectory" persisted.system.dryActivationScript
+        && !contains upstreamSource persisted.system.dryActivationScript
+        && contains "-update-users-groups.pl" persisted.system.dryActivationScript
+      );
+      ordinary = check "${release} ordinary exact baseline equivalence" (
+        script ordinary == script (baseline [ ])
+        && ordinary.system.dryActivationScript == (baseline [ ]).system.dryActivationScript
+        && force ordinary
+      );
+      alternatives = lib.genAttrs [ "sysusers" "userborn" ] (
+        backend:
+        let
+          c = alternative source backend;
+          b = alternative oldSource backend;
+        in
+        check "${release} ${backend} exact baseline equivalence" (
+          c.system.activationScripts.users == ""
+          && script c == script b
+          && c.system.dryActivationScript == b.system.dryActivationScript
+          && force c
+        )
+      );
+      ancestry = check "${release} selected source ancestry" (
+        before "\"/persistent/state\" \"/var/lib/nixos\"" "\"/var/lib/nixos/log\" \"/var/log\"" (
+          mounts ancestry
+        )
+        && force ancestry
+      );
+      topology = check "${release} valid selected-to-ordinary topology" (
+        before "\"/persistent/state\" \"/var/lib/nixos\"" "\"/var/lib/nixos/usr\" \"/usr\"" (
+          mounts dependent
+        )
+        && force dependent
+      );
+      root = check "${release} root-backed source allowed" (
+        force root
+        && contains (lib.escapeShellArg "/root-state/nixos") root.system.activationScripts.specialfs.text
+      );
+      declared = check "${release} declared backing in original global order" (
+        before "\"/host/custom\" \"/custom/backing\"" "\"/custom/backing/state\" \"/var/lib/nixos\"" (
+          mounts declared
+        )
+        && contains (lib.escapeShellArgs [
+          "bind"
+          "/host/custom"
+          "/custom/backing"
+        ]) declared.system.activationScripts.specialfs.text
+        && force declared
+      );
+      pathComponents = check "${release} backing checks respect path components" (
+        !contains (lib.escapeShellArgs [
+          "bind"
+          "/host/custom"
+          "/custom/backing"
+        ]) nearPrefix.system.activationScripts.specialfs.text
+        && force nearPrefix
+      );
+      nonBindBacking = check "${release} non-bind backing retains presence-only check" (
+        contains (lib.escapeShellArgs [
+          "filesystem"
+          "tmpfs"
+          "/custom/backing"
+        ]) nonBind.system.activationScripts.specialfs.text
+        && force nonBind
+      );
+      cycle = check "${release} upstream topology reports the selected-bind cycle" (
+        !(cycleOrder ? result)
+        && cycleOrder ? cycle
+        && cycleOrder.cycle != [ ]
+        && lib.all (path: builtins.elem path (map (mount: mount.mountPoint) cycleOrder.cycle)) [
+          "/var/lib/nixos"
+          "/var/log"
+        ]
+      );
+      mkForce = check "${release} guest mkForce retains precedence" (
+        forced.system.activationScripts.specialfs == "guest-specialfs" && force forced
+      );
+      direct = check "${release} direct filesystems retain upstream activation" (
+        script direct == script (baseline [
+          {
+            fileSystems."/var/log" = {
+              device = "/direct/log";
+              fsType = "none";
+              options = [ "bind" ];
+            };
+          }
+        ])
+        && force direct
+      );
+    };
+  shellConfig =
+    mode:
+    evaluate "26.05" (raw source "26.05") (
+      [
+        (manual [
+          (bind "/fixture/backing storage/nixos" "/var/lib/nixos")
+          (bind "/fixture/backing storage/log" "/var/log")
+        ])
+      ]
+      ++ lib.optional (mode != "undeclared") {
+        fileSystems."/fixture/backing storage" = {
+          device = if mode == "filesystem" then "tmpfs" else "/fixture/host storage";
+          fsType = if mode == "filesystem" then "tmpfs" else "none";
+          options = if mode == "filesystem" then [ "defaults" ] else [ "bind" ];
+          neededForBoot = true;
+        };
+      }
+    );
+in
+{
+  assertions = {
+    releases = lib.genAttrs [ "25.11" "26.05" "unstable" ] checkRelease;
+    latestStable = check "latest stable equals self-contained 26.05" (
+      builtins.readFile (source + "/os/lib/nixos-container/stable/vpsadminos.nix")
+      == builtins.readFile (source + "/os/lib/nixos-container/stable/vpsadminos-26.05.nix")
+    );
+  };
+  shellFixtures = lib.genAttrs [ "declared" "undeclared" "filesystem" ] (
+    name:
+    let
+      c = shellConfig name;
+    in
+    {
+      snippet = c.system.activationScripts.specialfs.text;
+      earlyMountScript = c.system.build.earlyMountScript;
+    }
+  );
+}
diff --git a/tests/nixos-container-persistence-shell.sh b/tests/nixos-container-persistence-shell.sh
new file mode 100644
index 000000000..c583b7199
--- /dev/null
+++ b/tests/nixos-container-persistence-shell.sh
@@ -0,0 +1,160 @@
+#!/usr/bin/env bash
+# Command doubles run the generated selected callback and globally ordered
+# fixture calls. The marker proves shell control flow, not guest allocation.
+set -euo pipefail
+snippet=$1
+early_mounts=$2
+mode=$3
+fixture_root=$(mktemp -d)
+trap 'rm -rf "$fixture_root"' EXIT
+
+scenarios=(fresh missing_parents existing_metadata failed_bind matching_live wrong_live failed_mount_lookup wrong_result source_file parent_file failed_mkdir failed_lookup)
+expected_calls=2
+if [ "$mode" != undeclared ]; then
+  scenarios+=(missing_backing); expected_calls=3
+  if [ "$mode" = declared ]; then scenarios+=(matching_backing wrong_backing); fi
+else scenarios+=(root_backing absent_undeclared)
+fi
+for scenario in "${scenarios[@]}"; do
+  case_root="$fixture_root/$scenario"
+  backing="$case_root/backing storage"
+  source="$backing/nixos"
+  target="$case_root/state_target"
+  log_source="$backing/log"
+  log_target="$case_root/log_target"
+  mkdir -p "$case_root/host storage"
+  if [ "$mode" = declared ]; then ln -s "$case_root/host storage" "$backing"
+  else mkdir "$backing"
+  fi
+  before_metadata=
+  case "$scenario" in
+    missing_parents) source="$backing/new-parent/nixos" ;;
+    existing_metadata)
+      mkdir "$source"
+      chmod 0710 "$source"
+      printf 'existing data\n' > "$source/payload"
+      before_metadata=$(stat -c '%u:%g:%a:%i' "$source")
+      ;;
+    matching_live)
+      mkdir "$source"
+      printf 'matching data\n' > "$source/payload"
+      ln -s "$source" "$target"
+      touch "$case_root/mounted-state"
+      ;;
+    wrong_live)
+      mkdir "$case_root/wrong"
+      ln -s "$case_root/wrong" "$target"
+      touch "$case_root/mounted-state"
+      ;;
+    source_file) touch "$source" ;;
+    wrong_backing)
+      mkdir "$case_root/wrong backing"
+      rm "$backing"
+      ln -s "$case_root/wrong backing" "$backing"
+      ;;
+    parent_file)
+      if [ -L "$backing" ]; then rm "$backing"; else rmdir "$backing"; fi
+      touch "$backing"
+      ;;
+    failed_mount_lookup) mkdir "$target" ;;
+  esac
+
+  # Rewrite configured fixture paths and the single source locator only.
+  rewrite() {
+    sed -e "s|/fixture/backing storage/nixos|$source|g" \
+      -e "s|/fixture/backing storage|$backing|g" \
+      -e "s|/fixture/host storage|$case_root/host storage|g" \
+      -e "s|/var/lib/nixos|$target|g" \
+      -e "s|/var/log|$log_target|g" "$1"
+  }
+  # Exclude unrelated /proc,/sys,/run mounts; their host paths are never touched.
+  awk '/^specialMount "\/fixture\// || /^specialMount .* "\/fixture\/backing storage"/ { print }' "$early_mounts" > "$case_root/selected.sh"
+  rewrite "$case_root/selected.sh" > "$case_root/mounts.sh"
+  rewrite "$snippet" | sed -E "s|^[[:space:]]*source .*|source '$case_root/mounts.sh'|" > "$case_root/activation.sh"
+  bash -n "$case_root/activation.sh"
+  bash -n "$case_root/mounts.sh"
+
+  set +e
+  (
+    set +e
+    umask 0077
+    _status=0
+    trap '_status=1' ERR
+    mountpoint() {
+      local path="${*: -1}"
+      if [ "$path" = / ]; then return 0; fi
+      if [ "$path" = "$backing" ]; then
+        [ "$scenario" != missing_backing ] || return 32
+        return 0
+      fi
+      [ "$scenario" != failed_mount_lookup ] || return 1
+      if [ "$path" = "$target" ]; then test -f "$case_root/mounted-state" || return 32
+      elif [ "$path" = "$log_target" ]; then test -f "$case_root/mounted-log" || return 32
+      else return 32
+      fi
+    }
+    dirname() {
+      [ "$scenario" != failed_lookup ] || return 1
+      command dirname "$@"
+    }
+    mkdir() {
+      [ "$scenario" != failed_mkdir ] || return 1
+      command mkdir "$@"
+    }
+    mount() {
+      printf '%s\n' "$*" >> "$case_root/mount-calls"
+      local from="${*: -2:1}" to="${*: -1}" options="$4"
+      # The ordinary declared backing callback precedes selected binds. Refuse
+      # its operation in the backing-failure case, as NixOS's ERR trap continues.
+      if [ "$to" = "$backing" ]; then
+        [ "$scenario" != missing_backing ] || return 1
+        return 0
+      fi
+      [ "$scenario" != failed_bind ] || return 1
+      if [[ "$options" != remount,* ]]; then
+        rmdir "$to" || return 1
+        if [ "$scenario" = wrong_result ]; then ln -s "$backing" "$to" || return 1
+        else ln -s "$from" "$to" || return 1
+        fi
+        if [ "$to" = "$target" ]; then touch "$case_root/mounted-state"; else touch "$case_root/mounted-log"; fi
+      fi
+    }
+    . "$case_root/activation.sh"
+    touch "$case_root/allocator-reached"
+  ) > "$case_root/output" 2>&1
+  status=$?
+  set -e
+  case "$scenario" in
+    fresh|missing_parents|existing_metadata|matching_live|matching_backing|root_backing|absent_undeclared)
+      [ "$status" = 0 ] && [ -f "$case_root/allocator-reached" ] || { cat "$case_root/output"; exit 1; }
+      [ "$source" -ef "$target" ] && [ "$log_source" -ef "$log_target" ]
+      [ "$(wc -l < "$case_root/mount-calls")" = "$expected_calls" ]
+      if [ "$scenario" = matching_live ]; then
+        [[ "$(grep -- " $target$" "$case_root/mount-calls")" == *'remount,bind,x-gvfs-hide'* ]]
+        [ "$(grep -c " $target$" "$case_root/mount-calls")" = 1 ]
+        [ "$(cat "$source/payload")" = 'matching data' ]
+      fi
+      ;;
+    *)
+      [ "$status" != 0 ] && [ ! -f "$case_root/allocator-reached" ] || { cat "$case_root/output"; exit 1; }
+      case "$scenario" in
+        wrong_live|wrong_backing|missing_backing|failed_mount_lookup|source_file|parent_file|failed_mkdir|failed_lookup)
+          if [ "$mode" != undeclared ]; then [ "$(wc -l < "$case_root/mount-calls")" = 1 ]
+          else [ ! -f "$case_root/mount-calls" ]
+          fi ;;
+      esac
+      ;;
+  esac
+  if [ "$scenario" = existing_metadata ]; then
+    [ "$before_metadata" = "$(stat -c '%u:%g:%a:%i' "$source")" ]
+    [ "$(cat "$source/payload")" = 'existing data' ]
+  fi
+  if [ "$scenario" = fresh ] || [ "$scenario" = missing_parents ]; then [ "$(stat -c '%a' "$source")" = 755 ]; fi
+  if [ "$scenario" = missing_parents ]; then [ "$(stat -c '%a' "$backing/new-parent")" = 755 ]; fi
+  if [ "$scenario" = wrong_backing ]; then
+    [ ! -e "$source" ] && [ ! -e "$case_root/host storage/nixos" ]
+    [ "$backing" -ef "$case_root/wrong backing" ]
+  fi
+  if [ "$scenario" = wrong_live ]; then [ ! -e "$source" ]; [ "$target" -ef "$case_root/wrong" ]; fi
+  printf 'PASS %s\n' "$scenario"
+done
