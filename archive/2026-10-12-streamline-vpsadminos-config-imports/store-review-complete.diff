+      layout = "root";
+      generations = generations "26.05" "root";
+    };
+    declared-backing-26_05 = {
+      release = "26.05";
+      layout = "declared";
+      generations = generations "26.05" "declared";
+    };
+    dependent-mount-26_05 = {
