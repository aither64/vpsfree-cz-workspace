@@ -0,0 +1,14 @@
+release:
+let
+  vpsadminos = builtins.getFlake (toString ../.);
+  lib = vpsadminos.inputs.nixpkgs.lib;
+in
+builtins.deepSeq
+  (vpsadminos.nixosModules.containerStable {
