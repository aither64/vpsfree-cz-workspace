+++ b/tests/fixtures/nixos-persistence-guests.nix
@@ -0,0 +1,329 @@
+# Prepared generations share every definition/input at the old-to-new boundary.
+{ system, source }:
+let
+  fixtures = import ./nixos-container-persistence.nix { inherit system; };
+  rawPath =
+    release:
+    if release == "unstable" then "unstable/vpsadminos.nix" else "stable/vpsadminos-${release}.nix";
+  storageFor =
+    layout:
+    if layout == "root" then
+      "/root-storage"
+    else if layout == "declared" then
+      "/guest-backing"
+    else
+      "/persistent";
+  ancestor =
+    layout:
+    if layout == "ancestor-var" then
+      "/var"
+    else if layout == "ancestor-lib" then
+      "/var/lib"
+    else
+      null;
+  stateTarget = layout: if ancestor layout == null then "/var/lib/nixos" else ancestor layout;
+  exact = layout: ancestor layout == null && layout != "direct";
+  definitions =
+    release: layout: challenge: failure:
+    {
+      lib,
+      pkgs,
+      modulesPath,
+      ...
+    }:
+    let
+      storage = storageFor layout;
+      ancestorFailure = builtins.elem failure [
+        "ancestor-bind"
+        "ancestor-conflict"
+      ];
+      requiredFailure = builtins.elem failure [
+        "missing"
+        "wrong-backing"
+        "required-remount"
+      ];
+      nonBindFailure = builtins.elem failure [
+        "nonbind"
+        "nonbind-remount"
+        "nonbind-positive"
+      ];
+    in
+    {
+      imports = [
+        (modulesPath + "/virtualisation/container-config.nix")
+        fixtures.impermanenceModule
+      ];
+      system.stateVersion = "22.11";
+      networking.hostName = "persistence-fixture";
+      networking.firewall.enable = false;
+      systemd.sysusers.enable = false;
+      services.userborn.enable = false;
+      nix.settings.experimental-features = [
+        "nix-command"
+        "flakes"
+      ];
+      environment.systemPackages = [
+        pkgs.jq
+        pkgs.util-linux
+      ];
+      users.groups.preservation-test = { };
+      users.users.preservation-test = {
+        isSystemUser = true;
+        group = "preservation-test";
+      };
+      users.groups.a-preservation-test = lib.mkIf challenge { };
+      users.users.a-preservation-test = lib.mkIf challenge {
+        isSystemUser = true;
+        group = "a-preservation-test";
+      };
+      environment.persistence.${storage} = {
+        hideMounts = true;
+        directories =
+          lib.optionals (layout != "direct") (
+            if ancestor layout != null then
+              [
+                {
+                  directory = ancestor layout;
+                  mode = "0710";
+                }
+              ]
+            else
+              [
+                {
+                  directory = "/var/lib/nixos";
+                  mode = "0710";
+                }
+                "/var/log"
+              ]
+          )
+          ++ [
+            {
+              directory = "/var/lib/preservation-test";
+              user = "preservation-test";
+              group = "preservation-test";
+              mode = "0750";
+            }
+          ];
+        files = [ "/etc/machine-id" ];
+      };
+      fileSystems = lib.mkMerge [
+        (lib.mkIf (layout == "direct") {
+          "/var/lib/nixos" = {
+            device = "${storage}/var/lib/nixos";
+            fsType = "none";
+            options = [
+              "bind"
+              "x-gvfs-hide"
+            ];
+          };
+        })
+        (lib.mkIf (layout == "declared") {
+          "/guest-backing" = {
+            device = "/persistent/backing";
+            fsType = "none";
+            options = [
+              "bind"
+              "x-gvfs-hide"
+            ];
+            neededForBoot = true;
+          };
+        })
+        (lib.mkIf requiredFailure {
+          "/required-storage" = {
+            device = if failure == "required-remount" then "tmpfs" else "/persistent/required";
+            fsType = if failure == "required-remount" then "tmpfs" else "none";
+            options =
+              if failure == "required-remount" then
+                [
+                  "remount"
+                  "size=invalid"
+                ]
+              else
+                [ "bind" ];
+            neededForBoot = true;
+          };
+        })
+        (lib.mkIf nonBindFailure {
+          "/var/log" = {
+            device = if failure == "nonbind" then "/dev/no-such-persistence-device" else "tmpfs";
+            fsType = if failure == "nonbind" then "ext4" else "tmpfs";
+            options = if failure == "nonbind-remount" then [ "size=invalid" ] else [ "mode=0755" ];
+          };
+        })
+      ];
+      systemd.mounts = lib.mkMerge [
+        (lib.mkIf (layout == "dependent") [
+          {
+            what = "/var/lib/nixos/usr";
+            where = "/usr";
+            type = "none";
+            options = "bind,x-gvfs-hide";
+          }
+        ])
+        (lib.mkIf (failure != null) (
+          lib.mkForce (
+            if nonBindFailure then
+              [ ]
+            else
+              [
+                {
+                  what =
+                    if requiredFailure then
+                      "/required-storage/absent-state"
+                    else if ancestorFailure then
+                      "/persistent/var/lib"
+                    else
+                      "/persistent/var/lib/nixos";
+                  where = if ancestorFailure then "/var/lib" else "/var/lib/nixos";
+                  type = "none";
+                  # MS_BIND|MS_REMOUNT requires a live mount; the private namespace
+                  # removes the target for deterministic bind-failure cases.
+                  options =
+                    if
+                      builtins.elem failure [
+                        "bind"
+                        "ancestor-bind"
+                      ]
+                    then
+                      "bind,remount"
+                    else
+                      "bind,x-gvfs-hide";
+                }
+              ]
+          )
+        ))
+      ];
+    };
+  make =
+    release: layout: base: challenge: failure:
+    let
+      c =
+        (fixtures.releases.${release}.lib.nixosSystem {
+          inherit system;
+          modules = [
+            (import (base + "/os/lib/nixos-container/${rawPath release}"))
+            (definitions release layout challenge failure)
+          ];
+        }).config;
+    in
+    assert
+      !(
+        ancestor layout != null
+        || builtins.elem failure [
+          "ancestor-bind"
+          "ancestor-conflict"
+        ]
+      )
+      || (!(c.boot.specialFileSystems ? "/var/lib/nixos") && !(c.boot.specialFileSystems ? "/var/log"));
+    assert
+      !(
+        layout == "direct"
+        || builtins.elem failure [
+          "nonbind"
+          "nonbind-remount"
+          "nonbind-positive"
+        ]
+      )
+      || builtins.all (
+        mount:
+        !(builtins.elem (mount.where or "") [
+          "/var/lib/nixos"
+          "/var/log"
+        ])
+      ) c.systemd.mounts;
+    c.system.build.toplevel;
+  generations = release: layout: {
+    oldInitial = make release layout fixtures.oldSource false null;
+    oldChallenge = make release layout fixtures.oldSource true null;
+    newInitial = make release layout source false null;
+    newChallenge = make release layout source true null;
+  };
+  variant =
+    release: layout: fresh:
+    let
+      storage = storageFor layout;
+      target = stateTarget layout;
+    in
+    {
+      inherit release layout fresh;
+      generations = generations release layout;
+      mounts = [
+        {
+          source = "${storage}${target}";
+          inherit target;
+        }
+      ]
+      ++ (
+        if exact layout then
+          [
+            {
+              source = "${storage}/var/log";
+              target = "/var/log";
+            }
+          ]
+        else
+          [ ]
+      );
+      stateBacking = "${storage}/var/lib/nixos";
+      sourceDirectory = "${storage}${target}";
+      sourcePathInRoot =
+        if layout == "root" then
+          "${storage}${target}"
+        else if layout == "declared" then
+          "/backing${target}"
+        else
+          target;
+      # Numeric ownership tests pre-existing source metadata only. Both fixture
+      # accounts and every saved allocation remain dynamically assigned.
+      sourceMetadata = if fresh || ancestor layout != null then "0:0:755" else "42:43:710";
+      absentExactMounts =
+        if ancestor layout != null then
+          [
+            "/var/lib/nixos"
+            "/var/log"
+          ]
+        else if layout == "direct" then
+          [ "/var/log" ]
+        else
+          [ ];
+      logBacking = if exact layout || layout == "ancestor-var" then "${storage}/var/log" else null;
+    };
+in
+{
+  inherit (fixtures) oldMetadata oldSource;
+  expectedRelease = release: fixtures.releases.${release}.lib.trivial.release;
+  variants = {
+    upgrade-25_11 = variant "25.11" "supplied" false;
+    upgrade-26_05 = variant "26.05" "supplied" false;
+    upgrade-unstable = variant "unstable" "supplied" false;
+    root-backed-26_05 = variant "26.05" "root" false;
+    declared-backing-26_05 = variant "26.05" "declared" false;
+    dependent-mount-26_05 = variant "26.05" "dependent" false;
+    fresh-26_05 = variant "26.05" "supplied" true;
+    ancestor-var-26_05 = variant "26.05" "ancestor-var" false;
+    ancestor-var-lib-26_05 = variant "26.05" "ancestor-lib" false;
+    direct-filesystem-bind-26_05 = variant "26.05" "direct" false;
+    fresh-ancestor-26_05 = variant "26.05" "ancestor-lib" true;
+    storage-failures-26_05 = (variant "26.05" "failures" false) // {
+      failures = builtins.listToAttrs (
+        map
+          (failure: {
+            name = failure;
+            value = make "26.05" "supplied" source true failure;
+          })
+          [
+            "missing"
+            "bind"
+            "conflict"
+            "wrong-backing"
+            "ancestor-bind"
+            "ancestor-conflict"
+            "nonbind"
+            "nonbind-remount"
+            "nonbind-positive"
+            "required-remount"
+          ]
+      );
+    };
+  };
+}
diff --git a/tests/nixos-container-eval.sh b/tests/nixos-container-eval.sh
new file mode 100644
index 000000000..79a1e344c
--- /dev/null
+++ b/tests/nixos-container-eval.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "${BASH_SOURCE[0]}")/.."
+
+nix eval --impure --json --file tests/nixos-container-modules-eval.nix
+nix eval --impure --json --file tests/nixos-container-templates-eval.nix
+nix eval --impure --json --file tests/nixos-container-standalone-eval.nix
+
+error_log=$(mktemp)
+trap 'rm -f "$error_log"' EXIT
+for release in 21.11 99.99 26_05 unstable ''; do
+  if nix eval --impure --json --file tests/nixos-container-unsupported-eval.nix \
+    --apply "select: select \"$release\"" 2>"$error_log"; then
+    echo "Unsupported release $release unexpectedly succeeded" >&2
+    exit 1
+  fi
+  error_text=$(cat "$error_log")
+  for expected in \
+    "unsupported stable NixOS release '$release'" \
+    'Known stable releases: 22.11, 23.05, 23.11, 24.05, 24.11, 25.05, 25.11, 26.05' \
+    'Update the vpsadminos input' \
+    'nixosModules.containerUnstable'; do
+    if [[ "$error_text" != *"$expected"* ]]; then
+      cat "$error_log" >&2
+      echo "Missing unsupported-release guidance: $expected" >&2
+      exit 1
+    fi
+  done
+done
diff --git a/tests/nixos-container-modules-eval.nix b/tests/nixos-container-modules-eval.nix
new file mode 100644
index 000000000..eaa5f6ece
--- /dev/null
+++ b/tests/nixos-container-modules-eval.nix
@@ -0,0 +1,194 @@
+# Run with nix eval --impure --json --file tests/nixos-container-modules-eval.nix.
+# Historical inputs use real option declarations, not a modern lib with a
+# substituted release string. Fetch failures are distinct from assertion errors.
+let
+  vpsadminos = builtins.getFlake (toString ../.);
+  lib = vpsadminos.inputs.nixpkgs.lib;
+  fixtures = import ./fixtures/nixos-container-releases.nix { inherit vpsadminos; };
+  modules = vpsadminos.nixosModules;
+  releases = [
+    "22.11"
+    "23.05"
+    "23.11"
+    "24.05"
+    "24.11"
+    "25.05"
+    "25.11"
+    "26.05"
+  ];
+  alias = release: "container_${lib.replaceStrings [ "." ] [ "_" ] release}";
+  nameservers = [
+    "1.1.1.1"
+    "2606:4700:4700::1111"
+  ];
+  check = name: condition: if condition then true else throw "NixOS container check failed: ${name}";
+
+  # Exercise every selector leaf without pretending these are historical NixOS
+  # evaluations. The real release evaluations below verify option compatibility.
+  moduleArgs = {
+    inherit lib;
+    config = {
+      boot.specialFileSystems = { };
+      fileSystems = { };
+      system.build.earlyMountScript = "/mock-early-mounts.sh";
+      systemd.mounts = [ ];
+      systemd.sysusers.enable = false;
+      services.userborn.enable = false;
+    };
+    options.boot.specialFileSystems.type.getSubOptions = _: { };
+    utils = {
+      fsNeededForBoot = _: false;
+      pathsNeededForBoot = [ ];
+    };
+    pkgs = {
+      iproute2 = "/iproute2";
+      bash = "/bash";
+    };
+  };
+  moduleValue = module: builtins.toJSON (module moduleArgs);
+  selectedValue =
+    selector: release:
+    moduleValue (
+      builtins.head
+        (selector {
+          lib = lib // {
+            trivial = lib.trivial // {
+              inherit release;
+              version = "${release}pre-git";
+            };
+          };
+        }).imports
+    );
+  unknownReleases = [
+    "21.11"
+    "99.99"
+    "26_05"
+    "unstable"
+    ""
+  ];
+
+  evaluate =
+    nixpkgs: module:
+    nixpkgs.lib.nixosSystem {
+      system = "x86_64-linux";
+      modules = [
+        module
+        { system.stateVersion = "22.11"; }
+      ];
+    };
+  configuration =
+    evaluated:
+    let
+      c = evaluated.config;
+    in
+    {
+      release = c.system.nixos.release;
+      stateVersion = c.system.stateVersion;
+      isContainer = c.boot.isContainer;
+      initScript = c.boot.loader.initScript.enable;
+      nameservers = c.networking.nameservers;
+      resolved =
+        if lib.versionAtLeast c.system.nixos.release "26.05" then
+          c.services.resolved.settings.Resolve.FallbackDNS
+        else
+          c.services.resolved.fallbackDns;
+      networkingSetup = c.systemd.services.networking-setup.serviceConfig.ExecStart;
+      oomd = c.systemd.services.systemd-oomd.enable;
+      audit = c.systemd.sockets.systemd-journald-audit.enable;
+      runKeys = c.boot.specialFileSystems."/run/keys".fsType;
+      toplevel = c.system.build.toplevel.drvPath;
+    };
+  # This exact import is reused for each guest release, with stateVersion fixed.
+  stableImport = modules.containerStable;
+  realReleaseCheck =
+    release: nixpkgs:
+    let
+      explicit = configuration (evaluate nixpkgs modules.containers.${release});
+      automatic = configuration (evaluate nixpkgs stableImport);
+      generic = configuration (evaluate nixpkgs modules.container);
+      underscore = configuration (evaluate nixpkgs modules.${alias release});
+    in
+    check "real ${release} guest and unchanged stable import" (
+      nixpkgs.lib.trivial.release == release
+      && automatic == explicit
+      && generic == explicit
+      && underscore == explicit
+      && automatic.release == release
+      && automatic.stateVersion == "22.11"
+      && automatic.isContainer
+      && automatic.initScript
+      && automatic.nameservers == nameservers
+      && automatic.resolved == nameservers
+      && !automatic.oomd
+      && !automatic.audit
+      && automatic.runKeys == "tmpfs"
+    );
+  stable = fixtures."26.05";
+  unstable = fixtures.unstable;
+  rawStable = import ../os/lib/nixos-container/stable/vpsadminos.nix;
+  rawUnstable = import ../os/lib/nixos-container/unstable/vpsadminos.nix;
+in
+{
+  exports = check "exact grouped keys, derived aliases, and no containerAuto" (
+    builtins.attrNames modules.containers == releases
+    && !(modules ? containerAuto)
+    && lib.all (release: modules ? ${alias release}) releases
+  );
+  selectorMatrix = builtins.listToAttrs (
+    map (
+      release:
+      let
+        original = moduleValue (import (../os/lib/nixos-container/stable + "/vpsadminos-${release}.nix"));
+      in
+      {
+        name = release;
+        value = check "selector and aliases for ${release}" (
+          moduleValue modules.containers.${release} == original
+          && selectedValue modules.containerStable release == original
+          && selectedValue modules.container release == original
+          && moduleValue modules.${alias release} == original
+        );
+      }
+    ) releases
+  );
+  unsupported = check "unknown releases fail during import selection" (
+    lib.all (
+      release:
+      !(builtins.tryEval (
+        builtins.deepSeq
+          (modules.containerStable {
+            lib = lib // {
+              trivial = lib.trivial // {
+                inherit release;
+              };
+            };
+          }).imports
+          true
+      )).success
+    ) unknownReleases
+  );
+  realReleases = lib.genAttrs [ "24.11" "25.11" "26.05" ] (
+    release: realReleaseCheck release fixtures.${release}
+  );
+  guestLibrary = check "24.11 guest is distinct from captured 26.05 input" (
+    lib.trivial.release == "26.05" && fixtures."24.11".lib.trivial.release == "24.11"
+  );
+  legacy = check "legacy latest stable and unstable exports retain raw behavior" (
+    configuration (evaluate stable vpsadminos.nixosConfigurations.container)
+    == configuration (evaluate stable rawStable)
+    &&
+      configuration (evaluate stable vpsadminos.nixosConfigurations.containerStable)
+      == configuration (evaluate stable rawStable)
+    &&
+      configuration (evaluate unstable vpsadminos.nixosConfigurations.containerUnstable)
+      == configuration (evaluate unstable rawUnstable)
+    &&
+      configuration (evaluate unstable modules.containerUnstable)
+      == configuration (evaluate unstable rawUnstable)
+  );
+  # Literal quoted and guest-nixpkgs interpolated lookups must both import a leaf.
+  groupedSyntax = check "quoted and interpolated release keys" (
+    configuration (evaluate stable modules.containers."26.05")
+    == configuration (evaluate stable modules.containers.${stable.lib.trivial.release})
+  );
+}
diff --git a/tests/nixos-container-persistence-check.nix b/tests/nixos-container-persistence-check.nix
new file mode 100644
index 000000000..4c0b7f7aa
--- /dev/null
+++ b/tests/nixos-container-persistence-check.nix
@@ -0,0 +1,50 @@
+{
+  pkgs,
+  source,
+  system,
+  nixpkgs,
+  nixpkgsUnstable,
+  impermanence,
+}:
+let
+  fixtures = import ./fixtures/nixos-container-persistence.nix {
+    inherit
+      system
+      nixpkgs
+      nixpkgsUnstable
+      impermanence
+      ;
+  };
+  evaluation = import ./nixos-container-persistence-eval.nix {
+    inherit source system;
+    inherit (pkgs) lib;
+    inherit (fixtures) oldSource impermanenceModule;
+    fixtures = fixtures.releases;
+  };
+  shellFixtures = pkgs.lib.mapAttrs (name: fixture: {
+    snippet = pkgs.writeText "persistent-specialfs-${name}.sh" fixture.snippet;
+    inherit (fixture) earlyMountScript mode selectedOptions;
+  }) evaluation.shellFixtures;
+in
+builtins.deepSeq evaluation.assertions (
+  pkgs.runCommand "nixos-container-persistence"
+    {
+      nativeBuildInputs = [
+        pkgs.bash
+        pkgs.coreutils
+        pkgs.util-linux
+        pkgs.gnused
+        pkgs.gawk
+      ];
+      passthru = { inherit evaluation shellFixtures; };
+    }
+    ''
+      ${pkgs.lib.concatMapStringsSep "\n" (name: ''
+        bash ${./nixos-container-persistence-shell.sh} ${shellFixtures.${name}.snippet} ${
+          shellFixtures.${name}.earlyMountScript
+        } ${shellFixtures.${name}.mode} ${pkgs.lib.escapeShellArg shellFixtures.${name}.selectedOptions}
+      '') (builtins.attrNames shellFixtures)}
+      mkdir "$out"
+      cp ${pkgs.writeText "persistence-evaluation.json" (builtins.toJSON evaluation.assertions)} "$out/evaluation.json"
+    ''
+)
diff --git a/tests/nixos-container-persistence-eval.nix b/tests/nixos-container-persistence-eval.nix
new file mode 100644
index 000000000..a24a06f8b
--- /dev/null
+++ b/tests/nixos-container-persistence-eval.nix
@@ -0,0 +1,596 @@
+# Explicit inputs keep this evaluator usable in normal pure flake checks.
+{
+  source,
+  fixtures,
+  oldSource,
+  impermanenceModule,
+  lib,
+  system,
+}:
+let
+  rawPath =
+    release:
+    if release == "unstable" then "unstable/vpsadminos.nix" else "stable/vpsadminos-${release}.nix";
+  raw = base: release: import (base + "/os/lib/nixos-container/${rawPath release}");
+  evaluate =
+    release: module: extra:
+    (fixtures.${release}.lib.nixosSystem {
+      inherit system;
+      modules = [
+        module
+        {
+          system.stateVersion = "22.11";
+          fileSystems."/" = {
+            device = "none";
+            fsType = "tmpfs";
+          };
+        }
+      ]
+      ++ extra;
+    }).config;
+  persistence = {
+    imports = [ impermanenceModule ];
+    environment.persistence."/persistent" = {
+      hideMounts = true;
+      directories = [
+        "/var/lib/nixos"
+        "/var/log"
+      ];
+    };
+  };
+  bind = what: where: {
+    inherit what where;
+    type = "none";
+    options = "bind,x-gvfs-hide";
+  };
+  manual = mounts: { systemd.mounts = mounts; };
+  persistedAncestor = target: {
+    imports = [ impermanenceModule ];
+    environment.persistence."/persistent".directories = [ target ];
+  };
+  filesystem = device: target: fsType: options: {
+    fileSystems.${target} = { inherit device fsType options; };
+  };
+  contains = needle: text: lib.hasInfix (builtins.unsafeDiscardStringContext needle) text;
+  position =
+    needle: text:
+    (lib.findFirst (entry: contains needle entry.line) { index = -1; } (
+      lib.imap0 (index: line: { inherit index line; }) (lib.splitString "\n" text)
+    )).index;
+  count = needle: text: builtins.length (lib.filter (contains needle) (lib.splitString "\n" text));
+  before =
+    first: second: text:
+    position first text >= 0 && position second text >= 0 && position first text < position second text;
+  check = label: condition: if condition then true else throw "Persistence check failed: ${label}";
+  script = c: c.system.activationScripts.script;
+  mounts = c: c.system.build.earlyMountScript.text;
+  force = c: builtins.deepSeq [ (script c) (mounts c) c.system.dryActivationScript ] true;
+  adapted =
+    c:
+    before "source ${c.system.build.earlyMountScript}" "-update-users-groups.pl" (script c)
+    && builtins.elem "specialfs" c.system.activationScripts.users.deps
+    && count "source ${c.system.build.earlyMountScript}" (script c) == 1
+    && count "specialMount()" (script c) == 1
+    && contains "vpsadminosMountRequired" c.system.activationScripts.specialfs.text
+    && force c;
+  noExactBinds =
+    c:
+    lib.all (path: !(builtins.hasAttr path c.boot.specialFileSystems)) [
+      "/var/lib/nixos"
+      "/var/log"
+    ];
+  checkRelease =
+    release:
+    let
+      current = extra: evaluate release (raw source release) extra;
+      baseline = extra: evaluate release (raw oldSource release) extra;
+      ordinary = current [ ];
+      persisted = current [ persistence ];
+      copied = builtins.toFile "vpsadminos-persistence-${release}.nix" (
+        builtins.readFile (source + "/os/lib/nixos-container/${rawPath release}")
+      );
+      standalone = evaluate release (import copied) [ persistence ];
+      alternative =
+        base: backend:
+        evaluate release (raw base release) [
+          persistence
+          {
+            systemd.sysusers.enable = backend == "sysusers";
+            services.userborn.enable = backend == "userborn";
+          }
+        ];
+      ancestry = current [
+        (manual [
+          (bind "/persistent/state" "/var/lib/nixos")
+          (bind "/var/lib/nixos/log" "/var/log")
+        ])
+      ];
+      dependent = current [
+        (manual [
+          (bind "/persistent/state" "/var/lib/nixos")
+          (bind "/var/lib/nixos/usr" "/usr")
+        ])
+      ];
+      root = current [ (manual [ (bind "/root-state/nixos" "/var/lib/nixos") ]) ];
+      declared = current [
+        (manual [ (bind "/custom/backing/state" "/var/lib/nixos") ])
+        {
+          fileSystems."/custom/backing" = {
+            device = "/host/custom";
+            fsType = "none";
+            options = [ "bind" ];
+            neededForBoot = true;
+          };
+        }
+      ];
+      nearPrefix = current [
+        (manual [ (bind "/custom/backing-other/state" "/var/lib/nixos") ])
+        {
+          fileSystems."/custom/backing" = {
+            device = "/host/custom";
+            fsType = "none";
+            options = [ "bind" ];
+            neededForBoot = true;
+          };
+        }
+      ];
+      nonBind = current [
+        (manual [ (bind "/custom/backing/state" "/var/lib/nixos") ])
+        {
+          fileSystems."/custom/backing" = {
+            device = "tmpfs";
+            fsType = "tmpfs";
+            neededForBoot = true;
+          };
+        }
+      ];
+      cycle = current [
+        (manual [
+          (bind "/var/log/state" "/var/lib/nixos")
+          (bind "/var/lib/nixos/log" "/var/log")
+        ])
+      ];
+      # The upstream builder selects .result directly, so a deliberate cycle
+      # produces a hard missing-attribute error that tryEval cannot catch.
+      # Inspect the same pinned upstream topology without building its script.
+      cycleUtils = import (fixtures.${release}.source + "/nixos/lib/utils.nix") {
+        config = cycle;
+        lib = fixtures.${release}.lib;
+        pkgs = import fixtures.${release}.source { inherit system; };
+      };
+      cycleOrder = fixtures.${release}.lib.toposort cycleUtils.fsBefore (
+        builtins.attrValues cycle.boot.specialFileSystems
+      );
+      forced = current [
+        persistence
+        { system.activationScripts.specialfs = lib.mkForce "guest-specialfs"; }
+      ];
+      direct = current [
+        {
+          fileSystems."/var/log" = {
+            device = "/direct/log";
+            fsType = "none";
+            options = [ "bind" ];
+          };
+        }
+      ];
+      ancestorVar = current [ (persistedAncestor "/var") ];
+      ancestorLib = current [ (persistedAncestor "/var/lib") ];
+      directState = current [ (filesystem "/direct/state" "/var/lib/nixos" "none" [ "bind" ]) ];
+      directNonBind = current [
+        (filesystem "tmpfs" "/var/log" "tmpfs" [
+          "defaults"
+          "mode=0755"
+        ])
+      ];
+      rbind = current [
+        (filesystem "/recursive/var" "/var" "auto" [
+          "rbind"
+          "ro"
+        ])
+      ];
+      effective = current [
+        (manual [ (bind "/original/state" "/var/lib/nixos") ])
+        {
+          boot.specialFileSystems."/var/lib/nixos" = lib.mkForce {
+            device = "/effective/state";
+            fsType = "auto";
+            options = [
+              "rbind"
+              "ro"
+            ];
+            depends = [ "/explicit" ];
+          };
+          fileSystems."/explicit" = {
+            device = "tmpfs";
+            fsType = "tmpfs";
+            neededForBoot = true;
+          };
+        }
+      ];
+      controls = {
+        disabled = {
+          boot.specialFileSystems."/var" = {
+            enable = false;
+            device = "tmpfs";
+            fsType = "tmpfs";
+          };
+        };
+        near = {
+          boot.specialFileSystems."/var/log-old" = {
+            device = "/other";
+            fsType = "none";
+            options = [ "bind" ];
+          };
+        };
+        nearVariable = {
+          boot.specialFileSystems."/variable" = {
+            device = "/other";
+            fsType = "none";
+            options = [ "bind" ];
+          };
+        };
+        nearState = {
+          boot.specialFileSystems."/var/lib/nixos-other" = {
+            device = "/other";
+            fsType = "none";
+            options = [ "bind" ];
+          };
+        };
+        rootOnly = { };
+      };
+      transitive = current [
+        (filesystem "/bridge/state" "/var/lib/nixos" "none" [ "bind" ])
+        {
+          fileSystems."/bridge" = {
+            device = "/required/bridge";
+            fsType = "none";
+            options = [ "bind" ];
+            neededForBoot = true;
+          };
+          fileSystems."/required" = {
+            device = "/host/required";
+            fsType = "none";
+            options = [ "rbind" ];
+            neededForBoot = true;
+          };
+          fileSystems."/unrelated" = {
+            device = "tmpfs";
+            fsType = "tmpfs";
+            neededForBoot = true;
+          };
+        }
+      ];
+      old = baseline [ persistence ];
+      upstreamSource = "source ${persisted.system.build.earlyMountScript}";
+    in
+    {
+      actualRelease = persisted.system.nixos.release;
+      legacyOrder = check "${release} global specialfs before real allocator" (
+        before upstreamSource "-update-users-groups.pl" (script persisted)
+        && builtins.elem "specialfs" persisted.system.activationScripts.users.deps
+        && count upstreamSource (script persisted) == 1
+        && count "specialMount()" (script persisted) == 1
+        && force persisted
+      );
+      promotion = check "${release} complete promotion and units/options" (
+        mounts persisted == mounts old
+        &&
+          lib.all
+            (
+              target:
+              persisted.boot.specialFileSystems.${target}.options == [
+                "bind"
+                "x-gvfs-hide"
+              ]
+              && lib.any (m: m.where == target && m.options == "bind,x-gvfs-hide") persisted.systemd.mounts
+            )
+            [
+              "/var/lib/nixos"
+              "/var/log"
+            ]
+      );
+      standalone = check "${release} copied self-contained file" (script standalone == script persisted);
+      dry = check "${release} dry omits mounts and prep" (
+        lib.all
+          (
+            c:
+            !contains "vpsadminosPrepareStateDirectory" c.system.dryActivationScript
+            && !contains "source ${c.system.build.earlyMountScript}" c.system.dryActivationScript
+            && contains "-update-users-groups.pl" c.system.dryActivationScript
+          )
+          [
+            persisted
+            ancestorVar
+            ancestorLib
+            directState
+            directNonBind
+            rbind
+            effective
+          ]
+      );
+      ordinary = check "${release} ordinary exact baseline equivalence" (
+        script ordinary == script (baseline [ ])
+        && ordinary.system.dryActivationScript == (baseline [ ]).system.dryActivationScript
+        && force ordinary
+      );
+      alternatives = lib.genAttrs [ "sysusers" "userborn" ] (
+        backend:
+        let
+          c = alternative source backend;
+          b = alternative oldSource backend;
+        in
+        check "${release} ${backend} exact baseline equivalence" (
+          c.system.activationScripts.users == ""
+          && script c == script b
+          && c.system.dryActivationScript == b.system.dryActivationScript
+          && force c
+        )
+      );
+      ancestry = check "${release} selected source ancestry" (
+        before "\"/persistent/state\" \"/var/lib/nixos\"" "\"/var/lib/nixos/log\" \"/var/log\"" (
+          mounts ancestry
+        )
+        && force ancestry
+      );
+      topology = check "${release} valid selected-to-ordinary topology" (
+        before "\"/persistent/state\" \"/var/lib/nixos\"" "\"/var/lib/nixos/usr\" \"/usr\"" (
+          mounts dependent
+        )
+        && force dependent
+      );
+      root = check "${release} root-backed source allowed" (
+        force root
+        && contains (lib.escapeShellArg "/root-state/nixos") root.system.activationScripts.specialfs.text
+      );
+      declared = check "${release} declared backing in original global order" (
+        before "\"/host/custom\" \"/custom/backing\"" "\"/custom/backing/state\" \"/var/lib/nixos\"" (
+          mounts declared
+        )
+        && contains (lib.escapeShellArgs [
+          "bind"
+          "/host/custom"
+          "/custom/backing"
+        ]) declared.system.activationScripts.specialfs.text
+        && force declared
+      );
+      pathComponents = check "${release} backing checks respect path components" (
+        !contains (lib.escapeShellArgs [
+          "bind"
+          "/host/custom"
+          "/custom/backing"
+        ]) nearPrefix.system.activationScripts.specialfs.text
+        && force nearPrefix
+      );
+      nonBindBacking = check "${release} non-bind backing retains presence-only check" (
+        contains (lib.escapeShellArgs [
+          "filesystem"
+          "tmpfs"
+          "/custom/backing"
+        ]) nonBind.system.activationScripts.specialfs.text
+        && force nonBind
+      );
+      cycle = check "${release} upstream topology reports the selected-bind cycle" (
+        !(cycleOrder ? result)
+        && cycleOrder ? cycle
+        && cycleOrder.cycle != [ ]
+        && lib.all (path: builtins.elem path (map (mount: mount.mountPoint) cycleOrder.cycle)) [
+          "/var/lib/nixos"
+          "/var/log"
+        ]
+      );
+      mkForce = check "${release} guest mkForce retains precedence" (
+        forced.system.activationScripts.specialfs == "guest-specialfs" && force forced
+      );
+      direct = check "${release} direct filesystems checked before allocation" (
+        adapted direct
+        && adapted directState
+        && adapted directNonBind
+        && adapted rbind
+        && contains (lib.escapeShellArg "/direct/log") direct.system.activationScripts.specialfs.text
+        && lib.all (option: builtins.elem option directNonBind.boot.specialFileSystems."/var/log".options) [
+          "defaults"
+          "mode=0755"
+        ]
+        && contains (lib.escapeShellArg (
+          lib.concatStringsSep "," directNonBind.boot.specialFileSystems."/var/log".options
+        )) directNonBind.system.activationScripts.specialfs.text
+        && lib.all (option: builtins.elem option rbind.boot.specialFileSystems."/var".options) [
+          "rbind"
+          "ro"
+        ]
+        && contains (lib.escapeShellArg (
+          lib.concatStringsSep "," rbind.boot.specialFileSystems."/var".options
+        )) rbind.system.activationScripts.specialfs.text
+      );
+      ancestors = check "${release} impermanence ancestors without exact state/log entries" (
+        adapted ancestorVar
+        && adapted ancestorLib
+        && noExactBinds ancestorVar
+        && noExactBinds ancestorLib
+        && contains (lib.escapeShellArg "/var") ancestorVar.system.activationScripts.specialfs.text
+        && contains (lib.escapeShellArg "/var/lib") ancestorLib.system.activationScripts.specialfs.text
+      );
+      effectiveEntry = check "${release} effective source/type/options/dependencies" (
+        adapted effective
+        && effective.boot.specialFileSystems."/var/lib/nixos".device == "/effective/state"
+        && effective.boot.specialFileSystems."/var/lib/nixos".fsType == "auto"
+        &&
+          effective.boot.specialFileSystems."/var/lib/nixos".options == [
+            "rbind"
+            "ro"
+          ]
+        && effective.boot.specialFileSystems."/var/lib/nixos".depends == [ "/explicit" ]
+        && contains (lib.escapeShellArg "/effective/state") effective.system.activationScripts.specialfs.text
+        && contains (lib.escapeShellArg "rbind,ro") effective.system.activationScripts.specialfs.text
+        && !contains (lib.escapeShellArg "/original/state") effective.system.activationScripts.specialfs.text
+        && contains (lib.escapeShellArg "/explicit") effective.system.activationScripts.specialfs.text
+      );
+      selectionControls = lib.mapAttrs (
+        name: extra:
+        check "${release} ${name} does not enable adapter" (
+          let
+            c = current [ extra ];
+          in
+          !contains "vpsadminosMountRequired" (script c) && force c
+        )
+      ) controls;
+      requiredPredecessors =
+        check "${release} transitive required membership without unrelated callbacks"
+          (
+            adapted transitive
+            && before "\"/host/required\" \"/required\"" "\"/required/bridge\" \"/bridge\"" (mounts transitive)
+            && before "\"/required/bridge\" \"/bridge\"" "\"/bridge/state\" \"/var/lib/nixos\"" (
+              mounts transitive
+            )
+            && contains (lib.escapeShellArg "/host/required") transitive.system.activationScripts.specialfs.text
+            && contains (lib.escapeShellArg "/required/bridge") transitive.system.activationScripts.specialfs.text
+            && !contains (lib.escapeShellArg "/unrelated") transitive.system.activationScripts.specialfs.text
+          );
+    };
+  shellConfig =
+    release: mode:
+    let
+      target =
+        if mode == "var" then
+          "/var"
+        else if mode == "var-lib" then
+          "/var/lib"
+        else
+          "/var/lib/nixos";
+      sourcePath =
+        if mode == "transitive" then "/fixture/bridge/state" else "/fixture/backing storage/nixos";
+      exact = builtins.elem mode [
+        "declared"
+        "undeclared"
+        "filesystem"
+      ];
+    in
+    evaluate release (raw source release) (
+      [
+        (
+          if mode == "nonbind" then
+            filesystem "/fixture/device-file" "/var/log" "tmpfs" [
+              "defaults"
+              "mode=0755"
+            ]
+          else if
+            builtins.elem mode [
+              "direct"
+              "rbind"
+              "transitive"
+              "explicit"
+            ]
+          then
+            filesystem sourcePath target "auto" [
+              (if mode == "rbind" then "rbind" else "bind")
+              "x-gvfs-hide"
+            ]
+          else
+            manual (
+              [ (bind sourcePath target) ] ++ lib.optional exact (bind "/fixture/backing storage/log" "/var/log")
+            )
+        )
+      ]
+      ++
+        lib.optional
+          (builtins.elem mode [
+            "declared"
+            "filesystem"
+          ])
+          {
+            fileSystems."/fixture/backing storage" = {
+              device = if mode == "filesystem" then "tmpfs" else "/fixture/host storage";
+              fsType = if mode == "filesystem" then "tmpfs" else "none";
+              options = if mode == "filesystem" then [ "defaults" ] else [ "bind" ];
+              neededForBoot = true;
+            };
+          }
+      ++ lib.optional (mode == "transitive") {
+        fileSystems."/fixture/backing storage" = {
+          device = "/fixture/host storage";
+          fsType = "none";
+          options = [ "rbind" ];
+          neededForBoot = true;
+        };
+        fileSystems."/fixture/bridge" = {
+          device = "/fixture/backing storage/bridge";
+          fsType = "none";
+          options = [ "bind" ];
+          neededForBoot = true;
+        };
+      }
+      ++ lib.optional (mode == "explicit") {
+        fileSystems."/var/lib/nixos".depends = [ "/fixture/dependency" ];
+        fileSystems."/fixture/dependency" = {
+          device = "fixture-dependency";
+          fsType = "tmpfs";
+          neededForBoot = true;
+        };
+        fileSystems."/fixture/unrelated" = {
+          device = "fixture-unrelated";
+          fsType = "tmpfs";
+          neededForBoot = true;
+        };
+      }
+    );
+in
+{
+  assertions = {
+    releases = lib.genAttrs [ "25.11" "26.05" "unstable" ] checkRelease;
+    latestStable = check "latest stable equals self-contained 26.05" (
+      builtins.readFile (source + "/os/lib/nixos-container/stable/vpsadminos.nix")
+      == builtins.readFile (source + "/os/lib/nixos-container/stable/vpsadminos-26.05.nix")
+    );
+  };
+  shellFixtures = builtins.listToAttrs (
+    lib.concatMap
+      (
+        release:
+        map
+          (
+            mode:
+            let
+              c = shellConfig release mode;
+            in
+            {
+              name = "${release}-${mode}";
+              value = {
+                snippet = c.system.activationScripts.specialfs.text;
+                earlyMountScript = c.system.build.earlyMountScript;
+                selectedOptions =
+                  lib.concatStringsSep ","
+                    c.boot.specialFileSystems.${
+                      if mode == "var" then
+                        "/var"
+                      else if mode == "var-lib" then
+                        "/var/lib"
+                      else if mode == "nonbind" then
+                        "/var/log"
+                      else
+                        "/var/lib/nixos"
+                    }.options;
+                inherit mode;
+              };
+            }
+          )
+          [
+            "declared"
+            "undeclared"
+            "filesystem"
+            "var"
+            "var-lib"
+            "direct"
+            "rbind"
+            "nonbind"
+            "transitive"
+            "explicit"
+          ]
+      )
+      [
+        "25.11"
+        "26.05"
+        "unstable"
+      ]
+  );
+}
diff --git a/tests/nixos-container-persistence-shell.sh b/tests/nixos-container-persistence-shell.sh
new file mode 100644
index 000000000..b5be7cf2d
--- /dev/null
+++ b/tests/nixos-container-persistence-shell.sh
@@ -0,0 +1,190 @@
+#!/usr/bin/env bash
+# Layout-specific doubles run generated callbacks. The allocator marker proves
+# shell control flow only; registered VM tests use the real account allocator.
+set -euo pipefail
+snippet=$1
+early_mounts=$2
+mode=$3
+selected_options=$4
+fixture_root=$(mktemp -d)
+trap 'rm -rf "$fixture_root"' EXIT
+fixture_bind_state=true
+exact=false
+configured_target=/var/lib/nixos
+case "$mode" in
+  declared|undeclared|filesystem) exact=true ;;
+  var) configured_target=/var ;;
+  var-lib) configured_target=/var/lib ;;
+  nonbind) fixture_bind_state=false; configured_target=/var/log ;;
+esac
+case "$mode" in
+  nonbind) required_options=(defaults mode=0755) ;;
+  rbind) required_options=(rbind x-gvfs-hide) ;;
+  *) required_options=(bind x-gvfs-hide) ;;
+esac
+for option in "${required_options[@]}"; do
+  [[ ",$selected_options," == *",$option,"* ]]
+done
+scenarios=(fresh existing_metadata matching_live failed_bind failed_remount failed_mount_lookup wrong_result failed_mkdir dangling_target)
+if "$fixture_bind_state"; then scenarios+=(missing_parents wrong_live source_file parent_file failed_lookup dangling_source); fi
+case "$mode" in
+  declared|filesystem|transitive) scenarios+=(missing_backing failed_required_remount) ;;
+  undeclared) scenarios+=(root_backing absent_undeclared) ;;
+esac
+case "$mode" in declared|transitive) scenarios+=(matching_backing wrong_backing missing_backing_source) ;; esac
+if [ "$mode" = transitive ]; then scenarios+=(missing_transitive); fi
+if [ "$mode" = explicit ]; then scenarios+=(missing_dependency failed_unrelated); fi
+for fixture_scenario in "${scenarios[@]}"; do
+  fixture_case_root="$fixture_root/$fixture_scenario"
+  fixture_backing="$fixture_case_root/backing storage"
+  fixture_host="$fixture_case_root/host storage"
+  fixture_bridge="$fixture_case_root/bridge"
+  fixture_dependency="$fixture_case_root/dependency"
+  fixture_target="$fixture_case_root/state_target"
+  fixture_log_target="$fixture_case_root/log_target"
+  mkdir -p "$fixture_host/bridge"
+  case "$mode" in declared|transitive) ln -s "$fixture_host" "$fixture_backing" ;; *) mkdir "$fixture_backing" ;; esac
+  if [ "$mode" = transitive ]; then ln -s "$fixture_backing/bridge" "$fixture_bridge"; fixture_source="$fixture_bridge/state"
+  elif "$fixture_bind_state"; then fixture_source="$fixture_backing/nixos"
+  else fixture_source="$fixture_case_root/device-file"; touch "$fixture_source"
+  fi
+  log_source="$fixture_backing/log"
+  before_metadata=
+  case "$fixture_scenario" in
+    missing_parents) fixture_source="$(dirname "$fixture_source")/new-parent/state" ;;
+    existing_metadata)
+      if "$fixture_bind_state"; then metadata_path="$fixture_source"; else metadata_path="$fixture_target"; fi
+      mkdir "$metadata_path"; chmod 0710 "$metadata_path"
+      printf 'existing data\n' > "$metadata_path/payload"
+      before_metadata=$(stat -c '%u:%g:%a:%i' "$metadata_path") ;;
+    matching_live|failed_remount)
+      if "$fixture_bind_state"; then mkdir "$fixture_source"; ln -s "$fixture_source" "$fixture_target"; else mkdir "$fixture_target"; fi
+      printf 'matching data\n' > "$fixture_target/payload"
+      touch "$fixture_case_root/mounted-state" ;;
+    wrong_live)
+      mkdir "$fixture_case_root/wrong"; ln -s "$fixture_case_root/wrong" "$fixture_target"; touch "$fixture_case_root/mounted-state" ;;
+    source_file) touch "$fixture_source" ;;
+    dangling_source) ln -s "$fixture_case_root/absent" "$fixture_source" ;;
+    dangling_target) ln -s "$fixture_case_root/absent" "$fixture_target" ;;
+    wrong_backing)
+      mkdir "$fixture_case_root/wrong backing"; rm "$fixture_backing"; ln -s "$fixture_case_root/wrong backing" "$fixture_backing" ;;
+    missing_backing_source) rmdir "$fixture_host/bridge" "$fixture_host" ;;
+    missing_transitive) rmdir "$fixture_host/bridge" ;;
+    parent_file)
+      if [ "$mode" = transitive ]; then rm "$fixture_bridge"; touch "$fixture_bridge"
+      elif [ -L "$fixture_backing" ]; then rm "$fixture_backing"; touch "$fixture_backing"
+      else rmdir "$fixture_backing"; touch "$fixture_backing"
+      fi ;;
+    failed_mount_lookup) mkdir "$fixture_target" ;;
+  esac
+  rewrite() {
+    sed -e "s|/fixture/backing storage/nixos|$fixture_source|g" \
+      -e "s|/fixture/bridge/state|$fixture_source|g" \
+      -e "s|/fixture/backing storage|$fixture_backing|g" \
+      -e "s|/fixture/host storage|$fixture_host|g" \
+      -e "s|/fixture/bridge|$fixture_bridge|g" \
+      -e "s|/fixture/dependency|$fixture_dependency|g" \
+      -e "s|/fixture/device-file|$fixture_source|g" \
+      -e "s|/fixture/unrelated|$fixture_case_root/unrelated|g" \
+      -e "s|\"$configured_target\"|\"$fixture_target\"|g" \
+      -e "s|'$configured_target'|'$fixture_target'|g" \
+      -e "s|= $configured_target ]|= '$fixture_target' ]|g" \
+      -e "s|\"/var/log\"|\"$fixture_log_target\"|g" \
+      -e "s|'/var/log'|'$fixture_log_target'|g" \
+      -e "s|= /var/log ]|= '$fixture_log_target' ]|g" "$1"
+  }
+  expected_selected_options=$(rewrite <(printf '%s\n' "$selected_options"))
+  # Filter fixture calls; host /proc,/sys,/run paths are never touched.
+  awk '/^specialMount "\/fixture\// || /^specialMount "fixture-/ || /^specialMount .* "\/fixture\// { print }' "$early_mounts" > "$fixture_case_root/selected.sh"
+  expected_calls=$(wc -l < "$fixture_case_root/selected.sh")
+  rewrite "$fixture_case_root/selected.sh" > "$fixture_case_root/mounts.sh"
+  rewrite "$snippet" | sed -E "s|^[[:space:]]*source .*|source '$fixture_case_root/mounts.sh'|" > "$fixture_case_root/activation.sh"
+  bash -n "$fixture_case_root/activation.sh"
+  bash -n "$fixture_case_root/mounts.sh"
+  set +e
+  (
+    set +e
+    umask 0077
+    _status=0
+    trap '_status=1' ERR
+    mountpoint() {
+      local path="${*: -1}"
+      if [ "$path" = / ]; then return 0; fi
+      case "$path" in
+        "$fixture_backing") [ "$fixture_scenario" != missing_backing ] || return 32; return 0 ;;
+        "$fixture_bridge") return 0 ;;
+        "$fixture_dependency") [ "$fixture_scenario" != missing_dependency ] || return 32; return 0 ;;
+      esac
+      [ "$fixture_scenario" != failed_mount_lookup ] || return 1
+      if [ "$path" = "$fixture_target" ]; then test -f "$fixture_case_root/mounted-state" || return 32
+      elif [ "$path" = "$fixture_log_target" ]; then test -f "$fixture_case_root/mounted-log" || return 32
+      else return 32
+      fi
+    }
+    dirname() { [ "$fixture_scenario" != failed_lookup ] || return 1; command dirname "$@"; }
+    mkdir() {
+      [ "$fixture_scenario" != failed_mkdir ] || return 1
+      if ! "$fixture_bind_state" && [[ "$*" == *"$fixture_source"* ]]; then return 1; fi
+      command mkdir "$@"
+    }
+    mount() {
+      printf '%s\n' "$*" >> "$fixture_case_root/mount-calls"
+      local from="${*: -2:1}" to="${*: -1}" options="$4"
+      if [ "$to" = "$fixture_target" ]; then printf '%s\n' "$options" >> "$fixture_case_root/target-options"; fi
+      if [ "$to" = "$fixture_backing" ]; then
+        [ "$fixture_scenario" != missing_backing ] && [ "$fixture_scenario" != failed_required_remount ]; return
+      fi
+      if [ "$to" = "$fixture_bridge" ]; then return 0; fi
+      if [ "$to" = "$fixture_dependency" ]; then [ "$fixture_scenario" != missing_dependency ]; return; fi
+      if [ "$to" = "$fixture_case_root/unrelated" ]; then [ "$fixture_scenario" != failed_unrelated ]; return; fi
+      [ "$fixture_scenario" != failed_bind ] && [ "$fixture_scenario" != failed_remount ] || return 1
+      if [[ "$options" != remount,* ]]; then
+        if "$fixture_bind_state"; then
+          rmdir "$to" || return 1
+          if [ "$fixture_scenario" = wrong_result ]; then ln -s "$fixture_backing" "$to" || return 1
+          else ln -s "$from" "$to" || return 1
+          fi
+        elif [ "$fixture_scenario" = wrong_result ]; then return 0
+        fi
+        if [ "$to" = "$fixture_target" ]; then touch "$fixture_case_root/mounted-state"; else touch "$fixture_case_root/mounted-log"; fi
+      fi
+    }
+    . "$fixture_case_root/activation.sh"
+    touch "$fixture_case_root/allocator-reached"
+  ) > "$fixture_case_root/output" 2>&1
+  status=$?
+  set -e
+  case "$fixture_scenario" in
+    fresh|missing_parents|existing_metadata|matching_live|matching_backing|root_backing|absent_undeclared|failed_unrelated)
+      [ "$status" = 0 ] && [ -f "$fixture_case_root/allocator-reached" ] || { cat "$fixture_case_root/output"; exit 1; }
+      if "$fixture_bind_state"; then [ "$fixture_source" -ef "$fixture_target" ]; else [ -f "$fixture_source" ]; fi
+      if "$exact"; then [ "$log_source" -ef "$fixture_log_target" ]; fi
+      [ "$(wc -l < "$fixture_case_root/mount-calls")" = "$expected_calls" ]
+      if [ "$fixture_scenario" = matching_live ]; then
+        [ "$(cat "$fixture_case_root/target-options")" = "remount,$expected_selected_options" ]
+        [ "$(grep -Fc -- " $fixture_target" "$fixture_case_root/mount-calls")" = 1 ]
+        [ "$(cat "$fixture_target/payload")" = 'matching data' ]
+      fi ;;
+    *) [ "$status" != 0 ] && [ ! -f "$fixture_case_root/allocator-reached" ] || { cat "$fixture_case_root/output"; exit 1; } ;;
+  esac
+  if [ "$fixture_scenario" = existing_metadata ]; then
+    [ "$before_metadata" = "$(stat -c '%u:%g:%a:%i' "$metadata_path")" ]
+    [ "$(cat "$metadata_path/payload")" = 'existing data' ]
+  fi
+  if [ "$fixture_scenario" = fresh ]; then
+    if "$fixture_bind_state"; then [ "$(stat -c '%a' "$fixture_source")" = 755 ]; fi
+    [ "$(stat -Lc '%a' "$fixture_target")" = 755 ]
+  fi
+  if [ "$fixture_scenario" = missing_parents ]; then
+    [ "$(stat -c '%a' "$fixture_source")" = 755 ]
+    [ "$(stat -c '%a' "$(dirname "$fixture_source")")" = 755 ]
+  fi
+  case "$fixture_scenario" in
+    wrong_backing|missing_backing|failed_required_remount|missing_dependency) [ ! -e "$fixture_source" ]; [ ! -e "$fixture_host/nixos" ] ;;
+    missing_backing_source) [ ! -e "$fixture_host" ] ;;
+    missing_transitive) [ ! -e "$fixture_host/bridge" ] ;;
+    wrong_live) [ ! -e "$fixture_source" ]; [ "$fixture_target" -ef "$fixture_case_root/wrong" ] ;;
+    failed_remount) [ -f "$fixture_case_root/mounted-state" ]; [ "$(cat "$fixture_target/payload")" = 'matching data' ] ;;
+  esac
+  printf 'PASS %s %s\n' "$mode" "$fixture_scenario"
+done
