    multi_dir=`echo ${ml} | sed -e 's/;.*$//'`; \
    flags=`echo ${ml} | sed -e 's/^[^;]*;//' -e 's/@/ -/g'`; \
    sfx=`/build/build/./gcc/xgcc -B/build/build/./gcc/  ${flags} -print-sysroot-headers-suffix`; \
    if [ "${multi_dir}" = "." ]; \
