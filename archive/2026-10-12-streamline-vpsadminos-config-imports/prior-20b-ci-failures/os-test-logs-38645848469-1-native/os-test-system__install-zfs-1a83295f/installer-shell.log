        networking.nameservers = [ "10.0.2.3" ];
        networking.useDHCP = true;
        system.vpsadminos.enableUnstable = false;
        osctl.test-shell = {
          enable = true;
          shells = 1;
        };

EOF
echo "}" >> "$tmp"
cat "$tmp" > /mnt/etc/vpsadminos/configuration.nix
