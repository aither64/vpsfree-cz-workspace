START: 2026-10-15 16:08:16 +0200
COMMAND: set -eu
marker=/tmp/vpsadminos-host-bpftrace-marker
pidfile=/tmp/vpsadminos-host-bpftrace-marker.pid
logfile=/tmp/vpsadminos-host-bpftrace-marker.log

rm -f "$marker" "$pidfile" "$logfile"
# A renamed coreutils multi-call symlink dispatches by argv[0] and fails.
# Execute a real script at the exact path observed by the tracepoint.
printf '#!/bin/sh\nexit 0\n' > "$marker"
chmod 0755 "$marker"
"$marker"
(
  end=$(( $(date +%s) + 240 ))
  while [ "$(date +%s)" -lt "$end" ]; do
    "$marker" || exit 1
    sleep 0.05
  done
) >"$logfile" 2>&1 &
echo $! >"$pidfile"
END: 2026-10-15 16:08:16 +0200
ELAPSED: 0.03s
STATUS: 0
OUTPUT:

