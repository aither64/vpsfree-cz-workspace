+++ b/tests/nixos-container-persistence-eval.nix
@@ -0,0 +1,239 @@
+# Evaluate generated activation text without building or mounting anything.
+let
+  vpsadminos = builtins.getFlake (toString ../.);
+  fixtures = import ./fixtures/nixos-container-releases.nix { inherit vpsadminos; };
+  lib = vpsadminos.inputs.nixpkgs.lib;
+  baselineDirectory = builtins.getEnv "VPSADMINOS_PERSISTENCE_BASELINE";
+  rawPath =
+    release:
+    if release == "unstable" then "unstable/vpsadminos.nix" else "stable/vpsadminos-${release}.nix";
+  raw = release: import (../os/lib/nixos-container + "/${rawPath release}");
+  persistence = {
+    imports = [ vpsadminos.inputs.impermanence.nixosModules.impermanence ];
+    environment.persistence."/persistent" = {
+      hideMounts = true;
+      directories = [
+        "/var/lib/nixos"
+        "/var/log"
+      ];
+    };
+  };
+  evaluate =
+    release: module: extra:
+    (fixtures.${release}.lib.nixosSystem {
+      system = "x86_64-linux";
+      modules = [
+        module
+        {
+          system.stateVersion = "22.11";
+          fileSystems."/" = {
+            device = "none";
+            fsType = "tmpfs";
+          };
+        }
+      ]
+      ++ extra;
+    }).config;
+  check = label: condition: if condition then true else throw "Persistence check failed: ${label}";
+  contains = needle: text: lib.hasInfix (builtins.unsafeDiscardStringContext needle) text;
+  matches = needle: text: lib.filter (contains needle) (lib.splitString "\n" text);
+  position =
+    needle: text:
+    let
+      lines = lib.splitString "\n" text;
+      numbered = lib.imap0 (index: line: { inherit index line; }) lines;
+    in
+    (lib.findFirst (entry: contains needle entry.line) { index = -1; } numbered).index;
+  forceScript = c: builtins.deepSeq c.system.activationScripts.script true;
+  failed = c: !(builtins.tryEval (forceScript c)).success;
+  manualBind = source: target: {
+    what = source;
+    where = target;
+    type = "none";
+    options = "bind,x-gvfs-hide";
+  };
+  script = c: c.system.activationScripts.script;
+  checkRelease =
+    release:
+    let
+      ordinary = evaluate release (raw release) [ ];
+      persisted = evaluate release (raw release) [ persistence ];
+      standaloneFile = builtins.toFile "vpsadminos-persistence-${release}.nix" (
+        builtins.readFile (../os/lib/nixos-container + "/${rawPath release}")
+      );
+      standalone = evaluate release (import standaloneFile) [ persistence ];
+      current = script persisted;
+      upstreamSource = "source ${persisted.system.build.earlyMountScript}";
+      step = "#### Activation script snippet vpsadminosPersistedState:";
+      alternative =
+        backend:
+        evaluate release (raw release) [
+          persistence
+          {
+            systemd.sysusers.enable = backend == "sysusers";
+            services.userborn.enable = backend == "userborn";
+          }
+        ];
+      baseline = extra: evaluate release (import (baselineDirectory + "/${rawPath release}")) extra;
+      ancestry = evaluate release (raw release) [
+        {
+          systemd.mounts = [
+            (manualBind "/persistent/state" "/var/lib/nixos")
+            (manualBind "/var/lib/nixos/log" "/var/log")
+          ];
+        }
+      ];
+      crossPhase = evaluate release (raw release) [
+        {
+          systemd.mounts = [
+            (manualBind "/persistent/state" "/var/lib/nixos")
+            (manualBind "/var/lib/nixos/store" "/nix")
+          ];
+        }
+      ];
+      cycle = evaluate release (raw release) [
+        {
+          systemd.mounts = [
+            (manualBind "/var/log/state" "/var/lib/nixos")
+            (manualBind "/var/lib/nixos/log" "/var/log")
+          ];
+        }
+      ];
+      duplicate = evaluate release (raw release) [
+        persistence
+        {
+          boot.specialFileSystems."/var/lib/nixos" = {
+            device = "/another/state";
+            fsType = "none";
+            options = [ "bind" ];
+          };
+        }
+      ];
+      relative = evaluate release (raw release) [
+        {
+          systemd.mounts = [ (manualBind "relative/state" "/var/lib/nixos") ];
+        }
+      ];
+      direct = evaluate release (raw release) [
+        {
+          fileSystems."/var/log" = {
+            device = "/direct/log";
+            fsType = "none";
+            options = [ "bind" ];
+          };
+        }
+      ];
+    in
+    {
+      actualRelease = persisted.system.nixos.release;
+      legacyOrder = check "${release} specialfs -> persisted state -> users" (
+        position upstreamSource current >= 0
+        && position step current >= 0
+        && position "-update-users-groups.pl" current >= 0
+        && position upstreamSource current < position step current
+        && position step current < position "-update-users-groups.pl" current
+        && persisted.system.activationScripts.vpsadminosPersistedState.deps == [ "specialfs" ]
+        && builtins.elem "vpsadminosPersistedState" persisted.system.activationScripts.users.deps
+        && builtins.length (matches "specialMount()" current) == 1
+        && builtins.length (matches upstreamSource current) == 1
+      );
+      preservedUnits = check "${release} bindings and options remain in systemd units" (
+        lib.all
+          (target: lib.any (m: m.where == target && m.options == "bind,x-gvfs-hide") persisted.systemd.mounts)
+          [
+            "/var/lib/nixos"
+            "/var/log"
+          ]
+        && !(persisted.boot.specialFileSystems ? "/var/lib/nixos")
+        && !(persisted.boot.specialFileSystems ? "/var/log")
+      );
+      standalone = check "${release} copied raw file retains complete activation behavior" (
+        script standalone == current
+      );
+      dry = check "${release} dry activation has no preparation or mount work" (
+        !contains "vpsadminosMountPersistedState" persisted.system.dryActivationScript
+        && !contains "mount -t" persisted.system.dryActivationScript
+        && contains "-update-users-groups.pl" persisted.system.dryActivationScript
+      );
+      ordinary = check "${release} no selected bindings" (
+        !(ordinary.system.activationScripts ? vpsadminosPersistedState)
+        && !builtins.elem "vpsadminosPersistedState" ordinary.system.activationScripts.users.deps
+        && forceScript ordinary
+      );
+      ancestry =
+        let
+          statePosition = position (lib.escapeShellArgs [
+            "/persistent/state"
+            "/var/lib/nixos"
+          ]) (script ancestry);
+          logPosition = position (lib.escapeShellArgs [
+            "/var/lib/nixos/log"
+            "/var/log"
+          ]) (script ancestry);
+        in
+        check "${release} selected source ancestry determines order" (
+          statePosition >= 0 && logPosition >= 0 && statePosition < logPosition
+        );
+      topology = check "${release} generated scripts force topology errors" (
+        failed crossPhase && failed cycle && failed duplicate && failed relative
+      );
+      directFilesystem = check "${release} direct filesystem definitions stay upstream" (
+        !(direct.system.activationScripts ? vpsadminosPersistedState)
+        && direct.boot.specialFileSystems."/var/log".device == "/direct/log"
+        && forceScript direct
+      );
+      alternatives = lib.genAttrs [ "sysusers" "userborn" ] (
+        backend:
+        let
+          c = alternative backend;
+        in
+        check "${release} ${backend} retains original promotion and users shape" (
+          !(c.system.activationScripts ? vpsadminosPersistedState)
+          && c.system.activationScripts.users == ""
+          && c.boot.specialFileSystems."/var/lib/nixos".device == "/persistent/var/lib/nixos"
+          && c.boot.specialFileSystems."/var/log".device == "/persistent/var/log"
+          && forceScript c
+        )
+      );
+      priorV2 =
+        if baselineDirectory == "" then
+          "not requested"
+        else
+          check "${release} ordinary and alternate scripts exactly match prior v2" (
+            script ordinary == script (baseline [ ])
+            && ordinary.system.dryActivationScript == (baseline [ ]).system.dryActivationScript
+            &&
+              lib.all
+                (
+                  backend:
+                  let
+                    old = baseline [
+                      persistence
+                      {
+                        systemd.sysusers.enable = backend == "sysusers";
+                        services.userborn.enable = backend == "userborn";
+                      }
+                    ];
+                    c = alternative backend;
+                  in
+                  script c == script old && c.system.dryActivationScript == old.system.dryActivationScript
+                )
+                [
+                  "sysusers"
+                  "userborn"
+                ]
+          );
+    };
+in
+{
+  releases = lib.genAttrs [ "25.11" "26.05" "unstable" ] checkRelease;
+  latestStable = check "latest stable is self-contained and equivalent to 26.05" (
+    builtins.readFile ../os/lib/nixos-container/stable/vpsadminos.nix
+    == builtins.readFile ../os/lib/nixos-container/stable/vpsadminos-26.05.nix
+  );
+  # The shell harness reads this actual generated snippet and substitutes only
+  # its configured source/destination arguments with temporary fixture paths.
+  shellFixture =
+    (evaluate "26.05" (raw "26.05") [ persistence ])
+    .system.activationScripts.vpsadminosPersistedState.text;
+}
