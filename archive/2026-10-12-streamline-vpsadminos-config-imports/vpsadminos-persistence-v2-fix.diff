+#!/usr/bin/env bash
+# Command doubles exercise the actual generated activation snippet. No mounts
+# or account operations are performed; all filesystem changes stay in fixtures.
+set -euo pipefail
+snippet=$1
+fixture_root=$(mktemp -d)
+trap 'rm -rf "$fixture_root"' EXIT
+
+for scenario in fresh existing_metadata missing_backing root_backing failed_bind matching_live wrong_live failed_lookup failed_mount_lookup wrong_result source_file; do
+  case_root="$fixture_root/$scenario"
+  backing="$case_root/backing storage"
+  source="$backing/state"
+  target="$case_root/state target"
+  log_source="$backing/log"
+  log_target="$case_root/log target"
+  mkdir -p "$backing"
+  before_metadata=
+  case "$scenario" in
+    existing_metadata)
+      mkdir "$source"
+      chmod 0710 "$source"
+      printf 'existing data\n' > "$source/payload"
+      before_metadata=$(stat -c '%u:%g:%a:%i' "$source")
+      ;;
+    matching_live)
+      mkdir "$source"
+      ln -s "$source" "$target"
+      touch "$case_root/mounted-state"
+      ;;
+    wrong_live)
+      mkdir "$case_root/wrong"
+      ln -s "$case_root/wrong" "$target"
+      touch "$case_root/mounted-state"
+      ;;
+    missing_backing) rmdir "$backing" ;;
+    source_file) touch "$source" ;;
+    failed_mount_lookup) mkdir "$target" ;;
+  esac
+
+  # Replace only the configured call arguments, including paths with spaces.
+  sed \
+    -e "s|/persistent/var/lib/nixos|'$source'|g" \
+    -e "s|/persistent/var/log|'$log_source'|g" \
+    -e "s|/var/lib/nixos|'$target'|g" \
+    -e "s|/var/log|'$log_target'|g" \
+    "$snippet" > "$case_root/activation.sh"
+  bash -n "$case_root/activation.sh"
+
+  # Run in a child shell so the actual explicit exit can prevent the allocator
+  # marker, even with NixOS's non-fatal ERR trap and conditional helper calls.
+  set +e
+  (
+    set +e
+    umask 0022
+    _status=0
+    trap '_status=1' ERR
+    findmnt() {
+      local path="${*: -1}"
+      [ "$scenario" != failed_lookup ] || return 1
+      if [ "$path" = / ] || [ "$scenario" = root_backing ] || [ "$scenario" = missing_backing ]; then
+        printf '1\n'
+      else
+        printf '42\n'
+      fi
+    }
+    mountpoint() {
+      local path="${*: -1}"
+      [ "$scenario" != failed_mount_lookup ] || return 1
+      if [ "$path" = "$case_root/state target" ]; then
+        test -f "$case_root/mounted-state" || return 32
+      else
+        test -f "$case_root/mounted-log" || return 32
+      fi
+    }
+    mount() {
+      printf '%s\n' "$*" >> "$case_root/mount-calls"
+      [ "$scenario" != failed_bind ] || return 1
+      local from="${*: -2:1}" to="${*: -1}" options="$4"
+      if [[ "$options" != remount,* ]]; then
+        rmdir "$to" || return 1
+        if [ "$scenario" = wrong_result ]; then
+          ln -s "$case_root/backing storage" "$to" || return 1
+        else
+          ln -s "$from" "$to" || return 1
+        fi
+        if [ "$to" = "$case_root/state target" ]; then touch "$case_root/mounted-state"; else touch "$case_root/mounted-log"; fi
+      fi
+    }
+    . "$case_root/activation.sh"
+    touch "$case_root/allocator-reached"
+  ) > "$case_root/output" 2>&1
+  status=$?
+  set -e
+  case "$scenario" in
+    fresh|existing_metadata|matching_live)
+      [ "$status" = 0 ] && [ -f "$case_root/allocator-reached" ] || { cat "$case_root/output"; exit 1; }
+      [ "$source" -ef "$target" ] && [ "$log_source" -ef "$log_target" ]
+      [ "$(wc -l < "$case_root/mount-calls")" = 2 ]
+      if [ "$scenario" = matching_live ]; then
+        [[ "$(head -n 1 "$case_root/mount-calls")" == *'remount,bind,x-gvfs-hide'* ]]
+      else
+        [[ "$(head -n 1 "$case_root/mount-calls")" == *'-o bind,x-gvfs-hide'* ]]
+      fi
+      ;;
+    *)
+      [ "$status" != 0 ] && [ ! -f "$case_root/allocator-reached" ] || { cat "$case_root/output"; exit 1; }
+      case "$scenario" in
+        wrong_live|missing_backing|root_backing|failed_lookup|failed_mount_lookup|source_file) [ ! -f "$case_root/mount-calls" ] ;;
+      esac
+      ;;
+  esac
+  if [ "$scenario" = existing_metadata ]; then
+    [ "$before_metadata" = "$(stat -c '%u:%g:%a:%i' "$source")" ]
+    [ "$(cat "$source/payload")" = 'existing data' ]
+  fi
+  if [ "$scenario" = fresh ]; then
+    [ "$(stat -c '%a' "$source")" = 755 ]
+  fi
+  if [ "$scenario" = wrong_live ]; then
+    [ ! -e "$source" ]
+    [ "$target" -ef "$case_root/wrong" ]
+  fi
+  printf 'PASS %s\n' "$scenario"
+done
