START: 2026-06-10 12:14:47 +0200
COMMAND: set -euo pipefail
api_dir="$(systemctl show -p WorkingDirectory --value vpsadmin-api)"
api_root="$(dirname "$api_dir")"
tmp_rb="$(mktemp /tmp/vpsadmin-storage-XXXX.rb)"
trap 'rm -f "$tmp_rb"' EXIT

cat > "$tmp_rb" <<'RUBY'
ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.find(1)
User.current = user
UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'console-router-integration'
)


vps = Vps.find(1)
chain, password = VpsAdmin::API::Operations::Vps::Passwd.run(
  vps,
  'secure'
)

puts JSON.dump(chain_id: chain.id, password: password)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
END: 2026-06-10 12:14:51 +0200
ELAPSED: 3.3s
STATUS: 0
OUTPUT:
{"chain_id":3,"password":"AfoBfaOj8xGH8Ky0euuz"}
