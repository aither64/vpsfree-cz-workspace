NAME
    ls - List containers

SYNOPSIS

    osctl [global options] ct ls [command options] [ctid...]

COMMAND OPTIONS
    -H, --hide-header               - Do not show header
    -L, --list                      - List available parameters
    -S, --state=state               - Filter by state, comma separated (default:
                                      none)
    --arch=arch                     - Filter by distribution arch, comma
                                      separated (default: none)
    -d, --distribution=distribution - Filter by distribution, comma separated
                                      (default: none)
    -e, --ephemeral                 - Filter ephemeral containers
    -g, --group=group               - Filter by group name, comma separated
                                      (default: none)
    -o, --output=parameters         - Select parameters to output (default:
                                      none)
    -p, --persistent                - Filter persistent (non-ephemeral)
                                      containers
    --pool=pool                     - Filter by pool, comma separated (default:
                                      none)
    -s, --sort=parameters           - Sort by parameter(s) (default: none)
    -u, --user=user                 - Filter by user name, comma separated
                                      (default: none)
    -v, --version=version           - Filter by distribution version, comma
                                      separated (default: none)
    --variant=variant               - Filter by distribution variant, comma
                                      separated (default: none)
    --vendor=vendor                 - Filter by distribution vendor, comma
                                      separated (default: none)


