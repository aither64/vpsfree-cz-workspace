START: 2026-06-10 11:38:12 +0200
COMMAND: set -euo pipefail
api_dir="$(systemctl show -p WorkingDirectory --value vpsadmin-api)"
api_root="$(dirname "$api_dir")"
tmp_rb="$(mktemp /tmp/vpsadmin-storage-XXXX.rb)"
trap 'rm -f "$tmp_rb"' EXIT

cat > "$tmp_rb" <<'RUBY'
ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
vps = Vps.find(2)
dip = vps.dataset_in_pool

puts JSON.dump(
  dataset_id: dip.dataset_id,
  dataset_in_pool_id: dip.id,
  refquota: dip.refquota,
  dataset_full_name: dip.dataset.full_name,
  pool_id: dip.pool_id,
  pool_filesystem: dip.pool.filesystem
)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
END: 2026-06-10 11:38:15 +0200
ELAPSED: 2.89s
STATUS: 0
OUTPUT:
{"dataset_id":2,"dataset_in_pool_id":2,"refquota":10240,"dataset_full_name":"2","pool_id":2,"pool_filesystem":"tank/ct-replace-no-start"}
