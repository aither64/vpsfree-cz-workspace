  scope: ['all'],
  token: token,
  token_str: token.token,
  token_lifetime: :permanent,
  label: 'Download mounter integration'
)
token.update!(owner: session)

puts JSON.dump(token: token.token)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
