++  def wait_for_chain!(chain, timeout: 300)
++    return unless chain
++
++    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
++    loop do
++      check_deadline!
++      chain.reload
++      if chain.state == 'done'
