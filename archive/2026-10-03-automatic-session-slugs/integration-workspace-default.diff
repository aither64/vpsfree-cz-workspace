++		}
++		if _, present := item["tools"]; present {
++			return names, errors.New("unexpected tool role")
++		}
++	}
++	if _, present := request["additional_tools"]; present {
++		return names, errors.New("unexpected tool role")
++	}
++	return names, nil
++}
