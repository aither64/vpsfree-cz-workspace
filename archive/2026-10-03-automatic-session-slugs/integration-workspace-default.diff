++func (h *ephemeralIntegrationHarness) timeoutFaultExercised(generation uint64, mode string) bool {
++	want := ""
++	switch mode {
++	case "timeout-config":
++		want = "config/read"
++	case "timeout-model":
++		want = "model/list"
++	default:
++		return false
++	}
++	h.mu.Lock()
++	defer h.mu.Unlock()
++	return generation == h.diagnosticGeneration && h.withheldResponse == want
++}
