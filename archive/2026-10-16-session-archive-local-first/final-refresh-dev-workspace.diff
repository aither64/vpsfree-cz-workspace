index 0000000..37a5eae
--- /dev/null
+++ b/portal/internal/session/tracking_sync.go
@@ -0,0 +1,79 @@
+package session
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+)
+
+type TrackingSyncStatus struct {
+	State     string `json:"state"`
+	Error     string `json:"error,omitempty"`
+	UpdatedAt string `json:"updatedAt,omitempty"`
+}
+
+type ArchiveProgress struct {
+	Schema      int    `json:"schema"`
+	Workspace   string `json:"workspace"`
+	Slug        string `json:"slug"`
+	OperationID string `json:"operation_id"`
+	Stage       string `json:"stage"`
+	Path        string `json:"path,omitempty"`
+	UpdatedAt   string `json:"updated_at"`
+}
+
+func ReadArchiveProgress(workspace, stateRoot, slug, operationID string) *ArchiveProgress {
+	if stateRoot == "" || !slugPattern.MatchString(slug) || operationID == "" {
+		return nil
+	}
+	identity := sha256.Sum256([]byte(workspace))
+	data, err := os.ReadFile(filepath.Join(stateRoot, "archive-progress", hex.EncodeToString(identity[:]), slug+".json"))
+	var progress ArchiveProgress
+	if err != nil || len(data) > 64*1024 || json.Unmarshal(data, &progress) != nil || progress.Schema != 1 ||
+		progress.Workspace != workspace || progress.Slug != slug || progress.OperationID != operationID {
+		return nil
+	}
+	return &progress
+}
+
+func ReadTrackingSync(workspace, stateRoot, slug string) (*TrackingSyncStatus, error) {
+	if !slugPattern.MatchString(slug) {
+		return nil, errors.New("invalid tracking sync session")
+	}
+	if stateRoot == "" {
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return nil, err
+		}
+		stateHome := os.Getenv("XDG_STATE_HOME")
+		if stateHome == "" {
+			stateHome = filepath.Join(home, ".local", "state")
+		}
+		stateRoot = filepath.Join(stateHome, "dev-workspaces")
+	}
+	identity := sha256.Sum256([]byte(workspace))
+	path := filepath.Join(stateRoot, "tracking-sync", hex.EncodeToString(identity[:]), slug+".json")
+	data, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var receipt struct {
+		Schema    int    `json:"schema"`
+		Workspace string `json:"workspace"`
+		Slug      string `json:"slug"`
+		State     string `json:"state"`
+		Error     string `json:"error"`
+		UpdatedAt string `json:"updated_at"`
+	}
+	if len(data) > 64*1024 || json.Unmarshal(data, &receipt) != nil || receipt.Schema != 1 ||
+		receipt.Workspace != workspace || receipt.Slug != slug || (receipt.State != "pending" && receipt.State != "synced") {
+		return nil, errors.New("invalid tracking sync receipt")
+	}
+	return &TrackingSyncStatus{receipt.State, receipt.Error, receipt.UpdatedAt}, nil
+}
diff --git a/portal/internal/web/archive_worker.go b/portal/internal/web/archive_worker.go
new file mode 100644
index 0000000..d9527da
--- /dev/null
+++ b/portal/internal/web/archive_worker.go
@@ -0,0 +1,112 @@
+package web
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/aither64/dev-workspace/portal/internal/processgroup"
+)
+
+// The user manager owns the archive process independently of portal lifetime.
+// Retain the exited unit until the portal has a durable terminal receipt.
+func (s *Server) supervisedArchives() bool {
+	return s.config.HostProfile != "" && s.config.PackageRoot != "" && s.config.WorkspaceName != ""
+}
+
+func archiveUnit(operation lifecycleOperation) string {
+	return "workspace-archive-" + operation.ReceiptID + "-" + strconv.Itoa(operation.Attempt) + ".service"
+}
+
+type archiveWorkerStatus struct {
+	State, Error, FinishedAt string
+}
+
+func (s *Server) archiveWorker(ctx context.Context, operation lifecycleOperation) (*archiveWorkerStatus, error) {
+	if !s.supervisedArchives() || operation.Kind != "archive" || operation.ReceiptID == "" {
+		return nil, nil
+	}
+	readCtx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	output, err := processgroup.CombinedOutput(readCtx, exec.Command("systemctl", "--user", "--timestamp=unix", "show", archiveUnit(operation),
+		"--property=LoadState,ActiveState,SubState,ExecMainCode,ExecMainStatus,ExecMainExitTimestamp"))
+	if err != nil {
+		return nil, fmt.Errorf("read archive worker: %w", err)
+	}
+	values := map[string]string{}
+	for _, line := range strings.Split(string(output), "\n") {
+		key, value, ok := strings.Cut(line, "=")
+		if ok {
+			values[key] = value
+		}
+	}
+	if values["LoadState"] == "not-found" || values["LoadState"] == "" {
+		return nil, nil
+	}
+	if values["ActiveState"] == "activating" || values["SubState"] == "running" || values["SubState"] == "start" {
+		return &archiveWorkerStatus{State: "running"}, nil
+	}
+	if values["SubState"] == "exited" && values["ExecMainStatus"] == "0" {
+		return &archiveWorkerStatus{State: "complete", FinishedAt: archiveFinishTime(values["ExecMainExitTimestamp"])}, nil
+	}
+	logs, _ := processgroup.CombinedOutput(readCtx, exec.Command("journalctl", "--user", "--unit="+archiveUnit(operation), "--no-pager", "--output=cat", "--lines=24"))
+	cause := fmt.Sprintf("archive worker ended (code %s, status %s)", values["ExecMainCode"], values["ExecMainStatus"])
+	return &archiveWorkerStatus{State: "failed", Error: boundedLifecycleError(cause + "\n" + string(logs)), FinishedAt: archiveFinishTime(values["ExecMainExitTimestamp"])}, nil
+}
+
+func archiveFinishTime(value string) string {
+	seconds, err := strconv.ParseFloat(strings.TrimPrefix(strings.TrimSpace(value), "@"), 64)
+	if err != nil || seconds <= 0 {
+		return ""
+	}
+	return time.Unix(int64(seconds), int64((seconds-float64(int64(seconds)))*1e9)).UTC().Format(time.RFC3339Nano)
+}
+
+func (s *Server) runSupervisedArchive(ctx context.Context, slug string, args []string) error {
+	s.operationMu.Lock()
+	operation, ok := s.operations[slug]
+	s.operationMu.Unlock()
+	if !ok || operation.Kind != "archive" || operation.ReceiptID == "" {
+		return errors.New("archive has no durable operation receipt")
+	}
+	commandArgs := []string{"--user", "--quiet", "--unit=" + archiveUnit(operation),
+		"--property=Type=exec", "--property=RemainAfterExit=yes", "--property=TimeoutStartSec=infinity",
+		"--property=KillMode=control-group", "--property=WorkingDirectory=" + s.config.Workspace,
+		"--setenv=DEV_WORKSPACE_NAME=" + s.config.WorkspaceName,
+		"--setenv=DEV_WORKSPACES_PROFILE=" + s.config.HostProfile}
+	if s.config.UserStateRoot != "" {
+		commandArgs = append(commandArgs, "--setenv=DEV_WORKSPACES_STATE="+s.config.UserStateRoot)
+	}
+	commandArgs = append(commandArgs, "--", filepath.Join(s.config.PackageRoot, "bin", "dev-session"))
+	commandArgs = append(commandArgs, args...)
+	startCtx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	output, err := processgroup.CombinedOutput(startCtx, exec.Command("systemd-run", commandArgs...))
+	cancel()
+	if err != nil {
+		return commandFailure("start archive worker", "", string(output), err)
+	}
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	for {
+		status, err := s.archiveWorker(ctx, operation)
+		if err != nil {
+			return err // The independent unit retains execution ownership.
+		}
+		if status != nil && status.State == "complete" {
+			return nil
+		}
+		if status != nil && status.State == "failed" {
+			return errors.New(status.Error)
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err() // Never cancel the worker on portal shutdown.
+		case <-ticker.C:
+		}
+	}
+}
diff --git a/portal/internal/web/archive_worker_test.go b/portal/internal/web/archive_worker_test.go
new file mode 100644
index 0000000..1e52256
--- /dev/null
+++ b/portal/internal/web/archive_worker_test.go
@@ -0,0 +1,103 @@
+package web
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestArchiveWorkerContinuesAcrossPortalCancellation(t *testing.T) {
+	directory := t.TempDir()
+	statusPath := filepath.Join(directory, "status")
+	launchPath := filepath.Join(directory, "launch")
+	for name, script := range map[string]string{
+		"systemd-run": "#!/bin/sh\nprintf '%s\\n' \"$@\" >\"$ARCHIVE_TEST_LAUNCH.tmp\"\nmv \"$ARCHIVE_TEST_LAUNCH.tmp\" \"$ARCHIVE_TEST_LAUNCH\"\n",
+		"systemctl":   "#!/bin/sh\ncat \"$ARCHIVE_TEST_STATUS\"\n",
+	} {
+		if err := os.WriteFile(filepath.Join(directory, name), []byte(script), 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Setenv("PATH", directory+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("ARCHIVE_TEST_STATUS", statusPath)
+	t.Setenv("ARCHIVE_TEST_LAUNCH", launchPath)
+	if err := os.WriteFile(statusPath, []byte("LoadState=loaded\nActiveState=active\nSubState=running\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	operation := lifecycleOperation{Slug: "example", Kind: "archive", State: "running", ReceiptID: strings.Repeat("a", 64), Attempt: 1}
+	server := &Server{config: Config{Workspace: directory, WorkspaceName: "example", HostProfile: directory, PackageRoot: directory}, operations: map[string]lifecycleOperation{"example": operation}}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- server.runSupervisedArchive(ctx, "example", []string{"archive", "example", "--as-is"}) }()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		if _, err := os.Stat(launchPath); err == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("archive worker was not launched")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	cancel()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancel portal wait: %v", err)
+	}
+	launch, _ := os.ReadFile(launchPath)
+	if !strings.Contains(string(launch), "TimeoutStartSec=infinity") || strings.Contains(string(launch), "--wait") {
+		t.Fatalf("worker lifetime is coupled to portal: %s", launch)
+	}
+	store, err := newLifecycleOperationStore(directory, t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	operation.State = "failed"
+	operation.Phase = "starting"
+	operation.StartedAt = time.Now().Add(-time.Minute).UTC().Format(time.RFC3339Nano)
+	operation.UpdatedAt = operation.StartedAt
+	operation.FinishedAt = operation.StartedAt
+	operation.Options.Mode = "archived"
+	operation.Redirect = "/"
+	if err := store.save(map[string]lifecycleOperation{"example": operation}); err != nil {
+		t.Fatal(err)
+	}
+	retained, err := store.load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	server.operationContext = context.Background()
+	reconciled, _, err := server.proposeLifecycleOperation("example", retained["example"], true, nil, nil, time.Now())
+	if err != nil || reconciled.State != "running" || reconciled.FinishedAt != "" {
+		t.Fatalf("stored receipt after observer restart: %#v, %v", reconciled, err)
+	}
+	if err := os.WriteFile(statusPath, []byte("LoadState=loaded\nActiveState=active\nSubState=exited\nExecMainStatus=0\nExecMainExitTimestamp=@1792174000.5\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	status, err := server.archiveWorker(context.Background(), operation)
+	if err != nil || status == nil || status.State != "complete" {
+		t.Fatalf("recover worker result after portal cancellation: %#v, %v", status, err)
+	}
+	reconciled, _, err = server.proposeLifecycleOperation("example", reconciled, true, nil, nil, time.Now())
+	wantFinish := time.Unix(1792174000, 500000000).UTC().Format(time.RFC3339Nano)
+	if err != nil || reconciled.State != "complete" || reconciled.FinishedAt != wantFinish {
+		t.Fatalf("worker final receipt timestamp: %#v, %v", reconciled, err)
+	}
+	if err := store.save(map[string]lifecycleOperation{"example": reconciled}); err != nil {
+		t.Fatal(err)
+	}
+	retained, err = store.load()
+	if err != nil || retained["example"].FinishedAt != wantFinish {
+		t.Fatalf("retained worker finish time: %#v, %v", retained, err)
+	}
+}
+
+func TestCommandFailurePreservesDeadlineOverSuccessfulFetchOutput(t *testing.T) {
+	err := commandFailure("archive session", "", "From github.com:example/workspace\n * branch master -> FETCH_HEAD", context.DeadlineExceeded)
+	if !errors.Is(err, context.DeadlineExceeded) || strings.Contains(err.Error(), "FETCH_HEAD") {
+		t.Fatalf("deadline hidden by fetch output: %v", err)
+	}
+}
