creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4495160Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4495625Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
