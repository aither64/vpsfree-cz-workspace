creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4483484Z # System-wide .bashrc file for interactive bash(1) shells.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4483792Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4484060Z # To enable the settings / commands in this file for login shells as well,
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4484636Z # this file has to be sourced in /etc/profile.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4484943Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4485124Z # If not running interactively, don't do anything
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4485537Z [ -z "$PS1" ] && return
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4485732Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4485930Z # check the window size after each command and, if necessary,
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4486375Z # update the values of LINES and COLUMNS.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4486745Z shopt -s checkwinsize
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4486928Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4487193Z # set variable identifying the chroot you work in (used in the prompt below)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4487923Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4488618Z     debian_chroot=$(cat /etc/debian_chroot)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4488965Z fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4489103Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4489327Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4489867Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4490275Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4490546Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4490776Z fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T14:53:51.4490867Z 
