+    def reconcile_fork_terminal!(slug, session, journal)
+      model, effort = journal.fetch('model'), journal.fetch('effort')
+      if @portal_command && codex_provenance_configured?
+        quiesced = quiesce_native_client!(slug, session)
+        begin
+          ensure_portal_thread_idle!(slug, @selected_authority)
+        rescue StandardError
+          restore_native_client!(slug, quiesced) if quiesced
+          raise
+        end
+        command = [*@portal_command, 'thread', 'ensure-settings',
+                   '--thread-id', session.codex_thread_id, '--user-state-root', @workspace_state_root]
+        environment = session_environment(slug)
+        THREAD_ENV_ARGUMENTS.each do |name, argument|
+          command += [argument, environment.fetch(name)] if environment.key?(name)
+        end
+        command += ['--require-runtime', '--model', model, '--effort', effort]
+        stdout, = @command_runner.capture(command)
+        actual = JSON.parse(stdout)
+        unless actual == { 'model' => model, 'reasoningEffort' => effort }
+          raise Error, "fork settings were not restored for #{slug}"
+        end
+      end
+      reconcile_native_client!(slug, session, model:, effort:)
+    rescue JSON::ParserError => e
+      raise Error, "workspace-portal returned invalid fork settings: #{e.message}"
+    end
+
     def native_provider_arguments(slug = nil)
