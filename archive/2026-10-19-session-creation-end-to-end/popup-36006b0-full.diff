+		t.Fatalf("removed compacted retry=%d %s", response.Code, response.Body.String())
+	}
+	if _, err := os.Stat(directory); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("removed destination recreated", err)
+	}
 }
 
