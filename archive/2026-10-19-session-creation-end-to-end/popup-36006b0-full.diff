+"""External Responses fixture for the packaged creation acceptance only.
+
+No portal, receipt, initializer or native App Server is replaced. Control files
+hold inference at an external boundary; requests remain observable on failure.
+"""
+import http.server
+import itertools
+import json
+import pathlib
+import threading
+import time
+
+ROOT = pathlib.Path("/tmp/creation-model")
+ROOT.mkdir(exist_ok=True)
+sequence = itertools.count(1)
+lock = threading.Lock()
+
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+    def json(self, value):
+        data = json.dumps(value).encode()
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(data)))
+        self.end_headers()
+        self.wfile.write(data)
+
+    def do_GET(self):
+        if self.path.endswith("/models"):
+            while (ROOT / "hold-models").exists():
+                (ROOT / "models-entered").touch()
+                time.sleep(0.05)
+            self.json({"object": "list", "data": [{"id": name, "object": "model"}
+                      for name in ["gpt-5.5", "gpt-6-luna"]]})
+        elif self.path.endswith("/usage"):
+            self.json({})
+        else:
+            self.send_error(404)
+
+    def do_POST(self):
+        if not self.path.endswith("/responses"):
+            self.send_error(404)
+            return
+        request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+        index = next(sequence)
+        provider = self.path.split("/")[1]
+        with lock:
+            with (ROOT / "requests.jsonl").open("a") as log:
+                log.write(json.dumps({"index": index, "provider": provider, "body": request}) + "\n")
+        naming = request.get("model") == "gpt-6-luna"
+        inputs = request.get("input", [])
+        last_user = next((item for item in reversed(inputs)
+                          if isinstance(item, dict) and item.get("role") == "user"), {})
+        if naming:
+            text = "invalid naming output" if (ROOT / "bad-name").exists() else json.dumps({"name": "accepted-session"})
+        elif "CREATION_PLAN_REQUEST" in json.dumps(last_user):
+            text = "<proposed_plan>\n# Creation acceptance plan\n\nReturn the CREATION_PLAN_DONE sentinel.\n</proposed_plan>"
+        else:
+            text = "CREATION_REPLY_" + provider
+        if not naming:
+            (ROOT / "turn-entered").touch()
+            while (ROOT / "hold-turn").exists():
+                time.sleep(0.05)
+        self.send_response(200)
+        self.send_header("Content-Type", "text/event-stream")
+        self.end_headers()
+
+        def event(value):
+            self.wfile.write(("data: " + json.dumps(value) + "\n\n").encode())
+            self.wfile.flush()
+
+        try:
+            identity = "response-" + str(index)
+            event({"type": "response.created", "response": {"id": identity}})
+            event({"type": "response.output_item.done", "item": {
+                "type": "message", "role": "assistant", "id": "answer-" + identity,
+                "phase": "final_answer", "content": [{"type": "output_text", "text": text}]}})
+            event({"type": "response.completed", "response": {"id": identity,
+                "usage": {"input_tokens": 1, "output_tokens": 1, "total_tokens": 2}}})
+        except (BrokenPipeError, ConnectionResetError):
+            pass
+
+
+http.server.ThreadingHTTPServer(("127.0.0.1", 2455), Handler).serve_forever()
diff --git a/test/creation_transport.py b/test/creation_transport.py
new file mode 100644
index 0000000..e9bdfa1
--- /dev/null
+++ b/test/creation_transport.py
@@ -0,0 +1,85 @@
+"""Transparent native transport fault and read-only proof, never RPC stubs.
+
+The proxy holds the actual successful turn/start response after Codex accepted
+the turn. Killing the portal at this barrier exercises an ambiguous initial send.
+"""
+import asyncio
+import json
+import pathlib
+import sys
+import tempfile
+
+import websockets
+
+
+async def proxy(listen, target):
+    async def connection(client):
+        async with websockets.unix_connect(target, max_size=16 * 1024 * 1024) as native:
+            starts = {}
+
+            async def upstream():
+                async for data in client:
+                    message = json.loads(data)
+                    if (message.get("method") == "thread/start" and
+                            message["params"].get("cwd", "").endswith("-before")):
+                        while pathlib.Path("/tmp/creation-model/hold-root-request").exists():
+                            pathlib.Path("/tmp/creation-model/root-entered").touch()
+                            await asyncio.sleep(0.025)
+                        if client.state.name != "OPEN":
+                            return
+                    if (message.get("method") == "turn/start" and
+                            "CREATION_INITIAL_after" in json.dumps(message["params"].get("input"))):
+                        starts[message["id"]] = message["params"]["threadId"]
+                    await native.send(data)
+
+            async def downstream():
+                async for data in native:
+                    message = json.loads(data)
+                    if message.get("id") in starts and "result" in message:
+                        with tempfile.NamedTemporaryFile(mode="w", dir="/tmp/creation-model", delete=False) as marker:
+                            json.dump({"threadId": starts[message["id"]],
+                                "turnId": message["result"]["turn"]["id"]}, marker)
+                        pathlib.Path(marker.name).replace("/tmp/creation-model/send-accepted")
+                        while pathlib.Path("/tmp/creation-model/hold-send-reply").exists():
+                            await asyncio.sleep(0.025)
+                    await client.send(data)
+
+            tasks = [asyncio.create_task(upstream()), asyncio.create_task(downstream())]
+            try:
+                done, _ = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
+                for task in done:
+                    task.result()
+            finally:
+                for task in tasks:
+                    task.cancel()
+
+    async with websockets.unix_serve(connection, listen, max_size=16 * 1024 * 1024):
+        pathlib.Path(listen).chmod(0o600)
+        await asyncio.Future()
+
+
+async def read(socket, identity):
+    async with websockets.unix_connect(socket, max_size=16 * 1024 * 1024) as native:
+        async def rpc(number, method, params):
+            await native.send(json.dumps({"id": number, "method": method, "params": params}))
+            while True:
+                result = json.loads(await native.recv())
+                if result.get("id") == number:
+                    assert "error" not in result, result
+                    return result["result"]
+
+        await rpc(1, "initialize", {"clientInfo": {"name": "creation-proof", "version": "1"},
+                                    "capabilities": {"experimentalApi": True}})
+        await native.send(json.dumps({"method": "initialized"}))
+        if identity == "inventory":
+            metadata = await rpc(2, "thread/list", {"limit": 100,
+                "modelProviders": ["primary", "alternate"], "sourceKinds": ["vscode"]})
+        else:
+            metadata = await rpc(2, "thread/read", {"threadId": identity, "includeTurns": True})
+        print(json.dumps(metadata))
+
+
+if sys.argv[1] == "proxy":
+    asyncio.run(proxy(*sys.argv[2:]))
+else:
+    asyncio.run(read(*sys.argv[2:]))
