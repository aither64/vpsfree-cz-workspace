creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4476332Z # System-wide .bashrc file for interactive bash(1) shells.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4476679Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4476883Z # To enable the settings / commands in this file for login shells as well,
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4477316Z # this file has to be sourced in /etc/profile.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4477517Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4477641Z # If not running interactively, don't do anything
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4477945Z [ -z "$PS1" ] && return
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4478089Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4478243Z # check the window size after each command and, if necessary,
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4478592Z # update the values of LINES and COLUMNS.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4478877Z shopt -s checkwinsize
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4479014Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4479222Z # set variable identifying the chroot you work in (used in the prompt below)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4479671Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4480317Z     debian_chroot=$(cat /etc/debian_chroot)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4480584Z fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4480683Z 
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4480855Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4481294Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4481893Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4482226Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4482505Z fi
creation	Run cachix/install-nix-action@v31.11.2	2026-10-19T17:14:39.4482597Z 
