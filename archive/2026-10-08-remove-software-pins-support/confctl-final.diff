-    def append_query(url, key, value)
-      separator = url.include?('?') ? '&' : '?'
-      "#{url}#{separator}#{key}=#{value}"
-    end
-
-    def nix_attr_key(name)
-      str = name.to_s
-      if str.match?(/\A[A-Za-z_][A-Za-z0-9_]*\z/)
-        str
-      else
-        "\"#{nix_string(str)}\""
-      end
-    end
