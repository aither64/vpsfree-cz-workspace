-
-      if change[:create]
-        FileUtils.mkdir_p(File.dirname(path))
-        content = <<~NIX
-          { ... }:
-          {
-            # confctl migrate swpins-to-flakes: legacy NIX_PATH compatibility
-            confctl.nix.impureEval = true;
-            confctl.nix.legacyNixPath = true;
-          }
