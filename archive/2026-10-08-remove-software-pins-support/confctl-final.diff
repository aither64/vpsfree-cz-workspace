-      lines = change[:content].lines
-      close_idx = lines.rindex { |line| line.strip == '}' }
-      close_idx ||= lines.rindex { |line| line.strip == '};' }
-      raise ConfCtl::Error, 'unable to edit configs/confctl.nix' unless close_idx
