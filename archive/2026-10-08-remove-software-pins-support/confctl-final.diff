-    def normalize_ref(ref)
-      return nil if ref.nil? || ref == ''
-
-      ref.sub(%r{\Arefs/(heads|tags)/}, '')
-    end
-
-    def github_repo_from_url(url)
-      m = url.match(%r{\Ahttps://github\.com/([^/]+)/([^/]+?)(?:\.git)?/?\z})
-      return nil unless m
-
-      [m[1], m[2]]
-    end
