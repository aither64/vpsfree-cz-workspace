    "steps": [
      {
        "name": "Save lock baseline",
        "script": "cp flake.lock \"$RUNNER_TEMP/flake-update-baseline.lock\"\necho \"UPDATE_OLD_LOCK=$RUNNER_TEMP/flake-update-baseline.lock\" >> \"$GITHUB_ENV\"\n",
        "original_script_sha256": "dee6398f5ca525d194316c424261ee872e3c36318a4665c97510cfd3f16523ea"
      },
      {
        "name": "Update flake inputs",
        "script": "nix shell \"$CONFCTL_FLAKE\" -c confctl inputs update --forward-only --all\n",
        "original_script_sha256": "27cf617c533a61cb160789f9adaac467eb5a93fee0e085d3a7dccac872d8e17d"
      },
      {
        "name": "Commit and push changes",
        "script": "set -euo pipefail\n\nif git diff --quiet; then\n  echo \"No flake.lock changes.\"\n  exit 0\nfi\n\nchanged_inputs=$(ruby .github/workflows/scripts/flake-update-commit-message.rb inputs \"$UPDATE_OLD_LOCK\" flake.lock)\nchanged_body=$(ruby .github/workflows/scripts/flake-update-commit-message.rb body \"$UPDATE_OLD_LOCK\" flake.lock)\n\ngit add flake.lock\ngit config user.name \"github-actions[bot]\"\ngit config user.email \"github-actions[bot]@users.noreply.github.com\"\n\ncommit_file=$(mktemp)\ntrap 'rm -f \"$commit_file\"' EXIT\n\nbody_lines=$(printf '%s\\n' \"$changed_body\" | sed '/^$/d' | wc -l | awk '{print $1}')\nif [ \"$body_lines\" -eq 1 ]; then\n  single_line=$(printf '%s\\n' \"$changed_body\" | head -n1 | sed 's/: / /')\n  printf 'flake: %s\\n' \"$single_line\" > \"$commit_file\"\nelse\n  if [ -n \"$changed_inputs\" ]; then\n    commit_message=\"flake: update $changed_inputs\"\n  else\n    commit_message=\"flake: update inputs\"\n  fi\n\n  if [ -n \"$changed_body\" ]; then\n    {\n      printf '%s\\n\\n' \"$commit_message\"\n      printf '%s\\n' \"$changed_body\"\n    } > \"$commit_file\"\n  else\n    printf '%s\\n' \"$commit_message\" > \"$commit_file\"\n  fi\nfi\ngit commit -F \"$commit_file\"\nfinal_lock=\"$RUNNER_TEMP/flake-update-final.lock\"\ngit show HEAD:flake.lock > \"$final_lock\"\nnix shell \"$CONFCTL_FLAKE\" -c confctl inputs check-update \\\n  --old-lock \"$UPDATE_OLD_LOCK\" --new-lock \"$final_lock\"\n",
        "original_script_sha256": "446ef9bcfe6ad2964a6a08bdecbc8ca81986a9378d22e273674ff1e1641f1808"
      }
    ],
