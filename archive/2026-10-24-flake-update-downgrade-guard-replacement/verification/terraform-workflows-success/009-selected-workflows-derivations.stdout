ace config.h \\\n  --replace-fail \"SYSTEMD_BINARY_PATH\" \"_SYSTEMD_BINARY_PATH\" \\\n  --replace-fail \"SYSTEM_SHUTDOWN_PATH\" \"_SYSTEM_SHUTDOWN_PATH\" \\\n  --replace-fail \"SYSTEM_SLEEP_PATH\" \"_SYSTEM_SLEEP_PATH\"\n","postFixup":"for f in bin/systemd-cryptsetup bin/systemd-cryptenroll; do\n  # This needs to be in LD_LIBRARY_PATH because rpath on a binary is not propagated to libraries using dlopen, in this case `libcryptsetup.so`\n  wrapProgram $out/$f --prefix LD_LIBRARY_PATH : /1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/cryptsetup\ndone\n","postInstall":"mkdir -p $out/example/systemd\nmv $out/lib/{binfmt.d,sysctl.d,tmpfiles.d} $out/example\nmv $out/lib/systemd/{system,user} $out/example/systemd\n\nrm -rf $out/etc/systemd/system\n\n# Fix reference to /bin/false in the D-Bus services.\nfor i in $out/share/dbus-1/system-services/*.service; do\n  substituteInPlace $i --replace /bin/false /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/false\ndone\n\n# For compatibility with dependents that use sbin instead of bin.\nln -s bin \"$out/sbin\"\nmv $out/lib/modules-load.d $out/example\nmv $out/lib/sysusers.d $out/example\n","postPatch":"substituteInPlace src/basic/path-util.h --replace \"@defaultPathNormal@\" \"/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/bin/\"\nsubstituteInPlace meson.build \\\n  --replace \"find_program('clang'\" \"find_program('clang'\"\nshopt -s extglob\npatchShebangs tools test src/!(rpm|kernel-install|ukify) src/kernel-install/test-kernel-install.sh\n","preConfigure":"substituteInPlace src/libsystemd/sd-journal/catalog.c \\\n  --replace /usr/lib/systemd/catalog/ $out/lib/systemd/catalog/\n","preInstall":"export DESTDIR=/\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"src":"/nix/store/kban61mm86a1nhq05rzg771n4l7qfjgw-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":false,"stripExclude":["lib/systemd/boot/efi/*"],"system":"x86_