ldInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"gdfq73isp2pl8gknq77i030cv4l9i5cc-crate-thiserror-1.0.69.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"thiserror-1.0.69","outputs":{"out":{"path":"salx3i5knagdz0qw8lmvy92lrn903ixz-thiserror-1.0.69"}},"system":"x86_64-linux","version":4},"5smgiid10iws1iw1dcaik2am00f1df1z-sv-kernel-modules-run.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"sv-kernel-modules-run","nativeBuildInputs":"","out":"/nix/store/6mjih4d0cpy4hq8j35rrxls2yc2f5dcd-sv-kernel-modules-run","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash\nmkdir -p \"/run/runit/cgroup.service/kernel-modules\"\necho $$ >> \"/run/runit/cgroup.service/kernel-modules/cgroup.procs\"\nexec 2>&1\nsource ./helpers\n\n\n# Module list: /nix/store/xk664810fgaskj5ccycymb3k2k0900c0-kernel-modules\nset -e\n\nmodule_list=/etc/kernel-modules\nstate_dir=/run/kernel-modules\nstate_file=$state_dir/modules\nsleep_pid=\n\nlog() {\n  printf '%s\\n' \"$*\"\n  /nix/store/mpb22kzpmrfaml8kcmfs5ib9sxq63wbb-util-linux-2.42.2-bin/bin/logger -t kernel-modules -- \"$*\" || true\n}\n\nstop_sleep() {\n  [ -n \"$sleep_pid\" ] || return 0\n  kill \"$sleep_pid\" 2> /dev/null || true\n  wait \"$sleep_pid\" 2> /dev/null || true\n  sleep_pid=\n}\n\nwait_for_syslog_socket() {\n  for i in $(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/seq 1 10); do\n    [ -S /dev/log ] && return 0\n    /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/sleep 1\n  done\n\n  return 1\n}\n\nload_modules() {\n  mkdir -p \"$state_dir\"\n\n  while IFS= read -r module; do\n    [ -n \"$module\" ] || continue\n\n    log \"loading module $module\"\n    if ! /nix/store/ahni4ky7vcyga5rkfk6yil6g0293qyvk-kmod-31/bin/modprobe \"$module\"; then\n      log \"failed to load module $module\"\n    fi\n  done < \"$module_list\"\n}\n\nunload_removed_modules() {\n  [ -s \"$state_file\" ] || return 0\n\n  /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/tac \"$state_file\" | while IFS= read -r module; do\n    [ -n \"$module\" ] || continue\n    /nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin/grep -Fxq \"$module\" \"$module_list\" && continue\n\n    log \"unloading removed module $module\"\n    if ! /nix/store/ahni4ky7vcyga5rkfk6yil6g0293qyvk-kmod-31/bin/modprobe -r \"$module\"; then\n      log \"kept removed module $module\"\n    fi\n  done\n}\n\nreload_modules() {\n  mkdir -p \"$state_dir\"\n\n  if true; then\n    log \"loading configured kernel modules\"\n    load_modules\n  else\n    log \"not loading new kernel modules because boot.kernel.loadNewModules is false\"\n  fi\n\n  if false; then\n    unload_removed_modules\n  else\n    log \"not unloading removed kernel modules because boot.kernel.unloadRemovedModules is false\"\n  fi\n\n  cp \"$module_list\" \"$state_file\"\n  log \"configured kernel modules loaded\"\n}\n\nhandle_hangup() {\n  stop_sleep\n  log \"reloading kernel-modules service script\"\n  exec /etc/runit/services/kernel-modules/run\n}\n\nhandle_exit() {\n  stop_sleep\n  exit 0\n}\n\ntrap handle_hangup HUP\ntrap handle_exit TERM INT\n\nsv up rsyslog 2> /dev/null || true\nwaitForService rsyslog 10 || true\nwait_for_syslog_socket || true\nreload_modules\n\nwhile true; do\n  /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/sleep infinity &\n  sleep_pid=$!\n  wait \"$sleep_pid\" || true\ndone\n\n\n\n"},"inputs":{"drvs":{"3hdkqd69xxi76mi7w7q4ac18lbd83vc8-util-linux-2.42.2.drv":{"dynamicOutputs":{},"outputs":["bin"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8cp1lhkcz1pi19lfzgln6w1kc3jswsi4-gnugrep-3.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"b62h34b8indjlwjy86799pq9q4mc8c2f-kmod-31.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"l10jsfsbqy0wyhbkglsw36n7gr89040j-kernel-modules.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"sv-kernel-modules-run","outputs":{"out":{"path":"6mjih4d0cpy4hq8j35rrxls2yc2f5dcd-sv-kernel-modules-run"}},"system":"x86_64-linux","version":4},"5swwj92rgxpkk9877yr0nqq0fnvcv55j-vault-0.3.1.6.tar.gz.drv":{"args":["-e","/nix/store/