ycaqjyx1ck8gd4bxmfx1-remove-references-to","out":"/nix/store/bm8mjkdqymfilhg25lxfxhzfsi16w05f-fgl-5.8.3.0","outputs":"out doc","patches":"","pname":"fgl","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"echo \"Replace Cabal file with edited version from mirror://hackage/fgl-5.8.3.0/revision/2.cabal.\"\ncp /nix/store/d8waj1xlhns6ynka32m67a8iba425kja-fgl-5.8.3.0-r2.cabal fgl.cabal\n\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"    ","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3.\"\nexport PATH=/nix/store/ncws3231mq7lz6wqyyg2p7gmz6fcvikf-hscolour-1.25/bin:$PATH\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname  --docdir=$doc/share/doc/fgl-5.8.3.0 --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --enable-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --enable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/x8n2xci17x6r8lb4hxwqhaawy8zh98aj-fgl-5.8.3.0.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"5.8.3.0"},"inputs":{"drvs":{"1gbawc48yci42lbjjgipkg2335ax539g-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"2gb7wwmz521qb0d7y66a0rpp78s4017f-fgl-5.8.3.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"31crzmq8yc1nlj0wjfh9afjwpkc86vpj-glibc-locales-2.42-67.drv":{"dynamicOutputs":{},"outputs":["out"]},"4by2ygk033w4hyngk9cx8ygjppk8s4ix-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"ckpdbv7d3pzbn3dbbp6cqj3qp2k5sjjf-fgl-5.8.3.0-r2.cabal.drv":{"dynamicOutputs":{},"outputs":["out"]},"hn9gyhy5qq58isa8922b5y608skrvplj-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"km4906xb6vn2l0szx06h5i946ljpmkm6-hspec-2.11.17.drv":{"dynamicOutputs":{},"outputs":["out"]},"ljxjrcrrir1x4laqb6dkc59hg2a4pd6y-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]},"rndqc2dqsqpasdczshzkd1myg4y2lfwi-QuickCheck-2.15.0.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["4mdp8nhyfddh7bllbi7xszz7k9955n79-Setup.hs","907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"fgl-5.8.3.0","outputs":{"doc":{"path":"0x3n8rri1mign5dc4ndkjs3lg72jws70-fgl-5.8.3.0-doc"},"out":{"path":"bm8mjkdqymfilhg25lxfxhzfsi16w05f-fgl-5.8.3.0"}},"system":"x86_64-linux","version":4},"h47lyyrip4qmscp25lbaf9mxjyff4yq7-gtk-3.24.52.tar.xz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynp