 Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-osctl-26.05.0","nativeBuildInputs":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/pxs987lnzbkq9ahivds5s7kqxax1bw1s-ruby3.4-osctl-26.05.0","outputs":"out","patches":"","pname":"osctl","propagatedBuildInputs":"/nix/store/5h9pbl9n92hlq5qagjml3sm5djshicii-ruby3.4-base64-0.3.0 /nix/store/dxnlydx4hhvq081jazj40pd6blhgij1q-ruby3.4-curses-1.6.0 /nix/store/myrbk54s0r46rif9wx9qscvlcw1cxzx4-ruby3.4-gli-2.22.2 /nix/store/34jvazq6b81ma5p4fv7v8gn5kss1wr02-ruby3.4-highline-3.1.2 /nix/store/xr65maz87jxy8l2xi7f4sr682flpanyh-ruby3.4-ipaddress-0.8.3 /nix/store/1qd1hl4q1izishy65b3pdj38zjvayhi3-ruby3.4-json-2.19.8 /nix/store/49igmpzaqxlyf8ak4bvscz3gk29dfqfp-ruby3.4-libosctl-26.05.0 /nix/store/jqmq2wdzyznyjnjigh6s6mzv86b1sn6n-ruby3.4-rainbow-3.1.1 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0 /nix/store/ci3sdn5dgvch08apykywrhx1q6mwv98l-ruby3.4-ruby-progressbar-1.13.0 /nix/store/gm7ra952lba7fyyd46z19fs34sj590kd-ruby3.4-tty-spinner-0.9.3","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/5h9pbl9n92hlq5qagjml3sm5djshicii-ruby3.4-base64-0.3.0 /nix/store/dxnlydx4hhvq081jazj40pd6blhgij1q-ruby3.4-curses-1.6.0 /nix/store/myrbk54s0r46rif9wx9qscvlcw1cxzx4-ruby3.4-gli-2.22.2 /nix/store/34jvazq6b81ma5p4fv7v8gn5kss1wr02-ruby3.4-highline-3.1.2 /nix/store/xr65maz87jxy8l2xi7f4sr682flpanyh-ruby3.4-ipaddress-0.8.3 /nix/store/1qd1hl4q1izishy65b3pdj38zjvayhi3-ruby3.4-json-2.19.8 /nix/store/49igmpzaqxlyf8ak4bvscz3gk29dfqfp-ruby3.4-libosctl-26.05.0 /nix/store/jqmq2wdzyznyjnjigh6s6mzv86b1sn6n-ruby3.4-rainbow-3.1.1 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0 /nix/store/ci3sdn5dgvch08apykywrhx1q6mwv98l-ruby3.4-r