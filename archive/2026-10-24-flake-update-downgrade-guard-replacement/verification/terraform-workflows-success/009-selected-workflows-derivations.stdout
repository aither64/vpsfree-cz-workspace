trs":"","buildInputs":"/nix/store/g5qbbj4cmzq1133lnvmaxanrlxl0k7ac-autoconf-2.73 /nix/store/sisn3jbz4mnmp02llc5sn60p80di1asm-libffi-3.8.0-dev /nix/store/8cyxkapwg2r784bg1zjgznxj9ir3ysjd-ncurses-6.6-dev /nix/store/bz0qnw6xnfijgbmyvcnajsanfys0yjgw-readline-8.3p3-dev /nix/store/0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev /nix/store/6snylzb0haf89m5xwkc7x9vvinkcmj41-openssl-3.6.3-dev /nix/store/qkrqgl0ji8s9f54xnd3h1kcmlihz4mlg-gdbm-1.26-dev /nix/store/nf1ybxq9qqcbgci1kz3psy52vib9w7iq-libyaml-0.2.5-dev","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cargoDeps":"/nix/store/4qj772y1xwzrip9mfa53v4x8f52bk45h-cargo-deps-vendor","cargoRoot":"yjit","cmakeFlags":"","configureFlags":"--enable-shared --enable-pthread --with-soname=ruby-3.4.9 --without-baseruby --disable-dtrace --enable-jit-support --enable-yjit --enable-install-doc --without-jemalloc --with-ridir=/0mzrxs60yn555qh08y6avv5sbrfy0gkizrji3v7ba9j25ha14fh5/share/ri CFLAGS=-O3","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","devdoc":"/nix/store/by620njx8311f0a4m3rr900lp70b6pnl-ruby-3.4.9-devdoc","disallowedRequisites":"","doCheck":"","doInstallCheck":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"","installCheckPhase":"overriden_cc=$(CC=foo $out/bin/ruby -rrbconfig -e 'puts RbConfig::CONFIG[\"CC\"]')\nif [[ \"$overriden_cc\" != \"foo\" ]]; then\n   echo \"CC cannot be overwritten: $overriden_cc != foo\" >&2\n   false\nfi\n\nfallback_cc=$(unset CC; $out/bin/ruby -rrbconfig -e 'puts RbConfig::CONFIG[\"CC\"]')\nif [[ \"$fallback_cc\" != \"$CC\" ]]; then\n   echo \"CC='$fallback_cc' should be '$CC' by default\" >&2\n   false\nfi\n","installFlags":"install-doc","mesonFlags":"","name":"ruby-3.4.9","nativeBuildInputs":"/nix/store/1gwjv0k6p346zp3la3bcbc3y75ahgi3s-autoreconf-hook /nix/store/47ibddl4z6rmhp517p1sas0qlapbb1zh-bison-3.8.2 /nix/store/hbbp1a8sr589ycaqjyx1ck8gd4bxmfx1-remove-references-to /nix/store/c6rl57qqmx2sk112kdgpk26ghm77s0li-groff-1.24.1 /nix/store/ghj0fyhcw07a220652nrc4smis5bfgll-cargo-setup-hook.sh /nix/store/ysm0d9hwywr9p62d60ldm68wjhs8x00d-rustc-wrapper-1.95.0","out":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9","outputs":"out devdoc","patches":"/nix/store/c6d5gm3zc63zg49kanxf8w6cxfv69ibk-dont-refer-to-build-dir.patch /nix/store/9rm9zmzp5d35hbsskxp3x8lvninc32lv-export-timer-functions.patch","pname":"ruby","postFixup":"rm $out/lib/ruby/gems/*/specifications/{debug*,rbs*,racc*}.gemspec\n","postInstall":"rbConfig=$(find $out/lib/ruby -name rbconfig.rb)\n# Remove references to the build environment from the closure\nsed -i '/^  CONFIG\\[\"\\(BASERUBY\\|SHELL\\|GREP\\|EGREP\\|MKDIR_P\\|MAKEDIRS\\|INSTALL\\)\"\\]/d' $rbConfig\n# Remove unnecessary groff reference from runtime closure, since it's big\nsed -i '/NROFF/d' $rbConfig\n\n\n# Allow to override compiler. This is important for cross compiling as\n# we need to set a compiler that is different from the build one.\nsed -i \"$rbConfig\" \\\n  -e 's/CONFIG\\[\"CC\"\\] = \"\\(.*\\)\"/CONFIG[\"CC\"] = if ENV[\"CC\"].nil? || ENV[\"CC\"].empty? then \"\\1\" else ENV[\"CC\"] end/' \\\n  -e 's/CONFIG\\[\"CXX\"\\] = \"\\(.*\\)\"/CONFIG[\"CXX\"] = if ENV[\"CXX\"].nil? || ENV[\"CXX\"].empty? then \"\\1\" else ENV[\"CXX\"] end/'\n\n# Remove unnecessary external intermediate files created by gems\nextMakefiles=$(find $out/lib/ruby/gems/3.4.0 -name Makefile)\nfor makefile in $extMakefiles; do\n  make -C \"$(dirname \"$makefile\")\" distclean\ndone\nfind \"$out/lib/ruby/gems/3.4.0\" \\( -name gem_make.out -o -name mkmf.log -o -name exts.mk \\) -delete\n# Bundler tries to create this directory\nmkdir -p $out/nix-support\ncat > $out/nix-support/setup-hook <<EOF\naddGemPath() {\n  addToSearchPath GEM_PATH \\$1/lib/ruby/gems/3.4.0\n}\naddRubyLibPath() {\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0/x86_64-linux\n}\n\naddEnvHooks \"$hostOffset\" addGemPath\naddEnvHooks \"$hostOffset\" addRubyLibPath\nEOF\n# Prevent the docs from being included in the closure\nsed -i \"s|\\$(DESTDIR)$devdoc|\\$(datarootdir)/\\$(RI_BASE_NAME)|\" $rbConfig\nsed -i \"s|'--with-ridir=$devdoc/share/ri'||\" $rbConfig\n\n# Add rbconfig shim so ri can find docs\nmkdir -p $devdoc/lib/ruby/site_ruby\ncp /nix/store/wq7zxvl223s5s97y3dhc3gkyk5d6dw0w-rbconfig.rb $devdoc/lib/ruby/site_ruby/rbconfig.rb\n","postPatch":"sed -i configure.ac -e '/config.guess/d'\ncp --remove-destination /nix/store/g5qbbj4cmzq1133lnvmaxanrlxl0k7ac-autoconf-2.73/share/autoconf/build-aux/config.{guess,sub} tool/\n","postUnpack":"rm -rf $sourceRoot/{lib,test}/rubygems*\ncp -r /nix/store/vnpyl3jwdqmbjyk2d5qnabfdx3d125w5-rubygems-3.7.2/lib/rubygems* $sourceRoot/lib\n","preConfigure":"# rdoc creates XDG_DATA_DIR (defaulting to $HOME/.local/share) even if\n# it's not going to be used.\nexport HOME=$TMPDIR\n","preInstall":"# Ruby installs gems here itself now.\nmkdir -pv \"$out/lib/ruby/gems/3.4.0\"\nexport GEM_HOME=\"$out/lib/ruby/gems/3.4.0\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/h459yblgc82az0vy3brjh5wc1452f8fw-ruby-3.4.9.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"3.4.9"},"inputs":{"drvs":{"16mjl83l917l0j1kr9ab2w7bi25mk91z-libyaml-0.2.5.drv":{"dynamicOutputs":{},"outputs":["dev"]},"3g4lhn00qsrx31p8ds4gi9x001pvpsl7-ruby-3.4.9.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"5n2k8nv60xzr2j7g43w5f70g0gk68y70-gdbm-1.26.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8s14cb1d61vsrqdi76cycsz9lsb8hlk6-cargo-deps-vendor.drv":{"dynamicOutputs":{},"outputs":["out"]},"alvcpiffvnsd7gqrls7lmf39na76ycsj-aut