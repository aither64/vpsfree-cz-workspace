t=x86_64-unknown-linux-gnu --with-sysroot=/ --disable-dependency-tracking --disable-nls --enable-deterministic-archives --disable-gprofng --enable-new-dtags --with-lib-path=:\n\n# Build\nmake -j $NIX_BUILD_CORES all-libiberty all-gas all-bfd all-libctf all-zlib all-gprof\nmake all-ld # race condition on ld/.deps/ldwrite.Po, serialize\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install\n\n# gprof/addr2line/elfedit + man pages are unused downstream.\nrm -f $out/bin/gprof $out/bin/addr2line $out/bin/elfedit\nrm -rf $out/share/info $out/share/man\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"binutils-2.46.0","out":"/nix/store/z8va212wrar5kxwv4ivlalrzasm2clx1-binutils-2.46.0","passAsFile":"buildCommand","pname":"binutils","system":"x86_64-linux","version":"2.46.0"},"inputs":{"drvs":{"3zhi7fn92ym1ds0n3yybmjyjvksypi39-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"4hfq6p045k7knv86fc57kq5cnf2djia6-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gwpvw0ssr7xmfzvy97c6f493fhc2f7r-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"cblshqv4b81g5gxis3zpb4inagkaffi1-binutils-2.46.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"d9hngw468h7b7fpcyx284kqwdgcn3gzy-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"j1aiw0pfh51nyay8zavyx3adq86xdnkl-tinycc-musl-unstable-2025-12-03-compiler.drv":{"dynamicOutputs":{},"outputs":["out"]},"jm8c5a9ysfm3fckryllnl6pd3nm1hd17-bootstrap-coreutils-musl-9.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"jvn6rxfx2j66k0svyl5njyqzq2nh0v5s-gnutar-musl-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"l6a6rj0gy31gp6k7k80qzn4ni0yvyzgh-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a9pds57ms69gfi2ya-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"v8jl1cziqai2qqgn0axr9cv3masm5nb5-bash-5.3.dr