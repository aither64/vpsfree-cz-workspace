4m2i47kxzw2zw9z-libnfnetlink-1.0.2"}},"system":"x86_64-linux","version":4},"1hxds31x4mkjsbs4s9n1zzyv0yf8yv3n-container-init.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"container-init","nativeBuildInputs":"","out":"/nix/store/0ryrdhxvcqlppnbhf66yqnlpkycjazx9-container-init","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#! /nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash -e\n\n# Exit early if we're asked to shut down.\ntrap \"exit 0\" SIGRTMIN+3\n\n# Initialise the container side of the veth pair.\nif [[ -n \"${HOST_ADDRESS-}\" ]]   || [[ -n \"${HOST_ADDRESS6-}\" ]]  ||\n   [[ -n \"${LOCAL_ADDRESS-}\" ]]  || [[ -n \"${LOCAL_ADDRESS6-}\" ]] ||\n   [[ -n \"${HOST_BRIDGE-}\" ]]    || [[ -n \"${LOCAL_MAC_ADDRESS-}\" ]]; then\n  ip link set host0 name eth0\n\n  if [[ -n \"${LOCAL_MAC_ADDRESS-}\" ]]; then\n    ip link set dev eth0 address \"$LOCAL_MAC_ADDRESS\"\n  fi\n\n  ip link set dev eth0 up\n\n  if [[ -n \"${LOCAL_ADDRESS-}\" ]]; then\n    ip addr add $LOCAL_ADDRESS dev eth0\n  fi\n  if [[ -n \"${LOCAL_ADDRESS6-}\" ]]; then\n    ip -6 addr add $LOCAL_ADDRESS6 dev eth0\n  fi\n  if [[ -n \"${HOST_ADDRESS-}\" ]]; then\n    ip route add $HOST_ADDRESS dev eth0\n    ip route add default via $HOST_ADDRESS\n  fi\n  if [[ -n \"${HOST_ADDRESS6-}\" ]]; then\n    ip -6 route add $HOST_ADDRESS6 dev eth0\n    ip -6 route add default via $HOST_ADDRESS6\n  fi\nfi\n\n\n\n# Start the regular stage 2 script.\n# We source instead of exec to not lose an early stop signal, which is\n# also the only _reliable_ shutdown signal we have since early stop\n# does not execute ExecStop* commands.\nset +e\n. \"$1\"\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"container-init","outputs":{"out":{"path":"0ryrdhxvcqlppnbhf66yqnlpkycjazx9-container-init"}},"system":"x86_64-linux","version":4},"1i0bff2wmyhg6mz4xpr5v4gqgkqmc2w2-CVE-2026-66033.patch.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/41yjsa29ydagklnqfd17abjzy909facg-CVE-2026-66033.patch"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"fipldvf4rvwd547anz21awdm06xvvl8d-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5