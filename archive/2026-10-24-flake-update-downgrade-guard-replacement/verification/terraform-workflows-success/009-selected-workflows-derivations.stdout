admin-database-setup-start","__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash -n -O extglob \"$target\"\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"/bin/vpsadmin-database-setup-start","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"unit-script-vpsadmin-database-setup-start","nativeBuildInputs":"","out":"/nix/store/llzzdiwc1v8yfcnrix0hica28swa83ia-unit-script-vpsadmin-database-setup-start","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash\nset -e\n\nset -euo pipefail\nshopt -s nullglob\n\n# Cleanup previous state\nrm -f \"/var/lib/vpsadmin/database/plugins/\"*\nfind \"/var/lib/vpsadmin/database/config\" -type l -exec rm -f {} +\n\n# Link in configuration\nfor v in \"/nix/store/b0kcn1kl2srccx8jn4nkl9ik1z9i1xrw-api\"/* ; do\n  ln -sf \"$v\" \"/var/lib/vpsadmin/database/config/$(basename $v)\"\ndone\n\nrm -f \"/var/lib/vpsadmin/database/config/deployment.json\"\ncp -f /nix/store/8q5r2af6imy7cnzspr3cd27p3rz2ncf6-deployment.json \"/var/lib/vpsadmin/database/config/deployment.json\"\nchmod 440 \"/var/lib/vpsadmin/database/config/deployment.json\"\n\n# Link in enabled plugins\nfor plugin in monitoring newslog outage_reports payments requests webui; do\n  ln -sf \"/nix/store/0f5hy9kp0a64r6c73pf7lxlldjamlvsq-vpsadmin-database-unknown/plugins/$plugin\" \"/var/lib/vpsadmin/database/plugins/$plugin\"\ndone\n\n# Handle database.passwordFile & permissions\nDBPASS=$(head -n1 /etc/vpsadmin-test/mariadb-api-password)\ndatabaseYmlTmp=\"$(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/mktemp \"/var/lib/vpsadmin/database/config/.database.yml.XXXXXX\")\"\ntrap '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/rm -f \"$databaseYmlTmp\"' EXIT\nsed -e \"s,#dbpass#,$DBPASS,g\" /nix/store/yi74sixinw7ja1a0bmy83p9q0w96mgzw-database.yml >\"$databaseYmlTmp\"\nchmod 440 \"$databaseYmlTmp\"\nmv -f \"$databaseYmlTmp\" \"/var/lib/vpsadmin/database/config/database.yml\"\ntrap - EXIT\n\n\ndbStateFile=\"/var/lib/vpsadmin/database/database-initialized\"\n\nif [ ! -e \"/var/lib/vpsadmin/database/cache/schema.rb\" ] ; then\n  cp /nix/store/0f5hy9kp0a64r6c73pf7lxlldjamlvsq-vpsadmin-database-unknown/database/db/schema.rb /var/lib/vpsadmin/database/cache/schema.rb\n  chmod 0600 \"/var/lib/vpsadmin/database/cache/schema.rb\"\nfi\n\nif [ -e \"$dbStateFile\" ]; then\n  dbInitialized=yes\n  echo \"Database is already initialized\"\nelse\n  dbInitialized=no\n  echo \"Loading database schema\"\n  /nix/store/0f5hy9kp0a64r6c73pf7lxlldjamlvsq-vpsadmin-database-unknown/ruby-env/bin/bundle exec rake db:schema:load\n  date > \"$dbStateFile\"\nfi\n\necho \"Running database migrations\"\n/nix/store/0f5hy9kp0a64r6c73pf7lxlldjamlvsq-vpsadmin-database-unknown/ruby-env/bin/bundle exec rake db:migrate\n\necho \"Running plugin migrations\"\n/nix/store/0f5hy9kp0a64r6c73pf7lxlldjamlvsq-vpsadmin-database-unknown/ruby-env/bin/bundle exec rake vpsadmin:plugins:migrate\n\nif [ \"$dbInitialized\" == \"no\" ]; then\n  echo \"Seeding file test.nix\"\n/nix/store/0f5hy9kp0a64r6c73pf7lxlldjamlvsq-vpsadmin-database-unknown/ruby-env/bin/bundle exec rake db:seed:file SEED_FILE=test.nix\n\necho \"Seeding file test-1-node.nix\"\n/nix/store/0f5hy9kp0a64r6c73pf7lxlldjamlvsq-vpsadmin-database-unknown/ruby-env/bin/bundle exec rake db:seed:file SEED_FILE=test-1-node.nix\n\nfi\n\necho \"Installing built-in notification templates\"\n/nix/store/0f5hy9kp0a64r6c73pf7lxlldjamlvsq-vpsadmin-database-unknown/ruby-env/bin/bundle exec rake vpsadmin:notification_templates:install_defaults\n\n\n\nexit 0\n\n\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"92p3r878k9g4bl165dssn6chbp4d9z07-deployment.json.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"w92cdlindvj3k7kymkqiqrp1cv8llf9d-vpsadmin-database-unknown.drv":{"dynamicOutputs":{},"outputs":["out"]},"xfdvb3ay2wnwwp7cn3rr6zk390c1v0iz-database.yml.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["b0kcn1kl2srccx8jn4nkl9ik1z9i1xrw-api","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-vpsadmin-database-setup-start","outputs":{"out":{"path":"llzzdiwc1v8yfcnrix0hica28swa83ia-unit-script-vpsadmin-database-setup-start"}},"system":"x86_64-linux","version":4},"3hdkqd69xxi76mi7w7q4ac18lbd83vc8-util-linux-2.42.2.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","bin":"/nix/store/mpb22kzpmrfaml8kcmfs5ib9sxq63wbb-util-linux-2.42.2-bin","buildInputs":"/nix/store/0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev /nix/store/k5j2kwjcap1zgdh4xn1fvvlsrzy55g1i-libxcrypt-4.5.2 /nix/store/nabvcs2dqhnfckjv0vb5v6hx5m404l5x-sqlite-3.51.2-dev /nix/store/khbxm3c02xklnz8jgh4c