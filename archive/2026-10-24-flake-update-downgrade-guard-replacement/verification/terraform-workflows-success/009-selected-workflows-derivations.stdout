ror: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://src.fedoraproject.org/rpms/dbus-c++/raw/9f515ace0594c8b2b9f0d41ffe71bc5b78d30eee/f/dbus-c++-writechar.patch"]},"system":"x86_64-linux","version":4},"rd1wbx642jb72xm77j5yyryxrs4p74fa-quickcheck-classes-0.6.5.0-r3.cabal.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/savxc13gfjjmyxh471zgi4kd2h7f6869-quickcheck-classes-0.6.5.0-r3.cabal"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"fipldvf4rvwd547anz21awdm06xvvl8d-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"quickcheck-classes-0.6.5.0-r3.cabal","outputs":{"out":{"hash":"sha256-xS5jcMkZizXmM607Oj/vEVSJP5wHMeyC2I01nUtVXN0=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":[],"curlOpts":"","curlOptsList":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagate