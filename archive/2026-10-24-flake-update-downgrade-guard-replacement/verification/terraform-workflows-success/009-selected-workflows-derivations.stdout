m1q4sy03p29ji83br3-linux-config-6.12.104","outputs":"out","patches":"/nix/store/mnlqwys9dxznjcvq4w3s0435s9ql8qv8-bridge-stp-helper.patch /nix/store/mbz5gln1q4swlzmqs2399br98qjif9kn-request-key-helper.patch /nix/store/23728y7zgh1jb55kpwxv5qnjbq0ykca6-randstruct-provide-seed-5.19.patch","pname":"linux-config","postPatch":"# Ensure that depmod gets resolved through PATH\nsed -i Makefile -e 's|= /sbin/depmod|= depmod|'\n\n# Some linux-hardened patches now remove certain files in the scripts directory, so the file may not exist.\n[[ -f scripts/ld-version.sh ]] && patchShebangs scripts/ld-version.sh\n\n# Set randstruct seed to a deterministic but diversified value. Note:\n# we could have instead patched gen-random-seed.sh to take input from\n# the buildFlags, but that would require also patching the kernel's\n# toplevel Makefile to add a variable export. This would be likely to\n# cause future patch conflicts.\nfor file in scripts/gen-randstruct-seed.sh scripts/gcc-plugins/gen-random-seed.sh; do\n  if [ -f \"$file\" ]; then\n    substituteInPlace \"$file\" \\\n      --replace NIXOS_RANDSTRUCT_SEED \\\n      $(echo /nix/store/ixh24v022kz63hg5hba0fs5gvi2i9bfw-linux-6.12.104.tar.xz /1s3bzfisrvrdlla1qr3z074sphpb4cpz4rbacwp56cmp9237lv2y | sha256sum | cut -d ' ' -f 1 | tr -d '\\n')\n    break\n  fi\ndone\n\npatchShebangs scripts\n\n# also patch arch-specific install scripts\nfor i in $(find arch -name install.sh); do\n    patchShebangs \"$i\"\ndone\n\n# unset $src because the build system tries to use it and spams a bunch of warnings\n# see: https://github.com/torvalds/linux/commit/b1992c3772e69a6fd0e3fc81cd4d2820c8b6eca0\nunset src\n# Patch kconfig to print \"###\" after every question so that\n# generate-config.pl from the generic builder can answer them.\nsed -e '/fflush(stdout);/i\\printf(\"###\");' -i scripts/kconfig/conf.c\n","preUnpack":"","preferBuiltin":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/ixh24v022kz63hg5hba0fs5gvi2i9bfw-linux-6.12.104.tar.xz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"6.12.104"},"inputs":{"drvs":{"3bkl4yqj9z2vyd4ginlzfh6cv8x8997j-flex-2.6.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"3qsb40pprfnj2kg94rmh1zlsm41jrv8s-rustc-1.95.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"4mqb16ds8139fisfwxzax647m2hib49n-linux-6.12.104.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"76z1f4wh1qchqchyna9h10vsrdzadcsb-libmpc-1.4.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"82h6sgm5vghha9vs35f5hmq9ygslg855-gcc-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"dnz4fqzcnwyfhq2qx2m4c63qiw8kp70a-perl-5.42.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"f914fd9r6h7jwdxp91750al8lbwvjs1p-rust-bindgen-unwrapped-0.72.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"fwjaqkyshshrk3li1bprn4a3j31qf0hr-pahole-1.31.drv":{"dynamicOutputs":{},"outputs":["out"]},"jp7ziv1mndz8w6vq5l20fyhg5qdscxm2-gcc-wrapper-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"kzc6jva8wiidkffxmxf05k9kxc65bjwy-binutils-2.46.drv":{"dynamicOutputs":{},"outputs":["out"]},"l0waafdwrmk3dlmmkjdar7m8kll8rngg-binutils-wrapper-2.46.drv":{"dynamicOutputs":{},"outputs":["out"]},"sz9gngc271q1awwyrzb7pxm7zpdqpjyg-rust-lib-src.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"w86zj68l86zb6cykl4125ndqiipgd14r-gmp-with-cxx-6.3.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"x1w0jlgrzalamm5a6s5gz2s4llsh8yq2-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"y3mrpl0bby1cnxr38dqdggjgzixlg1vr-mpfr-4.2.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"zs6vsbx1jwjls6p1vkib17d06362jv7g-kernel-intermediate-config.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["23728y7zgh1jb55kpwxv5qnjbq0ykca6-randstruct-provide-seed-5.19.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stden