"buildCommand":"# Unpack\nungz --file /nix/store/lpl6waw9irrva3y0f9g9d9whjl5lamgw-gawk-3.0.6.tar.gz --output gawk.tar\nuntar --file gawk.tar\nrm gawk.tar\ncd gawk-3.0.6\n\n# Patch\npatch -Np0 -i /nix/store/5fs57gxp6iw4h8hbdn4g3cym0l452bzl-no-stamp.patch\n\n# Configure\nexport CC=\"tcc -B /nix/store/rayh0cq2ik1xyw2hclrkdn7c67lppg2r-tinycc-mes-libs-unstable-2025-12-03/lib\"\nexport ac_cv_func_getpgrp_void=yes\nexport ac_cv_func_tzset=yes\nbash ./configure \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --disable-dependency-tracking \\\n  --disable-nls \\\n  --prefix=$out\n\n# Build\n# NOTE: parallel build (-j) breaks gawk autoconf'd Makefile under tcc-mes; keep serial.\nmake gawk\n\n# Install\ninstall -D gawk $out/bin/gawk\nln -s gawk $out/bin/awk\n","builder":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","name":"gawk-mes-3.0.6","out":"/nix/store/64yrq5q0w7y0x4zmz49csswx3q14rqnd-gawk-mes-3.0.6","passAsFile":"buildCommand","pname":"gawk-mes","system":"x86_64-linux","version":"3.0.6"},"inputs":{"drvs":{"1vgxf29abq71i0mh3m5839my4664jfmh-tinycc-mes-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"54jdq8vp944qn49b18harrbjw34dlxcp-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"9ms5jx08n6hdg7ji8fxln4lsfbzd92fa-gnused-mes-4.0.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"b0faqgmz5282qmis5v2m13b7bsc0y9jg-gnumake-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"d9hngw468h7b7fpcyx284kqwdgcn3gzy-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"dvl148vwwn460fa0zq13z8wlyrd2fz8k-gawk-3.0.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a9pds57ms69gfi2ya-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zmvpmmh7i1qba20c97v4cl6yi7zqpv3a