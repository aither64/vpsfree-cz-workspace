ced with a path to the build bash which doesn't get automatically patched by patchShebangs\nsubstituteInPlace contrib/gdiffmk/gdiffmk.sh \\\n  --replace-fail \"@POSIX_SHELL_PROG@\" \"/bin/sh\"\n","preCheck":"# The neqn-smoke-test fails on nixpkgs because neqn exec's eqn,\n# but eqn, isn't in the PATH in the nixpkgs test env, to remedy\n# that GROFF_BIN_PATH is set as follows:\nexport GROFF_BIN_PATH=.\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/ayl1qkwzzm5rxm43ba0ngl1ik2pr5w8y-groff-1.24.1.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"1.24.1"},"inputs":{"drvs":{"0380nrm8x9jlbzg3wskzrp9m2098q7h8-groff-1.24.1.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"5z8sj1169xaps07s9yw780fvznwn8yqy-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"alvcpiffvnsd7gqrls7lmf39na76ycsj-autoreconf-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"dnz4fqzcnwyfhq2qx2m4c63qiw8kp70a-perl-5.42.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"r9jkd36vjjkccvjpbyc16f1zqdc1h6sb-texinfo-7.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["1diimhjq1fbjdxr50ap0iawp79mj9dvb-site.tmac","av6kr2l7nf0f12f3gg3gjs35y9np5r6r-0001-Revert-man-Fix-Savannah-65190.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"groff-1.24.1","outputs":{"doc":{"path":"bq97d4dskq5fzd8926w33hjwijbjfx9m-groff-1.24.1-doc"},"info":{"path":"k2v5hqs43mg6159g258ka83ys83da1r1-groff-1.24.1-info"},"man":{"path":"ch34hbrav6pc4jszkk5avg84s340kh8f-groff-1.24.1-man"},"out":{"path":"c6rl57qqmx2sk112kdgpk26ghm77s0li-groff-1.24.1"},"perl":{"path":"sqagwsfqyfs6d43hm3njqyw2smmgjj1n-groff-1.24.1-perl"}},"system":"x86_64-linux","version":4},"