uses trouble:\n# * We only have meaningful locale(1) implementations for glibc and macOS\n# * NetBSD's locale(1) (used for macOS) depends on mandoc\n# * Sandbox and locales cause all kinds of trouble\n# * build and host libc (and thus locale handling) may differ\nHAVE_WCHAR=1\nUTF8_LOCALE=C.UTF-8\n","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"1","doInstallCheck":"","mesonFlags":"","name":"mandoc-1.14.6","nativeBuildInputs":"/nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0","out":"/nix/store/x7dx506iwrc04jwi4bvrarrc5bgr6pqk-mandoc-1.14.6","outputs":"out","patches":"","pname":"mandoc","preCheck":"patchShebangs --build regress/regress.pl","preConfigure":"printf '%s' \"$configureLocal\" > configure.local\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/fdz8h8sjm9wcl4m5dizkzapvvzjphzsc-mandoc-1.14.6.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.14.6"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"dnz4fqzcnwyfhq2qx2m4c63qiw8kp70a-perl-5.42.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"dq9973ranld8j99jmwai7ggsmchsd7mk-mandoc-1.14.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"z84lzqk6n44ya8fdmwhpwxnfrp2a961y-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["dev"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"mandoc-1.14.6","outputs":{"out":{"path":"x7dx506iwrc04jwi4bvrarrc5bgr6pqk-mandoc-1.14.6"}},"system":"x86_64-linux","version":4},"fbdk0cbnlsam520w38am8bm86dmmbfk2-tasty-golden-2.3.6.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg