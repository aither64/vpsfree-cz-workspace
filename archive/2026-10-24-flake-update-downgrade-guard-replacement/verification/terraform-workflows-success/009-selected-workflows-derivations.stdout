re/icons","CUPS_PRIMARY_SYSTEM_GROUP=root"],"mesonFlags":[],"name":"cups-2.4.19","nativeBuildInputs":["/nix/store/cizqnkc40i7k401f8cl2260ksi9nnph4-pkg-config-wrapper-0.29.2","/nix/store/hbbp1a8sr589ycaqjyx1ck8gd4bxmfx1-remove-references-to"],"outputChecks":{"dev":{},"lib":{},"man":{},"out":{}},"outputs":["out","lib","dev","man"],"patches":[],"pname":"cups","postInstall":"libexec=lib/cups\nmoveToOutput $libexec \"$out\"\n\n# $lib contains references to $out/share/cups.\n# CUPS is working without them, so they are not vital.\nfind \"$lib\" -type f -exec grep -q \"$out\" {} \\; \\\n     -printf \"removing references from %p\\n\" \\\n     -exec remove-references-to -t \"$out\" {} +\n\n# Delete obsolete stuff that conflicts with cups-filters.\nrm -rf $out/share/cups/banners $out/share/cups/data/testprint\n\nmoveToOutput bin/cups-config \"$dev\"\nsed -e \"/^cups_serverbin=/s|$lib|$out|\" \\\n    -i \"$dev/bin/cups-config\"\n\nfor f in \"$out\"/lib/systemd/system/*; do\n  substituteInPlace \"$f\" --replace \"$lib/$libexec\" \"$out/$libexec\"\ndone\n# Use xdg-open when on Linux\nsubstituteInPlace \"$out\"/share/applications/cups.desktop \\\n  --replace \"Exec=htmlview\" \"Exec=xdg-open\"\n","postPatch":"substituteInPlace cups/testfile.c \\\n  --replace 'cupsFileFind(\"cat\", \"/bin' 'cupsFileFind(\"cat\", \"/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin'\n\n  # The cups.socket unit shouldn't be part of cups.service: stopping the\n  # service would stop the socket and break subsequent socket activations.\n  # See https://github.com/apple/cups/issues/6005\n  sed -i '/PartOf=cups.service/d' scheduler/cups.socket.in\n","preConfigure":"export AR=\"/nix/store/7fpa17hpgqqs084lk08j0mwmc5xpbyf4-binutils-2.46/bin/ar\"\nconfigureFlagsArray+=(\n  # Put just lib/* and locale into $lib; this didn't work directly.\n  # lib/cups is moved back to $out in postInstall.\n  # Beware: some parts of cups probably don't fully respect these.\n  \"--prefix=$lib\"\n  \"--datadir=$out/share\"\n  \"--localedir=$lib/share/locale\"\n\n  \"--with-systemd=$out/lib/systemd/system\"\n\n  \n)\n","propagatedBuildInputs":["/nix/store/qbblni4f828ligb5wlls2nmhvamr6sf3-gmp-with-cxx-6.3.0-dev"],"propagatedNativeBuildInputs":[],"src":"/nix/store/0i7wmspcvcdzd774aspbr14kikdvcpdy-cups-2.4.19-source.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"2.4.19"},"system":"x86_64-linux","version":4},"91rq22hjizwqj1jnrxp0s6pvpk61hk8v-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/4wbq5vgb43mhxd4cdc7fzs6cdaq6pp00-source"},"inputs":{"drvs":{"078y0xd1fx6z4n9abgy5rv3nbali87h7-unzip-6.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"3xcrhx9g44is5067234b2bqzbgzyzbhb-glibc-locales-2.42-67.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"fipldvf4rvwd547anz21awdm06xvvl8d-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"source","outputs":{"out":{"hash":"sha256-6r0RXtmqGXtJbvLSD1Ma1xpqR8oXL2bBKaUE/cSENL8=","method":"nar"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":[],"curlOpts":"","curlOptsList":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetP