pagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","mesonFlags":"-Dintrospection=true","name":"gsettings-desktop-schemas-50.1","nativeBuildInputs":"/nix/store/azjvvvfpj7ri7s2hsijp3mbhgdx3szzl-glib-2.88.3-dev /nix/store/v801gannzcsbqazab2bcjz4a482rfzw8-meson-1.10.2 /nix/store/60z9n8f7cczph0klb7ny1mikhd8m1vkl-ninja-1.13.2 /nix/store/cizqnkc40i7k401f8cl2260ksi9nnph4-pkg-config-wrapper-0.29.2 /nix/store/7rpq0z0kkvvbfhskaqxq9rx1hv7iq4k9-gobject-introspection-wrapped-1.86.0-dev","out":"/nix/store/gs7nywn99nsl6rj7pzfln5ka24kl8x86-gsettings-desktop-schemas-50.1","outputs":"out","patches":"","pname":"gsettings-desktop-schemas","preInstall":"# Meson installs the schemas to share/glib-2.0/schemas\n# We add the override file there too so it will be compiled and later moved by\n# glib's setup hook.\nmkdir -p $out/share/glib-2.0/schemas\ncat - > $out/share/glib-2.0/schemas/remove-backgrounds.gschema.override <<- EOF\n  # These paths are supposed to refer to gnome-backgrounds\n  # but since we do not use FHS, they are broken.\n  # And we do not want to hardcode the correct paths\n  # since then every GTK app would pull in gnome-backgrounds.\n  # Let’s just override the broken paths so that people are not confused.\n  [org.gnome.desktop.background]\n  picture-uri=''\n  picture-uri-dark=''\n\n  [org.gnome.desktop.screensaver]\n  picture-uri=''\nEOF\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/z01xbjkqyj0w6v6xxlnl0h2pgvpjwj2c-gsettings-desktop-schemas-50.1.tar.xz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"50.1"},"inputs":{"drvs":{"12akz8ffzspfwgkg5lx05hy3ygh1bqm4-glib-2.88.3.drv":{"dynamicOutputs":{},"outputs":["dev"]},"2pic50w9brjn9k0vs3xil31sql1h2mik-gsettings-desktop-schemas-50.1.tar.xz.drv":{"dynamicOutputs":{},"outputs":["o