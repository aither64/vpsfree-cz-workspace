d even run if W^X is not enforced; it would fail dangerously.\nobjdump -p **/*.so | awk '\n  BEGIN { res = 0 }\n  /file format/ { file = $1 }\n  /STACK/ { stack = 1; next }\n  stack {\n    if ($0 ~ /flags.*x/) { print file \" has executable stack\"; res = 1 }\n    stack = 0\n  }\n  END { exit res }\n'\n","preConfigure":"rm configure\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"src":"/nix/store/85ca030305kjwx9nmycwvf6pdbdly4km-libressl-4.2.1.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"4.2.1"},"system":"x86_64-linux","version":4},"n9w1dvf9k6617mqdqj9vr74ajzpq2b3a-bash53-004.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"builtin:fetchurl","executable":"","impureEnvVars":"http_proxy https_proxy ftp_proxy all_proxy no_proxy","name":"bash53-004","out":"/nix/store/r5c3y73q0imsgrfpq9m6wxjcbxysgc0a-bash53-004","outputHash":"1l27jz4xzrajp0ww0rd7ylir1knrp6043y8j10pz6aam0i2x54cm","outputHashAlgo":"sha256","outputHashMode":"flat","preferLocalBuild":"1","system":"builtin","unpack":"","url":"https://ftpmirror.gnu.org/bash/bash-5.3-patches/bash53-004","urls":"https://ftpmirror.gnu.org/bash/bash-5.3-patches/bash53-004"},"inputs":{"drvs":{},"srcs":[]},"name":"bash53-004","outputs":{"out":{"hash":"sha256-lZHSRQRVKfMvCBL5QYC52c6QI/WnZcA5uFLl38mXR9A=","method":"flat"}},"system":"builtin","version":4},"n9x45zfsrcznjgzprsdzpnqwfsppch3c-bitvec-1.1.6.0.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/nn7hkgfgy8vp78wngrj7250cwa4nf4sz-bitvec-1.1.6.0.tar.gz"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn