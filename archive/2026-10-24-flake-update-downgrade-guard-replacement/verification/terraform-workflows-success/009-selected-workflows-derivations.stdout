$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/yaml-0.11.11.2\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"yaml-0.11.11.2","nativeBuildInputs":"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3 /nix/store/hbbp1a8sr589ycaqjyx1ck8gd4bxmfx1-remove-references-to /nix/store/9cclyqmrzvwh1l1d559hg2jcbnnz8bmp-hspec-discover-2.11.17","out":"/nix/store/wgspvhhbyfljxi6mb8qqxrj1d3gdwm95-yaml-0.11.11.2","outputs":"out doc bin","patches":"","pname":"yaml","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"echo \"Replace Cabal file with edited version from mirror://hackage/yaml-0.11.11.2/revision/2.cabal.\"\ncp /nix/store/z7j3pzgy992m6ba5b1aizn9v5pazm7v9-yaml-0.11.11.2-r2.cabal yaml.cabal\n\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"/nix/store/y57kizx597ivcfimwyms63xf2624i0fk-optparse-applicative-0.18.1.0 /nix/store/znzjnkp24jwvz693fisrg8s9ws8328nx-aeson-2.2.4.1 /nix/store/mx3gxaz4iqd60f8k2lvm83pzqw3kanvy-attoparsec-0.14.4   /nix/store/2m68yj7xv3mf1ankp18qjqp8q7divma6-conduit-1.3.6.1    /nix/store/03m99z2x676a4wwicb52xvd5yzxf3y1g-libyaml-0.1.4  /nix/store/6v2a86601bmfklgd6bwiy8rndpjni5w6-resourcet-1.3.0 /nix/store/5zqq10qhq25gjn3j5di8jxvy1hv3rr19-scientific-0.3.8.1    /nix/store/ww1pxl54z8jnczrxkpf9nqqjxbb91b8y-unordered-containers-0.2.20.1 /nix/store/9kp44f4jfr4kplyvbd6c74rg6bwl7z38-vector-0.13.2.0","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\