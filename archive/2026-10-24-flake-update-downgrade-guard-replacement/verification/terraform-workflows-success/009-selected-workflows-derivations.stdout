4rwyl1l-ruby3.4-connection_pool-3.0.2 /nix/store/gka44bv1rh4bb6ajb4vla2x5bck7fz4j-ruby3.4-drb-2.2.3 /nix/store/9knynf4iqfj1qnc493vc19ghhjaiv1fy-ruby3.4-i18n-1.15.2 /nix/store/dvyfqiy9q7l5mr2dsyvc5kxxvg5p6q7q-ruby3.4-json-2.21.2 /nix/store/fcna4azrh3fzjgbl7pnayvkbl1m3hqhv-ruby3.4-logger-1.7.0 /nix/store/mlqailg6d7kj6ml1lxwb998n3danqxwd-ruby3.4-minitest-6.0.6 /nix/store/kh0vkdk92zplllk4lw705y5bcixy1g6x-ruby3.4-securerandom-0.4.1 /nix/store/s7d46msmrjcbjgkaakq2c4ar53wi1r12-ruby3.4-tzinfo-2.0.6 /nix/store/f4gdx8p1pbnx2p6k9mzqzywhn0d2jd55-ruby3.4-uri-1.1.2","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-activesupport-8.1.4","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/s9s7rl49jvfylnci5zkx88xw38k219pi-ruby3.4-activesupport-8.1.4","outputs":"out","patches":"","pname":"activesupport","propagatedBuildInputs":"/nix/store/qrdhlx9bav6vck5kgikifnk5wckxx841-ruby3.4-base64-0.3.0 /nix/store/scffp40zaja962cxs6i4gnc0drkcczr3-ruby3.4-bigdecimal-4.1.3 /nix/store/b2hv8nhrwk5b7lna7gmf9mlb1gz7g27p-ruby3.4-concurrent-ruby-1.3.8 /nix/store/9khz38wxin7s5h8xc4qdvbk8c4rwyl1l-ruby3.4-connection_pool-3.0.2 /nix/store/gka44bv1rh4bb6ajb4vla2x5bck7fz4j-ruby3.4-drb-2.2.3 /nix/store/9knynf4iqfj1qnc493vc19ghhjaiv1fy-ruby3.4-i18n-1.15.2 /nix/store/dvyfqiy9q7l5mr2dsyvc5kxxvg5p6q7q-ruby3.4-json-2.21.2 /nix/store/fcna4azrh3fzjgbl7pnayvkbl1m3hqhv-ruby3.4-logger-1.7.0 /nix/store/mlqailg6d7kj6ml1lxwb998n3danqxwd-ruby3.4-minitest-6.0.6 /nix/store/kh0vkdk92zplllk4lw705y5bcixy1g6x-ruby3.4-securerandom-0.4.1 /nix/store/s7d46msmrjcbjgkaakq2c4ar53wi1r12-ruby3.4-tzinfo-2.0.6 /nix/store/f4gdx8p1pbnx2p6k9mzqzywhn0d2jd55-ruby3.4-uri-1.1.2","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/qrdhlx9bav6vck5kgikifnk5wckxx841-ruby3.4-base64-0.3.0 /nix/store/scffp40zaja962cxs6i4gnc0drkcczr3-ruby3.4-bigdecimal-4.1.3 /nix/store/b2hv8nhrwk5b7lna7gmf9mlb1gz7g27p-ruby3.4-concurrent-ruby-1.3.8 /nix/store/9khz38wxin7s5h8xc4qdvbk8c4rwyl1l-ruby3.4-connection_pool-3.0.2 /nix/store/gka44bv1rh4bb6ajb4