they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/g3xy4vj8db8fn8060vzp9hwfdmvg7mn8-hslua-classes-2.3.2.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"2.3.2"},"inputs":{"drvs":{"001knbnalg6nzcg046qrbh5zpm0zv45a-tasty-hslua-1.1.1.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"1gbawc48yci42lbjjgipkg2335ax539g-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"31crzmq8yc1nlj0wjfh9afjwpkc86vpj-glibc-locales-2.42-67.drv":{"dynamicOutputs":{},"outputs":["out"]},"48q7a96p7pjggivw0bs463c80diwc0h9-hslua-marshalling-2.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"4by2ygk033w4hyngk9cx8ygjppk8s4ix-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"6mfw1drgqrq50ipxcjqilgynnl18scdy-hslua-core-2.3.2.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"d34bmbz8sglhy53fldk