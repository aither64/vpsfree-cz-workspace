ot=false; to fetchzip to assume flat list of files.\"\n  exit 1\nfi\nfn=$(cd \"$unpackDir\" && ls -A)\nif [ -f \"$unpackDir/$fn\" ]; then\n  mkdir $out\nfi\nmv \"$unpackDir/$fn\" \"$out\"\n\n\nchmod 755 \"$out\"\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"recursiveHash":true,"repo":"gixy","rev":"v0.1.21","revCustom":"v0.1.21","showURLs":false,"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"stripRoot":true,"system":"x86_64-linux","urls":["https://github.com/yandex/gixy/archive/v0.1.21.tar.gz"]},"system":"x86_64-linux","version":4},"zv554b6qwmhffgd6bghk8aq236g0n92h-unit-script-initrd-find-nixos-closure-start.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"initrd-find-nixos-closure-start","__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash -n -O extglob \"$target\"\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"/bin/initrd-find-nixos-closure-start","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"unit-script-initrd-find-nixos-closure-start","nativeBuildInputs":"","out":"/nix/store/ai0ykm3nn24zddz097lilil202bmlwf8-unit-script-initrd-find-nixos-closure-start","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash\nset -e\n\nset -uo pipefail\nexport PATH=\"/bin:/nix/store/j2cwh4a23s7z65nyvjfck2axj2ci16ml-util-linux-minimal-2.42.2-bin/bin:/nix/store/612ghk5z4jw3qpy9pv1zmdrw9fxq6kw9-nixos-init-0.1.0/bin\"\n\n# Figure out what closure to boot\nclosure=\nfor o in $(< /proc/cmdline); do\n    case $o in\n        init=*)\n            IFS=\"=\" read -r -a initParam <<< \"$o\"\n            closure=\"${initParam[1]}\"\n            ;;\n    esac\ndone\n\n# Sanity check\nif [ -z \"${closure:-}\" ]; then\n  echo 'No init= parameter on the kernel command line' >&2\n  exit 1\nfi\n\n# Resolve symlinks in the init parameter. We need this for some boot loaders\n# (e.g. boot.loader.generationsDir).\nclosure=\"$(resolve-in-root /sysroot \"$closure\")\"\n\n# Assume the directory containing the init script is the closure.\nclosure=\"$(dirname \"$closure\")\"\n\nln --symbolic \"$closure\" /nixos-closure\n\n# If we are not booting a NixOS closure (e.g. init=/bin/sh),\n# we don't know what root to prepare so we don't do anything\nif ! [ -x \"/sysroot$(readlink \"/sysroot$closure/prepare-root\" || echo \"$closure/prepare-root\")\" ]; then\n  echo \"NEW_INIT=${initParam[1]}\" > /etc/switch-root.conf\n  echo \"$closure does not look like a NixOS installation - not activating\"\n  exit 0\nfi\necho 'NEW_INIT=' > /etc/switch-root.conf\n\n\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"dlp8kg7a8yrmjabh7gms37qpk6m9xqjm-util-linux-minimal-2.42.2.drv":{"dynamicOutputs":{},"outputs":