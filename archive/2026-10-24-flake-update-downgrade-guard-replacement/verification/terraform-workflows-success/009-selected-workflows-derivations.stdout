-config\" >> $out/.cargo/config.toml\n        fi\n      fi\n    done\n","buildInputs":[],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{},"mesonFlags":[],"name":"cargo-vendor-dir","nativeBuildInputs":[],"outputChecks":{"out":{}},"outputs":["out"],"passAsFile":["buildCommand"],"patches":[],"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"system":"x86_64-linux"},"system":"x86_64-linux","version":4},"74pg36fad17834wylzvv8h2l69w2qn4y-curl-8.21.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"bin":"/nix/store/w32hb8w5v3a562nlmmnw42g39sk8a8xg-curl-8.21.0-bin","debug":"/nix/store/r5c9hwvybnbaxyxlbrfdmpq4f9zynzj5-curl-8.21.0-debug","dev":"/nix/store/l1ngqxf7k8mp8v69arris6vvlfdz58f0-curl-8.21.0-dev","devdoc":"/nix/store/1xwfls5cqp4q5675wmpjaa5wpl191w2x-curl-8.21.0-devdoc","man":"/nix/store/src7c490drqplf6821s7micfncrmb2rz-curl-8.21.0-man","out":"/nix/store/4yf8dk984hdpjgq9v6dh1f11nwjlg8fi-curl-8.21.0"},"inputs":{"drvs":{"5z8sj1169xaps07s9yw780fvznwn8yqy-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"dnz4fqzcnwyfhq2qx2m4c63qiw8kp70a-perl-5.42.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"m2drmm24vp067k5nx3xngi4fvpi4rnq1-curl-8.21.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"m