apper-15.2.0/bin/nm STRIP=/nix/store/7fpa17hpgqqs084lk08j0mwmc5xpbyf4-binutils-2.46/bin/strip OBJCOPY=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/objcopy OBJDUMP=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/objdump READELF=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/readelf HOSTCC=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/cc HOSTCXX=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/c++ HOSTAR=/nix/store/25771zf6h2dryp8d3i65gyg17mmphy9v-binutils-wrapper-2.46/bin/ar HOSTLD=/nix/store/25771zf6h2dryp8d3i65gyg17mmphy9v-binutils-wrapper-2.46/bin/ld ARCH=x86_64 CROSS_COMPILE=","mesonFlags":"","name":"linux-config-6.18.45","nativeBuildInputs":"/nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0 /nix/store/qbblni4f828ligb5wlls2nmhvamr6sf3-gmp-with-cxx-6.3.0-dev /nix/store/f0a4hywr1hjw241wgcgdi4wmhfv66jrg-libmpc-1.4.0 /nix/store/d06f6w98w240srb893aqnzpfqjs3pmhk-mpfr-4.2.2-dev /nix/store/47ibddl4z6rmhp517p1sas0qlapbb1zh-bison-3.8.2 /nix/store/y3ym52hvpsp1f8c8jd58rlhyj5yigibn-flex-2.6.4 /nix/store/4ggx0lbj307k4cvg207dhzk03mpc7ihb-pahole-1.31 /nix/store/wqmyyw2i4mv2bjs8x0n79zyri2ks22pi-rust-bindgen-unwrapped-0.72.1 /nix/store/4838cpsffgmc4xw856y0zdpvgssjljm0-rustc-1.95.0","out":"/nix/store/48bdr4km54v45rjr7b75i6wcyakpz7r7-linux-config-6.18.45","outputs":"out","patches":"/nix/store/mnlqwys9dxznjcvq4w3s0435s9ql8qv8-bridge-stp-helper.patch /nix/store/mbz5gln1q4swlzmqs2399br98qjif9kn-request-key-helper.patch /nix/store/23728y7zgh1jb55kpwxv5qnjbq0ykca6-randstruct-provide-seed-5.19.patch","pname":"linux-config","postPatch":"# Ensure that depmod gets resolved through PATH\nsed -i Makefile -e 's|= /sbin/depmod|= depmod|'\n\n# Some linux-hardened patches now remove certain files in the scripts directory, so the file may not exist.\n[[ -f scripts/ld-version.sh ]] && patchShebangs scripts/ld-version.sh\n\n# Set randstruct seed to a deterministic but diversified value. Note:\n# we could have instead patched gen-random-seed.sh to take input from\n# the buildFlags, but that would require also patching the kernel's\n# toplevel Makefile to add a variable export. This would be likely to\n# cause future patch conflicts.\nfor file in scripts/gen-randstruct-seed.sh scripts/gcc-plugins/gen-random-seed.sh; do\n  if [ -f \"$file\" ]; then\n    substituteInPlace \"$file\" \\\n      --replace NIXOS_RANDSTRUCT_SEED \\\n      $(echo /nix/store/g1lm8gwfg2ix8xv435wvg446cz2ikmp7-linux-6.18.45.tar.xz /1s3bzfisrvrdlla1qr3z074sphpb4cpz4rbacwp56cmp9237lv2y | sha256sum | cut -d ' ' -f 1 | tr -d '\\n')\n    break\n  fi\ndone\n\npatchShebangs scripts\n\n# also patch arch-specific install scripts\nfor i in $(find arch -name install.sh); do\n    patchShebangs \"$i\"\ndone\n\n# unset $src because the build system tries to use it and spams a bunch of warnings\n# see: https://github.com/torvalds/linux/commit/b1992c3772e69a6fd0e3fc81cd4d2820c8b6eca0\nunset src\n# Patch kconfig to print \"###\" after every question so that\n# generate-config.pl from the generic builder can answer them.\nsed -e '/fflush(stdout);/i\\printf(\"###\");' -i scripts/kconfig/conf.c\n","preUnpack":"","preferBuiltin":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/g1lm8gwfg2ix8xv435wvg446cz2ikmp7-linux-6.18.45.tar.xz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"6.18.45"},"inputs":{"drvs":{"0ypak63jwwgggmqhf18xnsm4lzbhq77c-linux-6.18.45.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"3bkl4yqj9z2vyd4ginlzfh6cv8x8997j-flex-2.6.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"3qsb40pprfnj2kg94rmh1zlsm41jrv8s-rustc-1.95.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"76z1f4wh1qchqchyna9h10vsrdzadcsb-libmpc-1.4.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"82h6sgm5vghha9vs35f5hmq9ygslg855-gcc-15.2.0.drv