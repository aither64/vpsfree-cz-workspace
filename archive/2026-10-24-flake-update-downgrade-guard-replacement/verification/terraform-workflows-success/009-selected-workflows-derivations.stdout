4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":[],"configurePhase":"runHook preConfigure\n\nmkdir build\nexport buildRoot=\"$(pwd)/build\"\n\necho \"manual-config configurePhase buildRoot=$buildRoot pwd=$PWD\"\n\nif [ -f \"$buildRoot/.config\" ]; then\n  echo \"Could not link $buildRoot/.config : file exists\"\n  exit 1\nfi\nln -sv /nix/store/5d0pprz01ya12mm1q4sy03p29ji83br3-linux-config-6.12.104 $buildRoot/.config\n\n# reads the existing .config file and prompts the user for options in\n# the current kernel source that are not found in the file.\nmake \"${makeFlags[@]}\" oldconfig\nrunHook postConfigure\n\nmake \"${makeFlags[@]}\" prepare\nactualModDirVersion=\"$(cat $buildRoot/include/config/kernel.release)\"\nif [ \"$actualModDirVersion\" != \"6.12.104\" ]; then\n  echo \"Error: modDirVersion 6.12.104 specified in the Nix expression is wrong, it should be: $actualModDirVersion\"\n  exit 1\nfi\n\nbuildFlags+=(\"KBUILD_BUILD_TIMESTAMP=$(date -u -d @$SOURCE_DATE_EPOCH)\")\n\ncd $buildRoot\n","depsBuildBuild":["/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0"],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"dontCheckForBrokenSymlinks":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"KRUSTFLAGS":"--remap-path-prefix /nix/store/pfhglic7cvs9nwlq3z1kqhlzxh51w0jm-rust-lib-src=/","RUST_LIB_SRC":"/nix/store/pfhglic7cvs9nwlq3z1kqhlzxh51w0jm-rust-lib-src"},"hardeningDisable":["bindnow","format","fortify","stackprotector","pic"],"installFlags":["INSTALL_PATH=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9","INSTALL_MOD_PATH=/05n2ffx0bx7cbs5cpskwv10kvhr5662c2hh43kwqqb2y4gmiifn9"],"installTargets":["install"],"karch":"x86_64","makeFlags":["O=$(buildRoot)","--eval=undefine modules","CC=/nix/store/2limljgc50jy76vg388ld