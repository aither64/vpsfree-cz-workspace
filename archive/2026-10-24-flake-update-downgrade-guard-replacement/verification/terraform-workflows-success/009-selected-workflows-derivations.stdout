\n  ;;\nunload)\n  livepatch=$(cat /etc/livepatch-store-path)\n# Patches built with build-kpatch\nif [ -d /sys/kernel/livepatch/livepatch_6 ] && [ -f /sys/kernel/livepatch/livepatch_6/enabled ]; then\n  echo -en live-patches: disabling livepatch_6..\n  echo 0 > /sys/kernel/livepatch/livepatch_6/enabled 2>/dev/null\n  retries=91\n  while [ -d /sys/kernel/livepatch/livepatch_6 ] && [ $retries -gt 0 ]; do\n    if [ \"$(( $retries % 5 ))\" -eq 0 ]; then\n      echo -en \" $retries \"\n    fi\n    transition=$(cat /sys/kernel/livepatch/livepatch_6/transition 2>/dev/null)\n    if [ \"$transition\" -eq 1 ] 2>/dev/null; then\n      echo -en .\n    else\n      echo -en ?\n    fi\n    retries=$(( $retries - 1 ))\n    sleep 1\n  done\n  echo\nfi\nretries=13\nif [ -d /sys/module/livepatch_6 ]; then\n  echo -en live-patches: unloading livepatch_6..\n  while [ -d /sys/module/livepatch_6 ] && [ $retries -gt 0 ]; do\n    if [ \"$(( $retries % 3 ))\" -eq 0 ]; then\n      echo -en \" $retries \"\n    fi\n    echo -en .\n    retries=$(( $retries - 1 ))\n    if ! rmmod livepatch_6 2>/dev/null; then\n      sleep 0.2\n    fi\n    if [ \"$retries\" -eq 0 ]; then\n      echo -en \"\\nlive-patches: unloading livepatch_6... FAILED\"\n    fi\n  done\n  echo\nfi\nrm -f /run/vpsadminos/livepatches/livepatch_6.applied-at\n\n\n  ;;\nlist)\n  livepatch=$(cat /etc/livepatch-store-path)\ns=\"[\"\nif [ -d /sys/module/livepatch_6 ]; then\n  s=\"$s loaded\";\n  if [ -f /sys/kernel/livepatch/livepatch_6/enabled ] && \\\n     [ \"$(cat /sys/kernel/livepatch/livepatch_6/enabled 2>/dev/null)\" == \"1\" ]; then\n    s=\"$s enabled\"\n  fi\n  if [ \"$(cat /sys/kernel/livepatch/livepatch_6/transition 2>/dev/null)\" == \"1\" ]; then\n    s=\"$s transition\"\n  fi\nelse\n  s=\"$s unloaded\"\nfi\nprintf \"%-27s%s\\n\" \"$s\" \" ] livepatch_6\"\n\n\n  ;;\nstatus)\n  livepatch=$(cat /etc/livepatch-store-path)\ns=\"[\"\nif [ -d /sys/module/livepatch_6 ]; then\n  s=\"$s loaded\";\n  if [ -f /sys/kernel/livepatch/livepatch_6/enabled ] && \\\n     [ \"$(cat /sys/kernel/livepatch/livepatch_6/enabled 2>/dev/null)\" == \"1\" ]; then\n    s=\"$s enabled\"\n  fi\n  if [ \"$(cat /sys/kernel/livepatch/livepatch_6/transition 2>/dev/null)\" == \"1\" ]; then\n    s=\"$s transition\"\n  fi\nelse\n  s=\"$s unloaded\"\nfi\nprintf \"%-27s%s\\n\" \"$s\" \" ] livepatch_6\"\n\n\nprintf '%29s %s\n' 'contains:' 'bp-6.12.95-cumulative(v6)'\n\n  ;;\n*)\n  echo \"usage: $0 load|unload|list|status\"\n  ;;\nesac\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"live-patches","outputs":{"out":{"path":"c8j9fshk7gw9kv5pr3xjsbm2g7is2c7z-live-patches"}},"system":"x86_64-linux","version":4},"zx5b0pppdvd1sja114g29zh80y1zn9f7-file-5.47.tar.gz.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"builtin:fetchurl","executable":"","impureEnvVars":"http_proxy https_proxy ftp_proxy all_proxy no_proxy","name":"file-5.47.tar.gz","out":"/nix/store/lrj741yxfmh2iy85w646w2kphlnz86dg-file-5.47.tar.gz","outputHash":"sha256-RWcv7BZctMwTWKLXa11X0ih23Ll6sWlCesOFy+HVWXo=","outputHashAlgo":"","outputHashMode":"flat","preferLocalBuild":"1","system":"builtin","unpack":"","url":"https://astron.com/pub/file/file-5.47.tar.gz","urls":"https://astron.com/pub/file/file-5.47.tar.gz"},"inputs":{"drvs":{},"srcs":[]},"name":"file-5.47.tar.gz","outputs":{"out":{"hash":"sha256-RWcv7BZctMwTWKLXa11X0ih23Ll6sWlCesOFy+HVWXo=","method":"flat"}},"system":"builtin","version":4},"zxg0j17pxi56i4hxa73pfqqj1j13zfhz-libdecor-0.2.5.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structure