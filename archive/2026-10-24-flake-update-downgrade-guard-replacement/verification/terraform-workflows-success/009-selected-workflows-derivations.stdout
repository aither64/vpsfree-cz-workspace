\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash -n -O extglob \"$target\"\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"/bin/vpsadmin-supervisor-pre-start","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"unit-script-vpsadmin-supervisor-pre-start","nativeBuildInputs":"","out":"/nix/store/954vdas50vjzmdvzzmp2x12g22ixhid4-unit-script-vpsadmin-supervisor-pre-start","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash\nset -e\n\nset -euo pipefail\nshopt -s nullglob\n\n# Cleanup previous state\nrm -f \"/var/lib/vpsadmin/supervisor/plugins/\"*\nfind \"/var/lib/vpsadmin/supervisor/config\" -type l -exec rm -f {} +\n\n# Link in configuration\nfor v in \"/nix/store/b0kcn1kl2srccx8jn4nkl9ik1z9i1xrw-api\"/* ; do\n  ln -sf \"$v\" \"/var/lib/vpsadmin/supervisor/config/$(basename $v)\"\ndone\n\nrm -f \"/var/lib/vpsadmin/supervisor/config/deployment.json\"\ncp -f /nix/store/8q5r2af6imy7cnzspr3cd27p3rz2ncf6-deployment.json \"/var/lib/vpsadmin/supervisor/config/deployment.json\"\nchmod 440 \"/var/lib/vpsadmin/supervisor/config/deployment.json\"\n\n# Link in enabled plugins\nfor plugin in monitoring newslog outage_reports payments requests webui; do\n  ln -sf \"/nix/store/yj0aq4m4g44qv3q9xjmdg2hmnbac2bf1-vpsadmin-supervisor-unknown/plugins/$plugin\" \"/var/lib/vpsadmin/supervisor/plugins/$plugin\"\ndone\n\n# Handle database.passwordFile & permissions\nDBPASS=$(head -n1 /etc/vpsadmin-test/mariadb-supervisor-password)\ndatabaseYmlTmp=\"$(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/mktemp \"/var/lib/vpsadmin/supervisor/config/.database.yml.XXXXXX\")\"\ntrap '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/rm -f \"$databaseYmlTmp\"' EXIT\nsed -e \"s,#dbpass#,$DBPASS,g\" /nix/store/2lzvywl28l5959b9psa6z4phg4mb5bdb-database.yml >\"$databaseYmlTmp\"\nchmod 440 \"$databaseYmlTmp\"\nmv -f \"$databaseYmlTmp\" \"/var/lib/vpsadmin/supervisor/config/database.yml\"\ntrap - EXIT\n\n\nRABBITMQ_PASS=$(head -n1 /etc/vpsadmin-test/rabbitmq-supervisor-password)\ncp -f /nix/store/542z2mmchv3bcgnb9235qgviwrb3cw27-rabbitmq.yml \"/var/lib/vpsadmin/supervisor/config/supervisor.yml\"\nsed -e \"s,#rabbitmq_pass#,$RABBITMQ_PASS,g\" -i \"/var/lib/vpsadmin/supervisor/config/supervisor.yml\"\nchmod 440 \"/var/lib/vpsadmin/supervisor/config/supervisor.yml\"\n\n\n"},"inputs":{"drvs":{"0dx0q2zclkq8idaqk2v3rpjya8yd6lsq-database.yml.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"92p3r878k9g4bl165dssn6chbp4d9z07-deployment.json.drv":{"dynamicOutputs":{},"outputs":["out"]},"fc05c4nm79fp6w1psc0bijz6ba2xnmi8-rabbitmq.yml.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"siyvn3gmwrrsg9yvr58zgk2xyhmf2rrx-vpsadmin-supervisor-unknown.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["b0kcn1kl2srccx8jn4nkl9ik1z9i1xrw-api","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-vpsadmin-supervisor-pre-start","outputs":{"out":{"path":"954vdas50vjzmdvzzmp2x12g22ixhid4-unit-script-vpsadmin-supervisor-pre-start"}},"syst