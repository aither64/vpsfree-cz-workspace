# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-haveapi-client-0.29.9","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/91l2aj4xybyqaqpk5l41pdv4rbanwl4k-ruby3.4-haveapi-client-0.29.9","outputs":"out","patches":"","pname":"haveapi-client","propagatedBuildInputs":"/nix/store/s9s7rl49jvfylnci5zkx88xw38k219pi-ruby3.4-activesupport-8.1.4 /nix/store/z9b75x4x7gcfkf2y5sg09vi2w7f44aki-ruby3.4-highline-3.1.2 /nix/store/dvyfqiy9q7l5mr2dsyvc5kxxvg5p6q7q-ruby3.4-json-2.21.2 /nix/store/zh1f71hiarprpd34jgga5s1hcb3x3ic6-ruby3.4-require_all-2.0.0 /nix/store/35r3j4x2zxajmrqnqj5b4dckffqdg5zs-ruby3.4-rest-client-2.1.0 /nix/store/ql98sfndlmfzccq0r7k4c58afwiyhkr9-ruby3.4-ruby-progressbar-1.13.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/s9s7rl49jvfylnci5zkx88xw38k219pi-ruby3.4-activesupport-8.1.4 /nix/store/z9b75x4x7gcfkf2y5sg09vi2w7f44aki-ruby3.4-highline-3.1.2 /nix/store/dvyfqiy9q7l5mr2dsyvc5kxxvg5p6q7q-ruby3.4-json-2.21.2 /nix/store/zh1f71hiarprpd34jgga5s1hcb3x3ic6-ruby3.4-require_all-2.0.0 /nix/store/35r3j4x2zxajmrqnqj5b4dckffqdg5zs-ruby3.4-rest-client-2.1.0 /nix/store/ql98sfndlmfzccq0r7k4c58afwiyhkr9-ruby3.4-ruby-progressbar-1.13.0","ruby":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9","src":"/nix/store/58rh7w7aqw5201nv2vi6pmyq6xmm8xcy-haveapi-client-0.29.9.gem","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"0.29.9","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"0.29.9"},"inputs":{"drvs":{"32qav6c71psc102jfkcshbcl4sl67hr5-ruby3.4-ruby-progressbar-1.13.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"90smicx816w3pw3zd01ylc392pmbgw89-ruby3.4-activesupport-8.1.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"gs4d83rrq9msghnmsyq00nwn6paag5b8-ruby3.4-rest-client-2.1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"killhvwdxijrsjk5f3h80s3wzny0aphj-ruby3.4-highline-3.1.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"nx44hxiycfk0dwa5h4ppfasp00yiwdla-ruby3.4-require_all-2.0.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"qh350fb0h8mc0y5pnnk012v7bics16zc-haveapi-client-0.29.9.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"vg8pjwrwm5d62glb6i3ams2vrxv9xiiq-ruby3.4-json-2.21.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"xshd860gif707cn5krzl14260ash8c02-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"y898s2ajfd6ag157gc7gwa1z5vcbil9m-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-haveapi-client-0.29.9","outputs":{"out":{"path":"91l2aj4xybyqaqpk5