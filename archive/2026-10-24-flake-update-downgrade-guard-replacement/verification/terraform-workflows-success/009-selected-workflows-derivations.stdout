t=\"$(gem build $gemspec | tee >(cat - >&3))\"\n  exec 3>&-\n\n  gempkg=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"activesupport haveapi-client i18n json mail nesty rack-oauth2 rake redcarpet require_all sinatra sinatra-contrib tilt","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"haveapi","gemPath":"/nix/store/s9s7rl49jvfylnci5zkx88xw38k219pi-ruby3.4-activesupport-8.1.4 /nix/store/91l2aj4xybyqaqpk5l41pdv4rbanwl4k-ruby3.4-haveapi-client-0.29.9 /nix/store/9knynf4iqfj1qnc493vc19ghhjaiv1fy-ruby3.4-i18n-1.15.2 /nix/store/dvyfqiy9q7l5mr2dsyvc5kxxvg5p6q7q-ruby3.4-json-2.21.2 /nix/store/vpq7iwqr5w49fkl6aag3f7a33cs9h8mv-ruby3.4-mail-2.9.1 /nix/store/jhc5zyd07wb2jhhs6zv7xk6c3r46zhzm-ruby3.4-nesty-1.0.2 /nix/store/ygz7j4qmcgyck0b8ag3zdxb00na2x1f7-ruby3.4-rack-oauth2-2.2.1 /nix/store/dcyjhpr9p9hqwgsik3rws28hbpvgm5xf-ruby3.4-rake-13.4.2 /nix/store/hfp09kc14whcfx0snv7k901viw9xg7mx-ruby3.4-redcarpet-3.6.1 /nix/store/zh1f71hiarprpd34jgga5s1hcb3x3ic6-ruby3.4-require_all-2.0.0 /nix/store/lsa145j0s8wqwwvbqh0azwiw2hnammb7-ruby3.4-sinatra-4.2.1 /nix/store/3zlzkrrclribgmgkmzsi7d3nq8a60162-ruby3.4-sinatra-contrib-4.2.1 /nix/store/jp75cmgwl126da3xc0m6xaxhl4ply6r3-ruby3.4-tilt-2.9.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-haveapi-0.29.9","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-s