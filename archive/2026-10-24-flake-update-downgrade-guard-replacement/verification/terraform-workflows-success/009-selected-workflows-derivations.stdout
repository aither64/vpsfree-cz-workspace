t for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-nodectl-4.2.1","nativeBuildInputs":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/hzj8rlqrgc9mg0k2a9scjm7mb4w6gryp-ruby3.4-nodectl-4.2.1","outputs":"out","patches":"","pname":"nodectl","propagatedBuildInputs":"/nix/store/nw3in7jsrl9bch00r89pzcnzndv9rsk2-ruby3.4-json-3.1.0 /nix/store/803sam1npq4mb2xgwbv3knsrzkpa002b-ruby3.4-libnodectld-4.2.1 /nix/store/wawm9j6ss6xa58ppll783ldx1aac69y5-ruby3.4-libosctl-26.05.0 /nix/store/nskj1cxn37p0f24d7l3yrlg4qcxfqw6g-ruby3.4-pry-0.14.2 /nix/store/6hakjdc9d62phikpy2aa7shccp47wwzd-ruby3.4-pry-remote-0.1.8 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/nw3in7jsrl9bch00r89pzcnzndv9rsk2-ruby3.4-json-3.1.0 /nix/store/803sam1npq4mb2xgwbv3knsrzkpa002b-ruby3.4-libnodectld-4.2.1 /nix/store/wawm9j6ss6xa58ppll783ldx1aac69y5-ruby3.4-libosctl-26.05.0 /nix/store/nskj1cxn37p0f24d7l3yrlg4qcxfqw6g-ruby3.4-pry-0.14.2 /nix/store/6hakjdc9d62phikpy2aa7shccp47wwzd-ruby3.4-pry-remote-0.1.8 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0","ruby":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9","src":"/nix/store/0xx7cm39cy10kf53ppymspvgszdq7vm5-rx6nc2dk29njhn80h63xygn6l4fgb3pb-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"4.2.1","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nmkdir source\ncp -a \"$src/.\" source/\nchmod -R u+w source\nsourceRoot=source/nodectl\n\nrunHook postUnpack\n","version":"4.2.1"},"inputs":{"drvs":{"5jkrqf882wd3ddir8c623wqhv62638fx-ruby3.4-pry-0.14.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"b7pl6xhg35fir9clh6vnbjqq5r5z87mc-ruby3.4-libosctl-26.05.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"cwm3ljfzna9n0vd27agz5h5y26y2gmmj-ruby3.4-json-3.1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"d6wp995z4l9c6qrisdcls0zp6z8i5xiv-ruby3.4-pry-remote-0.1.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"jvy3mrn22mbmwc471f6xld6fvg3z2qfb-ruby3.4-libnodectld-4.2.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"vib5s2ffydrqfwdaw9mxd1d00y33vdcw-ruby3.4-require_all-2.0.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"vwv6gjb7r637il50p7sjbf0qn3lpxv3y-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"xshd860gif707cn5krzl14260ash8c02-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["0xx7cm39cy10kf53ppymspvgszdq7vm5-rx6nc2dk29njhn80h63xygn6l4fgb3pb-source","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-nodectl-4.2.1","outputs":{"out":{"path":"hzj8rlqrgc9mg0k2a9scjm7mb4w6gryp-ruby3.4-nodectl-4.2.1"}},"system":"x86_64-linux","version":4},"3xbfz95lqkdwswc6f7078lf69v450c70-logrotate.conf.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"# logrotate --debug also checks that users specified in config\n# file exist, but we only have sandboxed users here so brown these\n# out. according to man page that means su, create and createolddir.\n# files required to exist also won't be present, so missingok is forced.\nuser=$(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/id -un)\ngroup=$(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/id -gn)\nsed -E -e \"s/\\bsu\\s.*/su $user $group/\" \\\n       -e \"s/\\b((create|createolddir)\\b(\\s+[0-9]+)?).*/\\1 $user $group/\" \\\n       -e \"1imissingok\" -e \"s/\\bnomissingok\\b//\" \\\n    $out > logrotate.conf\n# Since this makes for very verbose builds only show real error.\n# There is no way to control log level, but logrotate hardcodes\n# 'error:' at common log level, so we can use grep, taking care\n# to keep error codes\nset -o pipefail\nif ! /nix/store/wkwww4aqjya04ghixs6ihbx2hd9jz3da-logrotate-3.22.0/sbin/logrotate -s logrotate.status \\\n                --debug logrotate.conf 2>&1 \\\n            | ( ! grep \"error:\" ) > logrotate-error; then\n        echo \"Logrotate configuration check failed.\"\n        echo \"The failing configuration (after adjustments to pass tests in sandbox) was:\"\n        printf \"%s\\n\" \"-------\"\n        cat logrotate.conf\n        printf \"%s\\n\" \"-------\"\n        echo \"The error reported by logrotate was as follow:\"\n        printf \"%s\\n\" \"-------\"\n        cat logrotate-error\n        printf \"%s\\n\" \"-------\"\n        echo \"You can disable this check with services.logrotate.checkConfig = false,\"\n        echo \"but if you think it should work please report this failure along with\"\n        echo \"the config file being tested!\"\n        false\nfi\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"","mesonFlags":"","name":"logrotate.conf","nativeBuildInputs":"","out":"/nix/store/59a1ia992iasz5hcg9xmj6188sivq45a-logrotate.conf","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"weekly\nmissingok\nnotifempty\nrotate 4\n\n\"/var/log/btmp\" {\n  create 0660 root utmp\n  monthly\n  minsize 1M\n  rotate 1\n}\n\n\"/var/log/wtmp\" {\n  create 0664 root utmp\n  monthly\n  minsize 1M\n  rotate 1\n}\n"},"inputs":{"drvs":{"274s4ls38s2rsyiwnw00yxcamwsi54hw-logrotate-3.22.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"logrotate.conf","outputs":{"out":{"path":"59a1ia992iasz5hcg9xmj6188sivq45a-logrotate.conf"}},"system":"x86_64-linux","version":4},"3xcrhx9g44is5067234b2bqzbgzyzbhb-glibc-locales-2.42-67.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"BASH_SHELL":"/bin/sh","LOCALEDEF_FLAGS":"--little-endian","NIX_NO_SELF_RPATH":"1","__structuredAttrs":"","buildInputs":"/nix/store/zkbb7r81giw7k0lhax3cwyl0l97dcskf-linux-headers-6.18.7","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"-C --enable-add-ons --sysconfdir=/etc --enable-stack-protector=strong --enable-bind-now --without-headers --disable-profile --enable-fortify-source --enable-static-pie","depsBuildBuild":"/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","extraNativeBuildInputs":"/nix/store/m07h00fl6538s4gavrp66a20ka4hg7fy-glibc-2.42-67","installFlags":"sysconfdir=$(out)/etc","installPhase":"mkdir -p \"$out/lib/locale\" \"$out/share/i18n\"\ncp -v \"$TMPDIR/$NIX_STORE/\"*\"/lib/locale/locale-archive\" \"$out/lib/locale\"\ncp -v ../localedata/SUPPORTED \"$out/share/i18n/SUPPORTED\"\n","is64bit":"1","linuxHeaders":"","makeFlags":"OBJCOPY=objcopy BUILD_LDFLAGS=-Wl,-rpath,/nix/store/m07h00fl6538s4gavrp66a20ka4hg7fy-glibc-2.42-67/lib OBJDUMP=/nix/store/7fpa17hpgqqs084lk08j0mwmc5xpbyf4-binutils-2.46/bin/objdump localedata/install-locales localedir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/locale","mesonFlags":"","name":"glibc-locales-2.42-67","nativeBuildInputs":"/nix/store/47ibddl4z6rmhp517p1sas0qlapbb1zh-bison-3.8.2 /nix/store/db8cwzsgxv3lijvf18kqvjjbylm5hrpi-gettext-1.0 /nix/store/yk1qqipjasb5mgjpq1vikmjf7aibbszn-python3-minimal-3.13.15 /nix/store/2rgc5gn3a2qids4bhjaq2g1l1r2i1637-glibc-2.42-67-dev","out":"/nix/store/mkblgh8iv5fgipy0llqsghgn86mrgs82-glibc-locales-2.42-67","outputs":"out","patches":"/nix/store/43b9m8jsp2sybz9n2yfjs5fpcv2x5ir3-2.42-master.patch /nix/store/nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch /nix/store/b1w7zbvm39ff1i52iyjggyvw2rdxz104-dont-use-system-ld-so-cache.patch /nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch /nix/store/llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch /nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch /nix/store/001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch /nix/store/0mb1pqwqkz9sk1fwgn897zlwzhhgfpbf-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch /nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch /nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch /nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch /nix/store/628jb27r7gyzblzn11d77nl5264ih86b-0001-resolv-Check-for-inet_ntop-failure-in-ns_sprintrrf.patch /nix/store/0swhhq4hf4vjsxndsqxs2can3mcsn2ca-0002-resolv-More-types-as-unknown-in-ns_sprintrrf-CVE-202.patch /nix/store/4i53m3qfc9lj43bnq4bs6kbdkw6ljj67-0003-resolv-Fix-buffer-overreads-in-ns_sprintrrf-CVE-2026.patch","pname":"glibc-locales","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n","postInstall":"moveToOutput bin/getent $getent\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/xidgjdv05b8yz6w6qrhk4mmjxm4l2zjf-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"# Awful hack: `localedef' doesn't allow the path to `locale-archive'\n# to be overriden, but you *can* specify a prefix, i.e. it will use\n# <prefix>/<path-to-glibc>/lib/locale/locale-archive.  So we use\n# $TMPDIR as a prefix, meaning that the locale-archive is placed in\n# $TMPDIR/nix/store/...-glibc-.../lib/locale/locale-archive.\nLOCALEDEF_FLAGS+=\" --prefix=$TMPDIR\"\n\nexport inst_complocaledir=\"$TMPDIR/\"/nix/store/m07h00fl6538s4gavrp66a20ka4hg7fy-glibc-2.42-67/lib/locale\nmkdir -p \"$inst_complocaledir\"\n\necho 'C.UTF-8/UTF-8 \\' >> ../localedata/SUPPORTED\n\n# Hack to allow building of the locales (needed since glibc-2.12)\nsubstituteInPlace ../localedata/Makefile \\\n  --replace-fail '$(rtld-prefix) $(common-objpfx)locale/localedef' 'localedef $(LOCALEDEF_FLAGS)'\n# Check that all locales to be built are supported\necho -n 'en_US.UTF-8/UTF-8 \\\n' \\\n  | sort -u > locales-to-build.txt\ncat ../localedata/SUPPORTED | grep ' \\\\' \\\n  | sort -u > locales-supported.txt\ncomm -13 locales-supported.txt locales-to-build.txt \\\n  > locales-unsupported.txt\nif [[ $(wc -c locales-unsupported.txt) != \"0 locales-unsupported.txt\" ]]; then\n  cat locales-supported.txt\n  echo \"Error: unsupported locales detected:\"\n  cat locales-unsupported.txt\n  echo \"You should choose from the list above the error.\"\n  false\nfi\n\necho SUPPORTED-LOCALES='en_US.UTF-8/UTF-8' > ../localedata/SUPPORTED\n","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHook":"/nix/store/imajxs8ia8lnfmdb604bkfwi1cmhdfpw-locales-setup-hook.sh","src":"/nix/store/6zxixmszg0vbhpaa8rxwfr05by9axj68-glibc-2.42.tar.xz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.42-67"},"inputs":{"drvs":{"19j2rnyyj1lmmkg7klik1qhidzrlqi47-glibc-2.42-67.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"2757jjsm9afpx810y3vkzckfvniin27l-python3-minimal-3.13.15.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8i1kfmj40d27683j4k36rwkwvsf43awq-locales-setup-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"8injyx1z38allpqjwycg8c7dm9r93mzk-libidn2-2.3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"c3294jpzknddczcp860hfcvwhs3amh8a-gettext-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"jp7ziv1mndz8w6vq5l20fyhg5qdscxm2-gcc-wrapper-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"kzc6jva8wiidkffxmxf05k9kxc65bjwy-binutils-2.46.drv":{"dynamicOutputs":{},"outputs":["out"]},"qf8rj25cm5igakvwdzas5x56r6ws5k3s-linux-headers-6.18.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"wcx8fa94g739rn59s54iym8bh5lzxdlc-glibc-2.42.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"x1w0jlgrzalamm5a6s5gz2s4llsh8yq2-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch","0mb1pqwqkz9sk1fwgn897zlwzhhgfpbf-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch","0swhhq4hf4vjsxndsqxs2can3mcsn2ca-0002-resolv-More-types-as-unknown-in-ns_sprintrrf-CVE-202.patch","43b9m8jsp2sybz9n2yfjs5fpcv2x5ir3-2.42-master.patch","4i53m3qfc9lj43bnq4bs6kbdkw6ljj67-0003-resolv-Fix-buffer-overreads-in-ns_sprintrrf-CVE-2026.patch","628jb27r7gyzblzn11d77nl5264ih86b-0001-resolv-Check-for-inet_ntop-failure-in-ns_sprintrrf.patch","62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch","7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch","b1w7zbvm39ff1i52iyjggyvw2rdxz104-dont-use-system-ld-so-cache.patch","f1qmmr4