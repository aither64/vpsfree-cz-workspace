 the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-osctl-exportfs-26.05.0","nativeBuildInputs":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/lnci51zxirkcd3b1549ckx4pdi20jmq3-ruby3.4-osctl-exportfs-26.05.0","outputs":"out","patches":"","pname":"osctl-exportfs","propagatedBuildInputs":"/nix/store/8bg79l9cbnkgbfg76nn5c163kvi4y09a-ruby3.4-filelock-1.1.1 /nix/store/myrbk54s0r46rif9wx9qscvlcw1cxzx4-ruby3.4-gli-2.22.2 /nix/store/49igmpzaqxlyf8ak4bvscz3gk29dfqfp-ruby3.4-libosctl-26.05.0 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/8bg79l9cbnkgbfg76nn5c163kvi4y09a-ruby3.4-filelock-1.1.1 /nix/store/myrbk54s0r46rif9wx9qscvlcw1cxzx4-ruby3.4-gli-2.22.2 /nix/store/49igmpzaqxlyf8ak4bvscz3gk29dfqfp-ruby3.4-libosctl-26.05.0 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0","ruby":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9","src":"/nix/store/idxqjbp85zh1ilzjlglmpqhh2givrmsq-zd7z6pw3pkk6099kjvjryqq5xxgblygw-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"26.05.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nmkdir source\ncp -a \"$src/.\" source/\nchmod -R u+w source\nsourceRoot=source/osctl-exportfs\n\nrunHook postUnpack\n","version":"26.05.0"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"7qlxiwkbp6lbhqf3qvh2zf81yyhwqrn7-ruby3.4-libosctl-26.05.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"9p7zfrbcancjqqwdgcs0fmdbqsqp9i04-ruby3.4-filelock-1.1.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"vib5s2ffydrqfwdaw9mxd1d00y33vdcw-ruby3.4-require_all-2.0.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"vwv6gjb7r637il50p7sjbf0qn3lpxv3y-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"xhjsgf9lf385n7civbjkcg8ymyz0h998-ruby3.4-gli-2.22.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"xshd860gif707cn5krzl14260ash8c02-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["idxqjbp85zh1ilzjlglmpqhh2givrmsq-zd7z6pw3pkk6099kjvjryqq5xxgblygw-source","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-osctl-exportfs-26.05.0","outputs":{"out":{"path":"lnci51zxirkcd3b1549ckx4pdi20jmq3-ruby3.4-osctl-exportfs-26.05.0"}},"system":"x86_64-linux","version":4},"kx19vl02bq1j1xik7imnyh670dvb4gar-sv-kernel-modules-control-hangup.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"sv-kernel-modules-control-hangup","nativeBuildInputs":"","out":"/nix/store/kifcxqc37pskn75kywk3rzsgf0cs2542-sv-kernel-modules-control-hangup","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash\n\n\nset -e\n\nmodule_list=/etc/kernel-modules\nstate_dir=/run/kernel-modules\nstate_file=$state_dir/modules\nsleep_pid=\n\nlog() {\n  printf '%s\\n' \"$*\"\n  /nix/store/mpb22kzpmrfaml8kcmfs5ib9sxq63wbb-util-linux-2.42.2-bin/bin/logger -t kernel-modules -- \"$*\" || true\n}\n\nstop_sleep() {\n  [ -n \"$sleep_pid\" ] || return 0\n  kill \"$sleep_pid\" 2> /dev/null || true\n  wait \"$sleep_pid\" 2> /dev/null || true\n  sleep_pid=\n}\n\nwait_for_syslog_socket() {\n  for i in $(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/seq 1 10); do\n    [ -S /dev/log ] && return 0\n    /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/sleep 1\n  done\n\n  return 1\n}\n\nload_modules() {\n  mkdir -p \"$state_dir\"\n\n  while IFS= read -r module; do\n    [ -n \"$module\" ] || continue\n\n    log \"loading module $module\"\n    if ! /nix/store/ahni4ky7vcyga5rkfk6yil6g0293qyvk-kmod-31/bin/modprobe \"$module\"; then\n      log \"failed to load module $module\"\n    fi\n  done < \"$module_list\"\n}\n\nunload_removed_modules() {\n  [ -s \"$state_file\" ] || return 0\n\n  /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/tac \"$state_file\" | while IFS= read -r module; do\n    [ -n \"$module\" ] || continue\n    /nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin/grep -Fxq \"$module\" \"$module_list\" && continue\n\n    log \"unloading removed module $module\"\n    if ! /nix/store/ahni4ky7vcyga5rkfk6yil6g0293qyvk-kmod-31/bin/modprobe -r \"$module\"; then\n      log \"kept removed module $module\"\n    fi\n  done\n}\n\nreload_modules() {\n  mkdir -p \"$state_dir\"\n\n  if true; then\n    log \"loading configured kernel modules\"\n    load_modules\n  else\n    log \"not loading new kernel modules because boot.kernel.loadNewModules is false\"\n  fi\n\n  if false; then\n    unload_removed_modules\n  else\n    log \"not unloading removed kernel modules because boot.kernel.unloadRemovedModules is false\"\n  fi\n\n  cp \"$module_list\" \"$state_file\"\n  log \"configured kernel modules loaded\"\n}\n\nhandle_hangup() {\n  stop_sleep\n  log \"reloading kernel-modules service script\"\n  exec /etc/runit/services/kernel-modules/run\n}\n\nhandle_exit() {\n  stop_sleep\n  exit 0\n}\n\nlog \"reloading kernel modules from service control\"\nreload_modules\n\n\n"},"inputs":{"drvs":{"3hdkqd69xxi76mi7w7q4ac18lbd83vc8-util-linux-2.42.2.drv":{"dynamicOutputs":{},"outputs":["bin"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8cp1lhkcz1pi19lfzgln6w1kc3jswsi4-gnugrep-3.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"b62h34b8indjlwjy86799pq9q4mc8c2f-kmod-31.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"sv-kernel-modules-control-hangup","outputs":{"out":{"path":"kifcxqc37pskn75kywk3rzsgf0cs2542-sv-kernel-modules-control-hangup"}},"system":"x86_64-linux","version":4},"kx3vxikhkkmni9llrapg5mshkcda8mzf-rbtree-0.4.7.gem.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/dnwb1gnqz6fb4zqb8b2y2yi0mc2gmlrf-rbtree-0.4.7.gem"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"fipldvf4rvwd547anz21awdm06xvvl8d-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"rbtree-0.4.7.gem","outputs":{"out":{"hash":"sha256-Hvq7yz/V8SJJycimEKdlB0hoFk7tDFDJ2yUxw