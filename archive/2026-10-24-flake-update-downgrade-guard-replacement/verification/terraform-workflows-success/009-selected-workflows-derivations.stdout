lude\"\n  fi\n}\n\nif [ -z \"$enableParallelBuilding\" ]; then\n    export NIX_BUILD_CORES=1\nfi\nfor pkg in $(getGoDirs \"\"); do\n  echo \"Building subPackage $pkg\"\nbuildGoDir install \"$pkg\"\n\ndone\nrunHook postBuild\n","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"runHook preCheck\n# We do not set trimpath for tests, in case they reference test assets\nexport GOFLAGS=${GOFLAGS//-trimpath/}\n\nfor pkg in $(getGoDirs test); do\n  buildGoDir test \"$pkg\"\ndone\n\nrunHook postCheck\n","cmakeFlags":"","configureFlags":"","configurePhase":"runHook preConfigure\n\nexport GOCACHE=$TMPDIR/go-cache\nexport GOPATH=\"$TMPDIR/go\"\nexport GOPROXY=off\nexport GOSUMDB=off\nif [ -f \"$NIX_CC_FOR_TARGET/nix-support/dynamic-linker\" ]; then\n  export GO_LDSO=$(cat $NIX_CC_FOR_TARGET/nix-support/dynamic-linker)\nfi\ncd \"$modRoot\"\nrm -rf vendor\ncp -r --reflink=auto \"$goModules\" vendor\n\nrunHook postConfigure\n","deleteVendor":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","disallowedReferences":"/nix/store/3yh8g6m3balbhzxsx77jlyyx443bxqii-go-1.26.6","doCheck":"1","doInstallCheck":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","goModules":"/nix/store/zpj5mq5b916miqvzyzhakpr05qh0awgc-opentofu-1.11.8-go-modules","installPhase":"runHook preInstall\n\nmkdir -p $out\ndir=\"$GOPATH/bin\"\n[ -e \"$dir\" ] && cp -r $dir $out\n\nrunHook postInstall\n","ldflags":"-s -w -X github.com/opentofu/opentofu/version.dev=no -buildid=","mesonFlags":"","modRoot":"./","name":"opentofu-1.11.8","nativeBuildInputs":"/nix/store/3yh8g6m3balbhzxsx77jlyyx443bxqii-go-1.26.6 /nix/store/v2i3m4k78qypvizq4igm1izik677c47p-install-shell-files /nix/store/631qd13k2amwp1vynz6g1a2irdprpgg8-writable-tmpdir-as-home-hook /nix/store/v4x2d0vn453a0fpf9bq21c0shjhqmaqw-versi