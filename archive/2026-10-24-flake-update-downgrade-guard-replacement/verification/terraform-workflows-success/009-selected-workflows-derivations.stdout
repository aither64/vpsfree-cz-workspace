fxfyc3p26w93fnsgyfs80-php-8.4.24-dev /nix/store/g5qbbj4cmzq1133lnvmaxanrlxl0k7ac-autoconf-2.73 /nix/store/cizqnkc40i7k401f8cl2260ksi9nnph4-pkg-config-wrapper-0.29.2 /nix/store/7fib25cz82y59x6ygaimwd8b8z9j5gw0-re2c-4.5.1 /nix/store/47ibddl4z6rmhp517p1sas0qlapbb1zh-bison-3.8.2","out":"/nix/store/5c9l5ys9xy8n4rbcsnqcsry0kmhj1bkn-php-zip-8.4.24","outputs":"out dev","patches":"","pname":"php-zip","preConfigure":"nullglobRestore=$(shopt -p nullglob)\nshopt -u nullglob   # To make ?-globbing work\n\n# Some extensions have a config0.m4 or config9.m4\nif [ -f config?.m4 ]; then\n  mv config?.m4 config.m4\nfi\n\n$nullglobRestore\n\nphpize\n\n\n\n","preConfigurePhases":"genfiles cdToExtensionRootPhase","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/dmp6jinvn3q6knidlbyinkcz3rwvfcpc-php-8.4.24.tar.bz2","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"8.4.24","zendExtension":""},"inputs":{"drvs":{"5z8sj1169xaps07s9yw780fvznwn8yqy-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6ipq17z415q593w593ibgvpmmlawsz75-re2c-4.5.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"gdv273rpxrziz61dmbar27ii82avhcx7-autoconf-2.73.drv":{"dynamicOutputs":{},"outputs":["out"]},"j1751iq2jzzrc5z0fwh34zgp7v1isl08-php-8.4.24.drv":{"dynamicOutputs":{},"outputs":["dev"]},"pncnsa48sljh6iyz1s57il9n35myh85w-rsync-3.4.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"sk4rrrrqxnfl1ss0gkrhg7bqg8c4n58l-libzip-1.11.4.drv":{"dynamicOutputs":{},"outputs":["dev"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"wpqcc5r1rrjn4m748avin2d5iyvd7jlm-php-8.4.24.tar.bz2.drv":{"dynamicOutputs":{},"outputs":["out"]},"x1w0jlgrzalamm5a6s5gz2s4llsh8yq2-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"z1sfjja53y3w1q15m6rrkjslj1snlmfg-pcre2-10.46.drv":{"dynamicOutputs":{