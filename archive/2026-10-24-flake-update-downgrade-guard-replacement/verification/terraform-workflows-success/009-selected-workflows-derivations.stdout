\n    find $out -name .pytest_cache -type d -exec rm -rf {} +\n}\nappendToVar preDistPhases pytestcachePhase\n\n# pytest generates it's own bytecode files to improve assertion messages.\n# These files similar to cpython's bytecode files but are never laoded\n# by python interpreter directly. We remove them for a few reasons:\n# - files are non-deterministic: https://github.com/NixOS/nixpkgs/issues/139292\n#   (file headers are generatedt by pytest directly and contain timestamps)\n# - files are not needed after tests are finished\npytestRemoveBytecodePhase () {\n    # suffix is defined at:\n    #    https://github.com/pytest-dev/pytest/blob/7.2.1/src/_pytest/assertion/rewrite.py#L51-L53\n    find $out -name \"*-pytest-*.py[co]\" -delete\n}\nappendToVar preDistPhases pytestRemoveBytecodePhase\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"pytest-hook","outputs":{"out":{"path":"4f2qdxaky7xc4ibz2hkwp0l6yyckp1ms-pytest-hook"}},"system":"x86_64-linux","version":4},"6pwcyr37rwfwns6v3z0xsjviy8j36g78-vpsadmin-api-prometheus-export-deploy.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"","cma