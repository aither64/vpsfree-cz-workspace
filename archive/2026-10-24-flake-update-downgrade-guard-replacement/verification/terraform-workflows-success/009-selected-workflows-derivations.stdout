store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","buildCommand":"# Unpack\ntar xf /nix/store/vclnb6d6yja2m42pjw5jay5zinnh54y3-gcc-15.2.0.tar.xz\ntar xf /nix/store/71p7vjw19g2vrh25i3mpi1656byvzj3w-gmp-6.3.0.tar.xz\ntar xf /nix/store/92vinq6gfq5afkjc870g6y301mmf1vqq-mpfr-4.2.2.tar.xz\ntar xf /nix/store/mdrv8znlgnysqzq1hnv46vi9jmnsc1bc-mpc-1.3.1.tar.gz\ntar xf /nix/store/jj8qn4h3nxzx3b93jizmp1wylb47nhza-isl-0.24.tar.bz2\ncd gcc-15.2.0\n\nln -s ../gmp-6.3.0 gmp\nln -s ../mpfr-4.2.2 mpfr\nln -s ../mpc-1.3.1 mpc\nln -s ../isl-0.24 isl\n\n# Patch\n# force musl even if host triple is gnu\nsed -i 's|\"os/gnu-linux\"|\"os/generic\"|' libstdc++-v3/configure.host\n\n# Configure\nexport CC=\"gcc -Wl,-dynamic-linker -Wl,/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/lib/libc.so\"\nexport CXX=\"g++ -Wl,-dynamic-linker -Wl,/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/lib/libc.so\"\nexport CFLAGS_FOR_TARGET=\"-Wl,-dynamic-linker -Wl,/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/lib/libc.so\"\nexport LIBRARY_PATH=\"/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6/lib\"\n\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-native-system-header-dir=/include \\\n  --with-sysroot=/nix/store/xkrpi9qjx50m8rrim60k0vrqp2p2xf10-musl-1.2.6 \\\n  --enable-languages=c,c++ \\\n  --enable-checking=release \\\n  --disable-bootstrap \\\n  --disable-dependency-tracking \\\n  --disable-libsanitizer \\\n  --disable-libssp \\\n  --disable-libgomp \\\n  --disable-libquadmath \\\n  --disable-libitm \\\n  --disable-libvtv \\\n  --disable-libatomic \\\n  --disable-libstdcxx-pch \\\n  --disable-lto \\\n  --disable-multilib \\\n  --disable-nls \\\n  --disable-plugin\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n\n# libstdc++ gdb pretty-printers + man pages are unused downstream.\nrm -rf $out/share/gcc-*/python $out/share/man $out/share/info\n","buil