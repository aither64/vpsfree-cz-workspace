0rgw77kxmbns1qgprm46cy-ruby3.4-highline-3.1.2 /nix/store/r9dhr0a4w21nyd2wg00il2qskjh9ry6k-ruby3.4-json-3.1.0 /nix/store/zh1f71hiarprpd34jgga5s1hcb3x3ic6-ruby3.4-require_all-2.0.0 /nix/store/35r3j4x2zxajmrqnqj5b4dckffqdg5zs-ruby3.4-rest-client-2.1.0 /nix/store/8y3a840l6zr69882kbvpykhy8iyfa9bb-ruby3.4-ruby-progressbar-1.13.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-haveapi-client-0.29.9","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/klv5d05dgid8kcdg5nbwlcaa1v98g5dq-ruby3.4-haveapi-client-0.29.9","outputs":"out","patches":"","pname":"haveapi-client","propagatedBuildInputs":"/nix/store/077lzlg91h6hdchzwq8gngp4zmywyxnq-ruby3.4-activesupport-8.1.4 /nix/store/dda29rp97p0rgw77kxmbns1qgprm46cy-ruby3.4-highline-3.1.2 /nix/store/r9dhr0a4w21nyd2wg00il2qskjh9ry6k-ruby3.4-json-3.1.0 /nix/store/zh1f71hiarprpd34jgga5s1hcb3x3ic6-ruby3.4-require_all-2.0.0 /nix/store/35r3j4x2zxajmrqnqj5b4dckffqdg5zs-ruby3.4-rest-client-2.1.0 /nix/store/8y3a840l6zr69882kbvpykhy8iyfa9bb-ruby3.4-ruby-progressbar-1.13.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/077lzlg91h6hdchzwq8gngp4zmywyxnq-ruby3.4-activesupport-8.1.4 /nix/store/dda29rp97p0rgw77kxmbns1qgprm46cy-ruby3.4-highline-3.1.2 /nix/store/r9dhr0a4w21nyd2wg00il2qskjh9ry6k-ruby3.4-json-3.1.0 /nix/store/zh1f71hiarprpd34jgga5s1hcb3x3ic6-ruby3.4-require_all-2.0.0 /nix/store/35r3j4x2zxajmrqnqj5b4dckffqdg5zs-ruby3.4-rest-client-2.1.0 /nix/store/8y3a840l6zr69882kbvpykhy8iyfa9bb-ruby3.4-ruby-progressbar-1.13.0","ruby":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9","src":"/nix/store/58rh7w7aqw5201nv2vi6pmyq6xmm8xcy-haveapi-client-0.29.9.gem","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"0.29.9","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"0.29.9"},"inputs":{"drvs":{"519s7zkx4ddcx7flsvq4c74pala841nq-ruby3.4-activesupport-8.1.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"5iq7zryfyz22is2d2faw96d7w3ljq5xx-ruby3.4-highline-3.1.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"dazpsdcz0s558kmf72cwhp5b61dsmnmx-ruby3.4-json-3.1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"gs4d83rrq9msghnmsyq00nwn6paag5b8-ruby3.4-rest-client-2.1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"i1lgxsx06lqdl9sviq7yrqrasavxw2xy-ruby3.4-ruby-progressbar-1.13.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"nx44hxiycfk0dwa5h4ppfasp00yiwdla-ruby3.4-require_all-2.0.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"qh350fb0h8mc0y5pnnk012v7bics16zc-haveapi-client-0.29.9.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"xshd860gif707cn5krzl14260ash8c02-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"y898s2ajfd6ag157gc7gwa1z5vcbil9m-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-haveapi-client-0.29.9","outputs":{"out":{"path":"klv5d05dgid8kcdg5nbwlcaa1v98g5dq-ruby3.4-haveapi-client-0.29.9"}