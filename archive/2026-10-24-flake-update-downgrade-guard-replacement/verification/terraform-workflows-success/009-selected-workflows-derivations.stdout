},"system":"x86_64-linux","version":4},"w2h04rg581f5722x2z6p3nwfl69yb9n1-pre-switch-checks.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"pre-switch-checks","__structuredAttrs":"","allowSubstitutes":"1","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"runHook preCheck\n/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash -n -O extglob \"$target\"\n# use shellcheck which does not include docs\n# pandoc takes long to build and documentation isn't needed for just running the cli\n/nix/store/0x4xf8ad5hzvnd4ya37y6r7xq9p0jn0y-ShellCheck-0.11.0/bin/shellcheck  \"$target\"\n\nrunHook postCheck\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"/bin/pre-switch-checks","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"pre-switch-checks","nativeBuildInputs":"","out":"/nix/store/f0sk5zsngp4q7wrz72m7yh5snrw3if8j-pre-switch-checks","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash\nset -o errexit\nset -o nounset\nset -o pipefail\n\nexport PATH=\"$PATH\"\n\n# pre-switch check switchInhibitors\n#\n# Run with errexit in a subshell that is not part of an `if`/`||`\n# condition, so that `set -e` is actually honoured inside the\n# check body.\nset +e\n(\n  set -e\n  incoming=\"${1-}\"\naction=\"${2-}\"\n\ncase \"$action\" in\n  boot|dry-activate)\n    echo \"Not checking switch inhibitors (action = $action)\"\n    exit\n    ;;\nesac\n\necho -n \"Checking switch inhibitors...\"\n\ncurrent_inhibitors=\"/run/current-system/switch-inhibitors\"\nif [ ! -f \"$current_inhibitors\" ]; then\n  current_inhibitors=\"/nix/store/3zj1p62zzic3fzgwvy6fadach202yqfa-empty-inhibitors\"\nfi\n\nnew_inhibitors=\"$incoming/switch-inhibitors\"\nif [ ! -f \"$new_inhibitors\" ]; then\n  new_inhibitors=\"/nix/store/3zj1p62zzic3fzgwvy6fadach202yqfa-empty-inhibitors\"\nfi\n\ndiff=\"$(\n  /nix/store/vkjzswzi7r1ayxa0xr920bjrzmi04x7v-jq-1.8.2-bin/bin/jq \\\n    --raw-output \\\n    --null-input \\\n    --rawfile current \"$current_inhibitors\" \\\n    --rawfile newgen \"$new_inhibitors\" \\\n  '\n    ($current | fromjson) as $old |\n    ($newgen | fromjson) as $new |\n    $old |\n    to_entries |\n    map(\n      select(.key | in ($new)) |\n      select(.value != $new.[.key]) |\n      [ .key, \":\", .value, \"->\", $new.[.key] ] | join(\" \")\n    ) |\n    join(\"\\n\")\n  ' \\\n)\"\n\nif [ -n \"$diff\" ]; then\n  echo\n  echo \"There are changes to critical components of the system:\"\n  echo\n  echo \"$diff\"\n  echo\n  echo \"Switching into this system is not recommended.\"\n  echo \"You probably want to run 'nixos-rebuild boot' and reboot your system instead.\"\n  echo\n  echo \"If you really want to switch into this configuration directly, then\"\n  echo \"you can set NIXOS_NO_CHECK=1 to ignore pre-switch checks.\"\n  echo\n  echo \"WARNING: doing so might cause the switch to fail or your system to become unstable.\"\n  echo\n  exit 1\nelse\n  echo \" done\"\nfi\n\n) >&2\n_rc=$?\nset -e\nif [ \"$_rc\" -ne 0 ]; then\n  echo \"Pre-switch check 'switchInhibitors' failed\" >&2\n  exit 1\nfi\n\n\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"p4m7f8xxk3c5wv00z01av8078aqjbayw-jq-1.8.2.drv":{"dynamicOutputs":{},"outputs":["bin"]},"y4habpgx9x6ngmvgg0k51dyvgzz4yh2r-empty-inhibitors.drv":{"dynamicOutputs":{},"outputs":["out"]},"yqm93finchza82cg78xdlwcm9zlp2pmb-ShellCheck-0.11.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"pre-switch-checks","outputs":{"out":{"path":"f0sk5zsngp4q7wrz72m7yh5snrw3if8j-pre-switch-checks"}},"system":"x86_64-linux","version":4},"w2hkwmwn43y9p2sayqdw7rrnap8rlm96-zeromq-fix-cmake-4-1.patch.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/lh5f1qbrwm5p0my00qdbrc1m2dyqhkyx-zeromq-fix-cmake-4-1.patch"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"fipldvf4rvwd547anz21awdm06xvvl8d-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"lgb45vclwalalpid88dx73aac30i7dl5-patchutils-0.3.3.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"zeromq-fix-cmake-4-1.patch","outputs":{"out":{"hash":"sha256-oauAZV6pThplcn2v9mQxhxlUhYgpbly0JBLYik+zoJE=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2