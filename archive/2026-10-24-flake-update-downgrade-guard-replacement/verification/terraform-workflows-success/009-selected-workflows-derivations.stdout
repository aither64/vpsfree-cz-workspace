piler/lib --libsubdir=\\$abi/\\$libname  --docdir=$doc/share/doc/attoparsec-aeson-2.2.2.0 --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --enable-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --enable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/5rb5wpjl9np13rv3zw09x0ihmgyz3gi8-attoparsec-aeson-2.2.2.0.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"2.2.2.0"},"inputs":{"drvs":{"158x91m5d8pj5mfaihwn8b1xw2qkavm8-scientific-0.3.8.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"1gbawc48yci42lbjjgipkg2335ax539g-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"1w1bpqwd991lc593wjr7m4c7b3w1jxmp-attoparsec-0.14.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"31crzmq8yc1nlj0wjfh9afjwpkc86vpj-glibc-locales-2.42-67.drv":{"dynamicOutputs":{},"outputs":["out"]},"3d9s3r34qh3867fcksdlc6qibcmx5vab-aeson-2.2.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"4by2ygk033w4hyngk9cx8ygjppk8s4ix-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"c5ckvjm6krmqdrlpnd608av0hkv4pz6r-vector-0.13.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"dq60pw73gsqzrg645lknndblx6qp6zzl-attoparsec-aeson-2.2.2.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"fkdic9b8