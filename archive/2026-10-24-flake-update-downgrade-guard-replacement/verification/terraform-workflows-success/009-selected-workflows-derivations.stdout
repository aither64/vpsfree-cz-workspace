0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev","/nix/store/4838cpsffgmc4xw856y0zdpvgssjljm0-rustc-1.95.0","/nix/store/wqmyyw2i4mv2bjs8x0n79zyri2ks22pi-rust-bindgen-unwrapped-0.72.1"],"outputChecks":{"dev":{},"modules":{},"out":{}},"outputs":["out","dev","modules"],"patches":["/nix/store/mnlqwys9dxznjcvq4w3s0435s9ql8qv8-bridge-stp-helper.patch","/nix/store/mbz5gln1q4swlzmqs2399br98qjif9kn-request-key-helper.patch","/nix/store/23728y7zgh1jb55kpwxv5qnjbq0ykca6-randstruct-provide-seed-5.19.patch"],"pname":"linux","postInstall":"mkdir -p $dev\ncp vmlinux $dev/\n\nmkdir -p $dev/lib/modules/6.12.104/build/scripts\n# Installing from source dir instead of $buildRoot so as to omit intermediate artifacts.\ncp -rL ../scripts/gdb/ $dev/lib/modules/6.12.104/build/scripts\n# Installing `constants.py` from `$buildRoot` as it's generated.\ncp scripts/gdb/linux/constants.py $dev/lib/modules/6.12.104/build/scripts/gdb/linux\n\nif [ -z \"${dontStrip-}\" ]; then\n  installFlags+=(\"INSTALL_MOD_STRIP=1\")\nfi\nmake modules_install \"${makeFlags[@]}\" \"${installFlags[@]}\"\nunlink $modules/lib/modules/6.12.104/build\n\nmkdir -p $dev/lib/modules/6.12.104/{build,source}\n\n# To save space, exclude a bunch of unneeded stuff when copying.\n(cd .. && rsync --archive --prune-empty-dirs \\\n    --exclude='/build/' \\\n    * $dev/lib/modules/6.12.104/source/)\n\ncd $dev/lib/modules/6.12.104/source\n\ncp $buildRoot/{.config,Module.symvers} $dev/lib/modules/6.12.104/build\nmake modules_prepare \"${makeFlags[@]}\" O=$dev/lib/modules/6.12.104/build\n\n# For reproducibility, removes accidental leftovers from a `cc1` call\n# from a `try-run` call from the Makefile\nrm -f $dev/lib/modules/6.12.104/build/.[0-9]*.d\n\n# Keep some extra files on some arches (powerpc, aarch64)\nfor f in arch/powerpc/lib/crtsavres.o arch/arm64/kernel/ftrace-mod.o; do\n  if [ -f \"$buildRoot/$f\" ]; then\n    mkdir -p \"$(dirname $dev/lib/modules/6.12.104/build/$f)\"\n    cp $buildRoot/$f $dev/lib/modules/6.12.104/build/$f\n  fi\ndone\n\n# !!! No documentation on how much of the source tree must be kept\n# If/when kernel builds fail due to missing files, you can add\n# them here. Note that we may see packages requiring headers\n# from drivers/ in the future; it adds 50M to keep all of its\n# headers on 3.10 though.\n\nchmod u+w -R ..\nbuildArchDir=\"$dev/lib/modules/6.12.104/build/arch\"\n\n# Remove unused arches\nfor d in $(cd arch/; ls); do\n  if [ -d \"$buildArchDir/$d\" ]; then continue; fi\n  if [ -d \"$buildArchDir/arm64\" ] && [ \"$d\" = arm ]; then continue; fi\n  rm -rf arch/$d\ndone\n\n# Remove all driver-specific code (50M of which is headers)\nrm -fR drivers\n\n# Keep all headers\nfind .  -type f -name '*.h' -print0 | xargs -0 -r chmod u-w\n\n# Keep linker scripts (they are required for out-of-tree modules on aarch64)\nfind .  -type f -name '*.lds' -print0 | xargs -0 -r chmod u-w\n\n# Keep root and arch-specific Makefiles\nchmod u-w Makefile arch/*/Makefile*\n\n# Keep rust Makefile\nchmod u-w rust/Makefile\n\n# Keep whole scripts dir\nchmod u-w -R scripts\n\n# Delete everything not kept\nfind . -type f -perm -u=w -print0 | xargs -0 -r rm\n\n# Delete empty directories\nfind -empty -type d -delete\n","postPatch":"# Ensure that depmod gets resolved through PATH\nsed -i Makefile -e 's|= /sbin/depmod|= depmod|'\n\n# Some linux-hardened patches now remove certain files in the scripts directory, so the file may not exist.\n[[ -f scripts/ld-version.sh ]] && patchShebangs scripts/ld-version.sh\n\n# Set randstruct seed to a deterministic but diversified value. Note:\n# we could have instead patched gen-random-seed.sh to take input from\n# the buildFlags, but that would require also patching the kernel's\n# toplevel Makefile to add a variable export. This would be likely to\n# cause future patch conflicts.\nfor file in scripts/gen-randstruct-seed.sh scripts/gcc-plugins/gen-random-seed.sh; do\n  if [ -f \"$file\" ]; then\n    substituteInPlace \"$file\" \\\n      --replace NIXOS_RANDSTRUCT_SEED \\\n      $(echo /nix/store/ixh24v022kz63hg5hba0fs5gvi2i9bfw-linux-6.12.104.tar.xz /1s3bzfisrvrdlla1qr3z074sphpb4cpz4rbacwp56cmp9237lv2y | sha256sum | cut -d ' ' -f 1 | tr -d '\\n')\n    break\n  fi\ndone\n\npatchShebangs scripts\n\n# also patch arch-specific install scripts\nfor i in $(find arch -name install.sh); do\n    patchShebangs \"$i\"\ndone\n\n# unset $src because the build system tries to use it and spams a bunch of warnings\n# see: https://github.com/torvalds/linux/commit/b1992c3772e69a6fd0e3fc81cd4d2820c8b6eca0\nunset src\n","preFixup":"if [ -z \"${dontStrip-}\" -a -e $out/vmlinux ]; then\n  strip -v -S -p $out/vmlinux\nfi\n","preInstall":"installFlags+=(\"-j$NIX_BUILD_CORES\")\nexport HOME=/nix/store/msl4kzlgsi2cbm9hgqw5i7nd508vdmj7-installkernel\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"src":"/nix/store/ixh24v022kz63hg5hba0fs5gvi2i9bfw-linux-6.12.104.tar.xz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":false,"system":"x86_64-linux","version":"6.12.104"},"system":"x86_64-linux","version":4},"1yr13z31g39plpx7qj19zgp7p807qq76-http2-5.3.10.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"LANG":"en_US.UTF-8","LOCALE_ARCHIVE":"/nix/store/d7w71nlhh7l9y619kcxsm2f0c65ynwfp-glibc-locales-2.42-67/lib/locale/locale-archive","__structuredAttrs":"","buildFlags":"","buildInputs":"/nix/store/znzjnkp24jwvz693fisrg8s9ws8328nx-aeson-2.2.4.1 /nix/store/vi5phly29n8phnxi86qk3rcwc5sirblp-aeson-pretty-0.8.10 /nix/store/pssw0kz4lh2w4b4zvc3853fxq7h02y0x-async-2.2.6  /nix/store/6bhij5f93g7sp93fjdwrxda9agnx5cqw-base16-bytestring-1.0.2.0  /nix/store/aqbf36pi6cnri8yncfd8mzyg91b7hsjf-crypton-1.0.6   /nix/store/xw7nyk1spi6p26bhc8s24ikr587wxiwx-Glob-0.10.2 /nix/store/qbnnyg4cdipnzx4wybs2x6zbyi2w