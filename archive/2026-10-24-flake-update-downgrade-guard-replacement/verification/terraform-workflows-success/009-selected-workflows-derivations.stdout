default for Nixpkgs, where there is no rust-lld.\nsubstituteInPlace compiler/rustc_target/src/spec/*/*.rs \\\n  --replace-quiet '\"rust-lld\"' '\"lld\"'\n\nrm -rf src/llvm\n\n# Useful debugging parameter\n# export VERBOSE=1\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"setOutputFlags":false,"setupHooks":"/nix/store/skyp8xs2584fkc44ki1cim9ag55wbi68-setup-hook.sh","src":"/nix/store/6wq4v4hfgx2875qszshp9x06wmlc5z65-rustc-1.95.0-src.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":false,"stripDebugList":["bin"],"system":"x86_64-linux","version":"1.95.0"},"system":"x86_64-linux","version":4},"3r20h9k59zvh13nd6z1yx9xrpg4drk0q-3d88c829bd5f13d13847b39067dbf09a60af2154.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/pdx1l5asmi0i4dh5v0qdni0l1m0nfxyd-3d88c829bd5f13d13847b39067dbf09a60af2154"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"fipldvf4rvwd547anz21awdm06xvvl8d-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"3d88c829bd5f13d13847b39067dbf09a60af2154","outputs":{"out":{"hash":"sha256-/amvu32u/YgSApY9xDdug4p68g9gBocOSDfvJ2aWkL8=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":[],"curlOpts":"","curlOptsList":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuil