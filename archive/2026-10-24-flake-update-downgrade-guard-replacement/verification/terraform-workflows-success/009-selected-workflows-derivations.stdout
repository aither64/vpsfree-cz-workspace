":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"/bin/mysql-start","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"unit-script-mysql-start","nativeBuildInputs":"","out":"/nix/store/lq66y33d6w0689cz64c22wwzyd088j77-unit-script-mysql-start","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash\nset -e\n\n# https://mariadb.com/kb/en/getting-started-with-mariadb-galera-cluster/#systemd-and-galera-recovery\nif test -n \"${_WSREP_START_POSITION}\"; then\n  if test -e \"/nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12/bin/galera_recovery\"; then\n    VAR=$(cd /nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12/bin/..; /nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12/bin/galera_recovery); [[ $? -eq 0 ]] && export _WSREP_START_POSITION=$VAR || exit 1\n  fi\nfi\n\n# The last two environment variables are used for starting Galera clusters\nexec /nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12/bin/mysqld --defaults-file=/etc/my.cnf --user=mysql --datadir=/var/lib/mysql --basedir=/nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12 $_WSREP_NEW_CLUSTER $_WSREP_START_POSITION\n\n\n"},"inputs":{"drvs":{"5fc2ppakjwxw2fb2mbz78vxdsmq5py5c-mariadb-server-11.4.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-mysq