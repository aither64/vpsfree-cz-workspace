get=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"","mesonFlags":"","name":"etc-bashrc","nativeBuildInputs":"","out":"/nix/store/rlby3yy573nwfmi15ywfg6vfw08a3ji8-etc-bashrc","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"# /etc/bashrc: DO NOT EDIT -- this file has been generated automatically.\n\n# Only execute this file once per shell.\nif [ -n \"$__ETC_BASHRC_SOURCED\" ] || [ -n \"$NOSYSBASHRC\" ]; then return; fi\n__ETC_BASHRC_SOURCED=1\n\n# If the profile was not loaded in a parent process, source\n# it.  But otherwise don't do it because we don't want to\n# clobber overridden values of $PATH, etc.\nif [ -z \"$__ETC_PROFILE_DONE\" ]; then\n    . /etc/profile\nfi\n\n# We are not always an interactive shell.\nif [ -n \"$PS1\" ]; then\n    # Disable hashing (i.e. caching) of command lookups.\nset +h\n\n# Provide a nice prompt if the terminal supports it.\nif [ \"$TERM\" != \"dumb\" ] || [ -n \"$INSIDE_EMACS\" ]; then\n  PROMPT_COLOR=\"1;31m\"\n  ((UID)) && PROMPT_COLOR=\"1;32m\"\n  if [ -n \"$INSIDE_EMACS\" ]; then\n    # Emacs term mode doesn't support xterm title escape sequence (\\e]0;)\n    PS1=\"\\n\\[\\033[$PROMPT_COLOR\\][\\u@\\h:\\w]\\\\$\\[\\033[0m\\] \"\n  else\n    PS1=\"\\n\\[\\033[$PROMPT_COLOR\\][\\[\\e]0;\\u@\\h: \\w\\a\\]\\u@\\h:\\w]\\\\$\\[\\033[0m\\] \"\n  fi\n  if test \"$TERM\" = \"xterm\"; then\n    PS1=\"\\[\\033]2;\\h:\\u:\\w\\007\\]$PS1\"\n  fi\nfi\n\neval \"$(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/dircolors -b )\"\n\n# Check whether we're running a version of Bash that has support for\n# programmable completion. If we do, enable all modules installed in\n# the system and user profile in obsolete /etc/bash_completion.d/\n# directories. Bash loads completions in all\n# $XDG_DATA_DIRS/bash-completion/completions/\n# on demand, so they do not need to be sourced here.\nif shopt -q progcomp &>/dev/null; then\n  . \"/nix/store/jaw8yg776c8x6rq0dq4qn6il8gq7qadq-bash-completion-2.17.0/etc/profile.d/bash_completion.sh\"\n  nullglobStatus=$(shopt -p nullglob)\n  shopt -s nullglob\n  for p in $NIX_PROFILES; do\n    for m in \"$p/etc/bash_completion.d/\"*; do\n      . \"$m\"\n    done\n  done\n  eval \"$nullglobStatus\"\n  unset nullglobStatus p m\nfi\n\nalias -- l='ls -alh'\nalias -- ll='ls -l'\nalias -- ls='ls --color=tty'\n\n\n\nfi\n\n# Read system-wide modifications.\nif test -f /etc/bashrc.local; then\n    . /etc/bashrc.local\nfi\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"k1220vf4bj171crfp10bydhvz1g0qy37-bash-completion-2.17.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"etc-bashrc","outputs":{"out":{"path":"rlby3yy573nwfmi15ywfg6vfw08a3ji8-etc-bashrc"}},"system":"x86_64-linux","version":4},"8j4f5v3lgcw0yca3glm0rx1kxralcaa1-sv-live-patches-log-run.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2m