ash.settings.nobrowser\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"If we should not auto-open a browser window on startup\",\"loc\":[\"services\",\"stash\",\"settings\",\"nobrowser\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.stash.settings.notifications_enabled\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"If we should send notifications to the desktop\",\"loc\":[\"services\",\"stash\",\"settings\",\"notifications_enabled\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.stash.settings.parallel_tasks\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"1\"},\"description\":\"Number of parallel tasks to start during scan/generate\",\"loc\":[\"services\",\"stash\",\"settings\",\"parallel_tasks\"],\"readOnly\":false,\"type\":\"signed integer\"},\"services.stash.settings.plugins_path\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"/var/lib/stash/plugins\\\"\"},\"description\":\"Path to scrapers\",\"loc\":[\"services\",\"stash\",\"settings\",\"plugins_path\"],\"readOnly\":false,\"type\":\"absolute path\"},\"services.stash.settings.port\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"9999\"},\"description\":\"The port that Stash should listen on.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"1234\"},\"loc\":[\"services\",\"stash\",\"settings\",\"port\"],\"readOnly\":false,\"type\":\"16 bit unsigned integer; between 0 and 65535 (both inclusive)\"},\"services.stash.settings.preview_audio\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},