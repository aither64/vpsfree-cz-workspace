bstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"# logrotate --debug also checks that users specified in config\n# file exist, but we only have sandboxed users here so brown these\n# out. according to man page that means su, create and createolddir.\n# files required to exist also won't be present, so missingok is forced.\nuser=$(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/id -un)\ngroup=$(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/id -gn)\nsed -E -e \"s/\\bsu\\s.*/su $user $group/\" \\\n       -e \"s/\\b((create|createolddir)\\b(\\s+[0-9]+)?).*/\\1 $user $group/\" \\\n       -e \"1imissingok\" -e \"s/\\bnomissingok\\b//\" \\\n    $out > logrotate.conf\n# Since this makes for very verbose builds only show real error.\n# There is no way to control log level, but logrotate hardcodes\n# 'error:' at common log level, so we can use grep, taking care\n# to keep error codes\nset -o pipefail\nif ! /nix/store/wkwww4aqjya04ghixs6ihbx2hd9jz3da-logrotate-3.22.0/sbin/logrotate -s logrotate.status \\\n                --debug logrotate.conf 2>&1 \\\n            | ( ! grep \"error:\" ) > logrotate-error; then\n        echo \"Logrotate configuration check failed.\"\n        echo \"The failing configuration (after adjustments to pass tests in sandbox) was:\"\n        printf \"%s\\n\" \"-------\"\n        cat logrotate.conf\n        printf \"%s\\n\" \"-------\"\n        echo \"The error reported by logrotate was as follow:\"\n        printf \"%s\\n\" \"-------\"\n        cat logrotate-error\n        printf \"%s\\n\" \"-------\"\n        echo \"You can disable this check with services.logrotate.checkConfig = false,\"\n        echo \"but if you think it should work please report this failure along with\"\n        echo \"the config file being tested!\"\n        false\nfi\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"","mesonFlags":"","name":"logrotate.conf","nativeBuildInputs":"","out":"/nix/store/2b2r5nqyy0ic05kilc43f75bgd7rj3jp-logrotate.conf","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"weekly\nmissingok\nnotifempty\nrotate 4\n\n\"/var/log/btmp\" {\n  create 0660 root utmp\n  monthly\n  minsize 1M\n  rotate 1\n}\n\n\"/var/log/wtmp\" {\n  create 0664 root utmp\n  monthly\n  minsize 1M\n  rotate 1\n}\n\n\"/var/log/nginx/access.log\"\n\"/var/log/nginx/error.log\" {\n  compress\n  delaycompress\n  weekly\n  postrotate\n    [ ! -f /var/run/nginx/nginx.pid ] || kill -USR1 `cat /var/run/nginx/nginx.pid`\n  endscript\n  rotate 26\n  su nginx nginx\n}\n\n\"/var/log/nginx/vpsadmin-*.log\" {\n  monthly\n  postrotate\n    [ ! -f /run/nginx/nginx.pid ] || kill -USR1 `cat /run/nginx/nginx.pid`\n\n  endscript\n  rotate 13\n  su nginx nginx\n}\n"},"inputs":{"drvs":{"274s4ls38s2rsyiwnw00yxcamwsi54hw-logrotate-3.22.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r3