s":{"out":{}},"outputs":["out"],"patches":[],"pathsToLink":["/"],"postBuild":"if [ -L \"$out/bin\" ]; then\n    unlink \"$out/bin\"\nfi\nmkdir -p \"$out/bin\"\n\n# take every binary from perl packages and put them into the env\nfor path in /nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0 /nix/store/m5pasamn7i4j8i20wmkx04yj9wamr473-perl5.42.0-File-Slurp-9999.32 /nix/store/c187xi64s0qinj4l62ryg9q3l240q2bm-perl5.42.0-IPC-Run-20231003.0 /nix/store/qdlck68p24gfyq4x2q5m4k951g7q8b1j-perl5.42.0-IO-Tty-1.20; do\n  if [ -d \"$path/bin\" ]; then\n    cd \"$path/bin\"\n    for prg in *; do\n      if [ -f \"$prg\" ]; then\n        rm -f \"$out/bin/$prg\"\n        if [ -x \"$prg\" ]; then\n          makeWrapper \"$path/bin/$prg\" \"$out/bin/$prg\" --suffix PERL5LIB ':' \"$out/lib/perl5/site_perl\"\n        fi\n      fi\n    done\n  fi\ndone\n","preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"system":"x86_64-linux"},"system":"x86_64-linux","version":4},"yis8n1ylzvgs5ikhizv6xx5zsld32lfn-libarchive-3.8.8.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"NIX_HARDENING_ENABLE":"bindnow format fortify fortify3 libcxxhardeningfast pic relro stackclashprotection stackprotector strictflexarrays1 strictoverflow zerocallusedregs","__structuredAttrs":"","buildInputs":"/nix/store/w7mmbar5lbvqi2nbfwlkr136viw198j8-bzip2-1.0.8-dev /nix/store/n3x6l159sa586mkp2hjj1rb4nn08vm0y-lzo-2.10-dev /nix/store/6snylzb0haf89m5xwkc7x9vvinkcmj41-openssl-3.6.3-dev /nix/store/qq258vs9bdwi7s97vn8as6rgj76cirif-xz-5.8.3-dev /nix/store/0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev /nix/store/n0adwsx0sxhrfq6x32zm2is31xzhaf5y-zstd-1.5.7-dev /nix/store/ashg5i5fdncm4dj7kdlhfd24j6ikgljj-acl-2.4.0-dev /nix/store/v6