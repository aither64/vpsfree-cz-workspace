gated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","doc":"/nix/store/n78xkfzzg647hhiad0rqmpx69i7kmyfx-lua-5.4.7-doc","luaversion":"5.4","makeFlags":"INSTALL_TOP=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9 INSTALL_MAN=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/share/man/man1 R=5.4.7 LDFLAGS=-fPIC V=5.4 PLAT=linux-readline CC=cc RANLIB=ranlib MYLIBS=-lncurses","mesonFlags":"","name":"lua-5.4.7","nativeBuildInputs":"/nix/store/hxzjnjwzvwn5ak0hkp5q7jhxvk86f24p-make-binary-wrapper-hook","out":"/nix/store/vks2ynlxm2ngpfl3c6g7b2ig9fzd2llk-lua-5.4.7","outputs":"out doc","patches":"","pkgversion":"5.4.7","pname":"lua","postInstall":"mkdir -p \"$out/nix-support\" \"$out/share/doc/lua\" \"$out/lib/pkgconfig\"\ncp /nix/store/lwram6frcvjmyf14pmk5v5k24sf4rgiz-utils.sh $out/nix-support/utils.sh\nmv \"doc/\"*.{gif,png,css,html} \"$out/share/doc/lua/\"\nrmdir $out/{share,lib}/lua/5.4 $out/{share,lib}/lua\nmkdir -p \"$out/lib/pkgconfig\"\n\ncat >\"$out/lib/pkgconfig/lua.pc\" <<EOF\nprefix=$out\nlibdir=$out/lib\nincludedir=$out/include\nINSTALL_BIN=$out/bin\nINSTALL_INC=$out/include\nINSTALL_LIB=$out/lib\nINSTALL_MAN=$out/man/man1\n\nName: Lua\nDescription: An Extensible Extension Language\nVersion: 5.4.7\nRequires:\nLibs: -L$out/lib -llua\nCflags: -I$out/include\nEOF\nln -s \"$out/lib/pkgconfig/lua.pc\" \"$out/lib/pkgconfig/lua-5.4.pc\"\nln -s \"$out/lib/pkgconfig/lua.pc\" \"$out/lib/pkgconfig/lua5.4.pc\"\nln -s \"$out/lib/pkgconfig/lua.pc\" \"$out/lib/pkgconfig/lua54.pc\"\n\n# Make documentation outputs of different versions co-installable.\nmv $out/share/doc/lua $out/share/doc/lua-5.4.7\n","postPatch":"sed -i \"s@#define LUA_ROOT[[:space:]]*\\\"/usr/local/\\\"@#define LUA_ROOT  \\\"$out/\\\"@g\" src/luaconf.h\n\n# abort if patching didn't work\ngrep $out src/luaconf.h\n# Add a target for a shared library to the Makefile.\nsed -e '1s/^/LUA_SO = liblua.so/' \\\n    -e 's/ALL_T *= */&$(LUA_SO) /' \\\n    -i src/Makefile\ncat /nix/store/1k6r7nnd9cxggbl94k9nfmcyfk6wplbi-lua-dso.make >> src/Makefile\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHook":"/nix/store/kzhs0iqzhs4iscivr27rbgz3hc27zyfc-lua-setup-hook","src":"/nix/store/67ryw5cplvlid98a7lvp5wwvnc4xjp43-lua-5.4.7.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"5.4.7"},"inputs":{"drvs":{"4v1nn4bdkxn8hcxl8viryiiscxhlw2p0-utils.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"5r4cwm9fq5c0s3hyyjzri1279jim16w4-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"mnmz5z3dvjl4pjzl2smfgxhbvbgccx3c-lua-5.4.7.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"wmvirw16qv2j6b1v1114mpy25hmm2kpf-readline-8.3p3.drv":{"dynamicOutputs":{},"outputs":["dev"]}},"srcs":["1k6r7nnd9cxggbl94k9nfmcyfk6wplbi-lua-dso.make","kzhs0iqzhs4iscivr27rbgz3hc27zyfc-lua-setup-hook","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"lua-5.4.7","outputs":{"doc":{"path":"n78xkfzzg647hhiad0rqmpx69i7kmyfx-lua-5.4.7-doc"},"out":{"path":"vks2ynlxm2ngpfl3c6g7b2ig9fzd2llk-lua-5.4.7"}},"system":"x86_64-linux","version":4},"7rbhah8msm9fwqic8z1zaa202n1c1z40-libpng-1.6.58-apng.patch.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/pip28064rqvzn66q9x8d016j8m3bkhjn-libpng-1.6.58-apng.patch.gz"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"773919n1zvj8z1v6yr53j218g