-i 's|nss_dist_dir=\"$dist_dir\"|nss_dist_dir=\"'$out'\"|;s|nss_dist_obj_dir=\"$obj_dir\"|nss_dist_obj_dir=\"'$out'\"|' build.sh\n./build.sh -v --opt --with-nspr=/nix/store/jx9hbwkn52znccgxbiz78s8z8fl6qb09-nspr-4.40-dev/include:/nix/store/hs1dngj4cj52ndiiw29warswazbvgi67-nspr-4.40/lib --system-sqlite --enable-legacy-db --target x64 -Dhost_arch=x64 -Duse_system_zlib=1 --enable-libpkix -j $NIX_BUILD_CORES\n\nrunHook postBuild\n","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/lrb68gfh2f8wdhj6y2az97zcfg83v66y-nss-3.112.5-dev","doCheck":"","doInstallCheck":"","installPhase":"runHook preInstall\n\nrm -rf $out/private\nfind $out -name \"*.TOC\" -delete\nmv $out/public $out/include\n\nln -s lib $out/lib64\n\n# Upstream issue: https://bugzilla.mozilla.org/show_bug.cgi?id=530672\n# https://gitweb.gentoo.org/repo/gentoo.git/plain/dev-libs/nss/files/nss-3.32-gentoo-fixups.patch?id=af1acce6c6d2c3adb17689261dfe2c2b6771ab8a\nNSS_MAJOR_VERSION=`grep \"NSS_VMAJOR\" lib/nss/nss.h | awk '{print $3}'`\nNSS_MINOR_VERSION=`grep \"NSS_VMINOR\" lib/nss/nss.h | awk '{print $3}'`\nNSS_PATCH_VERSION=`grep \"NSS_VPATCH\" lib/nss/nss.h | awk '{print $3}'`\nPREFIX=\"$out\"\n\nmkdir -p $out/lib/pkgconfig\nsed -e \"s,%prefix%,$PREFIX,\" \\\n    -e \"s,%exec_prefix%,$PREFIX,\" \\\n    -e \"s,%libdir%,$PREFIX/lib64,\" \\\n    -e \"s,%includedir%,$dev/include/nss,\" \\\n    -e \"s,%NSS_VERSION%,$NSS_MAJOR_VERSION.$NSS_MINOR_VERSION.$NSS_PATCH_VERSION,g\" \\\n    -e \"s,%NSPR_VERSION%,4.16,g\" \\\n    pkg/pkg-config/nss.pc.in > $out/lib/pkgconfig/nss.pc\nchmod 0644 $out/lib/pkgconfig/nss.pc\n\nsed -e \"s,@prefix@,$PREFIX,\" \\\n    -e \"s,@MOD_MAJOR_VERSION@,$NSS_MAJOR_VERSION,\" \\\n    -e \"s,@MOD_MINOR_VERSION@,$NSS_MINOR_VERSION,\" \\\n    -e \"s,@MOD_PATCH_VERSION@,$NSS_PATCH_VERSION,\" \\\n    pkg/pkg-config/nss-config.in > $out/bin/nss-config\nchmod 0755 $out/bin/nss-config\n\ninstallManPage doc/nroff/*\n","man":"/nix/store/jmnal186k2f8nbln1c9vfz40zs51qmaj-nss-3.112.5-man","mesonFlags":"","name":"nss-3.112.5","nativeBuildInputs":"/nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0 /nix/store/60z9n8f7cczph0klb7ny1mikhd8m1vkl-ninja-1.13.2 /nix/store/8pw3ipdyv0aqp59dfpikqibbvl0fcayn-python3-3.13.15-env /nix/store/v2i3m4k78qypvizq4igm1izik677c47p-install-shell-files","out":"/nix/store/sy1r30pqicgxnx6z2j6dqvfz42zd5g4p-nss-3.112.5","outputs":"out dev tools man","patches":"/nix/store/6w94vq4d02h3fkvnpr4qmy6npzfd5sd2-85_security_load_3.85+.patch /nix/store/a5skdyvh7a4iap5bpvlrxfq68y330xli-fix-cross-compilation.patch","pname":"nss","postFixup":"moveToOutput bin \"$tools\"\nmoveToOutput bin/nss-config \"$dev\"\nmoveToOutput lib/libcrmf.a \"$dev\" # needed by firefox, for example\nrm -f \"$out\"/lib/*.a\n\nrunHook postInstall\n","postInstall":"# Replace built-in trust with p11-kit connection\nln -sf /nix/store/4l0jkaf7zavzdyjbqzi39cyk1j9ds8g2-p11-kit-0.26.2/lib/pkcs11/p11-kit-trust.so $out/lib/libnssckbi.so\n","postPatch":"patchShebangs .\n\nfor f in coreconf/config.gypi build.sh; do\n  substituteInPlace \"$f\" --replace \"/usr/bin/env\" \"/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/env\"\ndone\n\nsubstituteInPlace coreconf/config.gypi --replace \"/usr/bin/grep\" \"/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/env grep\"\n","propagatedBuildInputs":"/nix/store/jx9hbwkn52znccgxbiz78s8z8fl6qb09-nspr-4.40-dev","propagatedNativeBuildInputs":"","src":"/nix/store/9jzzx8r3mdwbjr6f1a6vr4cn4idcbnwd-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","tools":"/nix/store/m7rcfq7fxa2sdx0l4h85nwf6ii6darxh-nss-3.112.5-tools","version":"3.