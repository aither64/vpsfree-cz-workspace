 that are not found in the file.\nmake \"${makeFlags[@]}\" oldconfig\nrunHook postConfigure\n\nmake \"${makeFlags[@]}\" prepare\nactualModDirVersion=\"$(cat $buildRoot/include/config/kernel.release)\"\nif [ \"$actualModDirVersion\" != \"6.18.45\" ]; then\n  echo \"Error: modDirVersion 6.18.45 specified in the Nix expression is wrong, it should be: $actualModDirVersion\"\n  exit 1\nfi\n\nbuildFlags+=(\"KBUILD_BUILD_TIMESTAMP=$(date -u -d @$SOURCE_DATE_EPOCH)\")\n\ncd $buildRoot\n","depsBuildBuild":["/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0"],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"dontCheckForBrokenSymlinks":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"KRUSTFLAGS":"--remap-path-prefix /nix/store/pfhglic7cvs9nwlq3z1kqhlzxh51w0jm-rust-lib-src=/","RUST_LIB_SRC":"/nix/store/pfhglic7cvs9nwlq3z1kqhlzxh51w0jm-rust-lib-src"},"hardeningDisable":["bindnow","format","fortify","stackprotector","pic"],"installFlags":["INSTALL_PATH=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9","INSTALL_MOD_PATH=/05n2ffx0bx7cbs5cpskwv10kvhr5662c2hh43kwqqb2y4gmiifn9"],"installTargets":["install"],"karch":"x86_64","makeFlags":["O=$(buildRoot)","--eval=undefine modules","CC=/nix/store/2limljgc50jy76vg388ldgggcjhhkhav-gcc-15.2.0/bin/gcc","LD=/nix/store/7fpa17hpgqqs084lk08j0mwmc5xpbyf4-binutils-2.46/bin/ld","AR=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/ar","NM=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/nm","STRIP=/nix/store/7fpa17hpgqqs084lk08j0mwmc5xpbyf4-binutils-2.46/bin/strip","OBJCOPY=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/objcopy","OBJDUMP=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/objdump","READELF=/nix/store/c7c0yarb87cv4jxlyr02