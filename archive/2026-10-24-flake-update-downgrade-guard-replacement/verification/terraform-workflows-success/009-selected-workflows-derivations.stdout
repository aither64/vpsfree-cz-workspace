| tee >(cat - >&3))\"\n  exec 3>&-\n\n  gempkg=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"activesupport aes_key_wrap base64 bindata faraday faraday-follow_redirects","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"json-jwt","gemPath":"/nix/store/s9s7rl49jvfylnci5zkx88xw38k219pi-ruby3.4-activesupport-8.1.4 /nix/store/h3pdv74bsl0sqn3z33b6w3qaksr22lmk-ruby3.4-aes_key_wrap-1.1.0 /nix/store/qrdhlx9bav6vck5kgikifnk5wckxx841-ruby3.4-base64-0.3.0 /nix/store/qk57mdk8q6hxyp6vm91lga8cm478p2jj-ruby3.4-bindata-2.5.1 /nix/store/lm3yvql3j5v0qxl3lvw96c6fhcf6wg6k-ruby3.4-faraday-2.15.0 /nix/store/w589kzvv2w29m9xm2gb9kd7s365j8idb-ruby3.4-faraday-follow_redirects-0.5.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-json-jwt-1.17.2","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/xqbpmkcbk7xwkq37dd5z9incna0adflc-ruby3.4-json-jwt-1.17.2","outputs":"out","patches":"","pname":"json-jwt","propagatedBuildInputs":"/nix/store/s9s7rl49jvfylnci5zkx88xw38k219pi-ruby3.4-activesupport-8.1.4 /nix/store/h3pdv74bsl0sqn3z33b6w3qaksr22lmk-ruby3.4-aes_key_wrap-1.1.0 /nix/store/qrdhlx9bav6vck5kgikifnk5wckxx841-ruby3.4-base64-0.3.0 /nix/store/qk57mdk8q6hxyp6vm91lga8cm478p2jj-ruby3.4-bindata-2.5.1 /nix/store/lm3yvql3j5v0qxl3lvw96c6fhcf6wg6k-ruby3.4-faraday-2.15.0 /nix/stor