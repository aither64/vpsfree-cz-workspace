sTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"NIX_LDFLAGS":"-lgcc_s","NIX_MAIN_PROGRAM":"git"},"installCheckFlags":["DEFAULT_TEST_TARGET=prove","PERL_PATH=/nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0/bin/perl"],"installCheckTarget":"test","installFlags":["NO_INSTALL_HARDLINKS=1"],"makeFlags":["prefix=${out}","ZLIB_NG=1","SHELL_PATH=/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","NO_PERL=1","NO_PYTHON=1","sysconfdir=/etc"],"mesonFlags":[],"name":"git-minimal-2.54.0","nativeBuildInputs":["/nix/store/nw7kdrk7fy5az89kq116mxwsdd1mwc4g-uname","/nix/store/db8cwzsgxv3lijvf18kqvjjbylm5hrpi-gettext-1.0","/nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0","/nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","/nix/store/cizqnkc40i7k401f8cl2260ksi9nnph4-pkg-config-wrapper-0.29.2","/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh"],"outputChecks":{"debug":{},"out":{"disallowedReferences":[]}},"outputs":["out","debug"],"patches":["/nix/store/j6vpikcvv4ry0pwalvpz1m65k2wckavl-docbook2texi.patch","/nix/store/xprdd33cnqprwk19lxi57h907fz7xic2-git-sh-i18n.patch","/nix/store/85ax0pclk9prgkp8d7m6n6q1g7v5m58j-git-send-email-honor-PATH.patch","/nix/store/k7c6k6zwjh9fgzm9fazn9l1qm6wnv0cy-t7703-ignore-ls-total.patch","/nix/store/fzzc79ndlidjp84dx1mxr4ir8sgi3msm-expect-gui--askyesno-failure-in-t1517.patch"],"pname":"git-minimal","postBuild":"# Set up the flags array for make in the same way as for the main build\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelBuilding:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray buildFlags buildFlagsArray\nechoCmd 'build flags' \"${flagsArray[@]}\"\nmake -C contrib/subtree \"${flagsArray[@]}\" all \nunset flagsArray\n","postInstall":"# Set up the flags array for make in the same way as for the main install\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelInstalling:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray installFlags installFlagsArray\nechoCmd 'install flags' \"${flagsArray[@]}\"\n\n# Install git-subtree.\nmake -C contrib/subtree \"${flagsArray[@]}\" install \nrm -rf contrib/subtree\n\n# Install contrib stuff.\nmkdir -p $out/share/git\ncp -a contrib $out/share/git/\nmkdir -p $out/share/bash-completion/completions\nln -s $out/share/git/contrib/completion/git-prompt.sh $out/share/bash-completion/completions/\n\n# grep is a runtime dependency, need to patch so that it's found\nsubstituteInPlace $out/libexec/git-core/git-sh-setup \\\n    --replace ' grep' ' /nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin/grep' \\\n    --replace ' egrep' ' /nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin/egrep'\n\n# Fix references to the perl, sed, awk and various coreutil binaries used by\n# shell scripts that git calls (e.g. filter-branch)\nSCRIPT=\"$(cat <<'EOS'\n  BEGIN{\n    @a=(\n      '/nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin/grep', '/nix/store/svl89366pvzz5s3myh1fjniz9l0x17fh-gnused-4.10/bin/sed', '/nix/store/m7wg7cj2vw3n6a0pcl3fzbqfm0qsawmd-gawk-5.4.1/bin/awk',\n      '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/cut', '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/basename', '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/dirname',\n      '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/wc', '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/tr'\n      \n    );\n  }\n  foreach $c (@a) {\n    $n=(split(\"/\", $c))[-1];\n    s|(?<=[^#][^/.-])\\b${n}(?=\\s)|${c}|g\n  }\nEOS\n)\"\nperl -0777 -i -pe \"$SCRIPT\" \\\n  $out/libexec/git-core/git-{sh-setup,filter-branch,merge-octopus,mergetool,quiltimport,request-pull,submodule,subtree,web--browse}\n\n\n# Also put git-http-backend into $PATH, so that we can use smart\n# HTTP(s) transports for pushing\nln -s $out/libexec/git-core/git-http-backend $out/bin/git-http-backend\nln -s $out/share/git/contrib/git-jump/git-jump $out/bin/git-jump\nrm $out/libexec/git-core/git-svn\nrm $out/libexec/git-core/git-send-email\nfor prog in bin/gitk libexec/git-core/git-gui; do\n  rm \"$out/$prog\"\ndone\nunset flagsArray\n","postPatch":"# Fix references to gettext introduced by ./git-sh-i18n.patch\nsubstituteInPlace git-sh-i18n.sh \\\n    --subst-var-by gettext /nix/store/db8cwzsgxv3lijvf18kqvjjbylm5hrpi-gettext-1.0\nsubstituteInPlace contrib/credential/libsecret/Makefile \\\n    --replace-fail 'pkg-config' \"$PKG_CONFIG\"\n# ensure we are using the correct shell when executing the test scripts\npatchShebangs t/*.sh\n","preBuild":"makeFlagsArray+=( perllibdir=$out/$(perl -MConfig -wle 'print substr $Config{installsitelib}, 1 + length $Config{siteprefixexp}') )\n","preInstall":"","preInstallCheck":"# Some tests break with high concurrency\n# https://github.com/NixOS/nixpkgs/pull/403237\nif ((NIX_BUILD_CORES > 32)); then\n  NIX_BUILD_CORES=32\nfi\n\ninstallCheckFlagsArray+=(\n  GIT_PROVE_OPTS=\"--jobs $NIX_BUILD_CORES --failures --state=failed,save\"\n  GIT_TEST_INSTALLED=$out/bin\n  NO_SVN_TESTS=y\n)\n\nfunction disable_test {\n  local test=$1 pattern=$2\n  if [ $# -eq 1 ]; then\n    mv t/{,skip-}$test.sh || true\n  else\n    sed -i t/$test.sh \\\n      -e \"/^\\s*test_expect_.*$pattern/,/^\\s*' *\\$/{s/^/: #/}\"\n  fi\n}\n\n# Shared permissions are forbidden in sandbox builds:\nsubstituteInPlace t/test-lib.sh \\\n  --replace \"test_set_prereq POSIXPERM\" \"\"\n# TODO: Investigate while these still fail (without POSIXPERM):\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'shared overrides system'\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'init honors global core.sharedRepository'\n# Tested to fail: 2.46.0\ndisable_test t1301-shared-repo\n# /build/git-2.44.0/contrib/completion/git-completion.bash: lin