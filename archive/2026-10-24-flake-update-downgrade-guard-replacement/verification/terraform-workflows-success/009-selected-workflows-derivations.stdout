]},"vkih34hcsqic1njlsgf78gni9hkq4xxk-nixos-install.drv":{"dynamicOutputs":{},"outputs":["out"]},"vqn9gw6ja6jwypif4hpcy9ygjnzzbg94-bash-interactive-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"wc10sia8r49qffcpch8n9f36qq4a9z3f-diffutils-3.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"xagqgk2maf7crdqxpac18dd2a3mfnk48-gptfdisk-1.0.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"ympn34qj9sfr6ir22z8d9lbl2bi636yz-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"z300misz7zy2zhl6d8xla3ngpp5dm73w-lkl-2025-11-13.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"nixos-test-disk-image","outputs":{"out":{"path":"46jc8zhy208axyh7jmlw45jx5j80aanh-nixos-test-disk-image"}},"structuredAttrs":{"QEMU_OPTS":"","buildCommand":"export PATH=/nix/store/j310a1j772b3lszjmxps00704nayqj4f-rsync-3.4.4/bin:/nix/store/4n075ll5jdwbjv142yg8ymz5f3yf4pam-util-linux-2.42.2-bin/bin:/nix/store/jjk6hw8g3nhdi2s7rbpgmnwkb5r7kfbw-parted-3.7/bin:/nix/store/3llrnwchkvcxgnrr604fhkvcmrlbrk2q-e2fsprogs-1.47.4-bin/bin:/nix/store/3yqacq7q3dfxkqn1znkgfrlm6dr9zi6v-lkl-2025-11-13/bin:/nix/store/k4a7p2ap87g5a7hvrdxx8ii9fb9fq5if-nixos-install/bin:/nix/store/lncccjysbrhk7fsn37v0gkbcqgawl60n-nixos-enter/bin:/nix/store/phdp59im6jvacsm7xcfv8ayd4s6ljk21-nix-2.34.8/bin:/nix/store/ccvdybwln7cvwa10xsjjqsml004xja8m-systemd-minimal-260.2/bin:/nix/store/d7gzrl8irg7hfqzvp3j2f6y6a38pj55x-gptfdisk-1.0.10/bin:/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin:/nix/store/jwq26byp7q4mxqg3yqqq4vgsabs7yknm-findutils-4.10.0/bin:/nix/store/9gjcj4ndp2akrqx108qwb56jzc7y7zrk-diffutils-3.12/bin:/nix/store/svl89366pvzz5s3myh1fjniz9l0x17fh-gnused-4.10/bin:/nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin:/nix/store/m7wg7cj2vw3n6a0pcl3fzbqfm0qsawmd-gawk-5.4.1/bin:/nix/store/c7g9dm6l2s33v60k8r6y7p1bc0vxd2ww-gnutar-1.35/bin:/nix/store/2722ncq58c1amdv6g6nv5d1wvab30p0r-gzip-1.14/bin:/nix/store/7mx2y4jcvcninami5vic5hz703ylrhnp-bzip2-1.0.8-bin/bin:/nix/store/9wyldz5qids294k9h5qcg1f72i52jidi-gnumake-4.4.1/bin:/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin:/nix/store/6w1adb545ayza5syyj4d6xscgn66jcws-patch-2.8/bin:/nix/store/ag994bfxf4wg90nv66y2j18djc5v34cc-xz-5.8.3-bin/bin:/nix/store/qicb9wk67c30wwplxlpx3a2f44bzrmmm-file-5.47/bin:$PATH\n\nrootDisk=/dev/vda\n\n# It is necessary to set root filesystem unique identifier in advance, otherwise\n# bootloader might get the wrong one and fail to boot.\n# At the end, we reset again because we want deterministic timestamps.\ntune2fs -T now -U F222513B-DED1-49FA-B591-20CE86A2FE7F -c 0 -i 0 $rootDisk\n\n# make systemd-boot find ESP without udev\nmkdir /dev/block\nln -s /dev/vda1 /dev/block/254:1\n\nmountPoint=/mnt\nmkdir $mountPoint\nmount $rootDisk $mountPoint\n\n# Create the ESP and mount it. Unlike e2fsprogs, mkfs.vfat doesn't support an\n# '-E offset=X' option, so we can't do this outside the VM.\n\n\n\n\n# Install a configuration.nix\nmkdir -p /mnt/etc/nixos\n\n\n\n\n# Set the ownerships of the contents. The modes are set in preVM.\n# No globbing on targets, so no need to set -f\ntargets_=()\nusers_=()\ngroups_=()\nfor ((i = 0; i < ${#targets_[@]}; i++)); do\n  target=\"${targets_[$i]}\"\n  user=\"${users_[$i]}\"\n  group=\"${groups_[$i]}\"\n  if [ -n \"$user$group\" ]; then\n    # We have to nixos-enter since we need to use the user and group of the VM\n    nixos-enter --root $mountPoint -- chown -R \"$user:$group\" \"$target\"\n  fi\ndone\n\numount -R /mnt\n\n# Make sure resize2fs works. Note that resize2fs has stricter criteria for resizing than a normal\n# mount, so the `-c 0` and `-i 0` don't affect it. Setting it to `now` doesn't produce deterministic\n# output, of course, but we can fix that when/if we start making images deterministic.\n# In deterministic mode, this is fixed to 1970-01-01 (UNIX timestamp 0).\n# This two-step approach is necessary otherwise `tune2fs` will want a fresher filesystem to perform\n# some changes.\ntune2fs -T now -U F222513B-DED1-49FA-B591-20CE86A2FE7F -c 0 -i 0 $rootDisk\ntune2fs -f -T 19700101 $rootDisk\n\n","buildInputs":["/nix/store/fc06kw42kmdp3kqnp9dwvl10c5q1rz4q-util-linux-2.42.2-dev","/nix/store/pa1dqv7m1h7m0ncwd35gqkji6ifl75l0-e2fsprogs-1.47.4-dev","/nix/store/wkdhd69xwlp5qndajkfl7b8xs0yab0v3-dosfstools-4.2"],"builder":"/nix/store/pkf547jp8a92k4wmxikkyby58w10pysr-bash-interactive-5.3p9/bin/sh","cmakeFlags":[],"configureFlags":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"QEMU_OPTS":" -m 8192 -object memory-backend-memfd,id=mem,size=8192M,share=on -machine memory-backend=mem"},"memSize":8192,"mesonFlags":[],"name":"nixos-test-disk-image","nativeBuildInputs":[],"origArgs":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"origBuilder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","outputs":["out"],"passAsFile":["buildCommand"],"patches":[],"postVM":"mv $diskImage $out/nixos-test.img\n\ndiskImage=$out/nixos-test.img\nmkdir -p $out/nix-support\necho \"file raw-image $out/nixos-test.img\" >> $out/nix-support/hydra-build-products\n","preVM":"export PATH=/nix/store/j310a1j772b3lszjmxps00704nayqj4f-rsync-3.4.4/bin:/nix/store/4n075ll5jdwbjv142yg8ymz5f3yf4pam-util-linux-2.42.2-bin/bin:/nix/store/jjk6hw8g3nhdi2s7rbpgmnwkb5r7kfbw-parted-3.7/bin:/nix/store/3llrnwchkvcxgnrr604fhkvcmrlbrk2q-e2fsprogs-1.47.4-bin/bin:/nix/store/3yqacq7q3dfxkqn1znkgfrlm6dr9zi6v-lkl-2025-11-13/bin:/nix/store/k4a7p2ap87g5a7hvrdxx8ii9fb9fq5if-nixos-install/bin:/nix/store/lncccjysbrhk7fsn37v0gkbcqgawl60n-nixos-enter/bin:/nix/store/phdp59im6jvacsm7xcfv8ayd4s6ljk21-nix-2.34.8/bin:/nix/store/ccvdybwln7cvwa10xsjjqsml004xja8m-systemd-minimal-260.2/bin:/nix/store/d7gzrl8irg7hfqzvp3j2f6y6a38pj55x-gptfdisk-1.0.10/bin:/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin:/nix/store/jwq26byp7q4mxqg3yqqq4vgsabs7yknm-findutils-4.10.0/bin:/nix/store/9gjcj4ndp2akrqx108qwb56jzc7y7zrk-diffutils-3.12/bin:/nix/store/svl89366pvzz5s3myh1fjniz9l0x17fh-gnused-4.10/bin:/nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin:/nix/store/m7wg7cj2vw3n6a0pcl3fzbqfm0qsawmd-gawk-5.4.1/bin:/nix/store/c7g9dm6l2s33v60k8r6y7p1bc0vxd2ww-gnutar-1.35/bin:/nix/store/2722ncq58c1amdv6g6nv5d1wvab30p0r-gzip-1.14/bin:/nix/store/7mx2y4jcvcninami5vic5hz703ylrhnp-bzip2-1.0.8-bin/bin:/nix/store/9wyldz5qids294k9h5qcg1f72i52jidi-gnumake-4.4.1/bin:/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin:/nix/store/6w1adb545ayza5syyj4d6xscgn66jcws-patch-2.8/bin:/nix/store/ag994bfxf4wg90nv66y2j18djc5v34cc-xz-5.8.3-bin/bin:/nix/store/qicb9wk67c30wwplxlpx3a2f44bzrmmm-file-5.47/bin\n\n# Yes, mkfs.ext4 takes different units in different contexts. Fun.\nsectorsToKilobytes() {\n  echo $(( ( \"$1\" * 512 ) / 1024 ))\n}\n\nsectorsToBytes() {\n  echo $(( \"$1\" * 512  ))\n}\n\n# Given lines of numbers, adds them together\nsum_lines() {\n  local acc=0\n  while read -r number; do\n    acc=$((acc+number))\n  done\n  echo \"$acc\"\n}\n\nmebibyte=$(( 1024 * 1024 ))\n\n# Approximative percentage of reserved space in an ext4 fs over 512MiB.\n# 0.05208587646484375\n#  × 1000, integer part: 52\ncompute_fudge() {\n  echo $(( $1 * 52 / 1000 ))\n}\n\nround_to_nearest() {\n  echo $(( ( $1 / $2 + 1) * $2 ))\n}\n\nmkdir $out\n\nroot=\"$PWD/root\"\nmkdir -p $root\n\n# Copy arbitrary other files into the image\n# Semi-shamelessly copied from make-etc.sh.\nset -f\nsources_=()\ntargets_=()\nmodes_=()\nset +f\n\nfor ((i = 0; i < ${#targets_[@]}; i++)); do\n  source=\"${sources_[$i]}\"\n  target=\"${targets_[$i]}\"\n  mode=\"${modes_[$i]}\"\n\n  if [ -n \"$mode\" ]; then\n    rsync_chmod_flags=\"--chmod=$mode\"\n  else\n    rsync_chmod_flags=\"\"\n  fi\n  # Unfortunately cptofs only supports modes, not ownership, so we can't use\n  # rsync's --chown option. Instead, we change the ownerships in the\n  # VM script with chown.\n  rsync_flags=\"-a --no-o --no-g $rsync_chmod_flags\"\n  if [[ \"$source\" =~ '*' ]]; then\n    # If the source name contains '*', perform globbing.\n    mkdir -p $root/$target\n    for fn in $source; do\n      rsync $rsync_flags \"$fn\" $root/$target/\n    done\n  else\n    mkdir -p $root/$(dirname $target)\n    if [ -e $root/$target ]; then\n      echo \"duplicate entry $target -> $source\"\n      exit 1\n    elif [ -d $source ]; then\n      # Append a slash to the end of source to get rsync to copy the\n      # directory _to_ the target instead of _inside_ the target.\n      # (See `man rsync`'s note on a trailing slash.)\n      rsync $rsync_flags $source/ $root/$target\n    else\n      rsync $rsync_flags $source $root/$target\n    fi\n  fi\ndone\n\nexport HOME=$TMPDIR\n\n# Provide a Nix database so that nixos-install can copy closures.\nexport NIX_STATE_DIR=$TMPDIR/state\nnix-store --load-db < /nix/store/ac1gjqwcszjvx5dfk33dvdalqbkdi6ss-closure-info/registration\n\nchmod 755 \"$TMPDIR\"\necho \"running nixos-install...\"\nnixos-install --root $root --no-bootloader --no-root-passwd \\\n  --system /nix/store/ax97hbf620xj79vyng3f116j89x3lry8-nixos-system-vpsadmin-services-26.05pre-git \\\n  --no-channel-copy \\\n  --substituters \"\"\n\n\n\ndiskImage=nixos.raw\n\nbootSize=$(round_to_nearest $(numfmt --from=iec '256M') $mebibyte)\nbootSizeMiB=$(( bootSize / 1024 / 1024 ))MiB\n\nreservedSpace=0\n\nadditionalSpace=$(( $(numfmt --from=iec '512M') + reservedSpace ))\n\n# Compute required space in filesystem blocks\ndiskUsage=$(find . ! -type d -print0 | du --files0-from=- --apparent-size --count-links --block-size \"4096\" | cut -f1 | sum_lines)\n# Each inode takes space!\nnumInodes=$(find . | wc -l)\n# Convert to bytes, inodes take two blocks each!\ndiskUsage=$(( (diskUsage + 2 * numInodes) * 4096 ))\n# Then increase the required space to account for the reserved blocks.\nfudge=$(compute_fudge $diskUsage)\nrequiredFilesystemSpace=$(( diskUsage + fudge ))\n\n# Round up to the nearest block size.\n# This ensures whole $blockSize bytes block sizes in the filesystem\n# and helps towards aligning partitions optimally.\nrequiredFilesystemSpace=$(round_to_nearest $requiredFilesystemSpace 4096)\n\ndiskSize=$(( requiredFilesystemSpace + additionalSpace ))\n\n# Round up to the nearest mebibyte.\n# This ensures whole 512 bytes sector sizes in the disk image\n# and helps towards aligning partitions optimally.\ndiskSize=$(round_to_nearest $diskSize $mebibyte)\n\ntruncate -s \"$diskSize\" $diskImage\n\nprintf \"Automatic disk size...\\n\"\nprintf \"  Closure space use: %d bytes\\n\" $diskUsage\nprintf \"  fudge: %d bytes\\n\" $fudge\nprintf \"  Filesystem size needed: %d bytes\\n\" $requiredFilesystemSpace\nprintf \"  Additional space: %d bytes\\n\" $additionalSpace\nprintf \"  Disk image size: %d bytes\\n\" $diskSize\n\n\n\n\nmkfs.ext4 -b 4096 -F -L nixos $diskImage\n\n\necho \"copying staging root to image...\"\ncptofs -p  \\\n       -t ext4 \\\n       -i $diskImage \\\n       $root/* / ||\n  (echo >&2 \"ERROR: cptofs failed. diskSize might be too small for closure.\"; exit 1)\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["kvm"],"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"system":"x86_64-linux"},"system":"x86_64-linux","version":4},"wxny1dpv9gypmdl9sqdk744jyx5gdmk8-sv-osctld-run.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$targe