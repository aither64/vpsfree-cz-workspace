856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-osctl-repo-26.05.0","nativeBuildInputs":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/b5hp3mz08riq43j7diw7yf77abm9khgl-ruby3.4-osctl-repo-26.05.0","outputs":"out","patches":"","pname":"osctl-repo","propagatedBuildInputs":"/nix/store/8bg79l9cbnkgbfg76nn5c163kvi4y09a-ruby3.4-filelock-1.1.1 /nix/store/myrbk54s0r46rif9wx9qscvlcw1cxzx4-ruby3.4-gli-2.22.2 /nix/store/1qd1hl4q1izishy65b3pdj38zjvayhi3-ruby3.4-json-2.19.8 /nix/store/49igmpzaqxlyf8ak4bvscz3gk29dfqfp-ruby3.4-libosctl-26.05.0 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/8bg79l9cbnkgbfg76nn5c163kvi4y09a-ruby3.4-filelock-1.1.1 /nix/store/myrbk54s0r46rif9wx9qscvlcw1cxzx4-ruby3.4-gli-2.22.2 /nix/store/1qd1hl4q1izishy65b3pdj38zjvayhi3-ruby3.4-json-2.19.8 /nix/store/49igmpzaqxlyf8ak4bvscz3gk29dfqfp-ruby3.4-libosctl-26.05.0 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0","ruby":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9","src":"/nix/store/idxqjbp85zh1ilzjlglmpqhh2givrmsq-zd7z6pw3pkk6099kjvjryqq5xxgblygw-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"26.05.0","system":"x86