\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-native-system-header-dir=/nix/store/g9m5dfj4xfizbwmvgiwlj9h6gvxr8wxx-glibc-2.42/include \\\n  --enable-languages=c,c++ \\\n  --enable-checking=release \\\n  --disable-bootstrap \\\n  --disable-dependency-tracking \\\n  --disable-libsanitizer \\\n  --disable-libssp \\\n  --disable-libgomp \\\n  --disable-libquadmath \\\n  --disable-libitm \\\n  --disable-libvtv \\\n  --disable-libatomic \\\n  --disable-libstdcxx-pch \\\n  --disable-lto \\\n  --disable-multilib \\\n  --disable-nls \\\n  --disable-plugin \\\n  --with-specs=\"%x{-dynamic-linker=/nix/store/g9m5dfj4xfizbwmvgiwlj9h6gvxr8wxx-glibc-2.42/lib/ld-linux-x86-64.so.2} %x{-L/nix/store/g9m5dfj4xfizbwmvgiwlj9h6gvxr8wxx-glibc-2.42/lib/} -B/nix/store/g9m5dfj4xfizbwmvgiwlj9h6gvxr8wxx-glibc-2.42/lib\"\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n\n# libstdc++ gdb pretty-printers + man pages are unused downstream.\nrm -rf $out/share/gcc-*/python $out/share/man $out/share/info\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"gcc-15.2.0","out":"/nix/store/8a7sqjhh9wh2ax7rzfc21f9p34fp41li-gcc-15.2.0","passAsFile":"buildCommand","pname":"gcc","system":"x86_64-linux","version":"15.2.0"},"inputs":{"drvs":{"0q1fkyw9jc9fafyswh9gkv48wph52yzy-isl-0.24.tar.bz2.drv":{"dynamicOutputs":{},"outputs":["out"]},"1hgh3ynq1lsicaxr0r5pdbvkbbhb0vrr-gmp-6.3.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"3298jfza8zv78425rrpr80xxcnnrbgr9-bzip2-1.0.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"3zhi7fn92ym1ds0n3yybmjyjvksypi39-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b0xnqkbv7qnbbbc7zhqwahygjf7mc2i-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"7l7ydfkn02frc6vw186zbzk65y3my3np-glibc-2.42.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gwpvw0ssr7xmfzvy97c6f493fhc2f7r-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"bv4a5fw05q4ysq24wy0z06bd5jysq1p2-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"h545qb92mx5i9q4amb44d2phh9by0zrq-gcc-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"hxagi71byf79kd6630nkzzslsmmjir34-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"jm8c5a9ysfm3fckryllnl6pd3nm1hd17-bootstrap-coreutils-musl-9.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"l6a6rj0gy31gp6k7k80qzn4ni0yvyzgh-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"q3px40945ahyqcfk1jd5i0ysarphz9dv-mpfr-4.2.2.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"s2g0la1392ys0bp34d0m38kmlzwi30v1-binutils-2.46.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a9pds57ms69gfi2ya-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"v8jl1cziqai2qqgn0axr9cv3masm5nb5-bash-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"vf5nz05lk9n6xm1h1sh3c8s951ybk08h-musl-1.2.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"wbaljcz177vkkjn844nya51h6jrl49hi-gcc-15.2.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"xlhf3ibq6r6qy2myin330ay7qscfzi1g-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"zzgcx00wj6bml7sdl4zzg1yy5zvzddl0-mpc-1.3.1.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["70acbfgbz5cxsx4sqzcnj8qaqhb4i9ay-bash-builder.sh"]},"name":"gcc-15.2.0","outputs":{"out":{"path":"8a7sqjhh9wh2ax7rzfc21f9p34fp41li-gcc-15.2.0"}},"system":"x86_64-linux","version":4},"zx08p4b83wzi66zz6s2a1gfb0dv3zy2d-unit-script-mysql-post-start.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"mysql-post-start","__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash -n -O extglob \"$target\"\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"/bin/mysql-post-start","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"unit-script-mysql-post-start","nativeBuildInputs":"","out":"/nix/store/668pg081m05f8jyi02gbf9rqxjjjhycc-unit-script-mysql-post-start","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash\nset -e\n\n# If MariaDB is used in an Galera cluster, we have to check if the sync is done,\n# or it will fail to init the database while joining, so we get in an broken non recoverable state\n# so we wait until we have an synced state\nif /nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12/bin/mysql -u mysql -N -e \"SHOW VARIABLES LIKE 'wsrep_on'\" 2>/dev/null | /nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin/grep -q 'ON'; then\n  echo \"Galera cluster detected, waiting for node to be synced...\"\n  while true; do\n    STATE=$(/nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12/bin/mysql -u mysql -N -e \"SHOW STATUS LIKE 'wsrep_local_state_comment'\" | /nix/store/m7wg7cj2vw3n6a0pcl3fzbqfm0qsawmd-gawk-5.4.1/bin/awk '{print $2}')\n    if [ \"$STATE\" = \"Synced\" ]; then\n      echo \"Node is synced\"\n      break\n    else\n      echo \"Current state: $STATE - Waiting for 1 second...\"\n      sleep 1\n    fi\n  done\nfi\n\n\nif [ -f /var/lib/mysql/mysql_init ]\nthen\n    # While MariaDB comes with a 'mysql' super user account since 10.4.x, MySQL does not\n    # Since we don't want to run this service as 'root' we need to ensure the account exists on first run\n    ( echo \"CREATE USER IF NOT EXISTS 'mysql'@'localhost' IDENTIFIED WITH unix_socket;\"\n      echo \"GRANT ALL PRIVILEGES ON *.* TO 'mysql'@'localhost' WITH GRANT OPTION;\"\n    ) | /nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12/bin/mysql -u mysql -N\n\n    \n\n    \n\n    \n\n    # Execute initial script\n# using toString to avoid copying the file to nix store if given as path instead of string,\n# as it might contain credentials\ncat /nix/store/4ma4dqv8nvxrwwfjw005paj1zw2zh0y5-vpsadmin-test-mysql-init.sql | /nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12/bin/mysql -u mysql -N\n\n\n    # Secure root@localhost for MySQL/Percona on first initialization\n    \n\n    rm /var/lib/mysql/mysql_init\nfi\n\n\n\n(\necho \"CREATE DATABASE IF NOT EXISTS \\`vpsadmin\\`;\"\n\n) | /nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12/bin/mysql -N\n\n\n( echo \"CREATE USER IF NOT EXISTS 'vpsadmin'@'localhost' IDENTIFIED WITH unix_socket;\"\n  echo \"GRANT ALL PRIVILEGES ON vpsadmin.* TO 'vpsadmin'@'localhost';\"\n\n) | /nix/store/m5l2vlwq15153rgs9x1k7vsdv8lfccc8-mariadb-server-11.4.12/bin/mysql -N\n\n\n\n"},"inputs":{"drvs":{"5fc2ppakjwxw2fb2mbz78vxdsmq5py5c-mariadb-server-11.4.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8cp1lhkcz1pi19lfzgln6w1kc3jswsi4-gnugrep-3.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"dfd0dzfybgh3r9xwyhkz20y8sl3avcnx-