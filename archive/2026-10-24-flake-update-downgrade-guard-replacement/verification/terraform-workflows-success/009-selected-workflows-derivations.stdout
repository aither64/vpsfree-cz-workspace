"mesonFlags":"","name":"vm-run","nativeBuildInputs":"","out":"/nix/store/mx08lb33mxsa384jk2krnjb0lwgvwzf2-vm-run","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/mkdir xchg\nexport > xchg/saved-env\n\nif [ -f \"${NIX_ATTRS_SH_FILE-}\" ]; then\n  /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/cp $NIX_ATTRS_JSON_FILE $NIX_ATTRS_SH_FILE xchg\n  source \"$NIX_ATTRS_SH_FILE\"\nfi\nsource $stdenv/setup\n\neval \"$preVM\"\n\nif [ \"$enableParallelBuilding\" = 1 ]; then\n  QEMU_NR_VCPUS=0\n  if [ ${NIX_BUILD_CORES:-0} = 0 ]; then\n    QEMU_NR_VCPUS=\"$(nproc)\"\n  else\n    QEMU_NR_VCPUS=\"$NIX_BUILD_CORES\"\n  fi\n  # qemu only supports 255 vCPUs (see error from `qemu-system-x86_64 -smp 256`)\n  if [ \"$QEMU_NR_VCPUS\" -gt 255 ]; then\n    QEMU_NR_VCPUS=255\n  fi\n  QEMU_OPTS+=\" -smp cpus=$QEMU_NR_VCPUS\"\nfi\n\n# Write the command to start the VM to a file so that the user can\n# debug inside the VM if the build fails (when Nix is called with\n# the -K option to preserve the temporary build directory).\n/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/cat > ./run-vm <<EOF\n#! /nix/store/pkf547jp8a92k4wmxikkyby58w10pysr-bash-interactive-5.3p9/bin/sh\n${diskImage:+diskImage=$diskImage}\n# GitHub Actions runners seems to not allow installing seccomp filter: https://github.com/rcambrj/nix-pi-loader/issues/1#issuecomment-2605497516\n# Since we are running in a sandbox already, the difference between seccomp and none is minimal\n/nix/store/5k8lzdmn4xybrsw876ijv7mnrbmah4rq-virtiofsd-1.13.3/bin/virtiofsd --xattr --socket-path virtio-store.sock --sandbox none --seccomp none --shared-dir \"/nix/store\" &\n/nix/store/5k8lzdmn4xybrsw876ijv7mnrbmah4rq-virtiofsd-1.13.3/bin/virtiofsd --xattr --socket-path virtio-xchg.sock --sandbox none --seccomp none --shared-dir xchg &\n\n# Wait until virtiofsd has created these sockets to avoid race condition.\nuntil [[ -e virtio-store.sock ]]; do /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/sleep 0.1; done\nuntil [[ -e virtio-xchg.sock ]]; do /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/sleep 0.1; done\n\n/nix/store/ihh1xb4n4s2nv5p3sccv9dmibc5mgyfh-qemu-host-cpu-only-10.2.4/bin/qemu-system-x86_64 -machine accel=kvm:tcg -cpu max \\\n  -nographic -no-reboot \\\n  -device virtio-rng-pci \\\n  -chardev socket,id=store,path=virtio-store.sock \\\n  -device vhost-user-fs-pci,chardev=store,tag=store \\\n  -chardev socket,id=xchg,path=virtio-xchg.sock \\\n  -device vhost-user-fs-pci,chardev=xchg,tag=xchg \\\n  ${diskImage:+-drive file=$diskImage,if=virtio,cache=unsafe,werror=report} \\\n  -kernel /nix/store/mxdij41zzxwz0ixg401d9nsai7r7qpka-linux-6.18.45/bzImage \\\n  -initrd /nix/store/w0ky8l4hy9jw0r7wsifsfj0242aiah70-initrd/initrd \\\n  -append \"console=ttyS0 panic=1 command=/nix/store/v5kfpg9hhi4vwqah5cabdignz8vn43qy-vm-run-stage2 mountDisk=$mountDisk loglevel=4\" \\\n  $QEMU_OPTS\n\nEOF\n\n/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/chmod +x ./run-vm\nsource ./run-vm\n\nif ! test -e xchg/in-vm-exit; then\n  echo \"Virtual machine didn't produce an exit code.\"\n  exit 1\nfi\n\nexitCode=\"$(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/cat xchg/in-vm-exit)\"\nif [ \"$exitCode\" != \"0\" ]; then\n  exit \"$exitCode\"\nfi\n\neval \"$postVM\"\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8jp6h480nq9a3r2an63cm6xql1kj6mlp-initrd.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"cxm968hcq26c4kbj91cf0rri208qrc6g-qemu-host-cpu-only-10.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"g7sg141rv4hbwp1aj8y4hlrf0f5y6