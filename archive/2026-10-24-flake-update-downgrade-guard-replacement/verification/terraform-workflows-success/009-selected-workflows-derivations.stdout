pfjj5npf0ldyx-coreutils-9.11/bin\",\"target\":null},{\"dlopen\":{\"features\":[],\"usePriority\":\"recommended\"},\"enable\":true,\"source\":\"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash\",\"target\":null},{\"dlopen\":{\"features\":[],\"usePriority\":\"recommended\"},\"enable\":true,\"source\":\"/nix/store/265hgk53hl438z1hgb37i0nbwg4fwqv5-etc-os-release\",\"target\":\"/etc/initrd-release\"},{\"dlopen\":{\"features\":[],\"usePriority\":\"recommended\"},\"enable\":true,\"source\":\"/nix/store/265hgk53hl438z1hgb37i0nbwg4fwqv5-etc-os-release\",\"target\":\"/etc/os-release\"},{\"dlopen\":{\"features\":[],\"usePriority\":\"recommended\"},\"enable\":true,\"source\":\"/nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/lib/systemd/systemd-shutdown\",\"target\":\"/shutdown\"}]"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"899gagmxab8xhknynh1vl3c502nbq0nc-systemd-260.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"lhfv78rcxcpk90mykvf7hhg46hpk78si-etc-os-release.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"shutdown-ramfs-contents.json","outputs":{"out":{"path":"i8yn2s9b8lxvqfrvnmsif1wzwkx5v8s2-shutdown-ramfs-contents.json"}},"system":"x86_64-linux","version":4},"s04clykb4z1b8hshpcbzash8zrv2gy8q-initrd-udev-rules.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"mkdir -p $out\nshopt -s nullglob\nset +o pipefail\n\n# Set a reasonable $PATH for programs called by udev rules.\necho 'ENV{PATH}=\"/nix/store/aqw0x2y520dkk3550v1dg1wbp908154r-initrd-bin-env/bin/bin:/nix/store/aqw0x2y520dkk3550v1dg1wbp908154r-initrd-bin-env/bin/sbin\"' > $out/00-path.rules\n\n# Add the udev rules from other packages.\nfor i in $packages; do\n  echo \"Adding rules for package $i\"\n  for j in $i/{etc,lib}/udev/rules.d/*; do\n    echo \"Copying $j to $out/$(basename $j)\"\n    cat $j > $out/$(basename $j)\n  done\ndone\n\n# Fix some paths in the standard udev rules.  Hacky.\nfor i in $out/*.rules; do\n  substituteInPlace $i \\\n    --replace-quiet \\\"/sbin/modprobe \\\"/nix/store/ahni4ky7vcyga5rkfk6yil6g0293qyvk-kmod-31/bin/modprobe \\\n    --replace-quiet \\\"/sbin/mdadm \\\"/nix/store/i3p2mqi7xc77inxsw127njlpcz0cj234-mdadm-4.4/sbin/mdadm \\\n    --replace-quiet \\\"/sbin/blkid \\\"/nix/store/4n075ll5jdwbjv142yg8ymz5f3yf4pam-util-linux-2.42.2-bin/sbin/blkid \\\n    --replace-quiet \\\"/bin/mount \\\"/nix/store/4n075ll5jdwbjv142yg8ymz5f3yf4pam-util-linux-2.42.2-bin/bin/mount \\\n    --replace-quiet /usr/bin/readlink /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/readlink \\\n    --replace-quiet /usr/bin/cat /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/cat \\\n    --replace-quiet /usr/bin/basename /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/basename 2>/dev/null\nsubstituteInPlace $i --replace-quiet '/run/current-system/systemd' \"/nix/store/aqw0x2y520dkk3550v1dg1wbp908154r-initrd-bin-env\"\n\ndone\n\necho -n \"Checking that all programs called by relative paths in udev rules exist in /nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/lib/udev... \"\nimport_progs=$(grep 'IMPORT{program}=\"[^/$]' $out/* |\n  sed -e 's/.*IMPORT{program}=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nrun_progs=$(grep -v '^[[:space:]]*#' $out/* | grep 'RUN+=\"[^/$]' |\n  sed -e 's/.*RUN+=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nfor i in $import_progs $run_progs; do\n  if [[ ! -x /nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/lib/udev/$i && ! $i =~ socket:.* ]]; then\n    echo \"FAIL\"\n    echo \"$i is called in udev rules but not installed by udev\"\n    exit 1\n  fi\ndone\necho \"OK\"\n\necho -n \"Checking that all programs called by absolute paths in udev rules exist... \"\nimport_progs=$(grep 'IMPORT{program}=\"/' $out/* |\n  sed -e 's/.*IMPORT{program}=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nrun_progs=$(grep -v '^[[:space:]]*#' $out/* | grep 'RUN+=\"/' |\n  sed -e 's/.*RUN+=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nfor i in $import_progs $run_progs; do\n  # if the path refers to /run/current-system/systemd, replace with config.systemd.package\n  if [[ $i == /run/current-system/systemd* ]]; then\n    i=\"/nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/${i#/run/current-system/systemd/}\"\n  fi\n\n  if [[ ! -x $i ]]; then\n    echo \"FAIL\"\n    echo \"$i is called in udev rules but is not executable or does not exist\"\n    exit 1\n  fi\ndone\necho \"OK\"\n\nfilesToFixup=\"$(for i in \"$out\"/*; do\n  # list all files referring to (/usr)/bin paths, but allow references to /bin/sh.\n  grep -P -l '\\B(?!\\/bin\\/sh\\b)(\\/usr)?\\/bin(?:\\/.*)?' \"$i\" || :\ndone)\"\n\nif [ -n \"$filesToFixup\" ]; then\n  echo \"Consider fixing the following udev rules:\"\n  echo \"$filesToFixup\" | while read localFile; do\n    remoteFile=\"origin unknown\"\n    for i in /nix/store/h1dpxri50hi5llambjar3iqsk5d4723k-lvm2-2.03.39-bin /nix/store/xp99bvc5brkxdl13y1i99ih4ia9w6q7h-bcache-tools-1.1 /nix/store/aqw0x2y520dkk3550v1dg1wbp908154r-initrd-bin-env/bin; do\n      for j in \"$i\"/*/udev/rules.d/*; do\n        [ -e \"$out/$(basename \"$j\")\" ] || continue\n        [ \"$(basename \"$j\")\" = \"$(basename \"$localFile\")\" ] || continue\n        remoteFile=\"originally from $j\"\n        break 2\n      done\n    done\n    refs=\"$(\n      grep -o '\\B\\(/usr\\)\\?/s\\?bin/[^ \"]\\+' \"$localFile\" \\\n        | sed -e ':r;N;${s/\\n/ and /;br};s/\\n/, /g;br'\n    )\"\n    echo \"$localFile ($remoteFile) contains references to $refs.\"\n  done\n  exit 1\nfi\n\n# Verify all the udev rules\necho \"Verifying udev rules using udevadm verify...\"\nudevadm verify --resolve-names=late --no-style $out\necho \"OK\"\n\n# If auto-configuration is disabled, then remove\n# udev's 80-drivers.rules file, which contains rules for\n# automatically calling modprobe.\n\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"initrd-udev-rules","nativeBuildInputs":"/nix/store/ccvdybwln7cvwa10xsjjqsml004xja8m-systemd-minimal-260.2","out":"/nix/store/z6bgjd9l0pzjs8smj8yvh3fyvniwflgy-initrd-udev-rules","outputs":"out","packages":"/nix/store/gnx0alh2mrc2ndjs7ik6jm3w7avld56w-lvm2-2.03.39 /nix/store/xp99bvc5brkxdl13y1i99ih4ia9w6q7h-bcache-tools-1.1 /nix/store/pxxdxn00pnbf9qsxzksf7lkl32dnac8m-udev-fido2 /nix/store/4avzw5bz6kj44qqcfgb3jmvi34xl6w5b-initrd-udev-rules /nix/store/9rs9pnsrz4anv2g9l6b6vppdrhngyci1-initrd-udev-rules","passAsFile":"buildCommand","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"5f6q78kqbvj416ylsv05d9i12i26bc9v-bcache-tools-1.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"6h8rg0bq7qqq3mjzccmrb4rpq9qaq2nv-initrd-udev-rules.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8587p58q5hapiv9hy9iayd5zwx46jky8-util-linux-2.42.2.drv":{"dynamicOutputs":{},"outputs":["bin"]},"89