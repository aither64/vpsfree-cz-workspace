:"x86_64-linux"},"inputs":{"drvs":{"pbrsvvhf1i7d9w3h87gk60q3bsngp69z-wait-builder.drv":{"dynamicOutputs":{},"outputs":["out"]},"pz3m6g7iabylyazm40p363y8795vybf9-mescc-tools-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":[]},"name":"wait","outputs":{"out":{"path":"s4vk5kfbhd9f9ibkw030pdv6zafv7334-wait"}},"system":"x86_64-linux","version":4},"9bh3i7lk8lh2igvg5i1x95alk0kll9p7-udev-rules.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"mkdir -p $out\nshopt -s nullglob\nset +o pipefail\n\n# Set a reasonable $PATH for programs called by udev rules.\necho 'ENV{PATH}=\"/nix/store/hn1fyisdr5vb05wz6a852y6z3iypqamh-udev-path/bin:/nix/store/hn1fyisdr5vb05wz6a852y6z3iypqamh-udev-path/sbin\"' > $out/00-path.rules\n\n# Add the udev rules from other packages.\nfor i in $packages; do\n  echo \"Adding rules for package $i\"\n  for j in $i/{etc,lib}/udev/rules.d/*; do\n    echo \"Copying $j to $out/$(basename $j)\"\n    cat $j > $out/$(basename $j)\n  done\ndone\n\n# Fix some paths in the standard udev rules.  Hacky.\nfor i in $out/*.rules; do\n  substituteInPlace $i \\\n    --replace-quiet \\\"/sbin/modprobe \\\"/nix/store/ahni4ky7vcyga5rkfk6yil6g0293qyvk-kmod-31/bin/modprobe \\\n    --replace-quiet \\\"/sbin/mdadm \\\"/nix/store/i3p2mqi7xc77inxsw127njlpcz0cj234-mdadm-4.4/sbin/mdadm \\\n    --replace-quiet \\\"/sbin/blkid \\\"/nix/store/4n075ll5jdwbjv142yg8ymz5f3yf4pam-util-linux-2.42.2-bin/sbin/blkid \\\n    --replace-quiet \\\"/bin/mount \\\"/nix/store/4n075ll5jdwbjv142yg8ymz5f3yf4pam-util-linux-2.42.2-bin/bin/mount \\\n    --replace-quiet /usr/bin/readlink /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/readlink \\\n    --replace-quiet /usr/bin/cat /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/cat \\\n    --replace-quiet /usr/bin/basename /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/basename 2>/dev/null\n\ndone\n\necho -n \"Checking that all programs called by relative paths in udev rules exist in /nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/lib/udev... \"\nimport_progs=$(grep 'IMPORT{program}=\"[^/$]' $out/* |\n  sed -e 's/.*IMPORT{program}=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nrun_progs=$(grep -v '^[[:space:]]*#' $out/* | grep 'RUN+=\"[^/$]' |\n  sed -e 's/.*RUN+=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nfor i in $import_progs $run_progs; do\n  if [[ ! -x /nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/lib/udev/$i && ! $i =~ socket:.* ]]; then\n    echo \"FAIL\"\n    echo \"$i is called in udev rules but not installed by udev\"\n    exit 1\n  fi\ndone\necho \"OK\"\n\necho -n \"Checking that all programs called by absolute paths in udev rules exist... \"\nimport_progs=$(grep 'IMPORT{program}=\"/' $out/* |\n  sed -e 's/.*IMPORT{program}=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nrun_progs=$(grep -v '^[[:space:]]*#' $out/* | grep 'RUN+=\"/' |\n  sed -e 's/.*RUN+=\"\\([^ \"]*\\)[ \"].*/\\1/' | uniq)\nfor i in $import_progs $run_progs; do\n  # if the path refers to /run/current-system/systemd, replace with config.systemd.package\n  if [[ $i == /run/current-system/systemd* ]]; then\n    i=\"/nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/${i#/run/current-system/systemd/}\"\n  fi\n\n  if [[ ! -x $i ]]; then\n    echo \"FAIL\"\n    echo \"$i is called in udev rules but is not executable or does not exist\"\n    exit 1\n  fi\ndone\necho \"OK\"\n\nfilesToFixup=\"$(for i in \"$out\"/*; do\n  # list all files referring to (/usr)/bin paths, but allow references to /bin/sh.\n  grep -P -l '\\B(?!\\/bin\\/sh\\b)(\\/usr)?\\/bin(?:\\/.*)?' \"$i\" || :\ndone)\"\n\nif [ -n \"$filesToFixup\" ]; then\n  echo \"Consider fixing the following udev rules:\"\n  echo \"$filesToFixup\" | while read localFile; do\n    remoteFile=\"origin unknown\"\n    for i in /nix/store/xqnpbmfzsxxlxfyf1kqwvk2bnnwxkp73-ipv6-privacy-extensions.rules /nix/store/0kkby9818c90nkahlcjkrrqzdrj0h9ik-ipv6-privacy-extensions.rules /nix/store/gnx0alh2mrc2ndjs7ik6jm3w7avld56w-lvm2-2.03.39 /nix/store/xp99bvc5brkxdl13y1i99ih4ia9w6q7h-bcache-tools-1.1 /nix/store/a29al91pwhj3028nz4lc08fl2gndq3qh-extra-udev-rules /nix/store/zl3wfq23cjhqwdggqfn173qr20xp1zlx-extra-hwdb-file; do\n      for j in \"$i\"/*/udev/rules.d/*; do\n        [ -e \"$out/$(basename \"$j\")\" ] || continue\n        [ \"$(basename \"$j\")\" = \"$(basename \"$localFile\")\" ] || continue\n        remoteFile=\"originally from $j\"\n        break 2\n      done\n    done\n    refs=\"$(\n      grep -o '\\B\\(/usr\\)\\?/s\\?bin/[^ \"]\\+' \"$localFile\" \\\n        | sed -e ':r;N;${s/\\n/ and /;br};s/\\n/, /g;br'\n    )\"\n    echo \"$localFile ($remoteFile) contains references to $refs.\"\n  done\n  exit 1\nfi\n\n# Verify all the udev rules\necho \"Verifying udev rules using udevadm verify...\"\nudevadm verify --resolve-names=late --no-style $out\necho \"OK\"\n\n# If auto-configuration is disabled, then remove\n# udev's 80-drivers.rules file, which contains rules for\n# automatically calling modprobe.\n\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"udev-rules","nativeBuildInputs":"/nix/store/ccvdybwln7cvwa10xsjjqsml004xja8m-systemd-minimal-260.2","out":"/nix/sto