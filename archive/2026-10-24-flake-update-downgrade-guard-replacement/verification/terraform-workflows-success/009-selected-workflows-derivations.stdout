ppxglpkdv894r6x9ipgilsbvl7v7s3p-rabbitmqcfg-1.0/bin/rabbitmqcfg\n\n$rabbitmqcfg setup --vhost vpsadmin_test --execute admin:testRabbitmqAdminPassword\n\n$rabbitmqcfg user --vhost vpsadmin_test --create --perms --execute api api:testRabbitmqApiPassword\n$rabbitmqcfg user --vhost vpsadmin_test --create --perms --execute console console:testRabbitmqConsolePassword\n$rabbitmqcfg user --vhost vpsadmin_test --create --perms --execute supervisor supervisor:testRabbitmqSupervisorPassword\nfor node_user in vpsadmin-node1.lab vpsadmin-mailer.lab; do\n  $rabbitmqcfg user --vhost vpsadmin_test --create --perms --execute node ${node_user}:testRabbitmqNodePassword\ndone\n\n\n$rabbitmqcfg policies --vhost vpsadmin_test --execute\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"rx9lwyfz3k0a57jgf7pr59279ihkqgp9-rabbitmqcfg-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"vqn9gw6ja6jwypif4hpcy9ygjnzzbg94-bash-interactive-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"rabbitmq-setup.sh","outputs":{"out":{"path":"xq8lrq1nmyndazw1ninqr6pjpm479khm-rabbitmq-setup.sh"}},"system":"x86_64-linux","version":4},"53nhh0wllq2dz8gn4p0qcbbgn4b78ax9-hedgehog-1.5.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"LANG":"en_US.UTF-8","LOCALE_ARCHIVE":"/nix/store/d7w71nlhh7l9y619kcxsm2f0c65ynwfp-glibc-locales-2.42-67/lib/locale/locale-archive","__structuredAttrs":"","buildFlags":"","buildInputs":"  /nix/store/67g98ljq811g64i4mshdrcbv5p6gn8vb-mmorph-1.2.2  /nix/store/rcsk2yf1s09ih9lwcv2vcfbvpcf6rd6q-pretty-show-1.10  ","buildPhase":"runHook preB