kg9hb4l679m7bh5pk3rvjdz8-libxslt-1.1.45-dev /nix/store/1w7v3swilqby67bfd6z90dch8rfxg3nn-gi-docgen-2026.1 /nix/store/9zzh2r7alv6pz789jy0p7dyjkjian99k-gobject-introspection-wrapped-1.86.0-dev /nix/store/aqw91m0av4jz6ixm727ysjd4g6600x65-systemtap-5.4 /nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/wpwksxna2lp2y0px8xnxwgs0rfary570-glib-2.88.3","outputs":"bin out dev devdoc debug","patches":"/nix/store/1741v6rlizzg8k41myx7jk53rwa24b2m-glib-appinfo-watch.patch /nix/store/xmaba5a6w625vcyk9iaf44vzz8mnydk7-schema-override-variable.patch /nix/store/d8pkc3xxx3arcvdid48vh8imx9q9g4vq-elementary-terminal-support.patch /nix/store/0s51jr07rjwls4bwwb7mrpzikc2ax15m-split-dev-programs.patch /nix/store/abzy833a3cyracjdj47qxkx26r7lw2sg-gdb_script.patch","pname":"glib","postCheck":"rm $out/lib/libgobject-2.0.so.0\nrm $out/lib/libgio-2.0.so.0\nrm $out/lib/libglib-2.0.so.0\n","postConfigure":"patchShebangs gio/gdbus-2.0/codegen/gdbus-codegen gobject/glib-{genmarshal,mkenums}\n","postFixup":"for i in $dev/bin/*; do\n  moveToOutput \"share/man/man1/${i##*/}.1.*\" \"$dev\"\ndone\n\n# Cannot be in postInstall, otherwise _multioutDocs hook in preFixup will move right back.\nmoveToOutput \"share/doc\" \"$devdoc\"\n","postInstall":"moveToOutput \"share/glib-2.0\" \"$dev\"\nmoveToOutput \"share/glib-2.0/gdb\" \"$out\"\nsubstituteInPlace \"$dev/bin/gdbus-codegen\" --replace \"$out\" \"$dev\"\nsed -i \"$dev/bin/glib-gettextize\" -e \"s|^gettext_dir=.*|gettext_dir=$dev/share/glib-2.0/gettext|\"\n\n# This file is *included* in gtk3 and would introduce runtime reference via __FILE__.\nsed '1i#line 1 \"glib-2.88.3/include/glib-2.0/gobject/gobjectnotifyqueue.c\"' \\\n  -i \"$dev\"/include/glib-2.0/gobject/gobjectnotifyqueue.c\nfor i in $bin/bin/*; do\n  moveToOutput \"share/bash-completion/completions/${i##*/}\" \"$bin\"\ndone\nfor i in $dev/bin/*; do\n  moveToOutput \"share/bash-completion/completions/${i##*/}\" \"$dev\"\ndone\n","postPatch":"patchShebangs glib/gen-unicode-tables.pl\npatchShebangs glib/tests/gen-casefold-txt.py\npatchShebangs glib/tests/gen-casemap-txt.py\npatchShebangs tools/gen-visibility-macros.py\npatchShebangs tests\n\n# Needs machine-id, comment the test\nsed -e '/\\/gdbus\\/codegen-peer-to-peer/ s/^\\/*/\\/\\//' -i gio/tests/gdbus-peer.c\nsed -e '/g_test_add_func/ s/^\\/*/\\/\\//' -i gio/tests/gdbus-address-get-session.c\n# All gschemas fail to pass the test, upstream bug?\nsed -e '/g_test_add_data_func/ s/^\\/*/\\/\\//' -i gio/tests/gschema-compile.c\n# Cannot reproduce the failing test_associations on hydra\nsed -e '/\\/appinfo\\/associations/d' -i gio/tests/appinfo.c\n# Needed because of libtool wrappers\nsed -e '/g_subprocess_launcher_set_environ (launcher, envp);/a g_subprocess_launcher_setenv (launcher, \"PATH\", g_getenv(\"PATH\"), TRUE);' -i gio/tests/gsubprocess.c\n","preCheck":"","preFixup":"buildPythonPath /nix/store/gh4a48gkixnmfi8vz11adb6pmxdcx3f0-python3.13-packaging-26.1\npatchPythonScript \"$dev/share/glib-2.0/codegen/utils.py\"\n","propagatedBuildInputs":"/nix/store/0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev /nix/store/sisn3jbz4mnmp02llc5sn60p80di1asm-libffi-3.8.0-dev /nix/store/db8cwzsgxv3lijvf18kqvjjbylm5hrpi-gettext-1.0 /nix/store/n3glfh8a03w0nvhnp9grivvvvbifhc0c-glibc-iconv-2.42","propagatedNativeBuildInputs":"","separateDebugInfo":"1","setupHook":"/nix/store/qgfij9cxhp7gfjk6hs43hzy4n3w9am3c-setup-hook.sh","src":"/nix/store/4298knw9zvdfz2mg7xizhzdvcq4gl8sr-glib-2.88.3.tar.xz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.88.3"},"inputs":{"drvs":{"03wrqbr1ivb7w5r9qkmlkf09z7fxdv5v-glib-2.88.3.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"14zk1gx48hdbn98gq6w190hrw435lr46-systemtap-5.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"5h5ajs0iwjfa4qvnar9wm03cnyaaa7ql-libselinux-3.10.drv":{"dynamicOutputs":{},"outputs":["dev"]},"5z8sj1169xaps07s9yw780fvznwn8yqy-pkg-config-wrapper-0.29.2.drv":{"dynamicOutp