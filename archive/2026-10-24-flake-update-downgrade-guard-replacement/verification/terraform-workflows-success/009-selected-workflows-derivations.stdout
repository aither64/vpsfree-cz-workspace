re\nactualModDirVersion=\"$(cat $buildRoot/include/config/kernel.release)\"\nif [ \"$actualModDirVersion\" != \"6.12.95\" ]; then\n  echo \"Error: modDirVersion 6.12.95 specified in the Nix expression is wrong, it should be: $actualModDirVersion\"\n  exit 1\nfi\n\n# Note: we can get rid of this once http://permalink.gmane.org/gmane.linux.kbuild.devel/13800 is merged.\nbuildFlagsArray+=(\"KBUILD_BUILD_TIMESTAMP=$(date -u -d @$SOURCE_DATE_EPOCH)\")\n\ncd $buildRoot\n","depsBuildBuild":"/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/38cj6n97fw51nnpwbqxc2jip146rwdhz-linux-6.12.95-dev","doCheck":"","doInstallCheck":"","dontCheckForBrokenSymlinks":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"bindnow format fortify stackprotector pic","installFlags":"INSTALLKERNEL=/nix/store/qcxf86qmw3p7zfb7hj0a6fm64yldga4s-installkernel INSTALL_PATH=$(out) INSTALL_MOD_PATH=$(out)","installTargets":"install","karch":"x86_64","makeFlags":"O=$(buildRoot) CC=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/cc HOSTCC=/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0/bin/cc ARCH=x86_64","mesonFlags":"","name":"linux-6.12.95","nativeBuildInputs":"/nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0 /nix/store/rj77c0f0074y6f5v38y3awhh0jafnnjy-bc-1.08.2 /nix/store/11r9b7xwm6gz7af0cj6d6gbvnipg1hg1-net-tools-2.10 /nix/store/6snylzb0haf89m5xwkc7x9vvinkcmj41-openssl-3.6.3-dev /nix/store/j310a1j772b3lszjmxps00704nayqj4f-rsync-3.4.4 /nix/store/qbblni4f828ligb5wlls2nmhvamr6sf3-gmp-with-cxx-6.3.0-dev /nix/store/f0a4hywr1hjw241wgcgdi4wmhfv66jrg-libmpc-1.4.0 /nix/store/d06f6w98w240srb893aqnzpfqjs3pmhk-mpfr-4.2.2-dev /nix/store/m7wg7cj2vw3n6a0pcl3fzbqfm0qsawmd-gawk-5.4.1 /nix/store/n0adwsx0sxhrfq6x32zm2is31xzhaf5y-zstd-1.5.7-dev /nix/store/yk1qqipjasb5mgjpq1vikmjf7aibbszn-python3-minimal-3.13.15 /nix/store/0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev /nix/store/4ggx0lbj307k4cvg207dhzk03mpc7ihb-pahole-1.31 /nix/store/47ibddl4z6rmhp517p1sas0qlapbb1zh-bison-3.8.2 /nix/store/y3ym52hvpsp1f8c8jd58rlhyj5yigibn-flex-2.6.4 /nix/store/sbflyyw5x1vplljcq58v0wmvr17hjbhc-cpio-2.15 /nix/store/xlinf0nnl6k0fhhlxn7j3zpcdc518jv3-elfutils-0.194-dev /nix/store/2icxjkhwrcxicpd1av6li93cnsraicil-kmod-31-dev","out":"/nix/store/kcff40cambzapqkp53g19fbsiy6wvfr5-linux-6.12.95","outputs":"out dev","patches":"/nix/store/mnlqwys9dxznjcvq4w3s0435s9ql8qv8-bridge-stp-helper.patch /nix/store/23728y7zgh1jb55kpwxv5qnjbq0ykca6-randstruct-provide-seed-5.19.patch","pname":"linux","postInstall":"mkdir -p $dev\ncp vmlinux $dev/\nif [ -z \"${dontStrip-}\" ]; then\n  installFlagsArray+=(\"INSTALL_MOD_STRIP=1\")\nfi\nmake modules_install $makeFlags \"${makeFlagsArray[@]}\" \\\n  $installFlags \"${installFlagsArray[@]}\"\nunlink $out/lib/modules/6.12.95/build\nrm -f $out/lib/modules/6.12.95/source\n\nmkdir -p $dev/lib/modules/6.12.95/{build,source}\n\n# To save space, exclude a bunch of unneeded stuff when copying.\n(cd .. && rsync --archive --prune-empty-dirs \\\n    --exclude='/build/' \\\n    * $dev/lib/modules/6.12.95/source/)\n\ncd $dev/lib/modules/6.12.95/source\n\ncp $buildRoot/{.config,Module.symvers} $dev/lib/modules/6.12.95/build\nmake modules_prepare $makeFlags \"${makeFlagsArray[@]}\" O=$dev/lib/modules/6.12.95/build\n\n# For reproducibility, removes accidental leftovers from a `cc1` call\n# from a `try-run` call from the Makefile\nrm -f $dev/lib/modules/6.12.95/build/.[0-9]*.d\n\n# Keep some extra files on some arches (powerpc, aarch64)\nfor f in arch/powerpc/lib/crtsavres.o arch/arm64/kernel/ftrace-mod.o; do\n  if [ -f \"$buildRoot/$f\" ]; then\n    cp $buildRoot/$f $dev/lib/modules/6.12.95/build/$f\n  fi\ndone\n\n# !!! No documentation on how much of the source tree must be kept\n# If/when kernel builds fail due to missing files, you can add\n# them here. Note that we may see packages requiring headers\n# from drivers/ in the future; it adds 50M to keep all of its\n# headers on 3.10 though.\n\nchmod u+w -R ..\narch=$(cd $dev/lib/modules/6.12.95/build/arch; ls)\n\n# Remove unused arches\nfor d in $(cd arch/; ls); do\n  if [ \"$d\" = \"$arch\" ]; then continue; fi\n  if [ \"$arch\" = arm64 ] && [ \"$d\" = arm ]; then continue; fi\n  rm -rf arch/$d\ndone\n\n# Remove all driver-specific code (50M of which is headers)\nrm -fR drivers\n\n# Keep all headers\nfind .  -type f -name '*.h' -print0 | xargs -0 -r chmod u-w\n\n# Keep linker scripts (they are required for out-of-tree modules on aarch64)\nfind .  -type f -name '*.lds' -print0 | xargs -0 -r chmod u-w\n\n# Keep root and arch-specific Makefiles\nchmod u-w Makefile\nchmod u-w arch/$arch/Makefile*\n\n# Keep whole scripts dir\nchmod u-w -R scripts\n\n# Delete everything not kept\nfind . -type f -perm -u=w -print0 | xargs -0 -r rm\n\n# Delete empty directories\nfind -empty -type d -delete\n\n# Remove reference to kmod\nsed -i Makefile -e 's|= /nix/store/ahni4ky7vcyga5rkfk6yil6g0293qyvk-kmod-31/bin/depmod|= depmod|'\n","postPatch":"sed -i Makefile -e 's|= depmod|= /nix/store/ahni4ky7vcyga5rkfk6yil6g0293qyvk-kmod-31/bin/depmod|'\n\n# Set randstruct seed to a deterministic but diversified value. Note:\n# we could have instead patched gen-random-seed.sh to take input from\n# the buildFlags, but that would require also patching the kernel's\n# toplevel Makefile to add a variable export. This would be likely to\n# cause future patch conflicts.\nif [ -f scripts/gcc-plugins/gen-random-seed.sh ]; then\n  substituteInPlace scripts/gcc-plugins/gen-random-seed.sh \\\n    --replace NIXOS_RANDSTRUCT_SEED \\\n    $(echo /nix/store/4jcdch0myxf11872ncmp4cgh91mg546r-a2384967b90f24d2470c9eb15f0e66d938df7e08.tar.gz /nix/store/3rbwfxkyxac71d2hi820s4lswfn9a97i-linux-config-6.12.95 | sha256sum | cut -d ' ' -f 1 | tr -d '\\n')\nfi\n\npatchShebangs scripts\n\n# also patch arch-specific install scripts\nfor i in $(find arch -name install.sh); do\n    patchShebangs \"$i\"\ndone\n","preInstall":"installFlagsArray+=(\"-j$NIX_BUILD_CORES\")\n","prePatch":"echo \"Copying ZFS builtin package...\"\ncp -r /nix/store/zg1w24p5s0mfcfqwqj4wqj0mg4jbw83h-zfs-builtin-2.3-vpsadminos-6.12.95 ./zfsBuiltin\nchmod -R u+w ./zfsBuiltin\npushd ./zfsBuiltin\n./copy-builtin ..\npopd\nfor mf in $(find -name Makefile -o -name Makefile.include -o -name install.sh); do\n    echo \"stripping FHS paths in \\`$mf'...\"\n    sed -i \"$mf\" -e 's|/usr/bin/||g ; s|/bin/||g ; s|/sbin/||g'\ndone\n\n# Don't include a (random) NT_GNU_BUILD_ID, to make the build more deterministic.\n# This way kernels can be bit-by-bit reproducible depending on settings\n# (e.g. MODULE_SIG and SECURITY_LOCKDOWN_LSM need to be disabled).\n# See also https://kernelnewbies.org/BuildId\nsed -i Makefile -e 's|--build-id|--build-id=none|'\n\npatchShebangs scripts/ld-version.sh\n\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","requiredSystemFeatures":"big-parallel","src":"/nix/store/4jcdch0myxf11872ncmp4cgh91mg546r-a2384967b90f24d2470c9eb15f0e66d938df7e08.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"6.12.95"},"inputs":{"drvs":{"0qvz0cszjrqhlmqh68minlnk7wy0anln-bc-1.08.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"0zzhd80bvdva53lqam8d09zjm4grc0xv-net-tools-2.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"2757jjsm9afpx810y3vkzckfvniin27l-python3-minimal-3.13.15.drv":{"dynamicOutputs":{},"outputs":["out"]},"3bkl4yqj9z2vyd4ginlzfh6cv8x8997j-flex-2.6.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"5p0skjjaf87w4s1m9d28rxcfa3rgh9ca-zfs-builtin-2.3-vpsadminos-6.12.95.drv":{"dynamicOutputs":{},"outputs":["out"]},"6g4jg3zvx41c3kv71gia2j9hs8lyh48h-elfutils-0.194.drv":{"dynamicOutputs":{},"outputs":["dev"]},"76z1f4wh1qchqchyna9h10vsrdzadcsb-libmpc-1.4.0.drv":{"