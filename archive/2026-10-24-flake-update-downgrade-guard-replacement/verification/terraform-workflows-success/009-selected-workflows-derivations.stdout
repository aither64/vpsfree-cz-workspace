","buildCommand":"mkdir -p $out\n\n# Copy the upstream systemd units we're interested in.\nfor i in app.slice background.slice basic.target bluetooth.target capsule@.target default.target exit.target graphical-session-pre.target graphical-session.target paths.target printer.target session.slice shutdown.target smartcard.target sockets.target sound.target systemd-exit.service timers.target xdg-desktop-autostart.target systemd-tmpfiles-clean.service systemd-tmpfiles-clean.timer systemd-tmpfiles-setup.service; do\n  fn=/nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/example/systemd/user/$i\n  if ! [ -e $fn ]; then echo \"missing $fn\"; false; fi\n  if [ -L $fn ]; then\n    target=\"$(readlink \"$fn\")\"\n    if [ ${target:0:3} = ../ ]; then\n      ln -s \"$(readlink -f \"$fn\")\" $out/\n    else\n      cp -pd $fn $out/\n    fi\n  else\n    ln -s $fn $out/\n  fi\ndone\n\n# Copy .wants links, but only those that point to units that\n# we're interested in.\nfor i in ; do\n  fn=/nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/example/systemd/user/$i\n  if ! [ -e $fn ]; then echo \"missing $fn\"; false; fi\n  x=$out/$(basename $fn)\n  mkdir $x\n  for i in $fn/*; do\n    y=$x/$(basename $i)\n    cp -pd $i $y\n    if ! [ -e $y ]; then rm $y; fi\n  done\ndone\n\n# Symlink all units provided listed in systemd.packages.\npackages=\"/nix/store/gnx0alh2mrc2ndjs7ik6jm3w7avld56w-lvm2-2.03.39 /nix/store/phdp59im6jvacsm7xcfv8ayd4s6ljk21-nix-2.34.8 /nix/store/xr9mx11i6gary2gbxnkfbxrdd0nfi4bx-dbus-1.16.2 /nix/store/52k47shyn682b1blwrryiha1inib69gq-dbus-broker-37 /nix/store/4n075ll5jdwbjv142yg8ymz5f3yf4pam-util-linux-2.42.2-bin /nix/store/9bls42pnwrggsa8qjaqndnm3j9bxg6lw-util-linux-2.42.2-lastlog\"\n\n# Filter duplicate directories\ndeclare -A unique_packages\nfor k in $packages ; do unique_packages[$k]=1 ; done\n\nfor i in ${!unique_packages[@]}; do\n  for fn in $i/etc/systemd/user/* $i/lib/systemd/user/*; do\n    if ! [[ \"$fn\" =~ .wants$ ]]; then\n      if [[ -d \"$fn\" ]]; then\n        targetDir=\"$out/$(basename \"$fn\")\"\n        mkdir -p \"$targetDir\"\n        /nix/store/sa95zr548fwpkdp35a56nla83wwh44ss-lndir-1.0.5/bin/lndir \"$fn\" \"$targetDir\"\n      else\n        ln -s $fn $out/\n      fi\n    fi\n  done\ndone\n\n# Symlink units defined by systemd.units where override strategy\n# shall be automatically detected. If these are also provided by\n# systemd or systemd.packages, then add them as\n# <unit-name>.d/overrides.conf, which makes them extend the\n# upstream unit.\nfor i in /nix/store/vaqpjcsgr7dxxrb98l39nwraf9ddvmcz-unit-dbus-broker.service /nix/store/gb7mprj2qngw0r8c2ldfp79ff0k372xg-unit-dbus.service /nix/store/plylhh9h24gihpqjm8xy3n92rw7nfrk1-unit-dbus.socket /nix/store/8hzq909n1rll8scfr59kci7j4c6lf83h-unit-nixos-activation.service /nix/store/wbdzv9643z2nca5ilnzswzkklzg8bcp0-unit-nixos-fake-graphical-session.target /nix/store/711ms178raiy817p9sxs8yjjkrxvgn38-unit-systemd-tmpfiles-clean.timer /nix/store/zjpakh88imzjbqc072rddjnl2bfc6dps-unit-systemd-tmpfiles-setup.service; do\n  fn=$(basename $i/*)\n  if [ -e $out/$fn ]; then\n    if [ \"$(readlink -f $i/$fn)\" = /dev/null ]; then\n      ln -sfn /dev/null $out/$fn\n    else\n      mkdir -p $out/$fn.d\nln -s $i/$fn $out/$fn.d/overrides.conf\n\n    fi\n else\n    ln -fs $i/$fn $out/\n  fi\ndone\n\n# Symlink units defined by systemd.units which shall be\n# treated as drop-in file.\nfor i in ; do\n  fn=$(basename $i/*)\n  mkdir -p $out/$fn.d\n  ln -s $i/$fn $out/$fn.d/overrides.conf\ndone\n\n# Create service aliases from aliases option.\nln -sfn 'dbus-broker.service' $out/'dbus.service'\n\n\n# Create .wants, .upholds and .requires symlinks from the wantedBy, upheldBy and\n# requiredBy options.\nmkdir -p $out/'sockets.target.wants'\nln -sfn '../dbus.socket' $out/'sockets.target.wants'/\nmkdir -p $out/'default.target.wants'\nln -sfn '../nixos-activation.service' $out/'default.target.wants'/\nmkdir -p $out/'timers.target.wants'\nln -sfn '../systemd-tmpfiles-clean.timer' $out/'timers.target.wants'/\nmkdir -p $out/'basic.target.wants'\nln -sfn '../systemd-tmpfiles-setup.service' $out/'basic.target.wants'/\n\n\n\n\n\n\n\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"user-units","nativeBuildInputs":"","out":"/nix/store/dwnh9qh3qyxr64gwpac9dr86ag3rsxzy-user-units","outputs":"out","passAsFile":"buildCommand","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"1w8v3hljg2ryr0f3qrvgc5c4h7r305ql-nix-2.34.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"6vjh0b6mbvfyzacky1j23j24rgwy9236-unit-nixos-fake-graphical-session.target.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8587p58q5hapiv9hy9iayd5zwx46jky8-util-linux-2.42.2.drv":{"dynamicOutputs":{},"outputs":["bin","lastlog"]},"899gagmxab8xhknynh1vl3c502nbq0nc-systemd-260.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"cnby8l0sspfjr2fkgrmd54cpki853pav-dbus-1.16.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"iazp0llsf1072m0br5cxzng9c7a9w5r8-dbus-broker-37.drv":{"dynamicOutputs":{},"outputs":["out"]},"k20g54qgb87z5fpwypwgca0ma3rs86hc-unit-dbus.service.drv":{"dynamicOutputs":{},"outputs":["out"]},"kzk8n90v6976blrv0inji07w4j0w19l9-unit-dbus-broker.service.drv":{"dynamicOutputs":{},"outputs":["out"]},"mv0l97v8531cs5g50mikqi