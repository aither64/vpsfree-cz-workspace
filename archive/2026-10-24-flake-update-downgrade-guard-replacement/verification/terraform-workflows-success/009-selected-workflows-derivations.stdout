it\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"rspec-core rspec-expectations rspec-mocks","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"rspec","gemPath":"/nix/store/7mn640wrkip73zwh93r22yj1pisznkq7-ruby3.4-rspec-core-3.13.6 /nix/store/zbvi0m6r8n15sxppapzaqycvmj9sbpg9-ruby3.4-rspec-expectations-3.13.5 /nix/store/d2d84c5jdivh1parrgxzip748dxf70rv-ruby3.4-rspec-mocks-3.13.8","gemType":"gem","groups":"test","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-rspec-3.13.2","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/3hqp2gk3gflqv25vrzsy7w5dawwa4lxy-ruby3.4-rspec-3.13.2","outputs":"out","patches":"","pname":"rspec","propagatedBuildInputs":"/nix/store/7mn640wrkip73zwh93r22yj1pisznkq7-ruby3.4-rspec-core-3.13.6 /nix/store/zbvi0m6r8n15sxppapzaqycvmj9sbpg9-ruby3.4-rspec-expectations-3.13.5 /nix/store/d2d84c5jdivh1parrgxzip748dxf70rv-ruby3.4-rspec-mocks-3.13.8","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/7mn640wrkip73zwh93r22yj1pisznkq7-ruby3.4-rspec-core-3.13.6 /nix/store/zbvi0m6r8n15sxppapzaqycvmj9sbpg9-ruby3.4-rspec-expectations-3.13.5 /nix/store/d2d84c5jdivh1parrgxzip748dxf70rv-ruby3.4-rspec-mocks-3.13.8","ruby":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9","src":"/nix/store/fh0kg6c3ah9b2qghiy5hd2wyih5ms7gs-rspec-3.13.2.gem","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"3.13.2","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"3.13.2"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"83hx54d0fvirgxsik9b92hmhxlriql0f-rspec-3.13.2.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"8gj1wx3jvd7kizmh5dr4q7xlmgs1m6m1-ruby3.4-rspec-expectations-3.13.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"9ggh9px1h9rivn2nlar3v3falrqdhyzj-ruby3.4-rspec-core-3.13.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"qvsrqb1610ji1k8lampla89za6k82f4j-ruby3.4-rspec-mocks-3.13.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"xshd860gif707cn5krzl14260ash8c02-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"y898s2ajfd6ag157gc7gwa1z5vcbil9m-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-rspec-3.13.2","outputs":{"out":{"path":"3hqp2gk3gflqv25vrzsy7w5dawwa4lxy-ruby3.4-rspec-3.13.2"}},"system":"x86_64-linux","version":4},"v5g557filmaiipf5vs2g154zss6sh7qf-witherable-0.5.tar.gz.drv":{"ar