emspec=\"$(find . -name '*.gemspec')\"\n    echo \"found the following gemspecs:\"\n    echo \"$gemspec\"\n    gemspec=\"$(echo \"$gemspec\" | head -n1)\"\n  fi\n\n  exec 3>&1\n  output=\"$(gem build $gemspec | tee >(cat - >&3))\"\n  exec 3>&-\n\n  gempkg=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"base64","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"jwt","gemPath":"/nix/store/qrdhlx9bav6vck5kgikifnk5wckxx841-ruby3.4-base64-0.3.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-jwt-3.3.0","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/wcd36cgmga4pi234kc1aaapd1873nag5-ruby3.4-jwt-3.3.0","outputs":"out","patches":"","pname":"jwt","propagatedBuildInputs":"/nix/store/qrdhlx9bav6vck5kgikifnk5wckxx841-ruby3.4-base64-0.3.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/qrdhlx9bav6vck5kgikifnk5wckxx841-ruby3.4-base64-0.3.0","ruby":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9","src":"/nix/store/pqgf63a2p94wm6ykbycmb1amji27mx85-jwt-3.3.0.gem","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"3.3.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"3.3.0"},"inputs":{"drvs":{"64x7hxpswxzh8fh2nakv6gzrw1i47jy6-jwt-3.3.0.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"aim3z9kd8pkrl7m1c414vk1c53niqimc-ruby3.4-base64-0.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"xshd860gif707cn5krzl14260ash8c02-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"y898s2ajfd6ag157gc7gwa1z5vcbil9m-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-jwt-3.3.0","outputs":{"out":{"path":"wcd36cgmga4pi234kc1aaapd1873nag5-ruby3.4-jwt-3.3.0"}},"system":"x86_64-linux","version":4},"8k2wg45qs8blks6xa8pb1jwr97181c86-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/zahi64rakp05qrmp37kg3zh9gx2hgc2v-source"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"7