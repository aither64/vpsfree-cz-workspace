ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowSubstitutes":"","buildCommand":"target=$out$destination\nmkdir -p \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"sv-pool-tank-run","nativeBuildInputs":"","out":"/nix/store/z7kd8m9sk6h2rpjimyfp9g5hs057096y-sv-pool-tank-run","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#!/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash\nmkdir -p \"/run/runit/cgroup.service/pool-tank\"\necho $$ >> \"/run/runit/cgroup.service/pool-tank/cgroup.procs\"\nexec 2>&1\nsource ./helpers\n\n\npoolReady() {\n  pool=\"$1\"\n  guid=\"$2\"\n\n  if [[ \"$guid\" = \"\" ]] ; then\n    state=\"$(/nix/store/5g49q71nd4x3s8yf8z1ig3kjfbbyfamx-check-zpool.rb -d \"/dev/disk/by-id\" \"$pool\")\"\n  else\n    state=\"$(/nix/store/5g49q71nd4x3s8yf8z1ig3kjfbbyfamx-check-zpool.rb -d \"/dev/disk/by-id\" \"$pool\" \"$guid\")\"\n  fi\n  if [[ \"$state\" = \"ONLINE\" ]]; then\n    return 0\n  else\n    echo \"Pool $pool in state $state, waiting\"\n    return 1\n  fi\n}\npoolImported() {\n  pool=\"$1\"\n  zpool list \"$pool\" >/dev/null 2>/dev/null\n}\npoolImport() {\n  pool=\"$1\"\n  zpool import -d \"/dev/disk/by-id\" -N $ZFS_FORCE \"$pool\"\n}\n\n\n# Loop across the import until it succeeds, because the devices needed may\n# not be discovered yet.\nif poolImported \"tank\"; then\n  echo \"Pool tank already imported\"\nelse\n  importName=\"tank\"\n  for trial in `seq 1 3`; do\n    echo \"Checking status of pool tank\"\n\n    if poolReady \"tank\" \"\" > /dev/null ; then\n      echo \"Attempting to import pool tank \"\n      msg=\"$(poolImport \"$importName\" 2>&1)\"\n      isImported=$?\n\n      if [ $isImported == 0 ] ; then\n        echo \"Pool tank imported\"\n        break\n      else\n        echo \"Unable to import pool tank: $msg\"\n      fi\n    else\n      echo \"Waiting for devices...\"\n    fi\n\n    sleep 1\n  done\n\n  if ! poolImported \"tank\" ; then\n    echo \"All attempts to cleanly import pool tank have failed\"\n    echo \"Importing a possibly degraded pool in 10s\"\n    sleep 10\n    poolImport \"$importName\"\n  fi\n\n  if ! poolImported \"tank\" ; then\n    /nix/store/a8d6azdbd1wlw51fm6vyqwffkhh0w3dy-do-create-pool-tank/bin/do-create-pool-tank --force \\\n|| fail \"Unable to create pool tank\"\n\n  fi\nfi\n\nstat=\"$( zpool status tank )\"\ntest $? && echo \"$stat\" | grep DEGRADED &> /dev/null && \\\n  echo -e \"Pool tank is DEGRADED!\"\n\necho \"Configuring pool tank\"\nzpool set \"feature@block_cloning=disabled\" tank\n\n\necho \"Mounting datasets...\"\n/nix/store/m77m5waghcgrg7cfbrxhspm4b2j19wz8-mount.rb tank /nix/store/5h0h5071s107f362026dbzapw669mp24-pool-tank-datasets.json\n\nactive=$(zfs get -Hp -o value org.vpsadminos.osctl:active tank)\n\necho \"Waiting for osctld...\"\nwaitForOsctld\n\nif [ \"$(getKernelParam osctl.pools 1)\" == \"1\" ] ; then\n  if [ \"$active\" == \"yes\" ] ; then\n    if  ! osctlEntityExists pool tank ; then\n      echo \"Importing pool tank into osctld\"\n      osctl pool import \\\n        $(if [ \"$(getKernelParam osctl.autostart 1)\" == \"1\" ] ; then echo \"--autostart\" ; else echo \"--no-autostart\" ; fi) \\\n        tank \\\n        || fail \"Unable to import pool tank into osctld\"\n    fi\n\n  elif true ; then\n    echo \"Installing pool tank into osctld\"\n    osctl pool install tank \\\n      || fail \"Unable to install pool tank into osctld\"\n  fi\n\n  \nelse\n  echo \"Pool install/import disabled by kernel parameter\"\nfi\n\necho \"Updating vdevlog\"\nvdevlog \\\n  update tank \\\n  -i /run/metrics\n\n\necho \"Set config.services.nfs.server.enable = true to enable filesystem sharing\"\n\n\necho \"Service pool-tank successfully finished\"\nmkdir -p /run/service/pool-tank\ntouch /run/service/pool-tank/done\nsv once pool-tank\n\n\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"9n1vxjxdvbqp0i8vnfb5ybdqlzzz035b-pool-tank-datasets.json.drv":{"dynamicOutputs":{},"outputs":["out"]},"bnm02787w0kk7ay0z4k9j3wnk486iwdx-check-zpool.rb.drv":{"dynamicOutputs":{},"outputs":["out"]},"kn47r5qn9qkc4as08yzqrmqr9577dd59-mount.rb.drv":{"dynamicOutputs":{},"outputs":["out"]},"zbsbfffmxxp50903mcj3gfrvlp7cvz4j-do-create-pool-tank.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"sv-pool-tank-run","outputs":{"out":{"path":"z7kd8m9sk6h2rpjimyfp9g5hs057096y-sv-pool-tank-run"}},"system":"x86_64-linux","version":4},"0aswbx5zf9x3j6asm03xxr7d9l73gg0h-url-2.5.7.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildCommand":"mkdir $out\ntar xf \"/nix/store/ld8sh9a6m9fif9i9sr1qvy21kdq7c944-crate-url-2.5.7.tar.gz\" -C $out --strip-components=1\n\n# Cargo is happy with 