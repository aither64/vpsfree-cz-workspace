in/api/config/$(basename $v)\"\ndone\n\nrm -f \"/var/lib/vpsadmin/api/config/deployment.json\"\ncp -f /nix/store/8q5r2af6imy7cnzspr3cd27p3rz2ncf6-deployment.json \"/var/lib/vpsadmin/api/config/deployment.json\"\nchmod 440 \"/var/lib/vpsadmin/api/config/deployment.json\"\n\n# Link in enabled plugins\nfor plugin in monitoring newslog outage_reports payments requests webui; do\n  ln -sf \"/nix/store/kg2wgqpnimhlc3q3l0c33axpbzp73w3z-vpsadmin-api-unknown/plugins/$plugin\" \"/var/lib/vpsadmin/api/plugins/$plugin\"\ndone\n\n# Handle database.passwordFile & permissions\nDBPASS=$(head -n1 /etc/vpsadmin-test/mariadb-api-password)\ndatabaseYmlTmp=\"$(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/mktemp \"/var/lib/vpsadmin/api/config/.database.yml.XXXXXX\")\"\ntrap '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/rm -f \"$databaseYmlTmp\"' EXIT\nsed -e \"s,#dbpass#,$DBPASS,g\" /nix/store/yi74sixinw7ja1a0bmy83p9q0w96mgzw-database.yml >\"$databaseYmlTmp\"\nchmod 440 \"$databaseYmlTmp\"\nmv -f \"$databaseYmlTmp\" \"/var/lib/vpsadmin/api/config/database.yml\"\ntrap - EXIT\n\n\n\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"92p3r878k9g4bl165dssn6chbp4d9z07-deployment.json.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"xfdvb3ay2wnwwp7cn3rr6zk390c1v0iz-database.yml.drv":{"dynamicOutputs":{},"outputs":["out"]},"zfdbhy08qrm5scrm4a3qh8j6n2dw58i1-vpsadmin-api-unknown.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["b0kcn1kl2srccx8jn4nkl9ik1z9i1xrw-api","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"unit-script-vpsadmin-api-pre-start","outputs":{"out":{"path":"h4pqq9v1lbimyg2ayglznf98qpl0n57m-unit-script-vpsadmin-api-pre-start"}},"system