y in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-rest-client-2.1.0","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/35r3j4x2zxajmrqnqj5b4dckffqdg5zs-ruby3.4-rest-client-2.1.0","outputs":"out","patches":"","pname":"rest-client","propagatedBuildInputs":"/nix/store/5jqrgcgqk1lwqhh2y8blzzh0b9453xgy-ruby3.4-http-accept-1.7.0 /nix/store/29m0bskcfrr6hpy17yna3li7lp4wazvp-ruby3.4-http-cookie-1.1.6 /nix/store/6dn16mry4wy289k8c291j01mnsl15vi4-ruby3.4-mime-types-3.7.0 /nix/store/vky85ilwnyk706yvks2azlhj8ffwpwvv-ruby3.4-netrc-0.11.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/5jqrgcgqk1lwqhh2y8blzzh0b9453xgy-ruby3.4-http-accept-1.7.0 /nix/store/29m0bskcfrr6hpy17yna3li7lp4wazvp-ruby3.4-http-cookie-1.1.6 /nix/store/6dn16mry4wy289k8c291j01mnsl15vi4-ruby3.4-mime-types-3.7.0 /nix/store/vky85ilwnyk706yvks2azlhj8ffwpwvv-ruby3.4-netrc-0.11.0","ruby":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9","src":"/nix/store/9m7rh3jpnldr9fvwbzjyrddbz1d237ci-rest-client-2.1.0.gem","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"2.1.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"2.1.0"},"inputs":{"drvs":{"2w1xbclgjn6raiiwiy203mnjb7xdnyzk-ruby3.4-http-accept-1.7.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"hw6f4rx54rig5dnnsxnlj2s7lk7cpq30-ruby3.4-netrc-0.11.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"jwb11ql2ryb4dspdb5vrw1swjf20i8d2-ruby3.4-mime-types-3.7.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"nsimlx4zrnydynx6v0qjanhifsy1bv36-ruby3.4-http-cookie-1.1.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"xshd860gif707cn5krzl14260ash8c02-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"y898s2ajfd6ag157gc7gwa1z5vcbil9m-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"zdmw2l1md6jyy2v8lya86gq2hpdl5pg4-rest-client-2.1.0.gem.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-rest-client-2.1.0","outputs":{"out":{"path":"35r3j4x2zxajmrqnqj5b4dckffqdg5zs-ruby3.4-rest-client-2.1.0"}},"system":"x86_64-linux","version":4},"gs9mwc2r1p7hs6xrnqz5s36dsw3c9nqm-mescc-tools-extra-chmod-1.9.1.drv":{"args":["--verbose","--strict","--file","/nix/store/a5c6xhw0v2z1yn20c58n2nw5adjiqy40-build-chmod.kaem"],"builder":"/nix/store/0ql80hyg6dqs00x15fggfz7a0dhs7swq-kaem-unwrapped-1.9.1","env":{"M1":"/nix/store/40nlys32r8ra0qrab1b27igpm6skkvnw-M1-1.9.1","M2":"/nix/store/c933x2407ahyia5bd2z39109zsk2q2b7-M2-1.9.1","blood-elf-0":"/nix/store/pc7xsqqlrmd36wlnpikj