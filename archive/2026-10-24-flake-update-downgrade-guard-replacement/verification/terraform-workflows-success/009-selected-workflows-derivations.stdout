le)\"},\"services.stash.settings.stash_boxes.*.apikey\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"description\":\"Stash Box API key\",\"loc\":[\"services\",\"stash\",\"settings\",\"stash_boxes\",\"*\",\"apikey\"],\"readOnly\":false,\"type\":\"string\"},\"services.stash.settings.stash_boxes.*.endpoint\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"description\":\"URL to the Stash Box graphql api\",\"loc\":[\"services\",\"stash\",\"settings\",\"stash_boxes\",\"*\",\"endpoint\"],\"readOnly\":false,\"type\":\"string\"},\"services.stash.settings.stash_boxes.*.name\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"description\":\"The name of the Stash Box\",\"loc\":[\"services\",\"stash\",\"settings\",\"stash_boxes\",\"*\",\"name\"],\"readOnly\":false,\"type\":\"string\"},\"services.stash.settings.theme_color\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"#202b33\\\"\"},\"description\":\"Sets the `theme-color` property in the UI\",\"loc\":[\"services\",\"stash\",\"settings\",\"theme_color\"],\"readOnly\":false,\"type\":\"string\"},\"services.stash.settings.ui.frontPageContent\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"<function>\"},\"description\":\"Search filters to display on the front page.\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"presets: [\\n  # To get the savedFilterId, you can query `{ findSavedFilters(mode: <FilterMode>) { id name } }` on localhost:9999/graphql\\n  {\\n    __typename = \\\"SavedFilter\\\";\\n    savedFilterId = 1;\\n  }\\n  # basic custom filter\\n  {\\n    __typename = \\\"CustomFilter\\\";\\n    title = \\\"Random Scenes\\\";\\n    mode = \\\"SCENES\\\";\\n    sortBy = \\\"random\\\";\\n    direction = \\\"DESC\\\";\\n  }\\n  presets.recentlyAddedImages\\n]\\n\"},\"loc\":[\"services\",\"stash\",\"settings\",\"ui\",\"frontPageContent\"],\"readOnly\":false,\"type\":\"(list of (attribute set)) or function that evaluates to a(n) list of (attribute set)\"},\"services.stash.settings.video_file_naming_algorithm\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"OSHASH\\\"\"},\"description\":\"Hash algorithm to use for generated file naming\",\"loc\":[\"services\",\"stash\",\"settings\",\"video_file_naming_algorithm\"],\"readOnly\":false,\"type\":\"one of \\\"OSHASH\\\", \\\"MD5\\\"\"},\"services.stash.settings.write_image_thumbnails\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"true\"},\"description\":\"Write image thumbnails to disk when generating on the fly\",\"loc\":[\"services\",\"stash\",\"settings\",\"write_image_thumbnails\"],\"readOnly\":false,\"type\":\"boolean\"},\"services.stash.user\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"\\\"stash\\\"\"},\"description\":\"User under which Stash runs.\",\"loc\":[\"services\",\"stash\",\"user\"],\"readOnly\":false,\"type\":\"string\"},\"services.stash.username\":{\"declarations\":[\"nixos/modules/services/web-apps/stash.nix\"],\"default\":{\"_type\":\"literalExpression\",\"text\":\"null\"},\"description\":\"Username for login.\\n\\n::: {.warning}\\n  This option takes precedence over {option}`services.stash.settings.username`\\n::\\n\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"admin\\\"\"},\"loc\":[\"services\",\"stash\",\"username\"],\"readOnly\":false,\"type\":\"null or non-empty string\"},\"services.strichliste.domain\":{\"declarations\":[\"nixos/modules/services/web-apps/strichliste.nix\"],\"description\":\"Domain name used to configure the webserver virtual host.\\n\",\"example\":{\"_type\":\"literalExpression\",\"text\":\"\\\"strichliste.example.com\\\"\"},\"loc\"