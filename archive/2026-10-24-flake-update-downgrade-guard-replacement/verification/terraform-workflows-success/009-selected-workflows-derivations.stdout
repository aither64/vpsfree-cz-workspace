# https://bugs.busybox.net/show_bug.cgi?id=15934\nCONFIG_TC n\n\n# Set the path for the udhcpc script\nCONFIG_UDHCPC_DEFAULT_SCRIPT \"$out/default.script\"\n\n\nCONFIG_CROSS_COMPILER_PREFIX \"\"\n\nEOF\n\nmake oldconfig\n\nrunHook postConfigure\n","debug":"/nix/store/qm3bjz546j21hk2ni843kbfmkj7fjhf6-busybox-1.37.0-debug","depsBuildBuild":"/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"format","makeFlags":"SKIP_STRIP=y","mesonFlags":"","name":"busybox-1.37.0","nativeBuildInputs":"/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/d5x4mlpb0zzwmgzjzwljb0vaifvfy7r9-busybox-1.37.0","outputs":"out debug","patches":"/nix/store/7wpjbl21q85z0vrqdx4c7lxg6n4rgwh7-busybox-in-store.patch /nix/store/ix0srl7w9s21y5bnpp4q8gmg7jwvjynd-fix-aarch64-sha1.patch /nix/store/221bb8kxaxp50dprlgw4m9qll0x3djd4-CVE-2023-39810.patch /nix/store/7kidyfd8x0fn46y1610yqknjbh5rffib-CVE-2026-26157_CVE-2026-26158.patch /nix/store/ivhl0vw16larnp208maq278bhzspf4qm-CVE-2026-26157_CVE-2026-26158-2.patch /nix/store/569ibvaqi0fxpxc2xndsi6dvfnqkasgf-busybox-1.37-fix-syslogd.patch /nix/store/qcp6w5nlqy2m4l2xj8sa07q3fpj4riz5-build-system-buffer-overflow.patch /nix/store/2asd10s4bxhpz6ylwc52m7di7xb3kwia-CVE-2025-60876.patch","pname":"busybox","postConfigure":"","postInstall":"sed -e '\n1 a busybox() { '$out'/bin/busybox \"$@\"; }\\\nlogger() { '$out'/bin/logger \"$@\"; }\\\n' /nix/store/4wbq5vgb43mhxd4cdc7fzs6cdaq6pp00-source/debian/tree/udhcpc/etc/udhcpc/default.script > $out/default.script\nsed -i 's|/sbin/resolvconf|\"$(busybox which resolvconf)\"|g' $out/default.script\nchmod 555 $out/default.script\nHOST_PATH=$out/bin patchShebangs --host