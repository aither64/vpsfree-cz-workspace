them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-rack-session-2.1.2","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/09yr1i1fx1mss5mllr1xv1k7mqav2rbr-ruby3.4-rack-session-2.1.2","outputs":"out","patches":"","pname":"rack-session","propagatedBuildInputs":"/nix/store/qrdhlx9bav6vck5kgikifnk5wckxx841-ruby3.4-base64-0.3.0 /nix/store/4xvlx4l7xci38pyfz7jw87nv996bwy98-ruby3.4-rack-3.2.7","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/qrdhlx9bav6vck5kgikifnk5wckxx841-ruby3.4-base64-0.3.0 /nix/store/4xvlx4l7xci38pyfz7jw87nv996bwy98-ruby3.4-rack-3.2.7","ruby":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9","src":"/nix/store/nxsi1hn4p7pnfk146hm7q70c9nal6vzl-rack-session-2.1.2.gem","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"2.1.2","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"2.1.2"},"inputs":{"drvs