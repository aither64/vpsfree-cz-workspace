 \"$(dirname \"$target\")\"\n\nif [ -e \"$textPath\" ]; then\n  mv \"$textPath\" \"$target\"\nelse\n  printf \"%s\" \"$text\" > \"$target\"\nfi\n\nif [ -n \"$executable\" ]; then\n  chmod +x \"$target\"\nfi\n\neval \"$checkPhase\"\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","checkPhase":"","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"/bin/firewall-start","doCheck":"","doInstallCheck":"","executable":"1","mesonFlags":"","name":"firewall-start","nativeBuildInputs":"","out":"/nix/store/n292lh7lfaw5c41b7w982mdq1gly3iak-firewall-start","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"#! /nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash -e\nip46tables() {\n  iptables -w \"$@\"\n  ip6tables -w \"$@\"\n\n}\n\nip46tables_ignore() {\n  iptables -w \"$@\" 2>/dev/null || true\n  ip6tables -w \"$@\" 2>/dev/null || true\n\n}\n\nremove_notrack_rules() {\n  for chain in PREROUTING OUTPUT; do\n    while iptables -w -t raw -D \"$chain\" -m comment --comment nixos-fw-notrack -j CT --notrack 2>/dev/null; do :; done\n    while ip6tables -w -t raw -D \"$chain\" -m comment --comment nixos-fw-notrack -j CT --notrack 2>/dev/null; do :; done\n\n  done\n}\n\nadd_notrack_rules() {\n  remove_notrack_rules\n\n  iptables -w -t raw -I PREROUTING 1 -m comment --comment nixos-fw-notrack -j CT --notrack\n  iptables -w -t raw -I OUTPUT 1 -m comment --comment nixos-fw-notrack -j CT --notrack\n  ip6tables -w -t raw -I PREROUTING 1 -m comment --comment nixos-fw-notrack -j CT --notrack\nip6tables -w -t raw -I OUTPUT 1 -m comment --comment nixos-fw-notrack -j CT --notrack\n\n}\n\nflush_firewall_chains() {\n  ip46tables_ignore -D INPUT -j nixos-fw\n\n  for chain in nixos-fw nixos-fw-accept nixos-fw-log-refuse nixos-fw-refuse; do\n    ip46tables_ignore -F \"$chain\"\n    ip46tables_ignore -X \"$chain\"\n  done\n\n  ip46tables_ignore -t mangle -D PREROUTING -j nixos-fw-rpfilter\n  ip46tables_ignore -t mangle -F nixos-fw-rpfilter\n  ip46tables_ignore -t mangle -X nixos-fw-rpfilter\n}\n\nremove_drop_rule() {\n  ip46tables_ignore -D INPUT -j nixos-drop\n  ip46tables_ignore -F nixos-drop\n  ip46tables_ignore -X nixos-drop\n}\n\n\nflush_firewall_chains\nremove_notrack_rules\n\n\nip46tables -N nixos-fw-accept\nip46tables -A nixos-fw-accept -j ACCEPT\n\nip46tables -N nixos-fw-refuse\nip46tables -A nixos-fw-refuse -j DROP\n\n\nip46tables -N nixos-fw-log-refuse\n\n\nip46tables -A nixos-fw-log-refuse -m pkttype ! --pkt-type unicast -j nixos-fw-refuse\n\nip46tables -A nixos-fw-log-refuse -j nixos-fw-refuse\n\nip46tables -N nixos-fw\n\nip46tables -t mangle -N nixos-fw-rpfilter\nip46tables -t mangle -A nixos-fw-rpfilter -m rpfilter --validmark  -j RETURN\n\niptables -t mangle -A nixos-fw-rpfilter -p udp --sport 67 --dport 68 -j RETURN\niptables -t mangle -A nixos-fw-rpfilter -s 0.0.0.0 -d 255.255.255.255 -p udp --sport 68 --dport 67 -j RETURN\n\n\nip46tables -t mangle -A nixos-fw-rpfilter -j DROP\nip46tables -t mangle -A PREROUTING -j nixos-fw-rpfilter\n\nip46tables -A nixos-fw -i lo -j nixos-fw-accept\n\n\nip46tables -A nixos-fw -m conntrack --ctstate ESTABLISHED,RELATED -j nixos-fw-accept\n\nip46tables -A nixos-fw -p tcp --dport 22 -j nixos-fw-accept \nip46tables -A nixos-fw -p tcp --dport 53 -j nixos-fw-accept -i lxcbr0\n\nip46tables -A nixos-fw -p tcp --dport 10000:20000 -j nixos-fw-accept -i eth1\n\nip46tables -A nixos-fw -p udp --dport 53 -j nixos-fw-accept -i lxcbr0\nip46tables -A nixos-fw -p udp --dport 67 -j nixos-fw-accept -i lxcbr0\n\n\niptables -w -A nixos-fw -p icmp --icmp-type echo-request -j nixos-fw-accept\n\n\nip6tables -A nixos-fw -p icmpv6 --icmpv6-type redirect -j DROP\nip6tables -A nixos-fw -p icmpv6 --icmpv6-type 139 -j DROP\nip6tables -A nixos-fw -p icmpv6 -j nixos-fw-accept\nip6tables -A nixos-fw -d fe80::/64 -p udp --dport 546 -j nixos-fw-accept\n\n\n\niptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE\n\n\nip46tables -A nixos-fw -j nixos-fw-log-refuse\n\n\nip46tables -A INPUT -j nixos-fw\nremove_drop_rule\n\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"firewall-start","outputs":{"out":{"path":"n292lh7lfaw5c41b7w982mdq1gly3iak-firewall-start"}},"system":"x86_64-linux","version":4},"s99fi7np1knvhg87z1gssi0a4v6wxxa9-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/h445hjgw9yqxc3yib4pd8flhpr22adjb-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/2fr8qlv8ddgiccr9r60gjws2yqgggd27-source"},"inputs":{"drvs":{"324jiy1aizlwmqhfvj8w7cxbkybwj6lw-git-minimal-2.54.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"i3c2bk0rsdk4ifyz6cvihwq643n36zrx-nss-cacert-3.126.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["h445hjgw9yqxc3yib4pd8flhpr22adjb-builder.sh","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","y1avs2bjvql0kv5sw20qblbzym9rxm7d-nix-prefetch-git"]},"name":"source","outputs":{"out":{"hash":"sha256-qFanbp0KPc6+CN4s5mMQNduzcxt/SrMcYWvIMZ0XnGY=","method":"nar"}},"structuredAttrs":{"NIX_PREFETCH_GIT_CHECKOUT_HOOK":"","buildInputs":[],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7