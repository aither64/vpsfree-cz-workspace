ted":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","destination":"","doCheck":"","doInstallCheck":"","executable":"","mesonFlags":"","name":"sshd.pam","nativeBuildInputs":"","out":"/nix/store/34rcr4kvgi10js2r3h47fix7hhcmf54n-sshd.pam","outputs":"out","passAsFile":"text","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux","text":"# Account management.\naccount required /nix/store/khbxm3c02xklnz8jgh4cdikkgz73ssh2-linux-pam-1.7.2/lib/security/pam_unix.so # unix (order 11000)\n\n# Authentication management.\nauth sufficient /nix/store/khbxm3c02xklnz8jgh4cdikkgz73ssh2-linux-pam-1.7.2/lib/security/pam_unix.so likeauth try_first_pass # unix (order 11700)\nauth required /nix/store/khbxm3c02xklnz8jgh4cdikkgz73ssh2-linux-pam-1.7.2/lib/security/pam_deny.so # deny (order 12500)\n\n# Password management.\npassword sufficient /nix/store/khbxm3c02xklnz8jgh4cdikkgz73ssh2-linux-pam-1.7.2/lib/security/pam_unix.so nullok yescrypt # unix (order 10200)\n\n# Session management.\nsession required /nix/store/khbxm3c02xklnz8jgh4cdikkgz73ssh2-linux-pam-1.7.2/lib/security/pam_env.so conffile=/etc/pam/environment readenv=0 # env (order 10100)\nsession required /nix/store/khbxm3c02xklnz8jgh4cdikkgz73ssh2-linux-pam-1.7.2/lib/security/pam_unix.so # unix (order 10200)\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"bnzchq2039ib9nqh7ji2dsdk0cgrg5js-linux-pam-1.7.2.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"sshd.pam","outputs":{"out":{"path":"34rcr4kvgi10js2r3h47fix7hhcmf54n-sshd.pam"}},"system":"x86_64-linux","version":4},"28x04lk2i4zy13bidwmj5ylbx3v880n4-tinycc-musl-unstable-2025-12-03.drv":{"args":["-e","/nix/store/9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh"],"builder":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","env":{"PATH":"/nix/store/5rw53l1mkfaqsk0cgp9dx5qmiini3jnr-tinycc-mes-unstable-2025-12-03/bin:/nix/store/8rshwxfxypgdc35c4ys7b4yn92i5g7fn-gnupatch-2.5.9/bin:/nix/store/aa37acnhlqvnngs2q8kk34rlsjg4bqgm-gnutar-1.12/bin:/nix/store/y9mmd3nq732mzkhc0hvyr7xzf4jr5g2g-gzip-1.2.4/bin:/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin:/nix/store/wb7pvclab1aaa7myi0jafbjc60d5yij5-bootstrap-coreutils-5.0/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","SHELL":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","buildCommand":"# Unpack\ntar xzf /nix/store/j8vqssml916z4hvq1dk36w19grfrks7y-cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341.tar.gz\ncd tinycc-cb41cbf\n\n# Patch\npatch -Np0 -i /nix/store/caakpwmdf9gpgdinaqrikc7vr8y62mf6-static-link.patch\nreplace --file i386-asm.c --output i386-asm.c --match-on \"switch(size)\" --replace-with \"if (reg >= 8) { cstr_printf(add_str, \\\"%%r%d%c\\\", reg, (size == 1) ? 'b' : ((size == 2) ? 'w' : ((size == 4) ? 'd' : ' '))); return; } switch(size)\"\n\n# If performing ptr + (-1) for example, the offset should be ptrdiff_t and not size_t\nreplace --file tccgen.c --output tccgen.c --match-on \"vpush_type_size(pointed_type(&vtop[-1].type), &align);\" --replace-with \"vpush_type_size(pointed_type(&vtop[-1].type), &align); if (!(vtop[-1].type.t & VT_UNSIGNED)) gen_cast_s(VT_PTRDIFF_T);\"\n\n# Configure\ntouch config.h\n\n# Build\n# We first have to recompile using tcc-0.9.26 as tcc-0.9.27 is not self-hosting,\n# but when linked with musl it is.\nln -s /nix/store/n68vha7bj7ki3yr4nqv4bn324vzgw5ai-musl-1.2.6/lib/libtcc1.a ./libtcc1.a\n\ntcc \\\n  -B /nix/store/rayh0cq2ik1xyw2hclrkdn7c67lppg2r-tinycc-mes-libs-unstable-2025-12-03/lib \\\n  -DC2STR \\\n  -o c2str \\\n  conftest.c\n./c2str include/tccdefs.h tccdefs_.h\n\ntcc -v \\\n  -static \\\n  -o tcc-musl \\\n  -D TCC_TARGET_X86_64=1 \\\n  -D CONFIG_TCCDIR=\\\"\\\" \\\n  -D CONFIG_TCC_CRTPREFIX=\\\"{B}\\\" \\\n  -D CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\" \\\n  -D CONFIG_TCC_LIBPATHS=\\\"{B}\\\" \\\n  -D CONFIG_TCC_SYSINCLUDEPATHS=\\\"/nix/store/n68vha7bj7ki3yr4nqv4bn324vzgw5ai-musl-1.2.6/include\\\" \\\n  -D TCC_LIBGCC=\\\"libc.a\\\" \\\n  -D TCC_LIBTCC1=\\\"libtcc1.a\\\" \\\n  -D CONFIG_TCC_STATIC=1 \\\n  -D CONFIG_USE_LIBGCC=1 \\\n  -D TCC_VERSION=\\\"0.9.27\\\" \\\n  -D ONE_SOURCE=1 \\\n  -D TCC_MUSL=1 \\\n  -D CONFIG_TCC_PREDEFS=1 \\\n  -D CONFIG_TCC_SEMLOCK=0 \\\n  -D CONFIG_TCC_BACKTRACE=0 \\\n  -B . \\\n  -B /nix/store/rayh0cq2ik1xyw2hclrkdn7c67lppg2r-tinycc-mes-libs-unstable-2025-12-03/lib \\\n  tcc.c\n# libtcc1.a\nrm -f libtcc1.a\ntcc -c -D HAVE_CONFIG_H=1 lib/libtcc1.c\ntcc -ar cr libtcc1.a libtcc1.o\n\n# Rebuild tcc-musl with itself\n./tcc-musl \\\n  -v \\\n  -static \\\n  -o tcc-musl \\\n  -D TCC_TARGET_X86_64=1 \\\n  -D CONFIG_TCCDIR=\\\"\\\" \\\n  -D CONFIG_TCC_CRTPREFIX=\\\"{B}\\\" \\\n  -D CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\" \\\n  -D CONFIG_TCC_LIBPATHS=\\\"{B}\\\" \\\n  -D CONFIG_TCC_SYSINCLUDEPATHS=\\\"/nix/store/n68vha7bj7ki3yr4nqv4bn324vzgw5ai-musl-1.2.6/include\\\" \\\n  -D TCC_LIBGCC=\\\"libc.a\\\" \\\n  -D TCC_LIBTCC1=\\\"libtcc1.a\\\" \\\n  -D CONFIG_TCC_STATIC=1 \\\n  -D CONFIG_USE_LIBGCC=1 \\\n  -D TCC_VERSION=\\\"0.9.27\\\" \\\n  -D ONE_SOURCE=1 \\\n  -D TCC_MUSL=1 \\\n  -D CONFIG_TCC_PREDEFS=1 \\\n  -D CONFIG_TCC_SEMLOCK=0 \\\n  -D CONFIG_TCC_BACKTRACE=0 \\\n  -B . \\\n  -B /nix/store/n68vha7bj7ki3yr4nqv4bn324vzgw5ai-musl-1.2.6/lib \\\n  tcc.c\n# libtcc1.a\nrm -f libtcc1.a\n./tcc-musl -c -D HAVE_CONFIG_H=1 lib/libtcc1.c\n./tcc-musl -c -D HAVE_CONFIG_H=1 lib/alloca.S\n./tcc-musl -ar cr libtcc1.a libtcc1.o alloca.o\n\n# Install\ninstall -D tcc-musl $out/bin/tcc\ninstall -Dm444 libtcc1.a $out/lib/libtcc1.a\n","builder":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","name":"tinycc-musl-unstable-2025-12-03","out":"/nix/store/i7pn12w5hc2x284jij26ryx3mr3n6wk1-tinycc-musl-unstable-2025-12-03","passAsFile":"buildCommand","pname":"tinycc-musl","system":"x86_64-linux","version":"unstable-2025-12-03"},"inputs":{"drvs":{"1vgxf29abq71i0mh3m5839my4664jfmh-tinycc-mes-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"54jdq8vp944qn49b18harrbjw34dlxcp-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"bv4a5fw05q4ysq24wy0z06bd5jysq1p2-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"d1simrxi41d15h88m043y00yd400fpd4-cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"d9hngw468h7b7fpcyx284kqwdgcn3gzy-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"pshx4r5vypzz5cjy5ikscgjyzhv2s99x-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"yiv6sqyjk4mgai8fsbq0imh3vzca8ag0-musl-1.2.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zmvpmmh7i1qba20c97v4cl6yi7zqpv3a-gnupatch-2.5.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh","caakpwmdf9gpgdinaqrikc7vr8y62mf6-static-link.patch"]},"name":"tinycc-musl-unstable-2025-12-03","outputs":{"out":{"path":"i7pn12w5hc2x284jij26ryx3mr3n6wk1-tinycc-musl-unstable-2025-12-03"}},"system":"x86_64-linux","version":4},"28xl1b74vcc2aqkph50x7xgc0n0030fr-HTTP-Daemon-6.17.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"out":"/nix/store/dvr02889snw9r499kbsb5v91v4srsrs3-HTTP-Daemon-6.17.tar.gz"},"inputs":{"drvs":{"2c4f8ci4kynsx1p9hygb6z45hbqf99r4-curl-8.21.0.