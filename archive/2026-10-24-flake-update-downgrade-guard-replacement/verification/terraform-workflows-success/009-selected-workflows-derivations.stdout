iting with nonsense.\nsubstituteInPlace \"$out\"/lib/perl5/*/*/Config_heavy.pl \\\n  --replace \"/nix/store/2rgc5gn3a2qids4bhjaq2g1l1r2i1637-glibc-2.42-67-dev\" /no-such-path \\\n  --replace \"/nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0\" /no-such-path \\\n  --replace \"/nix/store/2limljgc50jy76vg388ldgggcjhhkhav-gcc-15.2.0\" /no-such-path \\\n  --replace \"/no-such-path\" /no-such-path \\\n  --replace \"$man\" /no-such-path\n","postPatch":"substituteInPlace dist/PathTools/Cwd.pm \\\n  --replace \"/bin/pwd\" \"$(type -P pwd)\"\nrm -rf cpan/HTTP-Tiny\nmkdir -p cpan/HTTP-Tiny\n\ntar --strip-components=1 -C cpan/HTTP-Tiny -xf /nix/store/jlqba5y57i3jci9fdrg7cb2phwlxvmgl-HTTP-Tiny-0.094.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/HTTP-Tiny -type f -exec chmod a-x {} +\n\nrm -rf cpan/Compress-Raw-Zlib\nmkdir -p cpan/Compress-Raw-Zlib\n\ntar --strip-components=1 -C cpan/Compress-Raw-Zlib -xf /nix/store/5bwwd3c0a0wyrsalx048sjrxkj9jc334-Compress-Raw-Zlib-2.222.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Compress-Raw-Zlib -type f -exec chmod a-x {} +\n\nrm -rf cpan/Compress-Raw-Bzip2\nmkdir -p cpan/Compress-Raw-Bzip2\n\ntar --strip-components=1 -C cpan/Compress-Raw-Bzip2 -xf /nix/store/7zngpz79lxvj9rgbmzvs7lizr64qj8di-Compress-Raw-Bzip2-2.218.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Compress-Raw-Bzip2 -type f -exec chmod a-x {} +\n\nrm -rf cpan/IO-Compress\nmkdir -p cpan/IO-Compress\n\ntar --strip-components=1 -C cpan/IO-Compress -xf /nix/store/5q7xqjml453ckx9sk2plzbjxf6bkrqg9-IO-Compress-2.220.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/IO-Compress -type f -exec chmod a-x {} +\n\nrm -rf cpan/Archive-Tar\nmkdir -p cpan/Archive-Tar\n\ntar --strip-components=1 -C cpan/Archive-Tar -xf /nix/store/53yp48jf1rnbf978f1dql94j9128zi1l-Archive-Tar-3.12.tar.gz\n\n# Remove executable bits to make t/porting/exec-bit.t happy.\nfind cpan/Archive-Tar -type f -exec chmod a-x {} +\n# Perl's build system uses the src variable, and its value may end up in\n# the output in some cases (when cross-compiling).\nunset src\n","preConfigure":"cat > config.over <<EOF\nosvers=\"gnulinux\"\nmyuname=\"nixpkgs\"\nmyhostname=\"nixpkgs\"\ncf_by=\"nixpkgs\"\ncf_time=\"$(date -d \"@$SOURCE_DATE_EPOCH\")\"\nEOF\n\n# Compress::Raw::Zlib should use our zlib package instead of the one\n# included with the distribution\ncat > ./cpan/Compress-Raw-Zlib/config.in <<EOF\nBUILD_ZLIB   = False\nINCLUDE      = /nix/store/0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev/include\nLIB          = /nix/store/l68i51npb6nlxi6z18gvgb45dz3xr5yp-zlib-1.3.2/lib\nOLD_ZLIB     = False\nGZIP_OS_CODE = AUTO_DETECT\nUSE_ZLIB_NG  = False\nZLIB_INCLUDE = /nix/store/0a4i5pcnhb4b9wnzx1x1lga18nk3rna7-zlib-1.3.2-dev/include\nZLIB_LIB     = /nix/store/l68i51npb6nlxi6z18gvgb45dz3xr5yp-zlib-1.3.2/lib\nEOF\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setOutputFlags":"","setupHook":"/nix/store/dm81j9qdcdr4c458pqbc9wvq9ymgzk4m-setup-hook.sh","src":"/nix/store/mhcbhc42ymmh2laf6yr0m2jimr07y8z0-perl-5.42.0.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"5.42.0"},"inputs":{"drvs":{"19j2rnyyj1lmmkg7klik1qhidzrlqi47-glibc-2.42-67.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"3fiaam5rvj8yfacngwr7p9vs11zd8n5g-Compress-Raw-Zlib-2.222.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"4y9kzg6h4wxyfpvw3ml99ia9cgn8p6n7-perl-5.42.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"7zi2040j4zk02fj86pngxpw091rkr8ms-IO-Compress-2.220.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"82h6sgm5vghha9vs35f5hmq9ygslg855-gcc-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"jp7ziv1mndz8w6vq5l20fyhg5qdscxm2-gcc-wrapper-15.2.0.drv":{"dynamicOutputs":{},"outputs":[