 this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/l0l6lg96zpsk6j2vbrdf443yswsckdpz-ghc-9.10.3-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"9.10.3"},"inputs":{"drvs":{"1gbawc48yci42lbjjgipkg2335ax539g-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"2vr8pva1g8iv96q4xir7pq6c5y0m4y9y-ghc-9.10.3-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"31crzmq8yc1nlj0wjfh9afjwpkc86vpj-glibc-locales-2.42-67.drv":{"dynamicOutputs":{},"outputs":["out"]},"4qpbhnd2xg5b63hqmqkb5fi0l7przkfy-ghc-binary-9.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"5czcn4k7ayp0i0gdxrri98cs8pagv2p2-base16-bytestring-1.0.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"6hddhgcg3089pxpwp5ls6gi7ljdgvkxp-unordered-containers-0.2.20.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"983ydhhs6592lpzxqlpg0kpxb5k8h6gy-shake-0.19.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"9z6053krv9ghj1l1jlay9gjfbs4mpc1b-UserSettings.hs.drv":{"dynamicOutputs":{},"outputs":["out"]},"bxy6ajfl9rkg6zzjigxq94n24q9brw33-ghc-toolchain-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"hn9gyhy5qq58isa8922b5y608skrvplj-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"iwmmrrsp6ln4xi04wfh10ad95qafqlh1-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"j9656hi1gl0sb3cfbcqc8rmazvhrxnxi-extra-1.8.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"z141na4060xmx2nmca39v8hywrc0g167-ghc-platform-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"z3srwws5g0gsxw0ydxskdsj6pr95p2ln-cryptohash-sha256-0.11.102.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"sr