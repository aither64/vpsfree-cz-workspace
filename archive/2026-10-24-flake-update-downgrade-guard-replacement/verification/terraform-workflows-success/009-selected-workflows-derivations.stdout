' \\\n| xargs -I{} --delimiter='\\n' \\\n  filterdiff \\\n  --include={} \\\n  --strip=0 \\\n   \\\n  --clean \"$out\" > \"$tmpfile\"\n\nif [ ! -s \"$tmpfile\" ]; then\n  echo \"error: Normalized patch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://github.com/apache/subversion/commit/bf72420e86059a894fa3aacbbd6e3bee9286e46e.patch"]},"system":"x86_64-linux","version":4},"plnw8sskpinqa9fcvirk3k5v8jvpx1dj-texinfo-7.2.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/pzpmwj3agpmlkjfq0g62r2zxa7qysdya-bash-static-5.3/bin/bash","env":{"NIX_MAIN_PROGRAM":"texi2any","XFAIL_TESTS":"","__structuredAttrs":"","buildInputs":"/nix/store/26wpv9as5yink7s8yi42n298rscyfxzs-bash-5.3p9-dev ","builder":"/nix/store/pzpmwj3agpmlkjfq0g62r2zxa7qysdya-bash-static-5.3/bin/bash","cmakeFlags":"","configureFlags":"PERL=/nix/store/hig28k78vcm8s2nl93hwx8xzi92pphbj-perl-5.42.0/bin/perl","depsBuildBuild":"/nix/store/znpcm6im9dlwgxkskyxd3vd5q0507jcv-bootstrap-stage3-gcc-wrapper-15.2.0 /nix/store/hig28k78vcm8s2nl93hwx8xzi92pphbj-perl-5.42.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","dep