ic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","allowedReferences":"out","buildCommand":"set +o pipefail\nmkdir -p $out/bin $out/lib\nln -s $out/bin $out/sbin\n\ncopy_bin_and_libs() {\n  [ -f \"$out/bin/$(basename $1)\" ] && rm \"$out/bin/$(basename $1)\"\n  cp -pd $1 $out/bin\n}\n\n# Copy Busybox\nfor BIN in /nix/store/d5x4mlpb0zzwmgzjzwljb0vaifvfy7r9-busybox-1.37.0/{s,}bin/*; do\n  copy_bin_and_libs $BIN\ndone\n\n# Copy modprobe\ncopy_bin_and_libs /nix/store/ahni4ky7vcyga5rkfk6yil6g0293qyvk-kmod-31/bin/kmod\nln -sf kmod $out/bin/modprobe\n\n# Copy dhcpcd\ncopy_bin_and_libs /nix/store/qknvz6hdz4rjzw22zbz04jy8v955fshi-dhcpcd-10.3.1/bin/dhcpcd\n\n# Copy dmsetup and lvm.\ncopy_bin_and_libs /nix/store/h1dpxri50hi5llambjar3iqsk5d4723k-lvm2-2.03.39-bin/bin/dmsetup\ncopy_bin_and_libs /nix/store/h1dpxri50hi5llambjar3iqsk5d4723k-lvm2-2.03.39-bin/bin/lvm\n\n# Copy eudev\ncopy_bin_and_libs /nix/store/53xacyqyn630k3zrsipl7fnpk4nqyfl8-eudev-3.2.14/bin/udevd\ncopy_bin_and_libs /nix/store/53xacyqyn630k3zrsipl7fnpk4nqyfl8-eudev-3.2.14/bin/udevadm\nfor BIN in /nix/store/53xacyqyn630k3zrsipl7fnpk4nqyfl8-eudev-3.2.14/lib/udev/*_id; do\n  copy_bin_and_libs $BIN\ndone\n\n# Copy secrets if needed.\n\n\n\n\n# Copy ld manually since it isn't detected correctly\ncp -pv /nix/store/m07h00fl6538s4gavrp66a20ka4hg7fy-glibc-2.42-67/lib/ld*.so.? $out/lib\n\n# Copy all of the needed libraries\nfind $out/bin $out/lib -type f | while read BIN; do\n  echo \"Copying libs for executable $BIN\"\n  LDD=\"$(ldd $BIN)\" || continue\n  LIBS=\"$(echo \"$LDD\" | awk '{print $3}' | sed '/^$/d')\"\n  for LIB in $LIBS; do\n    TGT=\"$out/lib/$(basename $LIB)\"\n    if [ ! -f \"$TGT\" ]; then\n      SRC=\"$(readlink -e $LIB)\"\n      cp -pdv \"$SRC\" \"$TGT\"\n    fi\n  done\ndone\n\n# Strip binaries further than normal.\nchmod -R u+w $out\nstripDirs \"lib bin\" \"-s\"\n\n# Run patchelf to make the programs refer to the copied libraries.\nfind $out/bin $out/lib -type f | while read i; do\n  if ! test -L $i; then\n    nuke-refs -e $out $i\n  fi\ndone\n\nfind $out/bin -type f | while read i; do\n  if ! test -L $i; then\n    echo \"patching $i...\"\n    patchelf --set-interpreter $out/lib/ld*.so.? --set-rpath $out/lib $i || true\n  fi\ndone\n\n# Make sure that the patchelf'ed binaries still work.\necho \"testing patched programs...\"\n$out/bin/ash -c 'echo hello world' | grep \"hello world\"\nexport LD_LIBRARY_PATH=$out/lib\n$out/bin/mount --help 2>&1 | grep -q \"BusyBox\"\n\n\n","buildInputs":"/nix/store/w0029100ygy5kywcn38sjcsc36fyvk7x-nuke-refs /nix/store/fprnk4p8ddpr5dsplw84k08yz6n016qm-lvm2-2.03.39-dev","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"extra-utils","nativeBuildInputs":"","out":"/nix/store/zjch8kndwjkc67zk7v2xzqlzxskkgpri-extra-utils","outputs":"out","passAsFile":"buildCommand","patches":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"19j2rnyyj1lmmkg7klik1qhidzrlqi47-glibc-2.42-67.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"8602qdmkk8lsi6c3xbprny6s0vvvhzan-dhcpcd-10.3.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"9swz8flvn2x28cmabc0nf0yp1xmngrk8-eudev-3.2.14.drv":{"dynamicOutputs":{},"outputs":["out"]},"b62h34b8indjlwjy86799pq9q4mc8c2f-kmod-31.drv":{"dynamicOutputs":{},"out