RMQ_ERLAPP_DIR=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9","installTargets":"install install-man","man":"/nix/store/wmq144llmhbx196fgi2xzhfx1n5lsvir-rabbitmq-server-4.2.5-man","mesonFlags":"","name":"rabbitmq-server-4.2.5","nativeBuildInputs":"/nix/store/1q3qmd1kggcnd2c4bcds7s9da26hr2vi-unzip-6.0 /nix/store/wljjqwzj5i192k916g1qqsv2zhl4v7q6-xmlto-0.0.29 /nix/store/8f4ygphna36q34zwm22rsj561cywa6q1-docbook-xml-4.5 /nix/store/1hkblzc49j6f2yc79b4p57ad5djrlsgn-docbook-xsl-nons-1.79.2 /nix/store/g9p9khsnqw7a9j1n8k09ba9a1zs56brk-zip-3.0 /nix/store/j310a1j772b3lszjmxps00704nayqj4f-rsync-3.4.4 /nix/store/xqnbm0vgqcq9b1b54c80qj9s0qhbwa08-python3-3.13.15 /nix/store/7bssl9fh53lcz77ily8sxi89b455x0im-which-2.23 /nix/store/675xkc0bpd8j7is7j80m6q68ihjp6s77-p7zip-17.06","out":"/nix/store/pdimldl0yn2y1yypsjydlf0zcldjzsp3-rabbitmq-server-4.2.5","outputs":"out man doc","patches":"","pname":"rabbitmq-server","postInstall":"# rabbitmq-env calls to sed/coreutils, so provide everything early\nsed -i $out/sbin/rabbitmq-env -e '2s|^|PATH=/nix/store/3ii4hlai5qqkm29lrgk6a9sbdzwszv5m-erlang-27.3.4.16/bin:/nix/store/z1h08n9va72q8pl4gahy36nwbgal0gag-getconf-glibc-2.42-67/bin:/nix/store/08mnag1sppj2l9a7yshz4rn51iazfyal-socat-1.8.1.3/bin:/nix/store/svl89366pvzz5s3myh1fjniz9l0x17fh-gnused-4.10/bin:/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin:/nix/store/5ckqfb66kj5g68d51wgvjknb4hi8fi0z-procps-4.0.6/bin:/nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/bin\\${PATH:+:}\\$PATH/\\n|'\n\n# We know exactly where rabbitmq is gonna be, so we patch that into the env-script.\n# By doing it early we make sure that auto-detection for this will\n# never be executed (somewhere below in the script).\nsed -i $out/sbin/rabbitmq-env -e \"2s|^|RABBITMQ_SCRIPTS_DIR=$out/sbin\\n|\"\n\n# there’s a few stray files that belong into share\nmkdir -p $doc/share/doc/rabbitmq-server\nmv $out/LICENSE* $doc/share/doc/rabbitmq-server\n\n# and an unecessarily copied INSTALL file\nrm $out/INSTALL\n","preBuild":"export LANG=C.UTF-8 # fix elixir locale warning\nexport PROJECT_VERSION=\"$version\"\n","prePatch":"# erlang.mk assumes that the elixir lib directory is at the same level as the bin of the elixir binary,\n# this is not for the Nixpkgs packaging, so patch this\nsubstituteInPlace erlang.mk \\\n  --replace-fail \\\n  \"ELIXIR_LIBS ?= $(abspath $(dir $(ELIXIR_BIN))/../lib)\" \\\n  \"ELIXIR_LIBS ?= /nix/store/g3w1x2q420kj5aj7wns865s1p2zyzyd5-elixir-1.18.4/lib/elixir/lib\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/hnwsc4b1c687cv175ag5cm7kvhmlyv44-rabbitmq-server-4.2.5.tar.xz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"4.2.5"},"inputs":{"drvs":{"078y0xd1fx6z4n9abgy5rv3nbali87h7-unzip-6.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"1cj8by9mrpim6hvbmbn6jpcfhdv7ig5a-libxml2-2.15.3.drv":{"dynamicOutputs":{},"outputs":["dev"]},"2xfg3x874r7dnh7vgzrdm05qq7jiszww-erlang-27.3.4.16.drv":{"dynamicOutputs":{},"outputs":["out"]},"31crzmq8yc1nlj0wjfh9afjwpkc86vpj-glibc-locales-2.42-67.drv":{"dynamicOutputs":{},"outputs":["out"]},"4rasdd1biymhlnh1656c7xxr8ylm890b-socat-1.8.1.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"7c2jcfqbw8jgnifzvq9w7ni7hqr3qspr-elixir-1.18.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"899gagmxab8xhknynh1vl3c502nbq0nc-systemd-260.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"9hv10gj8d9xlhvdp1ndxn9851wkywnsf-libxslt-1.1.45.drv":{"dynamicOutputs":{},"outputs":["dev"]},"9q280ykhjqnaqcxxhfwybqm3rvm6qqxs-zip-3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"baldb43jkcqp5ydaz4wfbxjfahph43q9-docbook-xml-4.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"f6zfbaldy5wyzkfyj14fg17f7n1y63xz-which-2.23.drv":{"dynamicOutputs":{},"outputs":["out"]},"hqcsdvk95xsv9h7d2rl4858a2x5rip5j-procps-4.0.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"i86ay8918vsd1qn6k