rPhase":"runHook preCompileBuildDriver\n\nfor i in Setup.hs Setup.lhs /nix/store/4mdp8nhyfddh7bllbi7xszz7k9955n79-Setup.hs; do\n  test -f $i && break\ndone\n\necho setupCompileFlags: $setupCompileFlags\nghc $setupCompileFlags --make -o Setup -odir $builddir -hidir $builddir $i\n\nrunHook postCompileBuildDriver\n","configureFlags":"","configurePhase":"runHook preConfigure\n\necho configureFlags: $configureFlags\n./Setup configure $configureFlags 2>&1 | /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/tee \"$NIX_BUILD_TOP/cabal-configure.log\"\nif grep -E -q -z 'Warning:.*depends on multiple versions' \"$NIX_BUILD_TOP/cabal-configure.log\"; then\n  echo >&2 \"*** abort because of serious configure-time warning from Cabal\"\n  exit 1\nfi\n\n\nrunHook postConfigure\n","configurePlatforms":"","depsBuildBuild":"/nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","haddockPhase":"runHook preHaddock\n\nrunHook postHaddock\n","hardeningDisable":"","installPhase":"runHook preInstall\n\n./Setup install\n\n\n\n\n\n\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"happy-2.1.7","nativeBuildInputs":"/nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4 /nix/store/hbbp1a8sr589ycaqjyx1ck8gd4bxmfx1-remove-references-to /nix/store/7bssl9fh53lcz77ily8sxi89b455x0im-which-2.23","out":"/nix/store/nnm10663ljnv2srmvizz2lzc8vlmjz82-happy-2.1.7","outputs":"out","patches":"","pname":"happy","postPatch":"","preCheck":"export PATH=\"$PWD/dist/build/happy:$PATH\"\n","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4.\"\n\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname   --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --disable-library-profiling  --disable-profiling --disable-shared --disable-coverage --enable-static --disable-executable-dynamic --disable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/gzwrir9f12861dvsaxc4jgqci1knixvs-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/by53qlxwmmgad3s3n62dmbd17d6vj83g-happy-2.1.7.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"2.1.7"},"inputs":{"drvs":{"1gbawc48yci42lbjjgipkg2335ax539g-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"31crzmq8yc1nlj0wjfh9afjwpkc86vpj-glibc-locales-2.42-67.drv":{"dynamicOutputs":{},"outputs":["out"]},"4qpbhnd2xg5b63hqmqkb5fi0l7przkfy-ghc-binary-9.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"87yw1d72d5dasa9an92jd1cqamxlyvq2-happy-2.1.7.tar.gz.drv":{"dynamicOutputs":{},"outpu