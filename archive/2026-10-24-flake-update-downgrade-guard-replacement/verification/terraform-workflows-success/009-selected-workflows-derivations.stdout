onfFile\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/quickcheck-classes-0.6.5.0\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"quickcheck-classes-0.6.5.0","nativeBuildInputs":"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3 /nix/store/hbbp1a8sr589ycaqjyx1ck8gd4bxmfx1-remove-references-to","out":"/nix/store/zcl75xkszx8sjycprp8khkmis95vkc9q-quickcheck-classes-0.6.5.0","outputs":"out doc","patches":"","pname":"quickcheck-classes","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"echo \"Replace Cabal file with edited version from mirror://hackage/quickcheck-classes-0.6.5.0/revision/3.cabal.\"\ncp /nix/store/savxc13gfjjmyxh471zgi4kd2h7f6869-quickcheck-classes-0.6.5.0-r3.cabal quickcheck-classes.cabal\n\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"/nix/store/znzjnkp24jwvz693fisrg8s9ws8328nx-aeson-2.2.4.1   /nix/store/f5fiqq93q8rd7ys8g0vfsj2cz2757cm6-primitive-0.9.1.0 /nix/store/kjwhbm15gxa4g3gaczj86lr65ziijw94-primitive-addr-0.1.0.3 /nix/store/n2g9kff9a40k067qq1i0jqfhv18sprwd-QuickCheck-2.15.0.1 /nix/store/l1frp8qvdyjpx0bzbxjm7qvl3dpm193z-quickcheck-classes-base-0.6.2.0 /nix/store/bb1znamlbhqnzsbrwjwwxm2ms0i6rpjs-semigroupoids-6.0.2 /nix/store/2fk2mhhnv1jby6bf89fv2mw3iz4sxadr-semirings-0.7  /nix/store/9kp44f4jfr4kplyvbd6c74rg6bwl7z38-vector-0.13.2.0","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3.\"\nexport PATH=/nix/store/ncws3231mq7lz6wqyyg2p7gmz6fcvikf-hscolour-1.25/bin:$PATH\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname  --docdir=$doc/share/doc/quickcheck-classes-0.6.5.0 --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --enable-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --enable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/70svcd4pr6fk316qgsjy75k11hfi1yhl-quickcheck-classes-0.6.5.0.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.6.5.0"},"inputs":{"drvs":{"00mwkbywm8047xr5fhqbvwxrch0kpy03-semigroupoids-6.0.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"1gbawc48yci42lbjjgipkg2335ax539g-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"255m8jxig599vlwn3d4sy29jdgb5y388-primitive-addr-0.1.0.3.drv":{"dynamicOutputs":