":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"","dontStrip":"","gemName":"osup","gemPath":"/nix/store/myrbk54s0r46rif9wx9qscvlcw1cxzx4-ruby3.4-gli-2.22.2 /nix/store/mxvi83355ihd2fzmisnncrswb3cf0mx0-ruby3.4-json-2.21.2 /nix/store/49igmpzaqxlyf8ak4bvscz3gk29dfqfp-ruby3.4-libosctl-26.05.0 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-osup-26.05.0","nativeBuildInputs":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/b2bdpdyhn22yhkvy8iqjyxly6n5yr3dn-ruby3.4-osup-26.05.0","outputs":"out","patches":"","pname":"osup","propagatedBuildInputs":"/nix/store/myrbk54s0r46rif9wx9qscvlcw1cxzx4-ruby3.4-gli-2.22.2 /nix/store/mxvi83355ihd2fzmisnncrswb3cf0mx0-ruby3.4-json-2.21.2 /nix/store/49igmpzaqxlyf8ak4bvscz3gk29dfqfp-ruby3.4-libosctl-26.05.0 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/myrbk54s0r46rif9wx9qscvlcw1cxzx4-ruby3.4-gli-2.22.2 /nix/store/mxvi83355ihd2fzmisnncrswb3cf0mx0-ruby3.4-json-2.21.2 /nix/store/49igmpzaqxlyf8ak4bvscz3gk29dfqfp-ruby3.4-libosctl-26.05.0 /nix/store/5bfsfr03f8dib5bji2ii8mkzhjhw8gln-ruby3.4-require_all-2.0.0","ruby":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9","src":"/nix/store/idxqjbp85zh1ilzjlglmpqhh2givrmsq-zd7z6pw3pkk6099kjvjryqq5xxgblygw-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"26.05.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nmkdir source\ncp -a \"$src/.\" source/\nchmod -R u+w source\nsourceRoot=source/osup\n\nrunHook postUnpack\n","version":"26.05.0"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"7qlxiwkbp6lbhqf3qvh2zf81yyhwqrn7