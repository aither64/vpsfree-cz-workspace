1133lnvmaxanrlxl0k7ac-autoconf-2.73 /nix/store/prmvgm1wz27c4ipx6xigqjikshmyzxrn-automake-1.18.1 /nix/store/y3ym52hvpsp1f8c8jd58rlhyj5yigibn-flex-2.6.4 /nix/store/db8cwzsgxv3lijvf18kqvjjbylm5hrpi-gettext-1.0 /nix/store/c6rl57qqmx2sk112kdgpk26ghm77s0li-groff-1.24.1 /nix/store/ligd2psjpczqdhiy59ccs6a4k7w2xr5n-libtool-2.5.4 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook /nix/store/cizqnkc40i7k401f8cl2260ksi9nnph4-pkg-config-wrapper-0.29.2 /nix/store/n0adwsx0sxhrfq6x32zm2is31xzhaf5y-zstd-1.5.7-dev /nix/store/n3glfh8a03w0nvhnp9grivvvvbifhc0c-glibc-iconv-2.42","out":"/nix/store/phvdhap8ylrf7xffpbqlad69faza6mdx-man-db-2.13.1","outputMan":"out","outputs":"out doc","patches":"/nix/store/p4m9shlpsqrvir464livcdni0y32ah3f-systemwide-man-db-conf.patch","pname":"man-db","postInstall":"# apropos/whatis uses program name to decide whether to act like apropos or whatis\n# (multi-call binary). `apropos` is actually just a symlink to whatis. So we need to\n# make sure that we don't wrap symlinks (since that changes argv[0] to the -wrapped name)\nfind \"$out/bin\" -type f | while read file; do\n  wrapProgram \"$file\" \\\n    --prefix PATH : \"/nix/store/c6rl57qqmx2sk112kdgpk26ghm77s0li-groff-1.24.1/bin:/nix/store/2722ncq58c1amdv6g6nv5d1wvab30p0r-gzip-1.14/bin:/nix/store/xvd9s1sg5fb4zrvr649i4dydrrkngrj1-zstd-1.5.7-bin/bin\"\ndone\n","postPatch":"# Remove all mandatory manpaths. Nixpkgs makes no requirements on\n# these directories existing.\nsed -i 's/^MANDATORY_MANPATH/# &/' src/man_db.conf.in\n\n# Add Nix-related manpaths\necho \"MANPATH_MAP\t/nix/var/nix/profiles/default/bin\t/nix/var/nix/profiles/default/share/man\" >> src/man_db.conf.in\n\n# Add mandb locations for the above\necho \"MANDB_MAP\t/nix/var/nix/profiles/default/share/man\t/var/cache/man/nixpkgs\" >> src/man_db.conf.in\n","preConfigure":"./bootstrap --no-git --gnulib-srcdir=/nix/store/pir73cc0nvg51xr7rpm0z8w3b6yk1jz7-gnulib-20241001 --gen\nconfigureFlagsArray+=(\"--with-sections=1 n l 8 3 0 2 5 4 9 6