":["out"],"patches":[],"pathsToLink":["/"],"postBuild":"for path in /nix/store/xqnbm0vgqcq9b1b54c80qj9s0qhbwa08-python3-3.13.15 /nix/store/a4x2b6nfs57pgkw5q0ac0bprzxdbgxrg-python3.13-setuptools-80.10.1 /nix/store/d4jqmp1gg2wfn0gjkf4fb6xxd4mwvvqj-bin; do\n  if [ -d \"$path/bin\" ]; then\n    cd \"$path/bin\"\n    for prg in *; do\n      if [ -f \"$prg\" ] && [ -x \"$prg\" ]; then\n        rm -f \"$out/bin/$prg\"\n        if [ \"$prg\" = \"python3.13\" ]; then\n          makeWrapper \"/nix/store/xqnbm0vgqcq9b1b54c80qj9s0qhbwa08-python3-3.13.15/bin/python3.13\" \"$out/bin/$prg\" \\\n            --inherit-argv0 \\\n            --resolve-argv0 \\\n            --set PYTHONNOUSERSITE \"true\" \\\n            \n        elif [ \"$(readlink \"$prg\")\" = \"python3.13\" ]; then\n          ln -s \"python3.13\" \"$out/bin/$prg\"\n        else\n          makeWrapper \"$path/bin/$prg\" \"$out/bin/$prg\" \\\n            --set NIX_PYTHONPREFIX \"$out\" \\\n            --set NIX_PYTHONEXECUTABLE /1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/bin/python3.13 \\\n            --set NIX_PYTHONPATH /1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/python3.13/site-packages \\\n            --set PYTHONNOUSERSITE \"true\" \\\n            \n        fi\n      fi\n    done\n  fi\ndone\n","preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"system":"x86_64-linux"},"system":"x86_64-linux","version":4},"sz9gngc271q1awwyrzb7pxm7zpdqpjyg-rust-lib-src.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildCommand":"tar --strip-components=1 -xzf /nix/store/6wq4v4hfgx2875qszshp9x06wmlc5z65-rustc-1.95.0-src.tar.gz\nmv library $out\n","buildInputs":"","builder":"/nix/store