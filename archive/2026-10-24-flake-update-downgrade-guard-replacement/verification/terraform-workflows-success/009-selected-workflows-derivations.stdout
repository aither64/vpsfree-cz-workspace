r\" | wc -l) != 1 ]; then\n  echo \"error: zip file must contain a single file or directory.\"\n  echo \"hint: Pass stripRoot=false; to fetchzip to assume flat list of files.\"\n  exit 1\nfi\nfn=$(cd \"$unpackDir\" && ls -A)\nif [ -f \"$unpackDir/$fn\" ]; then\n  mkdir $out\nfi\nmv \"$unpackDir/$fn\" \"$out\"\n\n\nchmod 755 \"$out\"\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"recursiveHash":true,"repo":"python-certifi","rev":"2026.01.04","revCustom":"2026.01.04","showURLs":false,"stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":false,"stripRoot":true,"system":"x86_64-linux","urls":["https://github.com/certifi/python-certifi/archive/2026.01.04.tar.gz"]},"system":"x86_64-linux","version":4},"3cwic7i0fyrg1as3kjnm5xirwv4sllsj-openblas-0.3.33.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"NIX_HARDENING_ENABLE":"format fortify fortify3 libcxxhardeningfast stackclashprotection strictflexarrays1 zerocallusedregs","__structuredAttrs":"","blas64":"","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"-DTARGET:STRING=ATHLON -DDYNAMIC_ARCH:BOOL=TRUE -DUSE_OPENMP:BOOL=TRUE -DNUM_THREADS:STRING=64 -DINTERFACE64:BOOL=FALSE -DNO_SUFFIX64:BOOL=TRUE -DBUILD_STATIC_LIBS:BOOL=FALSE -DBUILD_SHARED_LIBS:BOOL=TRUE -DCMAKE_Fortran_COMPILER:STRING=gfortran -DBUILD_TESTING:BOOL=FALSE -DBINARY:STRING=64 -DNO_AVX512:BOOL=TRUE","configureFlags":"","depsBuildBuild":"/nix/store/10ilqhvh7m1lxpjsq73gp66waqlcl2iv-gfortran-wrapper-15.2.0 /nix/store/c7c0yarb87cv4jxlyr02dxryrlmyi232-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/0chh8406sp4hi5v4mgmykfl7gvfh70zd-openblas-0.3.33-dev","doCheck":"1","doInstallCheck":"","hardeningDisable":"stackprotector pic strictoverflow relro bindnow","mesonFlags":"","name":"openblas-0.3.33","nativeBuildInputs":"/nix/store/vrsali0sa6hwri27azgn4q0y0kmrglyi-cmake-4.1.6","out":"/nix/store/5v1hn742q1fb54r8d3rlw1382yjhgxq5-openblas-0.3.33","outputs":"out dev","patches":"/nix/store/9x9mhc53cq5n2war1sw7cw68jyc65a0x-cmake-include-fixes.patch /nix/store/9gp1dcbsgimk40ca7wcw0y8bkcbdyvv1-e3ce4623c299068bbd47c35ee87aab334bac73b1.patch /nix/store/h33h0wkqqd4cqhs9hczh3gsy8vra9pbs-3f6e928d34aca977bd5d4191e6d2c2338a342.patch","pname":"openblas","postInstall":"    # Provide headers in /include directly for compat with some consumers like flint\n    (cd $dev/include && ln -sf openblas/*.h .)\n\n    # Write pkgconfig aliases. Upstream report:\n    # https://github.com/OpenMathLib/OpenBLAS/issues/1740\n    for alias in blas cblas lapack; do\n      cat <<EOF > $out/lib/pkgconfig/$alias.pc\nName: $alias\nVersion: 0.3.33\nDescription: $alias provided by the OpenBLAS package.\nCflags: -I$dev/include\nLibs: -L$out/lib -lopenblas\nEOF\n    done\n\n    # Setup symlinks for blas / lapack\nln -s $out/lib/libopenblas.so $out/lib/libblas.so\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so\nln -s $out/lib/libopenblas.so $out/lib/liblapacke.so\nln -s $out/lib/libopenblas.so $out/lib/libblas.so.3\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so.3\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so.3\nln -s $out/lib/libopenblas.so $out/lib/liblapacke.so.3\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"/nix/store/465gr2z7j60lamxg6s49idzshy7hqhag-check-phase-thread-limit-hook","src":"/nix/store/8s966i8ks25b81iq8agnsmj8bz2zacp3-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.3.33"},"inputs":{"drvs":{"5nf84pa3c0