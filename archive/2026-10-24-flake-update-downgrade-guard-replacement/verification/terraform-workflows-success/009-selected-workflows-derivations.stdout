me Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-rack-oauth2-2.2.1","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/ygz7j4qmcgyck0b8ag3zdxb00na2x1f7-ruby3.4-rack-oauth2-2.2.1","outputs":"out","patches":"","pname":"rack-oauth2","propagatedBuildInputs":"/nix/store/s9s7rl49jvfylnci5zkx88xw38k219pi-ruby3.4-activesupport-8.1.4 /nix/store/qb3v9hb20gm66gy2dqkfz8sqkyf4cl22-ruby3.4-attr_required-1.0.2 /nix/store/lm3yvql3j5v0qxl3lvw96c6fhcf6wg6k-ruby3.4-faraday-2.15.0 /nix/store/w589kzvv2w29m9xm2gb9kd7s365j8idb-ruby3.4-faraday-follow_redirects-0.5.0 /nix/store/xqbpmkcbk7xwkq37dd5z9incna0adflc-ruby3.4-json-jwt-1.17.2 /nix/store/4xvlx4l7xci38pyfz7jw87nv996bwy98-ruby3.4-rack-3.2.7","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/s9s7rl49jvfylnci5zkx88xw38k219pi-ruby3.4-activesupport-8.1.4 /nix/store/qb3v9hb20gm66gy2dqkfz8sqkyf4cl22-ruby3.4-attr_required-1.0.2 /nix/store/lm3yvql3j5v0qxl3lvw96c6fhcf6wg6k-ruby3.4-faraday-2.15.0 /nix/store/w589kzvv2w29m9xm2gb9kd7s365j8idb-ruby3.4-faraday-follow