e\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/asn1-encoding-0.9.6\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"asn1-encoding-0.9.6","nativeBuildInputs":"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3 /nix/store/hbbp1a8sr589ycaqjyx1ck8gd4bxmfx1-remove-references-to","out":"/nix/store/i64crvsxm2225jg2y8yiffdzpribyz82-asn1-encoding-0.9.6","outputs":"out doc","patches":"","pname":"asn1-encoding","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"echo \"Replace Cabal file with edited version from mirror://hackage/asn1-encoding-0.9.6/revision/2.cabal.\"\ncp /nix/store/chp67s7d2sl2q20y9bv4lnragh457lgj-asn1-encoding-0.9.6-r2.cabal asn1-encoding.cabal\n\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"/nix/store/zz8cdvvv1zfmlgq31pp4ywwnc19kxcs5-asn1-types-0.3.4   /nix/store/mxk9nz5xk95v8j5w0q5scvvlykkpidmg-hourglass-0.2.12","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3.\"\nexport PATH=/nix/store/ncws3231mq7lz6wqyyg2p7gmz6fcvikf-hscolour-1.25/bin:$PATH\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname  --docdir=$doc/share/doc/asn1-encoding-0.9.6 --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --enable-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --enable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/rj7pj1mmdm1h4980q8s0v4f55gnnrrl6-asn1-encoding-0.9.6.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.9.6"},"inputs":{"drvs":{"08277mf9hfjhzqvlvs8bc51p2kdrag1z-asn1-encoding-0.9.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"1gbawc48yci42lbjjgipkg2335ax539g-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"31crzmq8yc1nlj0wjfh9afjwpkc86vpj-glibc-locales-2.42-67.drv":{"dynamicOutputs":{},"outputs":["out"]},"4by2ygk033w4hyngk9cx8ygjppk8s4ix-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"g7xckv5xiglyhissxrqyhjqmh03hddwx-tasty-quickcheck-0.11.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"hcyw016b7q33pdvnczpfdfyj0fml3s0h-hourglass-0.2.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"hn9gyhy5qq58isa8922b5y608skrvplj-remove-referen