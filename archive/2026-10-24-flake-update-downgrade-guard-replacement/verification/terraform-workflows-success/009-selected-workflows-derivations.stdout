ce systemd-ask-password-wall.path systemd-ask-password-wall.service systemd-bootctl@.service systemd-bootctl.socket systemd-creds@.service systemd-creds.socket systemd-pcrlock@.service systemd-pcrlock.socket systemd-tpm2-clear.service slices.target systemd-importd.service machine.slice machines.target systemd-machined.service systemd-nspawn@.service systemd-sysctl.service systemd-machine-id-commit.service dbus-org.freedesktop.timedate1.service systemd-timedated.service dbus-org.freedesktop.locale1.service systemd-localed.service dbus-org.freedesktop.hostname1.service systemd-hostnamed.service systemd-hostnamed.socket dbus-org.freedesktop.portable1.service systemd-portabled.service systemd-exit.service systemd-update-done.service capsule@.service capsule.slice factory-reset.target systemd-factory-reset-request.service systemd-factory-reset-reboot.service user.slice tpm2.target systemd-tpm2-setup-early.service systemd-tpm2-setup.service systemd-tmpfiles-clean.service systemd-tmpfiles-clean.timer systemd-tmpfiles-setup-dev-early.service systemd-tmpfiles-setup-dev.service systemd-tmpfiles-setup.service systemd-oomd.service systemd-oomd.socket systemd-logind.service systemd-user-sessions.service dbus-org.freedesktop.import1.service dbus-org.freedesktop.machine1.service dbus-org.freedesktop.login1.service user@.service user-runtime-dir@.service systemd-journald.socket systemd-journald@.socket systemd-journald-varlink@.socket systemd-journald.service systemd-journald@.service systemd-journal-flush.service systemd-journal-catalog-update.service systemd-journald-sync@.service systemd-journald-audit.socket systemd-journald-dev-log.socket systemd-journalctl.socket systemd-journalctl@.service syslog.socket systemd-coredump.socket systemd-coredump@.service emergency.target emergency.service; do\n  fn=/nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/example/systemd/system/$i\n  if ! [ -e $fn ]; then echo \"missing $fn\"; false; fi\n  if [ -L $fn ]; then\n    target=\"$(readlink \"$fn\")\"\n    if [ ${target:0:3} = ../ ]; then\n      ln -s \"$(readlink -f \"$fn\")\" $out/\n    else\n      cp -pd $fn $out/\n    fi\n  else\n    ln -s $fn $out/\n  fi\ndone\n\n# Copy .wants links, but only those that point to units that\n# we're interested in.\nfor i in sysinit.target.wants sockets.target.wants local-fs.target.wants multi-user.target.wants timers.target.wants factory-reset.target.wants; do\n  fn=/nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/example/systemd/system/$i\n  if ! [ -e $fn ]; then echo \"missing $fn\"; false; fi\n  x=$out/$(basename $fn)\n  mkdir $x\n  for i in $fn/*; do\n    y=$x/$(basename $i)\n    cp -pd $i $y\n    if ! [ -e $y ]; then rm $y; fi\n  done\ndone\n\n# Symlink all units provided listed in systemd.packages.\npackages=\"/nix/store/phdp59im6jvacsm7xcfv8ayd4s6ljk21-nix-2.34.8 /nix/store/xr9mx11i6gary2gbxnkfbxrdd0nfi4bx-dbus-1.16.2 /nix/store/52k47shyn682b1blwrryiha1inib69gq-dbus-broker-37 /nix/store/4n075ll5jdwbjv142yg8ymz5f3yf4pam-util-linux-2.42.2-bin /nix/store/9bls42pnwrggsa8qjaqndnm3j9bxg6lw-util-linux-2.42.2-lastlog\"\n\n# Filter duplicate directories\ndeclare -A unique_packages\nfor k in $packages ; do unique_packages[$k]=1 ; done\n\nfor i in ${!unique_packages[@]}; do\n  for fn in $i/etc/systemd/system/* $i/lib/systemd/system/*; do\n    if ! [[ \"$fn\" =~ .wants$ ]]; then\n      if [[ -d \"$fn\" ]]; then\n        targetDir=\"$out/$(basename \"$fn\")\"\n        mkdir -p \"$targetDir\"\n        /nix/store/sa95zr548fwpkdp35a56nla83wwh44ss-lndir-1.0.5/bin/lndir \"$fn\" \"$targetDir\"\n      else\n        ln -s $fn $out/\n      fi\n    fi\n  done\ndone\n\n# Symlink units defined by systemd.units where override strategy\n# shall be automatically detected. If these are also provided by\n# systemd or systemd.packages, then add them as\n# <unit-name>.d/overrides.conf, which makes them extend the\n# upstream unit.\nfor i in /nix/store/8x0msnc5db0i4gsrmbilv1idgkyzz834-unit--.slice /nix/store/yl70899krz0wzld