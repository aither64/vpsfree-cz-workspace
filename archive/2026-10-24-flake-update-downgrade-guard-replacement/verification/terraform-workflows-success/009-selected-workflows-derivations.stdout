nix/store/hxv34l653mz487v9sps8v62zw52bpkn3-curl-8.21.0-bin/bin/curl --head \"$url\" >/dev/null 2>&1 && return 0\n  done\n\n  return 1\n}\n\n\nwait_online() {\n  for i in {1..300} ; do\n    for method in ping http ; do\n      check_online_$method && return 0\n    done\n\n    warn \"Waiting for network to come online...\"\n    sleep 1\n  done\n\n  return 1\n}\n\nif ! wait_online ; then\n  warn \"Timed out while waiting for network to come online\"\n  exit 1\nfi\n\necho \"Service network-online successfully finished\"\nmkdir -p /run/service/network-online\ntouch /run/service/network-online/done\nsv once network-online\n\n\n"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"lfypd7a160phbili4qyx7ls4i5w0sijn-curl-8.21.0.drv":{"dynamicOutputs":{},"outputs":["bin"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"sv-network-online-run","outputs":{"out":{"path":"54w2grq9668n6p69xwvz9hpazq29sfnm-sv-network-online-run"}},"system":"x86_64-linux","version":4},"7ja5fnhf9alagfaad76618bavvf6j405-make-initrd-ng-0.1.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"make-initrd-ng","PKG_CONFIG_ALLOW_CROSS":"0","RUST_LOG":"","__structuredAttrs":"","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cargoBuildFeatures":"","cargoBuildNoDefaultFeatures":"","cargoBuildType":"release","cargoCheckFeatures":"","cargoCheckNoDefaultFeatures":"","cargoCheckType":"release","cargoDeps":"/nix/store/ka3brsyirrq0d7lkw7p7j1hps58n0lhg-cargo-vendor-dir","cmakeFlags":"","configureFlags":"","configurePhase":"runHook preConfigure\nrunHook p