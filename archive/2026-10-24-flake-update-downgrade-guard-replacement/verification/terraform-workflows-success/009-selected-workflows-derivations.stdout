ed\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-slop-3.6.0","nativeBuildInputs":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/0536s6s89c2ip51wpnlgrr19qhxs712y-ruby3.4-slop-3.6.0","outputs":"out","patches":"","pname":"slop","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"","ruby":"/nix/store/rc5ywk2fcw0939v498ykjns5sirmlhr0-ruby-3.4.9","src":"/nix/store/vdfmx9gj2dvc8cb265yp0k09x5bs64kk-slop-3.6.0.gem","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"3.6.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"3.6.0"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"aif34b0cnhvg4k4ib8148jgsk380zigc-slop-3.6.0.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"vwv6gjb7r637il50p7sjbf0qn3lpxv3y-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"xshd860gif707cn5krzl14260ash8c02-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-slop-3.6.0","outputs":{"out":{"path":"0536s6s89c2ip51wpnlgrr19qhxs712y-ruby3.4-slop-3.6.0"}},"system":"x86_64-linux","version":4},"bm21lvr3ishd7qqkhiyq7lqjz7j4sdgj-libc.a.drv":{"args":["--verbose","--strict","--file","/nix/store/q2j390hf8rvrc28d2w878wn21r36n31d-libc.a-builder"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0