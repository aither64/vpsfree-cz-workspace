f\"\nmkdir -p \"$packageConfDir\"\n./Setup register --gen-pkg-config=$packageConfFile\nif [ -d \"$packageConfFile\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/bifunctors-5.6.3\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"bifunctors-5.6.3","nativeBuildInputs":"/nix/store/2b72hax2wz154fdn363zw2hh9j8fzfsi-ghc-9.10.3 /nix/store/hbbp1a8sr589ycaqjyx1ck8gd4bxmfx1-remove-references-to /nix/store/9cclyqmrzvwh1l1d559hg2jcbnnz8bmp-hspec-discover-2.11.17","out":"/nix/store/azq4afkm1nw01cfhgiqs0izpr53gbf4v-bifunctors-5.6.3","outputs":"out doc","patches":"","pname":"bifunctors","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"echo \"Replace Cabal file with edited version from mirror://hackage/bifunctors-5.6.3/revision/1.cabal.\"\ncp /nix/store/2n8fgcgria8bdkabgvk3sj91r64cfbl7-bifunctors-5.6.3-r1.cabal bifunctors.cabal\n\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"/nix/store/h86h1flb8f8hcjgq8mg6b543chhx4fl5-assoc-1.1.1  /nix/store/7bmazzdhrjqmr57a6bpx2i8ggq4ndaia-comonad-5.0.10  /nix/store/ql4zvn3yq7nicbggfjl45fcn6alb9720-tagged-0.8.9  /nix/store/ynmk58604b3vl3vxmgavgyq99r9aafhv-th-abstraction-0.7.2.0","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/2b72hax2wz154fdn