"/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"asciidoctor","__structuredAttrs":"","allowSubstitutes":"","buildCommand":"mkdir -p $out/bin\nln -s '/nix/store/rr99sw54qmfmizckfgcc97dj4nvdm5p9-asciidoctor-2.0.26/bin/asciidoctor' $out/bin/asciidoctor;\nln -s '/nix/store/rr99sw54qmfmizckfgcc97dj4nvdm5p9-asciidoctor-2.0.26/bin/asciidoctor-pdf' $out/bin/asciidoctor-pdf;\n\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n\n  # See: https://github.com/NixOS/nixpkgs/blob/master/pkgs/development/ruby-modules/gem/default.nix#L184-L200\n  # See: https://github.com/rubygems/rubygems/blob/7a7b234721c375874b7e22b1c5b14925b943f04e/bundler/lib/bundler.rb#L285-L291\n  find -L /nix/store/rr99sw54qmfmizckfgcc97dj4nvdm5p9-asciidoctor-2.0.26/lib/ruby/gems/3.4.0/gems/asciidoctor-2.0.26 \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) -print -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\ncompressManPages \"${!outputMan}\"\n\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","exes":"asciidoctor asciidoctor-pdf","mesonFlags":"","name":"asciidoctor-2.0.26","nativeBuildInputs":"","out":"/nix/store/r87fm1m3vdb9q2d151f7l31vcch5311q-asciidoctor-2.0.26","outputs":"out","passAsFile":"buildCommand","patches":"","pname":"asciidoctor","preferLocalBuild":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4