,"depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/qyphhnypviq5hsj4b3dimzlywvzl50vk-openssl-3.6.3-dev","doCheck":"1","doInstallCheck":"","doc":"/nix/store/c4l1qld8qzw1wscfpwiqwy8irbcywkvi-openssl-3.6.3-doc","dontAddStaticConfigureFlags":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","makeFlags":"MANDIR=$(man)/share/man MANSUFFIX=ssl","man":"/nix/store/lnijr476b4ar7k946ccgg6mp7wxjj6x9-openssl-3.6.3-man","mesonFlags":"","name":"openssl-3.6.3","nativeBuildInputs":"/nix/store/hxzjnjwzvwn5ak0hkp5q7jhxvk86f24p-make-binary-wrapper-hook /nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0 /nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/g0miahg2zw9d2mx3qav9p1wn3h9g4im0-openssl-3.6.3","outputs":"bin dev out man doc debug","patches":"/nix/store/sq4h6bqjx12v9whvm65pjss25hg1538q-nix-ssl-cert-file.patch /nix/store/cklrwbwi889pp2fdsswdjvn12sdy5i5j-openssl-disable-kernel-detection.patch /nix/store/i58agvhx8bmdjlspgkk4m3ylh5348iim-use-etc-ssl-certs.patch","pname":"openssl","postFixup":"# Check to make sure the main output and the static runtime dependencies\n# don't depend on perl\nif grep -r '/nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0' $out $etc; then\n  echo \"Found an erroneous dependency on perl ^^^\" >&2\n  exit 1\nfi\n# cleanup cmake helpers for now (for OpenSSL >= 3.3), only rely on pkg-config.\n# pkg-config gets its paths fixed correctly\nrm -rf $dev/lib/cmake\n","postInstall":"# If we're building dynamic libraries, then don't install static\n# libraries.\nif [ -n \"$(echo $out/lib/*.so $out/lib/*.dylib $out/lib/*.dll)\" ]; then\n    rm \"$out/lib/\"*.a\nfi\n\n# 'etc' is a separate output on static builds only.\netc=$out\nmkdir -p $bin\nmv $out/bin $bin/bin\n\n# c_rehash is a legacy perl script with the same functionality\n# as `openssl rehash`\n# this wrapper script is created to maintain backwards compatibility without\n# depending on perl\nmakeWrapper $bin/bin/openssl $bin/bin/c_rehash \\\n  --add-flags \"rehash\"\n\nmkdir $dev\nmv $out/include $dev/\n\n# remove dependency on Perl at runtime\nrm -r $etc/etc/ssl/misc\n\nrmdir $etc/etc/ssl/{certs,private}\n","postPatch":"patchShebangs Configure\nsubstituteInPlace config --replace '/usr/bin/env' '/nix/store/kq8xvabpnlfwphhqyap5r7848vbng6wm-coreutils-9.11/bin/env'\n","preCheck":"patchShebangs util\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","setOutputFlags":"","src":"/nix/store/28gjcxgpb8wznqc5dn45s5xrnbvvf2v7-openssl-3.6.3.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"3.6.3"},"inputs":{"drvs":{"3jz6svvg7x9mxf90z6h395pyzanl325m-openssl-3.6.3.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"5r4cwm9fq5c0s3hyyjzri1279jim16w4-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"fqm3im0jh9akc66grwycx2j6i8g2f065-perl-5.42.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"wqg5nr0rc40868dpmkmyy8jnsysgjyg4-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["cklrwbwi889pp2fdsswdjvn12sdy5i5j-openssl-disable-kernel-detection.patch","i58agvhx8bmdjlspgkk4m3ylh5348iim-use-etc-ssl-certs.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","sq4h6bqjx12v9whvm65pjss25hg1538q-nix-ssl-cert-file.patch"]},"name":"openssl-3.6.3","outputs":{"bin":{"path":"qdbwf30sm624azswrqqsv9wqnhmjq09d-openssl-3.6.3-bin"},"debug":{"path":"4l60h4fawlyd48hja30ns8j530vgwy9d-openssl-3.6.3-debug"},"dev":{"path":"qyphhnypviq5hsj4b3dimzlywvzl50vk-openssl-3.6.3-dev"},"doc":{"path":"c4l1qld8qzw1wscfpwiqwy8irbcywkvi-o