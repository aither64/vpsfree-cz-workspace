out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-sinatra-contrib-4.2.1","nativeBuildInputs":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook","out":"/nix/store/3zlzkrrclribgmgkmzsi7d3nq8a60162-ruby3.4-sinatra-contrib-4.2.1","outputs":"out","patches":"","pname":"sinatra-contrib","propagatedBuildInputs":"/nix/store/bf56k5v19300xdlawzh80di2nx1dq0q0-ruby3.4-multi_json-1.21.2 /nix/store/1nqrbdcicqay0ngqfh853gl6gdydjrvh-ruby3.4-mustermann-3.1.1 /nix/store/1yb3i5p7aa67y83fpm2p1v5cjnlmnxkn-ruby3.4-rack-protection-4.2.1 /nix/store/lsa145j0s8wqwwvbqh0azwiw2hnammb7-ruby3.4-sinatra-4.2.1 /nix/store/jp75cmgwl126da3xc0m6xaxhl4ply6r3-ruby3.4-tilt-2.9.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/bf56k5v19300xdlawzh80di2nx1dq0q0-ruby3.4-multi_json-1.21.2 /nix/store/1nqrbdcicqay0ngqfh853gl6gdydjrvh-ruby3.4-mustermann-3.1.1 /nix/store/1yb3i5p7aa67y83fpm2p1v5cjnlmnxkn-ruby3.4-rack-protection-4.2.1 /nix/store/lsa145j0s8wqwwvbqh0azwiw2hnammb7-ruby3.4-sinatra-4.2.1 /nix/store/jp75cmgwl126da3xc0m6xaxhl4ply6r3-ruby3.4-tilt-2.9.0","ruby":"/nix/store/nin40kn7prvsn7pmbl7k576hhwcpp9x1-ruby-3.4.9","src":"/nix/store/bi87wid3aair8y5lmnspx052kj4fjgp5-sinatra-contrib-4.2.1.gem","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"","suffix":"4.2.1","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"4.2.1"},"inputs":{"drvs":{"0sqrnd5fgwdwn79658bx46l8n6vg6yy5-ruby3.4-tilt-2.9.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"5q02sd1mg1imxlzk0855rrbdbqqfzd14-ruby3.4-rack-protection-4.2.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"d110zydkysgl9rdry5xs42ap39g3b55x-ruby3.4-multi_json-1.21.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"fdffls23fhnj639vkw6jqg03x0jap6h4-sinatra-contrib-4.2.1.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"m7s4pdp59p6992m2n559prdizqa2a55g-ruby3.4-mustermann-3.1.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"v789fj82jhjrw99r28y4i14f0ysaqrjy-ruby3.4-sinatra-4.2.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"v7lwwcrmm66pmwhs7zyn2cv7y5gqh0sq-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"xshd860gif707cn5krzl14260ash8c02-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"y898s2ajfd6ag157gc7gwa1z5vcbil9m-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-sinatra-contrib-4.2.1","outputs":{"out":{"pa