      {
        "name": "Update nixpkgs",
        "script": "before=$(git rev-parse HEAD)\n./utils/update-nixpkgs.sh\nafter=$(git rev-parse HEAD)\n\nif [ \"$before\" != \"$after\" ]; then\n  echo \"committed=true\" >> \"$GITHUB_OUTPUT\"\nelse\n  echo \"committed=false\" >> \"$GITHUB_OUTPUT\"\nfi\n",
        "original_script_sha256": "c49482c831e17914979bd7e3a938351f6a45d847b35edcd5bb9102decb05f64c"
      },
      {
        "name": "Push update",
        "script": "final_lock=\"$RUNNER_TEMP/flake-update-final.lock\"\ngit show HEAD:flake.lock > \"$final_lock\"\nnix shell \"$CONFCTL_FLAKE\" -c confctl inputs check-update \\\n  --old-lock \"$UPDATE_OLD_LOCK\" --new-lock \"$final_lock\"\n",
