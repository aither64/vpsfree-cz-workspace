\" | cut -f3 -d' ' > symbols\nfor symbol in caxpy ccopy cdotc cdotu cgbmv cgemm cgemv cgerc cgeru chbmv chemm chemv cher cher2 cher2k cherk chpmv chpr chpr2 crotg cscal csrot csscal cswap csymm csyr2k csyrk ctbmv ctbsv ctpmv ctpsv ctrmm ctrmv ctrsm ctrsv dasum daxpy dcabs1 dcopy ddot dgbmv dgemm dgemv dger dnrm2 drot drotg drotm drotmg dsbmv dscal dsdot dspmv dspr dspr2 dswap dsymm dsymv dsyr dsyr2 dsyr2k dsyrk dtbmv dtbsv dtpmv dtpsv dtrmm dtrmv dtrsm dtrsv dzasum dznrm2 icamax idamax isamax izamax lsame sasum saxpy scabs1 scasum scnrm2 scopy sdot sdsdot sgbmv sgemm sgemv sger snrm2 srot srotg srotm srotmg ssbmv sscal sspmv sspr sspr2 sswap ssymm ssymv ssyr ssyr2 ssyr2k ssyrk stbmv stbsv stpmv stpsv strmm strmv strsm strsv xerbla xerbla_array zaxpy zcopy zdotc zdotu zdrot zdscal zgbmv zgemm zgemv zgerc zgeru zhbmv zhemm zhemv zher zher2 zher2k zherk zhpmv zhpr zhpr2 zrotg zscal zswap zsymm zsyr2k zsyrk ztbmv ztbsv ztpmv ztpsv ztrmm ztrmv ztrsm ztrsv; do\n  grep -q \"^$symbol_$\" symbols || { echo \"$symbol\" was not found in \"$libblas\"; exit 1; }\ndone\ncp -L \"$libblas\" $out/lib/libblas.so.3\nchmod +w $out/lib/libblas.so.3\n\npatchelf --set-soname libblas.so.3 $out/lib/libblas.so.3\npatchelf --set-rpath \"$(patchelf --print-rpath $out/lib/libblas.so.3):/nix/store/v125s7ad2ni0r1vxw6bp3x0hg0rd403x-openblas-0.3.32/lib\" $out/lib/libblas.so.3\n\n  if [ \"$out/lib/libblas.so.3\" != \"$out/lib/libblas.so\" ]; then\n    ln -s $out/lib/libblas.so.3 \"$out/lib/libblas.so\"\n  fi\n\n  cat <<EOF > $dev/lib/pkgconfig/blas.pc\nName: blas\nVersion: 3\nDescription: BLAS FORTRAN implementation\nLibs: -L$out/lib -lblas\nCflags: -I$dev/include\nEOF\n\n  libcblas=\"/nix/store/v125s7ad2ni0r1vxw6bp3x0hg0rd403x-openblas-0.3.32/lib/libcblas.so.3\"\n\n  if ! [ -e \"$libcblas\" ]; then\n    echo \"$libcblas does not exist, openblas-0.3.32 does not provide libcblas.\"\n    exit 1\n  fi\n\n  cp -L \"$libcblas\" $out/lib/libcblas.so.3\n  chmod +w $out/lib/libcblas.so.3\n\npatchelf --set-soname libcblas.so.3 $out/lib/libcblas.so.3\npatchelf --set-rpath \"$(patchelf --print-rpath $out/lib/libcblas.so.3):/nix/store/v125s7ad2ni0r1vxw6bp3x0hg0rd403x-openblas-0.3.32/lib\" $out/lib/libcblas.so.3\n  if [ \"$out/lib/libcblas.so.3\" != \"$out/lib/libcblas.so\" ]; then\n    ln -s $out/lib/libcblas.so.3 \"$out/lib/libcblas.so\"\n  fi\n\n  cp /nix/store/gwl7bng87ffqdcc17swzpr2ggjgxqw0n-liblapack-3.12.1/include/cblas{,_mangling}.h $dev/include\n\n  cat <<EOF > $dev/lib/pkgconfig/cblas.pc\nName: cblas\nVersion: 3\nDescription: BLAS C implementation\nCflags: -I$dev/include\nLibs: -L$out/lib -lcblas\nEOF\n","mesonFlags":"","name":"blas-3","nativeBuildInputs":"","out":"/nix/store/ba0pync7rmzsq32xxaz9l9hs3zj7hil4-blas-3","outputs":"out dev","patches":"","pname":"blas","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","system":"x86_64-linux","unpackPhase":"src=$PWD","version":"3"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"cwq2dxxz8qs9xjm0shjr5cjgws1bjrng-openblas-0.3.32.drv":{"dynamicOutputs":{},"outputs":["out"]},"m1gn4v33cy6s5wwhcw138sbb1kgmza2q-liblapack-3.12.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"blas-3","outputs":{"dev":{"path":"4475dvkkvpds695bmfz836x4nic1xz8j-blas-3-dev"},"out":{"path":"ba0pync7rmzsq32xxaz9l9hs3zj7hil4-blas-3"}},"system":"x86_64-linux","version":4},"k5rg2vwnp79zgc3f0ybnr7hhvg1r37k2-gnum4-get-version-1.4.21.drv":{"args":["-e","/nix/store/70acbfgbz5cxsx4sqzcnj8qaqhb4i9ay-bash-builder.sh"],"builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","env":{"PATH":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin:/nix/store/z498zyjm053c83r00qnwgg2pjw