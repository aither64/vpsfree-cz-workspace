ix/store/mirf7c51qwb4d454smz1725gx9r2m5bj-mirrors-list","name":"source","nativeBuildInputs":["/nix/store/azim31fjrmanwb4i0f15ywpk1jkizfxj-curl-8.20.0-dev"],"nixpkgsVersion":"26.05","outputChecks":{"out":{}},"outputHash":"sha256-2x3znm92wo8DCshf5sYK0stnESg0oVXbxsWRAaTj6oQ=","outputHashMode":"recursive","outputs":["out"],"owner":"pytest-dev","patches":[],"postFetch":"unpackDir=\"$TMPDIR/unpack\"\nmkdir \"$unpackDir\"\ncd \"$unpackDir\"\n\nrenamed=\"$TMPDIR/download.tar.gz\"\nmv \"$downloadedFile\" \"$renamed\"\nunpackFile \"$renamed\"\nchmod -R +w \"$unpackDir\"\nif [ $(ls -A \"$unpackDir\" | wc -l) != 1 ]; then\n  echo \"error: zip file must contain a single file or directory.\"\n  echo \"hint: Pass stripRoot=false; to fetchzip to assume flat list of files.\"\n  exit 1\nfi\nfn=$(cd \"$unpackDir\" && ls -A)\nif [ -f \"$unpackDir/$fn\" ]; then\n  mkdir $out\nfi\nmv \"$unpackDir/$fn\" \"$out\"\n\n\nchmod 755 \"$out\"\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"recursiveHash":true,"repo":"pytest-xdist","rev":"refs/tags/v3.8.0","showURLs":false,"stdenv":"/nix/store/81ff57hcs8gjlnaqqhbilzxsvb5pfzaa-stdenv-linux","strictDeps":false,"stripRoot":true,"system":"x86_64-linux","tag":"v3.8.0","urls":["https://github.com/pytest-dev/pytest-xdist/archive/refs/tags/v3.8.0.tar.gz"]},"system":"x86_64-linux","version":4},"i4k8vffg2d1qblx4lqi3sr0ni3ikp4w6-openblas-0.3.33.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"NIX_HARDENING_ENABLE":"format fortify fortify3 libcxxhardeningfast stackclashprotection strictflexarrays1 zerocallusedregs","__structuredAttrs":"","blas64":"","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"-DTARGET:STRING=ATHLON -DDYNAMIC_ARCH:BOOL=TRUE -DUSE_OPENMP:BOOL=TRUE -DNUM_THREADS:STRING=64 -DINTERFACE64:BOOL=FALSE -DNO_SUFFIX64:BOOL=TRUE -DBUILD_STATIC_LIBS:BOOL=FALSE -DBUILD_SHARED_LIBS:BOOL=TRUE -DCMAKE_Fortran_COMPILER:STRING=gfortran -DBUILD_TESTING:BOOL=FALSE -DBINARY:STRING=64 -DNO_AVX512:BOOL=TRUE","configureFlags":"","depsBuildBuild":"/nix/store/2w8k5grzg6rc23xl435r1683qyjj4bpy-gfortran-wrapper-15.3.0 /nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/7h4fvc3y61747i8xqypzb9m37zddj7ss-openblas-0.3.33-dev","doCheck":"1","doInstallCheck":"","hardeningDisable":"stackprotector pic strictoverflow relro bindnow","mesonFlags":"","name":"openblas-0.3.33","nativeBuildInputs":"/nix/store/v4m910fin3csvzhv8pq6aivvi6ghmzmp-cmake-4.1.6","out":"/nix/store/nlg0vijaii4b4h8y5z407fsadf8z36ds-openblas-0.3.33","outputs":"out dev","patches":"/nix/store/9x9mhc53cq5n2war1sw7cw68jyc65a0x-cmake-include-fixes.patch /nix/store/9gp1dcbsgimk40ca7wcw0y8bkcbdyvv1-e3ce4623c299068bbd47c35ee87aab334bac73b1.patch /nix/store/h33h0wkqqd4cqhs9hczh3gsy8vra9pbs-3f6e928d34aca977bd5d4191e6d2c2338a342.patch","pname":"openblas","postInstall":"    # Provide headers in /include directly for compat with some consumers like flint\n    (cd $dev/include && ln -sf openblas/*.h .)\n\n    # Write pkgconfig aliases. Upstream report:\n    # https://github.com/OpenMathLib/OpenBLAS/issues/1740\n    for alias in blas cblas lapack; do\n      cat <<EOF > $out/lib/pkgconfig/$alias.pc\nName: $alias\nVersion: 0.3.33\nDescription: $alias provided by the OpenBLAS package.\nCflags: -I$dev/include\nLibs: -L$out/lib -lopenblas\nEOF\n    done\n\n    # Setup symlinks for blas / lapack\nln -s $out/lib/libopenblas.so $out/lib/libblas.so\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so\nln -s $out/lib/libopenblas.so 