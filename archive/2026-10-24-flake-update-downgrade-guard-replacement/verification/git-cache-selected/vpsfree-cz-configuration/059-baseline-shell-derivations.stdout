re/fc77sy9m7q47vfk8la695lv7lmbx16vq-gettext-1.0-info","man":"/nix/store/lanfhdcq0wnfl31qaq1wlj4n267ddrpd-gettext-1.0-man","mesonFlags":"","name":"gettext-1.0","nativeBuildInputs":"/nix/store/rxs3bivs72csjhyv0a66xzyv9c1x3gv2-update-autotools-gnu-config-scripts-hook","out":"/nix/store/9z0zfywl7xpjf7ky0zb2is5cfx7628sq-gettext-1.0","outputs":"out man doc info","patches":"/nix/store/p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff /nix/store/yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch","pname":"gettext","postPatch":"# Older versions of gettext come with a copy of `extern-inline.m4` that is not compatible with clang 18.\n# When a project uses gettext + autoreconfPhase, autoreconfPhase will invoke `autopoint -f`, which will\n# replace whatever (probably compatible) version of `extern-inline.m4` with one that probalby won’t work\n# because `autopoint` will copy the autoconf macros from the project’s required version of gettext.\n# Fixing this requires replacing all the older copies of the problematic file with a new one.\n#\n# This is ugly, but it avoids requiring workarounds in every package using gettext and autoreconfPhase.\ndeclare -a oldFiles=($(tar tf gettext-tools/autotools/archive.dir.tar | grep '^gettext-0\\.[19].*/extern-inline.m4'))\noldFilesDir=$(mktemp -d)\nfor oldFile in \"${oldFiles[@]}\"; do\n  mkdir -p \"$oldFilesDir/$(dirname \"$oldFile\")\"\n  cp -a gettext-tools/gnulib-m4/extern-inline.m4 \"$oldFilesDir/$oldFile\"\ndone\ntar uf gettext-tools/autotools/archive.dir.tar --owner=0 --group=0 --numeric-owner -C \"$oldFilesDir\" \"${oldFiles[@]}\"\n\nsubstituteAllInPlace gettext-runtime/src/gettext.sh.in\nsubstituteInPlace gettext-tools/projects/KDE/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/projects/GNOME/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/src/project-id --replace \"/bin/pwd\" pwd\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHooks":"/nix/store/v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash /nix/store/ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","src":"/nix/store/n4lwy41bnpq1fsqsrf5fac3m7vmhk6sr-gettext-1.0.tar.gz","stdenv":"/nix/store/wjfyka15726v163hl64ibxgm4108kjb6-bootstrap-stage1-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"1.0"},"inputs":{"drvs":{"nx5vjcba7q56d0xpr7dj0vy0nln5i64k-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["dev"]},"rd7pipwli0pfwc4qdygaxh8prq71izjh-bootstrap-stage1-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"xwkyb3k04y5vx2kpb12gr7plqvcy67c3-update-autotools-gnu-config-scripts-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"z1a6zj82v13glfvrfnhjkpic03y4kppc-bash-static-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"zdbga6f8g5jysvhngmnjlwmj674bzds2-gettext-1.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash","yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch"]},"name":"gettext-1.0","outputs":{"doc":{"path":"p93zrppz9c7fxi0mqpi7yx364hny03zr-gettext-1.0-doc"},"info":{"path":"fc77sy9m7q47vfk8la695lv7lmbx16vq-gettext-1.0-info"},"man":{"path":"lanfhdcq0wnfl31qaq1wlj4n267ddrpd-gettext-1.0-man"},"out":{"path":"9z0zfywl7xpjf7ky0zb2is5cfx7628sq-gettext-1.0"}},"system":"x86_64-linux","version":4},"jfgdmzd75pybl8jbyv0qharzncawvfjk-hex2-1.9.1.drv":{"args":["--architecture","amd64","--little-endian","--base-address","0x00600000","-f","/nix/store/4f7nm8dblrdy74gmsl62b25rjrh4jcz3-stage0-posix-1.9.1-source/M2libc/amd64/ELF-amd64-debug.hex2","-f","/nix/store/dx1971i3j2clc597xaag1g1ljdkyn0lg-hex2_linker-2.hex2-1.9.1","-o","/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9"],"builder":"/nix/store/cq7wawb5qq908svy61cqd11pn5m1h0l4-hex2-1-1.9.1","e