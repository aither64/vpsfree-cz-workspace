n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"prawn","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"prawn-icon","gemPath":"/nix/store/jip930y6r4jp6i47mgg03dj7yq5461ab-ruby3.4-prawn-2.4.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-prawn-icon-3.0.0","nativeBuildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9 /nix/store/qw8rpqmndqzyc3fzzla754v5hlpm10i4-make-shell-wrapper-hook","out":"/nix/store/i1984gs4pm3l7nbw876gx51w79papfym-ruby3.4-prawn-icon-3.0.0","outputs":"out","patches":"","pname":"prawn-icon","propagatedBuildInputs":"/nix/store/jip930y6r4jp6i47mgg03dj7yq5461ab-ruby3.4-prawn-2.4.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/jip930y6r4jp6i47mgg03dj7yq5461ab-ruby3.4-prawn-2.4.0","ruby":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9","src":"/nix/store/pmhfqcyazi99ksiahpm99696wkzpgr08-prawn-icon-3.0.0.gem","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","suffix":"3.0.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"3.0.0"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"42i4pjiaawb8jg90048qq7y1lby0zbc0-prawn-icon-3.0.0.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"6pdlg6sll1wqj9mv8831wy7933zkdhhi-ruby3.4-prawn-2.4.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"sk7l7a3hg2rlwk050a510jq9kga8fh3i-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"x21bdkwizrgm5bww1n27lrfhh4w5a8c6-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-prawn-icon-3.0.0","outputs":{"out":{"path":"i1984gs4pm3l7nbw876gx51w79papfym-ruby3.4-prawn-icon-3.0.0"}},"system":"x86_64-linux","version":4},"j0l7801fhy6ralfrcw6b407bksgf3hp5-fread-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"fread-builder","out":"/nix/store/k6fgwfhj85ay1yif51bf8vi7c4m578mn-fread-builder","passAsFile":"text","system":"x86_64-linux","text":"mkdir ${out}\ncd ${out}\n/nix/store/n9mj1f0ipsva4vyd2llpdgv3wyrcmsm1-mes-src-0.27.1-bin/bin/mes-m2 -e main