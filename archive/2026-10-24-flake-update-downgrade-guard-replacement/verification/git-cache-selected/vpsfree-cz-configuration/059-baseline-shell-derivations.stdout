gs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"Ascii85 afm hashery ruby-rc4 ttfunk","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"pdf-reader","gemPath":"/nix/store/adzjx23b8chy1hdfl366v2avpzs1vfw9-ruby3.4-Ascii85-2.0.1 /nix/store/2z3sv273hj48bmbki96mswjpfyg89i7z-ruby3.4-afm-1.0.0 /nix/store/djw3ikyn3gfcmd3pf3s00afva8mr1254-ruby3.4-hashery-2.1.2 /nix/store/7z1r44sklfdaf90kgbq8h57dy1q1rvfr-ruby3.4-ruby-rc4-0.1.5 /nix/store/2jpkc4nywflycl29dqvhj234fn09d1m5-ruby3.4-ttfunk-1.7.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-pdf-reader-2.15.0","nativeBuildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9 /nix/store/qw8rpqmndqzyc3fzzla754v5hlpm10i4-make-shell-wrapper-hook","out":"/nix/store/rqwich2vrxd1418bcb1qi5hq8f3xwm26-ruby3.4-pdf-reader-2.15.0","outputs":"out","patches":"","pname":"pdf-reader","propagatedBuildInputs":"/nix/store/adzjx23b8chy1hdfl366v2avpzs1vfw9-ruby3.4-Ascii85-2.0.1 /nix/store/2z3sv273hj48bmbki96mswjpfyg89i7z-ruby3.4-afm-1.0.0 /nix/store/djw3ikyn3gfcmd3pf3s00afva8mr1254-ruby3.4-hashery-2.1.2 /nix/store/7z1r44sklfdaf90kgbq8h57dy1q1rvfr-ruby3.4-ruby-rc4-0.1.5 /nix/store/2jpkc4nywflycl29dqvhj234fn09d1m5-ruby3.4-ttfunk-1.7.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/adzjx23b8chy1hdfl366v2avpzs1vfw9-ruby3.4-Ascii85-2.0.1 /nix/store/2z3sv273hj48bmbki96mswjpfyg89i7z-ruby3.4-afm-1.0.0 /nix/store/djw3ikyn3gfcmd3pf3s00afva8mr1254-ruby3.4-hashery-2.1.2 /nix/store/7z1r44sklfdaf90kgbq8h57dy1q1rvfr-ruby3.4-ruby-rc4-0.1.5 /nix/store/2jpkc4nywflycl29dqvhj234fn09d1m5-ruby3.4-ttfunk-1.7.0","ruby":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9","src":"/nix/store/95r8w97nxskp15yhzn160lydkh1925yy-pdf-reader-2.15.0.gem","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","suffix":"2.15.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"2.15.0"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"2fifqjdqhi7d11grhxq9j8gsmmnslvik-ruby3.4-hashery-2.1.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"3f4y3dybg07yncnprr1kr6igs1rls0hr-ruby3.4-afm-1.0.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"92l8ia0bclmdl4x585jvzdv3rzp9ajl4-ruby3.4-ttfunk-1.7.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"a2czcdghg0qqjxnpjdyn9f5h613wn4z6-ruby3.4-ruby-rc4-0.1.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"bix427v78zh1wsxzw82ais0szrdba30k-ruby3.4-Ascii85-2.0.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"ry765m05nm93zzffssd58kq2ykpg149v-pdf-reader-2.15.0.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"sk7l7a3hg2rlwk050a510jq9kga8fh3i-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"x21bdkwizrgm5bww1n27lrfhh4w5a8c6-ruby-3.4.9.drv":{"dynamicOutputs":{},