ran_COMPILER:STRING=gfortran -DBUILD_TESTING:BOOL=FALSE -DBINARY:STRING=64 -DNO_AVX512:BOOL=TRUE","configureFlags":"","depsBuildBuild":"/nix/store/d5vr98w5546rdw6vhkgr870h8p4xd5zr-gfortran-wrapper-15.2.0 /nix/store/788mx070y81zjlg5ipcl0cra3afviw9k-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/wqy1iz0fhmar6srmy0mjnfigvp94yg6y-openblas-0.3.32-dev","doCheck":"1","doInstallCheck":"","hardeningDisable":"stackprotector pic strictoverflow relro bindnow","mesonFlags":"","name":"openblas-0.3.32","nativeBuildInputs":"/nix/store/r9941n32g4wyvggz2703dlplbdq8a6rd-cmake-4.1.2","out":"/nix/store/v125s7ad2ni0r1vxw6bp3x0hg0rd403x-openblas-0.3.32","outputs":"out dev","patches":"/nix/store/9x9mhc53cq5n2war1sw7cw68jyc65a0x-cmake-include-fixes.patch /nix/store/gj1a9l1ibiz50ydciwawhvaizpdrxnjy-7086a1b075ca317e12cfe79d40a32ad342a30496.patch /nix/store/h33h0wkqqd4cqhs9hczh3gsy8vra9pbs-3f6e928d34aca977bd5d4191e6d2c2338a342.patch","pname":"openblas","postInstall":"    # Provide headers in /include directly for compat with some consumers like flint\n    (cd $dev/include && ln -sf openblas/*.h .)\n\n    # Write pkgconfig aliases. Upstream report:\n    # https://github.com/OpenMathLib/OpenBLAS/issues/1740\n    for alias in blas cblas lapack; do\n      cat <<EOF > $out/lib/pkgconfig/$alias.pc\nName: $alias\nVersion: 0.3.32\nDescription: $alias provided by the OpenBLAS package.\nCflags: -I$dev/include\nLibs: -L$out/lib -lopenblas\nEOF\n    done\n\n    # Setup symlinks for blas / lapack\nln -s $out/lib/libopenblas.so $out/lib/libblas.so\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so\nln -s $out/lib/libopenblas.so $out/lib/liblapacke.so\nln -s $out/lib/libopenblas.so $out/lib/libblas.so.3\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so.3\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so.3\nln -s $out/lib/libopenblas.so $out/lib/liblapacke.so.3\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/2903gg391javxhn0pqvbmyaqf802s7h2-source","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.3.32"},"inputs":{"drvs":{"038401r3hkmvn1jm4jj25firwgj4nwjl-7086a1b075ca317e12cfe79d40a32ad342a30496.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"8023g2zs18p7fs4yk2c2x4jsrj4s8bww-gfortran-wrapper-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"ksvm0qiqzjsba2gzfnk95742lrcynqbl-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"nf07zwfw22ysq9pbrcy35wc4g6njq0fg-cmake-4.1.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"r734n90bsdwgiwmljk1ck3bv9i04gaaa-3f6e928d34aca977bd5d4191e6d2c2338a342.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"y7wnv3kycy9gpxzwmny1sppi7il9i31a-gcc-wrapper-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["9x9mhc53cq5n2war1sw7cw68jyc65a0x-cmake-include-fixes.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"openblas-0.3.32","outputs":{"dev":{"path":"wqy1iz0fhmar6srmy0mjnfigvp94yg6y-openblas-0.3.32-dev"},"out":{"path":"v125s7ad2ni0r1vxw6bp3x0hg0rd403x-openblas-0.3.32"}},"system":"x86_64-linux","version":4},"cwwkn8im5a6n8pw08bqg4xfzall52d1w-python3.13-editables-0.5.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","env":{"LANG":"C.UTF-8","__structuredAttrs":"","buildInputs":"","builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","catchConflicts":"1","cmakeFla