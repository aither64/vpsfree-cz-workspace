adrq25z7g706r59payzg9x9aa-ruby3.4-Ascii85-2.0.1 /nix/store/9x70akhf3xrmigjy58wdr39cvaych4fs-ruby3.4-afm-1.0.0 /nix/store/jkm472avczh8hwmh9fdny4x6p4m2v1bd-ruby3.4-hashery-2.1.2 /nix/store/nbh73f1fixn1sqbi0sbzlw43p8xkch84-ruby3.4-ruby-rc4-0.1.5 /nix/store/sg6z0ggn1s61wbzrck8i6b3s2wqxz756-ruby3.4-ttfunk-1.7.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-pdf-reader-2.15.0","nativeBuildInputs":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9 /nix/store/7whrgb2wib2q83wgbs78xsq9h25lf3aw-make-shell-wrapper-hook","out":"/nix/store/xw3smrgw1wh9wdr5dkp8v5bpyi99976l-ruby3.4-pdf-reader-2.15.0","outputs":"out","patches":"","pname":"pdf-reader","propagatedBuildInputs":"/nix/store/4jqazcjadrq25z7g706r59payzg9x9aa-ruby3.4-Ascii85-2.0.1 /nix/store/9x70akhf3xrmigjy58wdr39cvaych4fs-ruby3.4-afm-1.0.0 /nix/store/jkm472avczh8hwmh9fdny4x6p4m2v1bd-ruby3.4-hashery-2.1.2 /nix/store/nbh73f1fixn1sqbi0sbzlw43p8xkch84-ruby3.4-ruby-rc4-0.1.5 /nix/store/sg6z0ggn1s61wbzrck8i6b3s2wqxz756-ruby3.4-ttfunk-1.7.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/4jqazcjadrq25z7g706r59payzg9x9aa-ruby3.4-Ascii85-2.0.1 /nix/store/9x70akhf3xrmigjy58wdr39cvaych4fs-ruby3.4-afm-1.0.0 /nix/store/jkm472avczh8hwmh9fdny4x6p4m2v1bd-ruby3.4-hashery-2.1.2 /nix/store/nbh73f1fixn1sqbi0sbzlw43p8xkch84-ruby3.4-ruby-rc4-0.1.5 /nix/store/sg6z0ggn1s61wbzrck8i6b3s2wqxz756-ruby3.4-ttfunk-1.7.0","ruby":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9","src":"/nix/store/95r8w97nxskp15yhzn160lydkh1925yy-pdf-reader-2.15.0.gem","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","suffix":"2.15.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"2.15.0"},"inputs":{"drvs":{"049faz5h2hlc77kx3f6hvc147xrfc1n5-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"38r9xl4mg0hwz6686klwkiqb31yx3mn9-ruby3.4-Ascii85-2.0.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"j7b0s0gxybllmb8hkvr03n1dzhdvh1i9-ruby3.4-ttfunk-1.7.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"jzvlpibyj84j17fxxmrxcv53xa5szpj0-pdf-reader-2.15.0.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"pnw6mfj7qybmpx6sg5brx1vzf4q02rjw-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"x6zpqwddp3fr2lj051q7883d0ig7k23k-ruby3.4-ruby-rc4-0.1.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"xrkw3r9rlr9a4aq54q16fyaapx64sg0l-ruby3.4-hashery-2.1.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"zgad7q6wa0gdwmgd5d9r1hjjj1h3ddnz-ruby3.4-afm-1.0.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-pdf-reader-2.15.0","outputs":{"out":{"path":"xw3smrgw1wh9wdr5dkp8v5bpyi99976l-ruby3.4-pdf-reader-2.15.0"}},"system":"x86_64-linux","version":4},"y50qj1dqhzshhm1l64pi8qdb64zy011q-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/n4rqq7q61svya8gz4b9m0ac554bvmcb1-so