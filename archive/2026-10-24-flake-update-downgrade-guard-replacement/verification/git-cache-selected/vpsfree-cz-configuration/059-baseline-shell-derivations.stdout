{"dynamicOutputs":{},"outputs":["bin","out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"__getdirentries-builder","outputs":{"out":{"path":"6zk9ng27m4k4qrmfj8nf7pnjgv3pja24-__getdirentries-builder"}},"system":"x86_64-linux","version":4},"3kars6rqghqm9c5pywj2k3qpmvwxk069-ruby3.4-strings-0.2.1.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","env":{"NIX_CFLAGS_COMPILE":"","NIX_MAIN_PROGRAM":"strings","__structuredAttrs":"","buildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9","buildPhase":"runHook preBuild\n\nif [[ \"$gemType\" == \"gem\" ]]; then\n  if [[ -z \"$gemspec\" ]]; then\n    gemspec=\"$(find . -name '*.gemspec')\"\n    echo \"found the following gemspecs:\"\n    echo \"$gemspec\"\n    gemspec=\"$(echo \"$gemspec\" | head -n1)\"\n  fi\n\n  exec 3>&1\n  output=\"$(gem build $gemspec | tee >(cat - >&3))\"\n  exec 3>&-\n\n  gempkg=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"strings-ansi unicode-display_width unicode_utils","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"strings","gemPath":"/nix/store/d736dxvmgni3nh0vic7ac8m0prfwdxg0-ruby3.4-strings-ansi-0.2.0 /nix/store/50ifkqbndy7qh447ar00c03xpr963m95-ruby3.4-unicode-display_width-2.6.0 /nix/store/15sfhxd2d3s3hd0ckk44j5q98298fc45-ruby3.4-unicode_utils-1.4.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-strings-0.2.1","nativeBuildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9 /nix/store/qw8rpqmndqzyc3fzzla754v5hlpm10i4-make-shell-wrapper-hook","out":"/nix/store/15q42ppkplz4g2d1vx97ifafx6k2iskg-ruby3.4-strings-0.2.1","outputs":"out","patches":"","pname":"strings","propagatedBuildInputs":"/nix/store/d736dxvmgni3nh0vic7ac8m0prfwdxg0-ruby3.4-strings-ansi-0.2.0 /nix/store/50ifkqbndy7qh447ar00c03xpr963m95-ruby3.4-unicode-display_width-2.6.0 /nix/store/15sfhxd2d3s3hd0ckk44j5q98298fc45-ruby3.4-unicode_utils-1.4.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/d736dxvmgni3nh0vic7ac8m0prfwdxg0-ruby3.4-strings-ansi-0.2.0 /nix/store/50ifkqbndy7qh447ar00c03xpr963m95-ruby3.4-unicode-display_width-2.6.0 /nix/store/15sfhxd2d3s3hd0ckk44j5q98298fc45-ruby3.4-unicode_utils-1.4.0","ruby":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9","src":"/nix/store/6whfby7pdi1a0xqx10d5xkbjway1m97c-strings-0.2.1.gem","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","suffix":"0.2.1","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"0.2.1"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"6l3xd35cjmxaf8mf3kzcl4sjncvrkvba-ruby3.4-unicode_utils-1.4.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"bb02gddhnhmr9xpp04pp9f84sgj3b7zm-ruby3.4-unicode-display_width-2.6.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"sk7l7a3hg2rlwk050a510jq9kga8fh3i-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"valh47smwmr95cymri1css6d5nx39aiq-strings-0.2.1.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"x21bdkwizrgm5bww1n27lrfhh4w5a8c6-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"y9h5wx0bpix78jzipnma080lr3cjqix7-ruby3.4-strings-ansi-0.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-strings-0.2.1","outputs":{"out":{"path":"15q42ppkplz4g2d1vx97ifafx6k2iskg-ruby3.4-strings-0.2.1"}},"system":"x86_64-linux","version":4},"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash","env":{"FORCE_UNSAFE_CONFIGURE":"","NIX_CFLAGS_COMPILE":"","NIX_HARDENING_ENABLE":"bindnow format fortify fortify3 libcxxhardeningfast pic relro stackclashprotection stackprotector strictflexarrays1 strictoverflow zerocallusedregs","NIX_LDFLAGS":"","__structuredAttrs":"","buildInputs":"/nix/store/xklk0y1rk34f9x6qbbwxliy3y8kglhpd-acl-2.4.0-dev /nix/store/lmb3zn9pn4iippigghm8mas6w5ip0mzs-attr-2.6.0-dev /nix/store/h4rklarl4033ws91kz6b6psmlcqhljjp-gmp-with-cxx-6.3.0-dev","builder":"/nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash","cmakeFlags":"","configureFlags":"--with-packager=https://nixos.org --with-selinux --enable-install-program=kill,uptime --enable-single-binary=symlinks gl_cv_have_proc_uptime=yes","debug":"/nix/store/27ppi1aw9711bjhds28qlpaz7mhcq7dl-coreutils-9.11-debug","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"1","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"trivialautovarinit","info":"/nix/store/8gc7xlhafbwi95pyvsl1qllxylxbli5f-coreutils-9.11-info","mesonFlags":"","name":"coreutils-9.11","nativeBuildInputs":"/nix/store/rcjsw56ixsmmybxf27qf1d3xx2zdg1p7-perl-5.42.3 /nix/store/fr31df17rksfki6nv00xq4s5apvqpyhw-xz-5.8.4-bin /nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11","outputs":"out info debug","patches":"/nix/store/7d47dgqxcn66f5zgvrc5byhbshwr8rpw-CVE-2026-56391.patch /nix/store/ri503nkqxyqg8j0dcqd8jd1jzhryszsk-CVE-2026-56392.patch","pname":"coreutils","postInstall":"rm -r \"$out/share\"\n","postPatch":"# The test tends to fail on btrfs, f2fs and maybe other unusual filesystems.\nsed '2i echo Skipping dd sparse test && exit 77' -i ./tests/dd/sparse.sh\nsed '2i echo Skipping du threshold test && exit 77' -i ./tests/du/threshold.sh\nsed '2i echo Skipping cp reflink-auto test && exit 77' -i ./tests/cp/reflink-auto.sh\nsed '2i echo Skipping cp sparse test && exit 77' -i ./tests/cp/sparse.sh\nsed '2i echo Skipping env test && exit 77' -i ./tests/env/env.sh\nsed '2i echo Skipping rm deep-2 test && exit 77' -i ./tests/rm/deep-2.sh\nsed '2i echo Skipping du long-from-unreadable test && exit 77' -i ./tests/du/long-from-unreadable.sh\n\n# The test tends to fail on cephfs\nsed '2i echo Skipping df total-verify test && exit 77' -i ./tests/df/total-verify.sh\n\n# Some target platforms, especially when building inside a container have\n# issues with the inotify test.\nsed '2i echo Skipping tail inotify dir recreate test && exit 77' -i ./tests/tail/inotify-dir-recreate.sh\n\n# sandbox does not allow setgid\nsed '2i echo Skipping chmod setgid test && exit 77' -i ./tests/chmod/setgid.sh\nsubstituteInPlace ./tests/install/install-C.sh \\\n  --replace 'mode3=2755' 'mode3=1755'\n\n# Fails on systems with a rootfs. Looks like a bug in the test, see\n# https://lists.gnu.org/archive/html/bug-coreutils/2019-12/msg00000.html\nsed '2i print \"Skipping df skip-rootfs test\"; exit 77' -i ./tests/df/skip-rootfs.sh\n\n# these tests fail in the unprivileged nix sandbox (without nix-daemon) as we break posix assumptions\nfor f in ./tests/chgrp/{basic.sh,recurse.sh,default-no-deref.sh,no-x.sh,posix-H.sh}; do\n  sed '2i echo Skipping chgrp && exit 77' -i \"$f\"\ndone\nfor f in gnulib-tests/{test-chown.c,test-fchownat.c,test-lchown.c}; do\n  echo \"int main() { return 77; }\" > \"$f\"\ndone\n\n# We don't have localtime in the sandbox\nfor f in gnulib-tests/{test-localtime_r.c,test-localtime_r-mt.c}; do\n  echo \"int main() { return 77; }\" > \"$f\"\ndone\n\n# These tests sometimes fail on ZFS-backed NFS filesystems\nsed '2i echo \"Skipping test: fails on zfs \" && exit 77' -i gnulib-tests/test-file-has-acl-1.sh\nsed '2i echo \"Skipping test: fails on zfs \" && exit 77' -i gnulib-tests/test-set-mode-acl-1.sh\nsed '2i echo \"Skipping test: ls/removed-directory\" && exit 77' -i ./tests/ls/removed-directory.sh\n\n# intermittent failures on builders, unknown reason\nsed '2i echo Skipping du basic test && exit 77' -i ./tests/du/basic.sh\n\n# flaky on some filesystems due to non-deterministic disk usage\nsed '2i echo Skipping du deref test && exit 77' -i ./tests/du/deref.sh\nsed '2i echo Skipping du inacc-dir test && exit 77' -i ./tests/du/inacc-dir.sh\n\n# fails when syscalls related to acl not being available, e.g. in sandboxed environment\nsed '2i echo Skipping ls -al with acl test && exit 77' -i ./tests/ls/acl.sh\n","preInstall":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","src":"/nix/store/p59cz49l5faa67c72wxdql3jfj9gy2fn-coreutils-9.11.tar.xz","stdenv":"/nix/store/kf7zrrw232m1zdklzdx6kcgl34xqsm9l-bootstrap-stage4-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"9.11"},"inputs":{"drvs":{"0nrb3h17g2hhf8ijisi7frcfvqwhya3w-coreutils-9.11.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"1bivb8zg4ard4419zkpdh1m4m5w0wrds-gmp-with-cxx-6.3.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"2vp90ljr3dyk45rjyqaidqj3a69n2fny-perl-5.42.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"6qdkyginmgiq4ing2w0mg7nhh6hwgcir-acl-2.4.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"8skcqy8js62jn5mcwa3rkmnzwchk7szl-attr-2.6.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"rz72y4sgpjqm7f85w1zk6xpxs2q69hwq-bootstrap-stage4-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"spy1vhzw07pnzbk2c5lvcljb66ckzwr8-xz-5.8.4.drv":{"dynamicOutputs":{},"outputs":["bin"]},"zv2kqb8hbz2bhvsikii3cxh49gdsy1l9-bash-static-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["7d47dgqxcn66f5zgvrc5byhbshwr8rpw-CVE-2026-56391.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","ri503nkqxyqg8j0dcqd8jd1jzhryszsk-CVE-2026-56392.patch","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"coreutils-9.11","outputs":{"debug":{"path":"27ppi1aw9711bjhds28qlpaz7mhcq7dl-coreutils-9.11-debug"},"info":{"path":"8gc7xlhafbwi95pyvsl1qllxylxbli5f-coreutils-9.11-info"},"out":{"path":"bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11"}},"system":"x86_64-linux","version":4},"3l89d34bc9vraawapkrxpxfnw6vh3ryq-texinfo-7.2.drv":{"args":["-e","/nix/store/l62