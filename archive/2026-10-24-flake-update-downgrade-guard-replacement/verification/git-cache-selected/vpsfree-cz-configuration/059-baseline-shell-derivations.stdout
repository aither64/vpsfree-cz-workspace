 zerocallusedregs","__structuredAttrs":"","bin":"/nix/store/ymf24x6ky7bz2fayh7y4bca219yabacb-musl-1.2.5-bin","buildInputs":"","builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"--enable-shared --enable-static --enable-debug --enable-wrapper=all --syslibdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib","debug":"/nix/store/4ysn3jvzlq2agayscmpr26yx0cnjc7v4-musl-1.2.5-debug","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/0w09dvhfkmznqqbh18f3svpglnjcwn55-musl-1.2.5-dev","doCheck":"","doInstallCheck":"","dontAddStaticConfigureFlags":"1","dontDisableStatic":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"stackprotector","mesonFlags":"","name":"musl-1.2.5","nativeBuildInputs":"/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/hy46ywhxza3qxq5vl3vqmzn6kfmmqihy-musl-1.2.5","outputs":"out bin dev debug","patches":"/nix/store/mdmbvb93z195n3bij8pa838v3safw346-300-relative.patch /nix/store/72fpjkqigm2ssmzsajvcar5g8vb86q4n-CVE-2025-26519_0.patch /nix/store/54zx02rd8drmrcq3i69y93srfxs5dnjf-CVE-2025-26519_1.patch /nix/store/ym7qvxyrjvqqp5y9mfmgs909k410w6gk-stdio-skip-empty-iovec-when-buffering-is-disabled.patch","pname":"musl","postInstall":"# Not sure why, but link in all but scsi directory as that's what uclibc/glibc do.\n# Apparently glibc provides scsi itself?\n(cd $dev/include && ln -s $(ls -d /nix/store/d7dp8n370drwix07l0m11zfzq45ya2sm-linux-headers-6.18.7/include/* | grep -v \"scsi$\") .)\n\n\n\n# Create 'ldd' symlink, builtin\nln -s $out/lib/libc.so $bin/bin/ldd\n\n# (impure) cc wrapper around musl for interactive usuage\nfor i in musl-gcc musl-clang ld.musl-clang; do\n  moveToOutput bin/$i $dev\ndone\nmoveToOutput lib/musl-gcc.specs $dev\nsubstituteInPlace $dev/bin/musl-gcc \\\n  --replace $out/lib/musl-gcc.specs $dev/lib/musl-gcc.specs\n\n# provide 'iconv' utility, using just-built headers, libc/ldso\n$CC /nix/store/2bim63kxh3vi6ka6inclfpba9rsjj6v9-iconv.c -o $bin/bin/iconv \\\n  -I$dev/include \\\n  -L$out/lib -Wl,-rpath=$out/lib \\\n  -lc \\\n  -B $out/lib \\\n  -Wl,-dynamic-linker=$(ls $out/lib/ld-*)\n# Create 'libc.musl-$arch' symlink\nln -rs $out/lib/libc.so $out/lib/libc.musl-x86_64.so.1\ninstall -D /nix/store/5rcakigix8xmpkmcx90a083pkf8v0gwp-sys-queue.h $dev/include/sys/queue.h\ninstall -D /nix/store/byib83r321c1fjgdk37kai1q1zxncra7-sys-cdefs.h $dev/include/sys/cdefs.h\ninstall -D /nix/store/rnay1kyfxqvjhmk0bfj7g85q6zskk1xy-sys-tree.h $dev/include/sys/tree.h\n","postPatch":"substituteInPlace configure \\\n  --replace -fno-unwind-tables \"\" \\\n  --replace -fno-asynchronous-unwind-tables \"\"\n","preBuild":"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","src":"/nix/store/mp8mmm58idwnlcla8fb2d3289q9m2b26-musl-1.2.5.tar.gz","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.2.5"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"3f4qxh17rc0mjp50dr87jh0drsq1w4zj-linux-headers-6.18.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"55yx6s9fclxid2rqxrz8n3zlsrh3bkr1-iconv.c.drv":{"dynamicOutputs":{},"outputs":["out"]},"b8sadxj5kp7lz293l9kpq1rw611li236-musl-1.2.5.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"hxyj4yfpss7fy29331bzwg8ndavn7fzw-sys-cdefs.h.drv":{"dynamicOutputs":{},"outputs":["out"]},"jlp02rmdmfmixf5f8wd0wa3i96lmzqgm-sys-queue.h.drv":{"dynamicOutputs":{},"outputs":["out"]},"kd5zr9sdlhdwb2djrngcxiv3llp3mnc6-CVE-2025-26519_1.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"lc7zbhnzv4gw25cd75yk6j2p5530glhz-300-relative.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"m9mxz21d2024i95jq0l0a6dfbwdkkrci-CVE-202