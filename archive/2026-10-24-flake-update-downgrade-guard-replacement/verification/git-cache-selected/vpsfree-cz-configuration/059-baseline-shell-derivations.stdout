Output \"bin/lastlog2\" \"$lastlog\"\nln -svf \"$lastlog/bin/\"* $bin/bin/\nmoveToOutput \"lib/systemd/system/lastlog2-import.service\" \"$lastlog\"\nsubstituteInPlace $lastlog/lib/systemd/system/lastlog2-import.service \\\n  --replace-fail \"/usr/bin/mv\" \"/nix/store/9ypz3flqsrl5xl495mm8h645gadjsxi1-coreutils-9.11/bin/mv\" \\\n  --replace-fail \"$bin/bin/lastlog2\" \"$lastlog/bin/lastlog2\"\n","postPatch":"patchShebangs tests/run.sh tools/all_syscalls tools/all_errnos\n\nsubstituteInPlace sys-utils/eject.c \\\n  --replace-fail \"/bin/umount\" \"$bin/bin/umount\"\n\n# fix `mount -t` tab completion\nsubstituteInPlace bash-completion/{blkid,mount,umount} \\\n  --replace-fail \"/lib/modules\" \"/run/booted-system/kernel-modules/lib/modules\"\nsubstituteInPlace include/pathnames.h \\\n  --replace-fail \"/bin/login\" \"/nix/store/5yag29f2jzp10wk2kqadlgn70x9i1wqf-shadow-4.19.4/bin/login\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","src":"/nix/store/g7qkkwfpiq0gaby1h5ddm3brzakxk9w8-util-linux-2.42.tar.xz","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","swap":"/nix/store/qh6pjyg8bihh2dinfd1qcz0k8ac4h5z2-util-linux-2.42-swap","system":"x86_64-linux","version":"2.42"},"inputs":{"drvs":{"0712vvprb2p791b4hb7b4ybikrlkx0kd-perl5.42.0-po4a-0.74.drv":{"dynamicOutputs":{},"outputs":["out"]},"08fg4a5d85pnlagm8qrk1pga0zkyjsxm-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"2q9wilgnr1y9cakqi63jjafghm2sns2k-shadow-4.19.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"8yh2g6iawbghy2gacnzys7l1fxq3rhji-script-fix-backwards-compat.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"92xdzkimaan760r0xbs0s2dpmc90cv7a-script-fix-memory-leaks.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"ada2vbvrz39j7vwr42rc8s7zz8r426b6-autoconf-2.73.drv":{"dynamicOutputs":{},"outputs":["out"]},"c31mrkf6n1rm83cpz0w9h4a5imfg