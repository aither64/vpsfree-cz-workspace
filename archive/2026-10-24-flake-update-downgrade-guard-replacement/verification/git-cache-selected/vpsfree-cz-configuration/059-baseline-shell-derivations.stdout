989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/9kxawn0jm6rvszxa1p4qwpvs8dwimv3i-nix-flake-c-2.34.9","outputs":"out dev debug","patches":"","pname":"nix-flake-c","preConfigure":"case \"$mesonBuildType\" in\nrelease|minsize) appendToVar mesonFlags \"-Db_lto=true\"  ;;\n*)               appendToVar mesonFlags \"-Db_lto=false\" ;;\nesac\nchmod u+w ./.version\necho 2.34.9 > ./.version\nexport CFLAGS=\"${CFLAGS:-} -fno-semantic-interposition -Wl,-Bsymbolic-functions\"\nexport CXXFLAGS=\"${CXXFLAGS:-} -fno-semantic-interposition -Wl,-Bsymbolic-functions\"\n","propagatedBuildInputs":"/nix/store/sasvwkpya66vypl32imdca1bd03fvrrl-nix-expr-c-2.34.9-dev /nix/store/f859ciaa0aqgvl49axqjsfmykl5dcs7p-nix-store-c-2.34.9-dev /nix/store/dhvk1pfds3csamm6k34xxm9sl1zy9d1v-nix-fetchers-c-2.34.9-dev /nix/store/3mwy9lkfv2p5s4cny51x88kfhv1ddjsp-nix-flake-2.34.9-dev","propagatedNativeBuildInputs":"","separateDebugInfo":"1","sourceRoot":"source/./src/libflake-c","src":"/nix/store/jmm4j1jgrcdsgvigsjgsnxg2iz5p1vvm-source","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.34.9"},"inputs":{"drvs":{"18yw9jwipv30sd4g95wnrdszh5r20b91-nix-fetchers-c-2.34.9.drv":{"dynamicOutputs":{},"outputs":["dev"]},"2i7prvz6cdf1l28g0nb5fybnrhzpzw5k-meson-1.10.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"63zjnxw73yn1avnz9vcsb4hjlsvd0gls-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6dkndf5nwmmpsdzb2vcs34hyky0jxkqf-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"f7h4iwzb98cg1k2p1ss817bjxz1sckx3-nix-expr-c-2.34.9.drv":{"dynamicOutputs":{},"outputs":["dev"]},"m6b8286d4pf752545lzs6n9q8r3n86c0-ninja-1.13.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"qnr57sw5d8db4vk86kzwcvj99dgh2rng-nix-flake-2.34.9.drv":{"dynami