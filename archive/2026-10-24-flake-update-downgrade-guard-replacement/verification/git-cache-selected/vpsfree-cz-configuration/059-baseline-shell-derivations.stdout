tore/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"activesupport highline json require_all rest-client ruby-progressbar","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"haveapi-client","gemPath":"/nix/store/g024zvqi6gpdkgisdn8kx0drk80xqamw-ruby3.4-activesupport-8.1.2 /nix/store/4mhna0w0xikx8cp6fffzndz42wrfh17q-ruby3.4-highline-3.1.2 /nix/store/ppgc23lwzmpnw0gxmjslrsv2bmv9rn87-ruby3.4-json-2.18.1 /nix/store/r61b0lvvl43ailwv415c3g68s6sz886r-ruby3.4-require_all-2.0.0 /nix/store/6mq171qbn0dlmkw6n1yz29cmfidca1bz-ruby3.4-rest-client-2.1.0 /nix/store/i7qbgw5zl74b8h1nsvvw559ccc18yvhk-ruby3.4-ruby-progressbar-1.13.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-haveapi-client-0.26.5","nativeBuildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9 /nix/store/qw8rpqmndqzyc3fzzla754v5hlpm10i4-make-shell-wrapper-hook","out":"/nix/store/pgz609zl4bij4rifvjwispdx7kpvf883-ruby3.4-haveapi-client-0.26.5","outputs":"out","patches":"","pname":"haveapi-client","propagatedBuildInputs":"/nix/store/g024zvqi6gpdkgisdn8kx0drk80xqamw-ruby3.4-activesupport-8.1.2 /nix/store/4mhna0w0xikx8cp6fffzndz42wrfh17q-ruby3.4-highline-3.1.2 /nix/store/ppgc23lwzmpnw0gxmjslrsv2bmv9rn87-ruby3.4-json-2.18.1 /nix/store/r61b0lvvl43ailwv415c3g68s6sz886r-ruby3.4-require_all-2.0.0 /nix/store/6mq171qbn0dlmkw6n1yz29cmfidca1bz-ruby3.4-rest-client-2.1.0 /nix/store/i7qbgw5zl74b8h1nsvvw559ccc18yvhk-ruby3.4-ruby-progressbar-1.13.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/g024zvqi6gpdkgisdn8kx0drk80xqamw-ruby3.4-activesupport-8.1.2 /nix/store/4mhna0w0xikx8cp6fffzndz42wrfh17q-ruby3.4-highline-3.1.2 /nix/store/ppgc23lwzmpnw0gxmjslrsv2bmv9rn87-ruby3.4-json-2.18.1 /nix/store/r61b0lvvl43ailwv415c3g68s6sz886r-ruby3.4-require_all-2.0.0 /nix/store/6mq171qbn0dlmkw6n1yz29cmfidca1bz-ruby3.4-rest