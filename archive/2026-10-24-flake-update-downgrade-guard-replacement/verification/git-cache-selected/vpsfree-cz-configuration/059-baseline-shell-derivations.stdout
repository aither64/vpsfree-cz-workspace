fi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/81ff57hcs8gjlnaqqhbilzxsvb5pfzaa-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://gitweb.gentoo.org/repo/gentoo.git/plain/app-text/opensp/files/opensp-1.5.2-gcc15-musl.patch?id=7143f4a01836f8991d6c90b61fa919e88bf9a0fd"]},"system":"x86_64-linux","version":4},"13qmmi12f1pb05zb8rii45l3v57d9gyg-nothunks-0.3.1.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/y2bnhvmx2j2igw7ad1jf22kp1dlk8pg2-nothunks-0.3.1.tar.gz"},"inputs":{"drvs":{"3fc7klhja3mn322hjxl4bax4mk3m6h8l-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"nccfw1s0py9wvalrf7s92cfmg7bijj0i-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"]},"name":"nothunks-0.3.1.tar.gz","outputs":{"out":{"hash":"sha256-N4P5Uv5EjtND9U/Bh7G3wGJEODjO9xxUnpGCe8l+l10=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":[],"configureFlags":[],"curlOpts":"","curlOptsList":[],"depsBuildBuild":[],"depsBuildBuildP