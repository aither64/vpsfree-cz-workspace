ll\n\n./Setup copy \nlocal packageConfDir=\"$out/lib/ghc-9.10.3/lib/package.conf.d\"\nlocal packageConfFile=\"$packageConfDir/prettyprinter-compat-ansi-wl-pprint-1.0.2.conf\"\nmkdir -p \"$packageConfDir\"\n./Setup register --gen-pkg-config=$packageConfFile\nif [ -d \"$packageConfFile\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/prettyprinter-compat-ansi-wl-pprint-1.0.2\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"prettyprinter-compat-ansi-wl-pprint-1.0.2","nativeBuildInputs":"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3 /nix/store/svrzimmpgp5b9knw00b7cq6081hwadaz-remove-references-to","out":"/nix/store/x9k8a2qb0800wz7ygrch5r2vghx4xkcb-prettyprinter-compat-ansi-wl-pprint-1.0.2","outputs":"out doc","patches":"","pname":"prettyprinter-compat-ansi-wl-pprint","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":" /nix/store/xj0wr6b6yi39405x8lyv096k5pddkhvd-prettyprinter-1.7.1 /nix/store/pdfrnilbgrajagrjghs47lqjp64n9fqn-prettyprinter-ansi-terminal-1.1.3 ","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3.\"\nexport PATH=/nix/store/kg9hwh3pyb3lh41cfs5ym54xy4qymks1-hscolour-1.25/bin:$PATH\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname  --docdir=$doc/share/doc/prettyprinter-compat-ansi-wl-pprint-1.0.2 --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --enable-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --enable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/35pk5p36q1aqn4la63a6fxmawm0cg15f-prettyprinter-compat-ansi-wl-pprint-1.0.2.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.0.2"},"inputs":{"drvs":{"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"3wl3zw8f6dal8xbqwgzpns0gn02dq59y-prettyprinter-1.7.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"7v69i4ixacxjdan9gx0h4j9q0g3jv11k-glibc-locales-2.42-100.drv":{"dynamicOutputs":{},"outputs":["out"]},"d22jg4nh7xm8mdw99p176dw8j35lhrsk-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"h8nj936jnkjrv6af2h9sf0vgik5z5g78-hscol