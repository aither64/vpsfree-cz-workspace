ho \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"base64 curses haveapi-client json","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"vpsadmin-client","gemPath":"/nix/store/wh9788wb2mn4i3zp5lwdn4fnh9425kna-ruby3.4-base64-0.3.0 /nix/store/24cm96720gg40dq1hkfg868b8bd5287w-ruby3.4-curses-1.5.3 /nix/store/pgz609zl4bij4rifvjwispdx7kpvf883-ruby3.4-haveapi-client-0.26.5 /nix/store/ppgc23lwzmpnw0gxmjslrsv2bmv9rn87-ruby3.4-json-2.18.1","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-vpsadmin-client-4.1.0","nativeBuildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9 /nix/store/qw8rpqmndqzyc3fzzla754v5hlpm10i4-make-shell-wrapper-hook","out":"/nix/store/maf5dq51qfljvbakhdsn8zak07l2d68i-ruby3.4-vpsadmin-client-4.1.0","outputs":"out","patches":"","pname":"vpsadmin-client","propagatedBuildInputs":"/nix/store/wh9788wb2mn4i3zp5lwdn4fnh9425kna-ruby3.4-base64-0.3.0 /nix/store/24cm96720gg40dq1hkfg868b8bd5287w-ruby3.4-curses-1.5.3 /nix/store/pgz609zl4bij4rifvjwispdx7kpvf883-ruby3.4-haveapi-client-0.26.5 /nix/store/ppgc23lwzmpnw0gxmjslrsv2bmv9rn87-ruby3.4-json-2.18.1","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/wh9788wb2mn4i3zp5lwdn4fnh9425kna-ruby3.4-base64-0.3.0 /nix/store/24cm96720gg40dq1hkfg868b8bd5287w-ruby3.4-curses-1.5.3 /nix/store/pgz609zl4bij4rifvjwispdx7kpvf883-ruby3.4-haveapi-client-0.26.5 /nix/store/ppgc23lwzmpnw0gxmjslrsv2bmv9rn87-ruby3.4-json-2.18.1","ruby":"/nix/store/lkrkc1f