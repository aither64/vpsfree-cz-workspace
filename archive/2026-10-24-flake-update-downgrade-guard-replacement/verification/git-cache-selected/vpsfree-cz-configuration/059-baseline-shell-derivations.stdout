kgs because neqn exec's eqn,\n# but eqn, isn't in the PATH in the nixpkgs test env, to remedy\n# that GROFF_BIN_PATH is set as follows:\nexport GROFF_BIN_PATH=.\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/nz9gcn9abrijg1pxv13xflhvpiay31ky-groff-1.24.2.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"1.24.2"},"inputs":{"drvs":{"63zjnxw73yn1avnz9vcsb4hjlsvd0gls-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6g4n5z9fkk1yhavy5la9zp9bk8jfsc2v-groff-1.24.2.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"l225yn472rkgc8370h2z8nrf5x17hdh3-texinfo-7.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"qnl1kmb1fa72iv8s4168g5b2pc75qpm0-autoreconf-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"z2gsgvxwwcd0snpjsl2rpjz3cjqm3nqg-perl-5.42.3.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["1diimhjq1fbjdxr50ap0iawp79mj9dvb-site.tmac","av6kr2l7nf0f12f3gg3gjs35y9np5r6r-0001-Revert-man-Fix-Savannah-65190.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"groff-1.24.2","outputs":{"doc":{"path":"q3bba5fgfvsb5kc3aa0lpbdf7nyixm8p-groff-1.24.2-doc"},"info":{"path":"r1bl5i8l12515v1qsrschyfm786j806b-groff-1.24.2-info"},"man":{"path":"f1g2h0367rvqmzpgfmgiqizpnjmkxn9s-groff-1.24.2-man"},"out":{"path":"yb5g8vgvkfbaix9s1lbx3gqdp1c3pyl2-groff-1.24.2"},"perl":{"path":"v421j4q1xkrijfskylvq7vkgx07idwq2-groff-1.24.2-perl"}},"system":"x86_64-linux","version":4},"qp9mn19nkyp680m55w409i550zni62gh-modechange.patch.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"builtin:fetchurl","executable":"","impureEnvVars":"http_proxy https_proxy ftp_proxy all_proxy no_proxy","name":"modechange.patch",