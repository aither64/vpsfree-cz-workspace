4-unknown-linux-gnu\".crt-static=false","--enable-llvm-link-shared","--set=target.\"x86_64-unknown-linux-gnu\".llvm-config=/nix/store/vdnbszmf97i2n8vcqgq8r362a9xnzjdm-llvm-21.1.8-dev/bin/llvm-config","--set=target.\"x86_64-unknown-linux-gnu\".llvm-config=/nix/store/vdnbszmf97i2n8vcqgq8r362a9xnzjdm-llvm-21.1.8-dev/bin/llvm-config","--set=target.\"x86_64-unknown-linux-gnu\".llvm-config=/nix/store/vdnbszmf97i2n8vcqgq8r362a9xnzjdm-llvm-21.1.8-dev/bin/llvm-config","--set=target.wasm32-unknown-unknown.optimized-compiler-builtins=false","--set=target.wasm32v1-none.optimized-compiler-builtins=false","--enable-profiler","--set=rust.frame-pointers"],"configurePlatforms":[],"depsBuildBuild":["/nix/store/dy6j7267wrgjlr2z748sbx83zj16vs3c-gcc-wrapper-15.3.0","/nix/store/viqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2"],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"dontFixLibtool":true,"dontUpdateAutotoolsGnuConfigScripts":true,"dontUseCmakeConfigure":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"NIX_LDFLAGS":"--push-state --as-needed -lstdc++ --pop-state","NIX_MAIN_PROGRAM":"rustc","RUSTDOCFLAGS":"-A rustdoc::broken-intra-doc-links","RUSTFLAGS":"-Ccodegen-units=10 -Clinker-features=-lld -Clink-self-contained=-linker"},"mesonFlags":[],"name":"rustc-1.95.0","nativeBuildInputs":["/nix/store/wm7zx3imgww59ijma3i3zkxy9537mkxn-file-5.47-dev","/nix/store/jy00n3jp5xj8s40n1fbldmkcr5n7avxc-python3-3.13.15","/nix/store/w4kp88zdrd3vclyivqzbxrad5x9kqnqs-rustc-bootstrap-wrapper-1.95.0","/nix/store/v4m910fin3csvzhv8pq6aivvi6ghmzmp-cmake-4.1.6","/nix/store/dh0mfzvrz8s6pw7vqlbrik09nwwjf65g-which-2.23","/nix/store/vaf7c4aslgbislz4dmfjk950iwrlqdfl-libffi-3.8.0-dev","/nix/store/svrzimmpgp5b9knw00b7cq6081hwadaz-remove-references-to","/nix/store/viqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2","/nix/store/n133n8ir697g70mvzcdw669qfa69pibl-xz-5.8.4-dev"],"outputChecks":{"doc":{},"man":{},"out":{}},"outputs":["out","man","doc"],"patches":[],"pname":"rustc","postInstall":"# install rustc-dev components. Necessary to build rls, clippy...\npython x.py dist rustc-dev\ntar xf build/dist/rustc-dev*tar.gz\ncp -r rustc-dev*/rustc-dev*/lib/* $out/lib/\nrm $out/lib/rustlib/install.log\nfor m in $out/lib/rustlib/manifest-rust*\ndo\n  sort --output=$m < $m\ndone\n\n# remove references to llvm-config in lib/rustlib/x86_64-unknown-linux-gnu/codegen-backends/librustc_codegen_llvm-llvm.so\n# and thus a transitive dependency on ncurses\nfind $out/lib -name \"*.so\" -type f -exec remove-references-to -t /nix/store/vravw6d9gh8vmbmmfs5qbgq4nqrmi2y5-llvm-21.1.8 '{}' '+'\n\n# remove uninstall script that doesn't really make sense for Nix.\nrm $out/lib/rustlib/uninstall.sh\n","postPatch":"patchShebangs src/etc\n\n# rust-lld is the name rustup uses for its bundled lld, so that it\n# doesn't conflict with any system lld.  This is not an\n# appropriate default for Nixpkgs, where there is no rust-lld.\nsubstituteInPlace compiler/rustc_target/src/spec/*/*.rs \\\n  --replace-quiet '\"rust-lld\"' '\"lld\"'\n\nrm -rf src/llvm\n\n# Useful debugging parameter\n# export VERBOSE=1\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"setOutputFlags":false,"setupHooks":"/nix/store/skyp8xs2584fkc44ki1cim9ag55wbi68-setup-hook.sh","src":"/nix/store/6wq4v4hfgx2875qszshp9x06wmlc5z65-rustc-1.95.0-src.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":false,"stripDebugList":["bin"],"system":"x86_64-linux","version":"1.95.0"},"system":"x86_64-linux","version":4},"wb8cjvl3sciyqz1kprm42c9paqsvb8sk-help2man-1.49.3.tar.xz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/n