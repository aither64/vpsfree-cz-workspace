For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-activesupport-8.1.2","nativeBuildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9 /nix/store/qw8rpqmndqzyc3fzzla754v5hlpm10i4-make-shell-wrapper-hook","out":"/nix/store/g024zvqi6gpdkgisdn8kx0drk80xqamw-ruby3.4-activesupport-8.1.2","outputs":"out","patches":"","pname":"activesupport","propagatedBuildInputs":"/nix/store/wh9788wb2mn4i3zp5lwdn4fnh9425kna-ruby3.4-base64-0.3.0 /nix/store/ax7ylag3174bw61sa8p1yww90mqvirmc-ruby3.4-bigdecimal-4.0.1 /nix/store/isligyw3gi1ni3j37s3vhl2dvnhjj6n4-ruby3.4-concurrent-ruby-1.3.6 /nix/store/f3wm2jb4agsksqki43kjrrvia80flzrw-ruby3.4-connection_pool-3.0.2 /nix/store/fha3y6k1qm9dv20z8d3xd0bb3gfblf76-ruby3.4-drb-2.2.3 /nix/store/fqcgsp1b678vfpai57jfzpgvkr1dzdf9-ruby3.4-i18n-1.14.8 /nix/store/ppgc23lwzmpnw0gxmjslrsv2bmv9rn87-ruby3.4-json-2.18.1 /nix/store/3yfk10vhiknln15vhn33wrzgwy4mqnl5-ruby3.4-logger-1.7.0 /nix/store/kd8vs585qvynkclrnxrk6ai914js466r-ruby3.4-minitest-6.0.2 /nix/store/niblw87rqsmid2x6wlpmg80k6gpq7j80-ruby3.4-securerandom-0.4.1 /nix/store/zhnw1scl1v3hwvfr3hnywasmsgndkfnh-ruby3.4-tzinfo-2.0.6 /nix/store/z2g3xwgqfkmp2iyavrajd68x337x5p1p-ruby3.4-uri-1.1.1","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/wh9788wb2mn4i3zp5lwdn4fnh9425kna-ruby3.4-base64-0.3.0 /nix/store/ax7ylag3174bw61sa8p1yww90mqvirmc-ruby3.4-bigdecimal-4.0.1 /nix/store/isligyw3gi1ni3j37s3vhl2dvnhjj6n4-ruby3.4-concurrent-ruby-1.3.6 /nix/store/f3wm2jb4agsksqki43kjrrvia80flzrw-ruby3.4-connection_pool-3.0.2 /nix/store/fha3y6k1qm9dv20z8d3xd0bb3gfblf76-ruby3.4-drb-2.2.3 /nix/store/fqcgsp1b678vfpai57jfzpgvkr1dzdf9-ruby3.4-i18n-1.14.8 /nix/store/ppgc