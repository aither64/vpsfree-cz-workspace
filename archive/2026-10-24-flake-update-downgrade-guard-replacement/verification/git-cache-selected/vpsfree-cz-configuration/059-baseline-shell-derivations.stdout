iqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2 /nix/store/1hjg44rywjpc52nnhs1z9iba9vgr2s3n-zstd-1.5.7-dev /nix/store/ngy9kz80vpiylr093kjbcv8y2igq0m80-glibc-iconv-2.42","out":"/nix/store/bji80frz88sg8ai8n71sgvjkwg7whr3m-man-db-2.13.1","outputMan":"out","outputs":"out doc","patches":"/nix/store/p4m9shlpsqrvir464livcdni0y32ah3f-systemwide-man-db-conf.patch","pname":"man-db","postInstall":"# apropos/whatis uses program name to decide whether to act like apropos or whatis\n# (multi-call binary). `apropos` is actually just a symlink to whatis. So we need to\n# make sure that we don't wrap symlinks (since that changes argv[0] to the -wrapped name)\nfind \"$out/bin\" -type f | while read file; do\n  wrapProgram \"$file\" \\\n    --prefix PATH : \"/nix/store/yb5g8vgvkfbaix9s1lbx3gqdp1c3pyl2-groff-1.24.2/bin:/nix/store/k1z3ys65nbrdc60975wajrj4xjwaqqm4-gzip-1.14/bin:/nix/store/z8fp2l0b1k64swd0dxpych445wpfcgb0-zstd-1.5.7-bin/bin\"\ndone\n","postPatch":"# Remove all mandatory manpaths. Nixpkgs makes no requirements on\n# these directories existing.\nsed -i 's/^MANDATORY_MANPATH/# &/' src/man_db.conf.in\n\n# Add Nix-related manpaths\necho \"MANPATH_MAP\t/nix/var/nix/profiles/default/bin\t/nix/var/nix/profiles/default/share/man\" >> src/man_db.conf.in\n\n# Add mandb locations for the above\necho \"MANDB_MAP\t/nix/var/nix/profiles/default/share/man\t/var/cache/man/nixpkgs\" >> src/man_db.conf.in\n","preConfigure":"./bootstrap --no-git --gnulib-srcdir=/nix/store/c1gf156iz5dvjhavrs76wgpp7lhgna2a-gnulib-20241001 --gen\nconfigureFlagsArray+=(\"--with-sections=1 n l 8 3 0 2 5 4 9 6 7\")\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/6kz444k9yjlacfhrbw84qrbw1mk7vjgw-source","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.13.1"},"inputs":{"drvs":{"049faz5h2hlc77kx3f6hvc147xrfc1n5-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"09abhpb3pjvn3slijacfmsc