bash-5.3/bin/bash","buildCommand":"# Unpack\ntar xf /nix/store/vwj66jmx32xbw97zwbajmncp028kb93a-Python-3.14.4.tar.xz\ncd Python-3.14.4\n\n# Patch\npatch -Np1 -i /nix/store/jqin2kzvzrvi30cxda5zp7qz1fanmz7v-no-ldconfig.patch\n\n# Configure\nexport CC=musl-gcc\nexport C_INCLUDE_PATH=\"/nix/store/s5ga4ywpvxkxp1arkyxhsznax5qmqns4-zlib-1.3.2/include\"\nexport LIBRARY_PATH=\"/nix/store/s5ga4ywpvxkxp1arkyxhsznax5qmqns4-zlib-1.3.2/lib\"\nexport LDFLAGS=\"-Wl,-rpath,/nix/store/s5ga4ywpvxkxp1arkyxhsznax5qmqns4-zlib-1.3.2/lib -L/nix/store/s5ga4ywpvxkxp1arkyxhsznax5qmqns4-zlib-1.3.2/lib\"\nexport LD_LIBRARY_PATH=\"$LIBRARY_PATH\"\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --disable-test-modules \\\n  --without-ensurepip \\\n  --without-static-libpython\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install\n\n# Remove lib-dynload extension modules not needed for glibc's build scripts.\n# glibc uses Python only for scripts that import: os, re, subprocess, argparse,\n# pathlib, collections, tempfile.  Following the import chain:\n#   subprocess -> selectors -> math, select, fcntl, _posixsubprocess\n#   pathlib -> grp\n#   tempfile -> random -> _random, bisect -> _bisect\n# Everything else in lib-dynload is dead weight in the bootstrap context.\nfind $out/lib/python*/lib-dynload -name '*.so' \\\n  ! -name '_bisect*' \\\n  ! -name '_posixsubprocess*' \\\n  ! -name '_random*' \\\n  ! -name 'fcntl*' \\\n  ! -name 'grp*' \\\n  ! -name 'math*' \\\n  ! -name 'select*' \\\n  -delete\n\nrm -rf \\\n  $out/lib/python*/ensurepip \\\n  $out/lib/python*/idlelib \\\n  $out/lib/python*/site-packages \\\n  $out/lib/python*/test \\\n  $out/lib/python*/tkinter \\\n  $out/lib/python*/turtledemo \\\n  $out/share/man\n\nrm -f $out/bin/idle* $out/bin/pip*\nfind $out/lib/python* -type d -name __pycache__ -prune -exec rm -rf {} +\nstrip --strip-unneeded $out/bin/python3.14 $out/lib/python*/lib-dynload/*.so || true\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"python-3.14.4","out":"/nix/store/9ds17k3q1b2kckwp7p82iq0fpasdix1f-python-3.14.4","passAsFile":"buildCommand","pname":"python","system":"x86_64-linux","version":"3.14.4"},"inputs":{"drvs":{"3zhi7fn92ym1ds0n3yybmjyjvksypi39-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b0xnqkbv7qnbbbc7zhqwahygjf7mc2i-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"6khyn9406a1k9b1wi5cbw4wysffrnav1-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gwpvw0ssr7xmfzvy97c6f493fhc2f7r-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"h545qb92mx5i9q4amb44d2phh9by0zrq-gcc-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"haldh962ah38jwv0i8f72nr68nn7vw9r-Python-3.14.4.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"hxagi71byf79kd6630nkzzslsmmjir34-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"jm8c5a9ysfm3fckryllnl6pd3nm1hd17-bootstrap-coreutils-musl-9.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"l6a6rj0gy31gp6k7k80qzn4ni0yvyzgh-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"s2g0la1392ys0bp34d0m38kmlzwi30v1-binutils-2.46.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a9pds57ms69gfi2ya-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"v8jl1cziqai2qqgn0axr9cv3masm5nb5-bash-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"vf5nz05lk9n6xm1h1sh3c8s951ybk08h-musl-1.2.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"xlhf3ibq6r6qy2myin330ay7qscfzi1g-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"zmvpmmh7i1qba20c97v4cl6yi7zqpv3a-gnupatch-2.5.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["70acbfgbz5cxsx4sqzcnj8qaqhb4i9ay-bash-builder.sh","jqin2kzvzrvi30cxda5zp7qz1fanmz7v-no-ldconfig.patch"]},"name":"python-3.14.4","outputs":{"out":{"path":"9ds17k3q1b2kckwp7p82iq0fpasdix1f-python-3.14.4"}},"syst