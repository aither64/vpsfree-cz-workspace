"dontStrip":"","gemName":"highline","gemPath":"/nix/store/gs67fhs0pvx2mqry4qyf0jz724xwgs98-ruby3.4-reline-0.6.3","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-highline-3.1.2","nativeBuildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9 /nix/store/qw8rpqmndqzyc3fzzla754v5hlpm10i4-make-shell-wrapper-hook","out":"/nix/store/4mhna0w0xikx8cp6fffzndz42wrfh17q-ruby3.4-highline-3.1.2","outputs":"out","patches":"","pname":"highline","propagatedBuildInputs":"/nix/store/gs67fhs0pvx2mqry4qyf0jz724xwgs98-ruby3.4-reline-0.6.3","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/gs67fhs0pvx2mqry4qyf0jz724xwgs98-ruby3.4-reline-0.6.3","ruby":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9","src":"/nix/store/xvjdp9zk62qrn6a54my6axa6sbawfw2l-highline-3.1.2.gem","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","suffix":"3.1.2","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"3.1.2"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"15zz96nd1gls0zdk7m6w9ckjwgp08ibm-ruby3.4-reline-0.6.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"6xfir3xkp6ycq03hlz56hz538066plln-highline-3.1.2.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutput