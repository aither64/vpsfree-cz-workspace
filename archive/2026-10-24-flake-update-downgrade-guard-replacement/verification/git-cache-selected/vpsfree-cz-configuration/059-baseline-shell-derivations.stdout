v \"$tmpfile\" \"$out\"\n\nlsdiff \\\n   \\\n  \"$out\" \\\n| sort -u | sed -e 's/[*?]/\\\\&/g' \\\n| xargs -I{} --delimiter='\\n' \\\n  filterdiff \\\n  --include={} \\\n  --strip=0 \\\n   \\\n  --clean \"$out\" > \"$tmpfile\"\n\nif [ ! -s \"$tmpfile\" ]; then\n  echo \"error: Normalized patch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://gitlab.archlinux.org/archlinux/packaging/packages/ffmpeg/-/raw/a02c1a15706ea832c0d52a4d66be8fb29499801a/add-av_stream_get_first_dts-for-chromium.patch"]},"system":"x86_64-linux","version":4},"x21bdkwizrgm5bww1n27lrfhh4w5a8c6-ruby-3.4.9.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","env":{"NIX_MAIN_PROGRAM":"ruby","NROFF":"/nix/store/zk6rrmwz2p5zshgbmlajzipygb9dp3nc-groff-1.24.1/bin/nroff","__structuredAttrs":"","buildInputs":"/nix/store/c3g361js93jz2xx8lx6mnmqg76lghxxh-autoconf-2.73 /nix/store/aj7zqrfxvg96ldyph7fly6qgprcm2krv-libffi-3.5.2-dev /nix/store/gi6n3gp7z0d1j4f2zpc7rwygjj45zgm4-ncurses-6.6-dev /nix/store/zhd6q8c6nnrvw66qdz1w5qf85v83nvzb-readline-8.3p3-dev /nix/store/h7ik0g1xxayy0z8h27zbvrgmac63irgs-zlib-1.3.2-dev /nix/store/wxws7pwyzk8mbmjc1rwwwx9v184hh67v-openssl-3.6.2-dev /nix/store/8gz283jxaaacpc4mwxharczb17jdw8i6-gdbm-1.26-dev /nix/store/mmxarzrpbxccr4djwar95qbc3nvcx55w-libyaml-0.2.5-dev","builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","cargoDeps":"/nix/store/8cv5s3nv9y8pm67l68dclfpw7ayadf1c-cargo-deps-vendor","cargoRoot":"yjit","cmakeFlags":"","configureFlags":"--enable-shared --enable-pthread --with-soname=ruby-3.4.9 --without-baseruby --disable-dtrace --enable-jit-support --enable-yjit --enable-install-doc --without-jemalloc --with-ridir=/0mzrxs60yn555qh08y6avv5sbrfy0gkizrji3v7ba9j25ha14fh5/share/ri CFLAGS=-O3","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","devdoc":"/nix/store/813xnjnabmqk33vkakv1035q8y44kcl1-ruby-3.4.9-devdoc","disallowedRequisites":"","doCheck":"","doInstallCheck":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"","installCheckPhase":"overriden_cc=$(CC=foo $out/bin/ruby -rrbconfig -e 'puts RbConfig::CONFIG[\"CC\"]')\nif [[ \"$overriden_cc\" != \"foo\" ]]; then\n   echo \"CC cannot be overwritten: $overriden_cc != foo\" >&2\n   false\nfi\n\nfallback_cc=$(unset CC; $out/bin/ruby -rrbconfig -e 'puts RbConfig::CONFIG[\"CC\"]')\nif [[ \"$fallback_cc\" != \"$CC\" ]]; then\n   echo \"CC='$fallback_cc' should be '$CC' by default\" >&2\n   false\nfi\n","installFlags":"install-doc","mesonFlags":"","name":"ruby-3.4.9","nativeBuildInputs":"/nix/store/cmgajq2d7j3nhm2drnzybxzdc82kfbvj-autoreconf-hook /nix/store/xnrdzhzdkwpjcdl3rzqmqpaa8sn7g870-bison-3.8.2 /nix/store/i03v7b50ni09y85lvjphbyxrv64x4gfp-remove-references-to /nix/store/zk6rrmwz2p5zshgbmlajzipygb9dp3nc-groff-1.24.1 /nix/store/0kkppa57hwc4kqip4xv6g4h8crvxcl0a-cargo-setup-hook.sh /nix/store/wnhmqix7bippbbzasj29qiyb422g9asg-rustc-wrapper-1.95.0","out":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9","outputs":"out devdoc","patches":"/nix/store/c6d5gm3zc63zg49kanxf8w6cxfv69ibk-dont-refer-to-build-dir.patch","pname":"ruby","postInstall":"rbConfig=$(find $out/lib/ruby -name rbconfig.rb)\n# Remove references to the build environment from the closure\nsed -i '/^  CONFIG\\[\"\\(BASERUBY\\|SHELL\\|GREP\\|EGREP\\|MKDIR_P\\|MAKEDIRS\\|INSTALL\\)\"\\]/d' $rbConfig\n# Remove unnecessary groff reference from runtime closure, since it's big\nsed -i '/NROFF/d' $rbConfig\n\n\n# Allow to override compiler. This is important for cross compiling as\n# we need to set a compiler that is different from the build one.\nsed -i \"$rbConfig\" \\\n  -e 's/CONFIG\\[\"CC\"\\] = \"\\(.*\\)\"/CONFIG[\"CC\"] = if ENV[\"CC\"].nil? || ENV[\"CC\"].empty? then \"\\1\" else ENV[\"CC\"] end/' \\\n  -e 's/CONFIG\\[\"CXX\"\\] = \"\\(.*\\)\"/CONFIG[\"CXX\"] = if ENV[\"CXX\"].nil? || ENV[\"CXX\"].empty? then \"\\1\" else ENV[\"CXX\"] end/'\n\n# Remove unnecessary external intermediate files created by gems\nextMakefiles=$(find $out/lib/ruby/gems/3.4.0 -name Makefile)\nfor makefile in $extMakefiles; do\n  make -C \"$(dirname \"$makefile\")\" distclean\ndone\nfind \"$out/lib/ruby/gems/3.4.0\" \\( -name gem_make.out -o -name mkmf.log -o -name exts.mk \\) -delete\n# Bundler tries to create this directory\nmkdir -p $out/nix-support\ncat > $out/nix-support/setup-hook <<EOF\naddGemPath() {\n  addToSearchPath GEM_PATH \\$1/lib/ruby/gems/3.4.0\n}\naddRubyLibPath() {\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0/x86_64-linux\n}\n\naddEnvHooks \"$hostOffset\" addGemPath\naddEnvHooks \"$hostOffset\" addRubyLibPath\nEOF\n# Prevent the docs from being included in the closure\nsed -i \"s|\\$(DESTDIR)$devdoc|\\$(datarootdir)/\\$(RI_BASE_NAME)|\" $rbConfig\nsed -i \"s|'--with-ridir=$devdoc/share/ri'||\" $rbConfig\n\n# Add rbconfig shim so ri can find docs\nmkdir -p $devdoc/lib/ruby/site_ruby\ncp /nix/store/wq7zxvl223s5s97y3dhc3gkyk5d6dw0w-rbconfig.rb $devdoc/lib/ruby/site_ruby/rbconfig.rb\n","postPatch":"sed -i configure.ac -e '/config.guess/d'\ncp --remove-destination /nix/store/c3g361js93jz2xx8lx6mnmqg76lghxxh-autoconf-2.73/share/autoconf/build-aux/config.{guess,sub} tool/\n","postUnpack":"rm -rf $sourceRoot/{lib,test}/rubygems*\ncp -r /nix/store/ammasdv0agvwimsvih70n8g156s614pq-rubygems-3.7.2/lib/rubygems* $sourceRoot/lib\n","preConfigure":"# rdoc creates XDG_DATA_DIR (defaulting to $HOME/.local/share) even if\n# it's not going to be used.\nexport HOME=$TMPDIR\n","preInstall":"# Ruby installs gems here itself now.\nmkdir -pv \"$out/lib/ruby/gems/3.4.0\"\nexport GEM_HOME=\"$out/lib/ruby/gems/3.4.0\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/h459yblgc82az0vy3brjh5wc1452f8fw-ruby-3.4.9.tar.gz","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"3.4.9"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"30nind142ns86wd45vnl170plgz4gx0f-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"3yakg9pp76lh2aylnyqf94qgsnmvpb4l-libffi-3.5.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"4drj670xgxqvf4klick3m8advwhrrkkf-cargo-deps-vendor.drv":{"dynamicOutputs":{},"outputs":["out"]},"72nlqcz1lz91r952rrmhsn6zzx2r39pg-libyaml-0.2.5.drv":{"dynamicOutputs":{},"outputs":["dev"]},"ada2vbvrz39j7vwr42rc8s7zz8r426b6-autoconf-2.73.drv":{"dynamicOutputs":{},"outputs":["out"]},"afwpck33livlkfjmapnr3mhar7h3cd5n-rubygems-3.7.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"bkl0c5i4d0y42988ld646k1haqcnjsgq-autoreconf-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"h4fkx5vvws4bnpfhhk07k0scjymj189x-openssl-3.6.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"hz2z45zb9m1m6681n1qpcq2k6b63ardp-rustc-wrapper-1.95.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"kd3d6226n2qkvkxnr