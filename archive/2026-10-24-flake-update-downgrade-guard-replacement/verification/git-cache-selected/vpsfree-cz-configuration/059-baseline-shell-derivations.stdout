hOS/bootstrap-from-tcc/blob/2e0c68c36b3437386f786d619bc9a16177f2e149/using-nix/2a3-intermediate-musl.nix\nsed -i 's|/bin/sh|/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash|' \\\n  tools/*.sh\n# patch popen/system to search in PATH instead of hardcoding /bin/sh\nsed -i 's|posix_spawn(&pid, \"/bin/sh\",|posix_spawnp(\\&pid, \"sh\",|' \\\n  src/stdio/popen.c src/process/system.c\nsed -i 's|execl(\"/bin/sh\", \"sh\", \"-c\",|execlp(\"sh\", \"-c\",|'\\\n  src/misc/wordexp.c\n\n# Configure\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --syslibdir=$out/lib \\\n  --enable-wrapper\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install\nsed -i 's|/bin/sh|/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash|' $out/bin/*\nln -s ../lib/libc.so $out/bin/ldd\nln -s $(ls -d /nix/store/jc3w03rwdbh577bkqb2drrwj6i9wvmv8-linux-headers-6.5.6/include/* | grep -v scsi\\$) $out/include/\n\n# Strip\n# Ignore failures, because strip may fail on non-elf files.\nfind $out/{bin,lib} -type f -exec strip --strip-debug {} + || true\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"musl-1.2.6","out":"/nix/store/dm63csbh1cvkv5hbskj5mlfpyzw49hcy-musl-1.2.6","passAsFile":"buildCommand","pname":"musl","system":"x86_64-linux","version":"1.2.6"},"inputs":{"drvs":{"1s96sa6kxf55hkdc362fl3xiy9mj0bjf-linux-headers-6.5.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"59pgig863abfc3p6lmz20vh8gjf2nsv1-musl-1.2.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b0xnqkbv7qnbbbc7zhqwahygjf7mc2i-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gsx86gz3hgynhcx7cxsif30zwq0qg80-gcc-15.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"bv4a5fw05q4ysq24wy0z06bd5jysq1p2-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"jm8c5a9ysfm3fckryllnl6pd3nm1hd17-bootstrap-coreutils-musl-9.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"l6a6rj0gy31