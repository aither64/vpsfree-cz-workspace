nputs":"","out":"/nix/store/d6j5cifzkwjlimawmjhywqx9l6bk43q6-expand-response-params","outputs":"out","patches":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/jik02mkz72r2f6hhxnlhp6h5f0fi89gw-expand-response-params.c","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"1","system":"x86_64-linux","unpackPhase":"cp \"$src\" expand-response-params.c\nsrc=$PWD\n"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["jik02mkz72r2f6hhxnlhp6h5f0fi89gw-expand-response-params.c","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"expand-response-params","outputs":{"out":{"path":"d6j5cifzkwjlimawmjhywqx9l6bk43q6-expand-response-params"}},"system":"x86_64-linux","version":4},"p0jwiywmv79msnj5m4qm4xk7zgfxjrms-ncurses-6.6.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildInputs":"","builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"--with-shared --enable-pc-files --enable-symlinks --with-manpage-format=normal --disable-stripping --with-versioned-syms --without-debug cf_cv_type_of_bool=bool --build=x86_64-unknown-linux-gnu --host=x86_64-unknown-linux-gnu","configurePlatforms":"build host","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/gi6n3gp7z0d1j4f2zpc7rwygjj45zgm4-ncurses-6.6-dev","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","man":"/nix/store/5byzk414n47gxdbin28h2bs5b7g5kcyp-ncurses-6.6-man","mesonFlags":"","name":"ncurses-6.6","nativeBuildInputs":"/nix/store/rg5cj8c87ssrysrnirfar3zvahy8lmdy-update-autotools-gnu-config-scripts-hook /nix/store/1m05k7xgfnw6jc21xxk5681ni3ar97wf-pkg-config-wrapper-0.29.2","out":"/nix/store/wl2nw5l4x4dg6kclbgpq7v9212i1s6cy-ncurses-6.6","outputs":"out dev man","patches":"","pname":"ncurses","postInstall":"rm \"$out\"/lib/*.a\n# Determine what suffixes our libraries have\nsuffix=\"$(awk -F': ' 'f{print $3; f=0} /default library suffix/{f=1}' config.log)\"\nlibs=\"$(ls $dev/lib/pkgconfig | tr ' ' '\\n' | sed \"s,\\(.*\\)$suffix\\.pc,\\1,g\")\"\nsuffixes=\"$(echo \"$suffix\" | awk '{for (i=1; i < length($0); i++) {x=substr($0, i+1, length($0)-i); print x}}')\"\n\n# Get the path to the config util\ncfg=$(basename $dev/bin/ncurses*-config)\n\n# symlink the full suffixed include directory\nln -svf . $dev/include/ncurses$suffix\n\nfor newsuffix in $suffixes \"\"; do\n  # Create a non-abi versioned config util links\n  ln -svf $cfg $dev/bin/ncurses$newsuffix-config\n\n  # Allow for end users who #include <ncurses?w/*.h>\n  ln -svf . $dev/include/ncurses$newsuffix\n\n  for library in $libs; do\n    for dylibtype in so dll dylib; do\n      if [ -e \"$out/lib/lib${library}$suffix.$dylibtype\" ]; then\n        ln -svf lib${library}$suffix.$dylibtype $out/lib/lib$library$newsuffix.$dylibtype\n        ln -svf lib${library}$suffix.$dylibtype.6 $out/lib/lib$library$newsuffix.$dylibtype.6\n        if [ \"ncurses\" = \"$library\" ]\n        then\n          # make libtinfo symlinks\n          ln -svf lib${library}$suffix.$dylibtype $out/lib/libtinfo$newsuffix.$dylibtype\n          ln -svf lib${library}$suffix.$dylibtype.6 $out/lib/libtinfo$newsuffix.$dylibtype.6\n        fi\n      fi\n    done\n    for statictype in a dll.a la; do\n      if [ -e \"$out/lib/lib${library}$suffix.$statictype\" ]; then\n        ln -svf lib${library}$suffix.$statictype $out/lib/lib$library$newsuffix.$statictype\n        if [ \"ncurses\" = \"$library\" ]\n        then\n          # make libtinfo symlinks\n          ln -svf lib${library}$suffix.$statictype $out/lib/libtinfo$newsuffix.$statictype\n        fi\n      fi\n    done\n    ln -svf ${library}$suffix.pc $dev/lib/pkgconfig/$library$newsuffix.pc\n  done\ndone\n\n# add pkg-config aliases for libraries that are built-in to libncurses(w)\nfor library in tinfo tic; do\n  for suffix in \"\" w; do\n    ln -svf ncurses$suffix.pc $dev/lib/pkgconfig/$library$suffix.pc\n  done\ndone\n\n# move some utilities to $bin\n# these programs are used at runtime and don't really belong in $dev\nmoveToOutput \"bin/clear\" \"$out\"\nmoveToOutput \"bin/reset\" \"$out\"\nmoveToOutput \"bin/tabs\" \"$out\"\nmoveToOutput \"bin/tic\" \"$out\"\nmoveToOutput \"bin/tput\" \"$out\"\nmoveToOutput \"bin/tset\" \"$out\"\nmoveToOutput \"bin/captoinfo\" \"$out\"\nmoveToOutput \"bin/infotocap\" \"$out\"\nmoveToOutput \"bin/infocmp\" \"$out\"\n","postPatch":"sed -i '1i #include <stdbool.h>' include/curses.h.in\n","preConfigure":"export PKG_CONFIG_LIBDIR=\"$dev/lib/pkgconfig\"\nmkdir -p \"$PKG_CONFIG_LIBDIR\"\nconfigureFlagsArray+=(\n  \"--libdir=$out/lib\"\n  \"--includedir=$dev/include\"\n  \"--bindir=$dev/bin\"\n  \"--mandir=$man/share/man\"\n  \"--with-pkg-config-libdir=$PKG_CONFIG_LIBDIR\"\n)\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"","setOutputFlags":"","src":"/nix/store/1hkx09zxzwwhqwnr5rdi7r2v7jbiki00-ncurses-6.6.tar.gz","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"6.6"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"1hbskyqq8pmy702s4jppd7zdk5p1fndg-ncurses-6.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"gfzk85k58qbgzfw0ymjz8w3z8cfjf0m1-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"ppbkr6y1b280gpcdb6kql45nwmns0icf-update-autotools-gnu-config-scripts-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ncurses-6.6","outputs":{"dev":{"path":"gi6n3gp7z0d1j4f2zpc7rwygjj45zgm4-ncurses-6.6-dev"},"man":{"path":"5byzk414n47gxdbin28h2bs5b7g5kcyp-ncurses-6.6-man"},"out":{"path":"wl2nw5l4x4dg6kclbgpq7v9212i1s6cy-ncurses-6.6"}},"system":"x86_64-linux","version":4},"p0yc9xjrmp4xyhlghyc1y6w02wy7jlx0-perl-5.42.3.tar.gz.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"builtin:fetchurl","executable":"","impureEnvVars":"http_proxy https_proxy ftp_proxy all_proxy no_proxy","name":"perl-5.42.3.tar.gz","out":"/nix/store/m2qam71fmv9f8vyliw7741lr87mbxcwk-perl-5.42.3.tar.gz","outputHash":"sha256-ETd0CYWDe1zfFfDPq5Miedy0NS+RL+1vwUTotPCCNic=","outputHashAlgo":"sha256","outputHashMode":"flat","preferLocalBuild":"1","system":"builtin","unpack":"","url":"https://cpan.metacpan.org/src/5.0/perl-5.42.3.tar.gz","urls":"https://cpan.metacpan.org/src/5.0/perl-5.42.3.tar.gz"},"inputs":{"drvs":{},"srcs":[]},"name":"perl-5.42.3.tar.gz","outputs":{"out":{"hash":"sha256-ETd0CYWDe1zfFfDPq5Miedy0NS+RL+1vwUTotPCCNic=","method":"flat"}},"system":"builtin","version":4},"p0yyzdp250ai6dwblxf36ysihmd9bnq3-pyproject_metadata-0.10.0.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/z698hwc208p2vjfiaskcll8c82437d95-pyproject_metadata-0.10.0.tar.gz"},"inputs":{"drvs":{"3fc7klhja3mn322hjxl4bax4mk3m6h8l-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"4j2l0cvsy5izi98k7flqj166iqzcn2lr-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bas