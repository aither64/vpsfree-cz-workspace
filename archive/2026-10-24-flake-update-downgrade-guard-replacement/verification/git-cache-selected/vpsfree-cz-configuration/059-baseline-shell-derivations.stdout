ure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-headers=/nix/store/dxv9hw75vh11n6zl2sihrck3ldz7a2gn-linux-headers-6.5.6/include \\\n  --disable-dependency-tracking\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES INSTALL_UNCOMPRESSED=yes install\nln -s $(ls -d /nix/store/dxv9hw75vh11n6zl2sihrck3ldz7a2gn-linux-headers-6.5.6/include/* | grep -v scsi\\$) $out/include/\nfind $out/{bin,sbin,lib,libexec} -type f -exec strip --strip-unneeded {} + || true\n\n# localedef + iconv() are never invoked downstream of this glibc\nrm -rf $out/share/i18n $out/lib/gconv $out/share/locale\nrm -rf $out/bin $out/sbin\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"glibc-2.42","out":"/nix/store/1707g2v75lrw24ax3ybi6s9l54sypbva-glibc-2.42","passAsFile":"buildCommand","pname":"glibc","system":"x86_64-linux","version":"2.42"},"inputs":{"drvs":{"2hcix19ddnc0gssj508dfr9yzw29mkvf-linux-headers-6.5.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"3zhi7fn92ym1ds0n3yybmjyjvksypi39-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b0xnqkbv7qnbbbc7zhqwahygjf7mc2i-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gwpvw0ssr7xmfzvy97c6f493fhc2f7r-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"h545qb92mx5i9q4amb44d2phh9by0zrq-gcc-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"hxagi71byf79kd6630nkzzslsmmjir34-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"jm8c5a9ysfm3fckryllnl6pd3nm1hd17-bootstrap-coreutils-musl-9.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"k9kvp567r0m4ixkdanr0sxg8fyw1bhm9-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"l6a6rj0gy31gp6k7k80qzn4ni0yvyzgh-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"m4pkby9pv0nwasab4jrr4l2z9qghmqjg-glibc-2.42.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"