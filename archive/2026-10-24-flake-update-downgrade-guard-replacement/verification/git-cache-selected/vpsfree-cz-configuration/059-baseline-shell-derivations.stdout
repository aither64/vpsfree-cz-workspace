ut}\n\n# Check\n./src/echo \"Hello coreutils!\"\n\n# Install\n./src/mkdir -p ${out}/bin\nmake -f /nix/store/r7x7s6nhj2xbra35dpd7pp0wy03ax69f-main.mk install PREFIX=${out}\n"},"inputs":{"drvs":{"013mqc5ymx4cih72blz21l6ync49i3jg-expr-strcmp.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"aspfvh0wlsi4w6kva34p3m9kkcxr7vym-sort-locale.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"b147bn8sgyn2s58vy3cw59d89vrd482g-mbstate.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"br3yqsjafxyhh91879brxq1xzbyjwlwb-ls-strcmp.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"c672ird0l7wv8dr5idknpgnh1rhzlnqf-coreutils-5.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"lbn6dc55b8f36v2p2hkqbpk2z63wnjyx-touch-dereference.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"qp9mn19nkyp680m55w409i550zni62gh-modechange.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"vrkgrz8l2z0yq45fai507hpcaqp0i9cq-touch-getdate.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"x7l0vwljyrwyncsxkyvzh6gmc1f8p2rw-main.mk.drv":{"dynamicOutputs":{},"outputs":["out"]},"xfz5c7irzix5sakph3m18v0h400s6id6-uniq-fopen.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"bootstrap-coreutils-5.0-builder","outputs":{"out":{"path":"wgdpzmfzmk7awjaangk76l8w19jnn933-bootstrap-coreutils-5.0-builder"}},"system":"x86_64-linux","version":4},"f4y8nhqiqj40xv2q9anqps4h5d5xz65l-libICE-1.1.2.tar.xz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/store/jd