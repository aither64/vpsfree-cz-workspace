th":"kgd806ssw99qaxwiislhfx5dwnc8k893-glibc-2.42-100-bin"},"debug":{"path":"v98mh5jg68nn9cbzsnism0zjyrqib666-glibc-2.42-100-debug"},"dev":{"path":"sr08dm9x0fsa1mrzjrlb3csdcmilsraz-glibc-2.42-100-dev"},"getent":{"path":"9a6dqr6vgdi4qidprg92l3k9kkv13xyn-glibc-2.42-100-getent"},"out":{"path":"fsd4vbp9zjd9iaicq2fb9lpc1h5j973y-glibc-2.42-100"},"static":{"path":"730n9ixp9w48l4jwxh42qhkaj2q0zvrk-glibc-2.42-100-static"}},"system":"x86_64-linux","version":4},"p1g5jzfyxwpv5rn08hvaqz8rgp62xx1y-glib-2.88.3.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"DETERMINISTIC_BUILD":"1","NIX_CFLAGS_COMPILE":"-Wno-error=nonnull -DG_DISABLE_CAST_CHECKS","__structuredAttrs":"","bin":"/nix/store/60brw70jw0vhlaig870nkxh840bkq4vv-glib-2.88.3-bin","buildInputs":"/nix/store/qgfij9cxhp7gfjk6hs43hzy4n3w9am3c-setup-hook.sh /nix/store/pwkbkjp8zn8h90l9snrhddf2xw0gf1xr-libsysprof-capture-50.0 /nix/store/r4y5gj9b30608b0fwj37slgqv2l638r1-pcre2-10.49-dev /nix/store/mnv5sn4d6bdkq84f0wn3nibsxvqxaplr-bash-interactive-5.3p9-dev /nix/store/kph9fi6qr2mjz98blzb4rzzzsfgvf4c8-gnum4-1.4.21 /nix/store/f6haxbzaxb7v5d92wscfbrhip2l6l1m4-elfutils-0.194-dev /nix/store/yfy3whwvgfprv6ln1jhirfp8rj00ihwh-libsystemtap-5.3 /nix/store/npvjdlm0lsxms1m810479vyn4b8j589p-libselinux-3.10-dev /nix/store/ijyv5mn8kp91q247wynjhkk7ba530yh4-util-linux-minimal-2.42.3-dev","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","debug":"/nix/store/97kwm3pqzwsf8dlkpww9sjmcgb5jb6cr-glib-2.88.3-debug","depsBuildBuild":"/nix/store/viqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/d0vv6yniq5vhdm7dg7nvn