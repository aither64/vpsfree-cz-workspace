me","NIX_MIRRORS_gnu","NIX_MIRRORS_gnupg","NIX_MIRRORS_hackage","NIX_MIRRORS_hashedMirrors","NIX_MIRRORS_ibiblioPubLinux","NIX_MIRRORS_imagemagick","NIX_MIRRORS_kde","NIX_MIRRORS_kernel","NIX_MIRRORS_luarocks","NIX_MIRRORS_maven","NIX_MIRRORS_mozilla","NIX_MIRRORS_mysql","NIX_MIRRORS_openbsd","NIX_MIRRORS_opensuse","NIX_MIRRORS_osdn","NIX_MIRRORS_postgresql","NIX_MIRRORS_pypi","NIX_MIRRORS_qt","NIX_MIRRORS_sageupstream","NIX_MIRRORS_samba","NIX_MIRRORS_savannah","NIX_MIRRORS_sourceforge","NIX_MIRRORS_steamrt","NIX_MIRRORS_tcsh","NIX_MIRRORS_testpypi","NIX_MIRRORS_texhistoric","NIX_MIRRORS_ubuntu","NIX_MIRRORS_xfce","NIX_MIRRORS_xorg"],"mesonFlags":[],"mirrorsFile":"/nix/store/981lgfashyzwys4rf4y452n92hblkx5h-mirrors-list","name":"source","nativeBuildInputs":["/nix/store/3kyk0wjam6yl651y2hdz4wm8qilsxq71-curl-8.22.0-dev"],"nixpkgsVersion":"26.05","outputChecks":{"out":{}},"outputHash":"sha256-vhGFTd1yXL4Frqli5D1GwOatwByDjvcP8sxgkdu6Jqg=","outputHashMode":"recursive","outputs":["out"],"owner":"youknowone","patches":[],"postFetch":"unpackDir=\"$TMPDIR/unpack\"\nmkdir \"$unpackDir\"\ncd \"$unpackDir\"\n\nrenamed=\"$TMPDIR/download.tar.gz\"\nmv \"$downloadedFile\" \"$renamed\"\nunpackFile \"$renamed\"\nchmod -R +w \"$unpackDir\"\nif [ $(ls -A \"$unpackDir\" | wc -l) != 1 ]; then\n  echo \"error: zip file must contain a single file or directory.\"\n  echo \"hint: Pass stripRoot=false; to fetchzip to assume flat list of files.\"\n  exit 1\nfi\nfn=$(cd \"$unpackDir\" && ls -A)\nif [ -f \"$unpackDir/$fn\" ]; then\n  mkdir $out\nfi\nmv \"$unpackDir/$fn\" \"$out\"\n\n\nchmod 755 \"$out\"\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"recursiveHash":true,"repo":"python-deadlib","rev":"refs/tags/v3.13.0","showURLs":false,"stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":false,"stripRoot":true,"system":"x86_64-linux","tag":"v3.13.0","urls":["https://github.com/youknowone/python-dead