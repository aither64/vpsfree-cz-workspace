cate executable\n# Wrap it if makeWrapperArgs are specified\nmv $out tmp\n  mkdir -p $out/$(dirname \"/bin/pythoncheck.sh\")\n  mv tmp $out//bin/pythoncheck.sh\nif [ -n \"${makeWrapperArgs+${makeWrapperArgs[@]}}\" ]; then\n    wrapProgram $out//bin/pythoncheck.sh ${makeWrapperArgs[@]}\nfi\n","buildInputs":"","builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","content":"exec /nix/store/ag5jbqxrlhxz16a4kfqb3x9xz8ci37fk-python3.13-flake8-7.3.0/bin/flake8 --show-source --ignore E501 \"$1\"\n","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","interpreter":"/nix/store/h0lxbr4dysyz77mxwy02bbzjl8zpjrd7-dash-0.5.13.3/bin/dash","makeWrapperArgs":"","mesonFlags":"","name":"pythoncheck.sh","nativeBuildInputs":"/nix/store/scadi7kx5gq7yvy8kkgxsflypfbycblb-make-binary-wrapper-hook","out":"/nix/store/imi782bsbk7npjlrpxw85wf13fpqdcjr-pythoncheck.sh","outputs":"out","passAsFile":"buildCommand content","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/81ff57hcs8gjlnaqqhbilzxsvb5pfzaa-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"lw7jnk0vrdy642zk8whqxm98f9273k62-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"mba45ml5yahp2qsfpfyjmjxv1f900zh6-python3.13-flake8-7.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"mldlm2l5hgpjlcmvzl45zrl2053pv129-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"wg56cl1s5n707mbzw61vnv2hhadqwlq5-dash-0.5.13.3.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","