p5gsvlgqjqxp-zeromq-4.3.5","outputs":"out","patches":"/nix/store/d0jdif3xk7pmr5pichygigpk5rnfcq2r-cacheline_undefined.patch /nix/store/lh5f1qbrwm5p0my00qdbrc1m2dyqhkyx-zeromq-fix-cmake-4-1.patch /nix/store/3k93ndfvic4f0z547xn89im33lx7i8v1-zeromq-fix-cmake-4-2.patch","pname":"zeromq","postBuild":"# From https://gitlab.archlinux.org/archlinux/packaging/packages/zeromq/-/blob/main/PKGBUILD\n# man pages aren't created when using cmake\n# https://github.com/zeromq/libzmq/issues/4160\npushd ../doc\nfor FILE in *.txt; do\n    asciidoc \\\n        -d manpage \\\n        -b docbook \\\n        -f asciidoc.conf \\\n        -a zmq_version=\"4.3.5\" \\\n        \"${FILE}\"\n    xmlto --skip-validation man \"${FILE%.txt}.xml\"\ndone\npopd\n","postInstall":"# Install manually created man pages\ninstall -vDm644 -t \"$out/share/man/man3\" ../doc/*.3\ninstall -vDm644 -t \"$out/share/man/man7\" ../doc/*.7\n","postPatch":"substituteInPlace CMakeLists.txt \\\n  --replace '$'{prefix}/'$'{CMAKE_INSTALL_LIBDIR} '$'{CMAKE_INSTALL_FULL_LIBDIR} \\\n  --replace '$'{prefix}/'$'{CMAKE_INSTALL_INCLUDEDIR} '$'{CMAKE_INSTALL_FULL_INCLUDEDIR}\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/g5s3sgig2w7f9z8kdpnf01pv4y9nkmr1-source","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"4.3.5"},"inputs":{"drvs":{"041paw1ys0cfqsfv226vj0pikinjyz59-zeromq-fix-cmake-4-2.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"63zjnxw73yn1avnz9vcsb4hjlsvd0gls-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"hmxg83vki0z3j8nmjpafyqdddsdbxm77-cacheline_undefined.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"js2m3sws86233if7fckxgz2rv580gfwy-zeromq-fix-cmake-4-1.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"l0i3c0a9xicri4r1bg4wi5s7xwpsvyqk-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"mcpyh