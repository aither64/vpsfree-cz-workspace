"cmakeFlags":"","configureFlags":"-C --enable-add-ons --sysconfdir=/etc --enable-stack-protector=strong --enable-bind-now --with-headers=/nix/store/s52vdyj97g3adv6qb431v8m2kccs0bzz-linux-headers-6.18.7/include --disable-profile --enable-fortify-source --enable-static-pie --enable-cet=permissive --enable-kernel=3.10.0","debug":"/nix/store/064aav9qq5cszj4vw0q9z35pf9mjrj5w-glibc-2.42-61-debug","depsBuildBuild":"/nix/store/idzl4h8aik0mbp6bvdzf94il5096yclh-bootstrap-stage2-gcc-wrapper-15.2.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/15h9askp4k1lx44d9871wid23j2a8ijp-glibc-2.42-61-dev","doCheck":"","doInstallCheck":"","enableCETRuntimeDefault":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","getent":"/nix/store/nacdc243fq2l9csjcbb1d2pzb14pfq8b-glibc-2.42-61-getent","hardeningDisable":"fortify stackprotector strictflexarrays3","installFlags":"sysconfdir=$(out)/etc","is64bit":"1","linuxHeaders":"/nix/store/s52vdyj97g3adv6qb431v8m2kccs0bzz-linux-headers-6.18.7","makeFlags":"OBJCOPY=objcopy BUILD_LDFLAGS=-Wl,-rpath,/nix/store/h109qbj1967c5diymlzjrwm412qf1cwl-bootstrap-stage0-glibc-minimal-bootstrap/lib OBJDUMP=/nix/store/h4igq07bify53vw0dc6lcz1rli34cpq7-binutils-2.46/bin/objdump user-defined-trusted-dirs=/nix/store/g54b6ghpnn98hfdz4yqw87w10c3hx8bv-xgcc-15.2.0-libgcc/lib","mesonFlags":"","name":"glibc-2.42-61","nativeBuildInputs":"/nix/store/8f5h9gp9h0c5gxm6a7hh5vqyqy8qjk0j-bison-3.8.2 /nix/store/9z0zfywl7xpjf7ky0zb2is5cfx7628sq-gettext-1.0 /nix/store/ikv3l8xy15003xzxwm5khb7fp53qg7pm-python3-minimal-3.13.13 /nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/57iz36553175g3178pvxjij8z5rcsd4n-glibc-2.42-61","outputs":"out bin dev static getent debug","patches":"/nix/store/rdqv4vr2jrjclnk2hdcrj97zqv5ny9z6-2.42-master.patch /nix/store/nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch /nix/store/b1w7zbvm39ff1i52iyjggyvw2rdxz104-dont-use-system-ld-so-cache.patch /nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch /nix/store/llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch /nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch /nix/store/001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch /nix/store/0mb1pqwqkz9sk1fwgn897zlwzhhgfpbf-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch /nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch /nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch /nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch","pname":"glibc","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n\n# Apparently --bindir is not respected.\nmakeFlagsArray+=(\"bindir=$bin/bin\" \"sbindir=$bin/sbin\" \"rootsbindir=$bin/sbin\")\n","postInstall":"moveToOutput bin/getent $getent\necho SUPPORTED-LOCALES=C.UTF-8/UTF-8 > ../localedata/SUPPORTED\n# Don't install C.utf-8 into the archive, but into $out/lib/locale: on non-NixOS\n# systems with an empty /usr/lib/locale/locale-archive, glibc would fall back to\n# $libdir/locale/C.utf-8 instead of the locale archive of pkgs.glibc. See also #347965.\nmake -j${NIX_BUILD_CORES:-1} localedata/install-locale-files\n\ntest -f $out/etc/ld.so.cache && rm $out/etc/ld.so.cache\n\nif test -n \"$linuxHeaders\"; then\n    # Include the Linux kernel headers in Glibc, except the `scsi'\n    # subdirectory, which Glibc provides itself.\n    (cd $dev/include && \\\n     ln -sv $(ls -d $linuxHeaders/include/* | grep -v scsi\\$) .)\nfi\n\n# Fix for NIXOS-54 (ldd not working on x86_64).  Make a symlink\n# \"lib64\" to \"lib\".\nif test -n \"$is64bit\"; then\n    ln -s lib $out/lib64\nfi\n\n# Get rid of more unnecessary stuff.\nrm -rf $out/var $bin/bin/sln\n\n# Backwards-compatibility to fix e.g.\n# \"configure: error: Pthreads are required to build libgomp\" during `gcc`-build\n# because it's not actually needed anymore to link against `pthreads` since\n# it's now part of `libc.so.6` itself, but the gcc build breaks if\n# this doesn't work.\nln -sf $out/lib/libpthread.so.0 $out/lib/libpthread.so\nln -sf $out/lib/librt.so.1 $out/lib/librt.so\nln -sf $out/lib/libdl.so.2 $out/lib/libdl.so\ntest -f $out/lib/libutil.so.1 && ln -sf $out/lib/libutil.so.1 $out/lib/libutil.so\ntouch $out/lib/libpthread.a\n\n# Put libraries for static linking in a separate output.  Note\n# that libc_nonshared.a and libpthread_nonshared.a are required\n# for dynamically-linked applications.\nmkdir -p $static/lib\nmv $out/lib/*.a $static/lib\nmv $static/lib/lib*_nonshared.a $out/lib\n# If libutil.so.1 is missing, libutil.a is required.\ntest -f $out/lib/libutil.so.1 || mv $static/lib/libutil.a $out/lib\n# Some of *.a files are linker scripts where moving broke the paths.\nsed \"/^GROUP/s|$out/lib/lib|$static/lib/lib|g\" \\\n  -i \"$static\"/lib/*.a\n\n# Work around a Nix bug: hard links across outputs cause a build failure.\ncp $bin/bin/getconf $bin/bin/getconf_\nmv $bin/bin/getconf_ $bin/bin/getconf\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/6qa00czc79b3nb6ld0mdyacfp2p1k3jx-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","profilingLibraries":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","src":"/nix/store/6zxixmszg0vbhpaa8rxwfr05by9axj68-glibc-2.42.tar.xz","static":"/nix/store/b5qr6vlws4ifz9y5b98rn08iif41imv8-glibc-2.42-61-static","stdenv":"/nix/store/frf1cczc46wwl0m0iq7y5ckb7zg83i6j-bootstrap-stage2-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.42-61"},"inputs":{"drvs":{"0sm8bvvcpzcq48skj6glwachd0ydycg7-bootstrap-stage2-gcc-wrapper-15.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"dinjsy9j39gclj9hk2qaf7l296bj4053-binutils-2.46.drv":{"dynamicOutputs":{},"outputs":["out"]},"dl4wsj8kpyb1whdhhibqvqqx3c6rc60g-libidn2-2.3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"gfbn7q8wqsq5yzv3fi7sr0pf0kxj376m-bootstrap-stage2-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"hhyhhkpw6v15rzpbyw2y8qzxrz3wv2gl-bootstrap-stage0-glibc-minimal-bootstrap.drv":{"dynamicOutputs":{},"outputs":["out"]},"imyy7rg9gyf2qyhg3jjnmal8grabvra9-glibc-2.42.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"jfdsjqzp6ba2sxydfwvclbash9z0f3zf-gettext-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"n8v417y9hc2r3zyfnbjf8fg30v6hm529-python3-minimal-3.13.13.drv":{"dynamicOutputs":{},"outputs":["out"]},"wzhb336rh5z7c4fmp4fgf0hl6akn539r-xgcc-15.2.0.drv":{"dynamicOutputs":{},"outputs":["libgcc"]},"z1a6zj82v13glfvrfnhjkpic03y4kppc-bash-static-5.3.drv":{"dynamicOutput