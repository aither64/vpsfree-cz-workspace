l? || ENV[\"CXX\"].empty? then \"\\1\" else ENV[\"CXX\"] end/'\n\n# Remove unnecessary external intermediate files created by gems\nextMakefiles=$(find $out/lib/ruby/gems/3.4.0 -name Makefile)\nfor makefile in $extMakefiles; do\n  make -C \"$(dirname \"$makefile\")\" distclean\ndone\nfind \"$out/lib/ruby/gems/3.4.0\" \\( -name gem_make.out -o -name mkmf.log -o -name exts.mk \\) -delete\n# Bundler tries to create this directory\nmkdir -p $out/nix-support\ncat > $out/nix-support/setup-hook <<EOF\naddGemPath() {\n  addToSearchPath GEM_PATH \\$1/lib/ruby/gems/3.4.0\n}\naddRubyLibPath() {\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0/x86_64-linux\n}\n\naddEnvHooks \"$hostOffset\" addGemPath\naddEnvHooks \"$hostOffset\" addRubyLibPath\nEOF\n# Prevent the docs from being included in the closure\nsed -i \"s|\\$(DESTDIR)$devdoc|\\$(datarootdir)/\\$(RI_BASE_NAME)|\" $rbConfig\nsed -i \"s|'--with-ridir=$devdoc/share/ri'||\" $rbConfig\n\n# Add rbconfig shim so ri can find docs\nmkdir -p $devdoc/lib/ruby/site_ruby\ncp /nix/store/wq7zxvl223s5s97y3dhc3gkyk5d6dw0w-rbconfig.rb $devdoc/lib/ruby/site_ruby/rbconfig.rb\n","postPatch":"sed -i configure.ac -e '/config.guess/d'\ncp --remove-destination /nix/store/zsyaikhmdaxra0mh3mbxkahgvgh17d5a-autoconf-2.73/share/autoconf/build-aux/config.{guess,sub} tool/\n","postUnpack":"rm -rf $sourceRoot/{lib,test}/rubygems*\ncp -r /nix/store/skg91wi2sz762z6kchzdlpmdhbqawprn-rubygems-3.7.2/lib/rubygems* $sourceRoot/lib\n","preConfigure":"# rdoc creates XDG_DATA_DIR (defaulting to $HOME/.local/share) even if\n# it's not going to be used.\nexport HOME=$TMPDIR\n","preInstall":"# Ruby installs gems here itself now.\nmkdir -pv \"$out/lib/ruby/gems/3.4.0\"\nexport GEM_HOME=\"$out/lib/ruby/gems/3.4.0\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/h459yblgc82az0vy3brjh5wc1452f8fw-ruby-3.4.9.tar.gz","stdenv