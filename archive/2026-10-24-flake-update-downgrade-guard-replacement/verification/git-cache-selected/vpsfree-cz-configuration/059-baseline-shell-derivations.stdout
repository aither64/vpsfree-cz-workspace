cho $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-tty-progressbar-0.18.3","nativeBuildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9 /nix/store/qw8rpqmndqzyc3fzzla754v5hlpm10i4-make-shell-wrapper-hook","out":"/nix/store/lr6wzah4ggd6n0q7qbn15hdnp6hm50lj-ruby3.4-tty-progressbar-0.18.3","outputs":"out","patches":"","pname":"tty-progressbar","propagatedBuildInputs":"/nix/store/d736dxvmgni3nh0vic7ac8m0prfwdxg0-ruby3.4-strings-ansi-0.2.0 /nix/store/9b4ys836a1jn0k0h9xl18h3i20chz13w-ruby3.4-tty-cursor-0.7.1 /nix/store/6kgp3g1d1ryb73x91mq9zq230jqfi6pq-ruby3.4-tty-screen-0.8.2 /nix/store/50ifkqbndy7qh447ar00c03xpr963m95-ruby3.4-unicode-display_width-2.6.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/d736dxvmgni3nh0vic7ac8m0prfwdxg0-ruby3.4-strings-ansi-0.2.0 /nix/store/9b4ys836a1jn0k0h9xl18h3i20chz13w-ruby3.4-tty-cursor-0.7.1 /nix/store/6kgp3g1d1ryb73x91mq9zq230jqfi6pq-ruby3.4-tty-screen-0.8.2 /nix/store/50ifkqbndy7qh447ar00c03xpr963m95-ruby3.4-unicode-display_width-2.6.0","ruby":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9","src":"/nix/store/iycq9ipz2s3glhx69m2q5wg19dljwjkm-tty-progressbar-0.18.3.gem","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","suffix":"0.18.3","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"0.18.3"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"bb02gddhnhmr9xpp04pp9f84sgj3b7zm-ruby3.4-unicode-display_width-2.6.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"dbvg74ajb39722jk9b4d924w13mzk522-tty-progressbar-0.18.3.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"k2vl4mkll4q4qhaf4v1g4hc083ykaxig-ruby3.4-tty-cursor-0.7.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"psyyl691h6smcw8258rqlrpvh63dadvr-ruby3.4-tty-screen-0.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"sk7l7a3hg2rlwk050a510jq9kga8fh3i-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"x21bdkwizrgm5bww1n27lrfhh4w5a8c6-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"y9h5wx0bpix78jzipnma080lr3cjqix7-ruby3.4-strings-ansi-0.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-tty-progressbar-0.18.3","outputs":{"out":{"path":"lr6wz