\"\n\n  if ! [ -e \"$liblapacke\" ]; then\n    echo \"$liblapacke does not exist, openblas-0.3.32 does not provide liblapacke.\"\n    exit 1\n  fi\n\n  cp -L \"$liblapacke\" $out/lib/liblapacke.so.3\n  chmod +w $out/lib/liblapacke.so.3\n\npatchelf --set-soname liblapacke.so.3 $out/lib/liblapacke.so.3\npatchelf --set-rpath \"$(patchelf --print-rpath $out/lib/liblapacke.so.3):/nix/store/v125s7ad2ni0r1vxw6bp3x0hg0rd403x-openblas-0.3.32/lib\" $out/lib/liblapacke.so.3\n\n  if [ -f \"$out/lib/liblapacke.so.3\" ]; then\n    ln -s $out/lib/liblapacke.so.3 $out/lib/liblapacke.so\n  fi\n\n  cp /nix/store/gwl7bng87ffqdcc17swzpr2ggjgxqw0n-liblapack-3.12.1/include/lapacke{,_mangling,_config,_utils}.h $dev/include\n\n  cat <<EOF > $dev/lib/pkgconfig/lapacke.pc\nName: lapacke\nVersion: 3\nDescription: LAPACK C implementation\nCflags: -I$dev/include\nLibs: -L$out/lib -llapacke\nEOF\n","mesonFlags":"","name":"lapack-3","nativeBuildInputs":"","out":"/nix/store/nmzb24chkjhj581y4dd6006lw7yvwwrh-lapack-3","outputs":"out dev","patches":"","pname":"lapack","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","system":"x86_64-linux","unpackPhase":"src=$PWD","version":"3"},"inputs":{"drvs":{"12aqc6cgq53348nizvwiybqr1l3h4wa7-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"cwq2dxxz8qs9xjm0shjr5cjgws1bjrng-openblas-0.3.32.drv":{"dynamicOutputs":{},"outputs":["out"]},"m1gn4v33cy6s5wwhcw138sbb1kgmza2q-liblapack-3.12.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"rdi2zjmbw7565gc4pa4fkzvzpgwpaaj3-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"lapack-3","outputs":{"dev":{"path":"6jn2ikrwa12m9k14gw5jqbhqarwhnkpl-lapack-3-dev"},"out":{"path":"nmzb24chkjhj581y4dd6006lw7yvwwrh-lapack-3"}},"system":"x86_64-linux","version":4},"pj356rb5v96girndvdq71j69fcrwjkh7-tzdata-1.19