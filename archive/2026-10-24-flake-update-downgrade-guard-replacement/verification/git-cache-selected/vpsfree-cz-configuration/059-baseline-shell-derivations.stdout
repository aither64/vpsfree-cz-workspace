:[],"name":"cups-2.4.19","nativeBuildInputs":["/nix/store/viqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2","/nix/store/svrzimmpgp5b9knw00b7cq6081hwadaz-remove-references-to"],"outputChecks":{"dev":{},"lib":{},"man":{},"out":{}},"outputs":["out","lib","dev","man"],"patches":["/nix/store/fymbancl9zzwfs7mbcsdydbv4hnqnyix-CVE-2026-87875.patch","/nix/store/h2jmni1pcbgacjv3qzkdfwc9mjlr26c0-76b515154ce6264dae6d7cc44915d85e0e5fa0f4.patch","/nix/store/qfnsmvv368rqax9w1803kd2cmla1zc9h-526adb34fe87f7f0cf5f63ae26751c1afa36a5d6.patch","/nix/store/sgwh5d4zml7m4zrjhv7z4629v3yacncx-CVE-2026-87876.patch"],"pname":"cups","postInstall":"libexec=lib/cups\nmoveToOutput $libexec \"$out\"\n\n# $lib contains references to $out/share/cups.\n# CUPS is working without them, so they are not vital.\nfind \"$lib\" -type f -exec grep -q \"$out\" {} \\; \\\n     -printf \"removing references from %p\\n\" \\\n     -exec remove-references-to -t \"$out\" {} +\n\n# Delete obsolete stuff that conflicts with cups-filters.\nrm -rf $out/share/cups/banners $out/share/cups/data/testprint\n\nmoveToOutput bin/cups-config \"$dev\"\nsed -e \"/^cups_serverbin=/s|$lib|$out|\" \\\n    -i \"$dev/bin/cups-config\"\n\nfor f in \"$out\"/lib/systemd/system/*; do\n  substituteInPlace \"$f\" --replace \"$lib/$libexec\" \"$out/$libexec\"\ndone\n# Use xdg-open when on Linux\nsubstituteInPlace \"$out\"/share/applications/cups.desktop \\\n  --replace \"Exec=htmlview\" \"Exec=xdg-open\"\n","postPatch":"substituteInPlace cups/testfile.c \\\n  --replace 'cupsFileFind(\"cat\", \"/bin' 'cupsFileFind(\"cat\", \"/nix/store/bhv6xyvqw6gjs3j488gi1z6wdv18bdpa-coreutils-9.11/bin'\n\n  # The cups.socket unit shouldn't be part of cups.service: stopping the\n  # service would stop the socket and break subsequent socket activations.\n  # See https://github.com/apple/cups/issues/6005\n  sed -i '/PartOf=cups.service/d' scheduler/cups.socket.in\n","preConfigure":"export AR=\"/nix/store/g2i5zxslx9msaqjy14hdp2af064i9pbv-binutils-2.46/bin/ar\"\nconfigureFlagsArray+=(\n  # Put just lib/* and locale into $lib; this didn't work directly.\n  # lib/cups is moved back to $out in postInstall.\n  # Beware: some parts of cups probably don't fully respect these.\n  \"--prefix=$lib\"\n  \"--datadir=$out/share\"\n  \"--localedir=$lib/share/locale\"\n\n  \"--with-systemd=$out/lib/systemd/system\"\n\n  \n)\n","propagatedBuildInputs":["/nix/store/48zd0j6xb1z8n6sqlz2kwbhl1c7z6zky-gmp-with-cxx-6.3.0-dev"],"propagatedNativeBuildInputs":[],"src":"/nix/store/0i7wmspcvcdzd774aspbr14kikdvcpdy-cups-2.4.19-source.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"2.4.19"},"system":"x86_64-linux","version":4},"2v7gikmmc4g0pz53z7fgw8s2cjhl1csz-aws-c-io-0.27.2.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildInputs":"/nix/store/52zkl7ambd31fncmb8h1yljizzh2ihah-aws-c-cal-0.9.2 /nix/store/6cqd5cpqm7flgpi0fl4003j4ys5hja6v-aws-c-common-0.12.4 /nix/store/bkmw2db14mcvrqxb8hrr7j46vy4xj3kb-s2n-tls-1.7.6-dev","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"-DBUILD_SHARED_LIBS=ON","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","mesonFlags":"","name":"aws-c-io-0.27.2","nativeBuildInputs":"/nix/store/v4m910fin3csvzhv8pq6aivvi6ghmzmp-cmake-4.1.6","out":"/nix/store/3kz2hypzh1f5x0v4jirzv8gmh41xzpaj-aws-c-io-0.27.2","outputs":"out","patches":"","pname":"aws-c-io","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/6q6lxv289j0jhcv9kkzn2xwq6mdhmb1k-source","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.27.2"},"inputs":{"drvs":{"2mss6cpbkhkrv4qcgngg8hdk08zhba33-s2n-tls-1.7.6.drv":{"dynamicOutputs":{},"outputs":["dev"]},"3lg2g6fn024afn5cqhvxzlm82av4lb2v-aws-c-common-0.12.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"g2x5r8bb6wgvq0yl95dyyyrwlds1816i-aws-c-cal-0.9.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"mcpyhlrnzspkilnndql5xxghmp3a4hf0-cmake-4.1.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqwcaqvn7s00i00r71xjpb8wbyfkqywr-source.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"aws-c-io-0.27.2","outputs":{"out":{"path":"3kz2hypzh1f5x0v4jirzv8gmh41xzpaj-aws-c-io-0.27.2"}},"system":"x86_64-linux","version":4},"2vjn5zz36jgkxkai1s8awgwy2c6z8cw0-ruby3.4-curses-1.5.3.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","env":{"NIX_CFLAGS_COMPILE":"","NIX_MAIN_PROGRAM":"curses","__structuredAttrs":"","buildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9 /nix/store/gi6n3gp7z0d1j4f2zpc7rwygjj45zgm4-ncurses-6.6-dev","buildPhase":"runHook preBuild\n\nif [[ \"$gemType\" == \"gem\" ]]; then\n  if [[ -z \"$gemspec\" ]]; then\n    gemspec=\"$(find . -name '*.gemspec')\"\n    echo \"found the following gemspecs:\"\n    echo \"$gemspec\"\n    gemspec=\"$(echo \"$gemspec\" | head -n1)\"\n  fi\n\n  exec 3>&1\n  output=\"$(gem build $gemspec | tee >(cat - >&3))\"\n  exec 3>&-\n\n  gempkg=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/gik3rh1vz2jlgnifb9dh6vc6sxwwz9jj-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"","dontStrip":"","gemName":"curses","gemPath":"","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-curses-1.5.3","nativeBuildInputs":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9 /nix/store/qw8rpqmndqzyc3fzzla754v5hlpm10i4-make-shell-wrapper-hook","out":"/nix/store/24cm96720gg40dq1hkfg868b8bd5287w-ruby3.4-curses-1.5.3","outputs":"out","patches":"","pname":"curses","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"","ruby":"/nix/store/lkrkc1fxj9yr3ghsxp7nq30c2hxn9z0k-ruby-3.4.9","src":"/nix/store/pblf489c2n3y67r0snxzin7j6sllal02-curses-1.5.3.gem","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":"","suffix":"1.5.3","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preU