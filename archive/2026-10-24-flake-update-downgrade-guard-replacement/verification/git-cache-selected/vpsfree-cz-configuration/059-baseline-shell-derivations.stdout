++\n\nif [ -e $ccPath/gcc ]; then\n  wrap gcc $wrapper $ccPath/gcc\n  ln -s gcc $out/bin/cc\n  export named_cc=gcc\n  export named_cxx=g++\nelif [ -e $ccPath/clang ]; then\n  wrap clang $wrapper $ccPath/clang\n  ln -s clang $out/bin/cc\n  export named_cc=clang\n  export named_cxx=clang++\nelif [ -e $ccPath/arocc ]; then\n  wrap arocc $wrapper $ccPath/arocc\n  ln -s arocc $out/bin/cc\n  export named_cc=arocc\nfi\n\nif [ -e $ccPath/g++ ]; then\n  wrap g++ $wrapper $ccPath/g++\n  ln -s g++ $out/bin/c++\nelif [ -e $ccPath/clang++ ]; then\n  wrap clang++ $wrapper $ccPath/clang++\n  ln -s clang++ $out/bin/c++\nfi\n\nif [ -e $ccPath/cpp ]; then\n  wrap cpp $wrapper $ccPath/cpp\nelif [ -e $ccPath/cpp ]; then\n  wrap cpp $wrapper $ccPath/cpp\nfi\n","isArocc":"","isClang":"","libc_bin":"/nix/store/kgd806ssw99qaxwiislhfx5dwnc8k893-glibc-2.42-100-bin","libc_dev":"/nix/store/sr08dm9x0fsa1mrzjrlb3csdcmilsraz-glibc-2.42-100-dev","libc_lib":"/nix/store/fsd4vbp9zjd9iaicq2fb9lpc1h5j973y-glibc-2.42-100","man":"/nix/store/9q2abc764ggiqxv4bk203hc6hwvy98ni-bootstrap-stage4-gcc-wrapper-15.3.0-man","mesonFlags":"","mktemp":"/nix/store/phljivqdkyfx0ckl510sw7z1m540h1mw-coreutils-static-9.10/bin/mktemp","name":"bootstrap-stage4-gcc-wrapper-15.3.0","nativeBuildInputs":"","out":"/nix/store/di1dfxbmyj1bz0d2m04jqm7zilhqp76h-bootstrap-stage4-gcc-wrapper-15.3.0","outputs":"out man info","patches":"","pname":"bootstrap-stage4-gcc-wrapper","postFixup":"touch \"$out/nix-support/cc-cflags\"\ntouch \"$out/nix-support/cc-ldflags\"\nif [[ -f \"$bintools/nix-support/dynamic-linker\" ]]; then\n  ln -s \"$bintools/nix-support/dynamic-linker\" \"$out/nix-support\"\nfi\nif [[ -f \"$bintools/nix-support/dynamic-linker-m32\" ]]; then\n  ln -s \"$bintools/nix-support/dynamic-linker-m32\" \"$out/nix-support\"\nfi\necho \"-L/nix/store/s2f0mfx0iiap9yxmlfvq0psn26jsbind-gcc-15.3.0/lib/gcc/x86_64-unknown-linux-gnu/15.3.0\" >> $out/nix-support/cc-ldflags\necho \"-L/nix/store/dqj57l1prad38vjrad4bs9d977i4q5zm-gcc-15.3.0-l