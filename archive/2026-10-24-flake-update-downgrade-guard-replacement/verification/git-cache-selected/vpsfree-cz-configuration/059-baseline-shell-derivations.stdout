"x86_64-unknown-linux-gnu\".llvm-config=/nix/store/rfx89pjxx0dzlw8rbl9h5i1xsfv137kv-llvm-21.1.8-dev/bin/llvm-config","--set=target.\"x86_64-unknown-linux-gnu\".llvm-config=/nix/store/rfx89pjxx0dzlw8rbl9h5i1xsfv137kv-llvm-21.1.8-dev/bin/llvm-config","--set=target.\"x86_64-unknown-linux-gnu\".llvm-config=/nix/store/rfx89pjxx0dzlw8rbl9h5i1xsfv137kv-llvm-21.1.8-dev/bin/llvm-config","--set=target.wasm32-unknown-unknown.optimized-compiler-builtins=false","--set=target.wasm32v1-none.optimized-compiler-builtins=false","--enable-profiler","--set=rust.frame-pointers"],"configurePlatforms":[],"depsBuildBuild":["/nix/store/788mx070y81zjlg5ipcl0cra3afviw9k-gcc-wrapper-15.2.0","/nix/store/1m05k7xgfnw6jc21xxk5681ni3ar97wf-pkg-config-wrapper-0.29.2"],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"dontFixLibtool":true,"dontUpdateAutotoolsGnuConfigScripts":true,"dontUseCmakeConfigure":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"NIX_LDFLAGS":"--push-state --as-needed -lstdc++ --pop-state","NIX_MAIN_PROGRAM":"rustc","RUSTDOCFLAGS":"-A rustdoc::broken-intra-doc-links","RUSTFLAGS":"-Ccodegen-units=10 -Clinker-features=-lld -Clink-self-contained=-linker"},"mesonFlags":[],"name":"rustc-1.95.0","nativeBuildInputs":["/nix/store/85p0m744v3xm1qwc6kba78srkyirlwli-file-5.47-dev","/nix/store/60m4rxhg2fldqaak400c0lry96ijrzqn-python3-3.13.13","/nix/store/aal0xbgd8lv1iij5jbvia44si07w0vh8-rustc-bootstrap-wrapper-1.95.0","/nix/store/r9941n32g4wyvggz2703dlplbdq8a6rd-cmake-4.1.2","/nix/store/91d9n98grpqj93576zl27bd5x0khcsvv-which-2.23","/nix/store/aj7zqrfxvg96ldyph7fly6qgprcm2krv-libffi-3.5.2-dev","/nix/store/i03v7b50ni09y85lvjphbyxrv64x4gfp-remove-references-to","/nix/store/1m05k7xgfnw6jc21xxk5681ni3ar97wf-pkg-config-wrapper-0.29.2","/nix/store/91iczghslmxl3lafdy7z95cg76x2hiz7-xz-5.8.3-dev"],"outputChecks":{"doc":{},"man":{},"out":{}},"outputs":["out","man","doc"],"patches":[],"pname":"rustc","postInstall":"# install rustc-dev components. Necessary to build rls, clippy...\npython x.py dist rustc-dev\ntar xf build/dist/rustc-dev*tar.gz\ncp -r rustc-dev*/rustc-dev*/lib/* $out/lib/\nrm $out/lib/rustlib/install.log\nfor m in $out/lib/rustlib/manifest-rust*\ndo\n  sort --output=$m < $m\ndone\n\n# remove references to llvm-config in lib/rustlib/x86_64-unknown-linux-gnu/codegen-backends/librustc_codegen_llvm-llvm.so\n# and thus a transitive dependency on ncurses\nfind $out/lib -name \"*.so\" -type f -exec remove-references-to -t /nix/store/wfjvqf9zlh05w0admf7x1mz0jn4bfy21-llvm-21.1.8 '{}' '+'\n\n# remove uninstall script that doesn't really make sense for Nix.\nrm $out/lib/rustlib/uninstall.sh\n","postPatch":"patchShebangs src/etc\n\n# rust-lld is the name rustup uses for its bundled lld, so that it\n# doesn't conflict with any system lld.  This is not an\n# appropriate default for Nixpkgs, where there is no rust-lld.\nsubstituteInPlace compiler/rustc_target/src/spec/*/*.rs \\\n  --replace-quiet '\"rust-lld\"' '\"lld\"'\n\nrm -rf src/llvm\n\n# Useful debugging parameter\n# export VERBOSE=1\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"setOutputFlags":false,"setupHooks":"/nix/store/skyp8xs2584fkc44ki1cim9ag55wbi68-setup-hook.sh","src":"/nix/store/6wq4v4hfgx2875qszshp9x06wmlc5z65-rustc-1.95.0-src.tar.gz","stdenv":"/nix/store/jci7gw90lh2vdjaxkb6pzf9xp4v08wzs-stdenv-linux","strictDeps":false,"stripDebugList":["bin"],"system":"x86_64-linux","version":"1.95.0"},"system":"x86_64-linux","version":4},"1lb98fwhww94gwccvci4s6v0l5zsr4hl-hashable-1.5.1.0.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/vvlgjnnch92k53af32iwim3d7jdxai3y-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"out":"/nix/