nfi\n\necho \"#! $interpreterLine\" > $out\ncat \"$contentPath\" >> $out\n\nchmod +x $out\n\n# Relocate executable\n# Wrap it if makeWrapperArgs are specified\nmv $out tmp\n  mkdir -p $out/$(dirname \"/bin/pythoncheck.sh\")\n  mv tmp $out//bin/pythoncheck.sh\nif [ -n \"${makeWrapperArgs+${makeWrapperArgs[@]}}\" ]; then\n    wrapProgram $out//bin/pythoncheck.sh ${makeWrapperArgs[@]}\nfi\n","buildInputs":"","builder":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","content":"exec /nix/store/34zamrwmzg8i492gccdsavs6q8if754a-python3.13-flake8-7.3.0/bin/flake8 --show-source --ignore E501,W503 \"$1\"\n","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","interpreter":"/nix/store/ww21sq59scy3kfz9vsnvjcixwyf06hvk-dash-0.5.13.3/bin/dash","makeWrapperArgs":"","mesonFlags":"","name":"pythoncheck.sh","nativeBuildInputs":"/nix/store/hxzjnjwzvwn5ak0hkp5q7jhxvk86f24p-make-binary-wrapper-hook","out":"/nix/store/z0c2bs1gbzr8yir78c2d63f9jhk1nfx4-pythoncheck.sh","outputs":"out","passAsFile":"buildCommand content","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/mhmv0p4sqvfxsyxx58y6qx9zqfzyas1w-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"5r4cwm9fq5c0s3hyyjzri1279jim16w4-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"906f0r5yx85527y5bwqfd89mn8zksidw-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"h5sapbjsqgq4q6q2hnkf81hmmz7hwffs-python3.13-flake8-7.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"wrdcp1fi121cmjpbprvb0rzmfrkgkwy4-dash-0.5.13.3.drv