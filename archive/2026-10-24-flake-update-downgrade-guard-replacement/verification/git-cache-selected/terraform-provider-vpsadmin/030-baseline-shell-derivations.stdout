k /nix/store/z08ffd16vd6rk21hmrc0212yfyvpsid5-pypa-build-hook.sh /nix/store/hx2znyng8lnwnlh0xb2l3vjbrvqfziv1-python-runtime-deps-check-hook.sh /nix/store/bvdpwhp6ibrh30yxhkng06k12xh08cy7-pypa-install-hook /nix/store/qfc71d4v207hfd27wyrgplx5h5q88bsr-python-imports-check-hook.sh /nix/store/0vnybzbvmyfymqzkbfhbiqmw77k4j8hs-python-namespaces-hook.sh /nix/store/9qg447qk4a392hcbnw50dlvdjrxsi3yr-python-output-dist-hook","out":"/nix/store/a4x2b6nfs57pgkw5q0ac0bprzxdbgxrg-python3.13-setuptools-80.10.1","outputs":"out dist","patches":"/nix/store/3v3xiyd81sqak1z3qz29i7gvk3bq6qi2-reproducible-wheel.patch","pname":"setuptools","postFixup":"wrapPythonPrograms\n","postPatch":"sed -i \"/coherent.licensed/d\" pyproject.toml\n\n# Substitute version for reproducible builds\nsubstituteInPlace setuptools/version.py \\\n  --replace-fail '@version@' '80.10.1'\n","preBuild":"export SETUPTOOLS_INSTALL_WINDOWS_SPECIFIC_FILES=0\n","propagatedBuildInputs":"/nix/store/xqnbm0vgqcq9b1b54c80qj9s0qhbwa08-python3-3.13.15","propagatedNativeBuildInputs":"","src":"/nix/store/n4w6ira851v2q57ny58djkygql73di2y-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"80.10.1"},"inputs":{"drvs":{"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"ap559yn5splkg9xx19i0c1dj9gsr8461-python-runtime-deps-check-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"gi270rl7j8s51q5dd6lbnx3hf3w205d0-python-imports-check-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"hxj3kzmrf6gmj79cz7vkbxfyv5b6smq8-pypa-build-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"i5dqx9gw5ak1lmrj3xcnq1325mv6fcrh-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"i6ak61id4i92wjs3lf69x871fys8q5r2-python-output-dist-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"ijd45rmv7z76b4cf8kqqx59a5xilx7bq-python-remove-tests-dir-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"k736pfznm91nq65ii8m5bbdzg3ikxyrg-python-namespace