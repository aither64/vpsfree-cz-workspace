"${oldFiles[@]}\"\n\nsubstituteAllInPlace gettext-runtime/src/gettext.sh.in\nsubstituteInPlace gettext-tools/projects/KDE/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/projects/GNOME/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/src/project-id --replace \"/bin/pwd\" pwd\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHooks":"/nix/store/v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash /nix/store/ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","src":"/nix/store/n4lwy41bnpq1fsqsrf5fac3m7vmhk6sr-gettext-1.0.tar.gz","stdenv":"/nix/store/wqz1q99z5ypzn2mp85xnbg1l0f209b19-bootstrap-stage1-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"1.0"},"inputs":{"drvs":{"4m1sdiyd4qgqranq5p59fnx1r113blm5-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["dev"]},"9xz2wwg0dg2krrrvav8iy9gywxaqxkgp-bootstrap-stage1-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"b5w3z8a09hzgc6q7cmynrzys2s00ak6z-update-autotools-gnu-config-scripts-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"z1a6zj82v13glfvrfnhjkpic03y4kppc-bash-static-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"zdbga6f8g5jysvhngmnjlwmj674bzds2-gettext-1.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash","yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch"]},"name":"gettext-1.0","outputs":{"doc":{"path":"4qkfbpg85rvy49yc0k0b96mlw2jkfq9p-gettext-1.0-doc"},"info":{"path":"v50bp23alljg2b8l3z16yr661jrvc9gl-gettext-1.0-info"},"man":{"path":"z8vdmhspsjh36ackzq0qmwlm714l5qck-gettext-1.0-man"},"out":{"path":"k7p6bz6kzj6advgsjfkpccwh41if2zyz-gettext-1.0"}},"system":"x86_64-linux","version":4},"z5i7na9qpvfx6wx5phib8gwhqd1kyp99-fdputs-builder.drv":