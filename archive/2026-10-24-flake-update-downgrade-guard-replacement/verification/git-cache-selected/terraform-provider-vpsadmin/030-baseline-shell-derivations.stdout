/store/72qwwnvy0cqigflhvy15x4g0511cdsnh-openssl-3.6.3-man","mesonFlags":"","name":"openssl-3.6.3","nativeBuildInputs":"/nix/store/hxzjnjwzvwn5ak0hkp5q7jhxvk86f24p-make-binary-wrapper-hook /nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0 /nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/14cfdqp8w2iw188vhjfaz2wg8pzbghp3-openssl-3.6.3","outputs":"bin dev out man doc debug","patches":"/nix/store/sq4h6bqjx12v9whvm65pjss25hg1538q-nix-ssl-cert-file.patch /nix/store/cklrwbwi889pp2fdsswdjvn12sdy5i5j-openssl-disable-kernel-detection.patch /nix/store/i58agvhx8bmdjlspgkk4m3ylh5348iim-use-etc-ssl-certs.patch","pname":"openssl","postFixup":"# Check to make sure the main output and the static runtime dependencies\n# don't depend on perl\nif grep -r '/nix/store/jksq0zyk08l29w4alp0g3ycgx6pwwjdk-perl-5.42.0' $out $etc; then\n  echo \"Found an erroneous dependency on perl ^^^\" >&2\n  exit 1\nfi\n# cleanup cmake helpers for now (for OpenSSL >= 3.3), only rely on pkg-config.\n# pkg-config gets its paths fixed correctly\nrm -rf $dev/lib/cmake\n","postInstall":"# If we're building dynamic libraries, then don't install static\n# libraries.\nif [ -n \"$(echo $out/lib/*.so $out/lib/*.dylib $out/lib/*.dll)\" ]; then\n    rm \"$out/lib/\"*.a\nfi\n\n# 'etc' is a separate output on static builds only.\netc=$out\nmkdir -p $bin\nmv $out/bin $bin/bin\n\n# c_rehash is a legacy perl script with the same functionality\n# as `openssl rehash`\n# this wrapper script is created to maintain backwards compatibility without\n# depending on perl\nmakeWrapper $bin/bin/openssl $bin/bin/c_rehash \\\n  --add-flags \"rehash\"\n\nmkdir $dev\nmv $out/include $dev/\n\n# remove dependency on Perl at runtime\nrm -r $etc/etc/ssl/misc\n\nrmdir $etc/etc/ssl/{certs,private}\n","postPatch":"patchShebangs Configure\nsubstituteInPlace config --replace '/usr/bin/env' '/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/env'\n","preCheck":"patchShebangs util\n","propagatedB