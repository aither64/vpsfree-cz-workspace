PLT||' src/math/x86_64/expl.s\nsed -i 's|@PLT||' src/signal/x86_64/sigsetjmp.s\n\n# TODO Implement the required asm constraints 'x' and 't' in tinycc.\n# For now, we just remove code using those constraints. musl automatically\n# polyfills with pure C implementations.\nrm src/math/i386/*.c\nrm src/math/x86_64/*.c\n\n# Configure\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --disable-shared \\\n  CC=tcc\n\n# Build\n# NOTE: parallel build (-j) under tcc here is unstable and broke a previous run.\nmake AR=\"tcc -ar\" RANLIB=true CFLAGS=\"-DSYSCALL_NO_TLS\"\n\n# Install\nmake install\ncp /nix/store/rayh0cq2ik1xyw2hclrkdn7c67lppg2r-tinycc-mes-libs-unstable-2025-12-03/lib/libtcc1.a $out/lib\n","builder":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","name":"musl-1.2.6","out":"/nix/store/n68vha7bj7ki3yr4nqv4bn324vzgw5ai-musl-1.2.6","passAsFile":"buildCommand","pname":"musl","system":"x86_64-linux","version":"1.2.6"},"inputs":{"drvs":{"1vgxf29abq71i0mh3m5839my4664jfmh-tinycc-mes-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"54jdq8vp944qn49b18harrbjw34dlxcp-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"59pgig863abfc3p6lmz20vh8gjf2nsv1-musl-1.2.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"9ms5jx08n6hdg7ji8fxln4lsfbzd92fa-gnused-mes-4.0.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"b0faqgmz5282qmis5v2m13b7bsc0y9jg-gnumake-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"bv4a5fw05q4ysq24wy0z06bd5jysq1p2-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"d9hngw468h7b7fpcyx284kqwdgcn3gzy-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"pshx4r5vypzz5cjy5ikscgjyzhv2s99x-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a9pds57ms69gfi2ya-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs