er":"/nix/store/rzl7zd3zx56vl7m55x1l49sr4xx2bb7y-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"--disable-setuid --disable-cache-owner --localstatedir=/var --with-config-file=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/etc/man_db.conf --with-systemdtmpfilesdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/tmpfiles.d --with-systemdsystemunitdir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/systemd/system --with-pager=less --with-col=/nix/store/j2cwh4a23s7z65nyvjfck2axj2ci16ml-util-linux-minimal-2.42.2-bin/bin/col","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","disallowedReferences":"","doCheck":"1","doInstallCheck":"","doc":"/nix/store/w4dijcw76ql2ll919zdkpl1raah0n1mk-man-db-2.13.1-doc","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"man-db-2.13.1","nativeBuildInputs":"/nix/store/g5qbbj4cmzq1133lnvmaxanrlxl0k7ac-autoconf-2.73 /nix/store/prmvgm1wz27c4ipx6xigqjikshmyzxrn-automake-1.18.1 /nix/store/y3ym52hvpsp1f8c8jd58rlhyj5yigibn-flex-2.6.4 /nix/store/db8cwzsgxv3lijvf18kqvjjbylm5hrpi-gettext-1.0 /nix/store/c6rl57qqmx2sk112kdgpk26ghm77s0li-groff-1.24.1 /nix/store/ligd2psjpczqdhiy59ccs6a4k7w2xr5n-libtool-2.5.4 /nix/store/bnpp6hwrlvcdyijh5fpqyn13m11sy8rp-make-shell-wrapper-hook /nix/store/cizqnkc40i7k401f8cl2260ksi9nnph4-pkg-config-wrapper-0.29.2 /nix/store/n0adwsx0sxhrfq6x32zm2is31xzhaf5y-zstd-1.5.7-dev /nix/store/n3glfh8a03w0nvhnp9grivvvvbifhc0c-glibc-iconv-2.42","out":"/nix/store/phvdhap8ylrf7xffpbqlad69faza6mdx-man-db-2.13.1","outputMan":"out","outputs":"out doc","patches":"/nix/store/p4m9shlpsqrvir464livcdni0y32ah3f-systemwide-man-db-conf.patch","pname":"man-db","postInstall":"# apropos/whatis uses program name to decide whether to act like apropos or whatis\n# (multi-call binary). `apropos` is actually just a symlink to whatis. So we need to\n# make sure that we don't wrap symlinks (since that changes argv[0] to the -wrapped name)\nfind \"$out/bin\" -type f | while read file; do\n  wrapProgram \"$file\" \\\n    --prefix PATH : \"/nix/store/c6rl57qqmx2sk112kdgpk26ghm77s0li-groff-1.24.1/bin:/nix/store/2722ncq58c1amdv6g6nv5d1wvab30p0r-gzip-1.14/bin:/nix/store/xvd9s1sg5fb4zrvr649i4dydrrkngrj1-zstd-1.5.7-bin/bin\"\ndone\n","postPatch":"# Remove all mandatory manpaths. Nixpkgs makes no requirements on\n# these directories existing.\nsed -i 's/^MANDATORY_MANPATH/# &/' src/man_db.conf.in\n\n# Add Nix-related manpaths\necho \"MANPATH_MAP\t/nix/var/nix/profiles/default/bin\t/nix/var/nix/profiles/default/share/man\" >> src/man_db.conf.in\n\n# Add mandb locations for the above\necho \"MANDB_MAP\t/nix/var/nix/profiles/default/share/man\t/var/cache/man/nixpkgs\" >> src/man_db.conf.in\n","preConfigure":"./bootstrap --no-git --gnulib-srcdir=/nix/store/pir73cc0nvg51xr7rpm0z8w3b6yk1jz7-gnulib-20241001 --gen\nconfigureFlagsArray+=(\"--with-sections=1 n l 8 3 0 2 5 4 9 6 7\")\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/6kz444k9yjlacfhrbw84qrbw1mk7vjgw-source","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.13.1"},"inputs":{"drvs":{"1vj2zqqdc9izhzl9adm83xs75097zirc-gzip-1.14.drv":{"dynamicOutputs":{},"outputs":["out"]},"3bkl4yqj9z2vyd4ginlzfh6cv8x8997j-flex-2.6.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"5n2k8nv60xzr2j7g43w5f70g0gk68y70-gdbm-1.26.drv":{"dynamicOutputs":{},"outputs":["dev"]},"5z8sj1169xaps07s9yw780fvznwn8yqy-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"773919n1zvj8z1v6yr53j218gs5pgz1l-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"9a8hhc7dn0dp542x4b649xvl4bjckmvs-gnulib-20241001.drv":{"dynamicOutputs":{},"outputs":["out"]},"bcym5142y4c40f8jrwn7b08mm2gm2pnq-zstd-1.5.7.drv":{"dynamicOutputs":{},"outputs":["bin","dev"]},"c3294j