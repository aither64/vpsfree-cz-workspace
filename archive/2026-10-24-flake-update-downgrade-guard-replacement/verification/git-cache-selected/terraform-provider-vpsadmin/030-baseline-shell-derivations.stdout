":"x86_64-linux","text":"# Unpack\nungz --file /nix/store/gg47zajh5pmy3hb3y8a70dmk8yjcrvgd-coreutils-5.0.tar.gz --output coreutils.tar\nuntar --file coreutils.tar\nrm coreutils.tar\ncd coreutils-5.0\n\n# Patch\npatch -Np0 -i /nix/store/9i7n3wp23knjjhfwlcz9kdfkk7l9c7h2-modechange.patch\npatch -Np0 -i /nix/store/slaqid4v26zi8kdxb6gahfg1jl3sk859-mbstate.patch\npatch -Np0 -i /nix/store/vvqf57w4hgpmj2g6i0yv08smbkfyb34i-ls-strcmp.patch\npatch -Np0 -i /nix/store/7ns4z67sizbgbkq0dbcmmyxymv6kqjcs-touch-getdate.patch\npatch -Np0 -i /nix/store/xvaxic53ind0xba3sk0p6y4qqc455ckv-touch-dereference.patch\npatch -Np0 -i /nix/store/h24jwyqgava9fwnq8rxfk56n2gi25wgs-expr-strcmp.patch\npatch -Np0 -i /nix/store/05wlphr2qz9kd5hfqs9lkd6wspkwwydj-sort-locale.patch\npatch -Np0 -i /nix/store/x5w3ymyhkr12h96l3jnnxwgmixqr0v8r-uniq-fopen.patch\n\n# Configure\ncatm config.h\ncp lib/fnmatch_.h lib/fnmatch.h\ncp lib/ftw_.h lib/ftw.h\ncp lib/search_.h lib/search.h\nrm src/dircolors.h\n\n# Build\nmake -f /nix/store/r7x7s6nhj2xbra35dpd7pp0wy03ax69f-main.mk \\\n  CC=\"tcc -B /nix/store/rayh0cq2ik1xyw2hclrkdn7c67lppg2r-tinycc-mes-libs-unstable-2025-12-03/lib\" \\\n  PREFIX=${out}\n\n# Check\n./src/echo \"Hello coreutils!\"\n\n# Install\n./src/mkdir -p ${out}/bin\nmake -f /nix/store/r7x7s6nhj2xbra35dpd7pp0wy03ax69f-main.mk install PREFIX=${out}\n"},"inputs":{"drvs":{"013mqc5ymx4cih72blz21l6ync49i3jg-expr-strcmp.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"aspfvh0wlsi4w6kva34p3m9kkcxr7vym-sort-locale.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"b147bn8sgyn2s58vy3cw59d89vrd482g-mbstate.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"br3yqsjafxyhh91879brxq1xzbyjwlwb-ls-strcmp.patch.drv":{"dynamicOutputs":{},"outputs":["out"]},"c672ird0l7wv8dr5idknpgnh1rhzlnqf-coreutils-5.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"lbn6dc55b8f36v2p2hkqbpk2z63wnjyx-touch-dereference.p