\n  sort --output=$m < $m\ndone\n\n# remove references to llvm-config in lib/rustlib/x86_64-unknown-linux-gnu/codegen-backends/librustc_codegen_llvm-llvm.so\n# and thus a transitive dependency on ncurses\nfind $out/lib -name \"*.so\" -type f -exec remove-references-to -t /nix/store/djdwgbwx1zhjqrwd7zkpc43ml1yrxlli-llvm-21.1.8 '{}' '+'\n\n# remove uninstall script that doesn't really make sense for Nix.\nrm $out/lib/rustlib/uninstall.sh\n","postPatch":"patchShebangs src/etc\n\n# rust-lld is the name rustup uses for its bundled lld, so that it\n# doesn't conflict with any system lld.  This is not an\n# appropriate default for Nixpkgs, where there is no rust-lld.\nsubstituteInPlace compiler/rustc_target/src/spec/*/*.rs \\\n  --replace-quiet '\"rust-lld\"' '\"lld\"'\n\nrm -rf src/llvm\n\n# Useful debugging parameter\n# export VERBOSE=1\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"requiredSystemFeatures":["big-parallel"],"setOutputFlags":false,"setupHooks":"/nix/store/skyp8xs2584fkc44ki1cim9ag55wbi68-setup-hook.sh","src":"/nix/store/6wq4v4hfgx2875qszshp9x06wmlc5z65-rustc-1.95.0-src.tar.gz","stdenv":"/nix/store/843sqza79ns6k8n7sykxwmy04s741jzn-stdenv-linux","strictDeps":false,"stripDebugList":["bin"],"system":"x86_64-linux","version":"1.95.0"},"system":"x86_64-linux","version":4},"3siddy2kzlx0pj7h8s15jgqdicg3j3lr-pcre2-10.46.tar.bz2.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"builtin:fetchurl","executable":"","impureEnvVars":"http_proxy https_proxy ftp_proxy all_proxy no_proxy","name":"pcre2-10.46.tar.bz2","out":"/nix/store/np3ayc9gwp1li9m1fnl2qv0fvpcmi632-pcre2-10.46.tar.bz2","outputHash":"sha256-FfvFq6a+7gsXrssEYCrjlDI5OroevY45t8q/fbiDKZ8=","outputHashAlgo":"","outputHashMode":"flat","preferLocalBuild":"1","system":"builtin","unpack":"","url":"https://github.com/PhilipHazel/pcre2/releases/download/pcre2-10.46/pcre2-10.46.tar.bz2","urls":"https://github.com/PhilipHazel/pcre2/releases/download/pcre2-10.46/pcre2-10.46.tar.bz2"},"inputs