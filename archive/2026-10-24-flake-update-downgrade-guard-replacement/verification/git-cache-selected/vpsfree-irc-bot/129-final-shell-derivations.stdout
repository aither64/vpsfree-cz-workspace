e with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/fpi61m83w03q7nsz1pksz63i6xqqgl74-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/fpi61m83w03q7nsz1pksz63i6xqqgl74-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/1ij5xcr25khr40jrb35rms45p3r7pn04-splitmix-0.1.3.2.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.1.3.2"},"inputs":{"drvs":{"0hgm16z2q5nk69z0mimypg562gvp4y2m-ghc-binary-9.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"7v69i4ixacxjdan9gx0h4j9q0g3jv11k-glibc-locales-2.42-100.drv":{"dynamicOutputs":{},"outputs":["out"]},"clcylca4i2jffp0n5mihlv8ji9lbscsv-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]},"d22jg4nh7xm8mdw99p176dw8j35lhrsk-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"k3wn36zbr3l13w60qf9248i1l7382qyd-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"r3ziwzs5n9i4hlr4qrzl6hx9bgr5jqbb-splitmix-0.1.3.2.tar.gz.drv":{"dynamicOutputs":{},"outputs"