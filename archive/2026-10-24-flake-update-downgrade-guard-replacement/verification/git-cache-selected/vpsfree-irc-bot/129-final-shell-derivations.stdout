enableParallelChecking":"1","enableParallelInstalling":"1","mesonFlags":"","name":"man-db-2.13.1","nativeBuildInputs":"/nix/store/zsyaikhmdaxra0mh3mbxkahgvgh17d5a-autoconf-2.73 /nix/store/7jhxllqrbjwdl7i97b92l6llnly5xj8a-automake-1.18.1 /nix/store/lmlgg4x8djbs8mcxrk1b299dja91v1mh-flex-2.6.4 /nix/store/r6cl7zk1vhckkbnrjvvgf5ah1a23s090-gettext-1.0 /nix/store/yb5g8vgvkfbaix9s1lbx3gqdp1c3pyl2-groff-1.24.2 /nix/store/f3hj3hnd7rhqk4mw9qfz7dphgy19y2zc-libtool-2.5.4 /nix/store/7whrgb2wib2q83wgbs78xsq9h25lf3aw-make-shell-wrapper-hook /nix/store/viqf3122g0bn0ahqgns1yg52axx9p531-pkg-config-wrapper-0.29.2 /nix/store/1hjg44rywjpc52nnhs1z9iba9vgr2s3n-zstd-1.5.7-dev /nix/store/ngy9kz80vpiylr093kjbcv8y2igq0m80-glibc-iconv-2.42","out":"/nix/store/bji80frz88sg8ai8n71sgvjkwg7whr3m-man-db-2.13.1","outputMan":"out","outputs":"out doc","patches":"/nix/store/p4m9shlpsqrvir464livcdni0y32ah3f-systemwide-man-db-conf.patch","pname":"man-db","postInstall":"# apropos/whatis uses program name to decide whether to act like apropos or whatis\n# (multi-call binary). `apropos` is actually just a symlink to whatis. So we need to\n# make sure that we don't wrap symlinks (since that changes argv[0] to the -wrapped name)\nfind \"$out/bin\" -type f | while read file; do\n  wrapProgram \"$file\" \\\n    --prefix PATH : \"/nix/store/yb5g8vgvkfbaix9s1lbx3gqdp1c3pyl2-groff-1.24.2/bin:/nix/store/k1z3ys65nbrdc60975wajrj4xjwaqqm4-gzip-1.14/bin:/nix/store/z8fp2l0b1k64swd0dxpych445wpfcgb0-zstd-1.5.7-bin/bin\"\ndone\n","postPatch":"# Remove all mandatory manpaths. Nixpkgs makes no requirements on\n# these directories existing.\nsed -i 's/^MANDATORY_MANPATH/# &/' src/man_db.conf.in\n\n# Add Nix-related manpaths\necho \"MANPATH_MAP\t/nix/var/nix/profiles/default/bin\t/nix/var/nix/profiles/default/share/man\" >> src/man_db.conf.in\n\n# Add mandb locations for the above\necho \"MANDB_MAP\t/nix/var/nix/profiles/default/share/man\t/var/cache/man/nixpkgs\" >> src/man_db.conf.in\n","preConfigure":"./bootstrap --no-git --gnulib-srcdir=/nix/store/c1gf156iz5dvjhavrs76wgpp7lhgna2a-gnulib-20241001 --gen\nconfigureFlagsArray+=(\"--with-sections=1 n l 8 3 0 2 5 4 9 6 7\")\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/6kz444k9yjlacfhrbw84qrbw1mk7vjgw-source","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.13.1"},"inputs":{"drvs":{"049faz5h2hlc77kx3f6hvc147xrfc1n5-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"09abhpb3pjvn3slijacfmsc4vhgkhz1g-automake-1.18.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"63zjnxw73yn1avnz9vcsb4hjlsvd0gls-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"7jap05zl3zza0vpny5xl99cy0gskdyyw-autoconf-2.73.drv":{"dynamicOutputs":{},"outputs":["out"]},"8gapxvhc7ng94fwd1d0dbhbxbknp6jdx-gnulib-20241001.drv":{"dynamicOutputs":{},"outputs":["out"]},"a7sw3xa7f8ahlfrcf3q7xzy4rhdhvsvh-util-linux-minimal-2.42.3.drv":{"dynamicOutputs":{},"outputs":["bin"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"f5rf6zv347sh3m73gy41s2d754rdr8d4-gdbm-1.26.drv":{"dynamicOutputs":{},"outputs":["dev"]},"hvyi92d5vsapf07rgi74cpgbh01v90hi-libtool-2.5.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"jzwacclklik7wjl3pqajq05wk0xr0nm7-gettext-1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"laww36xl5rkzp0jcy7vds06zg54i0xzn-libpipeline-1.5.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"n61p2y23bl4y2h9708d3v5vnhr38zhbd-flex-2.6.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"pl2j9w5ajl202537ri6x9sc471950973-gzip-1.14.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"qnxjz3xfvq76k55ig1lh76fb7plrq44p-groff-1.24.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"vr3p7vp9fnzpgvgbphlvr9bwzrq411jb-zstd-1.5.7.drv":{"dynamicOutputs":{},"outputs":["bin","dev"]},"y694hsjrxppxbxil7b1ynahhxf6m6g6f-source.drv":{"dynamicOutputs":{},"o