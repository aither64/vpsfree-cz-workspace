mlc1vi8i6xkarmm26smwcp882ximw5pr-nix-2.34.9-doc"},"man":{"path":"11jbx6jwdr4gdmhjjqd39q9ddx25qx34-nix-2.34.9-man"},"out":{"path":"5np0yidzrnyjbb243hvgqpgpss865p0n-nix-2.34.9"}},"system":"x86_64-linux","version":4},"p3x8835w2rwiyy79ydrjmnz7kq5nsdia-tinycc-musl-unstable-2025-12-03.drv":{"args":["-e","/nix/store/9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh"],"builder":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","env":{"PATH":"/nix/store/xvm05v25kkk0fmg7xfvkwzxyhiv1hzsd-tinycc-musl-unstable-2025-12-03-compiler/bin:/nix/store/8rshwxfxypgdc35c4ys7b4yn92i5g7fn-gnupatch-2.5.9/bin:/nix/store/aa37acnhlqvnngs2q8kk34rlsjg4bqgm-gnutar-1.12/bin:/nix/store/y9mmd3nq732mzkhc0hvyr7xzf4jr5g2g-gzip-1.2.4/bin:/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin:/nix/store/wb7pvclab1aaa7myi0jafbjc60d5yij5-bootstrap-coreutils-5.0/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","SHELL":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","buildCommand":"# Unpack\ntar xzf /nix/store/j8vqssml916z4hvq1dk36w19grfrks7y-cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341.tar.gz\ncd tinycc-cb41cbf\n\n# Patch\npatch -Np0 -i /nix/store/caakpwmdf9gpgdinaqrikc7vr8y62mf6-static-link.patch\nreplace --file i386-asm.c --output i386-asm.c --match-on \"switch(size)\" --replace-with \"if (reg >= 8) { cstr_printf(add_str, \\\"%%r%d%c\\\", reg, (size == 1) ? 'b' : ((size == 2) ? 'w' : ((size == 4) ? 'd' : ' '))); return; } switch(size)\"\n\n# If performing ptr + (-1) for example, the offset should be ptrdiff_t and not size_t\nreplace --file tccgen.c --output tccgen.c --match-on \"vpush_type_size(pointed_type(&vtop[-1].type), &align);\" --replace-with \"vpush_type_size(pointed_type(&vtop[-1].type), &align); if (!(vtop[-1].type.t & VT_UNSIGNED)) gen_cast_s(VT_PTRDIFF_T);\"\n\n# Configure\ntouch config.h\n\n# Build\n# We first have to recompile using tcc-0.9.26 as tcc-0.9.27 is not self-hosting,\n# but when linked with musl it is.\nln -s /nix/store/z9j341wpiw4wsv5rbivkjbhc3y82hrrc-musl-1.2.6/lib/libtcc1.a ./libtcc1.a\n\ntcc \\\n  -B /nix/store/v752j1pqrdr4sc8015z0nal5hjrgk1c8-tinycc-musl-unstable-2025-12-03-libs/lib \\\n  -DC2STR \\\n  -o c2str \\\n  conftest.c\n./c2str include/tccdefs.h tccdefs_.h\n\ntcc -v \\\n  -static \\\n  -o tcc-musl \\\n  -D TCC_TARGET_X86_64=1 \\\n  -D CONFIG_TCCDIR=\\\"\\\" \\\n  -D CONFIG_TCC_CRTPREFIX=\\\"{B}\\\" \\\n  -D CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\" \\\n  -D CONFIG_TCC_LIBPATHS=\\\"{B}\\\" \\\n  -D CONFIG_TCC_SYSINCLUDEPATHS=\\\"/nix/store/z9j341wpiw4wsv5rbivkjbhc3y82hrrc-musl-1.2.6/include\\\" \\\n  -D TCC_LIBGCC=\\\"libc.a\\\" \\\n  -D TCC_LIBTCC1=\\\"libtcc1.a\\\" \\\n  -D CONFIG_TCC_STATIC=1 \\\n  -D CONFIG_USE_LIBGCC=1 \\\n  -D TCC_VERSION=\\\"0.9.27\\\" \\\n  -D ONE_SOURCE=1 \\\n  -D TCC_MUSL=1 \\\n  -D CONFIG_TCC_PREDEFS=1 \\\n  -D CONFIG_TCC_SEMLOCK=0 \\\n  -D CONFIG_TCC_BACKTRACE=0 \\\n  -B . \\\n  -B /nix/store/v752j1pqrdr4sc8015z0nal5hjrgk1c8-tinycc-musl-unstable-2025-12-03-libs/lib \\\n  tcc.c\n# libtcc1.a\nrm -f libtcc1.a\ntcc -c -D HAVE_CONFIG_H=1 lib/libtcc1.c\ntcc -ar cr libtcc1.a libtcc1.o\n\n# Rebuild tcc-musl with itself\n./tcc-musl \\\n  -v \\\n  -static \\\n  -o tcc-musl \\\n  -D TCC_TARGET_X86_64=1 \\\n  -D CONFIG_TCCDIR=\\\"\\\" \\\n  -D CONFIG_TCC_CRTPREFIX=\\\"{B}\\\" \\\n  -D CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\" \\\n  -D CONFIG_TCC_LIBPATHS=\\\"{B}\\\" \\\n  -D CONFIG_TCC_SYSINCLUDEPATHS=\\\"/nix/store/z9j341wpiw4wsv5rbivkjbhc3y82hrrc-musl-1.2.6/include\\\" \\\n  -D TCC_LIBGCC=\\\"libc.a\\\" \\\n  -D TCC_LIBTCC1=\\\"libtcc1.a\\\" \\\n  -D CONFIG_TCC_STATIC=1 \\\n  -D CONFIG_USE_LIBGCC=1 \\\n  -D TCC_VERSION=\\\"0.9.27\\\" \\\n  -D ONE_SOURCE=1 \\\n  -D TCC_MUSL=1 \\\n  -D CONFIG_TCC_PREDEFS=1 \\\n  -D CONFIG_TCC_SEMLOCK=0 \\\n  -D CONFIG_TCC_BACKTRACE=0 \\\n  -B . \\\n  -B /nix/store/z9j341wpiw4wsv5rbivkjbhc3y82hrrc-musl-1.2.6/lib \\\n  tcc.c\n# libtcc1.a\nrm -f libtcc1.a\n./tcc-musl -c -D HAVE_CONFIG_H=1 lib/libtcc1.c\n./tcc-musl -c -D HAVE_CONFIG_H=1 lib/alloca.S\n./tcc-musl -ar cr libtcc1.a libtcc1.o alloca.o\n\n# Install\ninstall -D tcc-musl $out/bin/tcc\ninstall -Dm444 libtcc1.a $out/lib/libtcc1.a\n","builder":"/nix/store/yqslm5mqjszd9md7c7v9kdadqkqrjm4l-bash-2.05b/bin/bash","name":"tinycc-musl-unstable-2025-12-03","out":"/nix/store/p7zy13p06q2byx8wk5ppmngsrdlkqmbw-tinycc-musl-unstable-2025-12-03","passAsFile":"buildCommand","pname":"tinycc-musl","system":"x86_64-linux","version":"unstable-2025-12-03"},"inputs":{"drvs":{"54jdq8vp944qn49b18harrbjw34dlxcp-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"bv4a5fw05q4ysq24wy0z06bd5jysq1p2-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"d1simrxi41d15h88m043y00yd400fpd4-cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"d9hngw468h7b7fpcyx284kqwdgcn3gzy-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"kcd8hlvcamwjs3p36is87ncigh6i1zbf-tinycc-musl-unstable-2025-12-03-compiler.drv":{"dynamicOutputs":{},"outputs":["out"]},"lmx5h1xhlck345nc3as6dglfv57aq9rn-tinycc-musl-unstable-2025-12-03-libs.drv":{"dynamicOutputs":{},"outputs":["out"]},"pshx4r5vypzz5cjy5ikscgjyzhv2s99x-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"wjmzjx1jzp5h8pmrcjvbs3hc8d5g8y4v-musl-1.2.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zmvpmmh7i1qba20c97v4cl6yi7zqpv3a-gnupatch-2.5.9.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh","caakpwmdf9gpgdinaqrikc7vr8y62mf6-static-link.patch"]},"name":"tinycc-musl-unstable-2025-12-03","outputs":{"out":{"path":"p7zy13p06q2byx8wk5ppmngsrdlkqmbw-tinycc-musl-unstable-2025-12-03"}},"system":"x86_64-linux","version":4},"p44m7gja7wxshdrkkw5wj82xgqjlv9sl-ruby3.4-polyglot-0.3.5.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"NIX_CFLAGS_COMPILE":"","NIX_MAIN_PROGRAM":"polyglot","__structuredAttrs":"","buildInputs":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9","buildPhase":"runHook preBuild\n\nif [[ \"$gemType\" == \"gem\" ]]; then\n  if [[ -z \"$gemspec\" ]]; then\n    gemspec=\"$(find . -name '*.gemspec')\"\n    echo \"found the following gemspecs:\"\n    echo \"$gemspec\"\n    gemspec=\"$(echo \"$gemspec\" | head -n1)\"\n  fi\n\n  exec 3>&1\n  output=\"$(gem build $gemspec | tee >(cat - >&3))\"\n  exec 3>&-\n\n  gempkg=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"polyglot","gemPath":"","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-polyglot-0.3.5","nativeBuildInputs":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9 /nix/store/7whrgb2wib2q83wgbs78xsq9h25lf3aw-make-shell-wrapper-hook","out":"/nix/store/177igm004fjxqcxlp9qjc6wfspgrmhrr-ruby3.4-polyglot-0.3.5","outputs":"out","patches":"","pname":"polyglot","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"","ruby":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9","src":"/nix/store/3kkg0i1hzic1hz9gn4i051rv3965p350-polyglot-0.3.5.gem","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","suffix":"0.3.5","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"0.3.5"},"inputs":{"drvs":{"049faz5h2hlc77kx3f6hvc147xrfc1n5-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"8qp4kvbi9ld2hsswniwcgpa2k93s4iki-polyglot-0.3.5.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"pnw6mfj7qybmpx6sg5brx1vzf4q02rjw-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-polyglot-0.3.5","outputs":{"out":{"path":"177igm004fjxqcxlp9qjc6wfspgrmhrr-ruby3.4-polyglot-0.3.5"}},"system":"x86_64-linux","version":4},"p5qdp6gr977n1s1518lpkn3zk2m70c8k-ltoab.drv":{"args":["--verbose","--strict","--file","/nix/store/67cmky7ppylqhy81jr7z9xmjs3b88lnq-ltoab-builder"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin:/nix/store/53zd871rgpcvi7qmqkffxhzaiq0is7k4-mescc-tools-1.