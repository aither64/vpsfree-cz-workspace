ing-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --enable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/0bv6zcdnalbb65l78lfyg4iwhws3g1d2-code-page-0.2.1.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.2.1"},"inputs":{"drvs":{"1y15f65kni48qpvy154chy6bmx8fzckn-code-page-0.2.1.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"7v69i4ixacxjdan9gx0h4j9q0g3jv11k-glibc-locales-2.42-100.drv":{"dynamicOutputs":{},"outputs":["out"]},"d22jg4nh7xm8mdw99p176dw8j35lhrsk-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"h8nj936jnkjrv6af2h9sf0vgik5z5g78-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]},"k3wn36zbr3l13w60qf9248i1l7382qyd-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"p34m9hzmlh9qkdy1wbikdsgyxjip2n2p-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["4mdp8nhyfddh7bllbi7xszz7k9955n79-Setup.hs","907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"code-page-0.2.1","outputs":{"doc":{"path":"j9d2lin47z7wcybsx7da