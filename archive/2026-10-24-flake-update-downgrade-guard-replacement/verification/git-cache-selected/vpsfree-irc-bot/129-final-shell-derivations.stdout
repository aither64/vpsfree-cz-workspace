le must contain a single file or directory.\"\n  echo \"hint: Pass stripRoot=false; to fetchzip to assume flat list of files.\"\n  exit 1\nfi\nfn=$(cd \"$unpackDir\" && ls -A)\nif [ -f \"$unpackDir/$fn\" ]; then\n  mkdir $out\nfi\nmv \"$unpackDir/$fn\" \"$out\"\n\n\nchmod 755 \"$out\"\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"recursiveHash":true,"repo":"doctest","rev":"refs/tags/v2.5.2","showURLs":false,"stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":false,"stripRoot":true,"system":"x86_64-linux","tag":"v2.5.2","urls":["https://github.com/doctest/doctest/archive/refs/tags/v2.5.2.tar.gz"]},"system":"x86_64-linux","version":4},"kzvj1yjs5i2rzppz34h0wjmr3ymy7gj8-perl5.42.3-ExtUtils-Helpers-0.028.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/119w10l5ic8izi6igxqpq0wdmccs9mbc-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"AUTOMATED_TESTING":"1","PERL_AUTOINSTALL":"--skipdeps","PERL_USE_UNSAFE_INC":"1","__structuredAttrs":"","buildInputs":"/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","checkTarget":"test","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","devdoc":"/nix/store/dz5hm9nphlcqdhnb1sq7k90mndh5argc-perl5.42.3-ExtUtils-Helpers-0.028-devdoc","doCheck":"1","doInstallCheck":"","enableParallelBuilding":"","fullperl":"/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3","mesonFlags":"","name":"perl5.42.3-ExtUtils-Helpers-0.028","nativeBuildInputs":"/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3","out":"/nix/store/4fsb3000y12npvscj1il8rzsbm1bb8wx-perl5.42.3-ExtUtils-Helpers-0.028","output