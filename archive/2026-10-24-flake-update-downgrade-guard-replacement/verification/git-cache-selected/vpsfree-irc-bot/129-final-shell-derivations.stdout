cq-openssl-3.6.5-dev /nix/store/mdmj30b0h7qwj68ay65pw2zwc6fzwayq-gdbm-1.26-dev /nix/store/hdfp4rwzsbhqppibvbr10bvycnsawk5g-libyaml-0.2.5-dev","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cargoDeps":"/nix/store/fl4xchc5pjal4mk2bx4zqfmb5nzgxf9r-cargo-deps-vendor","cargoRoot":"yjit","cmakeFlags":"","configureFlags":"--enable-shared --enable-pthread --with-soname=ruby-3.4.9 --without-baseruby --disable-dtrace --enable-jit-support --enable-yjit --enable-install-doc --without-jemalloc --with-ridir=/0mzrxs60yn555qh08y6avv5sbrfy0gkizrji3v7ba9j25ha14fh5/share/ri CFLAGS=-O3","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","devdoc":"/nix/store/jpl21128ii6y9x6acbbjswk5ajhmn7d1-ruby-3.4.9-devdoc","disallowedRequisites":"","doCheck":"","doInstallCheck":"1","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"","installCheckPhase":"overriden_cc=$(CC=foo $out/bin/ruby -rrbconfig -e 'puts RbConfig::CONFIG[\"CC\"]')\nif [[ \"$overriden_cc\" != \"foo\" ]]; then\n   echo \"CC cannot be overwritten: $overriden_cc != foo\" >&2\n   false\nfi\n\nfallback_cc=$(unset CC; $out/bin/ruby -rrbconfig -e 'puts RbConfig::CONFIG[\"CC\"]')\nif [[ \"$fallback_cc\" != \"$CC\" ]]; then\n   echo \"CC='$fallback_cc' should be '$CC' by default\" >&2\n   false\nfi\n","installFlags":"install-doc","mesonFlags":"","name":"ruby-3.4.9","nativeBuildInputs":"/nix/store/xhvf9b98fc7v2xs6glqq3nmrhr6f0r3k-autoreconf-hook /nix/store/7yaq6zpgwizygk1gayplhd259sr092y9-bison-3.8.2 /nix/store/svrzimmpgp5b9knw00b7cq6081hwadaz-remove-references-to /nix/store/yb5g8vgvkfbaix9s1lbx3gqdp1c3pyl2-groff-1.24.2 /nix/store/msb6l4fkjvszlmki43rj4zggb0hydd1l-cargo-setup-hook.sh /nix/store/7fppvgqxs3zxhvrpqnmwydn70bzgbnnx-rustc-wrapper-1.95.0","out":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9","outputs":"out devdoc","patches":"/nix/store/c6d5gm3zc63zg49kanxf8w6cxfv69ibk-dont-refer-to-build-dir.patch","pname":"ruby","postInstall":"rbConfig=$(find $out/lib/ruby -name rbconfig.rb)\n# Remove references to the build environment from the closure\nsed -i '/^  CONFIG\\[\"\\(BASERUBY\\|SHELL\\|GREP\\|EGREP\\|MKDIR_P\\|MAKEDIRS\\|INSTALL\\)\"\\]/d' $rbConfig\n# Remove unnecessary groff reference from runtime closure, since it's big\nsed -i '/NROFF/d' $rbConfig\n\n\n# Allow to override compiler. This is important for cross compiling as\n# we need to set a compiler that is different from the build one.\nsed -i \"$rbConfig\" \\\n  -e 's/CONFIG\\[\"CC\"\\] = \"\\(.*\\)\"/CONFIG[\"CC\"] = if ENV[\"CC\"].nil? || ENV[\"CC\"].empty? then \"\\1\" else ENV[\"CC\"] end/' \\\n  -e 's/CONFIG\\[\"CXX\"\\] = \"\\(.*\\)\"/CONFIG[\"CXX\"] = if ENV[\"CXX\"].nil? || ENV[\"CXX\"].empty? then \"\\1\" else ENV[\"CXX\"] end/'\n\n# Remove unnecessary external intermediate files created by gems\nextMakefiles=$(find $out/lib/ruby/gems/3.4.0 -name Makefile)\nfor makefile in $extMakefiles; do\n  make -C \"$(dirname \"$makefile\")\" distclean\ndone\nfind \"$out/lib/ruby/gems/3.4.0\" \\( -name gem_make.out -o -name mkmf.log -o -name exts.mk \\) -delete\n# Bundler tries to create this directory\nmkdir -p $out/nix-support\ncat > $out/nix-support/setup-hook <<EOF\naddGemPath() {\n  addToSearchPath GEM_PATH \\$1/lib/ruby/gems/3.4.0\n}\naddRubyLibPath() {\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0/x86_64-linux\n}\n\naddEnvHooks \"$hostOffset\" addGemPath\naddEnvHooks \"$hostOffset\" addRubyLibPath\nEOF\n# Prevent the docs from being included in the closure\nsed -i \"s|\\$(DESTDIR)$devdoc|\\$(datarootdir)/\\$(RI_BASE_NAME)|\" $rbConfig\nsed -i \"s|'--with-ridir=$devdoc/share/ri'||\" $rbConfig\n\n# Add rbconfig shim so ri can find docs\nmkdir -p $devdoc/lib/ruby/site_ruby\ncp /nix/store/wq7zxvl223s5s97y3dhc3gkyk5d6dw0w-rbconfig.rb $devdoc/lib/ruby/site_ruby/rbconfig.rb\n","postPatch":"sed -i configure.ac -e '/config.guess/d'\ncp --remove-destination /nix/store/zsyaikhmdaxra0mh3mbxkahgvgh17d5a-autoconf-2.73/share/autoconf/build-aux/config.{guess,sub} tool/\n","postUnpack":"rm -rf $sourceRoot/{lib,test}/rubygems*\ncp -r /nix/store/skg91wi2sz762z6kchzdlpmdhbqawprn-rubygems-3.7.2/lib/rubygems* $sourceRoot/lib\n","preConfigure":"# rdoc creates XDG_DATA_DIR (defaulting to $HOME/.local/share) even if\n# it's not going to be used.\nexport HOME=$TMPDIR\n","preInstall":"# Ruby installs gems here itself now.\nmkdir -pv \"$out/lib/ruby/gems/3.4.0\"\nexport GEM_HOME=\"$out/lib/ruby/gems/3.4.0\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/h459yblgc82az0vy3brjh5wc1452f8fw-ruby-3.4.9.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"3.4.9"},"inputs":{"drvs":{"0d1yns4fspnxhpbnl2f2j8wy96mg90ql-rustc-wrapper-1.95.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"4h14gh40cmy92iwbsv9z0rxcchi0c980-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"6sqm0ljjly86331dhma2s0sqkj9sab0b-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"7jap05zl3zza0vpny5xl99cy0gskdyyw-autoconf-2.73.drv":{"dynamicOutputs":{},"outputs":["out"]},"8xzqhmi0bhpmbzdhkkxinrx5zli4amwz-ncurses-6.6.drv":{"dynamicOutputs":{},"outputs":["dev"]},"94n3a64bwnijlpc8ix8163i45rc6ql80-ruby-3.4.9.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"d22jg4nh7xm8mdw99p176dw8j35lhrsk-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"f5rf6zv347sh3m73gy41s2d754rdr8d4-gdbm-1.26.drv":{"dynamicOutputs":{},"outputs":["dev"]},"hd73dkpv6dx8qyq3yl4jv8iyi9955vr8-openssl-3.6.5.drv":{"dynamicOutputs":{},"outputs":["dev"]},"lkgajhi3pmjl1m6jrryznfjbqixmyll9-cargo-setup-hook.sh.drv":{"dynamicOutputs":{},"outputs":