-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"extra-1.8.1","nativeBuildInputs":"/nix/store/fpi61m83w03q7nsz1pksz63i6xqqgl74-ghc-binary-9.8.4 /nix/store/svrzimmpgp5b9knw00b7cq6081hwadaz-remove-references-to","out":"/nix/store/v2vmva094z8i2ihac6xc9kpnwkhpyhgb-extra-1.8.1","outputs":"out","patches":"","pname":"extra","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":" /nix/store/brjd7jsnniz90liq4i2ygpkzsnark8xj-clock-0.8.4     ","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/fpi61m83w03q7nsz1pksz63i6xqqgl74-ghc-binary-9.8.4.\"\nexport PATH=/nix/store/z96q1ppk4121sjzybiqhy359nyxny53y-hscolour-1.25/bin:$PATH\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname   --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --disable-library-profiling  --disable-profiling --disable-shared --disable-coverage --enable-static --disable-executable-dynamic --disable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/fpi61m83w03q7nsz1pksz63i6xqqgl74-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/fpi61m83w03q7nsz1pksz63i6xqqgl74-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/fpi61m83w03q7nsz1pksz63i6xqqgl74-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/fpi61m83w03q7nsz1pksz63i6xqqgl74-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/3nprda3kdyhj8zkmv2z32yi6n0gwc966-extra-1.8.1.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.8.1"},"inputs":{"drvs":{"0hgm16z2q5nk69z0mimypg562gvp4y2m-ghc-binary-9.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"7v69i4ixacxjdan9gx0h4j9q0g3jv11k-glibc-locales-2.42-100.drv":{"dynamicOutputs":{},"outputs":["out"]},"clcylca4i2jffp0n5mihlv8ji9lbscsv-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]},"d22jg4nh7xm8mdw99p176dw8j35lhrsk-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"k3wn36zbr3l13w60qf9248i1l7382qyd-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"lz5q9v7vdqb2fg3p946x1b0rs7vq9i9m-extra-1.8.1.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"s3fdq32fy4m2d374hfyrgmsk4wvidvgg-clock-0.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["4mdp8nhyfddh7bllbi7xszz7k9955n79-Setup.hs","907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"extra-1.8.1","outputs":{"out":{"path":"v2vmva094z8i2ihac6xc9kpnwkhpyhgb-extra-1.8.1"}},"system":"x86_64-linux","version":4},"asdvhbkjhgwcd51lafnwqiah250299j3-dtoab.drv":{"args":["--verbose","--strict","--file","/nix/store/s15vrl62ra12qv9q1z070nplfbqcig6k-dtoa