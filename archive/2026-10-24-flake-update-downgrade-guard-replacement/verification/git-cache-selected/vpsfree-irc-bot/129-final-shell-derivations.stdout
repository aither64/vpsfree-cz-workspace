pkgsVersion":"26.05","outputChecks":{"out":{}},"outputHash":"sha256-MkP/vI6k1Kwi3cfdKh3FTFeHTEBki2D/lwCXY1VOrxM=","outputHashMode":"flat","outputs":["out"],"patches":[],"postFetch":"","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":false,"system":"x86_64-linux","urls":["https://kerberos.org/dist/krb5/1.22/krb5-1.22.2.tar.gz"]},"system":"x86_64-linux","version":4},"q75f3s0l812jqmqks1x90f35srn6ac2m-strcat-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"strcat-builder","out":"/nix/store/zh2y3hymyw3y2kpaadp72b3jpkfikrll-strcat-builder","passAsFile":"text","system":"x86_64-linux","text":"mkdir ${out}\ncd ${out}\n/nix/store/n9mj1f0ipsva4vyd2llpdgv3wyrcmsm1-mes-src-0.27.1-bin/bin/mes-m2 -e main /nix/store/n9mj1f0ipsva4vyd2llpdgv3wyrcmsm1-mes-src-0.27.1-bin/bin/mescc.scm -D HAVE_CONFIG_H=1 -I /nix/store/vhbf57apsjqv01fnvhavm6iyk91m91si-mes-src-0.27.1/mes-0.27.1/include -I /nix/store/vhbf57apsjqv01fnvhavm6iyk91m91si-mes-src-0.27.1/mes-0.27.1/include/linux/x86_64 -c /nix/store/vhbf57apsjqv01fnvhavm6iyk91m91si-mes-src-0.27.1/mes-0.27.1/lib/string/strcat.c\n"},"inputs":{"drvs":{"h6pi2cyw7j5liy0fbzq8i1ippcqwdjd3-mes-src-0.27.1.drv":{"dynamicOutputs":{},"outputs":["bin","out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"strcat-builder","outputs":{