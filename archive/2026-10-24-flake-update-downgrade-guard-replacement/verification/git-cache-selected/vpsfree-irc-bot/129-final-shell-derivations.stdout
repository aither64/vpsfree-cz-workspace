nfig.h src/mkconfig.h src/mkcustom.h\ncp lib/glob.in.h lib/glob.h\ncp lib/fnmatch.in.h lib/fnmatch.h\n\n# Compile\nalias CC=\"tcc -B /nix/store/a5rfrhplpv4wly6mmvwphi2cxh8jjj6i-tinycc-bootstrappable-libs-unstable-2024-07-07/lib -I./src -I./lib -DHAVE_CONFIG_H -DMAKE_MAINTAINER_MODE -DLIBDIR=\\\"/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib\\\" -DLOCALEDIR=\\\"/fake-locale\\\" -DPOSIX=1 -DNO_OUTPUT_SYNC=1 -DO_TMPFILE=020000000 -DFILE_TIMESTAMP_HI_RES=0 -DHAVE_ALLOCA -DHAVE_ALLOCA_H -DHAVE_ATEXIT -DHAVE_DECL_BSD_SIGNAL=0 -DHAVE_DECL_GETLOADAVG=0 -DHAVE_DECL_SYS_SIGLIST=0 -DHAVE_DECL__SYS_SIGLIST=0 -DHAVE_DECL___SYS_SIGLIST=0 -DHAVE_DIRENT_H -DHAVE_DUP2 -DHAVE_FCNTL_H -DHAVE_FDOPEN -DHAVE_GETCWD -DHAVE_GETTIMEOFDAY -DHAVE_INTTYPES_H -DHAVE_ISATTY -DHAVE_LIMITS_H -DHAVE_LOCALE_H -DHAVE_MEMORY_H -DHAVE_MKTEMP -DHAVE_SA_RESTART -DHAVE_SETVBUF -DHAVE_SIGACTION -DHAVE_SIGSETMASK -DHAVE_STDINT_H -DHAVE_STDLIB_H -DHAVE_STRDUP -DHAVE_STRERROR -DHAVE_STRINGS_H -DHAVE_STRING_H -DHAVE_STRTOLL -DHAVE_SYS_FILE_H -DHAVE_SYS_PARAM_H -DHAVE_SYS_RESOURCE_H -DHAVE_SYS_SELECT_H -DHAVE_SYS_STAT_H -DHAVE_SYS_TIMEB_H -DHAVE_SYS_TIME_H -DHAVE_SYS_WAIT_H -DHAVE_TTYNAME -DHAVE_UMASK -DHAVE_UNISTD_H -DHAVE_WAITPID -DMAKE_JOBSERVER -DMAKE_SYMLINKS -DPATH_SEPARATOR_CHAR=':' -DSCCS_GET=\\\"get\\\" -DSTDC_HEADERS -Dsig_atomic_t=int -Dvfork=fork\"\nCC -c src/ar.c\nCC -c src/arscan.c\nCC -c src/commands.c\nCC -c src/default.c\nCC -c src/dir.c\nCC -c src/expand.c\nCC -c src/file.c\nCC -c src/function.c\nCC -c src/getopt.c\nCC -c src/getopt1.c\nCC -c src/guile.c\nCC -c src/hash.c\nCC -c src/implicit.c\nCC -c src/job.c\nCC -c src/load.c\nCC -c src/loadapi.c\nCC -c src/main.c\nCC -c src/misc.c\nCC -c src/output.c\nCC -c src/read.c\nCC -c src/remake.c\nCC -c src/rule.c\nCC -c src/shuffle.c\nCC -c src/signame.c\nCC -c src/strcache.c\nCC -c src/variable.c\nCC -c src/version.c\nCC -c src/vpath.c\nCC -c lib/fnmatch.c\nCC -c lib/glob.c\nCC -c src/remote-stub.c\nCC -c src/posixos.c\n\n# Link\nCC -o make ar.o arscan.o commands.o default.o dir.o expand.o file.o function.o getopt.o getopt1.o guile.o hash.o implicit.o job.o load.o loadapi.o main.o misc.o output.o read.o remake.o rule.o shuffle.o signame.o strcache.o variable.o version.o vpath.o fnmatch.o glob.o remote-stub.o posixos.o\n\n# Check\n./make --version\n\n# Install\nmkdir -p ${out}/bin\ncp ./make ${out}/bin\nchmod 555 ${out}/bin/make\n"},"inputs":{"drvs":{"whkczx14wnzmkchfys92zgas16rnzqw9-make-4.4.1.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"xi8dy016hq7842iplkgfdmzribiy8a3m-tinycc-bootstrappable-libs-unstable-2024-07-07.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["2k52bklbjhhq47dn35gm833vlh06fgfn-0001-No-impure-bin-sh.patch","6cc64ayl3fd2nc28ffw47cqsqi2bg1sn-0002-remove-impure-dirs.patch","9bsy65vc7cqbphmsvkph5rpcsqly30kj-0003-tinycc-support.patch","m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"gnumake-4.4.1-builder","outputs":{"out":{"path":"qdycs2z57maflbgk9fm4y118rxva132a-gnumake-4.4.1-builder"}},"system":"x86_64-linux","version":4},"20i1igy2hxwh5i5nrakzj41cmaafsm6z-crt-builder.drv":{"args":["--verbose","--strict","--file","/nix/store/m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","destination":"","destinationDir":".","name":"crt-builder","out":"/nix/store/iqais0jvz9irq9g70i0jjz63cqz9fk9g-crt-builder","passAsFile":"text","system":"x86_64-linux","text":"mkdir -p ${out}/lib\n/nix/store/kyqx4ayvvj9xcdi1zk5iapfx06vg040b-tinycc-boot2-unstable-2024-07-07/bin/tcc -std=c11 -c -o ${out}/lib/crt1.o /nix/store/h5x1k0lv3jlh1ir8ry23lm59hizjx