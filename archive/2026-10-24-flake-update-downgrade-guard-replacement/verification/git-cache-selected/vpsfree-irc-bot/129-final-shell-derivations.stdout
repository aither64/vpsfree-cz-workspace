ingDisable":"","installPhase":"runHook preInstall\n\n./Setup copy \nlocal packageConfDir=\"$out/lib/ghc-9.10.3/lib/package.conf.d\"\nlocal packageConfFile=\"$packageConfDir/hspec-meta-2.11.17.conf\"\nmkdir -p \"$packageConfDir\"\n./Setup register --gen-pkg-config=$packageConfFile\nif [ -d \"$packageConfFile\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/hspec-meta-2.11.17\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"hspec-meta-2.11.17","nativeBuildInputs":"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3 /nix/store/svrzimmpgp5b9knw00b7cq6081hwadaz-remove-references-to","out":"/nix/store/q5kv3cvrnaa1skmsr2fng9bikxlxhl9g-hspec-meta-2.11.17","outputs":"out doc","patches":"","pname":"hspec-meta","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"/nix/store/ylf82mbdcd27ffsxjyw3yr7ldax5hvbc-ansi-terminal-1.1.5   /nix/store/njixx96iyb39rw6c4l0mi2fna3lwacp6-call-stack-0.4.0     /nix/store/n9hyr15p69zm4na4pydf201miw3lf7sh-haskell-lexer-1.2.1 /nix/store/azc49r87d265sv13j0as33b6is3lq3i6-hspec-expectations-0.8.4 /nix/store/7mnn9f8984gikkma8c3vv5c0rjy74r10-HUnit-1.6.2.0  /nix/store/swy2pniiv250lwfh53s0m2kx3njf1hma-QuickCheck-2.15.0.1 /nix/store/q29106jkrmlpg3fqfigxi0r45p0dqksk-quickcheck-io-0.2.0 /nix/store/pfx27dhpajq4jlbrzgml0aamz1c5w89j-random-1.2.1.3    /nix/store/ylf82mbdcd27ffsxjyw3