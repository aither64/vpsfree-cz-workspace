ckage","NIX_MIRRORS_hashedMirrors","NIX_MIRRORS_ibiblioPubLinux","NIX_MIRRORS_imagemagick","NIX_MIRRORS_kde","NIX_MIRRORS_kernel","NIX_MIRRORS_luarocks","NIX_MIRRORS_maven","NIX_MIRRORS_mozilla","NIX_MIRRORS_mysql","NIX_MIRRORS_openbsd","NIX_MIRRORS_opensuse","NIX_MIRRORS_osdn","NIX_MIRRORS_postgresql","NIX_MIRRORS_pypi","NIX_MIRRORS_qt","NIX_MIRRORS_sageupstream","NIX_MIRRORS_samba","NIX_MIRRORS_savannah","NIX_MIRRORS_sourceforge","NIX_MIRRORS_steamrt","NIX_MIRRORS_tcsh","NIX_MIRRORS_testpypi","NIX_MIRRORS_texhistoric","NIX_MIRRORS_ubuntu","NIX_MIRRORS_xfce","NIX_MIRRORS_xorg"],"mesonFlags":[],"mirrorsFile":"/nix/store/981lgfashyzwys4rf4y452n92hblkx5h-mirrors-list","name":"source","nativeBuildInputs":["/nix/store/3kyk0wjam6yl651y2hdz4wm8qilsxq71-curl-8.22.0-dev"],"nixpkgsVersion":"26.05","outputChecks":{"out":{}},"outputHash":"sha256-tz99C+dz5xJhunoC45bl0NdSdV9NXWya9ti48Z/KaHY=","outputHashMode":"recursive","outputs":["out"],"owner":"benjaminp","patches":[],"postFetch":"unpackDir=\"$TMPDIR/unpack\"\nmkdir \"$unpackDir\"\ncd \"$unpackDir\"\n\nrenamed=\"$TMPDIR/download.tar.gz\"\nmv \"$downloadedFile\" \"$renamed\"\nunpackFile \"$renamed\"\nchmod -R +w \"$unpackDir\"\nif [ $(ls -A \"$unpackDir\" | wc -l) != 1 ]; then\n  echo \"error: zip file must contain a single file or directory.\"\n  echo \"hint: Pass stripRoot=false; to fetchzip to assume flat list of files.\"\n  exit 1\nfi\nfn=$(cd \"$unpackDir\" && ls -A)\nif [ -f \"$unpackDir/$fn\" ]; then\n  mkdir $out\nfi\nmv \"$unpackDir/$fn\" \"$out\"\n\n\nchmod 755 \"$out\"\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"recursiveHash":true,"repo":"six","rev":"refs/tags/1.17.0","showURLs":false,"stdenv":"/nix/store/4lgbwpg4r41kcsms7nlwrzdlmhw83skj-stdenv-linux","strictDeps":false,"stripRoot":true,"system":"x86_64-linux","tag":"1.17.0","urls":["https://github.com/benjaminp/six/archive/refs/tags/1.17.0.tar.gz"]},"system":"x86_64-linux","version":4},"6xm01zs960z57y4682dax10l8fxi5v57-coreutils-9.11.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash","env":{"FORCE_UNSAFE_CONFIGURE":"","NIX_CFLAGS_COMPILE":"","NIX_HARDENING_ENABLE":"bindnow format fortify fortify3 libcxxhardeningfast pic relro stackclashprotection stackprotector strictflexarrays1 strictoverflow zerocallusedregs","NIX_LDFLAGS":"","__structuredAttrs":"","buildInputs":"","builder":"/nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash","cmakeFlags":"","configureFlags":"--with-packager=https://nixos.org --with-selinux --enable-install-program=kill,uptime --enable-single-binary=symlinks gl_cv_have_proc_uptime=yes","debug":"/nix/store/v70i9p38z9b2fjpl47k2kihy33vcw5l2-coreutils-9.11-debug","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"1","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"trivialautovarinit","info":"/nix/store/jp2ss9zjf3312gn7ba92vm062dhdnmg2-coreutils-9.11-info","mesonFlags":"","name":"coreutils-9.11","nativeBuildInputs":"/nix/store/llas6flzd2875r7zzhhvwnynwqi349jb-perl-5.42.3 /nix/store/fr31df17rksfki6nv00xq4s5apvqpyhw-xz-5.8.4-bin /nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/v30lijjvik14pcnmpa0394cx6x52bsgk-coreutils-9.11","outputs":"out info debug","patches":"/nix/store/7d47dgqxcn66f5zgvrc5byhbshwr8rpw-CVE-2026-56391.patch /nix/store/ri503nkqxyqg8j0dcqd8jd1jzhryszsk-CVE-2026-56392.patch","pname":"coreutils","postInstall":"rm -r \"$out/share\"\n","postPatch":"# The test tends to fail on btrfs, f2fs and maybe other unusual filesystems.\nsed '2i echo Skipping dd sparse test && exit 77' -i ./tests/dd/sparse.sh\nsed '2i echo Skipping du threshold test && exit 77' -i ./tests/du/threshold.sh\nsed '2i echo Skipping cp reflink-auto test && exit 77' -i ./tests/cp/reflink-auto.sh\nsed '2i echo Skipping cp sparse test && exit 77' -i ./tests/cp/sparse.sh\nsed '2i echo Skipping env test && exit 77' -i ./tests/env/env.sh\nsed '2i echo Skipping rm deep-2 test && exit 77' -i ./tests/rm/deep-2.sh\nsed '2i echo Skipping du long-from-unreadable test && exit 77' -i ./tests/du/long-from-unreadable.sh\n\n# The test tends to fail on cephfs\nsed '2i echo Skipping df total-verify test && exit 77' -i ./tests/df/total-verify.sh\n\n# Some target platforms, especially when building inside a container have\n# issues with the inotify test.\nsed '2i echo Skipping tail inotify dir recreate test && exit 77' -i ./tests/tail/inotify-dir-recreate.sh\n\n# sandbox does not allow setgid\nsed '2i echo Skipping chmod setgid test && exit 77' -i ./tests/chmod/setgid.sh\nsubstituteInPlace ./tests/install/install-C.sh \\\n  --replace 'mode3=2755' 'mode3=1755'\n\n# Fails on systems with a rootfs. Looks like a bug in the test, see\n# https://lists.gnu.org/archive/html/bug-coreutils/2019-12/msg00000.html\nsed '2i print \"Skipping df skip-rootfs test\"; exit 77' -i ./tests/df/skip-rootfs.sh\n\n# these tests fail in the unprivileged nix sandbox (without nix-daemon) as we break posix assumptions\nfor f in ./tests/chgrp/{basic.sh,recurse.sh,default-no-deref.sh,no-x.sh,posix-H.sh}; do\n  sed '2i echo Skipping chgrp && exit 77' -i \"$f\"\ndone\nfor f in gnulib-tests/{test-chown.c,test-fchownat.c,test-lchown.c}; do\n  echo \"int main() { return 77; }\" > \"$f\"\ndone\n\n# We don't have localtime in the sandbox\nfor f in gnulib-tests/{test-localtime_r.c,test-localtime_r-mt.c}; do\n  echo \"int main() { return 77; }\" > \"$f\"\ndone\n\n# These tests sometimes fail on ZFS-backed NFS filesystems\nsed '2i echo \"Skipping test: fails on zfs \" && exit 77' -i gnulib-tests/test-file-has-acl-1.sh\nsed '2i echo \"Skipping test: fails on zfs \" && exit 77' -i gnulib-tests/test-set-mode-acl-1.sh\nsed '2i echo \"Skipping test: ls/removed-directory\" && exit 77' -i ./tests/ls/removed-directory.sh\n\n# intermittent failures on builders, unknown reason\nsed '2i echo Skipping du basic test && exit 77' -i ./tests/du/basic.sh\n\n# flaky on some filesystems due to non-deterministic disk usage\nsed '2i echo Skipping du deref test && exit 77' -i ./tests/du/deref.sh\nsed '2i echo Skipping du inacc-dir test && exit 77' -i ./tests/du/inacc-dir.sh\n\n# fails when syscalls related to acl not being available, e.g. in sandboxed environment\nsed '2i echo Skipping ls -al with acl test && exit 77' -i ./tests/ls/acl.sh\n","preInstall":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","src":"/nix/store/p59cz49l5faa67c72wxdql3jfj9gy2fn-coreutils-9.11.tar.xz","stdenv":"/nix/store/kf7zrrw232m1zdklzdx6kcgl34xqsm9l-bootstrap-stage4-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"9.11"},"inputs":{"drvs":{"0nrb3h17g2hhf8ijisi7frcfvqwhya3w-coreutils-9.11.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"j62q08zzqxsbm1bnb9jf6bz320wkld38-perl-5.42.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"rz72y4sgpjqm7f85w1zk6xpxs2q69hwq-bootstrap-stage4-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"spy1vhzw07pnzbk2c5lvcljb66ckzwr8-xz-5.8.4.drv":{"dynamicOutputs":{},"outputs":["bin"]},"zv2kqb8hbz2bhvsikii3cxh49gdsy1l9-bash-static-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["7d47dgqxcn66f5zgvrc5byhbshwr8rpw-CVE-2026-56391.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","ri503nkqxyqg8j0dcqd8jd1jzhryszsk-CVE-2026-56392.patch","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"coreutils-9.11","outputs":{"debug":{"path":"v70i9p38z9b2fjpl47k2kihy33vcw5l2-coreutils-9.11-debug"},"info":{"path":"jp2ss9zjf3312gn7ba92vm062dhdnmg2-coreutils-9.11-info"},"out":{"path":"v30lijjvik14pcnmpa0394cx6x52bsgk-coreutils-9.11"}},"system":"x86_64-linux","version":4},"6xp5i384877x7nry7dq2ky51c7adlz7m-bundler-2.7.2.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"NIX_CFLAGS_COMPILE":"","NIX_MAIN_PROGRAM":"bundler","__structuredAttrs":"","buildInputs":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9","buildPhase":"runHook preBuild\n\nif [[ \"$gemType\" == \"gem\" ]]; then\n  if [[ -z \"$gemspec\" ]]; then\n    gemspec=\"$(find . -name '*.gemspec')\"\n    echo \"found the following gemspecs:\"\n    echo \"$gemspec\"\n    gemspec=\"$(echo \"$gemspec\" | head -n1)\"\n  fi\n\n  exec 3>&1\n  output=\"$(gem build $gemspec | tee >(cat - >&3))\"\n  exec 3>&-\n\n  gempkg=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"1","dontBuild":"1","dontPatchShebangs":"1","dontStrip":"","gemName":"bundler","gemType":"gem","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\n# When __structuredAttrs is enabled, this is not added to the environment by default,\n# but nix-bundle-install.rb needs it.\nexport ruby\n\nlocal -a flagsArray\nconcatTo flagsArray buildFlags\n\necho \"buildFlags: ${flagsArray[@]}\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg -- \"${flagsArray[@]}\"\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"bundler-2.7.2","nativeBuildInputs":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9 /nix/store/7whrgb2wib2q83wgbs78xsq9h25lf3aw-make-shell-wrapper-hook /nix/store/yf1g1hjv24m2slww43c85ag2qdirczvq-version-check-hook","out":"/nix/store/65zlxsy0vbw7llprqyr1d4dciwbmy5w4-bundler-2.7.2","outputs":"out","patches":"","pname":"bundler","postFixup":"substituteInPlace $out/bin/bundle --replace-fail \"activate_bin_path\" \"bin_path\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"","ruby":"/nix/store/3rcm37q1arwggzjxzcnbiz5s8a7c1ppx-ruby-3.4.9","src":"/nix/store/mhrlkrdd85wk2v2lfyvmd5varq9fshr4-bundler-2.7.2.gem","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","suffix":"2.7.2","system":"x86_64-linux","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"2.7.2","versionCheckProgram":"/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/bin/bundler"},"inputs":{"drvs":{"049faz5h2hlc77kx3f6hvc147xrfc1n5-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"pnw6mfj7qybmpx6sg5brx1vzf4q02rjw-ruby-3.4.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"wg7cmj3hqaidvwsx3kpm6y6ihm7z1196-version-check-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"y5ahb1i8carr0mdj7mww4ddqc8kcgam5-bundler-2.7.2.gem.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem