d":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","doc":"/nix/store/j2rw6v9kc11xz8lhmqbfyc9zsg1j7lcg-gettext-1.0-doc","enableParallelBuilding":"1","enableParallelChecking":"","enableParallelInstalling":"1","gettextNeedsLdflags":"","info":"/nix/store/607fq0i6djmrpq0zx7k0v1icjbwprsqm-gettext-1.0-info","man":"/nix/store/58ihmv0ciqbbwi7pdpxf833kalkd342b-gettext-1.0-man","mesonFlags":"","name":"gettext-1.0","nativeBuildInputs":"/nix/store/1ayzw3lmqyjklyfzw52c508d87pq6x67-update-autotools-gnu-config-scripts-hook","out":"/nix/store/y6rng1ng0l2ngd2pfcwxyzd1sdljq8b2-gettext-1.0","outputs":"out man doc info","patches":"/nix/store/p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff /nix/store/yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch","pname":"gettext","postPatch":"# Older versions of gettext come with a copy of `extern-inline.m4` that is not compatible with clang 18.\n# When a project uses gettext + autoreconfPhase, autoreconfPhase will invoke `autopoint -f`, which will\n# replace whatever (probably compatible) version of `extern-inline.m4` with one that probalby won’t work\n# because `autopoint` will copy the autoconf macros from the project’s required version of gettext.\n# Fixing this requires replacing all the older copies of the problematic file with a new one.\n#\n# This is ugly, but it avoids requiring workarounds in every package using gettext and autoreconfPhase.\ndeclare -a oldFiles=($(tar tf gettext-tools/autotools/archive.dir.tar | grep '^gettext-0\\.[19].*/extern-inline.m4'))\noldFilesDir=$(mktemp -d)\nfor oldFile in \"${oldFiles[@]}\"; do\n  mkdir -p \"$oldFilesDir/$(dirname \"$oldFile\")\"\n  cp -a gettext-tools/gnulib-m4/extern-inline.m4 \"$oldFilesDir/$oldFile\"\ndone\ntar uf gettext-tools/autotools/archive.dir.tar --owner=0 --group=0 --numeric-owner -C \"$oldFilesDir\" \"${oldFiles[@]}\"\n\nsubstituteAllInPlace gettext-runtime/src/gettext.sh.in\nsubstituteInPlace gettext-tools/projects/KDE/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/projects/GNOME/trigger --replace \"/bin/pwd\" pwd\nsubstituteInPlace gettext-tools/src/project-id --replace \"/bin/pwd\" pwd\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHooks":"/nix/store/v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash /nix/store/ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","src":"/nix/store/n4lwy41bnpq1fsqsrf5fac3m7vmhk6sr-gettext-1.0.tar.gz","stdenv":"/nix/store/icksbblvhrvx8z2g54n3xvxi2gqfsjkd-bootstrap-stage3-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"1.0"},"inputs":{"drvs":{"35wz9q50m04k86141x1039xnqa3kw26s-bootstrap-stage3-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"61xx94zmcm2pypfk8zjhfarkjly0vv05-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["dev"]},"bl9kshipn3rf2lybfv3l2q2v4m1lh777-update-autotools-gnu-config-scripts-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"zdbga6f8g5jysvhngmnjlwmj674bzds2-gettext-1.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"zv2kqb8hbz2bhvsikii3cxh49gdsy1l9-bash-static-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","ny42y6hs4p294rvnrwbmrpwzqghw2816-gettext-setup-hook.sh","p2fp6i7hjx9af1wbwr32k217wp2dxmiw-absolute-paths.diff","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","v9034cqc4h5bm10z4vz3n1q2n55grv5y-role.bash","yqwx9yln5i68nw61mmp9gz066yz3ri99-0001-msginit-Do-not-use-POT-Creation-Date.patch"]},"name":"gettext-1.0","outputs":{"doc":{"path":"j2rw6v9kc11xz8lhmqbfyc9zsg1j7lcg-gettext-1.0-doc"},"info":{"path":"607fq0i6djmrpq0zx7k0v1icjbwprsqm-gettext-1.0-info"},"man":{"path":"58ihmv0ciqbbwi7pdpxf833kalkd342b-gettext-1.0-man"},"out":{"path":"y6rng1ng0l2ngd2pfcwxyzd1sdljq8b2-gettext-1.0"}},"system":"x86_64-linux","version":4},"nvqjlc01wsnypr50ih2x6vsha3wjylgr-gcc-15.3.0.tar.xz.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"b