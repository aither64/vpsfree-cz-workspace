dcxx-pch \\\n  --disable-lto \\\n  --disable-multilib \\\n  --disable-nls \\\n  --disable-plugin\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n","builder":"/nix/store/glzmxw4hadd4hda2c1m0l3j49zp8by41-bash-5.3/bin/bash","name":"gcc-10.4.0","out":"/nix/store/7lbrh8l81j77kc692ychrj6bxm0fcdv3-gcc-10.4.0","passAsFile":"buildCommand","pname":"gcc","system":"x86_64-linux","version":"10.4.0"},"inputs":{"drvs":{"0q1fkyw9jc9fafyswh9gkv48wph52yzy-isl-0.24.tar.bz2.drv":{"dynamicOutputs":{},"outputs":["out"]},"3298jfza8zv78425rrpr80xxcnnrbgr9-bzip2-1.0.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"3zhi7fn92ym1ds0n3yybmjyjvksypi39-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"41kp7bkyk4g0lk2xq45hiqn268nbmx8a-gawk-5.3.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b0xnqkbv7qnbbbc7zhqwahygjf7mc2i-findutils-4.10.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gwpvw0ssr7xmfzvy97c6f493fhc2f7r-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"bv4a5fw05q4ysq24wy0z06bd5jysq1p2-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"hi93kfb0mz4b8b5mk060cl972p05bplr-mpc-1.4.1.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"hxagi71byf79kd6630nkzzslsmmjir34-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"jm8c5a9ysfm3fckryllnl6pd3nm1hd17-bootstrap-coreutils-musl-9.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"l6a6rj0gy31gp6k7k80qzn4ni0yvyzgh-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"ma479p2ss57bs6afjmhhi1xg27vin41s-gcc-10.4.0.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"q3px40945ahyqcfk1jd5i0ysarphz9dv-mpfr-4.2.2.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"r1rf2p01za5ckcbz87fjvdnz2mpvy3bz-gmp-6.2.1.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"s2g0la1392ys0bp34d0m38kmlzwi30v1-binutils-2.46.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"sb1sw1wqkaswx04a9pds57ms69gfi2ya-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"v8jl1cziqai2qqgn0axr9cv3masm5nb5-b