\"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/bmhin88ha3fdsk8zpd023csyqxjxi51g-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/r8xqfy0by7gwk3h26i4q7ygkzrsqxr4d-hspec-core-2.11.17.tar.gz","stdenv":"/nix/store/l325vp92jbs1xz51vrniwq02m6wdnbyi-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"2.11.17"},"inputs":{"drvs":{"0yd045mlwfcyk8bdcf19syg9nmg4csfb-hspec-expectations-0.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"1n7lsjqbhq3k60rv9ab14ip62aksik0l-ansi-terminal-1.1.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"3l7bj57n7b6y0w321f9sfw5rlqq4ik0g-coreutils-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"4wcjvik77a19vcfl2k8vy4880m5z9bsw-quickcheck-io-0.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"57mjiwn1pnr3yrn0q17askc9gy8mas0w-QuickCheck-2.15.0.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"7v69i4ixacxjdan9gx0h4j9q0g3jv11k-glibc-locales-2.42-100.drv":{"dynamicOutputs":{},"outputs":["out"]},"bsgv6qsy4cb3pws88vfj9r9b3g35lmx9-hspec-core-2.11.17.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"d22jg4nh7xm8mdw99p176dw8j35lhrsk-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"f13dw1l416dhsf1gck4wizy79hjvqp9d-bash-5.3p9.drv":{"dynamicOutputs":{},"outputs":["out"]},"fn45l3638xf15q34i7vq1naa4rbixpr2-HUnit-1.6.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"h8nj936jnkjrv6af2h9sf0vgik5z5g78-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]},"hgcqqgrfi0lhx89pr9xpncpf9iwrc8dy-haskell-lexer-1.2.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"k3wn36zbr3l13w60qf9248i1l7382qyd-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"n166z79fif234bl6szvhdmdpqqxzvw3x-random-1.2.1.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"p34m9hzmlh9qkdy1wbikdsgyxjip2n2p-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"pqv0mdjls23s879s4zkk7c2j199370ka-stdenv-linux.drv":{"dynamicO