 $ccPath/gcc\n  ln -s gcc $out/bin/cc\n  export named_cc=gcc\n  export named_cxx=g++\nelif [ -e $ccPath/clang ]; then\n  wrap clang $wrapper $ccPath/clang\n  ln -s clang $out/bin/cc\n  export named_cc=clang\n  export named_cxx=clang++\nelif [ -e $ccPath/arocc ]; then\n  wrap arocc $wrapper $ccPath/arocc\n  ln -s arocc $out/bin/cc\n  export named_cc=arocc\nfi\n\nif [ -e $ccPath/g++ ]; then\n  wrap g++ $wrapper $ccPath/g++\n  ln -s g++ $out/bin/c++\nelif [ -e $ccPath/clang++ ]; then\n  wrap clang++ $wrapper $ccPath/clang++\n  ln -s clang++ $out/bin/c++\nfi\n\nif [ -e $ccPath/cpp ]; then\n  wrap cpp $wrapper $ccPath/cpp\nelif [ -e $ccPath/cpp ]; then\n  wrap cpp $wrapper $ccPath/cpp\nfi\n","isArocc":"","isClang":"","libc_bin":"/nix/store/x7wascvip2xhz68x5as5qi98kr1kz6zr-bootstrap-stage0-glibc-minimal-bootstrap","libc_dev":"/nix/store/x7wascvip2xhz68x5as5qi98kr1kz6zr-bootstrap-stage0-glibc-minimal-bootstrap","libc_lib":"/nix/store/x7wascvip2xhz68x5as5qi98kr1kz6zr-bootstrap-stage0-glibc-minimal-bootstrap","mesonFlags":"","mktemp":"/nix/store/phljivqdkyfx0ckl510sw7z1m540h1mw-coreutils-static-9.10/bin/mktemp","name":"bootstrap-stage-xgcc-gcc-wrapper-15.3.0","nativeBuildInputs":"","out":"/nix/store/zsj0g9vcd3vc5g3llff69rr2fcbrfncq-bootstrap-stage-xgcc-gcc-wrapper-15.3.0","outputs":"out","patches":"","pname":"bootstrap-stage-xgcc-gcc-wrapper","postFixup":"touch \"$out/nix-support/cc-cflags\"\ntouch \"$out/nix-support/cc-ldflags\"\nif [[ -f \"$bintools/nix-support/dynamic-linker\" ]]; then\n  ln -s \"$bintools/nix-support/dynamic-linker\" \"$out/nix-support\"\nfi\nif [[ -f \"$bintools/nix-support/dynamic-linker-m32\" ]]; then\n  ln -s \"$bintools/nix-support/dynamic-linker-m32\" \"$out/nix-support\"\nfi\ntouch \"$out/nix-support/libc-cflags\"\ntouch \"$out/nix-support/libc-ldflags\"\necho \"-B/nix/store/x7wascvip2xhz68x5as5qi98kr1kz6zr-bootstrap-stage0-glibc-minimal-bootstrap/lib/\" >> $out/nix-support/libc-crt1-cflags\ninclude \"-idirafter\" \"/nix/store/x7wascvip2xhz68x5as5