utes":"","buildInputs":"","buildPhase":"runHook preBuild\n\ntarget=$out\nif test -n \"$dir\"; then\n    target=$out/$dir/$name\n    mkdir -p $out/$dir\nfi\n\nsubstitute \"$src\" \"$target\" --replace-fail @perl@ /nix/store/rcjsw56ixsmmybxf27qf1d3xx2zdg1p7-perl-5.42.3 --replace-fail @shell@ /nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash --replace-fail @signingUtils@ '' --replace-fail @storeDir@ /nix/store\n\nif test -n \"$isExecutable\"; then\n    chmod +x $target\nfi\n\nrunHook postBuild\n","builder":"/nix/store/h2sg7n256bl7qy32fyc645ci5gz6xdy5-bash-static-5.3/bin/bash","checkPhase":"runHook preCheck\nif grep -Pqe '@[a-zA-Z_][0-9A-Za-z_'\\''-]*@' \"$target\"; then\n  echo The following look like unsubstituted Nix identifiers that remain in \"$target\":\n  grep -Poe '@[a-zA-Z_][0-9A-Za-z_'\\''-]*@' \"$target\"\n  echo Use the more precise '`substitute`' function if this check is in error.\n  exit 1\nfi\nrunHook postCheck\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dir":"bin","doCheck":"1","doInstallCheck":"","dontUnpack":"1","isExecutable":"1","mesonFlags":"","name":"nuke-refs","nativeBuildInputs":"","out":"/nix/store/smr074qacrgd6i309lz8pixg7l2h7as4-nuke-refs","outputs":"out","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/329zjqfysghmg8sa9svgdd10vswbzcka-nuke-refs","stdenv":"/nix/store/nsjviwyfr1ycmncjwxxdpgkandmckv0g-bootstrap-stage4-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"2vp90ljr3dyk45rjyqaidqj3a69n2fny-perl-5.42.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"bx5gz73i2ppd7bqmv43fg2gj0vn76551-bootstrap-stage4-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"zv2kqb8hbz2bhvsikii3cxh49gdsy1l9-bash-static-5.3.drv":{"dynamicOutputs":{},"output