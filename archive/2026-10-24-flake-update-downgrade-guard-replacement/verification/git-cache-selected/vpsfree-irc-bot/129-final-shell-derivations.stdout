 -c basename.c\nCC -c dirname.c\nCC -c getopt.c\nCC -c getopt1.c\nCC -c inp.c\nCC -c maketime.c\nCC -c partime.c\nCC -c patch.c\nCC -c pch.c\nCC -c quote.c\nCC -c quotearg.c\nCC -c quotesys.c\nCC -c util.c\nCC -c version.c\nCC -c xmalloc.c\nCC -c error.c\n\n# Link\nCC -o patch addext.o argmatch.o backupfile.o basename.o dirname.o getopt.o getopt1.o inp.o maketime.o partime.o patch.o pch.o quote.o quotearg.o quotesys.o util.o version.o xmalloc.o error.o\n\n# Check\n./patch --version\n\n# Install\nmkdir -p ${out}/bin\ncp ./patch ${out}/bin\nchmod 555 ${out}/bin/patch\n"},"inputs":{"drvs":{"7bq69blihkvvqq5np4liiszw674bcqqj-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"m2khnp0iw665w7zjkyvil62v5wjlbl8i-patch-2.5.9.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zlsfxdxsnzp1nzzw113avl2v0s5mgjpr-kaem-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["m48r7nsm8wgjy69jg442vc7jjdfmcnl7-write-text-file.kaem"]},"name":"gnupatch-2.5.9-builder","outputs":{"out":{"path":"jmxskfr3aj6ih0k90lwmxj9z2jjrzh90-gnupatch-2.5.9-builder"}},"system":"x86_64-linux","version":4},"laww36xl5rkzp0jcy7vds06zg54i0xzn-libpipeline-1.5.8.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","env":{"__structuredAttrs":"","buildInputs":"","builder":"/nix/store/jnyfsf2mp08d1xyz2m72ic2vz2kcx0sd-bash-5.3p9/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","mesonFlags":"","name":"libpipeline-1.5.8","nativeBuildInputs":"/nix/store/vrnwkpz9sbpsc3mf1vp69ahhrjn82618-u