uld be '$CC' by default\" >&2\n   false\nfi\n","installFlags":"install-doc","mesonFlags":"","name":"ruby-3.4.11","nativeBuildInputs":"/nix/store/80s4plpndykpb7zql4kc1f90fzr49vkf-autoreconf-hook /nix/store/nilcmqdvnpv02v3n63rwnr7pl1zhbgm7-bison-3.8.2 /nix/store/595sskhzrrlc9hiqqi60c42wld9fwl4m-remove-references-to /nix/store/vwcibaw9av3dfi9cgz0br19mi95cyhqz-groff-1.24.2 /nix/store/sl5mjxc60hk7d2v8hz6y920wv63bfzc8-cargo-setup-hook.sh /nix/store/6l9kbzxwq9ij2lcmwl2qb1jdpqisjr8l-rustc-wrapper-1.99.0","out":"/nix/store/7b77drpxxyywsxq9hf4y0fc8c56pfivl-ruby-3.4.11","outputs":"out devdoc","patches":"/nix/store/c6d5gm3zc63zg49kanxf8w6cxfv69ibk-dont-refer-to-build-dir.patch","pname":"ruby","postInstall":"rbConfig=$(find $out/lib/ruby -name rbconfig.rb)\n# Remove references to the build environment from the closure\nsed -i '/^  CONFIG\\[\"\\(BASERUBY\\|SHELL\\|GREP\\|EGREP\\|MKDIR_P\\|MAKEDIRS\\|INSTALL\\)\"\\]/d' $rbConfig\n# Remove unnecessary groff reference from runtime closure, since it's big\nsed -i '/NROFF/d' $rbConfig\n\n\n# Allow to override compiler. This is important for cross compiling as\n# we need to set a compiler that is different from the build one.\nsed -i \"$rbConfig\" \\\n  -e 's/CONFIG\\[\"CC\"\\] = \"\\(.*\\)\"/CONFIG[\"CC\"] = if ENV[\"CC\"].nil? || ENV[\"CC\"].empty? then \"\\1\" else ENV[\"CC\"] end/' \\\n  -e 's/CONFIG\\[\"CXX\"\\] = \"\\(.*\\)\"/CONFIG[\"CXX\"] = if ENV[\"CXX\"].nil? || ENV[\"CXX\"].empty? then \"\\1\" else ENV[\"CXX\"] end/'\n\n# Remove unnecessary external intermediate files created by gems\nextMakefiles=$(find $out/lib/ruby/gems/3.4.0 -name Makefile)\nfor makefile in $extMakefiles; do\n  make -C \"$(dirname \"$makefile\")\" distclean\ndone\nfind \"$out/lib/ruby/gems/3.4.0\" \\( -name gem_make.out -o -name mkmf.log -o -name exts.mk \\) -delete\n# Bundler tries to create this directory\nmkdir -p $out/nix-support\ncat > $out/nix-support/setup-hook <<EOF\naddGemPath() {\n  addToSearchPath GEM_PATH \\$1/lib/ruby/gems/3.4.0\n}\naddRubyLibPath() {\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0\n  addToSearchPath RUBYLIB \\$1/lib/ruby/site_ruby/3.4.0/x86_64-linux\n}\n\naddEnvHooks \"$hostOffset\" addGemPath\naddEnvHooks \"$hostOffset\" addRubyLibPath\nEOF\n# Prevent the docs from being included in the closure\nsed -i \"s|\\$(DESTDIR)$devdoc|\\$(datarootdir)/\\$(RI_BASE_NAME)|\" $rbConfig\nsed -i \"s|'--with-ridir=$devdoc/share/ri'||\" $rbConfig\n\n# Add rbconfig shim so ri can find docs\nmkdir -p $devdoc/lib/ruby/site_ruby\ncp /nix/store/wq7zxvl223s5s97y3dhc3gkyk5d6dw0w-rbconfig.rb $devdoc/lib/ruby/site_ruby/rbconfig.rb\n","postPatch":"sed -i configure.ac -e '/config.guess/d'\ncp --remove-destination /nix/store/f5f2x76r61rkz4fis5n82rcnv670bm7s-autoconf-2.73/share/autoconf/build-aux/config.{guess,sub} tool/\n","postUnpack":"rm -rf $sourceRoot/{lib,test}/rubygems*\ncp -r /nix/store/19qx7rk6nqhj45wkq3p80rpa7n9bkj6l-rubygems-3.7.2/lib/rubygems* $sourceRoot/lib\n","preConfigure":"# rdoc creates XDG_DATA_DIR (defaulting to $HOME/.local/share) even if\n# it's not going to be used.\nexport HOME=$TMPDIR\n","preInstall":"# Ruby installs gems here itself now.\nmkdir -pv \"$out/lib/ruby/gems/3.4.0\"\nexport GEM_HOME=\"$out/lib/ruby/gems/3.4.0\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/2s8hrrpzym96cv8w07sczddkwyyc2iyg-ruby-3.4.11.tar.gz","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"3.4.11"},"inputs":{"drvs":{"08qk9c6g4vvzcww10k4phwzd48d40l5j-cargo-deps-vendor.drv":{"dynamicOutputs":{},"outputs":["out"]},"17x4zac030zfpdgkagi7w74f1s7gjpxy-ncurses-6.6.drv":{"dynamicOutputs":{},"outputs":["dev"]},"1sq3jhkwh17kpil91cvc2sg3m1xdjc50-groff-1.24.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"1vdasz95gwhzfafnj7g0r2i54qndq5qq-ruby-3.4.11.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"1wlq7f27hfii89rnf652xyxxagzc3mpz-rustc-wrapper-1.99.0.drv":