_MIRRORS_ibiblioPubLinux","NIX_MIRRORS_imagemagick","NIX_MIRRORS_kde","NIX_MIRRORS_kernel","NIX_MIRRORS_luarocks","NIX_MIRRORS_maven","NIX_MIRRORS_mozilla","NIX_MIRRORS_mysql","NIX_MIRRORS_openbsd","NIX_MIRRORS_opensuse","NIX_MIRRORS_osdn","NIX_MIRRORS_postgresql","NIX_MIRRORS_pypi","NIX_MIRRORS_qt","NIX_MIRRORS_sageupstream","NIX_MIRRORS_samba","NIX_MIRRORS_savannah","NIX_MIRRORS_sourceforge","NIX_MIRRORS_steamrt","NIX_MIRRORS_tcsh","NIX_MIRRORS_testpypi","NIX_MIRRORS_texhistoric","NIX_MIRRORS_ubuntu","NIX_MIRRORS_xfce","NIX_MIRRORS_xorg"],"mesonFlags":[],"mirrorsListFile":"/nix/store/808pz59rm1qby6rnhg8jkgiwqjc1bl7a-mirrors-list","name":"portability.patch","nativeBuildInputs":["/nix/store/mxsppj348yslmh2qx0mv6klymh9q9v3d-curl-8.22.0-dev","/nix/store/mc59d2ll732xrca8dsjhk3qba0mlkv99-patchutils-0.3.3"],"nixpkgsVersion":"26.11","outputChecks":{"out":{}},"outputHash":"sha256-/X01AWXK0eJ59F8oSREZ7V5Cpw1y35n9uFB1mCvMOus=","outputHashMode":"flat","outputs":["out"],"patches":[],"postFetch":"tmpfile=\"$TMPDIR/patch\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Fetched patch file '$out' is empty!\" 1>&2\n  exit 1\nfi\n\nset +e\ncat < \"$out\" > \"$tmpfile\"\nif [ $? -ne 0 ] || [ ! -s \"$tmpfile\" ]; then\n    echo 'Failed to decode patch with command \"'cat'\"' >&2\n    echo 'Fetched file was (limited to 128 bytes):' >&2\n    od -A x -t x1z -v -N 128 \"$out\" >&2\n    exit 1\nfi\nset -e\nmv \"$tmpfile\" \"$out\"\n\nlsdiff \\\n   \\\n  \"$out\" \\\n| sort -u | sed -e 's/[*?]/\\\\&/g' \\\n| xargs -I{} --delimiter='\\n' \\\n  filterdiff \\\n  --include={} \\\n  --strip=0 \\\n   \\\n  --clean \"$out\" > \"$tmpfile\"\n\nif [ ! -s \"$tmpfile\" ]; then\n  echo \"error: Normalized patch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc","strictDeps":true,"system":"x86_64-linux","urls":["https://github.com/google/benchmark/commit/b5ba9bab85d80f29a161dd634b7d234cf3722f90.patch"]},"system":"x86_64-linux","version":4},"hyz2fh44bhyj16rypvs556g2rr9sycv1-musl-1.2.6.drv":{"args":["-e","/nix/store/9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh"],"builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","env":{"PATH":"/nix/store/whsh3m5f892b10k5xg3j5x2vfplakwpw-tinycc-musl-unstable-2025-12-03-compiler/bin:/nix/store/4210ig7xwzjjwsab8v2mahmd2hckx6k6-gnumake-4.4.1/bin:/nix/store/azdj57mzy4npxfajhmgv91iz6wzb3686-gnupatch-2.5.9/bin:/nix/store/iavp9755n2x6fl76vgv288wkrn1l4h00-gnused-mes-4.0.9/bin:/nix/store/x0gqa6ksn306k9x91fdyb8k4ci90pn5x-gnugrep-2.4/bin:/nix/store/9i47y99mnryi9ldkalnpr0mp4iijqkwa-gnutar-1.12/bin:/nix/store/6skcsg3yn7afxaf0mkp0d0n4yjyz08s4-gzip-1.2.4/bin:/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin:/nix/store/mr3ikv5qcbjs672v5fsyxhfa6vn0v8f5-bootstrap-coreutils-5.0/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","SHELL":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","buildCommand":"# Unpack\ntar xzf /nix/store/1j3vmqzmlbx2j10q0j061fqychxd7q4i-musl-1.2.6.tar.gz\ncd musl-1.2.6\n\n# Patch\npatch -Np0 -i /nix/store/gg3z1dg2p54gc1zxj0m5a40kzgb0biqm-sigsetjmp.patch\n# tcc does not support complex types\nrm -rf src/complex\n# Configure fails without this\nmkdir -p /dev\n# https://github.com/ZilchOS/bootstrap-from-tcc/blob/2e0c68c36b3437386f786d619bc9a16177f2e149/using-nix/2a3-intermediate-musl.nix\nsed -i 's|/bin/sh|/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash|' \\\n  tools/*.sh\nchmod 755 tools/*.sh\n# patch popen/system to search in PATH instead of hardcoding /bin/sh\nsed -i 's|posix_spawn(&pid, \"/bin/sh\",|posix_spawnp(\\&pid, \"sh\",|' \\\n  src/stdio/popen.c src/process/system.c\nsed -i 's|execl(\"/bin/sh\", \"sh\", \"-c\",|execlp(\"sh\", \"-c\",|'\\\n  src/misc/wordexp.c\n\n# @PLT specifier is not supported by tinycc.\n# Calls do go through PLT regardless.\nsed -i 's|@PLT||' src/math/x86_64/expl.s\nsed -i 's|@PLT||' src/signal/x86_64/sigsetjmp.s\n\n# TODO Implement the required asm constraints 'x' and 't' in tinycc.\n# For now, we just remove code using those constraints. musl automatically\n# polyfills with pure C implementations.\nrm src/math/i386/*.c\nrm src/math/x86_64/*.c\n\n# Configure\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --disable-shared \\\n  CC=tcc\n\n# Build\n# NOTE: parallel build (-j) under tcc here is unstable and broke a previous run.\nmake AR=\"tcc -ar\" RANLIB=true CFLAGS=\"-DSYSCALL_NO_TLS\"\n\n# Install\nmake install\ncp /nix/store/km6izy2mps05hgn54byk9vav7lmkazil-tinycc-musl-unstable-2025-12-03-libs/lib/libtcc1.a $out/lib\n","builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","name":"musl-1.2.6","out":"/nix/store/8vaxvk541czfwm8h41i705hf4a1gispq-musl-1.2.6","passAsFile":"buildCommand","pname":"musl","system":"x86_64-linux","version":"1.2.6"},"inputs":{"drvs":{"05z44243pvwk3qrcimv1cf5g3nxi5jjb-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"59pgig863abfc3p6lmz20vh8gjf2nsv1-musl-1.2.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6f6p45qkd5mhdwvfzgxdydwdpplccvgj-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"7g9biqznf18jyzs1r19hhlbf1jvwyivl-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"agzpw52wkapzm6z6yjlmf5321gr7ngxd-gnused