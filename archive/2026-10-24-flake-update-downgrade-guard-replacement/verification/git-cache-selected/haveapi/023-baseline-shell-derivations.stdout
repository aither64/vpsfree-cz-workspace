kcheck-0.11.1.conf\"\nmkdir -p \"$packageConfDir\"\n./Setup register --gen-pkg-config=$packageConfFile\nif [ -d \"$packageConfFile\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/tasty-quickcheck-0.11.1\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"tasty-quickcheck-0.11.1","nativeBuildInputs":"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3 /nix/store/595sskhzrrlc9hiqqi60c42wld9fwl4m-remove-references-to","out":"/nix/store/gwdqhbwbsh00lwh1fcyjmlm8hcsphqp0-tasty-quickcheck-0.11.1","outputs":"out doc","patches":"","pname":"tasty-quickcheck","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"echo \"Replace Cabal file with edited version from mirror://hackage/tasty-quickcheck-0.11.1/revision/5.cabal.\"\ncp /nix/store/99rrbgmpbfcp6jb0ddxzfiq7v86y8v9d-tasty-quickcheck-0.11.1-r5.cabal tasty-quickcheck.cabal\n\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":" /nix/store/bfl18qc97pwkh72bhg2frxdh1kv8ak4b-optparse-applicative-0.18.1.0 /nix/store/3qj813knfwm4h9z2ww1pqjbahg7wyynk-QuickCheck-2.15.0.1 /nix/store/zsizrhv6hq4jczzhl3zx4j151a14v5h9-random-1.2.1.3 /nix/store/n7h2w5aibv58lkw59w5p63xr21ppaa4s-tagged-0.8.9 /nix/store/1mnbchy63h3wcblimvm4h8pkq7rq4j5q-tasty-1.5.4","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3.\"\nexport PATH=/nix/store/fp2wsxdpbg13anc4jv0cfmmi7f3ahjy2-hscolour-1.25/bin:$PATH\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname  --docdir=$doc/share/doc/tasty-quickcheck-0.11.1 --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --enable-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --disable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/2rw44a46hl49h0qv7zxaqafc80c1z7md-tasty-quickcheck-0.11.1.tar.gz","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.11.1"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"31fjd761yywh47jyq2ld6drfcq3dgq34-tasty-quickcheck-0.11.1.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"7c5zvcdslbs1wppshrh6pbj8zlrrjd3q-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"gnb6c5bp3jn1s9g3n423bajc22rj7f06-glibc-locales-2.44-57.drv":{"dynamicOutputs":{}