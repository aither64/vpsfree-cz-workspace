:["/nix/store/0b50k4vhw62hk15qp7zkgmiwhf2lpva2-uname","/nix/store/8qdw9shgr7dd3315jim8sfva2dnhq86c-gettext-1.0","/nix/store/y1gmkixqpkfwayj9iqxn3c8brm6zkn1m-perl-5.42.3","/nix/store/wnxl2v5a9rm80kixrg45k99d0s78zqsv-make-shell-wrapper-hook","/nix/store/s70gz6bvz74c36xigh5m2ab2cqli08cv-pkg-config-wrapper-0.29.2","/nix/store/sx85sjzihl44rkmk5xis7z2hwgbx4fpj-asciidoc-10.2.1","/nix/store/xw038bxq93jqzm0fgdc5ar3023gj2l04-texinfo-7.3","/nix/store/p7ssdjn559ix344mp1jrz7d1hsyl89nm-xmlto-0.0.29","/nix/store/y8hms07h6nqdpbh6j6w3zb5idjaq34sy-docbook2X-0.8.8","/nix/store/s5r0dak2i66w3d85y3bi5s6k8qfpn6x3-docbook-xsl-nons-1.79.2","/nix/store/pdg81zdpvd058yvinpdblg916pifpwg6-docbook-xml-4.5","/nix/store/51hrnnzac75d52nvxlq8dvp9i9mxphx2-libxslt-1.1.45-dev","/nix/store/1jwkiz96iwqdhm4bh2hvgd86ysb0b67q-cargo-1.99.0","/nix/store/6l9kbzxwq9ij2lcmwl2qb1jdpqisjr8l-rustc-wrapper-1.99.0","/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh"],"outputChecks":{"debug":{},"doc":{"disallowedReferences":[]},"out":{"disallowedReferences":[]}},"outputs":["out","doc","debug"],"patches":["/nix/store/j6vpikcvv4ry0pwalvpz1m65k2wckavl-docbook2texi.patch","/nix/store/xprdd33cnqprwk19lxi57h907fz7xic2-git-sh-i18n.patch","/nix/store/85ax0pclk9prgkp8d7m6n6q1g7v5m58j-git-send-email-honor-PATH.patch","/nix/store/k7c6k6zwjh9fgzm9fazn9l1qm6wnv0cy-t7703-ignore-ls-total.patch"],"pname":"git","postBuild":"# Set up the flags array for make in the same way as for the main build\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelBuilding:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags buildFlags\nechoCmd 'build flags' \"${flagsArray[@]}\"\n# Need to build the main Git documentation before building the\n# contrib/subtree documentation, as the latter depends on the\n# asciidoc.conf file created by the former.\nmake -C Documentation PERL_PATH=/nix/store/y1gmkixqpkfwayj9iqxn3c8brm6zkn1m-perl-5.42.3/bin/perl \"${flagsArray[@]}\"\nmake -C contrib/subtree \"${flagsArray[@]}\" all doc\nmake -C contrib/diff-highlight \"${flagsArray[@]}\"\nunset flagsArray\n","postInstall":"# Set up the flags array for make in the same way as for the main install\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelInstalling:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags installFlags\nechoCmd 'install flags' \"${flagsArray[@]}\"\n\n# Install git-subtree.\nmake -C contrib/subtree \"${flagsArray[@]}\" install install-doc\nrm -rf contrib/subtree\n\n# Install contrib stuff.\nmkdir -p $out/share/git\ncp -a contrib $out/share/git/\nmkdir -p $out/share/bash-completion/completions\nln -s $out/share/git/contrib/completion/git-prompt.sh $out/share/bash-completion/completions/\n\n# Fix references to the perl, sed, awk and various coreutil binaries used by\n# shell scripts that git calls (e.g. filter-branch)\nSCRIPT=\"$(cat <<'EOS'\n  BEGIN{\n    @a=(\n      '/nix/store/c3f45pxlb81gzz4w1nym7lpznfypva7s-gnugrep-3.12/bin/grep', '/nix/store/9wc73n5izv0m7ppjbibi4hbr68rba1lj-gnused-4.10/bin/sed', '/nix/store/h96s16mjssibkvk62pvmfm3lwfc3wnwp-gawk-5.4.1/bin/awk',\n      '/nix/store/cb987zkxvsv0490753ilrvn5yk7ylgxi-coreutils-9.12/bin/cut', '/nix/store/cb987zkxvsv0490753ilrvn5yk7ylgxi-coreutils-9.12/bin/basename', '/nix/store/cb987zkxvsv0490753ilrvn5yk7ylgxi-coreutils-9.12/bin/dirname',\n      '/nix/store/cb987zkxvsv0490753ilrvn5yk7ylgxi-coreutils-9.12/bin/wc', '/nix/store/cb987zkxvsv0490753ilrvn5yk7ylgxi-coreutils-9.12/bin/tr'\n      , '/nix/store/y1gmkixqpkfwayj9iqxn3c8brm6zkn1m-perl-5.42.3/bin/perl'\n    );\n  }\n  foreach $c (@a) {\n    $n=(split(\"/\", $c))[-1];\n    s|(?<=[^#][^/.-])\\b${n}(?=\\s)|${c}|g\n  }\nEOS\n)\"\nperl -0777 -i -pe \"$SCRIPT\" \\\n  $out/libexec/git-core/git-{sh-setup,filter-branch,merge-octopus,mergetool,quiltimport,request-pull,submodule,subtree,web--browse}\n\n\n# Also put git-http-backend into $PATH, so that we can use smart\n# HTTP(s) transports for pushing\nln -s $out/libexec/git-core/git-http-backend $out/bin/git-http-backend\nmakeWrapper $out/share/git/contrib/git-jump/git-jump $out/bin/git-jump \\\n  --prefix PATH : \"$out/bin:/nix/store/y1gmkixqpkfwayj9iqxn3c8brm6zkn1m-perl-5.42.3/bin:/nix/store/cb987zkxvsv0490753ilrvn5yk7ylgxi-coreutils-9.12/bin\"\n\n# wrap perl commands\nmakeWrapper \"$out/share/git/contrib/credential/netrc/git-credential-netrc.perl\" $out/libexec/git-core/git-credential-netrc \\\n            --set PERL5LIB   \"$out/lib/perl5/site_perl:/nix/store/0f9na660n2568sn5drb8r3p5aknxy5r8-perl5.42.3-libwww-perl-6.83/lib/perl5/site_perl:/nix/store/fq0lrn9lsg7qadvbc3hgclx6ijqrkprf-perl5.42.3-URI-5.36/lib/perl5/site_perl:/nix/store/m7677iiw5w36mqw5d7kzws7067qi6ry8-perl5.42.3-TermReadKey-2.38/lib/perl5/site_perl\"\n# ideally unneeded, but added for backwards compatibility\nln -s $out/libexec/git-core/git-credential-netrc $out/bin/\n\nwrapProgram $out/libexec/git-core/git-cvsimport \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/0f9na660n2568sn5drb8r3p5aknxy5r8-perl5.42.3-libwww-perl-6.83/lib/perl5/site_perl:/nix/store/fq0lrn9lsg7qadvbc3hgclx6ijqrkprf-perl5.42.3-URI-5.36/lib/perl5/site_perl:/nix/store/m7677iiw5w36mqw5d7kzws7067qi6ry8-perl5.42.3-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-archimport \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/0f9na660n2568sn5drb8r3p5aknxy5r8-perl5.42.3-libwww-perl-6.83/lib/perl5/site_perl:/nix/store/fq0lrn9lsg7qadvbc3hgclx6ijqrkprf-perl5.42.3-URI-5.36/lib/perl5/site_perl:/nix/store/m7677iiw5w36mqw5d7kzws7067qi6ry8-perl5.42.3-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-instaweb \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/0f9na660n2568sn5drb8r3p5aknxy5r8-perl5.42.3-libwww-perl-6.83/lib/perl5/site_perl:/nix/store/fq0lrn9lsg7qadvbc3hgclx6ijqrkprf-perl5.42.3-URI-5.36/lib/perl5/site_perl:/nix/store/m7677iiw5w36mqw5d7kzws7067qi6ry8-perl5.42.3-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-cvsexportcommit \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/0f9na660n2568sn5drb8r3p5aknxy5r8-perl5.42.3-libwww-perl-6.83/lib/perl5/site_perl:/nix/store/fq0lrn9lsg7qadvbc3hgclx6ijqrkprf-perl5.42.3-URI-5.36/lib/perl5/site_perl:/nix/store/m7677iiw5w36mqw5d7kzws7067qi6ry8-perl5.42.3-TermReadKey-2.38/lib/perl5/site_perl\"\n\n# gzip (and optionally bzip2, xz, zip) are runtime dependencies for\n# gitweb.cgi, need to patch so that it's found\nsed -i -e \"s|'compressor' => \\['gzip'|'compressor' => ['/nix/store/rpswfv0ff4wap9anx7k1224x2m94pfcc-gzip-1.15/bin/gzip'|\" \\\n    $out/share/gitweb/gitweb.cgi\n# Give access to CGI.pm and friends (was removed from perl core in 5.22)\nfor p in /nix/store/z2pfix6anjs8j8nplw18zlhqm2g9jygj-perl5.42.3-CGI-4.59 /nix/store/sixp6a2yhv1rqyjvi4q0vkz85z8r0rnr-perl5.42.3-HTML-Parser-3.85 /nix/store/y2fv5szkflkflgj2hws2mhlhr5bz7c7b-perl5.42.3-CGI-Fast-2.16 /nix/store/9drfa3mrps11k2169s62h354mpj86q7l-perl5.42.3-FCGI-0.82 /nix/store/ncpfrkxdi790dnky93p1dpvn50m7icaj-perl5.42.3-FCGI-ProcManager-0.28 /nix/store/spr79kzwpcsmfbvppf7br727bvn4gsdm-perl5.42.3-HTML-TagCloud-0.38; do\n    sed -i -e \"/use CGI /i use lib \\\"$p/lib/perl5/site_perl\\\";\" \\\n        \"$out/share/gitweb/gitweb.cgi\"\ndone\npatchShebangs $out/share/git/contrib/fast-import/import-zips.py\nrm $out/libexec/git-core/git-svn\n# wrap git-send-email\nwrapProgram $out/libexec/git-core/git-send-email \\\n             --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/plix5s7ffq1fp9p8yhxj3adl0ah4hhqz-perl5.42.3-libnet-3.15/lib/perl5/site_perl:/nix/store/kd19ppzfp08pwrqrwnzmqb13l2xwnwiq-perl5.42.3-Net-SMTP-SSL-1.04/lib/perl5/site_perl:/nix/store/dbrcfmydw7qbgl9phkdzg3l2ykp0ssgq-perl5.42.3-IO-Socket-SSL-2.083/lib/perl5/site_perl:/nix/store/rab3bl91k7xksrdpdw69pcpkj6p1z78q-perl5.42.3-Net-SSLeay-1.92/lib/perl5/site_perl:/nix/store/86c5q81pmzq11lriiry3pazlb01gggww-perl5.42.3-Authen-SASL-2.2100/lib/perl5/site_perl:/nix/store/x5a9anjlhrsp9rmr1j2rdf1czlxlzxnk-perl5.42.3-Digest-HMAC-1.05/lib/perl5/site_perl\"\n# Install man pages\nmake \"${flagsArray[@]}\" install install-html \\\n  -C Documentation\nfor prog in bin/gitk libexec/git-core/git-gui; do\n  rm \"$out/$prog\"\ndone\nunset flagsArray\n","postPatch":"# Fix references to gettext introduced by ./git-sh-i18n.patch\nsubstituteInPlace git-sh-i18n.sh \\\n    --subst-var-by gettext /nix/store/8qdw9shgr7dd3315jim8sfva2dnhq86c-gettext-1.0\nsubstituteInPlace contrib/credential/libsecret/Makefile \\\n    --replace-fail 'pkg-config' \"$PKG_CONFIG\"\n","preBuild":"makeFlags+=( perllibdir=$out/$(perl -MConfig -wle 'print substr $Config{installsitelib}, 1 + length $Config{siteprefixexp}') )\n","preInstall":"","preInstallCheck":"# Some tests break with high concurrency\n# https://github.com/NixOS/nixpkgs/pull/403237\nif ((NIX_BUILD_CORES > 32)); then\n  NIX_BUILD_CORES=32\nfi\n\ninstallCheckFlags+=(\n  GIT_PROVE_OPTS=\"--jobs $NIX_BUILD_CORES --failures --state=failed,save\"\n  GIT_TEST_INSTALLED=$out/bin\n  NO_SVN_TESTS=y\n)\nfunction disable_test {\n  local test=$1 pattern=$2\n  if [ $# -eq 1 ]; then\n    mv t/{,skip-}$test.sh || true\n  else\n    sed -i t/$test.sh \\\n      -e \"/^\\s*test_expect_.*$pattern/,/^\\s*' *\\$/{s/^/: #/}\"\n  fi\n}\n\n# Shared permissions are forbidden in sandbox builds:\nsubstituteInPlace t/test-lib.sh \\\n  --replace \"test_set_prereq POSIXPERM\" \"\"\n# TODO: Investigate while these still fail (without POSIXPERM):\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'shared overrides system'\n# Tested to fail: 2.46.0\ndisable_test t0001-init 'init honors global core.sharedRepository'\n# Tested to fail: 2.46.0\ndisable_test t1301-shared-repo\n# /build/git-2.44.0/contrib/completion/git-completion.bash: line 452: compgen: command not found\ndisable_test t9902-completion\n# Flaky tests:\ndisable_test t0027-auto-crlf\ndisable_test t1451-fsck-buffer\ndisable_test t5319-multi-pack-index\ndisable_test t6421-merge-partial-clone\ndisable_test t7504-commit-msg-hook\ndisable_test t5515-fetch-merge-logic\ndisable_test t4104-apply-boundary\ndisable_test t7002-mv-sparse-checkout\ndisable_test t4122-apply-symlink-inside\ndisable_test t7513-interpret-trailers\ndisable_test t2200-add-update\n\n# Fails when run with GIT_TEST_INSTALLED, that is, when we're testing an\n# installed package rather than the build output prior to installation.\n# This test is fragile when testing an installed package even in Nix's\n# otherwise clean build environment, upstream haven't been keen on patching\n# individual failures when they crop up, and nobody has yet managed to\n# rewrite the test to be less fragile.\n#\n# See in particular the below messages and discussions around them:\n# https://lore.kernel.org/git/xmqqect7fhnp.fsf@gitster.g/\n# https://lore.kernel.org/git/20251201031040.1120091-1-brianmlyles@gmail.com/\ndisable_test t1517-outside-repo\n\n# Fails reproducibly on ZFS on Linux with formD normalization\ndisable_test t0021-conversion\ndisable_test t3910-mac-os-precompose\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"src":"/nix/store/454fdxl1kl3cslpdmxai3n927xm9m55q-git-2.56.0.tar.xz","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":true,"stripDebugList":["lib","libexec","bin","share/git/contrib/credential"],"system":"x86_64-linux","version":"2.56.0"},"system":"x86_64-linux","version":4},"5y67rlqwiiv7607z9204zmfmw7bl4wwy-libtcc1.a.drv":{"args":["--verbose","--strict","--file","/nix/store/hsg2g4r0zy48vsprzqim4kp8pd7k5xky-libtcc1.a-builder"],"builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","env":{"PATH":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin:/nix/store/53zd871rgpcvi7qmqkffxhzaiq0is7k4-mescc-tools-1.9.1/bin:/nix/store/nf45b5s985mn73828jb6pfq0g85j0hvg-mescc-tools-extra-1.9.1/bin","builder":"/nix/store/n3mfz1lj8rbz0cspkfrvxiy9h5hm0vzg-kaem-1.9.1/bin/kaem","name":"libtcc1.a","out":"