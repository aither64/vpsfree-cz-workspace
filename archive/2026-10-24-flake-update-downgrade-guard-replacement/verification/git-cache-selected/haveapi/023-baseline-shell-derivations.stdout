ort CFLAGS_FOR_TARGET=\"-O0 -Wl,-dynamic-linker -Wl,/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib/libc.so\"\nexport CXXFLAGS_FOR_TARGET=\"$CFLAGS_FOR_TARGET\"\nexport C_INCLUDE_PATH=\"/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/include\"\nexport CPLUS_INCLUDE_PATH=\"$C_INCLUDE_PATH\"\nexport LIBRARY_PATH=\"/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib\"\n\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-native-system-header-dir=/include \\\n  --with-sysroot=/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6 \\\n  --enable-languages=c,c++ \\\n  --enable-checking=release \\\n  --disable-serial-configure \\\n  --disable-analyzer \\\n  --disable-bootstrap \\\n  --disable-dependency-tracking \\\n  --disable-decimal-float \\\n  --disable-libmpx \\\n  --disable-libsanitizer \\\n  --disable-libssp \\\n  --disable-libgomp \\\n  --disable-libquadmath \\\n  --disable-libitm \\\n  --disable-libvtv \\\n  --disable-libatomic \\\n  --disable-libstdcxx-pch \\\n  --disable-lto \\\n  --disable-multilib \\\n  --disable-nls \\\n  --disable-plugin \\\n  --without-isl \\\n  --disable-libstdcxx-filesystem-ts \\\n  --disable-shared\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n\nif [ -d \"$out/lib64\" ]; then\n  shopt -s dotglob\n  for lib in $out/lib64/*; do\n    mv --no-clobber \"$lib\" \"$out/lib/\"\n  done\n  shopt -u dotglob\n  rm -rf \"$out/lib64\"\n  ln -s lib \"$out/lib64\"\nfi\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"gcc-10.4.0","out":"/nix/store/hcb1z6vs22f1i10sxjn64xx40ybgprxq-gcc-10.4.0","passAsFile":"buildCommand","pname":"gcc","system":"x86_64-linux","version":"10.4.0"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"0dpycpy1hz7sccz9w6a9vc22zfzc17hd-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"5qsf