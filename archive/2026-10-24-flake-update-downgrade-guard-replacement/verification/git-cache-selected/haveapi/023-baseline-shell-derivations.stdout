file '$out' is empty!\" 1>&2\n  exit 1\nfi\n\nset +e\ncat < \"$out\" > \"$tmpfile\"\nif [ $? -ne 0 ] || [ ! -s \"$tmpfile\" ]; then\n    echo 'Failed to decode patch with command \"'cat'\"' >&2\n    echo 'Fetched file was (limited to 128 bytes):' >&2\n    od -A x -t x1z -v -N 128 \"$out\" >&2\n    exit 1\nfi\nset -e\nmv \"$tmpfile\" \"$out\"\n\nlsdiff \\\n   \\\n  \"$out\" \\\n| sort -u | sed -e 's/[*?]/\\\\&/g' \\\n| xargs -I{} --delimiter='\\n' \\\n  filterdiff \\\n  --include={} \\\n  --strip=0 \\\n   \\\n  --clean \"$out\" > \"$tmpfile\"\n\nif [ ! -s \"$tmpfile\" ]; then\n  echo \"error: Normalized patch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc","strictDeps":true,"system":"x86_64-linux","urls":["https://github.com/fontforge/fontforge/commit/7d67700cf8888e0bb37b453ad54ed932c8587073.patch"]},"system":"x86_64-linux","version":4},"a5aqcvs602azlq715rsdvxb4zjpjhx2c-secure-opendir-fix-error-handling.patch.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh"],"builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","env":{"out":"/nix/store/a49rxqqdi5i42qhyfnbq6mbwmf09cwal-secure-opendir-fix-error-handling.patch"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w