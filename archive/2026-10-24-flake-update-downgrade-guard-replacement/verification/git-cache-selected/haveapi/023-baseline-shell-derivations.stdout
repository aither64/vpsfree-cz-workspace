c6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","cmakeFlags":[],"configureFlags":["shared","--libdir=lib","--openssldir=etc/ssl","enable-ec_nistp_64_gcc_128","enable-ktls"],"configurePlatforms":[],"configureScript":"./Configure linux-x86_64","depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":true,"doInstallCheck":false,"dontAddStaticConfigureFlags":true,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"NIX_MAIN_PROGRAM":"openssl"},"makeFlags":["MANDIR=$(man)/share/man","MANSUFFIX=ssl"],"mesonFlags":[],"name":"openssl-3.5.9","nativeBuildInputs":["/nix/store/wsmmw9pf0gd3a4r1hygr1xm71k10mqbb-make-binary-wrapper-hook","/nix/store/y1gmkixqpkfwayj9iqxn3c8brm6zkn1m-perl-5.42.3","/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh"],"outputChecks":{"bin":{},"debug":{},"dev":{},"doc":{},"man":{},"out":{}},"outputs":["bin","dev","out","man","doc","debug"],"patches":["/nix/store/sq4h6bqjx12v9whvm65pjss25hg1538q-nix-ssl-cert-file.patch","/nix/store/cklrwbwi889pp2fdsswdjvn12sdy5i5j-openssl-disable-kernel-detection.patch","/nix/store/i58agvhx8bmdjlspgkk4m3ylh5348iim-use-etc-ssl-certs.patch"],"pname":"openssl","postFixup":"# Check to make sure the main output and the static runtime dependencies\n# don't depend on perl\nif grep -r '/nix/store/y1gmkixqpkfwayj9iqxn3c8brm6zkn1m-perl-5.42.3' $out $etc; then\n  echo \"Found an erroneous dependency on perl ^^^\" >&2\n  exit 1\nfi\n# cleanup cmake helpers for now (for OpenSSL >= 3.3), only rely on pkg-config.\n# pkg-config gets its paths fixed correctly\nrm -rf $dev/lib/cmake\n","postInstall":"# If we're building dynamic libraries, then don't install static\n# libraries.\nif [ -n \"$(echo $out/lib/*.so $out/lib/*.dylib $out/lib/*.dll)\" ]; then\n    rm \"$out/lib/\"*.a\nfi\n\n# 'etc' is a separate output on static builds only.\netc=$out\nmkdir -p $bin\nmv $out/bin $bin/bin\n\n# c_rehash is a legacy perl script with the same functionality\n# as `openssl rehash`\n# this wrapper script is created to maintain backwards compatibility without\n# depending on perl\nmakeWrapper $bin/bin/openssl $bin/bin/c_rehash \\\n  --add-flags \"rehash\"\n\nmkdir $dev\nmv $out/include $dev/\n\n# remove dependency on Perl at runtime\nrm -r $etc/etc/ssl/misc\n\nrmdir $etc/etc/ssl/{certs,private}\n","postPatch":"patchShebangs Configure\nsubstituteInPlace config --replace '/usr/bin/env' '/nix/store/cb987zkxvsv0490753ilrvn5yk7ylgxi-coreutils-9.12/bin/env'\n","preCheck":"patchShebangs util\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"separateDebugInfo":true,"setOutputFlags":false,"src":"/nix/store/pv5imjz1sglx59fjg1927pbjzavhvxc2-openssl-3.5.9.tar.gz","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"3.5.9"},"system":"x86_64-linux","version":4},"bqfv3c3dqgdwvih8ljbybgcsw5pqbg3w-Glob-0.10.2.tar.gz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh"],"builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","env":{"out":"/nix/store/9kjpqdkg512vvsjnyp33vacmgb3zlszs-Glob-0.10.2.tar.gz"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"4aindnhiwrbms5xnslk5gaagp047xpy0-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"jrjq3n2gpgq6sn07iiymh8ivf19ahncm-stdenv-linux-no-cc.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh","808pz59rm1qby6rnhg8jkgiwqjc1bl7a-mirrors-list","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh"]},"name":"Glob-0.10.2.tar.gz","outputs":{"out":{"hash":"sha256-avZyrIQn01y9QtZBQtwoj+qyZvC+ktrjxpbohg2Bc8A=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInput