_MIRRORS_gnu","NIX_MIRRORS_gnupg","NIX_MIRRORS_hackage","NIX_MIRRORS_hashedMirrors","NIX_MIRRORS_ibiblioPubLinux","NIX_MIRRORS_imagemagick","NIX_MIRRORS_kde","NIX_MIRRORS_kernel","NIX_MIRRORS_luarocks","NIX_MIRRORS_maven","NIX_MIRRORS_mozilla","NIX_MIRRORS_mysql","NIX_MIRRORS_openbsd","NIX_MIRRORS_opensuse","NIX_MIRRORS_osdn","NIX_MIRRORS_postgresql","NIX_MIRRORS_pypi","NIX_MIRRORS_qt","NIX_MIRRORS_sageupstream","NIX_MIRRORS_samba","NIX_MIRRORS_savannah","NIX_MIRRORS_sourceforge","NIX_MIRRORS_steamrt","NIX_MIRRORS_tcsh","NIX_MIRRORS_testpypi","NIX_MIRRORS_texhistoric","NIX_MIRRORS_ubuntu","NIX_MIRRORS_xfce","NIX_MIRRORS_xorg"],"mesonFlags":[],"mirrorsListFile":"/nix/store/808pz59rm1qby6rnhg8jkgiwqjc1bl7a-mirrors-list","name":"indexed-traversable-0.1.4.tar.gz","nativeBuildInputs":["/nix/store/mxsppj348yslmh2qx0mv6klymh9q9v3d-curl-8.22.0-dev"],"nixpkgsVersion":"26.11","outputChecks":{"out":{}},"outputHash":"08ivs1shxnvw5fzklvg7yh4xy0nnh3gsglm059fa5m9svyphkgjq","outputHashAlgo":"sha256","outputHashMode":"flat","outputs":["out"],"patches":[],"postFetch":"","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc","strictDeps":true,"system":"x86_64-linux","urls":["mirror://hackage/indexed-traversable-0.1.4.tar.gz"]},"system":"x86_64-linux","version":4},"faklixjfqrpfwz3z513s6p9lmk2qf3mw-mescc-tools-extra-cp-1.9.1.drv":{"args":["--verbose","--strict","--file","/nix/store/fzb1iqki8fw6k6vppjnyc0bqnqclssaq-build-cp.kaem"],"builder":"/nix/store/0ql80hyg6dqs00x15fggfz7a0dhs7swq-kaem-unwrapped-1.9.1","env":{"M1":"/nix/store/40nlys32r8ra0qrab1b27igpm6skkvnw-M1-1.9.1","M2":"/nix/store/c933x2407ahyia5bd2z39109zsk2q2b7-M2-1.9.1","blood-elf-0":"/nix/store/pc7xsqqlrmd36wlnpikj5kfr2rrpfmck-blood-elf-0-1.9.1","builder":"/nix/store/0ql80hyg6dqs00x15fggfz7a0dhs7swq-kaem-unwrapped-1.9.1","hex2":"/nix/store/932x535fjpinpaw2crsjay29snjpclfx-hex2-1.9