 \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc","strictDeps":true,"system":"x86_64-linux","urls":["https://github.com/nodejs/uvwasi/commit/0820128569533c855d60c0f6382acbb14aa62ad2.patch?full_index=1"]},"system":"x86_64-linux","version":4},"3mpycmgg5i9b6w9n2rlwqd425qc1bj97-e230f474b87134e8c6c85b630084c612057f253e.patch.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh"],"builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","env":{"out":"/nix/store/f32aydndzrxx1id1qxvp1dq29cl739wf-e230f474b87134e8c6c85b630084c612057f253e.patch"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"4aindnhiwrbms5xnslk5gaagp047xpy0-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"jrjq3n2gpgq6sn07iiymh8ivf19ahncm-stdenv-linux-no-cc.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh","808pz59rm1qby6rnhg8jkgiwqjc1bl7a-mirrors-list","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh"]},"name":"e230f474b87134e8c6c85b630084c612057f253e.patch","outputs":{"out":{"hash":"sha256-QERl8RHJz7tFr++hZIYwdj1/ogPpjArC+ia8S/bWxKk=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","cmakeFlags":[],"configureFlags":[],"curlOpts":"","curlOptsList":[],"depsBuildBuild":[],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"dep