n\ncp out/Release/{bytecode_builtins_list_generator,mksnapshot,torque,node_js2c,gen-regexp-special-case} $dev/bin\n\n$out/bin/node --completion-bash > node.bash\ninstallShellCompletion node.bash\n\n\nmkdir -p $npm/share/bash-completion/completions\nln -s $npm/lib/node_modules/npm/lib/utils/completion.sh \\\n  $npm/share/bash-completion/completions/npm\n\nln -s /nix/store/6zv6v5mq7njy12b84yamd3mpzz2qk5yf-libuv-1.53.0-dev/include/* /nix/store/wps4g7kaj73d2zs53a5cfimw1bnb3c99-openssl-3.5.9-dev/include/* /nix/store/a76rmqrp6l3w6h9pppfwzb3s6dzi0y4g-zlib-1.3.2-dev/include/* $out/include/node/\n\n# assemble a static v8 library and put it in the 'libv8' output\nmkdir -p $libv8/lib\npushd out/Release/obj\nfind . -path \"**/torque_*/**/*.o\" -or -path \"**/v8*/**/*.o\" \\\n  -and -not -name \"torque.*\" \\\n  -and -not -name \"mksnapshot.*\" \\\n  -and -not -name \"gen-regexp-special-case.*\" \\\n  -and -not -name \"bytecode_builtins_list_generator.*\" \\\n  | sort -u >files\ntest -s files # ensure that the list is not empty\n$AR -cqs $libv8/lib/libv8.a @files\npopd\n\n# copy v8 headers\ncp -r deps/v8/include $libv8/\n\n# create a pkgconfig file for v8\nmajor=$(grep V8_MAJOR_VERSION deps/v8/include/v8-version.h | cut -d ' ' -f 3)\nminor=$(grep V8_MINOR_VERSION deps/v8/include/v8-version.h | cut -d ' ' -f 3)\npatch=$(grep V8_PATCH_LEVEL deps/v8/include/v8-version.h | cut -d ' ' -f 3)\nmkdir -p $libv8/lib/pkgconfig\ncat > $libv8/lib/pkgconfig/v8.pc << EOF\nName: v8\nDescription: V8 JavaScript Engine\nVersion: $major.$minor.$patch\nLibs: -L$libv8/lib -lv8 -pthread -licui18n -licuuc\nCflags: -I$libv8/include\nEOF\ncp -r $out/include $dev/include\n","postPatch":"substituteInPlace tools/install.py \\\n  --replace-fail '  corepack_files(options, action)' \"  oip=options.install_path;options.install_path='$corepack';corepack_files(options, action);options.install_path=oip\" \\\n  --replace-fail '  npm_files(options, action)' \"  oip=options.install_path;options.install_path='$npm';np