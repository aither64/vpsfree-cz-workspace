nable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/r80xm14h93gqw74ay0rdsfhlp1v2v75s-ChasingBottoms-1.3.1.17.tar.gz","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.3.1.17"},"inputs":{"drvs":{"1ipscnfc04f7qlj42b4s67lx6s1859a6-ChasingBottoms-1.3.1.17.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"7c5zvcdslbs1wppshrh6pbj8zlrrjd3q-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"g4jq129jaqwii03a2285f7mwv2xvhvcg-ChasingBottoms-1.3.1.17-r1.cabal.drv":{"dynamicOutputs":{},"outputs":["out"]},"gnb6c5bp3jn1s9g3n423bajc22rj7f06-glibc-locales-2.44-57.drv":{"dynamicOutputs":{},"outputs":["out"]},"iacsilvsa2kwqvj9k5dvz6h3gmsryp0g-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"m7bmd2qz1zcnk4k25y5cg6wbb3y9qwcb-coreutils-9.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"s4fw7zy1xkhji75dnx7wnqp6f1i4yfxj-QuickCheck-2.15.0.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"s6zllgzln0kjzfnx5gjb559ql9i47xzh-syb-0.7.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"wlx9dx8l7la2awy6m6z9l6zwz5jhnqyr-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"xdrsvc2g7gy2b6bf1qryl1nkdwz5zqgm-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"yq658p0cj9vf1x1hfsdngnl9wy2yp694-random-1.2.1.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"ys38bpb9p9mhvbp37lrnxlda4q5hb2f3-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["4mdp8nhyfddh7bllbi7xszz7k9955n79-Setup.hs","907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk","l622p70v