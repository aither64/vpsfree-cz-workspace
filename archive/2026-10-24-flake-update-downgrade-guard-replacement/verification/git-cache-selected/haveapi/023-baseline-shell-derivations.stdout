y9qxvq37fn8vx-automake-1.18.1 /nix/store/m302wmq507k12h99k3x3l9ylnnr92y7h-flex-2.6.4 /nix/store/8qdw9shgr7dd3315jim8sfva2dnhq86c-gettext-1.0 /nix/store/vwcibaw9av3dfi9cgz0br19mi95cyhqz-groff-1.24.2 /nix/store/a9ilgwvkq7j51dyqp22caafam792ywdh-libtool-2.6.2 /nix/store/wnxl2v5a9rm80kixrg45k99d0s78zqsv-make-shell-wrapper-hook /nix/store/s70gz6bvz74c36xigh5m2ab2cqli08cv-pkg-config-wrapper-0.29.2 /nix/store/l9f17m3j280r2gmb7gksl4r1dycxylin-zstd-1.5.7-dev /nix/store/mb4vjismi9w285z1y4kjxdd9abn3v5r1-glibc-iconv-2.44","out":"/nix/store/zw0mlwj6iz4zkyln3qq06d5wzhp9dnjx-man-db-2.13.1","outputMan":"out","outputs":"out doc","patches":"/nix/store/p4m9shlpsqrvir464livcdni0y32ah3f-systemwide-man-db-conf.patch","pname":"man-db","postInstall":"# apropos/whatis uses program name to decide whether to act like apropos or whatis\n# (multi-call binary). `apropos` is actually just a symlink to whatis. So we need to\n# make sure that we don't wrap symlinks (since that changes argv[0] to the -wrapped name)\nfind \"$out/bin\" -type f | while read file; do\n  wrapProgram \"$file\" \\\n    --prefix PATH : \"/nix/store/vwcibaw9av3dfi9cgz0br19mi95cyhqz-groff-1.24.2/bin:/nix/store/rpswfv0ff4wap9anx7k1224x2m94pfcc-gzip-1.15/bin:/nix/store/yqgkjczmmxsp6l26nwriry7h3kq981vi-zstd-1.5.7-bin/bin\"\ndone\n","postPatch":"# Remove all mandatory manpaths. Nixpkgs makes no requirements on\n# these directories existing.\nsed -i 's/^MANDATORY_MANPATH/# &/' src/man_db.conf.in\n\n# Add Nix-related manpaths\necho \"MANPATH_MAP\t/nix/var/nix/profiles/default/bin\t/nix/var/nix/profiles/default/share/man\" >> src/man_db.conf.in\n\n# Add mandb locations for the above\necho \"MANDB_MAP\t/nix/var/nix/profiles/default/share/man\t/var/cache/man/nixpkgs\" >> src/man_db.conf.in\n","preConfigure":"./bootstrap --no-git --gnulib-srcdir=/nix/store/h2w86fikxn4hr91nwhkph9cbl0mbmyyv-gnulib-20241001 --gen\nconfigureFlagsArray+=(\"--with-sections=1 n l 8 3 0 2 5 4 9 6 7\")\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":