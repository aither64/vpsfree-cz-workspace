fi\n\n  # This should work as long as wrapperInterpreter is a shell, which is\n  # the case for programs wrapped with makeWrapper, like\n  # python3.withPackages etc.\n  interpreterLine=\"$wrapperInterpreterLine $interpreter\"\nelse\n  interpreterLine=$interpreter\nfi\n\necho \"#! $interpreterLine\" > $out\ncat \"$contentPath\" >> $out\n/nix/store/91a26w6xq3mlfr624xv63gprl2408mqp-dash-0.5.13.5/bin/dash -n $out\n\nchmod +x $out\n\n# Relocate executable\n# Wrap it if makeWrapperArgs are specified\nmv $out tmp\n  mkdir -p $out/$(dirname \"/bin/pythoncheck.sh\")\n  mv tmp $out//bin/pythoncheck.sh\nif [ -n \"${makeWrapperArgs+${makeWrapperArgs[@]}}\" ]; then\n    wrapProgram $out//bin/pythoncheck.sh ${makeWrapperArgs[@]}\nfi\n","buildInputs":"","builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","cmakeFlags":"","configureFlags":"","content":"exec /nix/store/5x5kd7vkdn90bxigz7abdqp2yl2zkmhr-python3.14-flake8-7.3.0/bin/flake8 --show-source --ignore E501,W503 \"$1\"\n","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","interpreter":"/nix/store/91a26w6xq3mlfr624xv63gprl2408mqp-dash-0.5.13.5/bin/dash","makeWrapperArgs":"","mesonFlags":"","name":"pythoncheck.sh","nativeBuildInputs":"/nix/store/wsmmw9pf0gd3a4r1hygr1xm71k10mqbb-make-binary-wrapper-hook","out":"/nix/store/hnx9xkxh9mkyq5s33hzqg33dvzxiajz9-pythoncheck.sh","outputs":"out","passAsFile":"buildCommand content","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"