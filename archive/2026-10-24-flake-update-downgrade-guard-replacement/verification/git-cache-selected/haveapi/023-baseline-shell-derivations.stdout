ized patch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc","strictDeps":true,"system":"x86_64-linux","urls":["https://salsa.debian.org/holmgren/uw-imap/raw/dcb42981201ea14c2d71c01ebb4a61691b6f68b3/debian/patches/1006_openssl1.1_autoverify.patch"]},"system":"x86_64-linux","version":4},"f6y6ln28vl29xk1r3gs7jkq014mpd6rn-composer.phar.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh"],"builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","env":{"out":"/nix/store/k51vbm3pd8nd3v0gywn56azmmq6i8kzh-composer.phar"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"4aindnhiwrbms5xnslk5gaagp047xpy0-curl-8.22.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"jrjq3n2gpgq6sn07iiymh8ivf19ahncm-stdenv-linux-no-cc.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh","808pz59rm1qby6rnhg8jkgiwqjc1bl7a-mirrors-list","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh"]},"name":"composer.phar","outputs":{"out":{"hash":"sha256-ei03nVuP/aoChYDvJklMNtL+70sXjT3RRzpNvF4XyNY=","method":"flat"}},"structuredAttrs":{"SSL_CERT_FILE":"/no-cert-file.crt","buildInputs":[],"builder":"