Inputs":[],"showURLs":false,"stdenv":"/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc","strictDeps":true,"system":"x86_64-linux","urls":["mirror://hackage/semigroupoids-6.0.2/revision/1.cabal"]},"system":"x86_64-linux","version":4},"v1azpm6hgdpy529809yf13xw9pf2773c-python-3.14.6.drv":{"args":["-e","/nix/store/70acbfgbz5cxsx4sqzcnj8qaqhb4i9ay-bash-builder.sh"],"builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","env":{"PATH":"/nix/store/hxjqk041csbm2r7qyk4bk6xbb1ikyfy3-gcc-wrapper-16.2.0/bin:/nix/store/r04s6g51v2002prayd855xazjrsiszlb-binutils-2.47/bin:/nix/store/06gvqpadb2w24pazjb87m2jd2j24h0v2-gnumake-musl-4.4.1/bin:/nix/store/azdj57mzy4npxfajhmgv91iz6wzb3686-gnupatch-2.5.9/bin:/nix/store/2afl43wwm3bp41aqr9d6233zghmqwahm-gnused-4.2/bin:/nix/store/x0gqa6ksn306k9x91fdyb8k4ci90pn5x-gnugrep-2.4/bin:/nix/store/nsxim2jqwz8s411zrljn11f64cmz9928-gawk-5.4.1/bin:/nix/store/8sn2nxrzlp4y2bn0s55pjlrdjmapyzkl-diffutils-3.8/bin:/nix/store/1694ha2msax6nrx00bhg2ybrpqfmkqq4-findutils-4.11.0/bin:/nix/store/x7y50xlwjp75hyqrq6038krray7schys-gnutar-1.35/bin:/nix/store/fjy092g1x515rnpv33bjx00hxfbp67h9-xz-5.8.3/bin:/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin:/nix/store/rfv4gzzcgz85wlha9k4s850c9l3k46m2-bootstrap-coreutils-musl-9.11/bin","SHELL":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","buildCommand":"# Unpack\ntar xf /nix/store/h49kk5c1f2gfmd7nramvh5rzcbpz4fwd-Python-3.14.6.tar.xz\ncd Python-3.14.6\n\n# Patch\npatch -Np1 -i /nix/store/jqin2kzvzrvi30cxda5zp7qz1fanmz7v-no-ldconfig.patch\n\n# Configure\nexport C_INCLUDE_PATH=\"/nix/store/rdwk2jcdarbvzcg1dil17lhch8s2d4xh-zlib-1.3.2/include\"\nexport LIBRARY_PATH=\"/nix/store/rdwk2jcdarbvzcg1dil17lhch8s2d4xh-zlib-1.3.2/lib\"\nexport LDFLAGS=\"-L/nix/store/rdwk2jcdarbvzcg1dil17lhch8s2d4xh-zlib-1.3.2/lib\"\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --disable-test-modules \\\n  --without-ensurepip \\\n  --without-static-libpython\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install\n\n# Remove lib-dynload extension modules not needed for glibc's build scripts.\n# glibc uses Python only for scripts that import: os, re, subprocess, argparse,\n# pathlib, collections, tempfile.  Following the import chain:\n#   subprocess -> selectors -> math, select, fcntl, _posixsubprocess\n#   pathlib -> grp\n#   tempfile -> random -> _random, bisect -> _bisect\n# Everything else in lib-dynload is dead weight in the bootstrap context.\nfind $out/lib/python*/lib-dynload -name '*.so' \\\n  ! -name '_bisect*' \\\n  ! -name '_posixsubprocess*' \\\n  ! -name '_random*' \\\n  ! -name 'fcntl*' \\\n  ! -name 'grp*' \\\n  ! -name 'math*' \\\n  ! -name 'select*' \\\n  -delete\n\nrm -rf \\\n  $out/lib/python*/ensurepip \\\n  $out/lib/python*/idlelib \\\n  $out/lib/python*/site-packages \\\n  $out/lib/python*/test \\\n  $out/lib/python*/tkinter \\\n  $out/lib/python*/turtledemo \\\n  $out/share/man\n\nrm -f $out/bin/idle* $out/bin/pip*\nfind $out/lib/python* -type d -name __pycache__ -prune -exec rm -rf {} +\nstrip --strip-unneeded $out/bin/python3.14 $out/lib/python*/lib-dynload/*.so || true\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"python-3.14.6","out":"/nix/store/1nzmryr5w5f3mfxlid9vynln3xr85x2s-python-3.14.6","passAsFile":"buildCommand","pname":"python","system":"x86_64-linux","version":"3.14.6"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"0dpycpy1hz7sccz9w6a9vc22zfzc17hd-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"2s5wx49znk1dfrm4j3vi5hdwbibyqmb3-Python-3.14.6.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"5qsfr7wfv9fnbk79s85v1gs759r2rw78-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"6v8bjfwdcw75b9hv7gzl0jyfljdlc3vw-binutils-2.47.drv":{"dynamicOutputs":{},"outputs":["out"]},"8xy9yi1vwp0mc32lz37jgva7hck5j9by-gawk-5.4.