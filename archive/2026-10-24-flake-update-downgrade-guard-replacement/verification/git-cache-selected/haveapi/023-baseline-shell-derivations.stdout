ude/\n\n# Strip\n# Ignore failures, because strip may fail on non-elf files.\nfind $out/{bin,lib} -type f -exec strip --strip-debug {} + || true\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"musl-1.2.6","out":"/nix/store/5ljagm084aar7yzakh5grrja44md9gd0-musl-1.2.6","passAsFile":"buildCommand","pname":"musl","system":"x86_64-linux","version":"1.2.6"},"inputs":{"drvs":{"0k7lgk25a3cynnhf1dfbvg45lm5s0rpp-linux-headers-6.5.6.drv":{"dynamicOutputs":{},"outputs":["out"]},"59pgig863abfc3p6lmz20vh8gjf2nsv1-musl-1.2.6.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6v8bjfwdcw75b9hv7gzl0jyfljdlc3vw-binutils-2.47.drv":{"dynamicOutputs":{},"outputs":["out"]},"7g9biqznf18jyzs1r19hhlbf1jvwyivl-gnutar-1.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"aw4a7hi7q0mb2ljazxq0in9f5v4905a5-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"bjfpxb6q4p4dxn2r8h5p337hn1vf444n-findutils-4.11.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"pip5q1b15n46rw6cbmz3jjk8mngqp7aw-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"qcz565439vz47snj3vky7rbdd4ihvxzl-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"svccn6gjnnbs350bfhgmwhm5mvh6n3n3-gcc-16.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"wcy0xsar1c27zdiz6mb6nwgiygar2k6h-bash-5.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"x2k1rx0682qi8q01svmay16q1c4glss2-bootstrap-coreutils-musl-9.11.drv":{"dynamicOutputs":{},"outputs":["out"]},"y2k52clja78ivjbsy5pjgskypmrjx9nz-gcc-wrapper-16.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"zgf0vd9gfdd8qbj1m8a0rdjrgsl6xmds-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["70acbfgbz5cxsx4sqzcnj8qaqhb4i9ay-bash-builder.sh"]},"name":"musl-1.2.6","outputs":{"out":{"path":"5ljagm084aar7yzakh5grrja44md9gd0-musl-1.2.6"}},"system":"x86_64-linux","version":4},"1ncwkv8v5ljsvs6iqccb1b1w3ckrjdjl-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/1fsaxrzl5qrycwbcgvs38sz86f07ymwd-b