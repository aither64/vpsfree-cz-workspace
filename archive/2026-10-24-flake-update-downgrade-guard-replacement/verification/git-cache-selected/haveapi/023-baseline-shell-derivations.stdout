/Makefile.in; do touch \"$f\" 2>/dev/null || true; done\nchmod +x configure config.guess config.sub install-sh missing compile \\\n  depcomp mkinstalldirs help2man 2>/dev/null || true\n[ -d build-aux ] && chmod +x build-aux/* 2>/dev/null || true\n\n# Configure\nexport CC=\"tcc -B /nix/store/armip90blbpwprlblj1phx0nnqj3xpvx-tinycc-mes-libs-unstable-2025-12-03/lib\"\nbash ./configure \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --disable-dependency-tracking \\\n  --disable-nls \\\n  --prefix=$out\n\n# Build\n# NOTE: parallel build (-j) breaks gnutar build under tcc-mes; keep serial.\nmake AR=\"tcc -ar\"\n\n# Install\nmake install\n","builder":"/nix/store/xi0dlxckix3dpwl5ap8j9148v9y5g3hq-bash-2.05b/bin/bash","name":"gnutar-1.12","out":"/nix/store/9i47y99mnryi9ldkalnpr0mp4iijqkwa-gnutar-1.12","passAsFile":"buildCommand","pname":"gnutar","system":"x86_64-linux","version":"1.12"},"inputs":{"drvs":{"05z44243pvwk3qrcimv1cf5g3nxi5jjb-bootstrap-coreutils-5.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"6f6p45qkd5mhdwvfzgxdydwdpplccvgj-bash-2.05b.drv":{"dynamicOutputs":{},"outputs":["out"]},"9d46md37a38ibk0zxjll9s58sfjf0jb6-tinycc-mes-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"agzpw52wkapzm6z6yjlmf5321gr7ngxd-gnused-mes-4.0.9.drv":{"dynamicOutputs":{},"outputs":["out"]},"mvwqinqcy1zjvb5zmhji91rjnmzh0fqf-tar-1.12.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"vix3mhga9d9pjgm0smc84w5608k8c7yb-gnumake-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"y0yxb5kxhvzffj19ggf3d7snxrc0xbjb-tinycc-mes-libs-unstable-2025-12-03.drv":{"dynamicOutputs":{},"outputs":["out"]},"yjp7zwabw9xcm6g42736mbhlvcddw410-mescc-tools-extra-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"zgf0vd9gfdd8qbj1m8a0rdjrgsl6xmds-gnugrep-2.4.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["9hvp9axa7zm732xi5jvg8pckvfk6ixcj-bash-builder.sh"]},"name":"gnutar-1.12","outputs":{"out":{"path":"9i47y99mnryi9ldkalnpr0mp4iijqkwa-gnutar-1.12"}},"sys