opy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/0bv6zcdnalbb65l78lfyg4iwhws3g1d2-code-page-0.2.1.tar.gz","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.2.1"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"7c5zvcdslbs1wppshrh6pbj8zlrrjd3q-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"gnb6c5bp3jn1s9g3n423bajc22rj7f06-glibc-locales-2.44-57.drv":{"dynamicOutputs":{},"outputs":["out"]},"iacsilvsa2kwqvj9k5dvz6h3gmsryp0g-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"m7bmd2qz1zcnk4k25y5cg6wbb3y9qwcb-coreutils-9.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"wlx9dx8l7la2awy6m6z9l6zwz5jhnqyr-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"xdrsvc2g7gy2b6bf1qryl1nkdwz5zqgm-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"y0xvksgdfijhrap739b9ysdr5bq0g5i4-code-page-0.2.1.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"ys38bpb9p9mhvbp37lrnxlda4q5hb2f3-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["4mdp8nhyfddh7bllbi7xszz7k9955n79-Setup.hs","907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"code-page-0.2.1","outputs":{"doc":{"path":"kfq8nmslxam16fn50lw7vbbyrmwdyq4r-code-page-0.2.1-doc"},"out":{"path":"7g6vxqb79ricppmg69mg783m180sqdnf-code-page-0.2.1"}},"system":"x86_64-linux","version":4},"fsbijg91n0vlxrkvf084n33x18nqsmsf-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/1fsaxrzl5qrycwbcgvs38sz86f07ymwd-builder.sh"],"builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","env":{"out":"/nix/store/9hjxhhgsg8nfw9i53dw0i52abhhwa8ff-source"},"inputs":{"drvs":{