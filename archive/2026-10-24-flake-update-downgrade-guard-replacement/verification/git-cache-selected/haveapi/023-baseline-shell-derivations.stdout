n-linux-gnu\ncp -r libiberty/ build-x86_64-unknown-linux-gnu/libiberty\n# Our custom hook; see common.nix.\nexport gccng_skip_target_lib_config=y\n\nexport CFLAGS=\"-O1\"\nexport CXXFLAGS=\"-O1\"\nexport LDFLAGS=\"-Wl,-rpath,/nix/store/7sg6rv7my7v2ylkxd7gr235jiaqxc6f9-mpc-1.3.1/lib,-rpath,/nix/store/hd9xbj8zjh4v5gzlhz05kfbfz3sski5k-mpfr-4.2.2/lib,-rpath,/nix/store/y7qsvr9irs3vwqbj3rm74ic8rvz7jfb3-gmp-6.3.0/lib,-rpath-link,/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib\"\nbash /nix/store/ysh32m514csj2nciyvgpyiz0srrmgb33-gcc-16.2.0-src/configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --target=x86_64-unknown-linux-gnu \\\n  --enable-fast-install \\\n  --disable-serial-configure \\\n  --disable-analyzer \\\n  --disable-dependency-tracking \\\n  --disable-bootstrap \\\n  --disable-decimal-float \\\n  --disable-gcov \\\n  --disable-install-libiberty \\\n  --disable-multilib \\\n  --disable-nls \\\n  --disable-libssp \\\n  --enable-default-pie \\\n  --enable-languages=c,c++ \\\n  --without-headers \\\n  --without-included-gettext \\\n  --enable-linker-build-id \\\n  --with-as=/nix/store/r04s6g51v2002prayd855xazjrsiszlb-binutils-2.47/bin/as \\\n  --with-ld=/nix/store/r04s6g51v2002prayd855xazjrsiszlb-binutils-2.47/bin/ld \\\n  --with-gnu-as \\\n  --with-gnu-ld \\\n  --with-sysroot=/ \\\n  --with-native-system-header-dir=/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/include \\\n  --with-mpfr=/nix/store/hd9xbj8zjh4v5gzlhz05kfbfz3sski5k-mpfr-4.2.2 \\\n  --with-gmp=/nix/store/y7qsvr9irs3vwqbj3rm74ic8rvz7jfb3-gmp-6.3.0 \\\n  --with-mpc=/nix/store/7sg6rv7my7v2ylkxd7gr235jiaqxc6f9-mpc-1.3.1 \\\n  --without-isl \\\n  --disable-plugin \\\n  --disable-plugins \\\n  --disable-lto\nsed -e '/TOPLEVEL_CONFIGURE_ARGUMENTS=/d' -i Makefile\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\nif [ -d \"$out/lib64\" ]; then\n  shopt -s dotglob\n  for lib in $out/lib64/*; do\n    mv --no-clobber \"$lib\" \"$out/lib/\"\n  done\n  shopt -u dotglob\n  rm -rf \"$out/lib64\"\n  ln -s lib \"$out/lib64\"\nfi\n\n# Prevent references to build-time dependencies\nrm -rf $out/libexec/gcc/*/*/install-tools\nrm -rf $out/lib/gcc/*/*/install-tools\n\n# libstdc++ gdb pretty-printers + man pages are unused downstream.\nrm -rf $out/share/gcc-*/python $out/share/man $out/share/info\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"gcc-16.2.0","out":"/nix/store/r1l0dsdrdpzyqyrbwv415fkbyqjbyh4m-gcc-16.2.0","passAsFile":"buildCommand","pname":"gcc","system":"x86_64-linux","version":"16.2.0"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"0dpycpy1hz7sccz9w6a9vc22zfzc17hd-xz-5.8.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"4gmgn8jwh044yvr7yvk1axwj2kw0jfjw-gcc-wrapper-10.4.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"5qsfr7wfv9fnbk79s85v1gs759r2rw78-gnutar-1.35.drv":{"dynamicOutputs":{},"outputs":["out"]},"6v8bjfwdcw75b9hv7gzl0jyfljdlc3vw-binutils-2.47.drv":{"dynamicOutputs":{},"outputs":["out"]},"8xy9yi1vwp0mc32lz37jgva7hck5j9by-gawk-5.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"aw4a7hi7q0mb2ljazxq0in9f5v4905a5-gnumake-musl-4.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"bjfpxb6q4p4dxn2r8h5p337hn1vf444n-findutils-4.11.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"fjq8rqpnghnycknww049ls6p5l1wzkjl-mpfr-4.2.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"izv72j73jmqmnjcnvk11fb8xhdsjrsky-gcc-16.2.0-src.drv":{"dynamicOutputs":{},"outputs":["out"]},"n655781g4wd5klgg5ifs3w48chldbap0-mpc-1.3.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"pip5q1b15n46rw6cbmz3jjk8mngqp7aw-gnused-4.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"qc0r09cxrav1j529k1rs36ym5562rnfj-libiberty-16.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"qcz565439vz47snj3vky7rbdd4ihvxzl-gzip-1.2.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"qjffi07dx2sbh63l939n8j0h8swnar6s-bzip2-1.0