9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/4gra0f3ynq5wwcsk3iqj9kl84k9zxj6y-doctest-parallel-0.4.1.tar.gz","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.4.1"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"3hgdq0vg4b3yp4rij2i01pqq88rhk5g4-ghc-exactprint-1.10.0.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"69l6ncn4v9z771iy4wdxvmav8cmw6bmd-unordered-containers-0.2.20.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"7c5zvcdslbs1wppshrh6pbj8zlrrjd3q-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"7qpd9qv15wdp7d8bvn68dbpq1aa4i8gz-silently-1.2.5.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"90dy76d1sfhi9l4hb4bgvikx0p7l9bga-stringbuilder-0.5.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"dfv9yb6mxz9myh2g37gd8ynn7fbbzqiy-HUnit-1.6.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"dz0r76vh4sggsc4nrlc182qn3gr0z2jy-mockery-0.3.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"ff9784lxn10wqk3r2bg8vyij60a7vgbi-hspec-2.11.17.drv":{"dynamicOutputs":{},"outputs":["out"]},"frxmhq0rsj2sk70kwycxyhyrhqckiy7j-code-page-0.2.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"gnb6c5bp3jn1s9g3n423bajc22rj7f06-glibc-locales-2.44-57.drv":{"dynamicOutputs":{},"outputs":["out"]},"gq8bz3mkh0mm3j66nznbva2rxy4pjscw-ghc-paths-0.1.0.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"gsb708xridfi3bpca44zi2mvajx5k0cg-Glo