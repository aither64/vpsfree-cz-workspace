ble-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --enable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/9kjpqdkg512vvsjnyp33vacmgb3zlszs-Glob-0.10.2.tar.gz","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.10.2"},"inputs":{"drvs":{"1d4qsb2vxispwbqsn152haw1sk5aynii-test-framework-hunit-0.3.0.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"7c5zvcdslbs1wppshrh6pbj8zlrrjd3q-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"bqfv3c3dqgdwvih8ljbybgcsw5pqbg3w-Glob-0.10.2.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"dfv9yb6mxz9myh2g37gd8ynn7fbbzqiy-HUnit-1.6.2.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"fhcl9np953xh65qrqsmbwhi2wzyzni1b-transformers-compat-0.7.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"gnb6c5bp3jn1s9g3n423bajc22rj7f06-glibc-locales-2.44-57.drv":{"dynamicOutputs":{},"outputs":["out"]},"h1737kr070byhl6zapqdplfq0nay88hq-test-framework-0.8.2.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"iacsilvsa2kwqvj9k5dvz6h3gmsryp0g-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"l9yfcj636396gsjfcliq2j17gzrhdygy-Glob-0.10.2-r3.cabal.drv":{"dynamicOutputs":{},"outputs":["out"]},"m7bmd2qz1zcnk4k25y5cg6wbb3y9qwcb-coreutils-9.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"s4fw7zy1xkhji75dnx7wnqp6f1i4yfxj-Q