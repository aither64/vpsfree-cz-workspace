ion-testing-0.6.3.conf\"\nmkdir -p \"$packageConfDir\"\n./Setup register --gen-pkg-config=$packageConfFile\nif [ -d \"$packageConfFile\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\nfor x in $doc/share/doc/inspection-testing-0.6.3\"/html/src/\"*.html; do\n  remove-references-to -t $out $x\ndone\nmkdir -p $doc\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"inspection-testing-0.6.3","nativeBuildInputs":"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3 /nix/store/595sskhzrrlc9hiqqi60c42wld9fwl4m-remove-references-to","out":"/nix/store/6z51vmn85hdcwl2pidzq3l1zvw2dja0w-inspection-testing-0.6.3","outputs":"out doc","patches":"","pname":"inspection-testing","postPatch":"","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"  /nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3  ","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3.\"\nexport PATH=/nix/store/fp2wsxdpbg13anc4jv0cfmmi7f3ahjy2-hscolour-1.25/bin:$PATH\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname  --docdir=$doc/share/doc/inspection-testing-0.6.3 --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --enable-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --enable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/747aj3l9dzkwncryxf6mpzdszh0h2gbc-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/1caxwp1sprkbkascg58016ci2qgcs6nw-inspection-testing-0.6.3.tar.gz","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.6.3"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"5cxaqqx4sk6nvhwidgpl5fjnnqpr2l78-inspection-testing-0.6.3.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"7c5zvcdslbs1wppshrh6pbj8zlrrjd3q-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"gnb6c5bp3jn1s9g3n423bajc22rj7f06-glibc-locales-2.44-57.drv":{"dynamicOutputs":{},"outputs":["out"]},"iacsilvsa2kwqvj9k5dvz6h3gmsryp0g-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"m7bmd2qz1zcnk4k25y5cg6wbb3y9qwcb-coreutils-9.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"wlx9dx8l7la2awy6m6z9l6zwz5jhnqyr-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"xdrsvc2g7gy2b6bf1qryl1nkdwz5zqgm-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"ys38bpb9p9mhvbp37lrnxlda4q5hb2f3-hscolour-1.25.drv":{"dynamicO