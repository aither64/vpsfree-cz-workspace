fix-x64-abi.patch","f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch","jzyh2wkk6dvv1rxj2skhly6izqsaf6im-nix-nss-open-files.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch","mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch","pyrilqws1mgmdh6x5i3aj1c1xa53hb6r-nix-locale-archive.patch","q04sk7l470q1l77mdd5l6j8h63rk5k69-2.44-master.patch","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch","ywdz7fsdiff19745v59snscar3qsgd79-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch"]},"name":"glibc-locales-2.44-57","outputs":{"out":{"path":"nm27mwa8p91s2j0i8d34n9i72nvxmxwk-glibc-locales-2.44-57"}},"structuredAttrs":{"BASH_SHELL":"/bin/sh","LOCALEDEF_FLAGS":"--little-endian","NIX_NO_SELF_RPATH":1,"buildInputs":["/nix/store/wf7d501qlfynh45147y25g9kww9z0a09-linux-headers-7.2"],"builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","cmakeFlags":[],"configureFlags":["-C","--enable-add-ons","--sysconfdir=/etc","--enable-stack-protector=strong","--enable-bind-now","--without-headers","--disable-profile","--enable-fortify-source","--enable-static-pie"],"depsBuildBuild":["/nix/store/r5ri78axx1qggkjq3vawywlzglg70b5w-gcc-wrapper-16.2.0"],"depsBuildBuildPropagated":[],"depsBuildTarget":[],"depsBuildTargetPropagated":[],"depsHostHost":[],"depsHostHostPropagated":[],"depsTargetTarget":[],"depsTargetTargetPropagated":[],"doCheck":false,"doInstallCheck":false,"enableParallelBuilding":true,"enableParallelChecking":true,"enableParallelInstalling":true,"env":{"BASH_SHELL":"/bin/sh","LOCALEDEF_FLAGS":"--little-endian","NIX_NO_SELF_RPATH":1,"is64bit":true,"linuxHeaders":""},"extraNativeBuildInputs":["/nix/store/pqyiidz5mi73wv5f91d48s9plcqyj5bz-glibc-2.44-57"],"installFlags":["sysconfdir=$(out)/etc"],"installPhase":"mkdir -p \"$out/lib/locale\" \"$out/share/i18n\"\ncp -v \"$TMPDIR/$NIX_STORE/\"*\"/lib/locale/locale-archive\" \"$out/lib/locale\"\ncp -v ../localedata/SUPPORTED \"$out/share/i18n/SUPPORTED\"\n","is64bit":true,"linuxHeaders":"","makeFlags":["OBJCOPY=objcopy","zonedir=/usr/share/zoneinfo","BUILD_LDFLAGS=-Wl,-rpath,/nix/store/pqyiidz5mi73wv5f91d48s9plcqyj5bz-glibc-2.44-57/lib","OBJDUMP=/nix/store/y6ri2r743ckh5kk160r461czl9n2f2wf-binutils-2.46/bin/objdump","localedata/install-locales","localedir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/locale"],"mesonFlags":[],"name":"glibc-locales-2.44-57","nativeBuildInputs":["/nix/store/nilcmqdvnpv02v3n63rwnr7pl1zhbgm7-bison-3.8.2","/nix/store/8qdw9shgr7dd3315jim8sfva2dnhq86c-gettext-1.0","/nix/store/wgyapl0fph0y5yljvjqfnm07f5hrkwxn-python3-minimal-3.14.8","/nix/store/3zlgjcfm8j3nscrldjv8izxciybg0nh3-glibc-2.44-57-dev"],"outputChecks":{"out":{}},"outputs":["out"],"patches":["/nix/store/q04sk7l470q1l77mdd5l6j8h63rk5k69-2.44-master.patch","/nix/store/pyrilqws1mgmdh6x5i3aj1c1xa53hb6r-nix-locale-archive.patch","/nix/store/43lp683anlywwy1m6rv0mrw9m2iv681q-dont-use-system-ld-so-cache.patch","/nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch","/nix/store/llr530f1l6c470xkl2w80k2kkfqddmpm-fix_path_attribute_in_getconf.patch","/nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch","/nix/store/jzyh2wkk6dvv1rxj2skhly6izqsaf6im-nix-nss-open-files.patch","/nix/store/ywdz7fsdiff19745v59snscar3qsgd79-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch","/nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch","/nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch","/nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch"],"pname":"glibc-locales","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n","postInstall":"moveToOutput bin/getent $getent\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/00fs4zz9c0jjcvs62wg39b91dydz7zqb-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\n","preBuild":"# Awful hack: `localedef' doesn't allow the path to `locale-archive'\n# to be overriden, but you *can* specify a prefix, i.e. it will use\n# <prefix>/<path-to-glibc>/lib/locale/locale-archive.  So we use\n# $TMPDIR as a prefix, meaning that the locale-archive is placed in\n# $TMPDIR/nix/store/...-glibc-.../lib/locale/locale-archive.\nLOCALEDEF_FLAGS+=\" --prefix=$TMPDIR\"\n\nexport inst_complocaledir=\"$TMPDIR/\"/nix/store/pqyiidz5mi73wv5f91d48s9plcqyj5bz-glibc-2.44-57/lib/locale\nmkdir -p \"$inst_complocaledir\"\n\necho 'C.UTF-8/UTF-8 \\' >> ../localedata/SUPPORTED\n\n# Hack to allow building of the locales (needed since glibc-2.12)\nsubstituteInPlace ../localedata/Makefile \\\n  --replace-fail '$(rtld-prefix) $(common-objpfx)locale/localedef' 'localedef $(LOCALEDEF_FLAGS)'\n# Check that all locales to be built are supported\necho -n 'en_US.UTF-8/UTF-8 \\\n' \\\n  | sort -u > locales-to-build.txt\ncat ../localedata/SUPPORTED | grep ' \\\\' \\\n  | sort -u > locales-supported.txt\ncomm -13 locales-supported.txt locales-to-build.txt \\\n  > locales-unsupported.txt\nif [[ $(wc -c locales-unsupported.txt) != \"0 locales-unsupported.txt\" ]]; then\n  cat locales-supported.txt\n  echo \"Error: unsupported locales detected:\"\n  cat locales-unsupported.txt\n  echo \"You should choose from the list above the error.\"\n  false\nfi\n\necho SUPPORTED-LOCALES='en_US.UTF-8/UTF-8' > ../localedata/SUPPORTED\n","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir build\ncd build\n\nconfigureScript=\"`pwd`/../configure\"\n","propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"setupHook":"/nix/store/4gxwl140lzs727yg0b9mzjw72y2rr1mx-locales-setup-hook.sh","src":"/nix/store/jq00nlpdcxgcj5xwx25jibn61a611234-glibc-2.44.tar.xz","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":true,"system":"x86_64-linux","version":"2.44-57"},"system":"x86_64-linux","version":4},"dc7nildrb4kg6bprdjqqfydkpc8h4374-php-opcache-8.3.35.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","env":{"__structuredAttrs":"","buildInputs":"/nix/store/ir81clyh96ribjk07srpwbp8igwd0lr2-pcre2-10.49-dev /nix/store/jj22y7syjhkxrphhfbn9h8yx7jnivri9-valgrind-3.27.1-dev","builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","cdToExtensionRootPhase":"# Go to extension source root.\ncd \"ext/opcache\"\n","checkPhase":"runHook preCheck\n\nNO_INTERACTION=yes SKIP_PERF_SENSITIVE=yes SKIP_ONLINE_TESTS=yes make test\nrunHook postCheck\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHos