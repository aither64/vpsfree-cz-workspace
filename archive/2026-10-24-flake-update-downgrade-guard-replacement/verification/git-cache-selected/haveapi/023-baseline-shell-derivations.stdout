S_testpypi","NIX_MIRRORS_texhistoric","NIX_MIRRORS_ubuntu","NIX_MIRRORS_xfce","NIX_MIRRORS_xorg"],"mesonFlags":[],"mirrorsListFile":"/nix/store/808pz59rm1qby6rnhg8jkgiwqjc1bl7a-mirrors-list","name":"ftobjs-formatting.patch","nativeBuildInputs":["/nix/store/mxsppj348yslmh2qx0mv6klymh9q9v3d-curl-8.22.0-dev","/nix/store/mc59d2ll732xrca8dsjhk3qba0mlkv99-patchutils-0.3.3"],"nixpkgsVersion":"26.11","outputChecks":{"out":{}},"outputHash":"sha256-govOzLBzQMAjSKABVFryDnSn2by2f/W9BgGG3o+qSuE=","outputHashMode":"flat","outputs":["out"],"patches":[],"postFetch":"tmpfile=\"$TMPDIR/patch\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Fetched patch file '$out' is empty!\" 1>&2\n  exit 1\nfi\n\nset +e\ncat < \"$out\" > \"$tmpfile\"\nif [ $? -ne 0 ] || [ ! -s \"$tmpfile\" ]; then\n    echo 'Failed to decode patch with command \"'cat'\"' >&2\n    echo 'Fetched file was (limited to 128 bytes):' >&2\n    od -A x -t x1z -v -N 128 \"$out\" >&2\n    exit 1\nfi\nset -e\nmv \"$tmpfile\" \"$out\"\n\nlsdiff \\\n   \\\n  \"$out\" \\\n| sort -u | sed -e 's/[*?]/\\\\&/g' \\\n| xargs -I{} --delimiter='\\n' \\\n  filterdiff \\\n  --include={} \\\n  --strip=0 \\\n   \\\n  --clean \"$out\" > \"$tmpfile\"\n\nif [ ! -s \"$tmpfile\" ]; then\n  echo \"error: Normalized patch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc","strictDeps":true,"system":"x86_64-linux","urls":["https://gitlab.freedesktop.org/freetype/freetype/-/commit/590b77014bd920d0bdf64c039fddbce89a288b83.patch"]},"system":"x86_64-linux","version":4},"f9pf89jwwyynby5nhpbx1qmzf296lcxg-pythoncheck.sh.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","env":{"NIX_MAIN_PROGRAM":"pythoncheck.sh","__structuredAttrs":"","allowSubstitutes":"","buildCommand":"# On darwin a script cannot be used as an interpreter in a shebang but\n# there doesn't seem to be a limit to the size of shebang and multiple\n# arguments to the interpreter are allowed.\nif [[ -n \"\" ]] && isScript $interpreter\nthen\n  wrapperInterpreterLine=$(head -1 \"$interpreter\" | tail -c+3)\n  # Get first word from the line (note: xargs echo remove leading spaces)\n  wrapperInterpreter=$(echo \"$wrapperInterpreterLine\" | xargs echo | cut -d \" \" -f1)\n\n  if isScript $wrapperInterpreter\n  then\n    echo \"error: passed interpreter ($interpreter) is a script which has another script ($wrapperInterpreter) as an interpreter, which is not supported.\"\n    exit 1\n  fi\n\n  # This should work as long as wrapperInterpreter is a shell, which is\n  # the case for programs wrapped with makeWrapper, like\n  # python3.withPackages etc.\n  interpreterLine=\"$wrapperInterpreterLine $interpreter\"\nelse\n  interpreterLine=$interpreter\nfi\n\necho \"#! $interpreterLine\" > $out\ncat \"$contentPath\" >> $out\n/nix/store/91a26w6xq3mlfr624xv63gprl2408mqp-dash-0.5.13.5/bin/dash -n $out\n\nchmod +x $out\n\n# Relocate executable\n# Wrap it if makeWrapperArgs are specified\nmv $out tmp\n  mkdir -p $out/$(dirname \"/bin/pythoncheck.sh\")\n  mv tmp $out//bin/pythoncheck.sh\nif [ -n \"${makeWrapperArgs+${makeWrapperArgs[@]}}\" ]; then\n    wrapProgram $out//bin/pythoncheck.sh ${makeWrapperArgs[@]}\nfi\n","buildInputs":"","builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","cmakeFlags":"","configureFlags":"","content":"exec /nix/store/5x5kd7vkdn90bxigz7abdqp2yl2zkmhr-python3.14-flake8-7.3.0/bin/flake8 --show-source --ignore E501 \"$1\"\n","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","interpreter":"/nix/store/91a26w6xq3mlfr624xv63gprl2408mqp-dash-0.5.13.5/bin/dash","makeWrapperArgs":"","mesonFlags":"","name":"pythoncheck.sh","nativeBuildInputs":"/nix/store/wsmmw9pf0gd3a4r1hygr1xm71k10mqbb-make-binary-wrapper-hook","out":"/nix/store/s5bpw10x29jnglcm696dc2nja1vgwycp-pythoncheck.sh","outputs":"out","passAsFile":"buildCommand content","patches":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","stdenv":"/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"3xns94ddxa2jlvb06awbmjviflf0k0fl-dash-0.5.13.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"jrjq3n2gpgq6sn07iiymh8ivf19ahncm-stdenv-linux-no-cc.drv":{"dynamicOutputs":{},"outputs":["out"]},"vg2yqik90dgl8dvyx73c07bi5pf9kz0r-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"wnhzdhjwcy57v76alsmfy7fvi3gyd9a7-python3.14-flake8-7.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"pythoncheck.sh","outputs":{"out":{"path":"s5bpw10x29jnglcm696dc2nja1vgwycp-pythoncheck.sh"}},"system":"x86_64-linux","version":4},"fabkvz1519wvag1g2w7qrj2hh0lfvxlg-indexed-traversable-0.1.4.tar.gz.d