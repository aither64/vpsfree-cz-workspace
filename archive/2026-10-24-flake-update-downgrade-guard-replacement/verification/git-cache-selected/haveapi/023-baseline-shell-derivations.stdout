e fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":false,"preferLocalBuild":true,"propagatedBuildInputs":[],"propagatedNativeBuildInputs":[],"showURLs":false,"stdenv":"/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc","strictDeps":true,"system":"x86_64-linux","urls":["https://github.com/sqlalchemy/mako/commit/411b4ac6cf054e61a8fb44c236990fda1e41ade4.patch?full_index=1"]},"system":"x86_64-linux","version":4},"8535vxp9rsjhbf6vib9s5pq3lyvc93fx-automake-1.18.1.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","env":{"out":"/nix/store/vxsb4wclj2223z350hzy9qxvq37fn8vx-automake-1.18.1"},"inputs":{"drvs":{"115s3aa76a4j1k2kfqb21vwyri4s0fdr-update-autotools-gnu-config-scripts-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"82czysdbwzzvcrdfq1y9q9y4fv5kgy73-autoconf-2.73.drv":{"dynamicOutputs":{},"outputs":["out"]},"ixzq8h3mrcqhc3hi24y8j8s3hab16nfl-automake-1.18.1.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"xdrsvc2g7gy2b6bf1qryl1nkdwz5zqgm-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"zb8xqbkiccrldiqg6xaiicvfb4y1jj5h-perl-5.42.3.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["4cmjzk8yr6i5vls5d2050p653zzdvmvp-setup-hook.sh","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","s