/store/x1j4kyqq4x7lqrjnif1mkdqr06blr3i4-mpc-1.0.3.tar.gz\ncd gcc-4.6.4\n\nln -s ../gmp-4.3.2 gmp\nln -s ../mpfr-2.4.2 mpfr\nln -s ../mpc-1.0.3 mpc\n\n# Patch\npatch -Np1 -i /nix/store/7bqlyrbj1r9ddcmm825g9zzhrgwxy9fw-no-system-headers.patch\n# doesn't recognise musl\nsed -i 's|\"os/gnu-linux\"|\"os/generic\"|' libstdc++-v3/configure.host\n\n# Configure\nexport CC=\"gcc -Wl,-dynamic-linker -Wl,/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib/libc.so\"\nexport CFLAGS=\"-O1\"\nexport CXXFLAGS=\"-O1\"\nexport CFLAGS_FOR_TARGET=\"-O0 -Wl,-dynamic-linker -Wl,/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib/libc.so\"\nexport CXXFLAGS_FOR_TARGET=\"$CFLAGS_FOR_TARGET\"\nexport C_INCLUDE_PATH=\"/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/include\"\nexport CPLUS_INCLUDE_PATH=\"$C_INCLUDE_PATH\"\nexport LIBRARY_PATH=\"/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/lib\"\n\nbash ./configure \\\n  --prefix=$out \\\n  --build=x86_64-unknown-linux-gnu \\\n  --host=x86_64-unknown-linux-gnu \\\n  --with-native-system-header-dir=/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6/include \\\n  --with-build-sysroot=/nix/store/90nc0wkxyrl9p53ang05qcb52lv0zbzp-musl-1.2.6 \\\n  --enable-languages=c,c++ \\\n  --enable-checking=release \\\n  --disable-bootstrap \\\n  --disable-dependency-tracking \\\n  --disable-libgomp \\\n  --disable-libmudflap \\\n  --disable-libquadmath \\\n  --disable-libssp \\\n  --disable-libstdcxx-pch \\\n  --disable-lto \\\n  --disable-multilib \\\n  --disable-nls \\\n  --disable-libsanitizer \\\n  --disable-shared\n\n# Build\nmake -j $NIX_BUILD_CORES\n\n# Install\nmake -j $NIX_BUILD_CORES install-strip\n","builder":"/nix/store/2lgm4lkhnszawf9p3z1hpzzayczhv0ns-bash-5.3/bin/bash","name":"gcc-cxx-4.6.4","out":"/nix/store/rallc5g097f59id8rn7y879j6r6ycvhj-gcc-cxx-4.6.4","passAsFile":"buildCommand","pname":"gcc-cxx","system":"x86_64-linux","version":"4.6.4"},"inputs":{"drvs":{"0brypcsmz7160dyfdfnnnqbfmp8lvfy4-diffutils-3.8.drv":