jpm42vipw92pr73vdgl6xs1hycac8kf2n9/share/dbus-1 --enable-libusb --enable-ssl --enable-avahi --enable-libpaper --build=x86_64-unknown-linux-gnu --host=x86_64-unknown-linux-gnu","configurePlatforms":"build host","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/m20r338px24fcwp0l1zxxrisy9c00hv5-cups-2.4.16-dev","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","installFlags":"CACHEDIR=$(TMPDIR)/dummy LAUNCHD_DIR=$(TMPDIR)/dummy LOGDIR=$(TMPDIR)/dummy REQUESTS=$(TMPDIR)/dummy STATEDIR=$(TMPDIR)/dummy PAMDIR=$(out)/etc/pam.d XINETD=$(out)/etc/xinetd.d SERVERROOT=$(out)/etc/cups MENUDIR=$(out)/share/applications ICONDIR=$(out)/share/icons CUPS_PRIMARY_SYSTEM_GROUP=root","lib":"/nix/store/7nbs867m8jh5r7n02q0l767cm0809kky-cups-2.4.16-lib","man":"/nix/store/815i96gardc8l7b9pl8vh3k9m3g2hsz7-cups-2.4.16-man","mesonFlags":"","name":"cups-2.4.16","nativeBuildInputs":"/nix/store/i7s4dyaj2qz5bczzycybq850pj4iygim-pkg-config-wrapper-0.29.2 /nix/store/j2c51aym9mdv6h4kmxm0r5syldrcyxl7-remove-references-to","out":"/nix/store/rn0pfh5mysxcib880gzkdr13vbdyvr4p-cups-2.4.16","outputs":"out lib dev man","patches":"","pname":"cups","postInstall":"libexec=lib/cups\nmoveToOutput $libexec \"$out\"\n\n# $lib contains references to $out/share/cups.\n# CUPS is working without them, so they are not vital.\nfind \"$lib\" -type f -exec grep -q \"$out\" {} \\; \\\n     -printf \"removing references from %p\\n\" \\\n     -exec remove-references-to -t \"$out\" {} +\n\n# Delete obsolete stuff that conflicts with cups-filters.\nrm -rf $out/share/cups/banners $out/share/cups/data/testprint\n\nmoveToOutput bin/cups-config \"$dev\"\nsed -e \"/^cups_serverbin=/s|$lib|$out|\" \\\n    -i \"$dev/bin/cups-config\"\n\nfor f in \"$out\"/lib/systemd/system/*; do\n  substituteInPlace \"$f\" --replace \"$lib/$libexec\" \"$out/$libexec\"\ndone\n# Use xdg-open when on Linux\nsubstituteInPlace \"$out\"/share/applications/cups.desktop \\\n  --replace \"Exec=htmlview\" \"Exec=xdg-open\"\n","postPatch":"substituteInPlace cups/testfile.c \\\n  --replace 'cupsFileFind(\"cat\", \"/bin' 'cupsFileFind(\"cat\", \"/nix/store/vzx1mi9c0xfadmsm9dhd83d005cb1qs9-coreutils-9.8/bin'\n\n  # The cups.socket unit shouldn't be part of cups.service: stopping the\n  # service would stop the socket and break subsequent socket activations.\n  # See https://github.com/apple/cups/issues/6005\n  sed -i '/PartOf=cups.service/d' scheduler/cups.socket.in\n","preConfigure":"export AR=\"/nix/store/i839kg98izahkn1iq17sn3wliliic7pm-binutils-2.44/bin/ar\"\nconfigureFlagsArray+=(\n  # Put just lib/* and locale into $lib; this didn't work directly.\n  # lib/cups is moved back to $out in postInstall.\n  # Beware: some parts of cups probably don't fully respect these.\n  \"--prefix=$lib\"\n  \"--datadir=$out/share\"\n  \"--localedir=$lib/share/locale\"\n\n  \"--with-systemd=$out/lib/systemd/system\"\n\n  \n)\n","propagatedBuildInputs":"/nix/store/dqarabcsdicl10xs7gk49nwji2i81fb3-gmp-with-cxx-6.3.0-dev","propagatedNativeBuildInputs":"","src":"/nix/store/r50fk7n599pbac88ypv5ff2ig9kbywyg-cups-2.4.16-source.tar.gz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"2.4.16"},"inputs":{"drvs":{"0vgf8xan18x19ikjnwdg3pa7bdi30g7y-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"1vgcp8qgq7zgra8sc5kjza6hm39mnij8-gnutls-3.8.12.drv":{"dynamicOutputs":{},"outputs":["dev"]},"3qvf3cp13kl2lsj8x18kz06k4bp3fpxj-libusb-1.0.29.drv":{"dynamicOutputs":{},"outputs":["dev"]},"52x281q6hpf3jya35i852qajdf59phf5-avahi-0.8.drv":{"dynamicOutputs":{},"outputs":["dev"]},"63jd5y5wy6p6l7jcbakwj55040790q5x-binutils-2.44.drv":{"dynamicOutputs":{},"outputs":["out"]},"abcdrf7cl0lnwhmandinvb2lx6dz4mzp-libpng-apng-1.6.55.drv":{"dynamic