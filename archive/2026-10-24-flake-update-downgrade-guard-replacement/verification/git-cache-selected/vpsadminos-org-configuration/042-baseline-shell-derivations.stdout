ch '$tmpfile' is empty (while the fetched file was not)!\" 1>&2\n  echo \"Did you maybe fetch a HTML representation of a patch instead of a raw patch?\" 1>&2\n  echo \"Fetched file was:\" 1>&2\n  cat \"$out\" 1>&2\n  exit 1\nfi\n\nfilterdiff \\\n  -p1 \\\n   \\\n   \\\n   \\\n  \"$tmpfile\" > \"$out\"\n\nif [ ! -s \"$out\" ]; then\n  echo \"error: Filtered patch '$out' is empty (while the original patch file was not)!\" 1>&2\n  echo \"Check your includes and excludes.\" 1>&2\n  echo \"Normalized patch file was:\" 1>&2\n  cat \"$tmpfile\" 1>&2\n  exit 1\nfi\n","preferHashedMirrors":"","preferLocalBuild":"1","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","showURLs":"","stdenv":"/nix/store/n84bgxb2qxhfph1ria0xxlhjhpg48740-stdenv-linux","strictDeps":"","system":"x86_64-linux","urls":"https://git.kernel.org/pub/scm/utils/kernel/kmod/kmod.git/patch/?id=11eb9bc67c319900ab00523997323a97d2d08ad2"},"inputs":{"drvs":{"250jpdy8ii986n2l5cm6ccw93kyr2967-mirrors-list.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"ksfcnil7yjc8rfgfy71ygjhp1z5knxim-curl-8.19.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"s8ldl64hd0y1ccsg1yzqn5fyyrgp10b6-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"x1kjg2g78hgr8s5zc7ls9308xgqbn5mk-patchutils-0.3.3.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","w003xwysww5hwn4a759kji6s3157xmrc-builder.sh"]},"name":"musl.patch","outputs":{"out":{"hash":"sha256-CYG615elMWces6QGQRg2H/NL7W4XsG9Zvz5H+xsdFFo=","method":"flat"}},"system":"x86_64-linux","version":4},"1i3xs4gfs2aq19nl02fqcybswydkb0gk-kmod-31.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","env":{"__structuredAttrs":"","buildInputs":"/nix/store/s6q3ij6mwn29zzqm0qkj5