ay=(\n    ${enableParallelBuilding:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray buildFlags buildFlagsArray\nechoCmd 'build flags' \"${flagsArray[@]}\"\n# Need to build the main Git documentation before building the\n# contrib/subtree documentation, as the latter depends on the\n# asciidoc.conf file created by the former.\nmake -C Documentation PERL_PATH=/nix/store/x17gg3w7lcwiqscqmif25688sivchwsn-perl-5.40.0/bin/perl \"${flagsArray[@]}\"\nmake -C contrib/subtree \"${flagsArray[@]}\" all doc\nmake -C contrib/diff-highlight \"${flagsArray[@]}\"\nunset flagsArray\n","postInstall":"# Set up the flags array for make in the same way as for the main install\n# phase from stdenv.\nlocal flagsArray=(\n    ${enableParallelInstalling:+-j${NIX_BUILD_CORES}}\n    SHELL=\"$SHELL\"\n)\nconcatTo flagsArray makeFlags makeFlagsArray installFlags installFlagsArray\nechoCmd 'install flags' \"${flagsArray[@]}\"\n\n# Install git-subtree.\nmake -C contrib/subtree \"${flagsArray[@]}\" install install-doc\nrm -rf contrib/subtree\n\n# Install contrib stuff.\nmkdir -p $out/share/git\ncp -a contrib $out/share/git/\nmkdir -p $out/share/bash-completion/completions\nln -s $out/share/git/contrib/completion/git-prompt.sh $out/share/bash-completion/completions/\n\n# grep is a runtime dependency, need to patch so that it's found\nsubstituteInPlace $out/libexec/git-core/git-sh-setup \\\n    --replace ' grep' ' /nix/store/ph2lki556zck2g99ngzy2f451ly9pvy4-gnugrep-3.12/bin/grep' \\\n    --replace ' egrep' ' /nix/store/ph2lki556zck2g99ngzy2f451ly9pvy4-gnugrep-3.12/bin/egrep'\n\n# Fix references to the perl, sed, awk and various coreutil binaries used by\n# shell scripts that git calls (e.g. filter-branch)\nSCRIPT=\"$(cat <<'EOS'\n  BEGIN{\n    @a=(\n      '/nix/store/ph2lki556zck2g99ngzy2f451ly9pvy4-gnugrep-3.12/bin/grep', '/nix/store/cajg449qn174z6lckd5nl3f6j4qf0j6h-gnused-4.9/bin/sed', '/nix/store/warr9dcy6aw1hhgzccadq6ldvmjnn10k-gawk-5.3.2/bin/awk',\n      '/nix/store/vzx1mi9c0xfadmsm9dhd83d005cb1qs9-coreutils-9.8/bin/cut', '/nix/store/vzx1mi9c0xfadmsm9dhd83d005cb1qs9-coreutils-9.8/bin/basename', '/nix/store/vzx1mi9c0xfadmsm9dhd83d005cb1qs9-coreutils-9.8/bin/dirname',\n      '/nix/store/vzx1mi9c0xfadmsm9dhd83d005cb1qs9-coreutils-9.8/bin/wc', '/nix/store/vzx1mi9c0xfadmsm9dhd83d005cb1qs9-coreutils-9.8/bin/tr'\n      , '/nix/store/x17gg3w7lcwiqscqmif25688sivchwsn-perl-5.40.0/bin/perl'\n    );\n  }\n  foreach $c (@a) {\n    $n=(split(\"/\", $c))[-1];\n    s|(?<=[^#][^/.-])\\b${n}(?=\\s)|${c}|g\n  }\nEOS\n)\"\nperl -0777 -i -pe \"$SCRIPT\" \\\n  $out/libexec/git-core/git-{sh-setup,filter-branch,merge-octopus,mergetool,quiltimport,request-pull,submodule,subtree,web--browse}\n\n\n# Also put git-http-backend into $PATH, so that we can use smart\n# HTTP(s) transports for pushing\nln -s $out/libexec/git-core/git-http-backend $out/bin/git-http-backend\nln -s $out/share/git/contrib/git-jump/git-jump $out/bin/git-jump\n# wrap perl commands\nmakeWrapper \"$out/share/git/contrib/credential/netrc/git-credential-netrc.perl\" $out/libexec/git-core/git-credential-netrc \\\n            --set PERL5LIB   \"$out/lib/perl5/site_perl:/nix/store/201vdyj63whfpdxscmy034ff0dwprhqm-perl5.40.0-libwww-perl-6.72/lib/perl5/site_perl:/nix/store/r0b6g4wjnpwv0sj5ynp9y5v1ma1njgl0-perl5.40.0-URI-5.21/lib/perl5/site_perl:/nix/store/ss145r3rrla7jl8a3w8c7liy8arha484-perl5.40.0-TermReadKey-2.38/lib/perl5/site_perl\"\n# ideally unneeded, but added for backwards compatibility\nln -s $out/libexec/git-core/git-credential-netrc $out/bin/\n\nwrapProgram $out/libexec/git-core/git-cvsimport \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/201vdyj63whfpdxscmy034ff0dwprhqm-perl5.40.0-libwww-perl-6.72/lib/perl5/site_perl:/nix/store/r0b6g4wjnpwv0sj5ynp9y5v1ma1njgl0-perl5.40.0-URI-5.21/lib/perl5/site_perl:/nix/store/ss145r3rrla7jl8a3w8c7liy8arha484-perl5.40.0-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-archimport \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/201vdyj63whfpdxscmy034ff0dwprhqm-perl5.40.0-libwww-perl-6.72/lib/perl5/site_perl:/nix/store/r0b6g4wjnpwv0sj5ynp9y5v1ma1njgl0-perl5.40.0-URI-5.21/lib/perl5/site_perl:/nix/store/ss145r3rrla7jl8a3w8c7liy8arha484-perl5.40.0-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-instaweb \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/201vdyj63whfpdxscmy034ff0dwprhqm-perl5.40.0-libwww-perl-6.72/lib/perl5/site_perl:/nix/store/r0b6g4wjnpwv0sj5ynp9y5v1ma1njgl0-perl5.40.0-URI-5.21/lib/perl5/site_perl:/nix/store/ss145r3rrla7jl8a3w8c7liy8arha484-perl5.40.0-TermReadKey-2.38/lib/perl5/site_perl\"\nwrapProgram $out/libexec/git-core/git-cvsexportcommit \\\n            --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/201vdyj63whfpdxscmy034ff0dwprhqm-perl5.40.0-libwww-perl-6.72/lib/perl5/site_perl:/nix/store/r0b6g4wjnpwv0sj5ynp9y5v1ma1njgl0-perl5.40.0-URI-5.21/lib/perl5/site_perl:/nix/store/ss145r3rrla7jl8a3w8c7liy8arha484-perl5.40.0-TermReadKey-2.38/lib/perl5/site_perl\"\n\n# gzip (and optionally bzip2, xz, zip) are runtime dependencies for\n# gitweb.cgi, need to patch so that it's found\nsed -i -e \"s|'compressor' => \\['gzip'|'compressor' => ['/nix/store/dv49sc8jjw07mp9ns7m2m63dl96r1j84-gzip-1.14/bin/gzip'|\" \\\n    $out/share/gitweb/gitweb.cgi\n# Give access to CGI.pm and friends (was removed from perl core in 5.22)\nfor p in /nix/store/gh5rgi51yjkcm2qamaqy067z8s00hsxj-perl5.40.0-CGI-4.59 /nix/store/hfn8hkq16ch3hsbvf6xr5cwkbbjy0k03-perl5.40.0-HTML-Parser-3.81 /nix/store/2i2fa5b8bpmi3s6638qvnmdnggcza3dv-perl5.40.0-CGI-Fast-2.16 /nix/store/6v9jx3m7lgck049zq3mx31v99kwzfabw-perl5.40.0-FCGI-0.82 /nix/store/3vxwag3qdxw55lx06l82jbnip1igp6mi-perl5.40.0-FCGI-ProcManager-0.28 /nix/store/vkq8pdxqpg122k4i40jhr1737pnl0mgx-perl5.40.0-HTML-TagCloud-0.38; do\n    sed -i -e \"/use CGI /i use lib \\\"$p/lib/perl5/site_perl\\\";\" \\\n        \"$out/share/gitweb/gitweb.cgi\"\ndone\nrm $out/libexec/git-core/git-svn\n# wrap git-send-email\nwrapProgram $out/libexec/git-core/git-send-email \\\n             --set GITPERLLIB \"$out/lib/perl5/site_perl:/nix/store/r015h6w9c9aygyhvs1n26kdykyg83qk7-perl5.40.0-libnet-3.15/lib/perl5/site_perl:/nix/store/7xh42girixn1hpwbxryz8wn791rdi7rg-perl5.40.0-Net-SMTP-SSL-1.04/lib/perl5/site_perl:/nix/store/biibrgicmb9f47kflmzl7dmnkyqla9xj-perl5.40.0-IO-Socket-SSL-2.083/lib/perl5/site_perl:/nix/store/p61wnpx83c9zskvpciimj3lsrasjg02n-perl5.40.0-Net-SSLeay-1.92/lib/perl5/site_perl:/nix/store/zk7l59sm6mqvcqdhj1lm3vk9zd54ans3-perl5.40.0-Authen-SASL-2.1900/lib/perl5/site_perl:/nix/store/m0bzg50fsb3pxgbp28grdjrii4z4hm17-perl5.40.0-Digest-HMAC-1.05/lib/perl5/site_perl\"\n# Install man pages\nmake \"${flagsArray[@]}\" install install-html \\\n  -C Documentation\nfor prog in bin/gitk libexec/git-core/git-gui; do\n  rm \"$out/$prog\"\ndone\nunset flagsArray\n","postPatch":"# Fix references to gettext introduced by ./git-sh-i18n.patch\nsubstituteInPlace git-sh-i18n.sh \\\n    --subst-var-by gettext /nix/store/nzl79pryz8bzzkpq3j6l87jdiikfksqz-gettext-0.25.1\nsubstituteInPlace contrib/credential/libsecret/Makefile \\\n    --replace-fail 'pkg-config' \"$PKG_CONFIG\"\n# ensure we are using the correct shell when executing the test scripts\npatchShebangs t/*.sh\n","preBuild":"makeFlagsArray+=( perllibdir=$out/$(perl -MConfig -wle 'print substr $Config{installsitelib}, 1 + length $Config{siteprefixexp}') )\n","preInstall":"","preInstallCheck":"# Some tests break with high concurrency\n# https://github.com/NixOS/nixpkgs/pull/403237\nif ((NIX_BUILD_CORES > 32)); then\n  NIX_BUILD_CORES=32\nfi\n\ninstallCheckFlagsArray+=(\n  GIT_PROVE_OPTS=\"--jobs $NIX_BUILD_CORES --failures --state=failed,save\"\n  GIT_TEST_INSTALLED=$out/bin\n  NO_SVN_TESTS=y\n)\n\nfunction disable_test {\n  local test=$1 pattern=$2\n  if [ $# -eq 1 ]; then\n    mv t/{,skip-}$test.sh || true\n  else\n    sed -i t/$test.sh \\\n      -e \"/^\\s*test_expect_.*$patt