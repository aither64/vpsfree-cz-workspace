"configureFlags":"","debug":"/nix/store/3q47ngw6r4k7l13xk52vgrpvqq01w1q7-glib-2.86.3-debug","depsBuildBuild":"/nix/store/i7s4dyaj2qz5bczzycybq850pj4iygim-pkg-config-wrapper-0.29.2","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/fp3in7bmc66j76gd7irbssl88v4qfp4k-glib-2.86.3-dev","devdoc":"/nix/store/cvhvx4nnfhhzihz4qi4npbwg2apkk23z-glib-2.86.3-devdoc","doCheck":"","doInstallCheck":"","mesonFlags":"-Dglib_debug=disabled -Ddocumentation=true -Ddtrace=enabled -Dsystemtap=enabled -Dnls=enabled -Ddevbindir=/02qcpld1y6xhs5gz9bchpxaw0xdhmsp5dv88lh25r2ss44kh8dxz/bin -Dintrospection=disabled -Dtests=true","name":"glib-2.86.3","nativeBuildInputs":"/nix/store/lf084jlxwxqsmdy95gba3hrfa6k6apz0-python3.13-docutils-0.21.2 /nix/store/q1w41q7s597hn9p3pcl0zdygj0c1r0f5-meson-1.9.1 /nix/store/mn5a8r4dznljayzhykcfsbs4c08jwnps-ninja-1.13.1 /nix/store/i7s4dyaj2qz5bczzycybq850pj4iygim-pkg-config-wrapper-0.29.2 /nix/store/x17gg3w7lcwiqscqmif25688sivchwsn-perl-5.40.0 /nix/store/qwb5ygz9k8gs5ql9bpxbrsrv12r1icgm-python3-3.13.12 /nix/store/ykdhhj1kfx61car68hzsl9frmrl9djsl-python3.13-packaging-25.0 /nix/store/d55p47jagiv5hy15qhcsdhxa2blpvrxn-wrap-python-hook /nix/store/nzl79pryz8bzzkpq3j6l87jdiikfksqz-gettext-0.25.1 /nix/store/dv327l1c42dgjjipw1hxi7sch49m2bkv-libxslt-1.1.45-dev /nix/store/hn774dgv0vv3mcd50qxkw8a1ray6bi68-systemtap-5.2 /nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/fd4v4clwwy0p214drnzq1y695as7c612-glib-2.86.3","outputs":"bin out dev devdoc debug","patches":"/nix/store/1741v6rlizzg8k41myx7jk53rwa24b2m-glib-appinfo-watch.patch /nix/store/xmaba5a6w625vcyk9iaf44vzz8mnydk7-schema-override-variable.patch /nix/store/d8pkc3xxx3arcvdid48vh8imx9q9g4vq-elementary-terminal-support.patch /nix/store/0s51jr07rjwls4bwwb7mrpzikc2ax15m-split-dev-programs.patch /nix/store/abzy833a3cyracjdj47qxkx26r7lw2sg-gdb_script.patch","pname":"glib","postCheck":"rm $out/lib/libgobject-2.0.so.0\nrm $out/lib/libgio-2.0.so.0\nrm $out/lib/libglib-2.0.so.0\n","postConfigure":"patchShebangs gio/gdbus-2.0/codegen/gdbus-codegen gobject/glib-{genmarshal,mkenums}\n","postFixup":"for i in $dev/bin/*; do\n  moveToOutput \"share/man/man1/${i##*/}.1.*\" \"$dev\"\ndone\n\n# Cannot be in postInstall, otherwise _multioutDocs hook in preFixup will move right back.\nmoveToOutput \"share/doc\" \"$devdoc\"\n","postInstall":"moveToOutput \"share/glib-2.0\" \"$dev\"\nmoveToOutput \"share/glib-2.0/gdb\" \"$out\"\nsubstituteInPlace \"$dev/bin/gdbus-codegen\" --replace \"$out\" \"$dev\"\nsed -i \"$dev/bin/glib-gettextize\" -e \"s|^gettext_dir=.*|gettext_dir=$dev/share/glib-2.0/gettext|\"\n\n# This file is *included* in gtk3 and would introduce runtime reference via __FILE__.\nsed '1i#line 1 \"glib-2.86.3/include/glib-2.0/gobject/gobjectnotifyqueue.c\"' \\\n  -i \"$dev\"/include/glib-2.0/gobject/gobjectnotifyqueue.c\nfor i in $bin/bin/*; do\n  moveToOutput \"share/bash-completion/completions/${i##*/}\" \"$bin\"\ndone\nfor i in $dev/bin/*; do\n  moveToOutput \"share/bash-completion/completions/${i##*/}\" \"$dev\"\ndone\n","postPatch":"patchShebangs glib/gen-unicode-tables.pl\npatchShebangs glib/tests/gen-casefold-txt.py\npatchShebangs glib/tests/gen-casemap-txt.py\npatchShebangs tools/gen-visibility-macros.py\npatchShebangs tests\n\n# Needs machine-id, comment the test\nsed -e '/\\/gdbus\\/codegen-peer-to-peer/ s/^\\/*/\\/\\//' -i gio/tests/gdbus-peer.c\nsed -e '/g_test_add_func/ s/^\\/*/\\/\\//' -i gio/tests/gdbus-address-get-session.c\n# All gschemas fail to pass the test, upstream bug?\nsed -e '/g_test_add_data_func/ s/^\\/*/\\/\\//' -i gio/tests/gschema-compile.c\n# Cannot reproduce the failing test_associations on hydra\nsed -e '/\\/appinfo\\/associations/d' -i gio/tests/appinfo.c\n# Needed because of libtool wrappers\nsed -e '/g_subprocess_launcher_set_environ (launcher, envp);/a g_subprocess_launcher_setenv (launcher, \"PATH\", g_getenv(\"PATH\"), TRUE);' -i gio/tests/gsubprocess.c\n","preCheck":"","preFixup":"buildPythonPath /nix/store/ykdhhj1kfx61car68hzsl9frmrl9djsl-python3.13-packaging-25.0\npatchPythonScript \"$dev/share/glib-2.0/codegen/utils.py\"\n","propagatedBuildInputs":"/nix/store/0076ndvx724b4icqkmgiwfmnlp5hbw6x-zlib-1.3.2-dev /nix/store/v0nhq44q76xg75wvqfdff8kda4rna08r-libffi-3.5.2-dev /nix/store/nzl79pryz8bzzkpq3j6l87jdiikfksqz-gettext-0.25.1 /nix/store/0nyxvip6ssikwprfgbjnxjyib7amgldg-glibc-iconv-2.40","propagatedNativeBuildInputs":"","separateDebugInfo":"1","setupHook":"/nix/store/qgfij9cxhp7gfjk6hs43hzy4n3w9am3c-setup-hook.sh","src":"/nix/store/gy7m3a0x90630dk3nmizxqz4rzw8426i-glib-2.86.3.tar.xz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.86.3"},"inputs":{"drvs":{"0vgf8xan18x19ikjnwdg3pa7bdi30g7y-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"21wcp995hpcc68sh9zdx48k9swzw3ljn-glib-2.86.3.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"2mi60aaqvk06babm26lbbgpnc7zl0myw-libselinux-3.8.1.drv":{"dynamicOutputs":{},"outputs":["dev"]},"6184myqz0xd7lgjpvghic7a25j9yg0qk-meson-1.9.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"b8yjprblh33vmwpssjsz3hpjhjxccifa-libffi-3.5.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"ck21bbdpc5inhxhkw5bgigmd4i0ygdz9-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"fw3cn6ld4xfbix0fpi8s4rhvsk8waq1f-pcre2-10.46.drv":{"dynamicOutputs":{},"outputs":["dev"]},"fxk8mbm27inp29qpyp3p7vmpdh1j0p7d-python3.13-docutils-0.21.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"g6fhakp65bdxvnrpvc3vbkms0cnw7pph-perl-5.40.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"hdyswmjki8ph2hq4dzf0rdg4akai6l28-bash-interactive-5.3p3.drv":{"dynamicOutputs":{},"outputs":["dev"]},"hwbjapw42afx8c71bqjiij9n2d2lsga2-util-linux-minimal-2.41.3.drv":{"dynamicOutpu