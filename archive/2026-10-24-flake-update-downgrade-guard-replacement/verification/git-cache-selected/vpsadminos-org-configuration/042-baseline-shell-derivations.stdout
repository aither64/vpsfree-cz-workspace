fm6ghg0hfgnl7yc722xdyrmsn6-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/g22xx6fm6ghg0hfgnl7yc722xdyrmsn6-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/x2vhj00qycq8jcgffcsw7hdlbm3ddx0r-hspec-meta-2.11.14.tar.gz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"2.11.14"},"inputs":{"drvs":{"0apzdz4jkw22ajdz7wgylixixjhgnnk2-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]},"2vgsjkgfpzi5pppbgdqzcs68zqvag8rd-hspec-meta-2.11.14.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"3qrm1qnh4gsj5yvx8gphm0rppbknmj4n-call-stack-0.4.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"5nmvkwgvgb0ik8pq0s2ppqsn5bbv5fvr-tf-random-0.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"5r5nfd1rdnk18zc5r51s8ff1vd2lfkrh-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"6k6091kk09573h8cq5vz110m1s40h2si-hspec-expectations-0.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"71wqifz87nvx6kf58bfz3s1bq9y1hc1w-hspec-meta-2.11.14-r2.cabal.drv":{"dynamicOutputs":{},"outputs":["out"]},"7pxd80gc0m61lbymw5aval1ch0kd06yh-random-1.2.1.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"iha25923ldwiqybljhcfc6hwhjgrfjy7-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"m90blzz96kk5pc7n70yg2c1kb3c242zr-glibc-locales-2.40-218.drv":{"dynamicOutputs":{},"outputs":["out"]},"mi5v4jqn2swyknvm69x2h7yviz1w