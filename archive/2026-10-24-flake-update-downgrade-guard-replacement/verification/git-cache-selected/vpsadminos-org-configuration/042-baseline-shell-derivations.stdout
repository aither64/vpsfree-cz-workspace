y-9.8.4\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/yw0062vigc7wrmcidyjck1xg05n5g7xw-js-dgtable-0.5.2.tar.gz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.5.2"},"inputs":{"drvs":{"7i8x2fq0lp2qqnmianjz7j2zikk7pp0k-ghc-binary-9.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"dyjay1y1cifpbhaq9iw491gk948r5cv2-js-dgtable-0.5.2.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"iha25923ldwiqybljhcfc6hwhjgrfjy7-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"m90blzz96kk5pc7n70yg2c1kb3c242zr-glibc-locales-2.40-218.drv":{"dynamicOutputs":{},"outputs":["out"]},"mi5v4jqn2swyknvm69x2h7yviz1w9acs-coreutils-9.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"sdp1lbwaf2nbqs6msifwc6w7bdk4kz99-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]},"sj24vwbm6xrvp2wvzla5vr26cm7afpfk-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["4mdp8nhyfddh7bllbi7xszz7k9955n79-Setup.hs","907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"js-dgtable-0.5.2","outputs":{"data"