ge databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/zn0h14cj7l0fvxbjgcanvvz9f1s6pfx5-hashable-1.5.0.0.tar.gz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.5.0.0"},"inputs":{"drvs":{"0iqv2ifd65zp4h6kskszvy0np7pmxn0b-hashable-1.5.0.0-r1.cabal.drv":{"dynamicOutputs":{},"outputs":["out"]},"7i8x2fq0lp2qqnmianjz7j2zikk7pp0k-ghc-binary-9.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"iha25923ldwiqybljhcfc6hwhjgrfjy7-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"l67f8mzjw4lzv9y1mf6v9fhwsi4hav66-jailbreak-cabal-1.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"llqk6vh1m8p1p9zkf71g45xfxnrvf4dq-hashable-1.5.0.0.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"m90blzz96kk5pc7n70yg2c1kb3c242zr-glibc-locales-2.40-218.drv":{"dynamicOutputs":{},"outputs":["out"]},"mi5v4jqn2