c' is a separate output on static builds only.\netc=$out\nmkdir -p $bin\nmv $out/bin $bin/bin\n\n# c_rehash is a legacy perl script with the same functionality\n# as `openssl rehash`\n# this wrapper script is created to maintain backwards compatibility without\n# depending on perl\nmakeWrapper $bin/bin/openssl $bin/bin/c_rehash \\\n  --add-flags \"rehash\"\n\nmkdir $dev\nmv $out/include $dev/\n\n# remove dependency on Perl at runtime\nrm -r $etc/etc/ssl/misc\n\nrmdir $etc/etc/ssl/{certs,private}\n","postPatch":"patchShebangs Configure\nsubstituteInPlace config --replace '/usr/bin/env' '/nix/store/vzx1mi9c0xfadmsm9dhd83d005cb1qs9-coreutils-9.8/bin/env'\n","preCheck":"patchShebangs util\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","separateDebugInfo":"1","setOutputFlags":"","src":"/nix/store/nl95ql07rlggvh6hy92ws4jh3fl3xlac-openssl-3.6.1.tar.gz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"3.6.1"},"inputs":{"drvs":{"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"g6fhakp65bdxvnrpvc3vbkms0cnw7pph-perl-5.40.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"h75cii96f6y85w38048wvsms29dd2jgz-openssl-3.6.1.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"mi5v4jqn2swyknvm69x2h7yviz1w9acs-coreutils-9.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"rkbxv6hq6m37nwkjw9cs63mzm14y3dly-make-binary-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["cklrwbwi889pp2fdsswdjvn12sdy5i5j-openssl-disable-kernel-detection.patch","i58agvhx8bmdjlspgkk4m3ylh5348iim-use-etc-ssl-certs.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh","sq4h6bqjx12v9whvm65pjss25hg1538q-nix-ssl-cert-file.patch"]},"name":"openssl-3.6.1","outputs":{"bin":{"pa