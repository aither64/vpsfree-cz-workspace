=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"drb prism","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"minitest","gemPath":"/nix/store/ijs23vlrj4hcx2rbbhd5glfg9bknidcm-ruby3.4-drb-2.2.3 /nix/store/aviy9k16wrb637h2mz4d32k2xi8h6djy-ruby3.4-prism-1.9.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\necho \"buildFlags: $buildFlags\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg $gemFlags -- $buildFlags\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-minitest-6.0.2","nativeBuildInputs":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook","out":"/nix/store/fdb8blyvr7vq2wnyly6r2yrib173638l-ruby3.4-minitest-6.0.2","outputs":"out","patches":"","propagatedBuildInputs":"/nix/store/ijs23vlrj4hcx2rbbhd5glfg9bknidcm-ruby3.4-drb-2.2.3 /nix/store/aviy9k16wrb637h2mz4d32k2xi8h6djy-ruby3.4-prism-1.9.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/ijs23vlrj4hcx2rbbhd5glfg9bknidcm-ruby3.4-drb-2.2.3 /nix/store/aviy9k16wrb637h2mz4d32k2xi8h6djy-ruby3.4-prism-1.9.0","ruby":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8","src":"/nix/store/vh3hnfqak00a9z5jiccaxq6yh1klir3x-minitest-6.0.2.gem","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","suffix":"6.0.2","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n   