sh-5.3p3/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"diff-lcs rspec-support","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"rspec-expectations","gemPath":"/nix/store/4p9j1xvznzz0ss4nqbrwi1xzngzm2dik-ruby3.4-diff-lcs-1.6.2 /nix/store/vnvx1nmq8kw5vi1b9s79r9d0258jik9y-ruby3.4-rspec-support-3.13.7","gemType":"gem","groups":"default development test","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\necho \"buildFlags: $buildFlags\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg $gemFlags -- $buildFlags\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-rspec-expectations-3.13.5","nativeBuildInputs":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook","out":"/nix/store/cvq26ya2qldhyw14x1bjqvy3b87a5b81-ruby3.4-rspec-expectations-3.13.5","outputs":"out","patches":"","propagatedBuildInputs":"/nix/store/4p9j1xvznzz0ss4nqbrwi1xzngzm2dik-ruby3.4-diff-lcs-1.6.2 /nix/store/vnvx1nmq8kw5vi1b9s79r9d0258jik9y-ruby3.4-rspec-support-3.13.7","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/4p9j1xvznzz0ss4nqbrwi1xzngzm2dik-ruby3.4-diff-lcs-1.6.2 /nix/store/vnvx1nmq8kw5vi1b9s79r9d0258jik9y-ruby3.4-rspec-support-3.13.7","ruby":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8","src":"/nix/store/x318bqrxpdl63ljjgh61i8xqlqng2i22-rspec-expectations-3.13.5.gem","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","suffix":"3.13.5","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"3.13.5"},"inputs":{"drvs":{"0anzqcbhlbc78v3chh29b0p3w5k9qjrr-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"25mz3rhvphx7c6aiz8b2v1vxaw5x1glj-rspec-expectations-3.13.5.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"dzq88d0nhqwi7hx52g6imsg33iblbfn5-ruby3.4-diff-lcs-1.6.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"p2s3ijk7krn4zi5bn7x1g1gs1bipa7iv-ruby-3.4.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"v4qsbdngnz2blmj8xzv1zvhz563xana1-ruby3.4-rspec-support-3.13.7.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-rspec-expectations-3.13.5","outputs":{"out":{"path":"cvq26ya2qldhyw14x1bjqvy3b87a5b81-ruby3.4-rspec-expectations-3.13.5"}},"system":"x86_64-linux","version":4},"9jybqhhvy4mrnfk28xw1c7i3qdyznqpc-bash-completion-2.17.0.tar.xz.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/w003xwysww5hwn4a759kji6s3157xmrc-builder.sh"],"builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","env":{"SSL_CERT_FILE":"/no-cert-file.crt","__structuredAttrs":"","buildInputs":"","builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","cmakeFlags":"","configureFlags":"","curlOpts":"","curlOptsList":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","downloadToTemp":"","executable":"","impureEnvVars":"http_proxy https_proxy ftp_proxy all_proxy no_proxy HTTP_PROXY HTTPS_PROXY FTP_PROXY ALL_PRO