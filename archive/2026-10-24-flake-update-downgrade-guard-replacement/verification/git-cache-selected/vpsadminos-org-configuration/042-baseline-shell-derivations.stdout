ORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --enable-library-profiling --profiling-detail=exported-functions --disable-profiling --enable-shared --disable-coverage --enable-static --disable-executable-dynamic --enable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping --ghc-option=-haddock $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/g22xx6fm6ghg0hfgnl7yc722xdyrmsn6-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/g22xx6fm6ghg0hfgnl7yc722xdyrmsn6-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/g22xx6fm6ghg0hfgnl7yc722xdyrmsn6-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/g22xx6fm6ghg0hfgnl7yc722xdyrmsn6-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/wgpv2l91r2c5zkvi217kj11jdsw1dlbm-hspec-2.11.14.tar.gz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"2.11.14"},"inputs":{"drvs":{"0apzdz4jkw22ajdz7wgylixixjhgnnk2-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]},"5r5nfd1rdnk18zc5r51s8ff1vd2lfkrh-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"6k6091kk09573h8cq5vz110m1s40h2si-hspec-expectations-0.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"iha25923ldwiqybljhcfc6hwhjgrfjy7-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"lh2la54m9vzl48kfxjwqlzdpgpf4w1y2-hspec-core-2.11.14.drv":{"dynamicOutputs":{},"outputs":["out"]},"m90blzz96kk5pc7n70yg2c1kb3c242zr-glibc-locales-2.40-218.drv":{"dynamicOutputs":{},"outputs":["out"]},"mi5v4jqn2swyknvm69x2h7yviz1w9acs-coreutils-9.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"qln8a55n2229gvmilcfiq96wy7dmbzyb-QuickCheck-2.15.0.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"s7d7a5f5xdbbgmzvz0cgcb3par4c80rh-hspec-discover-2.11.14.drv":{"dynamicOutputs":{},"outputs":["ou