re shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-tty-progressbar-0.18.3","nativeBuildInputs":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook","out":"/nix/store/2yklg2ci9v0fjxfxsckkb6p1rqy16m4m-ruby3.4-tty-progressbar-0.18.3","outputs":"out","patches":"","propagatedBuildInputs":"/nix/store/v6vdmzbvrfg469f310b9vdq9jyhfxkbb-ruby3.4-strings-ansi-0.2.0 /nix/store/82jnjnwck0xmzybxwnmbgvini8gbgqxf-ruby3.4-tty-cursor-0.7.1 /nix/store/415ll883qsa951kkzzhnn6z1rwh293wr-ruby3.4-tty-screen-0.8.2 /nix/store/m8fjm5qw56jzk4k3dx3gnkb7nrxpcbpz-ruby3.4-unicode-display_width-2.6.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/v6vdmzbvrfg469f310b9vdq9jyhfxkbb-ruby3.4-strings-ansi-0.2.0 /nix/store/82jnjnwck0xmzybxwnmbgvini8gbgqxf-ruby3.4-tty-cursor-0.7.1 /nix/store/415ll883qsa951kkzzhnn6z1rwh293wr-ruby3.4-tty-screen-0.8.2 /nix/store/m8fjm5qw56jzk4k3dx3gnkb7nrxpcbpz-ruby3.4-unicode-display_width-2.6.0","ruby":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8","src":"/nix/store/iycq9ipz2s3glhx69m2q5wg19dljwjkm-tty-progressbar-0.18.3.gem","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","suffix":"0.18.3","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gem