e remove them for a few reasons:\n# - files are non-deterministic: https://github.com/NixOS/nixpkgs/issues/139292\n#   (file headers are generatedt by pytest directly and contain timestamps)\n# - files are not needed after tests are finished\npytestRemoveBytecodePhase () {\n    # suffix is defined at:\n    #    https://github.com/pytest-dev/pytest/blob/7.2.1/src/_pytest/assertion/rewrite.py#L51-L53\n    find $out -name \"*-pytest-*.py[co]\" -delete\n}\nappendToVar preDistPhases pytestRemoveBytecodePhase\n"},"inputs":{"drvs":{"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"s8ldl64hd0y1ccsg1yzqn5fyyrgp10b6-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"pytest-hook","outputs":{"out":{"path":"qznh8bh1ss413rgf9b5xw492swf1ga47-pytest-hook"}},"system":"x86_64-linux","version":4},"08h1vslczik5rq7cf3wis5wagrvnc3aq-libtheora-1.2.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","env":{"__structuredAttrs":"","buildInputs":"","builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","cmakeFlags":"","configureFlags":"--disable-examples","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","dev":"/nix/store/milxgzr0zz28j512w3gh0yjbgq9md56n-libtheora-1.2.0-dev","devdoc":"/nix/store/67ji76dcjhwyqi484my2bd9fwcblgana-libtheora-1.2.0-devdoc","doCheck":"","doInstallCheck":"","mesonFlags":"","name":"libtheora-1.2.0","nativeBuildInputs":"/nix/store/hlch10mig4b11rcwy56f3q046w0glivf-autoreconf-hook /nix/store/i7s4dyaj2qz5bczzycybq850pj4iygim-pkg-config-wrapper-0.29.2 /nix/store