 cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-vpsadmin-client-4.1.0","nativeBuildInputs":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook","out":"/nix/store/yx040m3rlqz840vhl83d9vvjnnzspirp-ruby3.4-vpsadmin-client-4.1.0","outputs":"out","patches":"","propagatedBuildInputs":"/nix/store/a5c70s1jpkw1fch8d7sn0g5c5n359bvb-ruby3.4-base64-0.3.0 /nix/store/8yjvdxghjz2n50j8df7qr9w1rwbxl7hy-ruby3.4-curses-1.5.3 /nix/store/jgbf9cksw3kks96gpg716i2p34qh9hg8-ruby3.4-haveapi-client-0.26.5 /nix/store/g4qkjk4m4vyrrhq9qw29449r0lqjm556-ruby3.4-json-2.18.1","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/a5c70s1jpkw1fch8d7sn0g5c5n359bvb-ruby3.4-base64-0.3.0 /nix/store/8yjvdxghjz2n50j8df7qr9w1rwbxl7hy-ruby3.4-curses-1.5.3 /nix/store/jgbf9cksw3kks96gpg716i2p34qh9hg8-ruby3.4-haveapi-client-0.26.5 /nix/store/g4qkjk4m4vyrrhq9qw29449r0lqjm556-ruby3.4-json-2.18.1","ruby":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8","src":"/nix/store/x6rxarvw0mqzicdhm8mi5lrq0bnbq5v4-vpsadmin-client-4.1.0.gem","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","suffix":"4.1.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n  