kage databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.10.3/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/g22xx6fm6ghg0hfgnl7yc722xdyrmsn6-ghc-9.10.3\" ] && [ \"$p\" != \"/nix/store/g22xx6fm6ghg0hfgnl7yc722xdyrmsn6-ghc-9.10.3\" ]; then\n  cp -f \"$p/lib/ghc-9.10.3/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/1nr84gxykdayb34wqhyhzapplwj6hj2x-tf-random-0.5.tar.gz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.5"},"inputs":{"drvs":{"0apzdz4jkw22ajdz7wgylixixjhgnnk2-hscolour-1.25.drv":{"dynamicOutputs":{},"outputs":["out"]},"5r5nfd1rdnk18zc5r51s8ff1vd2lfkrh-ghc-9.10.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"6nv4bh64l8fng4z7rz0fkifjp73djqf0-primitive-0.9.1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"7pxd80gc0m61lbymw5aval1ch0kd06yh-random-1.2.1.3.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"iha25923ldwiqybljhcfc6hwhjgrfjy7-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"m90blzz96kk5pc7n70yg2c1kb3c242zr-glibc-locales-2.40-218.drv":{"dynamicOutputs":{},"outputs":["out"]},"mi5v4jqn2swyknvm69x2h7yviz1w9acs-coreutils-9.8.drv":{"d