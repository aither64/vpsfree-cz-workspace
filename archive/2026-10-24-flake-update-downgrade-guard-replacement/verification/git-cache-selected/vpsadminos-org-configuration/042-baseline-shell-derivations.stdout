w5p5-ruby-3.4.8","buildPhase":"runHook preBuild\n\nif [[ \"$gemType\" == \"gem\" ]]; then\n  if [[ -z \"$gemspec\" ]]; then\n    gemspec=\"$(find . -name '*.gemspec')\"\n    echo \"found the following gemspecs:\"\n    echo \"$gemspec\"\n    gemspec=\"$(echo \"$gemspec\" | head -n1)\"\n  fi\n\n  exec 3>&1\n  output=\"$(gem build $gemspec | tee >(cat - >&3))\"\n  exec 3>&-\n\n  gempkg=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"base64 bigdecimal concurrent-ruby connection_pool drb i18n json logger minitest securerandom tzinfo uri","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"activesupport","gemPath":"/nix/store/a5c70s1jpkw1fch8d7sn0g5c5n359bvb-ruby3.4-base64-0.3.0 /nix/store/kd8vksyb0d8wi0p6sa8pl2s7vjbldcg1-ruby3.4-bigdecimal-4.0.1 /nix/store/qqv83k1rv1g11pnsp8lprrmvfy3vbgbi-ruby3.4-concurrent-ruby-1.3.6 /nix/store/88rxil0hlsd4j2fpkqal8ddhv0lpz3bc-ruby3.4-connection_pool-3.0.2 /nix/store/ijs23vlrj4hcx2rbbhd5glfg9bknidcm-ruby3.4-drb-2.2.3 /nix/store/sdsl1vjkh3q5ifwgrls88kdpy95rgisv-ruby3.4-i18n-1.14.8 /nix/store/g4qkjk4m4vyrrhq9qw29449r0lqjm556-ruby3.4-json-2.18.1 /nix/store/xa0mrzlzcrxkj5p6j6myshkj2549v9py-ruby3.4-logger-1.7.0 /nix/store/fdb8blyvr7vq2wnyly6r2yrib173638l-ruby3.4-minitest-6.0.2 /nix/store/vv76r18lpd43rmyspy9pgqjfn76lb3b9-ruby3.4-se