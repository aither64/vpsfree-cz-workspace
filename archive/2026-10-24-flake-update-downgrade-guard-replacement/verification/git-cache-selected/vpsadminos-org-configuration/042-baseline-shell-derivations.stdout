\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/by53qlxwmmgad3s3n62dmbd17d6vj83g-happy-2.1.7.tar.gz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"2.1.7"},"inputs":{"drvs":{"15zs4937sj8xs5gvmciy68pf4gwwjjrf-happy-lib-2.1.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"7i8x2fq0lp2qqnmianjz7j2zikk7pp0k-ghc-binary-9.8.4.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"iha25923ldwiqybljhcfc6hwhjgrfjy7-haskell-generic-builder-test-wrapper.sh.drv":{"dynamicOutputs":{},"outputs":["out"]},"m90blzz96kk5pc7n70yg2c1kb3c242zr-glibc-locales-2.40-218.drv":{"dynamicOutputs":{},"outputs":["out"]},"mi5v4jqn2swyknvm69x2h7yviz1w9acs-coreutils-9.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"sj24vwbm6xrvp2wvzla5vr26cm7afpfk-remove-references-to.drv":{"dynamicOutputs":{},"outputs":["out"]},"x7khvcpkcda0pf4nj82ps17h84nwgxic-happy-2.1.7.tar.gz.drv":{"dynamicOutputs":{},"outputs":["out"]},"xmsyc99zfbjjl8fjb3l6yicwahdy6jmf-which-2.23.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["4mdp8nhyfddh7bllbi7xszz7k9955n79-Setup.hs","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"happy-2.1.7","outputs":{"out":{"path":"xmn89nf3g6vqgivl8y52qv8chqgszsd3-happy-2.1.7"}},"system":"x86_64-linux","version":4},"i3zasqmsc3i9wca3ysxc0hvlhi0gd30z-source.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/w003xwysww5hwn4a759kji6s3157xmrc-builder.sh"],"builder":"/nix/store/wv8bpzriikv65xnd1vciqp