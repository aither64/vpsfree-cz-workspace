riikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"logger mime-types-data","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"mime-types","gemPath":"/nix/store/xa0mrzlzcrxkj5p6j6myshkj2549v9py-ruby3.4-logger-1.7.0 /nix/store/c6s4dprv7xpld1rkrx4vr1pqph2m7zg4-ruby3.4-mime-types-data-3.2026.0224","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\necho \"buildFlags: $buildFlags\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg $gemFlags -- $buildFlags\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-mime-types-3.7.0","nativeBuildInputs":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook","out":"/nix/store/hrc61zdqyy768dmzbwi5mqb5121yvvv9-ruby3.4-mime-types-3.7.0","outputs":"out","patches":"","propagatedBuildInputs":"/nix/store/xa0mrzlzcrxkj5p6j6myshkj2549v9py-ruby3.4-logger-1.7.0 /nix/store/c6s4dprv7xpld1rkrx4vr1pqph2m7zg4-ruby3.4-mime-types-data-3.2026.0224","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/xa0mrzlzcrxkj5p6j6myshkj2549v9py-ruby3.4-logger-1.7.0 /nix/store/c6s4dprv7xpld1rkrx4vr1pqph2m7zg4-ruby3.4-mime-types-data-3.2026.0224","ruby":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8","src":"/nix/store/xf9bmfm4gxvfzqrlkpasrdvjqdjnw9v7-mime-types-3.7.0.gem","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","suffix":"3.7.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi