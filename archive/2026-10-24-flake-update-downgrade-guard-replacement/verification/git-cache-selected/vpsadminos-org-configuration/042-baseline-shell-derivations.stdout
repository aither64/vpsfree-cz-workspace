essary to build rls, clippy...\npython x.py dist rustc-dev\ntar xf build/dist/rustc-dev*tar.gz\ncp -r rustc-dev*/rustc-dev*/lib/* $out/lib/\nrm $out/lib/rustlib/install.log\nfor m in $out/lib/rustlib/manifest-rust*\ndo\n  sort --output=$m < $m\ndone\n\n# remove references to llvm-config in lib/rustlib/x86_64-unknown-linux-gnu/codegen-backends/librustc_codegen_llvm-llvm.so\n# and thus a transitive dependency on ncurses\nfind $out/lib -name \"*.so\" -type f -exec remove-references-to -t /nix/store/n96mcsx6qisxrpljz1lvzcxxqyip9z2m-llvm-21.1.7 '{}' '+'\n\n# remove uninstall script that doesn't really make sense for Nix.\nrm $out/lib/rustlib/uninstall.sh\n","postPatch":"patchShebangs src/etc\n\n# rust-lld is the name rustup uses for its bundled lld, so that it\n# doesn't conflict with any system lld.  This is not an\n# appropriate default for Nixpkgs, where there is no rust-lld.\nsubstituteInPlace compiler/rustc_target/src/spec/*/*.rs \\\n  --replace-quiet '\"rust-lld\"' '\"lld\"'\n\nrm -rf src/llvm\n\n# Useful debugging parameter\n# export VERBOSE=1\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","requiredSystemFeatures":"big-parallel","setOutputFlags":"","setupHooks":"/nix/store/skyp8xs2584fkc44ki1cim9ag55wbi68-setup-hook.sh","src":"/nix/store/032wk39vbrkqvvzplxr7inmxw1hcdv20-rustc-1.91.1-src.tar.gz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","stripDebugList":"bin","system":"x86_64-linux","version":"1.91.1"},"inputs":{"drvs":{"0vgf8xan18x19ikjnwdg3pa7bdi30g7y-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"4h4gq0wpzj8amvbs2h9jmla5j9b39sqp-cmake-4.1.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"5y6a9rw2gwj6ifa4icc75xikq31pjhx2-openssl-3.6.1.drv":{"dynamicOutputs":{},"outputs":["dev"]},"67wkbgxbg74qd44lnl0918prcsr23qvc-gcc-wrapper-14.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"b8yjprblh33vmwpssjsz3hpjhjxccifa-libffi-3.5.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"c2b1hn1cda9v0s2b9