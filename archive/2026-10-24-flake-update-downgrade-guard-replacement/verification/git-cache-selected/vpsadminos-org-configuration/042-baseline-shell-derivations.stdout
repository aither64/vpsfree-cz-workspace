"OBJCOPY=objcopy BUILD_LDFLAGS=-Wl,-rpath,/nix/store/pdwlyjkmc6icc0wb5gaw08m9ynqrg683-glibc-2.40-218/lib OBJDUMP=/nix/store/yh5c3kqkmlhfs86y5b12ncg89kik88zf-binutils-patchelfed-ld-2.44/bin/objdump localedata/install-locales localedir=/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/lib/locale","mesonFlags":"","name":"glibc-locales-2.40-218","nativeBuildInputs":"/nix/store/n5gy6gc2h90s3kgmxbkw6qfva8gh4bgz-bison-3.8.2 /nix/store/fhvjmrliq3pffab49dbqbcvz051mdsnm-python3-minimal-3.13.12 /nix/store/903kx9pwhyzswmx1caf7rc8idram9vdq-glibc-2.40-218-dev","out":"/nix/store/a5bmp68l2a0dvlqkz85wzp7v44fk64jd-glibc-locales-2.40-218","outputs":"out","patches":"/nix/store/59724d86p0bpwjw7a9x5y9f47hmmmq9z-2.40-master.patch /nix/store/nc5hqqizlj7042vvhvx121kzf4nwh35p-nix-locale-archive.patch /nix/store/b1w7zbvm39ff1i52iyjggyvw2rdxz104-dont-use-system-ld-so-cache.patch /nix/store/mnglr8rr7nl444h7p50ysyq8qd0fm1lm-dont-use-system-ld-so-preload.patch /nix/store/za0pg7fmysrcwrqcal26fnmzw6vycgdn-fix_path_attribute_in_getconf.patch /nix/store/7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch /nix/store/001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch /nix/store/pcpx2ayccijipfl32zchx0mg7rzvj6zx-0001-Revert-Remove-all-usage-of-BASH-or-BASH-in-installed.patch /nix/store/sj0qllprnrmk1cqnnk57vvn2cqgjynbx-reenable_DT_HASH.patch /nix/store/f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch /nix/store/62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch","pname":"glibc-locales","postConfigure":"# Hack: get rid of the `-static' flag set by the bootstrap stdenv.\n# This has to be done *after* `configure' because it builds some\n# test binaries.\nexport NIX_CFLAGS_LINK=\nexport NIX_LDFLAGS_BEFORE=\n\nexport NIX_DONT_SET_RPATH=1\nunset CFLAGS\n","postInstall":"moveToOutput bin/getent $getent\n","postPatch":"# Needed for glibc to build with the gnumake 3.82\n# http://comments.gmane.org/gmane.linux.lfs.support/31227\nsed -i 's/ot \\$/ot:\\n\\ttouch $@\\n$/' manual/Makefile\n\n# nscd needs libgcc, and we don't want it dynamically linked\n# because we don't want it to depend on bootstrap-tools libs.\necho \"LDFLAGS-nscd += -static-libgcc\" >> nscd/Makefile\n\n# Ensure that `__nss_files_fopen` can still be wrapped by `libredirect`.\nsed -i -e '/libc_hidden_def (__nss_files_fopen)/d' nss/nss_files_fopen.c\nsed -i -e '/libc_hidden_proto (__nss_files_fopen)/d' include/nss_files.h\n\n# Ensure that libidn2 is found.\npatch -p 1 <<EOF\n--- a/inet/idna.c\n+++ b/inet/idna.c\n@@ -25,1 +25,1 @@\n-#define LIBIDN2_SONAME \"libidn2.so.0\"\n+#define LIBIDN2_SONAME \"/nix/store/qywg7bxskvihq62ms2g51fkzkrdnyfkh-libidn2-2.3.8/lib/libidn2.so.0\"\nEOF\nfor path in timezone/zic.c timezone/zdump.c ; do\n  substituteInPlace $path  --replace-fail \"ATTRIBUTE_REPRODUCIBLE\" \"\"\ndone\n","preBuild":"# Awful hack: `localedef' doesn't allow the path to `locale-archive'\n# to be overriden, but you *can* specify a prefix, i.e. it will use\n# <prefix>/<path-to-glibc>/lib/locale/locale-archive.  So we use\n# $TMPDIR as a prefix, meaning that the locale-archive is placed in\n# $TMPDIR/nix/store/...-glibc-.../lib/locale/locale-archive.\nLOCALEDEF_FLAGS+=\" --prefix=$TMPDIR\"\n\nexport inst_complocaledir=\"$TMPDIR/\"/nix/store/pdwlyjkmc6icc0wb5gaw08m9ynqrg683-glibc-2.40-218/lib/locale\nmkdir -p \"$inst_complocaledir\"\n\necho 'C.UTF-8/UTF-8 \\' >> ../glibc-2*/localedata/SUPPORTED\n\n# Hack to allow building of the locales (needed since glibc-2.12)\nsubstituteInPlace ../glibc-2*/localedata/Makefile \\\n  --replace-fail '$(rtld-prefix) $(common-objpfx)locale/localedef' 'localedef $(LOCALEDEF_FLAGS)'\n","preConfigure":"export PWD_P=$(type -tP pwd)\nfor i in configure io/ftwtest-sh; do\n    # Can't use substituteInPlace here because replace hasn't been\n    # built yet in the bootstrap.\n    sed -i \"$i\" -e \"s^/bin/pwd^$PWD_P^g\"\ndone\n\nmkdir ../build\ncd ../build\n\nconfigureScript=\"`pwd`/../$sourceRoot/configure\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","setupHook":"/nix/store/cv6qvvz4akwi31pf0idvjg2n6f3p9b2c-locales-setup-hook.sh","src":"/nix/store/l66b2j7crhj29wk7sx4nycbq55np9fvh-glibc-2.40.tar.xz","stdenv":"/nix/store/ri11z6hvcx072pkrdwfli5mjmfwqfi5p-bootstrap-stage4-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.40-218"},"inputs":{"drvs":{"05q48dcd4lgk4vh7wyk330gr2fr082i2-bootstrap-tools.drv":{"dynamicOutputs":{},"outputs":["out"]},"5fia0s7sl13hsqbhcmgmjpq84i0rqczs-glibc-2.40.tar.xz.drv":{"dynamicOutputs":{},"outputs":["out"]},"6b9vb9fwl2hqqpfzs3i4lbh3m93frhsl-linux-headers-6.16.7.drv":{"dynamicOutputs":{},"outputs":["out"]},"a64c09hgbhz1k3knddjgc43z6hpb0gsx-libidn2-2.3.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"c6pkqn35fcmq47binlkgfydf51w643i9-bootstrap-stage4-gcc-wrapper-14.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"cpxl8857m1b0f9fz8lvbhr2m8p56v96c-binutils-patchelfed-ld-2.44.drv":{"dynamicOutputs":{},"outputs":["out"]},"i7miyh7832lkyy229nipb5h6zg5n32rc-bison-3.8.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"ljzczrbjmwzkp0j1hak7mvhh7xf58m3b-python3-minimal-3.13.12.drv":{"dynamicOutputs":{},"outputs":["out"]},"n65b8f5a28h8bww5wxfzc8nqs06pmssl-glibc-2.40-218.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"qkics4b5lgl1d98ad19vslda1vc00j8a-bootstrap-stage4-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"zfgay32lz9z1gswqzdabv19yi8111xmc-locales-setup-hook.sh.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["001gp43bjqzx60cg345n2slzg7131za8-nix-nss-open-files.patch","59724d86p0bpwjw7a9x5y9f47hmmmq9z-2.40-master.patch","62qh08ij1zvw5lxj69n98lzv0byda0di-0002-Makeconfig-make-inst_complocaledir-overridable.patch","7kw224hdyxd7115lrqh9a4dv2x8msq2s-fix-x64-abi.patch","b1w7zbvm39ff1i52iyjggyvw2rdxz104-dont-use-system-ld-so-cache.patch","f1qmmr4f6mi99xr5bvfrqmynjx9j038p-0001-localedata-allow-reproducible-parallel-install-of-lo.patch","l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","mnglr8