 $gemspec | tee >(cat - >&3))\"\n  exec 3>&-\n\n  gempkg=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","cmakeFlags":"","configureFlags":"","dependencies":"binman redcarpet rouge","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"md2man","gemPath":"/nix/store/bx2inlivg4rm0wd6gx1lskrp0nblbc5a-ruby3.4-binman-5.1.0 /nix/store/i0kwl3vvdxyl67nmq4zz0c07a9x9sw67-ruby3.4-redcarpet-3.6.1 /nix/store/wip8a491dncgnvawvy9rrcllvsznvrwb-ruby3.4-rouge-3.30.0","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\necho \"buildFlags: $buildFlags\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg $gemFlags -- $buildFlags\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-md2man-5.1.2","nativeBuildInputs":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook","out":"/nix/store/kk5iiyp9vqq7fq2im8dqypglnipwxhi7-ruby3.4-md2man-5.1.2","outputs":"out","patches":"","propagatedBuildInputs":"/nix/store/bx2inlivg4rm0wd6gx1lskrp0nblbc5a-ruby3.4-binman-5.1.0 /nix/store/i0kwl3vvdxyl67nmq4zz0c07a9x9sw67-ruby3.4-redcarpet-3.6.1 /nix/store/wip8a491dncgnvawvy9rrcllvsznvrwb-ruby3.4-rouge-3.30.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/bx2inlivg4rm0wd6gx1lskrp0nblbc5a-ruby3.4-binman-5.1.0 /nix/store/i0kwl3vvdxyl67nmq4zz0c07a9x9sw67-ruby3.4-redcarpet-3.6.1 /nix/store/wip8a491dncgnvawvy9rrcllvsznvrwb-ruby3.4-rouge-3.30.0","ruby":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8","src":"/nix/store/mbpsi27s2yzqmivx7gm7alkmz68921ra-md2man-5.1.2.gem","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","suffix":"5.1.2","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"5.1.2"},"inputs":{"drvs":{"0anzqcbhlbc78v3chh29b0p3w5k9qjrr-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"0ipb5ab48s8syn2d7rani13si7jla20p-md2man-5.1.2.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"1fncgppkihybqjszvjlpj5r38fizrkrn-ruby3.4-redcarpet-3.6.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"3kw9pfar2j9gkmbj67dj1xj4vj8v2pk8-ruby3.4-rouge-3.30.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"mrkfw9ml7pzvl315b2iasccmcbm3w7i4-ruby3.4-binman-5.1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"p2s3ijk7krn4zi5bn7x1g1gs1bipa7iv-ruby-3.4.8.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-md2man-5.1.2","outputs":{"out":{"path":"kk5iiyp9vqq7fq2im8dqypglnipwxhi7-ruby3.4-md2man-5.1.2"}},"system":"x86_64-linux","version":4},"qkics4b5lgl1d98ad19vslda1vc00j8a-bootstrap-stage4-stdenv-linux.drv":{"args":["-e","/nix/store/cnss4bmvsa7kjmghgksgcadrxsvkyla1-builder.sh"],"builder":"/nix/store/razasrvdg7ckplfmvdxv4ia3wbayr94s-bootstrap-too