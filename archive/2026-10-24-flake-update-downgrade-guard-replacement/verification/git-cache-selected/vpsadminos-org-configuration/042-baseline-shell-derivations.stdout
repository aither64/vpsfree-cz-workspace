b \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.3-treetop-1.6.18","nativeBuildInputs":"/nix/store/y1jhbdp5hazr8ayacvkjzxwhfcajbzsr-ruby-3.3.10 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook","out":"/nix/store/nq83jjd5nb967aiak921x6yfg6jfrdj8-ruby3.3-treetop-1.6.18","outputs":"out","patches":"","propagatedBuildInputs":"/nix/store/gfgsczhirns5yhsmfrhvckc1914hba5g-ruby3.3-polyglot-0.3.5","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/gfgsczhirns5yhsmfrhvckc1914hba5g-ruby3.3-polyglot-0.3.5","ruby":"/nix/store/y1jhbdp5hazr8ayacvkjzxwhfcajbzsr-ruby-3.3.10","src":"/nix/store/agzy3pzqqwmcgqkimpwmppqy87j49ckk-treetop-1.6.18.gem","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","suffix":"1.6.18","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"1.6.18"},"inputs":{"drvs":{"0anzqcbhlbc78v3chh29b0p3w5k9qjrr-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"47w3pvjxbgzkj42cqpwf1r0xnyn9wpgd-ruby3.3-polyglot-0.3.5.drv":{"dynamicOutputs":{},"outputs":["out"]},"bjyryppfrigfwz56wd9ykpwz26g94bjf-ruby-3.3.10.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"m03f9axr9ldvifasr0xay1g12ms98a6p-treetop-1.6.18.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.3-treetop-1.6.18","outputs":{"out":{"path":"nq83jjd5nb967aiak921x6yfg6jfrdj8-ruby3.3-treetop-1.6.18"}},"system":"x86_64-linux","version":4},"p899fm65y45lslrbzwq4d9sx2pf048vj-perl5.40.0-Moo-2.005005.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/380ibq4l01y2bphpsdxp5q9w5szmj3y1-builder.sh"],"builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","env":{"AUTOMATED_TESTING":"1","PERL_AUTOINSTALL":"--skipdeps","PERL_USE_UNSAFE_INC":"1","__structuredAttrs":"","buildInputs":"/nix/store/6kmhn4jhq5ymis9yyapcj5fzr9ijs9ba-perl5.40.0-Test-Fatal-0.017 /nix/store/x17gg3w7lcwiqscqmif25688sivchwsn-perl-5.40.0","builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","checkTarget":"test","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":""