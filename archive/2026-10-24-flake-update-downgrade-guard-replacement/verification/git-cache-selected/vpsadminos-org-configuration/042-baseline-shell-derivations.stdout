pagated":"","dev":"/nix/store/7fl4big89al2p3h8gn6h7165112n4xz9-openssh-10.2p1-dev","doCheck":"","doInstallCheck":"1","enableParallelBuilding":"1","enableParallelChecking":"","enableParallelInstalling":"1","installCheckPhase":"for binary in ssh sshd; do\n  $out/bin/$binary -V 2>&1 | grep -P \"$(printf '^OpenSSH_\\\\Q%s\\\\E,' \"$version\")\"\ndone\n","installFlags":"sysconfdir=${out}/etc/ssh","installTargets":"install-nokeys","man":"/nix/store/qxbkvk7nr7pj8aby5lanzbpxli56k2yp-openssh-10.2p1-man","mesonFlags":"","name":"openssh-10.2p1","nativeBuildInputs":"/nix/store/hlch10mig4b11rcwy56f3q046w0glivf-autoreconf-hook /nix/store/i7s4dyaj2qz5bczzycybq850pj4iygim-pkg-config-wrapper-0.29.2","out":"/nix/store/wn31bzs6yk4gy35lpba3iwvp9dgqpgvz-openssh-10.2p1","outputs":"out dev man","patches":"/nix/store/isik6ifcjxpw22sfh3kz37galficc78c-locale_archive.patch /nix/store/ybb4xs45dkngdf3x1xnxqgzn5zmv5alf-dont_create_privsep_path.patch /nix/store/ys0myn64qkrcgkpr4s6wfl7p4g7pz4c6-pkcs11-fetchkey-error-to-debug.patch /nix/store/fg450z16mnn3nylcn2dqm0nvr91y60wz-pkcs11-fix-pinentry.patch /nix/store/8bj5dmqd71xpvjcgwil1k14wcv8gd6vf-pkcs11-tests-allow-module-path.patch /nix/store/ki4ib9b9w16f05zzrhajdbvsbs3rkx51-ssh-agent-tests-increase-timeout.patch /nix/store/7jbzj9s2wkbznn93ga3aqka6vfx06gjg-ssh-keysign-8.5.patch","pname":"openssh","postInstall":"# Install ssh-copy-id, it's very useful.\ncp contrib/ssh-copy-id $out/bin/\nchmod +x $out/bin/ssh-copy-id\ncp contrib/ssh-copy-id.1 $man/share/man/man1/\n","postPatch":"substituteInPlace Makefile.in --replace-fail '$(INSTALL) -m 4711' '$(INSTALL) -m 0711'\n","preCheck":"# construct a dummy HOME\nexport HOME=$(realpath ../dummy-home)\nmkdir -p ~/.ssh\n\n# construct a dummy /etc/passwd file for the sshd under test\n# to use to look up the connecting user\nDUMMY_PASSWD=$(realpath ../dummy-passwd)\ncat > $DUMMY_PASSWD <<EOF\n$(whoami)::$(id -u):$(id -g)::$HOME:$SHELL\nEOF\n\n# we need to NIX_REDIRECTS /etc/passwd both for processes\n# invoked directly and those invoked by the \"remote\" session\ncat > ~/.ssh/environment.base <<EOF\nNIX_REDIRECTS=/etc/passwd=$DUMMY_PASSWD\nLD_PRELOAD=/nix/store/0y1g1s9vwl7an9f9713zwa5c712md15d-libredirect-0/lib/libredirect.so\nEOF\n\n# use an ssh environment file to ensure environment is set\n# up appropriately for build environment even when no shell\n# is invoked by the ssh session. otherwise the PATH will\n# only contain default unix paths like /bin which we don't\n# have in our build environment\ncat - regress/test-exec.sh > regress/test-exec.sh.new <<EOF\ncp $HOME/.ssh/environment.base $HOME/.ssh/environment\necho \"PATH=\\$PATH\" >> $HOME/.ssh/environment\nEOF\nmv regress/test-exec.sh.new regress/test-exec.sh\n\n# explicitly enable the PermitUserEnvironment feature\nsubstituteInPlace regress/test-exec.sh \\\n  --replace-fail \\\n    'cat << EOF > $OBJ/sshd_config' \\\n    $'cat << EOF > $OBJ/sshd_config\\n\\tPermitUserEnvironment yes'\n\n# some tests want to use files under /bin as example files\nfor f in regress/sftp-cmds.sh regress/forwarding.sh; do\n  substituteInPlace $f --replace-fail '/bin' \"$(dirname $(type -p ls))\"\ndone\n\n# set up NIX_REDIRECTS for direct invocations\nset -a; source ~/.ssh/environment.base; set +a\n# The extra tests check PKCS#11 interactions, which softhsm emulates with software only\nsubstituteInPlace regress/test-exec.sh \\\n  --replace-fail /usr/local/lib/softhsm/libsofthsm2.so /nix/store/1kvim64v3fi01mgc7j7ync6igxv5bbym-softhsm-2.6.1/lib/softhsm/libsofthsm2.so\n","preConfigure":"# Setting LD causes `configure' and `make' to disagree about which linker\n# to use: `configure' wants `gcc', but `make' wants `ld'.\nunset LD\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/lsskanh5af05s5mwnjzvbmmv1sq9n4si-openssh-10.2p1.tar.gz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"10.2p1"},"inputs":{"drvs":{"0p03gxrjwiy45q0gjifmxzm72r80k0k4-opens