x","version":4},"vmgdkkp6yjzb7blal5478qn3m905whm8-ruby3.4-http-accept-1.7.0.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","env":{"NIX_CFLAGS_COMPILE":"","NIX_MAIN_PROGRAM":"http-accept","__structuredAttrs":"","buildInputs":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8","buildPhase":"runHook preBuild\n\nif [[ \"$gemType\" == \"gem\" ]]; then\n  if [[ -z \"$gemspec\" ]]; then\n    gemspec=\"$(find . -name '*.gemspec')\"\n    echo \"found the following gemspecs:\"\n    echo \"$gemspec\"\n    gemspec=\"$(echo \"$gemspec\" | head -n1)\"\n  fi\n\n  exec 3>&1\n  output=\"$(gem build $gemspec | tee >(cat - >&3))\"\n  exec 3>&-\n\n  gempkg=$(echo \"$output\" | grep -oP 'File: \\K(.*)')\n\n  echo \"gem package built: $gempkg\"\nelif [[ \"$gemType\" == \"git\" ]]; then\n  git init\n  # remove variations to improve the likelihood of a bit-reproducible output\n  rm -rf .git/logs/ .git/hooks/ .git/index .git/FETCH_HEAD .git/ORIG_HEAD .git/refs/remotes/origin/HEAD .git/config\n  # support `git ls-files`\n  git add .\nfi\n\nrunHook postBuild\n","builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","document":"","dontBuild":"1","dontStrip":"","gemName":"http-accept","gemPath":"","gemType":"gem","groups":"default","installPhase":"runHook preInstall\n\nexport GEM_HOME=$out/lib/ruby/gems/3.4.0\nmkdir -p $GEM_HOME\n\necho \"buildFlags: $buildFlags\"\n\n\n\n\nif [[ -z \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path unspecified\" 1>&2\n  exit 1\nelif [[ ! -f \"$gempkg\" ]]; then\n  echo \"failure: \\$gempkg path invalid\" 1>&2\n  exit 1\nfi\n\ngem install \\\n  --local \\\n  --force \\\n  --http-proxy 'http://nodtd.invalid' \\\n  --ignore-dependencies \\\n  --install-dir \"$GEM_HOME\" \\\n  --build-root '/' \\\n  --backtrace \\\n  --no-env-shebang \\\n  -N \\\n  $gempkg $gemFlags -- $buildFlags\n\n# looks like useless files which break build repeatability and consume space\npushd $out/lib/ruby/gems/3.4.0\nfind doc/ -iname created.rid -delete -print\nfind gems/*/ext/ extensions/ \\( -iname Makefile -o -iname mkmf.log -o -iname gem_make.out \\) -delete -print\nrm -fvr cache\npopd\n\n# write out metadata and binstubs\nspec=$(echo $out/lib/ruby/gems/3.4.0/specifications/*.gemspec)\nruby /nix/store/qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb \"$spec\"\n\n\nfor section in {1..9}; do\n  mandir=\"$out/share/man/man$section\"\n  find $out/lib \\( -wholename \"*/man/*.$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-http-accept-1.7.0","nativeBuildInputs":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook","out":"/nix/store/lqn3dap9p16j5jxi5585g3b269czvgb4-ruby3.4-http-accept-1.7.0","outputs":"out","patches":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"","ruby":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8","src":"/nix/store/vyr9jg79fkjpgyffmxzw4l7641i5jvny-http-accept-1.7.0.gem","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","suffix":"1.7.0","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"1.7.0"},"inputs":{"drvs":{"0anzqcbhlbc78v3chh29b0p3w5k9qjrr-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"p2s3ijk7krn4zi5bn7x1g1gs1bipa7iv-ruby-3.4.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"wd5gy41w12kpzkp0sdka0akpk2c913zd-http-accept-1.7.0.gem.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","qjj178v5f2afrzqkp6mvpzsyi1856mf3-gem-post-build.rb","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"ruby3.4-http-accept-1.7.0","outputs":{"out":{"path":"lqn3dap9p16j5jxi5585g3b269czvgb4-ruby3.4-http-accept-1.7.0"}},"system":"x86_64-linux","version":4},"vmhss394mpk9262p6jijry11g72pwpgg-gettext-0.25.1.tar.gz.drv":{"args":[],"builder":"builtin:fetchurl","env":{"builder":"builtin:fetchurl","executable":"","impureEnvVars":"http_proxy https_proxy ftp_proxy all_proxy no_proxy","name":"gettext-0.25.1.tar.gz","out":"/nix/store/q4axdvr6qjxqxyf97jmv6wh8lklp1r5p-gettext-0.25.1.tar.gz","outputHas