instubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.3-prawn-svg-0.34.2","nativeBuildInputs":"/nix/store/y1jhbdp5hazr8ayacvkjzxwhfcajbzsr-ruby-3.3.10 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook","out":"/nix/store/krsyd4r9nw8y08jklcgi5f5s2s7gpq8k-ruby3.3-prawn-svg-0.34.2","outputs":"out","patches":"","propagatedBuildInputs":"/nix/store/2q4k85nh0bm80979n4q8m0kk86j2xnhz-ruby3.3-css_parser-1.21.1 /nix/store/72b7k8m5m0k5zvp4wznvb21zxc6ydkky-ruby3.3-matrix-0.4.3 /nix/store/5bdqd2jjrycnyw3w5xnnrc3nqqmlpjz1-ruby3.3-prawn-2.4.0 /nix/store/81ci1fc0xfq8v952i30lxcclvpd2wz46-ruby3.3-rexml-3.4.4","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/2q4k85nh0bm80979n4q8m0kk86j2xnhz-ruby3.3-css_parser-1.21.1 /nix/store/72b7k8m5m0k5zvp4wznvb21zxc6ydkky-ruby3.3-matrix-0.4.3 /nix/store/5bdqd2jjrycnyw3w5xnnrc3nqqmlpjz1-ruby3.3-prawn-2.4.0 /nix/store/81ci1fc0xfq8v952i30lxcclvpd2wz46-ruby3.3-rexml-3.4.4","ruby":"/nix/store/y1jhbdp5hazr8ayacvkjzxwhfcajbzsr-ruby-3.3.10","src":"/nix/store/vmg570v84akvv12n2d3xawd229q87nq5-prawn-svg-0.34.2.gem","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","suffix":"0.34.2","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # 