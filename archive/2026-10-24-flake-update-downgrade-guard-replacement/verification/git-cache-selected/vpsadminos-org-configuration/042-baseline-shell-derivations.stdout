onfigureFlags\n./Setup configure $configureFlags 2>&1 | /nix/store/vzx1mi9c0xfadmsm9dhd83d005cb1qs9-coreutils-9.8/bin/tee \"$NIX_BUILD_TOP/cabal-configure.log\"\nif grep -E -q -z 'Warning:.*depends on multiple versions' \"$NIX_BUILD_TOP/cabal-configure.log\"; then\n  echo >&2 \"*** abort because of serious configure-time warning from Cabal\"\n  exit 1\nfi\n\n\nrunHook postConfigure\n","configurePlatforms":"","depsBuildBuild":"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","haddockPhase":"runHook preHaddock\n\nrunHook postHaddock\n","hardeningDisable":"","installPhase":"runHook preInstall\n\n./Setup copy \nlocal packageConfDir=\"$out/lib/ghc-9.8.4/lib/package.conf.d\"\nlocal packageConfFile=\"$packageConfDir/ghc-toolchain-9.10.3.conf\"\nmkdir -p \"$packageConfDir\"\n./Setup register --gen-pkg-config=$packageConfFile\nif [ -d \"$packageConfFile\" ]; then\n  mv \"$packageConfFile/\"* \"$packageConfDir\"\n  rmdir \"$packageConfFile\"\nfi\nfor packageConfFile in \"$packageConfDir/\"*; do\n  local pkgId=$(gawk -f /nix/store/907d7wf2d113vlv8dlhi1i3d683gc1rs-unpretty-cabal-conf.awk \"$packageConfFile\" \\\n    | grep '^id:' | cut -d' ' -f2)\n  mv \"$packageConfFile\" \"$packageConfDir/$pkgId.conf\"\ndone\n\n# delete confdir if there are no libraries\nfind $packageConfDir -maxdepth 0 -empty -delete;\n\n\n\n\n\n\n\n\n\n\nrunHook postInstall\n","mesonFlags":"","name":"ghc-toolchain-9.10.3","nativeBuildInputs":"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4 /nix/store/j2c51aym9mdv6h4kmxm0r5syldrcyxl7-remove-references-to","out":"/nix/store/8gaz1ydkshnf74zzc54y4rqa0b14wkmr-ghc-toolchain-9.10.3","outputs":"out","patches":"","pname":"ghc-toolchain","postPatch":"","postUnpack":"sourceRoot=\"$sourceRoot/utils/ghc-toolchain\"\n","preConfigurePhases":"compileBuildDriverPhase","preInstallPhases":"haddockPhase","prePatch":"\nsed -i -e 's/\\r$//' *.cabal\n","prePhases":"setupCompilerEnvironmentPhase","propagatedBuildInputs":"   /nix/store/glzlsy1y65br4gr0qjgfd0kh62lgvdjg-ghc-platform-9.10.3   ","propagatedNativeBuildInputs":"","setOutputFlags":"","setupCompilerEnvironmentPhase":"NIX_BUILD_CORES=$(( NIX_BUILD_CORES < 16 ? NIX_BUILD_CORES : 16 ))\nrunHook preSetupCompilerEnvironment\n\necho \"Build with /nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4.\"\nexport PATH=/nix/store/dp4gjbz0jbrldqc90vgk8gpasa79hn6b-hscolour-1.25/bin:$PATH\n\nbuilddir=\"$(mktemp -d)\"\nsetupPackageConfDir=\"$builddir/setup-package.conf.d\"\nmkdir -p $setupPackageConfDir\npackageConfDir=\"$builddir/package.conf.d\"\nmkdir -p $packageConfDir\n\nsetupCompileFlags=\"-package-db=$setupPackageConfDir -threaded\"\nconfigureFlags=\"--verbose --prefix=$out --libdir=\\$prefix/lib/\\$compiler/lib --libsubdir=\\$abi/\\$libname   --with-gcc=$CC --package-db=$packageConfDir   --ghc-option=-j$NIX_BUILD_CORES --ghc-option=+RTS --ghc-option=-A64M --ghc-option=-RTS  --disable-library-profiling  --disable-profiling --disable-shared --disable-coverage --enable-static --disable-executable-dynamic --disable-tests --disable-benchmarks --enable-library-vanilla --disable-library-for-ghci --enable-split-sections --enable-library-stripping --enable-executable-stripping $configureFlags\"\nfor p in \"${pkgsBuildBuild[@]}\" \"${pkgsBuildHost[@]}\" \"${pkgsBuildTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $setupPackageConfDir/\n  continue\nfi\n\ndone\nghc-pkg --package-db=\"$setupPackageConfDir\" recache\nfor p in \"${pkgsHostHost[@]}\" \"${pkgsHostTarget[@]}\"; do\n  # If this dependency has a package database, then copy the contents of it,\n# unless it is one of our GHCs. These can appear in our dependencies when\n# we are doing native builds, and they have package databases in them, but\n# we do not want to copy them over.\n#\n# We don't need to, since those packages will be provided by the GHC when\n# we compile with it, and doing so can result in having multiple copies of\n# e.g. Cabal in the database with the same name and version, which is\n# ambiguous.\nif [ -d \"$p/lib/ghc-9.8.4/lib/package.conf.d\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ] && [ \"$p\" != \"/nix/store/59arrqvrp6rvcb4387fp2imb69ai7lnl-ghc-binary-9.8.4\" ]; then\n  cp -f \"$p/lib/ghc-9.8.4/lib/package.conf.d/\"*.conf $packageConfDir/\n  continue\nfi\n\n  if [ -d \"$p/include\" ]; then\n    appendToVar configureFlags \"--extra-include-dirs=$p/include\"\n  fi\n  if [ -d \"$p/lib\" ]; then\n    appendToVar configureFlags \"--extra-lib-dirs=$p/lib\"\n  fi\n  if [[ -d \"$p/Library/Frameworks\" ]]; then\n    appendToVar configureFlags \"--extra-framework-dirs=$p/Library/Frameworks\"\n  fi\ndone\nghc-pkg --package-db=\"$packageConfDir\" recache\n\nrunHook postSetupCompilerEnvironment\n","src":"/nix/store/5ksay9gyym23iljzp13qmsdvycqg5bgc-ghc-9.10.3-source","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"9.10.3"},"inputs":{"drvs":{"7i8x2fq0lp2qqnmianjz7j2zikk7pp0k-ghc-binary-9.8.4.drv":{"dynamicOut