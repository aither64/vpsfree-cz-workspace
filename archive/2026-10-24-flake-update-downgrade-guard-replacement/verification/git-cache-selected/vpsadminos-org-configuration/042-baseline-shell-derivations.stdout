72q0m0zmv8yzn261lpyjghqqhg-groff-1.23.0 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook /nix/store/i7s4dyaj2qz5bczzycybq850pj4iygim-pkg-config-wrapper-0.29.2 /nix/store/l8ysbzk9vyvx85i2vmclp088i6f48z73-zstd-1.5.7-dev /nix/store/0nyxvip6ssikwprfgbjnxjyib7amgldg-glibc-iconv-2.40","out":"/nix/store/sxaag4v42mhn9kif0abhpbhmg8wvicf9-man-db-2.13.1","outputMan":"out","outputs":"out doc","patches":"/nix/store/p4m9shlpsqrvir464livcdni0y32ah3f-systemwide-man-db-conf.patch","pname":"man-db","postInstall":"# apropos/whatis uses program name to decide whether to act like apropos or whatis\n# (multi-call binary). `apropos` is actually just a symlink to whatis. So we need to\n# make sure that we don't wrap symlinks (since that changes argv[0] to the -wrapped name)\nfind \"$out/bin\" -type f | while read file; do\n  wrapProgram \"$file\" \\\n    --prefix PATH : \"/nix/store/n5yvjw72q0m0zmv8yzn261lpyjghqqhg-groff-1.23.0/bin:/nix/store/dv49sc8jjw07mp9ns7m2m63dl96r1j84-gzip-1.14/bin:/nix/store/q37rpd3sz0j0zsbsgxz1py9k42bnng1q-zstd-1.5.7-bin/bin\"\ndone\n","postPatch":"# Remove all mandatory manpaths. Nixpkgs makes no requirements on\n# these directories existing.\nsed -i 's/^MANDATORY_MANPATH/# &/' src/man_db.conf.in\n\n# Add Nix-related manpaths\necho \"MANPATH_MAP\t/nix/var/nix/profiles/default/bin\t/nix/var/nix/profiles/default/share/man\" >> src/man_db.conf.in\n\n# Add mandb locations for the above\necho \"MANDB_MAP\t/nix/var/nix/profiles/default/share/man\t/var/cache/man/nixpkgs\" >> src/man_db.conf.in\n","preConfigure":"configureFlagsArray+=(\"--with-sections=1 n l 8 3 0 2 5 4 9 6 7\")\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/1hc6y3h868dliqih8gmghqqm32sdhwra-man-db-2.13.1.tar.xz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"2.13.1"},"inputs":{"drvs":{"0anzqcbhlbc78v3chh29b0p3w5k9qjrr-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["o