cOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"mpx8w59h2lmz7i8i5wywp374hlvbhfbm-docbook-xml-4.3.zip.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"]},"name":"docbook-xml-4.3","outputs":{"out":{"path":"cdsbgbyhaz61mrmja2fhmraf24ap1dax-docbook-xml-4.3"}},"system":"x86_64-linux","version":4},"lkxh7b0003xiwin8y422vyjd47mwm08b-busybox-1.36.1.drv":{"args":["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","env":{"NIX_HARDENING_ENABLE":"bindnow libcxxhardeningextensive libcxxhardeningfast pic relro stackclashprotection stackprotector strictoverflow zerocallusedregs","NIX_MAIN_PROGRAM":"busybox","__structuredAttrs":"","buildInputs":"","builder":"/nix/store/wv8bpzriikv65xnd1vciqpq7rnr8h2q2-bash-5.3p3/bin/bash","cmakeFlags":"","configureFlags":"","configurePhase":"export KCONFIG_NOTIMESTAMP=1\nmake allnoconfig\n\nfunction parseconfig {\n    while read LINE; do\n        NAME=`echo \"$LINE\" | cut -d \\  -f 1`\n        OPTION=`echo \"$LINE\" | cut -d \\  -f 2`\n\n        if ! [[ \"$NAME\" =~ ^CONFIG_ ]]; then continue; fi\n\n        echo \"parseconfig: removing $NAME\"\n        sed -i /$NAME'\\(=\\| \\)'/d .config\n\n        echo \"parseconfig: setting $NAME=$OPTION\"\n        echo \"$NAME=$OPTION\" >> .config\n    done\n}\n\n\ncat << EOF | parseconfig\n\nCONFIG_PREFIX \"$out\"\nCONFIG_INSTALL_NO_USR y\n\nCONFIG_LFS y\n\n# More features for modprobe.\n\n\nCONFIG_STATIC y\n\n\n\n\n# Use the external mount.cifs program.\nCONFIG_FEATURE_MOUNT_CIFS n\nCONFIG_FEATURE_MOUNT_HELPERS y\n\n# Set paths for console fonts.\nCONFIG_DEFAULT_SETFONT_DIR \"/etc/kbd\"\n\n# Bump from 4KB, much faster I/O\nCONFIG_FEATURE_COPYBUF_KB 64\n\n# Doesn't build with current kernel headers.\n# https://bugs.busybox.net/show_bug.cgi?id=15934\nCONFIG_TC n\n\n# Set the path for the udhcpc script\nCONFIG_UDHCPC_DEFAULT_SCRIPT \"$out/default.script\"\n\nCONFIG_FEATURE_FANCY_ECHO y\nCONFIG_FEATURE_SH_MATH y\nCONFIG_FEATURE_SH_MATH_64 y\nCONFIG_FEATURE_TEST_64 y\n\nCONFIG_ASH y\nCONFIG_ASH_OPTIMIZE_FOR_SIZE y\n\nCONFIG_ASH_ALIAS y\nCONFIG_ASH_BASH_COMPAT y\nCONFIG_ASH_CMDCMD y\nCONFIG_ASH_ECHO y\nCONFIG_ASH_GETOPTS y\nCONFIG_ASH_INTERNAL_GLOB y\nCONFIG_ASH_JOB_CONTROL y\nCONFIG_ASH_PRINTF y\nCONFIG_ASH_TEST y\n\nCONFIG_CROSS_COMPILER_PREFIX \"\"\nCONFIG_FEATURE_UTMP n\nCONFIG_FEATURE_WTMP n\n\nEOF\n\nmake oldconfig\n\nrunHook postConfigure\n","debug":"/nix/store/0saqgmy20fzqyywy6cjg0b5nxyba7rdq-busybox-1.36.1-debug","depsBuildBuild":"/nix/store/kilyfvfmh9x9rlaj47ph1916lbc1pnsr-gcc-wrapper-14.3.0","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"","doInstallCheck":"","enableParallelBuilding":"1","enableParallelChecking":"1","enableParallelInstalling":"1","hardeningDisable":"format fortify","makeFlags":"SKIP_STRIP=y","mesonFlags":"","name":"busybox-1.36.1","nativeBuildInputs":"/nix/store/r989dk196nl9frhnfsa1lb7knhbyjxw6-separate-debug-info.sh","out":"/nix/store/1xbb7mkcwzpci1sifmiw4ag1ynllzcba-busybox-1.36.1","outputs":"out debug","patches":"/nix/store/7wpjbl21q85z0vrqdx4c7lxg6n4rgwh7-busybox-in-store.patch /nix/store/z7d0iap9j4r6kbdlrnsq4m7pbgy8nd6p-CVE-2022-28391.patch /nix/store/4py33501xzlyp3v5gmcv09znpvhmimmd-CVE-2022-28391.patch /nix/store/kajdbrsl5nfwcpb8g3v99j0wpjl905cw-CVE-2022-48174.patch /nix/store/cs3203ij40ydc6g687hq0p2xfixny78q-CVE-2023-42366.patch /nix/store/iaqndcikwjwjajr0ssjjdsxfh2mada1l-CVE-2023-42363.patch /nix/store/f991ddy4f5a2gch3vz0ll6nskcxk5744-CVE-2023-42364_CVE-2023-42365.patc