g Aws.h to avoid\n# having to pass `AWS_CORE_HEADER_FILE` explicitly to cmake configure\n# when using find_package(AWSSDK CONFIG)\nsubstituteInPlace cmake/AWSSDKConfig.cmake \\\n  --replace 'C:/AWSSDK/${AWSSDK_INSTALL_INCLUDEDIR}/aws/core' \\\n    'C:/AWSSDK/${AWSSDK_INSTALL_INCLUDEDIR}/aws/core\"\n        \"/02qcpld1y6xhs5gz9bchpxaw0xdhmsp5dv88lh25r2ss44kh8dxz/include/aws/core'\n\n# Avoid blanket -Werror to evade build failures on less\n# tested compilers.\nsubstituteInPlace cmake/compiler_settings.cmake \\\n  --replace '\"-Werror\"' ' '\n\n# Flaky on Hydra\nrm tests/aws-cpp-sdk-core-tests/aws/auth/AWSCredentialsProviderTest.cpp\nrm tests/aws-cpp-sdk-core-tests/aws/client/AWSClientTest.cpp\nrm tests/aws-cpp-sdk-core-tests/aws/client/AwsConfigTest.cpp\n# Includes aws-c-auth private headers, so only works with submodule build\nrm tests/aws-cpp-sdk-core-tests/aws/auth/AWSAuthSignerTest.cpp\n# TestRandomURLMultiThreaded fails\nrm tests/aws-cpp-sdk-core-tests/http/HttpClientTest.cpp\n","propagatedBuildInputs":"/nix/store/31w7h6hjl4dyk5mgb9pbsrcxvyx6zjjy-aws-crt-cpp-0.34.3-dev","propagatedNativeBuildInputs":"","requiredSystemFeatures":"","src":"/nix/store/bgqxv8zfvfq6p2845f6j80n13fk1y7bg-source","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.11.647"},"inputs":{"drvs":{"4h4gq0wpzj8amvbs2h9jmla5j9b39sqp-cmake-4.1.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"5y6a9rw2gwj6ifa4icc75xikq31pjhx2-openssl-3.6.1.drv":{"dynamicOutputs":{},"outputs":["dev"]},"ck21bbdpc5inhxhkw5bgigmd4i0ygdz9-zlib-1.3.2.drv":{"dynamicOutputs":{},"outputs":["dev"]},"drsbr715b4c9pfsqxx9m0bhjn2zaswzp-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"nk7srgibl26nz3m33h66rvmxfdncy1vy-curl-8.19.0.drv":{"dynamicOutputs":{},"outputs":["dev"]},"vyzmkaa2