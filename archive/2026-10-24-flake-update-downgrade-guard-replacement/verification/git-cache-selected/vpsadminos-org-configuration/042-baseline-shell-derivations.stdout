gure":"","postPatch":"# disable broken 'nametabletest' test, fails on gcc-13:\n#   https://github.com/silnrsi/graphite/pull/74\nsubstituteInPlace tests/CMakeLists.txt \\\n  --replace 'add_subdirectory(nametabletest)' '#add_subdirectory(nametabletest)'\n\n# support cross-compilation by using target readelf binary:\nsubstituteInPlace Graphite.cmake \\\n  --replace 'readelf' \"readelf\"\n\n# headers are located in the dev output:\nsubstituteInPlace CMakeLists.txt \\\n  --replace-fail ' ${CMAKE_INSTALL_PREFIX}/include' \" /02qcpld1y6xhs5gz9bchpxaw0xdhmsp5dv88lh25r2ss44kh8dxz/include\"\n\n# Fix the build with CMake 4.\n#\n# See: <https://github.com/silnrsi/graphite/issues/98>\nbadCmakeFiles=(\n  CMakeLists.txt\n  src/CMakeLists.txt\n  tests/{bittwiddling,json,sparsetest,utftest}/CMakeLists.txt\n  gr2fonttest/CMakeLists.txt\n)\nfor file in \"${badCmakeFiles[@]}\"; do\n  substituteInPlace \"$file\" \\\n    --replace-fail \\\n      'CMAKE_MINIMUM_REQUIRED(VERSION 2.8.0 FATAL_ERROR)' \\\n      'CMAKE_MINIMUM_REQUIRED(VERSION 3.10 FATAL_ERROR)'\ndone\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/366q28w1fn667n3qnhdnqlci49fnvicc-graphite2-1.3.14.tgz","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"1.3.14"},"inputs":{"drvs":{"0vgf8xan18x19ikjnwdg3pa7bdi30g7y-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"16bw705576148d4r7cqk2fjskcq5ivm2-graphite2-1.3.14.tgz.drv":{"dynamicOutputs":{},"outputs":["out"]},"4h4gq0wpzj8amvbs2h9jmla5j9b39sqp-cmake-4.1.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"9gh6r9s9n4cy3y15b9v3jf14q80rl55y-freetype-2.13.3.drv":{"dynamicOutputs":{},"outputs":["dev"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"sp6dgjp9xvsr1rhsnyj255ibbym9i8xx-graphite2-1.3.14-gcc15.patch.drv":{"dynamicOutputs":{}