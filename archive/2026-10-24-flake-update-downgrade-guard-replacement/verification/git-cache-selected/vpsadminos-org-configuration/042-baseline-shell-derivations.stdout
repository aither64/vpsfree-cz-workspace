$section\" -o -wholename \"*/man/man$section/*.$section\" \\) \\\n    -execdir mkdir -p $mandir \\; -execdir cp '{}' $mandir \\;\ndone\n\n\n# For Ruby-generated binstubs, shebang paths are already in Nix store but for\n# ruby used to build the package. Update them to match the host system. Note\n# that patchShebangsAuto ignores scripts where shebang line is already in Nix\n# store.\nif [[ -d $GEM_HOME/bin ]]; then\n  patchShebangs --update --host -- \"$GEM_HOME\"/bin\nfi\n\nrunHook postInstall\n","mesonFlags":"","name":"ruby3.4-haveapi-client-0.26.5","nativeBuildInputs":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8 /nix/store/7mak4di4q7xvlb4rpm19dyjf3829vqam-make-shell-wrapper-hook","out":"/nix/store/jgbf9cksw3kks96gpg716i2p34qh9hg8-ruby3.4-haveapi-client-0.26.5","outputs":"out","patches":"","propagatedBuildInputs":"/nix/store/j7i7hqkykr59qwzfq81wsr2qwwp28jnv-ruby3.4-activesupport-8.1.2 /nix/store/rap9j2yx3f3m0b068izz2if28csg8z9y-ruby3.4-highline-3.1.2 /nix/store/g4qkjk4m4vyrrhq9qw29449r0lqjm556-ruby3.4-json-2.18.1 /nix/store/smmb5az3f1701apwdxx9zlra7wayjyx4-ruby3.4-require_all-2.0.0 /nix/store/6bx0n8vr0w0qyc11195jqslqgvvfdcff-ruby3.4-rest-client-2.1.0 /nix/store/fi6q12vr43ys4j9mijs39xdh52vwchgs-ruby3.4-ruby-progressbar-1.13.0","propagatedNativeBuildInputs":"","propagatedUserEnvPkgs":"/nix/store/j7i7hqkykr59qwzfq81wsr2qwwp28jnv-ruby3.4-activesupport-8.1.2 /nix/store/rap9j2yx3f3m0b068izz2if28csg8z9y-ruby3.4-highline-3.1.2 /nix/store/g4qkjk4m4vyrrhq9qw29449r0lqjm556-ruby3.4-json-2.18.1 /nix/store/smmb5az3f1701apwdxx9zlra7wayjyx4-ruby3.4-require_all-2.0.0 /nix/store/6bx0n8vr0w0qyc11195jqslqgvvfdcff-ruby3.4-rest-client-2.1.0 /nix/store/fi6q12vr43ys4j9mijs39xdh52vwchgs-ruby3.4-ruby-progressbar-1.13.0","ruby":"/nix/store/x8nw3ljkdbwg0yrjmyjvx2c45qa3w5p5-ruby-3.4.8","src":"/nix/store/96p8bqy3fdi29wpsdyv5fj06lgxjx66z-haveapi-client-0.26.5.gem","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","suffix":"0.26.5","system":"x86_64-linux","type":"gem","unpackPhase":"runHook preUnpack\n\nif [[ -f $src && $src == *.gem ]]; then\n  if [[ -z \"${dontBuild-}\" ]]; then\n    # we won't know the name of the directory that RubyGems creates,\n    # so we'll just use a glob to find it and move it over.\n    gempkg=\"$src\"\n    sourceRoot=source\n    gem unpack $gempkg --target=container\n    cp -r container/* $sourceRoot\n    rm -r container\n\n    # copy out the original gemspec, for convenience during patching /\n    # overrides.\n    gem specification $gempkg  --ruby > original.gemspec\n    gemspec=$(readlink -f .)/original.gemspec\n  else\n    gempkg=\"$src\"\n  fi\nelse\n  # Fall back to the original thing for everything else.\n  dontBuild=\"\"\n  preUnpack=\"\" postUnpack=\"\" unpackPhase\nfi\n\nrunHook postUnpack\n","version":"0.26.5"},"inputs":{"drvs":{"0anzqcbhlbc78v3chh29b0p3w5k9qjrr-make-shell-wrapper-hook.drv":{"dynamicOutputs":{},"outputs":["out"]},"3ij2djjwd8rvw6xq467b4ap4jv8jldg5-ruby3.4-rest-client-2.1.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"64hvhg99zwx11r043ns466aabv8wfizc-ruby3.4-json-2.18.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"ckab1hgy2wi8hjj9a9f6nch4f279f97n-ruby3.4-activesupport-8.1.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"gqslg88724aahlrmm8w15bl1yv796k9v-ruby3.4-ruby-progressbar-1.13.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"j5rcjhvd2gm44y6730hak16dhhk16rlh-ruby3.4-highline-3.1.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"jcizxgcvx91f86i9q3qcwmmz3xdx9kir-haveapi-client-0.26.5.gem.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"p2s3ijk7krn4zi5bn7x1g1gs1bipa7iv-ruby-3.4.8.drv":{"dynamicOutputs":{},"outputs":["out"]},"p63vm2nhxwaiz39mhmv1rz5vhx15b4pg-ruby3.4-require_all-2.0.0.drv":{"dynamicOutputs":{},"outputs":["out"]}},"srcs":["l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.s