ric-kernels-for-SCAL-on-POWER4-5.patch","pname":"openblas","postInstall":"    # Write pkgconfig aliases. Upstream report:\n    # https://github.com/OpenMathLib/OpenBLAS/issues/1740\n    for alias in blas cblas lapack; do\n      cat <<EOF > $out/lib/pkgconfig/$alias.pc\nName: $alias\nVersion: 0.3.30\nDescription: $alias provided by the OpenBLAS package.\nCflags: -I$dev/include\nLibs: -L$out/lib -lopenblas\nEOF\n    done\n\n    # Setup symlinks for blas / lapack\nln -s $out/lib/libopenblas.so $out/lib/libblas.so\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so\nln -s $out/lib/libopenblas.so $out/lib/liblapacke.so\nln -s $out/lib/libopenblas.so $out/lib/libblas.so.3\nln -s $out/lib/libopenblas.so $out/lib/libcblas.so.3\nln -s $out/lib/libopenblas.so $out/lib/liblapack.so.3\nln -s $out/lib/libopenblas.so $out/lib/liblapacke.so.3\n","postPatch":"# cc1: error: invalid feature modifier 'sve2' in '-march=armv8.5-a+sve+sve2+bf16'\nsubstituteInPlace Makefile.arm64 --replace \"+sve2+bf16\" \"\"\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/1s6slcx7bkppwmipnzfbhrd4q5vdnbz7-source","stdenv":"/nix/store/sgz04vy3x5cvg9kqq9vlm93qi1n2pb6k-stdenv-linux","strictDeps":"","system":"x86_64-linux","version":"0.3.30"},"inputs":{"drvs":{"67wkbgxbg74qd44lnl0918prcsr23qvc-gcc-wrapper-14.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"f0iwc652ai39s868bxi62hzd985xqssi-bash-5.3p3.drv":{"dynamicOutputs":{},"outputs":["out"]},"g6fhakp65bdxvnrpvc3vbkms0cnw7pph-perl-5.40.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"hhdw1zrjypyjvz0nq5rj2f9ybbqq6vn2-source.drv":{"dynamicOutputs":{},"outputs":["out"]},"ly51m49zn8sglgk34161w0r7wmpa1sc1-gfortran-wrapper-14.3.0.drv":{"dynamicOutputs":{},"outputs":["out"]},"mn45jl98n7pc5h7afif3l772q5bxxh70-stdenv-linux.drv":{"dynamicOutputs":{},"outputs":["out"]},"pzxgr91h2b0637qm1gl2azcswxcv7kw3-0001-openblas-Use-generic-kernels-for-SCAL-on-POWER4-5.patch.drv":{"dynamicOutputs"