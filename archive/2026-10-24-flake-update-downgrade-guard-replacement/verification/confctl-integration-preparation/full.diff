@@ -0,0 +1,219 @@
+require 'spec_helper'
+require 'confctl/flake_lock'
+require 'confctl/inputs/forward_guard'
+
+RSpec.describe ConfCtl::Inputs::ForwardGuard do
+  let(:provider) { instance_double(ConfCtl::Inputs::GitCompare) }
+  let(:guard) { described_class.new(provider: provider) }
+
+  def source(rev = 'a' * 40, repo = 'source')
+    { 'locked' => { 'type' => 'github', 'owner' => 'example', 'repo' => repo, 'rev' => rev } }
+  end
+
+  def graph
+    {
+      'version' => 7,
+      'root' => 'entry',
+      'nodes' => {
+        'entry' => { 'inputs' => { 'parent' => 'p', 'alias' => %w[parent leaf] } },
+        'p' => source.merge('inputs' => { 'leaf' => 'l' }),
+        'l' => source('b' * 40, 'dependency')
+      }
+    }
+  end
+
+  def compare(owner: 'example', repo: 'source', old_rev: 'a' * 40, new_rev: 'c' * 40, result: :ahead)
+    expect(provider).to receive(:compare).with(owner: owner, repo: repo, old_rev: old_rev, new_rev: new_rev)
+                                         .once.and_return(result)
+  end
+
+  it 'accepts identical revisions locally, including an ordinary FlakeLock object' do
+    expect(provider).not_to receive(:compare)
+    result = guard.validate(ConfCtl::FlakeLock.new('old', graph), graph)
+    expect(result.status).to eq(:unchanged)
+    expect(result).to be_success
+    expect(result.changes).to be_empty
+  end
+
+  it 'ignores arbitrary generated node renumbering and input ordering' do
+    candidate = graph
+    candidate['nodes']['renumbered'] = candidate['nodes'].delete('l')
+    candidate['nodes']['p']['inputs']['leaf'] = 'renumbered'
+    expect(guard.validate(graph, candidate).status).to eq(:unchanged)
+  end
+
+  it 'accepts forward root revisions' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['rev'] = 'c' * 40
+    compare
+    result = guard.validate(graph, candidate)
+    expect(result.status).to eq(:updated)
+    expect(result.changes.map(&:path)).to eq(['parent'])
+    expect(result.changes.first.old_rev).to eq('a' * 40)
+  end
+
+  it 'checks all nested changes when the root revision is equal and deduplicates alias evidence' do
+    candidate = graph
+    candidate['nodes']['l']['locked']['rev'] = 'c' * 40
+    compare(repo: 'dependency', old_rev: 'b' * 40)
+    result = guard.validate(graph, candidate)
+    expect(result.status).to eq(:updated)
+    expect(result.changes.map(&:path)).to eq(['alias', 'parent/leaf'])
+  end
+
+  it 'rejects a nested rollback even when its parent advances' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['rev'] = 'c' * 40
+    candidate['nodes']['l']['locked']['rev'] = 'd' * 40
+    compare
+    compare(repo: 'dependency', old_rev: 'b' * 40, new_rev: 'd' * 40, result: :behind)
+    result = guard.validate(graph, candidate)
+    expect(result).to be_rejected
+    expect(result).not_to be_success
+    expect(result.issues.join).to include('parent/leaf', 'behind', 'b' * 40, 'd' * 40)
+  end
+
+  %i[behind diverged].each do |outcome|
+    it "rejects #{outcome} history despite newer candidate metadata" do
+      candidate = graph
+      candidate['nodes']['p']['locked'].merge!('rev' => 'c' * 40, 'lastModified' => 2_000_000_000)
+      compare(result: outcome)
+      expect(guard.validate(graph, candidate)).to be_rejected
+    end
+  end
+
+  it 'accepts merge and later-revert commits when they contain the original commit' do
+    candidate = graph
+    candidate['nodes']['p']['locked'].merge!('rev' => 'c' * 40, 'lastModified' => 1, 'narHash' => 'sha256-new')
+    compare
+    expect(guard.validate(graph, candidate)).to be_success
+  end
+
+  %w[repo owner host type dir].each do |attribute|
+    it "does not accept a changed #{attribute} as ordinary forward movement" do
+      candidate = graph
+      candidate['nodes']['p']['locked'].merge!(attribute => 'different', 'rev' => 'c' * 40)
+      expect(provider).not_to receive(:compare)
+      expect(guard.validate(graph, candidate)).not_to be_success
+    end
+  end
+
+  it 'normalizes github.com source names for ancestry queries' do
+    candidate = graph
+    candidate['nodes']['p']['locked'].merge!('rev' => 'c' * 40, 'owner' => 'EXAMPLE', 'repo' => 'SOURCE')
+    compare(owner: 'EXAMPLE', repo: 'SOURCE')
+    expect(guard.validate(graph, candidate)).to be_success
+  end
+
+  %w[narHash lastModified dir].each do |attribute|
+    it "rejects changed #{attribute} at an equal revision" do
+      candidate = graph
+      candidate['nodes']['p']['locked'][attribute] = attribute == 'lastModified' ? 100 : 'changed'
+      expect(provider).not_to receive(:compare)
+      expect(guard.validate(graph, candidate)).to be_rejected
+    end
+  end
+
+  it 'rejects switching between a flake and raw source' do
+    candidate = graph
+    candidate['nodes']['p']['flake'] = false
+    expect(guard.validate(graph, candidate)).to be_rejected
+  end
+
+  it 'permits revision updates to raw GitHub sources' do
+    old = graph
+    old['nodes']['l']['flake'] = false
+    candidate = Marshal.load(Marshal.dump(old))
+    candidate['nodes']['l']['locked']['rev'] = 'c' * 40
+    compare(repo: 'dependency', old_rev: 'b' * 40)
+    expect(guard.validate(old, candidate)).to be_success
+  end
+
+  it 'rejects removed logical paths even when they were aliases' do
+    candidate = graph
+    candidate['nodes']['entry']['inputs'].delete('alias')
+    result = guard.validate(graph, candidate)
+    expect(result).to be_rejected
+    expect(result.issues.join).to include('alias', 'removed')
+  end
+
+  it 'accepts new supported immutable dependencies and reports them' do
+    candidate = graph
+    candidate['nodes']['entry']['inputs']['new'] = 'n'
+    candidate['nodes']['n'] = source
+    result = guard.validate(graph, candidate)
+    expect(result.status).to eq(:updated)
+    expect(result.changes.map(&:path)).to eq(['new'])
+    expect(result.changes.first.old_node).to be_nil
+  end
+
+  it 'retains unchanged unsupported path sources without giving changed sources a bypass' do
+    old = graph
+    old['nodes']['l']['locked'] = { 'type' => 'path', 'path' => '/source' }
+    expect(guard.validate(old, old).status).to eq(:unchanged)
+    candidate = Marshal.load(Marshal.dump(old))
+    candidate['nodes']['l']['locked']['path'] = '/changed'
+    expect(guard.validate(old, candidate)).to be_error
+  end
+
+  it 'fails closed for unsupported new dependencies' do
+    candidate = graph
+    candidate['nodes']['entry']['inputs']['new'] = 'n'
+    candidate['nodes']['n'] = { 'locked' => { 'type' => 'tarball', 'url' => 'https://example.com/archive' } }
+    expect(guard.validate(graph, candidate)).to be_error
+  end
+
+  [nil, 'short', 'main'].each do |rev|
+    it "fails closed for nonimmutable revision #{rev.inspect}" do
+      candidate = graph
+      candidate['nodes']['p']['locked']['rev'] = rev
+      expect(guard.validate(graph, candidate)).to be_error
+    end
+  end
+
+  it 'fails closed for unknown extraction attributes without exposing their values' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['privateToken'] = 'secret-value'
+    result = guard.validate(graph, candidate)
+    expect(result).to be_error
+    expect(result.issues.join).not_to include('secret-value')
+  end
+
+  it 'reports unavailable provider evidence as an error even alongside a known rejection' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['rev'] = 'c' * 40
+    candidate['nodes']['l']['locked']['rev'] = 'd' * 40
+    allow(provider).to receive(:compare).and_raise(ConfCtl::Inputs::GitCompare::Error, 'Unavailable evidence')
+    compare(result: :behind)
+    expect(guard.validate(graph, candidate)).to be_error
+  end
+
+  it 'fails closed for unexpected provider outcomes' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['rev'] = 'c' * 40
+    compare(result: nil)
+    expect(guard.validate(graph, candidate)).to be_error
+  end
+
+  it 'deduplicates failed evidence requests shared by aliases' do
+    candidate = graph
+    candidate['nodes']['l']['locked']['rev'] = 'c' * 40
+    expect(provider).to receive(:compare).once.and_raise(ConfCtl::Inputs::GitCompare::Error, 'Unavailable evidence')
+    result = guard.validate(graph, candidate)
+    expect(result).to be_error
+    expect(result.issues.size).to eq(2)
+  end
+
+  it 'does not reuse comparison evidence for another revision pair or validation run' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['rev'] = 'c' * 40
+    expect(provider).to receive(:compare).twice.and_return(:ahead)
+    2.times { expect(guard.validate(graph, candidate)).to be_success }
+  end
+
+  it 'returns typed graph errors rather than accepting unsupported lock versions' do
+    candidate = graph
+    candidate['version'] = 100
+    expect(guard.validate(graph, candidate)).to be_error
+  end
+end
diff --git a/spec/inputs/git_compare_spec.rb b/spec/inputs/git_compare_spec.rb
new file mode 100644
index 0000000000000000000000000000000000000000..d2f830b1f1046fa8139c3d680e9014b036337082
--- /dev/null
+++ b/spec/inputs/git_compare_spec.rb
@@ -0,0 +1,45 @@
+require 'spec_helper'
+require 'confctl/inputs/git_compare'
+
+RSpec.describe ConfCtl::Inputs::GitCompare do
+  let(:old_rev) { 'a' * 40 }
+  let(:new_rev) { 'b' * 40 }
+
+  it 'uses the exact locked spelling and existing changelog URL without a suffix' do
+    mirror = instance_double(ConfCtl::GitRepoMirror)
+    expect(ConfCtl::GitRepoMirror).to receive(:new).with('https://github.com/NixOS/nixpkgs', quiet: true).and_return(mirror)
+    expect(mirror).to receive(:compare).with(old_rev, new_rev).and_return(:ahead)
+    expect(described_class.new.compare(owner: 'NixOS', repo: 'nixpkgs', old_rev: old_rev, new_rev: new_rev)).to eq(:ahead)
+  end
+
+  it 'accepts equality without constructing or accessing a mirror' do
+    expect(ConfCtl::GitRepoMirror).not_to receive(:new)
+    expect(described_class.new.compare(owner: 'owner', repo: 'repo', old_rev: old_rev, new_rev: old_rev)).to eq(:identical)
+  end
+
+  [nil, 'main', 'abc', '-bad', 'a' * 39].each do |rev|
+    it "rejects nonimmutable revision #{rev.inspect}" do
+      expect(ConfCtl::GitRepoMirror).not_to receive(:new)
+      expect do
+        described_class.new.compare(owner: 'owner', repo: 'repo', old_rev: old_rev, new_rev: rev)
+      end.to raise_error(described_class::Error)
+    end
+  end
+
+  ['.', '..', 'name/other', 'name?key=value', nil].each do |name|
+    it "rejects invalid repository component #{name.inspect}" do
+      expect do
+        described_class.new.compare(owner: name, repo: 'repo', old_rev: old_rev, new_rev: new_rev)
+      end.to raise_error(described_class::Error)
+    end
+  end
+
+  it 'converts cache evidence failures into the provider error contract' do
+    mirror = instance_double(ConfCtl::GitRepoMirror)
+    allow(ConfCtl::GitRepoMirror).to receive(:new).and_return(mirror)
+    allow(mirror).to receive(:compare).and_raise(ConfCtl::GitRepoMirror::Error, 'Git evidence unavailable')
+    expect do
+      described_class.new.compare(owner: 'owner', repo: 'repo', old_rev: old_rev, new_rev: new_rev)
+    end.to raise_error(described_class::Error, 'Git evidence unavailable')
+  end
+end
diff --git a/spec/inputs/guarded_update_spec.rb b/spec/inputs/guarded_update_spec.rb
new file mode 100644
index 0000000000000000000000000000000000000000..11eb2534cd7d80fec30a1e72c2de46438c113f4d
--- /dev/null
+++ b/spec/inputs/guarded_update_spec.rb
@@ -0,0 +1,259 @@
+# frozen_string_literal: true
+
+require 'spec_helper'
+require 'confctl/exceptions'
+require 'confctl/inputs/updater'
+require 'tty-command'
+require 'tmpdir'
+
+RSpec.describe ConfCtl::Inputs::GuardedUpdate do
+  include CliHelper
+
+  let(:old_rev) { 'a' * 40 }
+  let(:new_rev) { 'b' * 40 }
+  let(:provider) { instance_double(ConfCtl::Inputs::GitCompare, compare: :ahead) }
+  let(:cmd) { instance_double(TTY::Command) }
+  let(:result) { TTY::Command::Result.new(0, '', '') }
+  let(:old_data) do
+    {
+      'version' => 7, 'root' => 'entry',
+      'nodes' => {
+        'entry' => { 'inputs' => { 'source' => 'source' } },
+        'source' => {
+          'locked' => { 'type' => 'github', 'owner' => 'example', 'repo' => 'source', 'rev' => old_rev }
+        }
+      }
+    }
+  end
+  let(:candidate) do
+    Marshal.load(Marshal.dump(old_data)).tap { |data| data['nodes']['source']['locked']['rev'] = new_rev }
+  end
+
+  around do |example|
+    Dir.mktmpdir('confctl-guarded-update-') do |dir|
+      @conf_dir = dir
+      init_git_repo(dir)
+      File.write(File.join(dir, 'flake.nix'), "{ outputs = { ... }: {}; }\n")
+      File.write(File.join(dir, 'flake.lock'), JSON.pretty_generate(old_data))
+      git_commit_all(dir, 'fixture: baseline')
+      @before_state = repository_state
+      example.run
+    end
+  end
+
+  before do
+    allow(ConfCtl::SystemCommand).to receive(:new).and_return(cmd)
+    allow(ConfCtl::Inputs::GitCompare).to receive(:new).and_return(provider)
+    allow(ConfCtl::Inputs::GitCommit).to receive(:commit!)
+    allow(cmd).to receive(:run) do |*argv|
+      expect(argv).to include('--reference-lock-file', '--output-lock-file')
+      reference = argv[argv.index('--reference-lock-file') + 1]
+      output = argv[argv.index('--output-lock-file') + 1]
+      expect(File.binread(reference)).to eq(@before_state[:lock])
+      expect(repository_state).to eq(@before_state)
+      File.write(output, JSON.generate(candidate))
+      result
+    end
+  end
+
+  def repository_state
+    index = run_cmd('git', 'rev-parse', '--git-path', 'index', chdir: @conf_dir).out.strip
+    {
+      lock: File.binread(File.join(@conf_dir, 'flake.lock')),
+      head: run_cmd('git', 'rev-parse', 'HEAD', chdir: @conf_dir).out,
+      index: File.binread(File.expand_path(index, @conf_dir))
+    }
+  end
+
+  def update(**options)
+    ConfCtl::Inputs::Updater.run!(
+      conf_dir: @conf_dir, inputs: ['source'], commit: false,
+      changelog: false, downgrade: false, editor: false,
+      forward_only: true, **options
+    )
+  end
+
+  def expect_preserved
+    expect(repository_state).to eq(@before_state)
+    expect(ConfCtl::Inputs::GitCommit).not_to have_received(:commit!)
+    expect(Dir.glob(File.join(@conf_dir, '.confctl-update-*'))).to be_empty
+  end
+
+  it 'validates the separate candidate before installing and committing' do
+    expect(provider).to receive(:compare) do |**|
+      expect(repository_state).to eq(@before_state)
+      :ahead
+    end
+    expect(ConfCtl::Inputs::GitCommit).to receive(:commit!) do |**|
+      expect(JSON.parse(File.read(File.join(@conf_dir, 'flake.lock')))).to eq(candidate)
+    end
+
+    response = update(commit: true)
+    expect(response).to include(status: :updated, changed: true)
+    expect(response[:changes].map(&:name)).to eq(['source'])
+    expect(response[:changes].first.new_rev).to eq(new_rev)
+  end
+
+  it 'rejects non-containing candidates even with --downgrade' do
+    allow(provider).to receive(:compare).and_return(:behind)
+    expect(update(commit: true, downgrade: true)).to include(status: :rejected, changed: false)
+    expect_preserved
+  end
+
+  it 'fails on unknown ancestry evidence' do
+    allow(provider).to receive(:compare).and_raise(ConfCtl::Inputs::GitCompare::Error, 'unavailable')
+    expect(update(commit: true)).to include(status: :error, changed: false)
+    expect_preserved
+  end
+
+  it 'preserves the checkout when Nix exits unsuccessfully' do
+    allow(cmd).to receive(:run) { TTY::Command.new(printer: :null).run('sh', '-c', 'exit 1') }
+    expect(update(commit: true)).to include(status: :error, changed: false)
+    expect_preserved
+  end
+
+  it 'rejects malformed output' do
+    allow(cmd).to receive(:run) do |*argv|
+      File.write(argv[argv.index('--output-lock-file') + 1], '{')
+      result
+    end
+    expect(update(commit: true)).to include(status: :error)
+    expect_preserved
+  end
+
+  it 'does not accept cached GitHub metadata after Nix succeeds' do
+    allow(cmd).to receive(:run) do |*argv|
+      File.write(argv[argv.index('--output-lock-file') + 1], JSON.generate(candidate))
+      TTY::Command::Result.new(0, '', "unable to download 'https://api.github.com/repos/x/y': using cached version")
+    end
+    expect(update(commit: true)).to include(status: :error)
+    expect_preserved
+  end
+
+  it 'fails if Nix warns that a selector did not match' do
+    allow(cmd).to receive(:run).and_return(TTY::Command::Result.new(0, '', "warning: input 'x' does not match any input"))
+    expect(update).to include(status: :error)
+    expect_preserved
+  end
+
+  it 'cleans owned preparation files on interruption before installation' do
+    allow(provider).to receive(:compare).and_raise(Interrupt)
+    expect { update(commit: true) }.to raise_error(Interrupt)
+    expect_preserved
+  end
+
+  it 'keeps exact bytes for a no-change result' do
+    allow(cmd).to receive(:run) do |*argv|
+      File.write(argv[argv.index('--output-lock-file') + 1], JSON.generate(old_data))
+      result
+    end
+    expect(update(commit: true)).to include(status: :unchanged, changed: false)
+    expect_preserved
+  end
+
+  %w[flake.lock flake.nix imported.txt].each do |path|
+    it "rejects a concurrent tracked change to #{path} without overwriting it" do
+      if path == 'imported.txt'
+        File.write(File.join(@conf_dir, path), 'original')
+        git_commit_all(@conf_dir, 'fixture: imported declaration data')
+        @before_state = repository_state
+      end
+      allow(provider).to receive(:compare) do |**|
+        File.write(File.join(@conf_dir, path), 'external writer')
+        :ahead
+      end
+      expect(update(commit: true)).to include(status: :error)
+      expect(File.read(File.join(@conf_dir, path))).to eq('external writer')
+      expect(repository_state.slice(:index, :head)).to eq(@before_state.slice(:index, :head))
+      expect(ConfCtl::Inputs::GitCommit).not_to have_received(:commit!)
+    end
+  end
+
+  it 'rejects a concurrent HEAD change' do
+    allow(provider).to receive(:compare) do |**|
+      run_cmd('git', 'commit', '--allow-empty', '-m', 'external writer', chdir: @conf_dir)
+      :ahead
+    end
+    expect(update(commit: true)).to include(status: :error)
+    expect(File.binread(File.join(@conf_dir, 'flake.lock'))).to eq(@before_state[:lock])
+    expect(ConfCtl::Inputs::GitCommit).not_to have_received(:commit!)
+  end
+
+  it 'rejects a concurrent index change without undoing the other writer' do
+    allow(provider).to receive(:compare) do |**|
+      File.write(File.join(@conf_dir, 'other'), 'external writer')
+      run_cmd('git', 'add', 'other', chdir: @conf_dir)
+      :ahead
+    end
+    expect(update(commit: true)).to include(status: :error)
+    expect(repository_state[:lock]).to eq(@before_state[:lock])
+    expect(repository_state[:head]).to eq(@before_state[:head])
+    expect(run_cmd('git', 'diff', '--cached', '--name-only', chdir: @conf_dir).out).to eq("other\n")
+    expect(ConfCtl::Inputs::GitCommit).not_to have_received(:commit!)
+  end
+
+  it 'rejects a dirty index before running Nix' do
+    File.write(File.join(@conf_dir, 'other'), 'unrelated staged data')
+    run_cmd('git', 'add', 'other', chdir: @conf_dir)
+    @before_state = repository_state
+    expect(update(commit: true)).to include(status: :error)
+    expect(cmd).not_to have_received(:run)
+    expect_preserved
+  end
+
+  it 'requires an existing tracked lock' do
+    File.unlink(File.join(@conf_dir, 'flake.lock'))
+    expect(update).to include(status: :error)
+    expect(cmd).not_to have_received(:run)
+    expect(File).not_to exist(File.join(@conf_dir, 'flake.lock'))
+  end
+
+  it 'refuses a simultaneous cooperating update without waiting' do
+    path = run_cmd('git', 'rev-parse', '--git-path', 'confctl-input-update.lock', chdir: @conf_dir).out.strip
+    File.open(File.expand_path(path, @conf_dir), 'w') do |lock|
+      lock.flock(File::LOCK_EX)
+      expect(update).to include(status: :error)
+      expect(cmd).not_to have_received(:run)
+    end
+    expect_preserved
+  end
+
+  it 'leaves a validated lock installed when the commit hook fails' do
+    allow(ConfCtl::Inputs::GitCommit).to receive(:commit!).and_raise('git commit failed')
+    expect { update(commit: true) }.to raise_error('git commit failed')
+    expect(JSON.parse(File.read(File.join(@conf_dir, 'flake.lock')))).to eq(candidate)
+    expect(repository_state.slice(:index, :head)).to eq(@before_state.slice(:index, :head))
+  end
+
+  it 'rejects the whole candidate when one of several inputs goes backwards' do
+    old_data['nodes']['entry']['inputs']['other'] = 'other'
+    old_data['nodes']['other'] = { 'locked' => old_data['nodes']['source']['locked'].merge('repo' => 'other') }
+    candidate['nodes']['other']['locked']['rev'] = 'c' * 40
+    File.write(File.join(@conf_dir, 'flake.lock'), JSON.generate(old_data))
+    git_commit_all(@conf_dir, 'fixture: second input')
+    @before_state = repository_state
+    allow(provider).to receive(:compare).with(hash_including(repo: 'other')).and_return(:behind)
+    expect(update(commit: true)).to include(status: :rejected)
+    expect_preserved
+  end
+
+  it 'updates the terminal follows target without widening to its parent' do
+    old_data['nodes']['entry']['inputs'] = { 'parent' => 'parent', 'alias' => %w[parent leaf] }
+    old_data['nodes']['parent'] = {
+      'locked' => old_data['nodes']['source']['locked'].merge('repo' => 'parent'),
+      'inputs' => { 'leaf' => 'source' }
+    }
+    File.write(File.join(@conf_dir, 'flake.lock'), JSON.generate(old_data))
+    git_commit_all(@conf_dir, 'fixture: follows')
+    @before_state = repository_state
+    allow(cmd).to receive(:run) do |*argv|
+      expect(argv.last).to eq('parent/leaf')
+      File.write(argv[argv.index('--output-lock-file') + 1], JSON.generate(candidate))
+      result
+    end
+    response = update(inputs: ['alias'])
+    expect(response).to include(status: :updated)
+    expect(response[:changes].map(&:name)).to eq(['alias', 'parent/leaf'])
+    expect(JSON.parse(File.read(File.join(@conf_dir, 'flake.lock'))).dig('nodes', 'parent', 'locked', 'rev')).to eq(old_rev)
+  end
+end
diff --git a/spec/inputs/lock_graph_spec.rb b/spec/inputs/lock_graph_spec.rb
new file mode 100644
index 0000000000000000000000000000000000000000..264ef5afec82875917d07c3f13d6ef99ce897606
--- /dev/null
+++ b/spec/inputs/lock_graph_spec.rb
@@ -0,0 +1,87 @@
+require 'spec_helper'
+require 'confctl/inputs/lock_graph'
+
+RSpec.describe ConfCtl::Inputs::LockGraph do
+  def source(rev = 'a' * 40)
+    { 'locked' => { 'type' => 'github', 'owner' => 'example', 'repo' => 'source', 'rev' => rev } }
+  end
+
+  def graph
+    {
+      'version' => 7,
+      'root' => 'entry',
+      'nodes' => {
+        'entry' => { 'inputs' => { 'parent' => 'p', 'alias' => %w[parent middle leaf], 'chain' => ['alias'] } },
+        'p' => source.merge('inputs' => { 'middle' => 'm' }),
+        'm' => source.merge('inputs' => { 'leaf' => 'l' }),
+        'l' => source
+      }
+    }
+  end
+
+  it 'uses lock.root and resolves full nested and chained follows to terminal update paths' do
+    lock = described_class.new(graph)
+    expect(lock.resolve_path('chain').node).to eq(graph['nodes']['l'])
+    expect(lock.resolve_path('chain').terminal_path).to eq('parent/middle/leaf')
+    expect(lock.update_inputs(%w[alias chain parent/middle/leaf])).to eq(['parent/middle/leaf'])
+    expect(lock.entries.keys).to contain_exactly('parent', 'parent/middle', 'parent/middle/leaf', 'alias', 'chain')
+  end
+
+  it 'continues traversal below an alias and resolves nested follows from the root' do
+    data = graph
+    data['nodes']['entry']['inputs']['top'] = ['parent']
+    data['nodes']['p']['inputs']['shared'] = ['alias']
+    lock = described_class.new(data)
+    expect(lock.resolve_path('top/middle/leaf').terminal_path).to eq('parent/middle/leaf')
+    expect(lock.resolve_path('top/shared').terminal_path).to eq('parent/middle/leaf')
+    expect(lock.entries).to have_key('top/shared')
+  end
+
+  it 'preserves all logical paths through shared nodes' do
+    data = graph
+    data['nodes']['entry']['inputs']['another'] = 'p'
+    expect(described_class.new(data).entries).to have_key('another/middle/leaf')
+  end
+
+  it 'ignores unreachable nodes' do
+    data = graph
+    data['nodes']['unused'] = { 'inputs' => { 'bad' => 'missing' } }
+    expect { described_class.new(data) }.not_to raise_error
+  end
+
+  it 'accepts raw non-flake sources' do
+    data = graph
+    data['nodes']['l']['flake'] = false
+    expect(described_class.new(data).resolve_path('alias').node['flake']).to be(false)
+  end
+
+  {
+    'unknown schema' => ->(data) { data['version'] = 8 },
+    'noninteger schema' => ->(data) { data['version'] = 7.0 },
+    'absent root' => ->(data) { data.delete('root') },
+    'dangling node' => ->(data) { data['nodes'].delete('l') },
+    'missing locked source' => ->(data) { data['nodes']['l'].delete('locked') },
+    'malformed inputs' => ->(data) { data['nodes']['p']['inputs'] = [] },
+    'malformed input name' => ->(data) { data['nodes']['p']['inputs'][4] = 'l' },
+    'malformed edge' => ->(data) { data['nodes']['entry']['inputs']['alias'] = 1 },
+    'malformed follows' => ->(data) { data['nodes']['entry']['inputs']['alias'] = ['parent', 4] },
+    'dangling follows' => ->(data) { data['nodes']['entry']['inputs']['alias'] = %w[parent absent] },
+    'direct follows cycle' => ->(data) { data['nodes']['entry']['inputs']['alias'] = ['alias'] },
+    'chained follows cycle' => ->(data) { data['nodes']['entry']['inputs']['alias'] = ['chain'] },
+    'dependency cycle' => ->(data) { data['nodes']['l']['inputs'] = { 'loop' => 'p' } },
+    'root follows cycle' => ->(data) { data['nodes']['entry']['inputs']['alias'] = [] },
+    'malformed flake flag' => ->(data) { data['nodes']['l']['flake'] = 'false' }
+  }.each do |name, mutate|
+    it "rejects #{name}" do
+      data = graph
+      mutate.call(data)
+      expect { described_class.new(data) }.to raise_error(described_class::Error)
+    end
+  end
+
+  it 'rejects missing or malformed requested paths instead of silently skipping them' do
+    lock = described_class.new(graph)
+    expect { lock.resolve_path('parent/absent') }.to raise_error(described_class::Error)
+    expect { lock.resolve_path('parent//middle') }.to raise_error(described_class::Error)
+  end
+end
