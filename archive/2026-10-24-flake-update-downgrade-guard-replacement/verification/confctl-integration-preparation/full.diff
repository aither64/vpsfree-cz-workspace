diff --git a/lib/confctl/cli/inputs/update_result.rb b/lib/confctl/cli/inputs/update_result.rb
new file mode 100644
index 0000000000000000000000000000000000000000..c315bff7e5ee1b25e98a5007504bed67e4a409a5
--- /dev/null
+++ b/lib/confctl/cli/inputs/update_result.rb
@@ -0,0 +1,16 @@
+module ConfCtl::Cli
+  module Inputs::UpdateResult
+    protected
+
+    def ensure_update_success!(result)
+      return unless %i[rejected error].include?(result[:status])
+
+      message = result[:issues].join("\n")
+      if result[:status] == :rejected
+        raise GLI::CustomExit.new("Forward-only update rejected:\n#{message}", 3)
+      end
+
+      raise ConfCtl::Error, "Forward-only update could not be verified:\n#{message}"
+    end
+  end
+end
