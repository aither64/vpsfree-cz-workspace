          "script": "final_lock=\"$RUNNER_TEMP/flake-update-final.lock\"\ngit show HEAD:flake.lock > \"$final_lock\"\nnix shell \"$CONFCTL_FLAKE\" -c confctl inputs check-update \\\n  --old-lock \"$UPDATE_OLD_LOCK\" --new-lock \"$final_lock\"\n",
