        {
          "name": "Update nixpkgs",
          "script": "before=$(git rev-parse HEAD)\n./utils/update-nixpkgs.sh\nafter=$(git rev-parse HEAD)\n\nif [ \"$before\" != \"$after\" ]; then\n  echo \"committed=true\" >> \"$GITHUB_OUTPUT\"\nelse\n  echo \"committed=false\" >> \"$GITHUB_OUTPUT\"\nfi\n",
