      "steps": [
        {
          "name": "Configure Git",
          "script": "git config user.name \"github-actions[bot]\"\ngit config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n",
          "original_script_sha256": "0fb18105f9c2021e46a3bf53c25d12b25903569bb5e315c2c3db23d6d06efc89"
        },
        {
          "name": "Record starting revision",
          "script": "echo \"UPDATE_START_REF=$(git rev-parse HEAD)\" >> \"$GITHUB_ENV\"\ncp flake.lock \"$RUNNER_TEMP/flake-update-baseline.lock\"\necho \"UPDATE_OLD_LOCK=$RUNNER_TEMP/flake-update-baseline.lock\" >> \"$GITHUB_ENV\"\n",
          "original_script_sha256": "979841712af8abd2276079d655161555cb7e1a2ff933706f473b3dcdab55d408"
        },
        {
          "name": "Update flake input",
          "script": "set -euo pipefail\n\nold_rev=\"$(nix shell \"$CONFCTL_FLAKE\" -c confctl inputs ls --json nixpkgs | jq -er '\n  map(select(.input == \"nixpkgs\"))\n  | if length == 1 then .[0].rev | select(type == \"string\" and length > 0) else empty end\n')\"\nif [ -z \"$old_rev\" ]; then\n  echo \"Unable to read nixpkgs revision from flake.lock.\" >&2\n  exit 1\nfi\n\nnix shell \"$CONFCTL_FLAKE\" -c confctl inputs update --forward-only nixpkgs\n\nif git diff --quiet -- flake.lock; then\n  echo \"No flake input updates to commit.\"\n  exit 0\nfi\n\nnew_rev=\"$(nix shell \"$CONFCTL_FLAKE\" -c confctl inputs ls --json nixpkgs | jq -er '\n  map(select(.input == \"nixpkgs\"))\n  | if length == 1 then .[0].rev | select(type == \"string\" and length > 0) else empty end\n')\"\nif [ -z \"$new_rev\" ]; then\n  echo \"Unable to read updated nixpkgs revision from flake.lock.\" >&2\n  exit 1\nfi\n\ncommit_msg=\"$(mktemp)\"\ntrap 'rm -f \"$commit_msg\"' EXIT\n\nprintf 'flake: nixpkgs %.11s -> %.11s\\n' \"$old_rev\" \"$new_rev\" > \"$commit_msg\"\n\ngit add -- flake.lock\ngit commit -F \"$commit_msg\"\n",
          "original_script_sha256": "1ef196d87970cc505d243f04f98a252d57b14a306e4faf8b303639d7c2806c12"
        },
        {
          "name": "Update Go dependencies",
          "script": "set -euo pipefail\n\nold_go_mod=\"$(mktemp)\"\nnew_go_mod=\"$(mktemp)\"\ndirect_changes=\"$(mktemp)\"\ncommit_msg=\"$(mktemp)\"\nbuild_log=\"$(mktemp)\"\ntrap 'rm -f \"$old_go_mod\" \"$new_go_mod\" \"$direct_changes\" \"$commit_msg\" \"$build_log\"' EXIT\n\nnix develop --command go mod edit -json > \"$old_go_mod\"\n\nnix develop --command go get -u -t ./...\nnix develop --command go mod tidy\n\nif git diff --quiet -- go.mod go.sum; then\n  echo \"No Go dependency updates to commit.\"\n  exit 0\nfi\n\nnix develop --command go mod edit -json > \"$new_go_mod\"\n\njq --slurp -r '\n  def direct:\n    (.Require // [])\n    | map(select((.Indirect // false) | not))\n    | map({key: .Path, value: .Version})\n    | from_entries;\n\n  (.[0] | direct) as $old\n  | (.[1] | direct) as $new\n  | (($old + $new) | keys | sort[])\n  | select(($old[.] // \"\") != ($new[.] // \"\"))\n  | [., ($old[.] // \"\"), ($new[.] // \"\")]\n  | @tsv\n' \"$old_go_mod\" \"$new_go_mod\" > \"$direct_changes\"\n\nperl tools/set-vendor-hash.pl --fake nix/package.nix\n\nif nix build .#vpsf-status --no-link 2>\"$build_log\"; then\n  echo \"Nix build unexpectedly succeeded with lib.fakeHash.\" >&2\n  exit 1\nfi\n\nvendor_hash=\"$(\n  sed -n 's/^[[:space:]]*got:[[:space:]]*\\(sha256-[^[:space:]]*\\).*/\\1/p' \"$build_log\" | tail -n1\n)\"\n\nif [ -z \"$vendor_hash\" ]; then\n  cat \"$build_log\" >&2\n  exit 1\nfi\n\nperl tools/set-vendor-hash.pl \"$vendor_hash\" nix/package.nix\n\ndirect_count=\"$(wc -l < \"$direct_changes\" | tr -d ' ')\"\nif [ \"$direct_count\" -eq 0 ]; then\n  subject=\"go: update indirect dependencies\"\nelif [ \"$direct_count\" -eq 1 ]; then\n  IFS=$'\\t' read -r module_path old_version new_version < \"$direct_changes\"\n  module_name=\"${module_path##*/}\"\n  if [[ \"$module_name\" =~ ^v[0-9]+$ ]]; then\n    parent_path=\"${module_path%/*}\"\n    module_name=\"${parent_path##*/}/${module_name}\"\n  fi\n\n  if [ -z \"$old_version\" ]; then\n    subject=\"go: add $module_name $new_version\"\n  elif [ -z \"$new_version\" ]; then\n    subject=\"go: remove $module_name\"\n  else\n    subject=\"go: update $module_name to $new_version\"\n  fi\nelse\n  subject=\"go: update $direct_count direct dependencies\"\nfi\n\nprintf '%s\\n\\n' \"$subject\" > \"$commit_msg\"\nif [ \"$direct_count\" -eq 0 ]; then\n  printf 'No direct dependency version changes were detected.\\n\\n' >> \"$commit_msg\"\nelse\n  printf 'Direct dependency changes:\\n\\n' >> \"$commit_msg\"\n  while IFS=$'\\t' read -r module_path old_version new_version; do\n    printf '%s:\\n' \"$module_path\" >> \"$commit_msg\"\n    if [ -z \"$old_version\" ]; then\n      printf '  added %s\\n\\n' \"$new_version\" >> \"$commit_msg\"\n    elif [ -z \"$new_version\" ]; then\n      printf '  removed %s\\n\\n' \"$old_version\" >> \"$commit_msg\"\n    else\n      printf '  %s -> %s\\n\\n' \"$old_version\" \"$new_version\" >> \"$commit_msg\"\n    fi\n  done < \"$direct_changes\"\nfi\nprintf 'Refresh nix/package.nix vendorHash for the updated Go module graph.\\n' >> \"$commit_msg\"\n\ngit add -A -- go.mod go.sum nix/package.nix\ngit commit -F \"$commit_msg\"\n",
          "original_script_sha256": "3016bd36df9dba36f25496053181d25f18edac47b0218ce0c1155898d6480700"
        },
        {
          "name": "Check committed dependency updates",
          "script": "set -euo pipefail\n\nif ! git diff --quiet || ! git diff --cached --quiet; then\n  git status --short\n  exit 1\nfi\n",
          "original_script_sha256": "3959b5dba8fa3553c7111b9f1e7f4d14bef742284525aae78fb6f067554d3b0d"
        },
        {
          "name": "Run tests",
          "script": "nix develop --command go test ./...\n",
          "original_script_sha256": "16fbbf7424d813c56716bb5530c9f4909dade2614fc7c202123fcb9ea6d8e4af"
        },
        {
          "name": "Build Nix package",
          "script": "nix build .#vpsf-status --no-link\n",
          "original_script_sha256": "044301fa999bff5fdbdb5c3a28ad3b6784e3d5e6315328a774847ffae67df546"
        },
        {
          "name": "Push changes",
          "script": "set -euo pipefail\n\nif [ \"$(git rev-parse HEAD)\" = \"$UPDATE_START_REF\" ]; then\n  echo \"No dependency updates to push.\"\n  exit 0\nfi\n\nfinal_lock=\"$RUNNER_TEMP/flake-update-final.lock\"\ngit show HEAD:flake.lock > \"$final_lock\"\nnix shell \"$CONFCTL_FLAKE\" -c confctl inputs check-update \\\n  --old-lock \"$UPDATE_OLD_LOCK\" --new-lock \"$final_lock\"\n",
          "original_script_sha256": "4e1800bd3a47a41a0e049e6ceff7fc53aeb94bfa20e968632fb34ab17ee268d7"
        }
      ],
      "removed_publication_lines": [
        "git push origin \"HEAD:${{ github.event.repository.default_branch }}\""
      ],
      "selection": "nixpkgs"
    }
  ],
