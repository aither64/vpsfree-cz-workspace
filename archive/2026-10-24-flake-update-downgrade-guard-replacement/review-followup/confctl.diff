diff --git a/spec/inputs/forward_guard_spec.rb b/spec/inputs/forward_guard_spec.rb
new file mode 100644
index 0000000..a79d0ce
--- /dev/null
+++ b/spec/inputs/forward_guard_spec.rb
@@ -0,0 +1,219 @@
+require 'spec_helper'
+require 'confctl/flake_lock'
+require 'confctl/inputs/forward_guard'
+
+RSpec.describe ConfCtl::Inputs::ForwardGuard do
+  let(:provider) { instance_double(ConfCtl::Inputs::GitHubCompare) }
+  let(:guard) { described_class.new(provider: provider) }
+
+  def source(rev = 'a' * 40, repo = 'source')
+    { 'locked' => { 'type' => 'github', 'owner' => 'example', 'repo' => repo, 'rev' => rev } }
+  end
+
+  def graph
+    {
+      'version' => 7,
+      'root' => 'entry',
+      'nodes' => {
+        'entry' => { 'inputs' => { 'parent' => 'p', 'alias' => %w[parent leaf] } },
+        'p' => source.merge('inputs' => { 'leaf' => 'l' }),
+        'l' => source('b' * 40, 'dependency')
+      }
+    }
+  end
+
+  def compare(repo: 'source', old_rev: 'a' * 40, new_rev: 'c' * 40, result: :ahead)
+    expect(provider).to receive(:compare).with(owner: 'example', repo: repo, old_rev: old_rev, new_rev: new_rev)
+                                         .once.and_return(result)
+  end
+
+  it 'accepts identical revisions locally, including an ordinary FlakeLock object' do
+    expect(provider).not_to receive(:compare)
+    result = guard.validate(ConfCtl::FlakeLock.new('old', graph), graph)
+    expect(result.status).to eq(:unchanged)
+    expect(result).to be_success
+    expect(result.changes).to be_empty
+  end
+
+  it 'ignores arbitrary generated node renumbering and input ordering' do
+    candidate = graph
+    candidate['nodes']['renumbered'] = candidate['nodes'].delete('l')
+    candidate['nodes']['p']['inputs']['leaf'] = 'renumbered'
+    expect(guard.validate(graph, candidate).status).to eq(:unchanged)
+  end
+
+  it 'accepts forward root revisions' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['rev'] = 'c' * 40
+    compare
+    result = guard.validate(graph, candidate)
+    expect(result.status).to eq(:updated)
+    expect(result.changes.map(&:path)).to eq(['parent'])
+    expect(result.changes.first.old_rev).to eq('a' * 40)
+  end
+
+  it 'checks all nested changes when the root revision is equal and deduplicates alias evidence' do
+    candidate = graph
+    candidate['nodes']['l']['locked']['rev'] = 'c' * 40
+    compare(repo: 'dependency', old_rev: 'b' * 40)
+    result = guard.validate(graph, candidate)
+    expect(result.status).to eq(:updated)
+    expect(result.changes.map(&:path)).to eq(['alias', 'parent/leaf'])
+  end
+
+  it 'rejects a nested rollback even when its parent advances' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['rev'] = 'c' * 40
+    candidate['nodes']['l']['locked']['rev'] = 'd' * 40
+    compare
+    compare(repo: 'dependency', old_rev: 'b' * 40, new_rev: 'd' * 40, result: :behind)
+    result = guard.validate(graph, candidate)
+    expect(result).to be_rejected
+    expect(result).not_to be_success
+    expect(result.issues.join).to include('parent/leaf', 'behind', 'b' * 40, 'd' * 40)
+  end
+
+  %i[behind diverged].each do |outcome|
+    it "rejects #{outcome} history despite newer candidate metadata" do
+      candidate = graph
+      candidate['nodes']['p']['locked'].merge!('rev' => 'c' * 40, 'lastModified' => 2_000_000_000)
+      compare(result: outcome)
+      expect(guard.validate(graph, candidate)).to be_rejected
+    end
+  end
+
+  it 'accepts merge and later-revert commits when they contain the original commit' do
+    candidate = graph
+    candidate['nodes']['p']['locked'].merge!('rev' => 'c' * 40, 'lastModified' => 1, 'narHash' => 'sha256-new')
+    compare
+    expect(guard.validate(graph, candidate)).to be_success
+  end
+
+  %w[repo owner host type dir].each do |attribute|
+    it "does not accept a changed #{attribute} as ordinary forward movement" do
+      candidate = graph
+      candidate['nodes']['p']['locked'].merge!(attribute => 'different', 'rev' => 'c' * 40)
+      expect(provider).not_to receive(:compare)
+      expect(guard.validate(graph, candidate)).not_to be_success
+    end
+  end
+
+  it 'normalizes github.com source names for ancestry queries' do
+    candidate = graph
+    candidate['nodes']['p']['locked'].merge!('rev' => 'c' * 40, 'owner' => 'EXAMPLE', 'repo' => 'SOURCE')
+    compare
+    expect(guard.validate(graph, candidate)).to be_success
+  end
+
+  %w[narHash lastModified dir].each do |attribute|
+    it "rejects changed #{attribute} at an equal revision" do
+      candidate = graph
+      candidate['nodes']['p']['locked'][attribute] = attribute == 'lastModified' ? 100 : 'changed'
+      expect(provider).not_to receive(:compare)
+      expect(guard.validate(graph, candidate)).to be_rejected
+    end
+  end
+
+  it 'rejects switching between a flake and raw source' do
+    candidate = graph
+    candidate['nodes']['p']['flake'] = false
+    expect(guard.validate(graph, candidate)).to be_rejected
+  end
+
+  it 'permits revision updates to raw GitHub sources' do
+    old = graph
+    old['nodes']['l']['flake'] = false
+    candidate = Marshal.load(Marshal.dump(old))
+    candidate['nodes']['l']['locked']['rev'] = 'c' * 40
+    compare(repo: 'dependency', old_rev: 'b' * 40)
+    expect(guard.validate(old, candidate)).to be_success
+  end
+
+  it 'rejects removed logical paths even when they were aliases' do
+    candidate = graph
+    candidate['nodes']['entry']['inputs'].delete('alias')
+    result = guard.validate(graph, candidate)
+    expect(result).to be_rejected
+    expect(result.issues.join).to include('alias', 'removed')
+  end
+
+  it 'accepts new supported immutable dependencies and reports them' do
+    candidate = graph
+    candidate['nodes']['entry']['inputs']['new'] = 'n'
+    candidate['nodes']['n'] = source
+    result = guard.validate(graph, candidate)
+    expect(result.status).to eq(:updated)
+    expect(result.changes.map(&:path)).to eq(['new'])
+    expect(result.changes.first.old_node).to be_nil
+  end
+
+  it 'retains unchanged unsupported path sources without giving changed sources a bypass' do
+    old = graph
+    old['nodes']['l']['locked'] = { 'type' => 'path', 'path' => '/source' }
+    expect(guard.validate(old, old).status).to eq(:unchanged)
+    candidate = Marshal.load(Marshal.dump(old))
+    candidate['nodes']['l']['locked']['path'] = '/changed'
+    expect(guard.validate(old, candidate)).to be_error
+  end
+
+  it 'fails closed for unsupported new dependencies' do
+    candidate = graph
+    candidate['nodes']['entry']['inputs']['new'] = 'n'
+    candidate['nodes']['n'] = { 'locked' => { 'type' => 'tarball', 'url' => 'https://example.com/archive' } }
+    expect(guard.validate(graph, candidate)).to be_error
+  end
+
+  [nil, 'short', 'main'].each do |rev|
+    it "fails closed for nonimmutable revision #{rev.inspect}" do
+      candidate = graph
+      candidate['nodes']['p']['locked']['rev'] = rev
+      expect(guard.validate(graph, candidate)).to be_error
+    end
+  end
+
+  it 'fails closed for unknown extraction attributes without exposing their values' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['privateToken'] = 'secret-value'
+    result = guard.validate(graph, candidate)
+    expect(result).to be_error
+    expect(result.issues.join).not_to include('secret-value')
+  end
+
+  it 'reports unavailable provider evidence as an error even alongside a known rejection' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['rev'] = 'c' * 40
+    candidate['nodes']['l']['locked']['rev'] = 'd' * 40
+    allow(provider).to receive(:compare).and_raise(ConfCtl::Inputs::GitHubCompare::Error, 'Unavailable evidence')
+    compare(result: :behind)
+    expect(guard.validate(graph, candidate)).to be_error
+  end
+
+  it 'fails closed for unexpected provider outcomes' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['rev'] = 'c' * 40
+    compare(result: nil)
+    expect(guard.validate(graph, candidate)).to be_error
+  end
+
+  it 'deduplicates failed evidence requests shared by aliases' do
+    candidate = graph
+    candidate['nodes']['l']['locked']['rev'] = 'c' * 40
+    expect(provider).to receive(:compare).once.and_raise(ConfCtl::Inputs::GitHubCompare::Error, 'Unavailable evidence')
+    result = guard.validate(graph, candidate)
+    expect(result).to be_error
+    expect(result.issues.size).to eq(2)
+  end
+
+  it 'does not reuse comparison evidence for another revision pair or validation run' do
+    candidate = graph
+    candidate['nodes']['p']['locked']['rev'] = 'c' * 40
+    expect(provider).to receive(:compare).twice.and_return(:ahead)
+    2.times { expect(guard.validate(graph, candidate)).to be_success }
+  end
+
+  it 'returns typed graph errors rather than accepting unsupported lock versions' do
+    candidate = graph
+    candidate['version'] = 100
+    expect(guard.validate(graph, candidate)).to be_error
+  end
+end
diff --git a/spec/inputs/github_compare_spec.rb b/spec/inputs/github_compare_spec.rb
new file mode 100644
index 0000000..5b78613
--- /dev/null
+++ b/spec/inputs/github_compare_spec.rb
@@ -0,0 +1,135 @@
+require 'spec_helper'
+require 'confctl/inputs/github_compare'
+
+RSpec.describe ConfCtl::Inputs::GitHubCompare do
+  let(:transport) { class_double(Net::HTTP) }
+  let(:http) { instance_double(Net::HTTP) }
+  let(:old_rev) { 'a' * 40 }
+  let(:new_rev) { 'b' * 40 }
+  let(:client) { described_class.new(token: 'private-token', http: transport) }
+
+  def compare
+    client.compare(owner: 'example', repo: 'source', old_rev: old_rev, new_rev: new_rev)
+  end
+
+  def summary(status = 'ahead')
+    {
+      'status' => status,
+      'base_commit' => { 'sha' => old_rev },
+      'merge_base_commit' => { 'sha' => old_rev },
+      'ahead_by' => 5,
+      'behind_by' => 0,
+      'total_commits' => 5,
+      'commits' => []
+    }
+  end
+
+  def response(body: summary.to_json, code: '200')
+    allow(transport).to receive(:start).with('api.github.com', 443,
+                                             use_ssl: true, open_timeout: 10, read_timeout: 30).and_yield(http)
+    allow(http).to receive(:max_retries=).with(0)
+    allow(http).to receive(:request).and_return(instance_double(Net::HTTPResponse, code: code, body: body))
+  end
+
+  it 'uses exact full SHAs, fixed HTTPS host, explicit token and bounded network settings' do
+    response
+    expect(http).to receive(:request) do |request|
+      expect(request.path).to eq("/repos/example/source/compare/#{old_rev}...#{new_rev}?per_page=1")
+      expect(request['Authorization']).to eq('Bearer private-token')
+      expect(request['Accept']).to eq('application/vnd.github+json')
+      expect(request['User-Agent']).to eq('confctl-forward-guard')
+      instance_double(Net::HTTPResponse, code: '200', body: summary.to_json)
+    end
+    expect(compare).to eq(:ahead)
+  end
+
+  it 'decides equality locally' do
+    expect(transport).not_to receive(:start)
+    expect(client.compare(owner: 'example', repo: 'source', old_rev: old_rev, new_rev: old_rev)).to eq(:identical)
+  end
+
+  it 'accepts a large comparison using complete summary metadata despite truncated commit lists' do
+    data = summary.merge('ahead_by' => 50_000, 'total_commits' => 50_000,
+                         'commits' => [{ 'sha' => new_rev }])
+    response(body: data.to_json)
+    expect(compare).to eq(:ahead)
+  end
+
+  it 'reports behind history' do
+    data = summary('behind').merge('ahead_by' => 0, 'behind_by' => 50_000, 'total_commits' => 0,
+                                   'merge_base_commit' => { 'sha' => new_rev })
+    response(body: data.to_json)
+    expect(compare).to eq(:behind)
+  end
+
+  it 'reports divergent history, including an equivalent cherry pick or rebase' do
+    data = summary('diverged').merge('behind_by' => 1, 'merge_base_commit' => { 'sha' => 'c' * 40 })
+    response(body: data.to_json)
+    expect(compare).to eq(:diverged)
+  end
+
+  {
+    'missing fields' => ->(data) { data.delete('behind_by') },
+    'wrong base' => ->(data) { data['base_commit']['sha'] = 'd' * 40 },
+    'wrong merge base' => ->(data) { data['merge_base_commit']['sha'] = new_rev },
+    'abbreviated merge base' => ->(data) { data['merge_base_commit']['sha'] = 'short' },
+    'ahead and behind' => ->(data) { data['behind_by'] = 1 },
+    'missing ahead count' => ->(data) { data['ahead_by'] = 0 },
+    'wrong total' => ->(data) { data['total_commits'] = 6 },
+    'negative counts' => ->(data) { data['ahead_by'] = -1 },
+    'string counts' => ->(data) { data['behind_by'] = '0' },
+    'unknown status' => ->(data) { data['status'] = 'maybe' },
+    'false equality' => ->(data) { data['status'] = 'identical' },
+    'inconsistent behind status' => ->(data) { data['status'] = 'behind' },
+    'inconsistent diverged status' => ->(data) { data['status'] = 'diverged' }
+  }.each do |name, mutate|
+    it "fails closed on #{name}" do
+      data = summary
+      instance_exec(data, &mutate)
+      response(body: data.to_json)
+      expect { compare }.to raise_error(described_class::Error, /ancestry evidence/)
+    end
+  end
+
+  ['null', '[]', '{bad-json', '{"message":"private-token"}'].each do |body|
+    it "rejects invalid response shape #{body[0, 10]} without leaking response data" do
+      response(body: body)
+      expect { compare }.to raise_error(described_class::Error) { |e| expect(e.message).not_to include('private-token') }
+    end
+  end
+
+  %w[301 302 401 403 404 409 422 429 500 503].each do |code|
+    it "fails closed for HTTP #{code} without redirecting or leaking credentials/body" do
+      response(code: code, body: 'private-token')
+      expect { compare }.to raise_error(described_class::Error, "GitHub comparison failed (HTTP #{code})")
+    end
+  end
+
+  [Net::OpenTimeout, Net::ReadTimeout, SocketError, Errno::ECONNRESET, OpenSSL::SSL::SSLError,
+   Net::HTTPBadResponse, EOFError].each do |error|
+    it "returns sanitized evidence failure for #{error}" do
+      allow(transport).to receive(:start).and_raise(error, 'private-token')
+      expect { compare }.to raise_error(described_class::Error, 'Unable to obtain GitHub ancestry evidence')
+    end
+  end
+
+  it 'supports unauthenticated public requests without sending an empty authorization header' do
+    response
+    client = described_class.new(token: nil, http: transport)
+    expect(http).to receive(:request) do |request|
+      expect(request['Authorization']).to be_nil
+      instance_double(Net::HTTPResponse, code: '200', body: summary.to_json)
+    end
+    expect(client.compare(owner: 'example', repo: 'source', old_rev: old_rev, new_rev: new_rev)).to eq(:ahead)
+  end
+
+  it 'rejects malformed repository coordinates or mutable refs before HTTP' do
+    expect(transport).not_to receive(:start)
+    expect do
+      client.compare(owner: 'example/other', repo: 'source', old_rev: old_rev, new_rev: new_rev)
+    end.to raise_error(described_class::Error)
+    expect do
+      client.compare(owner: 'example', repo: 'source', old_rev: 'main', new_rev: new_rev)
+    end.to raise_error(described_class::Error)
+  end
+end
diff --git a/spec/inputs/guarded_update_spec.rb b/spec/inputs/guarded_update_spec.rb
