diff --git a/lib/confctl/inputs/forward_guard.rb b/lib/confctl/inputs/forward_guard.rb
new file mode 100644
index 0000000..81baedb
--- /dev/null
+++ b/lib/confctl/inputs/forward_guard.rb
@@ -0,0 +1,133 @@
+require 'confctl/inputs/lock_graph'
+require 'confctl/inputs/github_compare'
+
+module ConfCtl
+  module Inputs
+    class ForwardGuard
+      Result = Struct.new(:status, :changes, :issues) do
+        def success? = %i[unchanged updated].include?(status)
+        def rejected? = status == :rejected
+        def error? = status == :error
+      end
+
+      Change = Struct.new(:path, :old_node, :new_node) do
+        def old_rev = old_node&.dig('locked', 'rev')
+        def new_rev = new_node&.dig('locked', 'rev')
+      end
+
+      class UnsupportedSource < StandardError; end
+
+      def initialize(provider: GitHubCompare.new)
+        @provider = provider
+      end
+
+      def validate(old_lock, candidate_lock)
+        old_entries = LockGraph.new(old_lock).entries
+        new_entries = LockGraph.new(candidate_lock).entries
+        changes = []
+        rejected = []
+        errors = []
+        cache = {}
+
+        (old_entries.keys | new_entries.keys).sort.each do |path|
+          old_node = old_entries[path]&.node
+          new_node = new_entries[path]&.node
+          next if same_source?(old_node, new_node)
+
+          change = Change.new(path: path, old_node: old_node, new_node: new_node)
+          changes << change
+          check_change(change, rejected, cache)
+        rescue UnsupportedSource, GitHubCompare::Error => e
+          errors << "#{path}: #{e.message}"
+        end
+
+        status = if !errors.empty?
+                   :error
+                 elsif !rejected.empty?
+                   :rejected
+                 elsif changes.empty?
+                   :unchanged
+                 else
+                   :updated
+                 end
+        Result.new(status: status, changes: changes, issues: errors + rejected)
+      rescue LockGraph::Error => e
+        Result.new(status: :error, changes: [], issues: [e.message])
+      end
+
+      protected
+
+      def same_source?(old_node, new_node)
+        old_node && new_node && old_node['locked'] == new_node['locked'] &&
+          old_node.fetch('flake', true) == new_node.fetch('flake', true)
+      end
+
+      def check_change(change, rejected, cache)
+        if change.new_node.nil?
+          rejected << "#{change.path}: previously reachable dependency was removed"
+          return
+        end
+
+        new_source = source(change.new_node)
+        return if change.old_node.nil?
+
+        old_source = source(change.old_node)
+        if old_source != new_source || change.old_node.fetch('flake', true) != change.new_node.fetch('flake', true)
+          rejected << "#{change.path}: source or extraction attributes changed; manual review required"
+          return
+        end
+
+        if change.old_rev == change.new_rev
+          rejected << "#{change.path}: locked attributes changed at the same revision"
+          return
+        end
+
+        key = [old_source, change.old_rev, change.new_rev]
+        outcome = cache.fetch(key) do
+          cache[key] = begin
+            @provider.compare(
+              owner: new_source['owner'], repo: new_source['repo'], old_rev: change.old_rev, new_rev: change.new_rev
+            )
+          rescue GitHubCompare::Error => e
+            e
+          end
+        end
+        raise outcome if outcome.is_a?(GitHubCompare::Error)
+
+        return if outcome == :ahead
+
+        unless %i[behind diverged].include?(outcome)
+          raise GitHubCompare::Error, 'Unknown ancestry comparison outcome'
+        end
+
+        rejected << "#{change.path}: #{change.old_rev} -> #{change.new_rev} is #{outcome}"
+      end
+
+      def source(node)
+        locked = node['locked']
+        unless locked['type'] == 'github' && [nil, 'github.com'].include?(locked['host']) &&
+               %w[owner repo].all? do |key|
+                 value = locked[key]
+                 value.is_a?(String) && GitHubCompare::NAME.match?(value) && !%w[. ..].include?(value)
+               end
+          raise UnsupportedSource, 'Changed dependency is not a supported github.com source'
+        end
+        unless locked['rev'].is_a?(String) && GitHubCompare::SHA.match?(locked['rev'])
+          raise UnsupportedSource, 'Changed dependency lacks a full immutable Git revision'
+        end
+
+        allowed = %w[type owner repo host rev narHash lastModified dir]
+        unless (locked.keys - allowed).empty? &&
+               (!locked.has_key?('dir') || locked['dir'].is_a?(String)) &&
+               (!locked.has_key?('narHash') || locked['narHash'].is_a?(String)) &&
+               (!locked.has_key?('lastModified') || locked['lastModified'].is_a?(Integer))
+          raise UnsupportedSource, 'Unsupported GitHub source attributes'
+        end
+
+        locked.except('rev', 'narHash', 'lastModified').merge(
+          'owner' => locked['owner'].downcase, 'repo' => locked['repo'].downcase, 'host' => 'github.com'
+        )
+      end
+    end
+  end
+end
diff --git a/lib/confctl/inputs/github_compare.rb b/lib/confctl/inputs/github_compare.rb
new file mode 100644
index 0000000..33034af
--- /dev/null
+++ b/lib/confctl/inputs/github_compare.rb
@@ -0,0 +1,76 @@
+require 'json'
+require 'net/http'
+require 'uri'
+
+module ConfCtl
+  module Inputs
+    class GitHubCompare
+      class Error < StandardError; end
+
+      SHA = /\A[0-9a-f]{40}\z/
+      NAME = /\A[A-Za-z0-9_.-]+\z/
+
+      def initialize(token: ENV['GITHUB_TOKEN'] || ENV.fetch('GH_TOKEN', nil), http: Net::HTTP)
+        @token = token
+        @http = http
+      end
+
+      # Returns :ahead, :behind or :diverged; unavailable/inconsistent evidence
+      # raises Error. The paginated commits list is deliberately not authority.
+      def compare(owner:, repo:, old_rev:, new_rev:)
+        unless [owner, repo].all? { |v| v.is_a?(String) && NAME.match?(v) && !%w[. ..].include?(v) } &&
+               [old_rev, new_rev].all? { |v| v.is_a?(String) && SHA.match?(v) }
+          raise Error, 'GitHub comparison requires a repository and full commit SHAs'
+        end
+        return :identical if old_rev == new_rev
+
+        uri = URI("https://api.github.com/repos/#{owner}/#{repo}/compare/#{old_rev}...#{new_rev}?per_page=1")
+        request = Net::HTTP::Get.new(uri)
+        request['Accept'] = 'application/vnd.github+json'
+        request['X-GitHub-Api-Version'] = '2022-11-28'
+        request['User-Agent'] = 'confctl-forward-guard'
+        request['Authorization'] = "Bearer #{@token}" if @token && !@token.empty?
+
+        # No redirects: a token must never follow a Location to another host.
+        response = @http.start(uri.host, uri.port, use_ssl: true, open_timeout: 10, read_timeout: 30) do |http|
+          http.max_retries = 0
+          http.request(request)
+        end
+        raise Error, "GitHub comparison failed (HTTP #{response.code})" unless response.code == '200'
+
+        summary(JSON.parse(response.body), old_rev, new_rev)
+      rescue JSON::ParserError
+        raise Error, 'Malformed GitHub comparison response'
+      rescue Timeout::Error, SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse
+        # Network exceptions can contain request data; never forward their text.
+        raise Error, 'Unable to obtain GitHub ancestry evidence'
+      end
+
+      protected
+
+      def summary(data, old_rev, new_rev)
+        unless data.is_a?(Hash) && data['base_commit'].is_a?(Hash) &&
+               data['base_commit']['sha'] == old_rev && data['merge_base_commit'].is_a?(Hash) &&
+               SHA.match?(data['merge_base_commit']['sha'].to_s) &&
+               %w[ahead_by behind_by total_commits].all? { |key| data[key].is_a?(Integer) && data[key] >= 0 }
+          raise Error, 'Incomplete GitHub ancestry evidence'
+        end
+
+        ahead = data['ahead_by']
+        behind = data['behind_by']
+        base = data['merge_base_commit']['sha']
+        case data['status']
+        when 'ahead'
+          return :ahead if ahead > 0 && behind == 0 && base == old_rev && data['total_commits'] == ahead
+        when 'behind'
+          return :behind if ahead == 0 && behind > 0 && base == new_rev && data['total_commits'] == 0
+        when 'diverged'
+          return :diverged if ahead > 0 && behind > 0 && ![old_rev, new_rev].include?(base) &&
+                              data['total_commits'] == ahead
+        end
+
+        raise Error, 'Contradictory GitHub ancestry evidence'
+      end
+    end
+  end
+end
diff --git a/lib/confctl/inputs/guarded_update.rb b/lib/confctl/inputs/guarded_update.rb
new file mode 100644
index 0000000..65cc476
--- /dev/null
+++ b/lib/confctl/inputs/guarded_update.rb
@@ -0,0 +1,115 @@
+require 'open3'
+require 'tmpdir'
+require 'tty-command'
+require 'confctl/exceptions'
+require 'confctl/flake_lock'
+require 'confctl/flake_lock_diff'
+require 'confctl/inputs/lock_graph'
+require 'confctl/inputs/forward_guard'
+
+module ConfCtl
+  module Inputs
+    # The checkout must have a single writer. The process lock serializes
+    # cooperating confctl updates; snapshots detect other writers before install.
+    class GuardedUpdate
+      def initialize(conf_dir:, inputs:, guard: ForwardGuard.new)
+        @conf_dir = File.expand_path(conf_dir)
+        @inputs = inputs
+        @guard = guard
+        @lock_path = File.join(@conf_dir, 'flake.lock')
+      end
+
+      def run!(after_install: nil)
+        process_lock = git!('rev-parse', '--git-path', 'confctl-input-update.lock').strip
+        File.open(File.expand_path(process_lock, @conf_dir), File::RDWR | File::CREAT, 0o600) do |lock|
+          unless lock.flock(File::LOCK_EX | File::LOCK_NB)
+            raise ConfCtl::Error, 'another guarded input update is running'
+          end
+
+          snapshot!
+          old_lock = FlakeLock.new(@lock_path, JSON.parse(@original_lock))
+          targets = LockGraph.new(old_lock).update_inputs(@inputs)
+
+          Dir.mktmpdir('.confctl-update-', @conf_dir) do |dir|
+            reference = File.join(dir, 'reference.lock')
+            output = File.join(dir, 'candidate.lock')
+            File.binwrite(reference, @original_lock)
+            yield reference, output, targets
+            raise ConfCtl::Error, 'Nix did not produce a candidate lock' unless File.file?(output)
+
+            candidate = FlakeLock.load(output)
+            result = @guard.validate(old_lock, candidate)
+            return outcome(result.status, issues: result.issues) unless result.success?
+
+            verify_snapshot!
+            return outcome(:unchanged) if result.status == :unchanged
+
+            changes = FlakeLockDiff.from_guard(result.changes, old_lock, candidate)
+            File.chmod(@original_mode, output)
+            File.rename(output, @lock_path)
+            @installed = true
+            after_install&.call(changes)
+            outcome(:updated, changes: changes)
+          end
+        end
+      rescue StandardError => e
+        # Commit hooks may have side effects. An installed, validated candidate
+        # stays available for diagnosis if the subsequent commit fails.
+        raise if @installed
+
+        message = case e
+                  when JSON::ParserError
+                    'Invalid lock JSON'
+                  when TTY::Command::ExitError
+                    'Nix failed while preparing the candidate lock'
+                  when ConfCtl::Error, LockGraph::Error
+                    e.message
+                  else
+                    "Guarded input update failed (#{e.class})"
+                  end
+        outcome(:error, issues: [message])
+      end
+
+      protected
+
+      def snapshot!
+        unless File.file?(@lock_path) && !File.symlink?(@lock_path)
+          raise ConfCtl::Error, 'forward-only updates require an existing regular flake.lock'
+        end
+
+        git!('ls-files', '--error-unmatch', '--', 'flake.lock')
+        unless git!('status', '--porcelain=v1', '--untracked-files=no').empty?
+          raise ConfCtl::Error, 'forward-only updates require a clean tracked checkout and index'
+        end
+
+        @original_lock = File.binread(@lock_path)
+        @original_mode = File.stat(@lock_path).mode & 0o777
+        @original_flake = File.binread(File.join(@conf_dir, 'flake.nix'))
+        @head = git!('rev-parse', 'HEAD')
+        @index = git!('ls-files', '--stage', '-z')
+      end
+
+      def verify_snapshot!
+        unchanged = File.binread(@lock_path) == @original_lock &&
+                    File.binread(File.join(@conf_dir, 'flake.nix')) == @original_flake &&
+                    git!('rev-parse', 'HEAD') == @head &&
+                    git!('ls-files', '--stage', '-z') == @index &&
+                    git!('status', '--porcelain=v1', '--untracked-files=no').empty?
+        return if unchanged
+
+        raise ConfCtl::Error, 'checkout changed while preparing the input update; retry from a fresh baseline'
+      end
+
+      def git!(*args)
+        out, _err, status = Open3.capture3({ 'GIT_OPTIONAL_LOCKS' => '0' }, 'git', *args, chdir: @conf_dir)
+        raise ConfCtl::Error, "guarded update Git preflight failed (#{args.first})" unless status.success?
+
+        out
+      end
+
+      def outcome(status, changes: [], issues: [])
+        { status: status, changed: status == :updated, changes: changes, issues: issues }
+      end
+    end
+  end
+end
diff --git a/lib/confctl/inputs/lock_graph.rb b/lib/confctl/inputs/lock_graph.rb
new file mode 100644
index 0000000..094e3cb
--- /dev/null
+++ b/lib/confctl/inputs/lock_graph.rb
@@ -0,0 +1,94 @@
+module ConfCtl
+  module Inputs
+    # A semantic view of a version-7 lock, independent of generated node IDs.
+    class LockGraph
+      class Error < StandardError; end
+
+      Entry = Struct.new(:path, :node, :terminal_path)
+
+      attr_reader :entries
+
+      def initialize(lock)
+        @data = lock.respond_to?(:data) ? lock.data : lock
+        unless @data.is_a?(Hash) && @data['version'].eql?(7) && @data['nodes'].is_a?(Hash)
+          raise Error, 'Expected a version-7 flake lock graph'
+        end
+
+        @nodes = @data['nodes']
+        @root = @data['root']
+        node!(@root)
+        @entries = {}
+        walk([], @root, [@root])
+      end
+
+      def resolve_path(path)
+        components = path.is_a?(String) ? path.split('/', -1) : path
+        validate_path!(components)
+        id, terminal = resolve(components, [])
+        Entry.new(path: components.join('/'), node: node!(id), terminal_path: terminal.join('/'))
+      end
+
+      def update_inputs(names)
+        names.map { |name| resolve_path(name).terminal_path }.uniq
+      end
+
+      protected
+
+      def node!(id)
+        node = @nodes[id]
+        unless id.is_a?(String) && node.is_a?(Hash) &&
+               (!node.has_key?('inputs') || node['inputs'].is_a?(Hash)) &&
+               (id == @root || node['locked'].is_a?(Hash)) &&
+               (!node.has_key?('original') || node['original'].is_a?(Hash)) &&
+               (!node.has_key?('flake') || [true, false].include?(node['flake']))
+          raise Error, 'Malformed or dangling lock graph node'
+        end
+
+        validate_path!((node['inputs'] || {}).keys)
+        node
+      end
+
+      def validate_path!(path)
+        return if path.is_a?(Array) && path.all? { |name| name.is_a?(String) && !name.empty? && !name.include?('/') }
+
+        raise Error, 'Malformed lock input path'
+      end
+
+      def resolve(components, stack)
+        id = @root
+        terminal = []
+        components.each do |name|
+          key = [id, name]
+          raise Error, 'Cyclic follows reference in lock graph' if stack.include?(key)
+
+          edge = (node!(id)['inputs'] || {})[name]
+          case edge
+          when String
+            id = edge
+            node!(id)
+            terminal << name
+          when Array
+            validate_path!(edge)
+            id, terminal = resolve(edge, stack + [key])
+          else
+            raise Error, 'Malformed or dangling lock input reference'
+          end
+        end
+        [id, terminal]
+      end
+
+      def walk(prefix, id, ancestors)
+        (node!(id)['inputs'] || {}).keys.sort.each do |name|
+          validate_path!([name])
+          path = prefix + [name]
+          entry = resolve_path(path)
+          target, = resolve(path, [])
+          raise Error, 'Cyclic dependency in lock graph' if ancestors.include?(target)
+
+          @entries[entry.path] = entry
+          walk(path, target, ancestors + [target])
+        end
+      end
+    end
+  end
+end
