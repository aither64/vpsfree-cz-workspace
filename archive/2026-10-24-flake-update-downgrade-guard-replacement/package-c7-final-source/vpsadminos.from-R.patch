diff --git a/.github/workflows/flake-update.yml b/.github/workflows/flake-update.yml
index a68667765..f0ca63069 100644
--- a/.github/workflows/flake-update.yml
+++ b/.github/workflows/flake-update.yml
@@ -9,7 +9,7 @@ permissions:
   contents: write
 
 env:
-  CONFCTL_FLAKE: github:vpsfreecz/confctl/5436d3d7c36d3d5174eab3c44e3578830749d3db#confctl
+  CONFCTL_FLAKE: github:vpsfreecz/confctl/822c0e35dbe2549111912f539116b4225dfd3035#confctl
   GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
 
 jobs:
@@ -27,6 +27,14 @@ jobs:
 
       - uses: cachix/install-nix-action@31.11.3
 
+      - name: Restore confctl cache
+        uses: actions/cache/restore@v6
+        with:
+          path: ~/.cache/confctl
+          key: confctl-cache-${{ runner.os }}-${{ github.run_id }}
+          restore-keys: |
+            confctl-cache-${{ runner.os }}
+
       - name: Save lock baseline
         run: |
           cp flake.lock "$RUNNER_TEMP/flake-update-baseline.lock"
@@ -81,3 +89,10 @@ jobs:
           nix shell "$CONFCTL_FLAKE" -c confctl inputs check-update \
             --old-lock "$UPDATE_OLD_LOCK" --new-lock "$final_lock"
           git push origin "HEAD:${GITHUB_REF_NAME}"
+
+      - name: Save confctl cache
+        if: ${{ !cancelled() }}
+        uses: actions/cache/save@v6
+        with:
+          path: ~/.cache/confctl
+          key: confctl-cache-${{ runner.os }}-${{ github.run_id }}
diff --git a/README.md b/README.md
