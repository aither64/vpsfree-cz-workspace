+test('namespaced inventory queries isolate unrelated rows, provision one association and safely reuse it', async (t) => {
+  const inventory = fixture({ locationMissing: true, missing: true });
+  const unrelated = JSON.stringify(inventory.unrelated);
+  const calls = mockInventoryTransport(t, async (call) => {
+    if (call.resource === 'users/current') return { response: currentUser(call.login) };
+    assert.equal(call.login, 'test-admin');
+    return { response: await inventory.api(call.method, call.resource, call.body) };
+  });
+  await withInventoryConnection(recordedAccounts(), async (cluster) => {
+    const { adminApi } = await inventoryIdentity(cluster);
+    const first = await ensureIpInventory(adminApi, { userId: 2, vpsId: 10 });
+    assert.deepEqual(first, { inventoryVpsId: 10, disabledIpId: 90, disabledNetworkId: 5, disabledAddress: '203.0.113.10' });
+    assert.deepEqual(calls.filter((call) => call.method !== 'GET').map((call) => [call.method, call.resource, call.body]), [
+      ['POST', 'location_networks', { location_network: { network: 5, location: 1, primary: false, priority: 100, autopick: false, userpick: false } }],
+      ['POST', 'ip_addresses', { ip_address: { addr: '203.0.113.10/32', network: 5, user: 2, location: 1 } }],
+      ['PUT', 'networks/5', { network: { enabled: false } }],
+    ]);
+    const expectedQueries = [
+      ['/v7.0/networks', [['_meta[limit]', '1000']]],
+      ['/v7.0/location_networks', [['location_network[network]', '5'], ['_meta[limit]', '1000']]],
+      ['/v7.0/ip_addresses', [['ip_address[network]', '5'], ['_meta[limit]', '1000']]],
+      ['/v7.0/ip_addresses', [['ip_address[vps]', '10'], ['ip_address[version]', '4'], ['_meta[limit]', '1000']]],
+    ];
+    assert.deepEqual(calls.filter((call) => call.method === 'GET' && call.query.length).map((call) => [call.pathname, call.query]), expectedQueries);
+    const beforeReuse = calls.length;
+    assert.deepEqual(await ensureIpInventory(adminApi, { userId: 2, vpsId: 10 }), first);
+    assert(calls.slice(beforeReuse).every((call) => call.method === 'GET'), 'reuse cannot duplicate registration, charges or enablement');
+    assert.deepEqual(calls.slice(beforeReuse).filter((call) => call.query.length).map((call) => [call.pathname, call.query]), expectedQueries);
+    const locations = (await adminApi('GET', 'location_networks?location_network%5Bnetwork%5D=5&_meta%5Blimit%5D=1000')).location_networks;
+    assert.equal(locations.length, 1);
+    assert.equal(locations[0].network.id, 5);
+    const addresses = (await adminApi('GET', 'ip_addresses?ip_address%5Bnetwork%5D=5&_meta%5Blimit%5D=1000')).ip_addresses;
+    assert.deepEqual(addresses.map((entry) => entry.id), [90]);
+    const assigned = (await adminApi('GET', 'ip_addresses?ip_address%5Bvps%5D=10&ip_address%5Bversion%5D=4&_meta%5Blimit%5D=1000')).ip_addresses;
+    assert.deepEqual(assigned.map((entry) => entry.id), [11], 'another VPS and IPv6 rows are excluded');
+    assert.equal((await adminApi('GET', 'networks?_meta%5Blimit%5D=1')).networks.length, 1);
+    assert.equal((await adminApi('GET', 'networks?limit=1')).networks.length, 3, 'flat limit is not a metadata alias');
+  });
+  assert.equal(JSON.stringify(inventory.unrelated), unrelated, 'unrelated primary associations, addresses and VPS rows remain untouched');
+});
+
+test('old flat filters return unrelated associations and refuse before any inventory mutation', async (t) => {
+  const inventory = fixture({ locationMissing: true, missing: true });
+  const unrelated = JSON.stringify(inventory.unrelated);
+  const calls = mockInventoryTransport(t, async (call) => {
+    if (call.resource === 'users/current') return { response: currentUser(call.login) };
+    assert.equal(call.login, 'test-admin');
+    return { response: await inventory.api(call.method, call.resource, call.body) };
+  });
+  await withInventoryConnection(recordedAccounts(), async (cluster) => {
+    const { adminApi } = await inventoryIdentity(cluster);
+    const flatApi = (method, resource, body) => {
+      const url = new URL(resource, 'https://api.example.test/');
+      const flat = new URLSearchParams([...url.searchParams].map(([key, value]) =>
+        [key.replace(/^(?:location_network|ip_address|_meta)\[([^\]]+)\]$/, '$1'), value]));
+      return adminApi(method, `${url.pathname.slice(1)}${flat.size ? `?${flat}` : ''}`, body);
+    };
+    await assert.rejects(ensureIpInventory(flatApi, { userId: 2, vpsId: 10 }), /Unexpected dedicated inventory location/);
+  });
+  assert(calls.every((call) => call.method === 'GET'));
+  assert.deepEqual(calls.filter((call) => call.query.length).map((call) => [call.pathname, call.query]), [
+    ['/v7.0/networks', [['limit', '1000']]],
+    ['/v7.0/location_networks', [['network', '5'], ['limit', '1000']]],
+  ]);
+  assert.equal(JSON.stringify(inventory.unrelated), unrelated);
+  assert.equal(inventory.pool.enabled, true, 'flat-query refusal cannot disable the dedicated pool');
+});
