+class RunnerSessionTest
+  def test_public_stop_reaps_machine_owned_listener_daemons_and_retires_the_namespace
+    with_virtiofs_runner do
+      with_runner do |context|
+        with_controller(context) do |pid, input, output|
+          observe_virtiofs_runner(context, output, pid)
+          input.write('.'); input.flush
+          assert(Process.waitpid2(pid).last.success?)
+          context[:controller_reaped] = true
