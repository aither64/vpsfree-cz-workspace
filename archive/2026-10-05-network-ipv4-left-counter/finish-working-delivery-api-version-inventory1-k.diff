+  def run_interrupted_scan(engine, remaining: 5)
+    Timeout.timeout(10) do
+      engine.ssh_keyscan(two_endpoints['services'], timeout: 1,
+        deadline: Process.clock_gettime(Process::CLOCK_MONOTONIC) + remaining)
+    end
