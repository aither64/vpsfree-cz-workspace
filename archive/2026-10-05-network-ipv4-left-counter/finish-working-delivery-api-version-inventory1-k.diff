+  def test_public_stop_preserves_unknown_pidfile_and_refuses_stopped_even_after_daemons_exit
+    with_virtiofs_runner do
+      with_runner do |context|
+        with_controller(context) do |pid, input, output|
+          observe_virtiofs_runner(context, output, pid)
+          input.write('.'); input.flush
+          assert(Process.waitpid2(pid).last.success?)
+          context[:controller_reaped] = true
+          path = File.join(context[:record]['socket_dir'], 'unknown.sock.pid')
+          File.write(path, 'not cleanup authority', mode: 'wb', perm: 0o600)
+          inode = File.lstat(path).ino
+          error = assert_raises(KbRuntime::Error) { shutdown(context) }
+          assert_match(/unrecognized retained socket contents/, error.message)
+          assert_equal('stopping', context[:engine].phase['phase'])
+          assert(context[:engine].gone?(context[:record]))
+          assert(context[:engine].process_record(context[:record])['complete'])
+          assert_empty(Dir.glob(File.join(context[:engine].resources.root, '*.json')))
+          assert_equal(['not cleanup authority', inode], [File.read(path), File.lstat(path).ino])
+          assert_equal(['unknown.sock.pid'], Dir.children(context[:record]['socket_dir']))
+        end
+      end
+    end
+  end
