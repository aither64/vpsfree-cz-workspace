+  def assert_proofs_closed(machine)
+    machine.instance_variable_get(:@kb_virtiofs_paths).each_value do |proof|
+      %i[directory_fd socket_fd].each { |key| assert(proof.fetch(key).closed?) }
+    end
+  end
