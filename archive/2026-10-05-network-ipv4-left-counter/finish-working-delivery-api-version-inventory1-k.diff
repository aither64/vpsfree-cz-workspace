+  def with_adapter(klass, daemon: nil, cleanup_refusal: false)
+    Dir.mktmpdir('kb-vfs-', '/tmp') do |directory|
+      state = File.join(directory, 'disks')
+      sockets = File.join(directory, 'sockets')
+      [state, sockets].each { |path| Dir.mkdir(path, 0o700) }
+      daemon ||= write_daemon(directory)
+      config = { 'spin' => klass == KbRuntime::NixosMachine ? 'nixos' : 'vpsadminos',
+        'qemu' => '/not-executed', 'virtiofsd' => daemon, 'memory' => 64, 'cpus' => 1,
+        'kernel' => '/not-executed/kernel', 'initrd' => '/not-executed/initrd',
+        'toplevel' => '/not-executed/system',
+        (klass == KbRuntime::NixosMachine ? 'diskImage' : 'squashfs') => '/not-executed/root-image',
+        'cpu' => { 'cores' => 1, 'threads' => 1, 'sockets' => 1 }, 'disks' => [],
+        'sharedFileSystems' => { 'vpsadmin' => directory, 'vpsadminos' => directory } }
+      machine = klass.new('services', OsVm::MachineConfig.from_config(config), state, sockets)
+      machine.send(:shared_dir).setup
+      yield machine, directory
+    ensure
+      primary = $!
+      begin
+        if primary && state
+          evidence = Dir.mktmpdir('kb-virtiofs-evidence-', '/tmp')
+          Dir.glob(File.join(state, '*-fs-*.log')).each do |source|
+            target = File.join(evidence, File.basename(source))
+            FileUtils.copy_file(source, target)
+            File.chmod(0o600, target)
+            excerpt = File.binread(target, 768).gsub(/[\r\n]/, ' ')
+            warn "Virtiofs fixture native: #{excerpt}; evidence=#{target} sha256=#{Digest::SHA256.file(target).hexdigest}"
+          end
+        end
+      rescue StandardError => error
+        warn "Virtiofs fixture diagnostic retention: #{error.class}: #{error.message}"
+      end
+      begin
+        stop_daemons(machine) if machine && !machine.send(:virtiofsd_pids).empty?
+        machine&.cleanup
+      rescue StandardError, Minitest::Assertion => error
+        warn "Virtiofs fixture cleanup: #{error.class}: #{error.message}"
+        raise unless primary || cleanup_refusal
+      ensure
+        machine&.finalize
+      end
+    end
+  end
