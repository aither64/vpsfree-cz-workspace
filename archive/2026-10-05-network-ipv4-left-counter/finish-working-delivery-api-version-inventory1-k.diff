+            'disks' => [], 'sharedFileSystems' => { 'vpsadmin' => directory, 'vpsadminos' => directory } }
+          super('services', OsVm::MachineConfig.from_config(config), directory, sockets, hash_base:)
+        end
+        def start(wait_for_boot:)
+          shared_dir.setup
+          start_virtiofs
+          # Only the VM transport is synthetic. Keep the actual OSVM QEMU
+          # reaper, virtiofs stop/wait and K cleanup methods in this fixture.
+          Thread.handle_interrupt(Exception => :never) do
+            reader, @fixture_writer = IO.pipe
+            pid = Process.spawn(RbConfig.ruby, '-e', 'STDIN.read', in: reader, out: File::NULL, err: File::NULL, close_others: true)
+            reader.close
+            qemu_mutex.synchronize do
+              @qemu_pid = pid
+              @running = true
+              @qemu_reaper = run_qemu_reaper(pid)
+            end
+          ensure
+            reader&.close unless reader&.closed?
+          end
+        end
+        def wait_for_boot(timeout:)
+          shares = shared_filesystems.to_h do |share, _|
+            peer = UNIXSocket.new(virtiofs_socket_path(share))
+            begin
+              [share, JSON.parse(Timeout.timeout(5) { peer.gets })]
+            ensure
+              peer.close
+            end
+          end
+          File.write(File.join(@directory, 'machine.json'), JSON.generate('session' => Process.getsid(0),
+            'group' => Process.getpgrp, 'shares' => shares), mode: 'wb', perm: 0o600)
+        end
+        def stop(timeout:)
+          @fixture_writer.close unless @fixture_writer.closed?
+          join(timeout:)
+        end
+        def finalize
+          super
+          File.write(File.join(@directory, 'finalized'), '', mode: 'wb', perm: 0o600)
+        end
+        def cleanup
+          super
+          File.write(File.join(@directory, 'cleaned'), '', mode: 'wb', perm: 0o600)
+        end
+      end
+      class SessionRunner
+        def build_machines(opts)
+          [MachineState.new(name: 'services', machine: VirtiofsSessionMachine.new(opts[:state_dir], opts[:sock_dir], hash_base))]
+        end
+      end
+    RUBY
+    marker = "exit SessionRunner.run(ARGV, hash_base: 'synthetic-network')"
+    define_singleton_method(:runner_program) do
+      source = original.call
+      raise 'runner fixture entrypoint changed' unless source.scan(marker).length == 1
+      source.sub(marker, addition + marker)
+    end
+    singleton_class.send(:private, :runner_program)
+    yield
+  ensure
+    singleton_class.send(:remove_method, :runner_program)
+  end
+end
