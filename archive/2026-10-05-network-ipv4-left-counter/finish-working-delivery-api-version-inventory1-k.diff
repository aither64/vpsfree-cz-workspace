+  def interruption_at(boundary)
+    with_adapter(KbRuntime::NixosMachine) do |machine, _directory|
+      listeners = []
+      spawned = []
+      owner = Thread.current
+      native_socket = Socket.method(:new)
+      native_spawn = Process.method(:spawn)
+      socket = lambda do |*args|
+        listener = native_socket.call(*args)
+        listeners << listener
+        Thread.new { owner.raise Interrupt, 'owned listener interruption' }.join if boundary == :listener
+        listener
+      end
+      spawn = lambda do |*args, **options|
+        pid = native_spawn.call(*args, **options)
+        spawned << pid
+        Thread.new { owner.raise Interrupt, 'owned spawn interruption' }.join if boundary == :spawn
+        pid
+      end
+      Socket.stub(:new, socket) do
+        Process.stub(:spawn, spawn) { assert_raises(Interrupt) { machine.send(:start_virtiofs) } }
+      end
+      assert_equal(1, spawned.length)
+      assert_equal(spawned, machine.send(:virtiofsd_pids))
+      assert_equal(1, listeners.length)
+      assert(listeners.all?(&:closed?))
+      stop_daemons(machine)
+      machine.cleanup
+      assert_empty(Dir.children(machine.send(:sockdir)))
+      assert_proofs_closed(machine)
+    end
+  end
+
+  def write_daemon(directory)
+    package = File.join(directory, 'daemon')
+    Dir.mkdir(package, 0o700)
+    Dir.mkdir(File.join(package, 'bin'), 0o700)
+    File.write(File.join(package, 'bin/virtiofsd'), daemon_program, mode: 'wb', perm: 0o700)
+    package
+  end
+
+  def daemon_program
+    <<~RUBY
+      #!#{RbConfig.ruby}
+      require 'socket'
+      require 'json'
+      listener = Socket.for_fd(Integer(ARGV.fetch(ARGV.index('--fd') + 1)))
+      fds = Dir.children('/proc/self/fd').filter_map { |fd| File.readlink('/proc/self/fd/' + fd) rescue nil }
+      observation = { 'argv' => ARGV, 'fds' => fds, 'listener_type' => listener.stat.ftype.upcase,
+        'accepting' => listener.getsockopt(Socket::SOL_SOCKET, Socket::SO_ACCEPTCONN).int == 1 }
+      loop do
+        peer, = listener.accept
+        peer.puts(JSON.generate(observation))
+        peer.close
+      end
+    RUBY
+  end
+end
