+      assert_equal("drain stderr\n", File.read(File.join(File.dirname(path), 'stderr')))
+      refute(record.key?('environment'))
+    ensure
+      owner&.raise(Interrupt) if owner&.alive?
+      owner&.join
+    end
+  end
