+        end
+      rescue StandardError => error
+        cleanup_error = error
+        context[:drain_cleanup_error] = error
+      ensure
+        peer&.close unless peer&.closed?
+        server&.close unless server&.closed?
+        waiter&.join
+      end
+      raise cleanup_error if cleanup_error && !primary
+    end
+  end
