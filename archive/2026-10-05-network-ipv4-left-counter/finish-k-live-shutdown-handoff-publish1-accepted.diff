+        b_commands.map { |argv| File.dirname(File.dirname(argv[0])) })
+      assert_equal([old_source, old_source], descriptors.select { |which, _| which == 'old' }.map(&:last))
+      assert_equal(3, descriptors.count { |which, expected| which == 'b' && expected == campaign.source })
+      assert_empty(old_descriptors); assert_empty(final_descriptors)
+      assert_equal(identities, campaign.read('continuity-b.json')['identities'])
+      assert_equal(sentinels, campaign.read('continuity-b.json')['sentinels'])
