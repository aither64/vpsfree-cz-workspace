+  def test_predecessor_uses_final_controller_stop_then_genuine_old_resume_and_final_live_update
+    with_campaign do |campaign|
+      campaign.initialize_campaign
+      old_runtime = '/nix/store/synthetic-k68-runtime'
+      old_source = campaign.source.merge('revision' => KbVerify::PREDECESSOR)
+      campaign.write('predecessor.json', { 'runtime' => old_runtime, 'source' => old_source })
+      calls = []
+      campaign.define_singleton_method(:capacity) { |_operation| }
+      campaign.define_singleton_method(:checkpoint) { |stage, *_| calls << ['checkpoint', stage] }
+      campaign.define_singleton_method(:command) do |*argv, **|
+        calls << argv
+        ['', 0]
+      end
+      base = { 'instance_id' => 'b-instance', 'run_id' => 'old-run', 'artifact_id' => 'old-artifact',
+        'artifact_sha256' => 'old-digest', 'provenance' => { 'machine_toplevels' => { 'services' => 'old-closure' } } }
+      old_descriptors = [base, base.merge('run_id' => 'old-resumed')]
+      current = base.merge('run_id' => 'updated-run', 'artifact_id' => 'final-artifact', 'artifact_sha256' => 'final-digest',
+        'provenance' => { 'machine_toplevels' => { 'services' => 'new-closure' } })
+      final_descriptors = [current, current, current.merge('run_id' => 'final-resumed')]
+      descriptors = []
+      campaign.define_singleton_method(:descriptor) do |which, expected|
+        descriptors << [which, expected]
+        case which
+        when 'a' then base.merge('instance_id' => 'a-instance')
+        when 'old' then old_descriptors.shift || raise('unexpected predecessor descriptor')
+        when 'b' then final_descriptors.shift || raise('unexpected final descriptor')
