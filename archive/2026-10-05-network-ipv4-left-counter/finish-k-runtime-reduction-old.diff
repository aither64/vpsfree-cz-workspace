+      assert_equal('unknown', record['remote_cancellation'])
+      assert_equal(360, record['caller_timeout_seconds'])
+      assert_equal('synthetic/historical-drain', record['stage'])
+      assert_equal("drain stdout\n", File.read(File.join(File.dirname(path), 'stdout')))
+      assert_equal("drain stderr\n", File.read(File.join(File.dirname(path), 'stderr')))
