+      campaign.define_singleton_method(:isolation) { |_first, _second| }
+      campaign.define_singleton_method(:preparation) { |_value| }
+      if fail_drain
+        campaign.write('receipts/installed-layout.json', { 'complete' => true, 'inputs' => campaign.inputs })
+        error = assert_raises(KbVerify::Error) { campaign.run('isolation-continuity-update') }
+        assert_match(/native service refusal/, error.message)
+        assert_equal(fail_drain, drains.length)
+        operations = calls.select { |argv| argv[0].end_with?('/bin/vpsfree-kb-devcluster') && argv[2] == campaign.file('state-b') }.map { |argv| argv[3] }
+        assert_equal(fail_drain == 1 ? %w[start ssh ssh ssh] : %w[start ssh ssh ssh stop resume ssh], operations)
+        refute_includes(operations, 'update')
+        refute(File.exist?(campaign.file('receipts/isolation-continuity-update.json')))
+        assert_equal('failed', campaign.read('receipts/isolation-continuity-update-attempt.json')['stage'])
+        previous = calls.dup
