+      replacement = config.merge('kernel' => '/candidate/new/kernel', 'initrd' => '/candidate/new/initrd',
+        'toplevel' => '/candidate/new/system', 'diskImage' => candidate_image)
+      newer = artifact.merge('artifact_id' => SecureRandom.uuid)
