+  let ready = false;
+  let closed = false;
+  let protocolLost = false;
+  let cleanup;
+  let rejectReadiness;
+  const exited = new Promise((resolve) => {
+    child.once('close', (code) => {
+      closed = true;
+      if (!closing) abort.abort(new Error('Capture controller lost; fixture activity is cancelled'));
+      resolve(code);
+    });
+  });
