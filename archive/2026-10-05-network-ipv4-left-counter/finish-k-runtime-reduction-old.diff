+      peer.puts(JSON.generate('schema' => 1, 'run_id' => mode == 'wrong-ack-run' ? SecureRandom.uuid : launch['run_id'], 'accepted' => accepted))
+    end
+    peer.close
+    if mode == 'retry' && attempts == 1
