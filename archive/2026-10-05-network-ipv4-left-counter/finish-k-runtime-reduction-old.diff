+    def call(argv, cwd:, accepted: [0], input: '', stage: nil, caller_timeout: nil)
+      started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+      raise Error, 'invalid public command observation budget' if caller_timeout && (!caller_timeout.is_a?(Numeric) || !caller_timeout.finite? || caller_timeout <= 0)
