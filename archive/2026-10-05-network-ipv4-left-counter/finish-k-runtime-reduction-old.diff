+      current = base.merge('run_id' => 'updated-run', 'artifact_id' => 'final-artifact', 'artifact_sha256' => 'final-digest',
+        'provenance' => { 'source' => campaign.source, 'machine_toplevels' => { 'services' => 'new-closure' } })
+      final_descriptors = [current, current, current.merge('run_id' => 'final-resumed')]
+      descriptors = []
+      campaign.define_singleton_method(:descriptor) do |which, expected|
