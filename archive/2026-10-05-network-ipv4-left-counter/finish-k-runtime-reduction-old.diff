+      state.lock(kind, create: true) do
+        ready.write('held'); ready.close
+        release.read
+      end
+      exit! 0
+    end
+    ready.close; release.close
+    assert_equal('held', Timeout.timeout(5) { reader.read })
+    yield
+  ensure
+    writer&.close unless writer&.closed?
+    reader&.close unless reader&.closed?
