+    end
+
+    def allocation(path)
+      stat = File.lstat(path)
+      raise Error, 'capacity path is not an ordinary file or directory' unless (stat.file? || stat.directory?) && !stat.symlink?
+      allocated, = command('du', '-s', '-B1', path)
+      apparent, = command('du', '-s', '-B1', '--apparent-size', path)
+      { 'path' => path, 'device' => stat.dev, 'allocated_bytes' => Integer(allocated.split.first),
+        'apparent_bytes' => Integer(apparent.split.first) }
+    end
+
+    def remaining_growth(operation)
+      configs = Dir.glob(file('state-*/clusters/same-slug/result-config-*'))
+      images = configs.filter_map { |path| JSON.parse(File.read(path)).fetch('machines').fetch('services')['diskImage'] }.uniq
+      # Immutable service images consume store space; root copies and tank writes
+      # consume campaign space. Sparse extents are still future growth, even when
+      # File.size already reports the configured capacity. No reflink is assumed.
+      images = images.uniq { |path| stat = File.stat(path); [stat.dev, stat.ino] }
+      realized_images = images.map { |path| allocation(path) }
+      image_growth = [36 * GIB - realized_images.sum { |entry| entry.fetch('allocated_bytes') }, 0].max
+      roots = operation == 'resume-b-final' ? ['b'] : %w[a b]
+      retained_disks = []
+      disk_growth = roots.sum do |which|
+        { 'services-root.img' => 12 * GIB, 'node1-tank.img' => 16 * GIB }.sum do |name, size|
+          path = file("state-#{which}/clusters/same-slug/disks/#{name}")
+          entry = File.exist?(path) ? allocation(path) : nil
+          retained_disks << entry if entry
+          allocated = entry ? entry.fetch('allocated_bytes') : 0
+          [size - allocated, 0].max
+        end
+      end
+      { 'image_bytes' => image_growth, 'disk_bytes' => disk_growth, 'realized_images' => realized_images, 'retained_disks' => retained_disks }
+    end
+
+    def capacity(operation)
+      value, digest = capacity_assessment
+      roles = value.fetch('roles')
+      raise Error, 'capacity roles must name campaign, store and actual daemon scratch' unless roles.keys.sort == %w[builder_scratch state_images store]
+      paths = { 'state_images' => root, 'store' => '/nix/store', 'builder_scratch' => roles.fetch('builder_scratch').fetch('path') }
+      snapshots = paths.to_h do |role, path|
+        expected = roles.fetch(role)
+        raise Error, 'capacity filesystem path must be canonical and absolute' unless path == File.expand_path(path)
+        actual = filesystem(path)
+        raise Error, "capacity filesystem binding changed: #{role}" unless expected == actual.reject { |key, _| key == 'available_bytes' }
+        [role, actual]
+      end
+      check(!%w[tmpfs ramfs].include?(snapshots.fetch('state_images').fetch('fstype')), 'campaign images use disk-backed filesystem')
+      host = host_capacity
+      check(host.fetch('ram_available') >= 24 * GIB, '24 GiB available host RAM')
+      check(host.fetch('shm_available') >= 18 * GIB, '18 GiB available shared memory')
+      devices = snapshots.values.map { |entry| entry.fetch('device') }.uniq
+      budgets = value.fetch('filesystems')
+      unless budgets.map { |entry| entry.fetch('device') }.uniq.size == budgets.size && budgets.map { |entry| entry.fetch('device') }.sort == devices.sort
+        raise Error, 'capacity assessment must budget each shared filesystem once'
+      end
+      growth = remaining_growth(operation)
+      check(growth.fetch('realized_images').all? { |entry| entry['device'] == snapshots.fetch('store').fetch('device') }, 'service images remain on the bound store filesystem')
+      check(growth.fetch('retained_disks').all? { |entry| entry['device'] == snapshots.fetch('state_images').fetch('device') }, 'retained disks remain on the bound campaign filesystem')
+      charges = Hash.new(0)
+      charges[snapshots.fetch('state_images').fetch('device')] += growth.fetch('disk_bytes')
+      charges[snapshots.fetch('store').fetch('device')] += growth.fetch('image_bytes')
+      realized = value.fetch('realized_paths').uniq.map do |path|
+        raise Error, 'realized capacity path must be an immutable store path' unless path.start_with?('/nix/store/') && path == File.expand_path(path)
+        allocation(path)
+      end
+      missing = value.fetch('missing_paths').group_by { |entry| entry.fetch('path') }.map do |path, entries|
+        raise Error, 'conflicting repeated missing path evidence' unless entries.uniq.size == 1
+        entry = entries.first
+        raise Error, 'missing closure must be an immutable store path' unless path.start_with?('/nix/store/') && path == File.expand_path(path)
+        raise Error, 'missing path kind must identify closure or budgeted service image' unless %w[closure service-image].include?(entry.fetch('kind'))
+        nonnegative_bytes(entry.fetch('nar_size'))
+        nonnegative_bytes(entry.fetch('download_size')) unless entry['download_size'].nil?
+        # NAR size is a known estimate, not a claim about builder/FS peaks. A
+        # service image already belongs to the three-image extent budget above.
+        charges[snapshots.fetch('store').fetch('device')] += entry.fetch('nar_size') if entry.fetch('kind') == 'closure' && !File.exist?(path)
+        entry.merge('currently_realized' => File.exist?(path))
+      end
+      raise Error, 'receipt lists more than the three planned service images' if missing.count { |entry| entry['kind'] == 'service-image' } > 3
+      fresh = budgets.map do |budget|
+        device = budget.fetch('device')
+        reserve = nonnegative_bytes(budget.fetch('reserve_bytes'))
+        headroom = nonnegative_bytes(budget.fetch('build_headroom_bytes'))
+        raise Error, 'operator-assessed build headroom must be positive' unless headroom.positive?
+        raise Error, 'campaign reserve must retain 16 GiB' if device == snapshots.fetch('state_images').fetch('device') && reserve < 16 * GIB
+        nonnegative_bytes(budget.fetch('observed_available_bytes'))
+        available = snapshots.values.select { |entry| entry['device'] == device }.map { |entry| entry.fetch('available_bytes') }.min
+        remaining = charges.fetch(device, 0)
+        check(available >= remaining + reserve + headroom, 'fresh filesystem growth, reserve and assessed headroom')
+        { 'device' => device, 'available_bytes' => available, 'remaining_growth_bytes' => remaining,
+          'reserve_bytes' => reserve, 'available_build_headroom_bytes' => available - remaining - reserve,
+          'assessed_build_headroom_bytes' => headroom }
+      end
+      policy = value.fetch('build_plan')
+      if commands.respond_to?(:environment)
+        commands.environment['NIX_CONFIG'] = commands.environment.fetch('NIX_CONFIG').lines.reject { |line| line.match?(/\A(?:max-jobs|cores) =/) }.join +
+          "max-jobs = #{policy.fetch('max_jobs')}\ncores = #{policy.fetch('cores')}\n"
+      end
+      write("receipts/capacity-#{SecureRandom.hex(12)}.json", { 'schema' => 1, 'operation' => operation,
+        'receipt_sha256' => digest, 'assessment' => value, 'measured_at' => Time.now.utc.iso8601,
+        'host' => host, 'filesystems' => fresh, 'owned_output' => allocation(root), 'realized_paths' => realized,
+        'remaining_growth' => growth, 'known_missing_paths' => missing,
+        'scratch_bound' => 'unknown', 'owned_output_worst_envelope' => 108 * GIB }, immutable: true)
+    end
+
+    def descriptor(which, metadata)
+      out, = engine(which, 'connection')
+      value = JSON.parse(out)
+      check(value.dig('provenance', 'source') == metadata, "#{which} exact prepared source")
+      observations = {}
+      value.fetch('provenance').fetch('machine_toplevels').each do |machine, closure|
+        identity, = engine(which, 'ssh', machine, '--', 'cat', '/etc/vpsfree-kb-capture.json')
+        check(JSON.parse(identity) == value.fetch('provenance').fetch('guest_identity'), "#{which}/#{machine} live guest identity")
+        running, = engine(which, 'ssh', machine, '--', 'readlink', '-f', '/run/current-system')
+        check(running.strip == closure, "#{which}/#{machine} actual system closure")
+        observations[machine] = { 'identity_sha256' => Digest::SHA256.hexdigest(identity), 'closure' => closure }
+      end
+      @guest_observations ||= {}
+      @guest_observations[[which, value.fetch('run_id')]] = { 'descriptor' => JSON.parse(JSON.generate(value)), 'machines' => observations }
+      value
+    end
+
+    def historical_router_drain(value)
+      proof = @guest_observations&.fetch(['old', value.fetch('run_id')], nil)
+      check(proof && proof.fetch('descriptor') == value && value.dig('provenance', 'source', 'revision') == PREDECESSOR,
+        'historical drain follows exact predecessor descriptor/source attestation')
+      service = proof.fetch('machines').fetch('services')
+      script = <<~SH
+        set -eu
+        test "$(sha256sum /etc/vpsfree-kb-capture.json | cut -d ' ' -f 1)" = "$1"
+        test "$(readlink -f /run/current-system)" = "$2"
+        timeout 360 systemctl stop vpsadmin-console-router.service
+        systemctl show vpsadmin-console-router.service --property=LoadState,ActiveState,SubState,MainPID,Result
+      SH
+      checkpoint('draining-predecessor-console-router', 'run_id' => value.fetch('run_id'))
+      output, = engine('old', 'ssh', 'services', '--', 'sh', '-s', '--', service.fetch('identity_sha256'),
+        service.fetch('closure'), input: script, caller_timeout: 360)
+      properties = router_properties(output)
+      check(properties == { 'LoadState' => 'loaded', 'ActiveState' => 'inactive', 'SubState' => 'dead',
+        'MainPID' => '0', 'Result' => 'success' }, 'historical console router clean inactive result')
+      write("receipts/router-drain-#{value.fetch('run_id')}.json", { 'schema' => 1,
+        'source' => value.fetch('provenance').fetch('source'), 'run_id' => value.fetch('run_id'),
+        'artifact_id' => value.fetch('artifact_id'), 'artifact_sha256' => value.fetch('artifact_sha256'),
+        'unit' => 'vpsadmin-console-router.service', 'properties' => properties,
+        'guard' => service, 'output_sha256' => Digest::SHA256.hexdigest(output),
+        'guest_timeout_seconds' => 360, 'caller_timeout_seconds' => 360 }, immutable: true)
+      assertions << 'operator-prepared 7dc K-runtime-only crossing; unchanged V; ordinary historical stop and K68 excluded'
+    end
+
+    def router_properties(output)
+      entries = output.lines.map { |line| line.chomp.split('=', 2) }
+      check(entries.all? { |entry| entry.size == 2 } && entries.map(&:first).sort == %w[ActiveState LoadState MainPID Result SubState],
+        'exact console router service properties')
+      entries.to_h
+    end
+
+    def restored_router(value)
+      output, = engine('b', 'ssh', 'services', '--', 'systemctl', 'show', 'vpsadmin-console-router.service',
+        '--property=LoadState,ActiveState,SubState,MainPID,Result')
+      properties = router_properties(output)
+      check(properties.slice('LoadState', 'ActiveState', 'SubState', 'Result') ==
+        { 'LoadState' => 'loaded', 'ActiveState' => 'active', 'SubState' => 'running', 'Result' => 'success' } &&
+        /\A[1-9][0-9]*\z/.match?(properties.fetch('MainPID')), 'final boot restores healthy console router')
+      write("receipts/router-health-#{value.fetch('run_id')}-#{SecureRandom.hex(6)}.json", { 'schema' => 1,
+        'source' => value.fetch('provenance').fetch('source'), 'run_id' => value.fetch('run_id'),
+        'artifact_id' => value.fetch('artifact_id'), 'unit' => 'vpsadmin-console-router.service',
+        'properties' => properties, 'output_sha256' => Digest::SHA256.hexdigest(output) }, immutable: true)
+    end
+
+    def identities
+      directory = file('state-b/clusters/same-slug')
+      files = CREDENTIALS.to_h { |name| [name, Digest::SHA256.file(File.join(directory, 'credentials', name)).hexdigest] }
+      disks = %w[services-root.img node1-tank.img].to_h do |name|
+        path = File.join(directory, 'disks', name)
+        stat = File.lstat(path)
+        check(stat.file? && !stat.symlink? && stat.uid == Process.uid, 'owned retained disk')
+        [name, { 'device' => stat.dev, 'inode' => stat.ino, 'size' => stat.size }]
+      end
+      accounts = Digest::SHA256.hexdigest(@state.file(File.join(directory, 'accounts.json')))
+      { 'credentials' => files, 'disks' => disks, 'accounts_sha256' => accounts }
+    end
+
+    def sentinels(which)
+      { 'services' => '/root/kb-root-sentinel', 'node1' => '/tank/kb-data-sentinel' }.to_h do |machine, path|
+        output, = engine(which, 'ssh', machine, '--', 'sha256sum', path)
+        [machine, output.split.first]
+      end
+    end
+
+    def continuity(previous, current, identity, sentinel)
+      check(current.fetch('instance_id') == previous.fetch('instance_id'), 'retained instance identity')
+      check(current.fetch('run_id') != previous.fetch('run_id'), 'fresh live run identity')
+      check(current.fetch('artifact_id') == previous.fetch('artifact_id') && current.fetch('artifact_sha256') == previous.fetch('artifact_sha256'), 'cold resume reuses accepted artifact')
+      check(current.fetch('provenance').fetch('machine_toplevels') == previous.fetch('provenance').fetch('machine_toplevels'), 'cold resume does not rebuild closures')
+      check(identities == identity, 'all six credentials, private accounts digest and disk identities preserved')
+      check(sentinels('b') == sentinel, 'root/data sentinels preserved')
+    end
+
+    def isolation_continuity_update
+      checkpoint('starting-a')
+      engine('a', 'start', '--network', 'local', '--topology', 'single', '--config', file('config-a.json'))
+      a = descriptor('a', source)
+      checkpoint('starting-predecessor-b')
+      old_source = read('predecessor.json').fetch('source')
+      engine('old', 'start', '--network', 'local', '--topology', 'single', '--config', file('config-b.json'))
+      old = descriptor('old', old_source)
+      isolation(a, old)
+      { 'services' => '/root/kb-root-sentinel', 'node1' => '/tank/kb-data-sentinel' }.each do |machine, path|
+        engine('old', 'ssh', machine, '--', 'sh', '-c', 'test ! -e "$1"; printf "%s" "$2" > "$1"', 'sh', path, read('campaign.json').fetch('campaign_id'))
+      end
+      identity, sentinel = identities, sentinels('old')
+      write('continuity-b.json', { 'identities' => identity, 'sentinels' => sentinel }, immutable: true)
+      historical_router_drain(old)
+      checkpoint('final-controller-stop-of-predecessor-b')
+      engine('b', 'stop', '--timeout', '900')
+      engine('old', 'resume')
+      resumed = descriptor('old', old_source)
+      continuity(old, resumed, identity, sentinel)
+      descriptor('a', source)
+      historical_router_drain(resumed)
+      checkpoint('updating-b')
+      engine('b', 'update', '--timeout', '900', '--network', 'local', '--topology', 'single', '--config', file('config-b.json'))
+      assertions << 'final-controller stop of predecessor runner, genuine predecessor resume, final-controller update'
+      current = descriptor('b', source)
+      restored_router(current)
+      check(current.fetch('instance_id') == old.fetch('instance_id') && current.fetch('run_id') != resumed.fetch('run_id'), 'update retains instance with fresh run')
+      check(current.fetch('artifact_id') != resumed.fetch('artifact_id') && current.fetch('provenance').fetch('machine_toplevels') != resumed.fetch('provenance').fetch('machine_toplevels'), 'genuinely changed artifact and closures')
+      check(identities == identity && sentinels('b') == sentinel, 'update preserves disks, six credentials, private accounts digest and sentinels')
+      preparation(current)
+      isolation(descriptor('a', source), current)
+      checkpoint('resetting-only-a')
+      engine('a', 'stop', '--timeout', '900')
+      engine('a', 'reset')
+      check(!File.exist?(file('state-a/clusters/same-slug')), 'only owned A tree reset')
+      current = descriptor('b', source)
+      engine('b', 'stop', '--timeout', '900')
+      engine('b', 'resume')
+      final = descriptor('b', source)
+      restored_router(final)
+      continuity(current, final, identity, sentinel)
+      write('accepted-b.json', final, immutable: true)
+      checkpoint('public-lease-proof')
+      command('node', File.join(source.fetch('source'), 'tools/verify-live-lease.cjs'), file('accepted-b.json'),
+        selection.fetch('metadata'), selection.fetch('runtime'), file('state-b'), file('config-b.json'))
+      assertions << 'public lease lifecycle exclusion, EOF/interruption, reacquisition, wrong-source refusal and routing'
+    end
+
+    def isolation(first, second)
+      check(first.fetch('instance_id') != second.fetch('instance_id'), 'same slug has independent instances')
+      check(first.fetch('machines') != second.fetch('machines'), 'two roots have disjoint SSH endpoints')
+      records = %w[a b].map do |name|
+        phase = @state.read(file("state-#{name}/clusters/same-slug/phase.json"))
+        @state.read(file("state-#{name}/clusters/same-slug/launch-#{phase.fetch('run_id')}.json"))
+      end
+      check(records.map { |record| record.fetch('state_root') }.uniq.size == 2 && records.map { |record| record.fetch('socket_dir') }.uniq.size == 2, 'distinct roots and sockets')
+      claims = records.map { |record| record.fetch('resource_claims') }
+      check((claims[0] & claims[1]).empty? && claims.all? { |set| set.any? { |claim| claim['kind'] == 'udp' } }, 'TCP/UDP claims are disjoint')
+    end
+
+    def preparation(descriptor)
+      artifact = descriptor.fetch('artifact_id')
+      summary = @state.read(file("state-b/clusters/same-slug/prepared-#{artifact}.json"))
+      check(summary['complete'] == true && summary['kind'] == 'import', 'candidate import completed before new boot')
+      proof = @state.read(file("state-b/clusters/same-slug/prepared-#{artifact}-services.json"))
+      check(proof['complete'] == true && proof['artifact_sha256'] == descriptor.fetch('artifact_sha256'), 'exact candidate preparation receipt')
+      gcroot, = engine('b', 'ssh', 'services', '--', 'readlink', '-f', proof.fetch('guest_root'))
+      check(gcroot.strip == proof.fetch('toplevel'), 'candidate guest GC root retained')
+      actual, = engine('b', 'ssh', 'services', '--', 'nix', 'path-info', '--recursive', '--json', proof.fetch('toplevel'))
+      value = JSON.parse(actual)
+      value = value.to_h { |entry| [entry.fetch('path'), entry] } if value.is_a?(Array)
+      normalized = value.transform_values { |entry| { 'narHash' => entry.fetch('narHash'), 'narSize' => entry.fetch('narSize'), 'references' => entry.fetch('references').sort } }
+      check(normalized == proof.fetch('closure'), 'live candidate closure content and references')
+    end
+
+    def bilingual_capture
+      restored_router(descriptor('b', source))
+      before = source_hashes
+      output = file('output')
+      capture = File.join(selection.fetch('capture'), 'bin/vpsfree-kb-capture')
+      command(capture, '--cluster', 'same-slug', '--state-root', file('state-b'), '--language', 'cs', '--checkpoint', 'networking/ip-address-list', '--output-root', output)
+      value, = engine('b', 'connection')
+      write('capture-connection.json', JSON.parse(value))
+      command(capture, '--connection', file('capture-connection.json'), '--language', 'en', '--checkpoint', 'networking/ip-address-list', '--output-root', output)
+      command(capture, '--connection', file('capture-connection.json'), '--language', 'en', '--checkpoint', 'networking/ip-address-list', cwd: output)
+      validate = File.join(selection.fetch('capture'), 'bin/vpsfree-kb-validate')
+      command(validate, '--update', '--output-root', output)
+      command(validate, '--output-root', output)
+      rows = JSON.parse(File.read(File.join(output, 'tmp/capture-results.json')))
+      check(rows.map { |row| [row.fetch('language'), row.fetch('id')] }.sort == [['cs', 'networking/ip-address-list'], ['en', 'networking/ip-address-list']], 'exact bilingual results')
+      check(rows.all? { |row| row.dig('provenance', 'source') == source }, 'both captures bind final immutable source')
+      check(source_hashes == before, 'capture/validation leave source immutable')
+      write('receipts/export.json', KbCaptureArtifacts.export(output, file('export')), immutable: true)
+      assertions << 'strict installed full-inventory validation and five-file physical-lock checksum export'
+    end
+  end
+
+  def self.run(argv)
+    options = {}
+    parser = OptionParser.new do |value|
+      value.banner = 'Usage: vpsfree-kb-verify --root DIR --config-a FILE --config-b FILE --predecessor-ref EXACT-REF --capacity-receipt FILE --phase PHASE'
+      %w[root config-a config-b predecessor-ref capacity-receipt phase selection].each do |name|
+        value.on("--#{name} VALUE") do |argument|
+          key = name.tr('-', '_').to_sym
+          raise Error, "duplicate option: --#{name}" if options.key?(key)
+          options[key] = argument
+        end
+      end
+      value.on('--help') { puts value; return 0 }
+    end
+    parser.parse!(argv)
+    raise Error, 'unexpected positional arguments' unless argv.empty?
+    phase = options.delete(:phase) || raise(Error, '--phase is required')
+    selected = options.delete(:selection) || raise(Error, 'use the packaged verifier with its fixed source selection')
+    %i[root config_a config_b predecessor_ref capacity_receipt].each { |name| options.fetch(name) }
+    options[:selection] = JSON.parse(File.read(selected))
+    Campaign.new(**options).run(phase)
+    puts JSON.generate('phase' => phase, 'complete' => true)
+    0
+  rescue Error, KbRuntime::Error, KeyError, OptionParser::ParseError, JSON::ParserError, SystemCallError => error
+    warn "Verification refused: #{error.message}"
+    1
+  end
+end
+
+exit KbVerify.run(ARGV) if $PROGRAM_NAME == __FILE__
