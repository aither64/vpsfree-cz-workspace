+        assert.equal(error.message, statusCode === 404
+          ? 'Inventory resource action failed: GET /v7.0/users/current (HTTP 404)' : 'Inventory resource response is invalid');
+        assert.equal(error.cause, undefined, 'no parser cause or response excerpt is retained');
