+const responseSecret = 'synthetic-response-boundary-secret';
+for (const [label, statusCode, raw] of [
+  ['malformed HTTP404', 404, responseSecret],
+  ['malformed HTTP200', 200, responseSecret],
+  ['null envelope', 200, JSON.stringify(null)],
+  ['array envelope', 200, JSON.stringify([responseSecret])],
+  ['primitive envelope', 200, JSON.stringify(responseSecret)],
+  ['false success status', 200, JSON.stringify({ status: false, response: { private: responseSecret } })],
+  ['non-boolean success status', 200, JSON.stringify({ status: 'true', response: { private: responseSecret } })],
+  ['missing response', 200, JSON.stringify({ status: true, message: responseSecret })],
+  ['null response', 200, JSON.stringify({ status: true, response: null, message: responseSecret })],
+  ['array response', 200, JSON.stringify({ status: true, response: [responseSecret] })],
+  ['primitive response', 200, JSON.stringify({ status: true, response: responseSecret })],
+]) {
+  test(`inventory ${label} has bounded private diagnostics before browser or mutation`, async (t) => {
+    const accounts = recordedAccounts();
+    const calls = mockInventoryTransport(t, () => ({ statusCode, raw }));
+    await withInventoryConnection(accounts, async (cluster, _abort, root) => {
+      const page = {
+        locator() { assert.fail('invalid response must precede browser work'); },
+        goto() { assert.fail('invalid response must precede browser navigation'); },
