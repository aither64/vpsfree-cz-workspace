UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)


user = User.find(1)
pool = Pool.find(1)
dataset = Dataset.new(
  name: "client-snapshot-download",
  user: user,
  user_editable: true,
  user_create: true,
  user_destroy: true,
  confirmed: Dataset.confirmed(:confirm_create)
)
chain, created = TransactionChains::Dataset::Create.fire(
  pool,
  nil,
  [dataset],
  automount: false,
  properties: {refquota: 10240},
  user: user,
  label: "client-snapshot-download"
)
dip = Array(created).last

puts JSON.dump(
  chain_id: chain.id,
  dataset_id: dataset.id,
  dataset_in_pool_id: dip.id,
  dataset_full_name: dataset.full_name
)

RUBY

