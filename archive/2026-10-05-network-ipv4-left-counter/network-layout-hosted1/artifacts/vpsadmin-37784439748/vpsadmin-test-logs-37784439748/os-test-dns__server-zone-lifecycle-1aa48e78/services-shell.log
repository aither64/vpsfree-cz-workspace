START: 2026-10-08 16:33:05 +0200
COMMAND: set -euo pipefail
api_dir="$(systemctl show -p WorkingDirectory --value vpsadmin-api)"
api_root="$(dirname "$api_dir")"
tmp_rb="$(mktemp /tmp/vpsadmin-storage-XXXX.rb)"
trap 'rm -f "$tmp_rb"' EXIT

cat > "$tmp_rb" <<'RUBY'
ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.find(1)
User.current = user
UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)


node = Node.find(301)
server = DnsServer.create!(
  node: node,
  name: "ns1.dns.test",
  ipv4_addr: node.ip_addr,
  hidden: false,
  enable_user_dns_zones: true,
  user_dns_zone_type: :primary_type
)

puts JSON.dump(
  id: server.id,
  node_id: server.node_id,
  name: server.name,
  ipv4_addr: server.ipv4_addr
)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
END: 2026-10-08 16:33:09 +0200
ELAPSED: 4.31s
STATUS: 0
