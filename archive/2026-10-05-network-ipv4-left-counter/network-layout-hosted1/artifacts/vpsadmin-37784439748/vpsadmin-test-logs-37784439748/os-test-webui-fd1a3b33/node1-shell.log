while IFS='|' read -r pool_fs; do
  [ -n "$pool_fs" ] || continue
  ensure_dataset "$pool_fs/vpsadmin/config"
  ensure_dataset "$pool_fs/vpsadmin/download"
  ensure_dataset "$pool_fs/vpsadmin/mount"
