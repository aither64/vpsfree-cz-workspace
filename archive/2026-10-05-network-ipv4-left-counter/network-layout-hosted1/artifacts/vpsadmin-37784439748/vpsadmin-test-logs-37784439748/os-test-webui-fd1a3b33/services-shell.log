START: 2026-10-08 17:51:45 +0200
COMMAND: set -euo pipefail
api_dir="$(systemctl show -p WorkingDirectory --value vpsadmin-api)"
api_root="$(dirname "$api_dir")"
tmp_rb="$(mktemp /tmp/vpsadmin-storage-XXXX.rb)"
trap 'rm -f "$tmp_rb"' EXIT

cat > "$tmp_rb" <<'RUBY'
ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.find(1)
User.current = user
UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)

netif = NetworkInterface.find(4)
vps = netif.vps
name = netif.name
netif.delete
chain, netif = TransactionChains::NetworkInterface::VethRouted::Create.fire(vps, name)

fixtures = JSON.parse(File.read("/tmp/vpsadmin-webui-fixtures.json"))
fixtures.fetch('networking').fetch('vps').fetch('ip_release')['networkInterfaceId'] = netif.id
File.write("/tmp/vpsadmin-webui-fixtures.json", JSON.generate(fixtures))
puts JSON.dump(chain_id: chain.id, netif_id: netif.id)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
