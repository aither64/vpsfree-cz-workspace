  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)

User.find_by!(login: 'webui-user').update!(
  mailer_enabled: false
)
puts JSON.dump(ok: true)

RUBY

