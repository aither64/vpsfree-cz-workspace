START: 2026-10-08 17:51:52 +0200
COMMAND: set -euo pipefail
api_dir="$(systemctl show -p WorkingDirectory --value vpsadmin-api)"
api_root="$(dirname "$api_dir")"
tmp_rb="$(mktemp /tmp/vpsadmin-storage-XXXX.rb)"
trap 'rm -f "$tmp_rb"' EXIT

cat > "$tmp_rb" <<'RUBY'
ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.find(1)
User.current = user
UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)


user = User.find_by!(login: 'webui-user')
previous_mailer_enabled = user.mailer_enabled
user.update!(mailer_enabled: true)

# The browser fixtures insert owned addresses directly. Match
# their accounting before exercising ordinary release chains.
env = Environment.find(1)
[user, User.find_by!(login: 'webui-user-secondary')].each do |owner|
  config = owner.environment_user_configs.find_by!(environment: env)
  usage = IpAddress.joins(:network).where(
    user: owner,
    charged_environment: env,
    networks: { ip_version: 4, role: Network.roles[:public_access] }
  ).sum(:size)
  config.reallocate_resource!(
    :ipv4, usage, user: owner, save: true,
    confirmed: ClusterResourceUse.confirmed(:confirmed)
