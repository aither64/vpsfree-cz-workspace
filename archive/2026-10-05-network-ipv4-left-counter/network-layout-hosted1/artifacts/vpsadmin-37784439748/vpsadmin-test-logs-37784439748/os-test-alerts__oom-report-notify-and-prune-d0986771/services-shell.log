ENV['RACK_ENV'] ||= 'production'
require 'json'
Dir.chdir(ENV.fetch('API_DIR'))
$LOAD_PATH.unshift(File.join(ENV.fetch('API_DIR'), 'lib'))
require 'vpsadmin'
user = User.find(1)
User.current = user
UserSession.current = UserSession.create!(
  user: user,
  auth_type: 'basic',
  api_ip_addr: '127.0.0.1',
  client_version: 'storage-integration'
)

ENV["DAYS"] = "1"

before_chain_id = TransactionChain.maximum(:id).to_i
VpsAdmin::API::Tasks::OomReport.new.public_send("prune")
chain_ids = TransactionChain.where('id > ?', before_chain_id).order(:id).pluck(:id)

puts JSON.dump(ok: true, chain_ids: chain_ids)

RUBY

API_DIR="$api_dir" "$api_root/ruby-env-wrapped/bin/ruby" "$tmp_rb"
END: 2026-10-08 17:49:47 +0200
