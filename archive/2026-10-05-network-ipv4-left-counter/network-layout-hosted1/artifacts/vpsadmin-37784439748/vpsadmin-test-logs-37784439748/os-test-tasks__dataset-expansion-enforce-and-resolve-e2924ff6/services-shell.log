START: 2026-10-08 18:36:38 +0200
COMMAND: echo "[after_test_script_run] systemctl --failed"
systemctl_output=$(systemctl --failed --no-legend --no-pager --type=service 2>&1 || true)
printf '%s
' "$systemctl_output"

failed_units=$(printf '%s
' "$systemctl_output" | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /\.service$/) print $i }')

if [ -z "$failed_units" ]; then
  echo "[after_test_script_run] no failed services found"
  exit 0
fi

for unit in $failed_units; do
  echo "[after_test_script_run] journalctl --no-pager -n 1000 -u ${unit}"
  journalctl --no-pager -n 1000 -u "${unit}"
  echo
done
END: 2026-10-08 18:36:38 +0200
ELAPSED: 0.04s
STATUS: 0
