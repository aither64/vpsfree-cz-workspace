+      with_controller(context) do |pid, input, output|
+        observe_runner(context, output, pid)
+        input.write('.')
+        input.flush
+        status = Process.waitpid2(pid).last
+        context[:controller_reaped] = true
+        assert(status.success?)
+        assert_retained_runner(context)
+        shutdown(context)
