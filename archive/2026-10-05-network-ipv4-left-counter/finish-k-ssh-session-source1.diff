+        if remaining <= 0 || truncated
+          expired = remaining <= 0
+          break
+        end
+        if pid
+          waited = Process.waitpid2(pid, Process::WNOHANG)
+          if waited
+            status = waited.last
+            pid = nil
+          end
+        end
+        next if pending.empty? && status
+        readable = IO.select(pending, nil, nil, [0.1, remaining].min)&.first || []
