+  def key(endpoint, fill = 'k')
+    wire = [11].pack('N') + 'ssh-ed25519' + [32].pack('N') + fill * 32
+    "[#{endpoint['host']}]:#{endpoint['port']} ssh-ed25519 #{Base64.strict_encode64(wire)}"
+  end
