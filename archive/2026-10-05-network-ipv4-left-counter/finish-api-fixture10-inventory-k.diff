+            ensure
+              @writer.close unless @writer.closed?
+              @reaper.join
+            end
+          end
+        end
+        class SessionRunner
+          def build_machines(opts)
+            [MachineState.new(name: 'services', machine: AckLossMachine.new(opts[:state_dir]))]
+          end
+        end
+      end
+      exit SessionRunner.run(ARGV, hash_base: 'synthetic-network')
+    RUBY
+  end
+end
