+    const artifacts = capture(value, 'cs', 'cs');
+    fs.writeFileSync(artifactPath(value.outputRoot, value.manifest.assets[0].variants.cs.output), 'partial');
+    assert.throws(() => new Artifacts({ ...value, source }), /hash/);
