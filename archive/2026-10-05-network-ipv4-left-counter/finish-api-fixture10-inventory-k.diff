+  private
+
+  def observe_virtiofs_runner(context, output, controller_pid)
+    controller = JSON.parse(Timeout.timeout(5) { output.gets })
+    assert_equal(controller_pid, controller['controller_pid'])
+    proof = context[:engine].process_record(context[:record])
+    assert_equal(controller['runner_pid'], proof['runner']['pid'])
+    assert(KbRuntime::ProcessIdentity.runner_matches?(proof['runner'], context[:record]))
+    context[:runner] = proof['runner']
+    context[:children] = proof['children']
+    assert_equal(4, proof['children'].length, 'three daemons and the owned stand-in VM process')
+    assert(proof['children'].all? { |child| KbRuntime::ProcessIdentity.matches?(child) })
+    marker = JSON.parse(File.read(context[:marker]))
+    assert_equal(proof['runner']['pid'], marker['session'])
+    assert_equal(proof['runner']['pid'], marker['group'])
+    assert_equal(%w[vmSharedDir vpsadmin vpsadminos].sort, marker['shares'].keys.sort)
+    guards = %w[gate operation].map { |kind| File.join(context[:state].root, 'locks', "#{context[:state].slug}.#{kind}.lock") }
+    marker['shares'].each_value do |observed|
+      (guards + [context[:generation], context[:record]['socket_dir']]).each { |path| refute_includes(observed['fds'], path) }
+      assert_equal(['--fd', '3'], observed['argv'].first(2))
+      assert(observed['accepting'])
+    end
+  end
+
+  def with_virtiofs_runner
+    original = method(:runner_program)
+    daemon = VirtiofsListenerTest.new('fixture').send(:daemon_program)
+    addition = <<~RUBY
+      class VirtiofsSessionMachine < KbRuntime::NixosMachine
+        def initialize(directory, sockets, hash_base)
+          @directory = directory
+          package = File.join(directory, 'daemon')
+          Dir.mkdir(package, 0o700)
+          Dir.mkdir(File.join(package, 'bin'), 0o700)
+          File.write(File.join(package, 'bin/virtiofsd'), #{daemon.inspect}, mode: 'wb', perm: 0o700)
+          config = { 'spin' => 'nixos', 'qemu' => '/not-executed', 'virtiofsd' => package,
+            'kernel' => '/not-executed/kernel', 'initrd' => '/not-executed/initrd',
+            'toplevel' => '/not-executed/system', 'diskImage' => '/not-executed/root-image',
+            'memory' => 64, 'cpus' => 1, 'cpu' => { 'cores' => 1, 'threads' => 1, 'sockets' => 1 },
+            'disks' => [], 'sharedFileSystems' => { 'vpsadmin' => directory, 'vpsadminos' => directory } }
+          super('services', OsVm::MachineConfig.from_config(config), directory, sockets, hash_base:)
+        end
+        def start(wait_for_boot:)
+          shared_dir.setup
+          start_virtiofs
+          # Only the VM transport is synthetic. Keep the actual OSVM QEMU
+          # reaper, virtiofs stop/wait and K cleanup methods in this fixture.
+          Thread.handle_interrupt(Exception => :never) do
+            reader, @fixture_writer = IO.pipe
+            pid = Process.spawn(RbConfig.ruby, '-e', 'STDIN.read', in: reader, out: File::NULL, err: File::NULL, close_others: true)
+            reader.close
+            qemu_mutex.synchronize do
+              @qemu_pid = pid
+              @running = true
+              @qemu_reaper = run_qemu_reaper(pid)
+            end
+          ensure
+            reader&.close unless reader&.closed?
+          end
+        end
+        def wait_for_boot(timeout:)
+          shares = shared_filesystems.to_h do |share, _|
+            peer = UNIXSocket.new(virtiofs_socket_path(share))
+            begin
+              [share, JSON.parse(Timeout.timeout(5) { peer.gets })]
+            ensure
+              peer.close
+            end
+          end
+          File.write(File.join(@directory, 'machine.json'), JSON.generate('session' => Process.getsid(0),
+            'group' => Process.getpgrp, 'shares' => shares), mode: 'wb', perm: 0o600)
+        end
+        def stop(timeout:)
+          @fixture_writer.close unless @fixture_writer.closed?
+          join(timeout:)
+        end
+        def finalize
+          super
+          File.write(File.join(@directory, 'finalized'), '', mode: 'wb', perm: 0o600)
+        end
+        def cleanup
+          super
+          File.write(File.join(@directory, 'cleaned'), '', mode: 'wb', perm: 0o600)
+        end
+      end
+      class SessionRunner
+        def build_machines(opts)
+          [MachineState.new(name: 'services', machine: VirtiofsSessionMachine.new(opts[:state_dir], opts[:sock_dir], hash_base))]
+        end
+      end
+    RUBY
+    marker = "exit SessionRunner.run(ARGV, hash_base: 'synthetic-network')"
+    define_singleton_method(:runner_program) do
+      source = original.call
+      raise 'runner fixture entrypoint changed' unless source.scan(marker).length == 1
+      source.sub(marker, addition + marker)
+    end
+    singleton_class.send(:private, :runner_program)
+    yield
+  ensure
+    singleton_class.send(:remove_method, :runner_program)
+  end
+end
