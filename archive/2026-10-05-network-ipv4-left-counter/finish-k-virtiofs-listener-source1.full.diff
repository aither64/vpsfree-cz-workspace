+  def test_both_machine_classes_pass_only_the_listener_for_all_three_shares
+    CLASSES.each do |klass|
+      with_adapter(klass) do |machine, directory|
+        guard = File.open(File.join(directory, 'guard.lock'), 'w', 0o600)
+        guard.close_on_exec = false
+        machine.send(:start_virtiofs)
+        assert_equal(3, machine.send(:virtiofsd_pids).length)
+        machine.send(:shared_filesystems).each do |share, shared_path|
+          path = machine.send(:virtiofs_socket_path, share)
+          peer = UNIXSocket.new(path)
+          observed = JSON.parse(Timeout.timeout(5) { peer.gets })
+          peer.close
+          assert_equal(['--fd', '3', '--shared-dir', shared_path, '--cache', 'auto'], observed['argv'])
+          assert_equal('SOCKET', observed['listener_type'])
+          assert(observed['accepting'])
+          assert_equal(Process.uid, File.lstat(path).uid)
+          assert_equal(0o600, File.lstat(path).mode & 0o7777)
+          refute_includes(observed['fds'], guard.path)
+          machine.instance_variable_get(:@kb_virtiofs_paths).each_value do |proof|
+            [proof[:directory_fd], proof[:socket_fd]].each { |fd| assert(fd.close_on_exec?) }
+            refute_includes(observed['fds'], proof[:directory])
+            refute_includes(observed['fds'], proof[:path])
+          end
+          refute(File.exist?(path + '.pid'))
+        end
+        expected = machine.send(:shared_filesystems).keys.map { |share| machine.send(:virtiofs_socket_path, share) }
+        options = machine.send(:qemu_virtiofs_options)
+        expected.each { |path| assert(options.any? { |option| option.include?("path=#{path}") }) }
+        stop_daemons(machine)
+        machine.cleanup
+        assert_empty(Dir.children(machine.send(:sockdir)))
+        machine.cleanup
+        assert_proofs_closed(machine)
+      ensure
+        guard&.close
+      end
+    end
+  end
+
+  def test_selected_pinned_virtiofsd_consumes_the_real_listener_without_pidfiles
+    selected = ENV.fetch('VPSADMIN_KB_VIRTIOFSD')
+    assert_match(%r{\A/nix/store/[^/]+-virtiofsd-}, selected)
+    executable = File.realpath(File.join(selected, 'bin/virtiofsd'))
+    native_spawn = Process.method(:spawn)
+    mapped = []
+    peers = []
+    with_adapter(KbRuntime::NixosMachine, daemon: selected) do |machine, _directory|
+      Process.stub(:spawn, lambda { |*arguments, **options|
+        assert_equal(File.join(selected, 'bin/virtiofsd'), arguments.first)
+        assert_equal(true, options[:close_others])
+        listener = options.fetch(3)
+        mapped << File.readlink("/proc/self/fd/#{listener.fileno}")
+        # The host test isolates the selected daemon's FD API from namespace
+        # sandbox policy. Production retains its original sandbox options.
+        native_spawn.call(*arguments, '--sandbox', 'none', **options)
+      }) { machine.send(:start_virtiofs) }
+      assert_equal(3, machine.send(:virtiofsd_pids).length)
+      machine.send(:virtiofsd_pids).each_with_index do |pid, i|
+        Timeout.timeout(5) do
+          Thread.pass until File.realpath("/proc/#{pid}/exe") == executable
+        end
+        targets = Dir.children("/proc/#{pid}/fd").filter_map do |fd|
+          File.readlink("/proc/#{pid}/fd/#{fd}") rescue nil
+        end
+        assert_includes(targets, mapped[i])
+      end
+      machine.send(:shared_filesystems).each_key do |share|
+        path = machine.send(:virtiofs_socket_path, share)
+        assert(File.socket?(path))
+        refute(File.exist?(path + '.pid'))
+        log = machine.send(:virtiofs_log_path, share)
+        Timeout.timeout(5) do
+          Thread.pass until File.read(log).include?('Waiting for vhost-user socket connection')
+        end
+        peer = UNIXSocket.new(path)
+        peers << peer
+        # Native vhost-user GET_FEATURES over the inherited listener: request 1,
+        # protocol version 1, zero payload. No QEMU or guest is involved.
+        peer.write([1, 1, 0].pack('L<3'))
+        header = Timeout.timeout(5) { peer.read(12) }
+        refute_nil(header)
+        assert_equal(12, header.bytesize)
+        request, flags, length = header.unpack('L<3')
+        assert_equal(1, request)
+        assert_equal(5, flags)
+        assert_equal(8, length)
+        assert_equal(8, Timeout.timeout(5) { peer.read(length) }.bytesize)
+      end
+      statuses = []
+      native_wait = Process.method(:waitpid2)
+      Process.stub(:wait, lambda { |pid|
+        waited, status = native_wait.call(pid)
+        statuses << status
+        waited
+      }) { stop_daemons(machine) }
+      assert_equal(3, statuses.length)
+      statuses.each { |status| assert(status.success? || status.termsig == Signal.list.fetch('TERM'), status.inspect) }
+      machine.cleanup
+      assert_empty(Dir.children(machine.send(:sockdir)))
+      assert_proofs_closed(machine)
+    ensure
+      peers.each { |peer| peer.close unless peer.closed? }
+    end
+  end
