+test('more than one thousand source networks return the bounded page and refuse before inventory mutation or following browser work', async (t) => {
+  const inventory = fixture({ networkMissing: true, locationMissing: true, missing: true });
+  inventory.unrelated.networks.push(...Array.from({ length: 1001 }, (_, index) => ({
+    id: 100 + index, address: `2001:db8:${index.toString(16)}::`, enabled: true,
+  })));
+  const original = JSON.stringify(inventory.unrelated);
+  assert.equal(inventory.unrelated.networks.length, 1003);
+  let returnedNetworkCount;
+  const calls = mockInventoryTransport(t, async (call) => {
+    if (call.resource === 'users/current') return { response: currentUser(call.login) };
+    assert.equal(call.login, 'test-admin');
+    assert.equal(call.method, 'GET', 'truncated selection cannot provision or disable inventory');
+    const response = await inventory.api(call.method, call.resource, call.body);
+    if (response.networks) returnedNetworkCount = response.networks.length;
+    return { response };
+  });
+  await withInventoryConnection(recordedAccounts(), async (cluster) => {
+    const { member, adminApi } = await inventoryIdentity(cluster);
+    const page = { locator() { assert.fail('truncated inventory must refuse before following browser work'); } };
+    await assert.rejects(async () => {
+      await ensureIpInventory(adminApi, { userId: member.id, vpsId: 10 });
+      await assertInventoryMember(page, member);
+    }, (error) => {
+      assert.equal(error.message, 'Inventory network selection is truncated');
+      return true;
+    });
+  });
+  assert.equal(returnedNetworkCount, 1000, 'the server model applies the actual resource input limit');
+  assert.deepEqual(calls.map((call) => [call.method, call.wirePath]), [
+    ['GET', '/v7.0/users/current'], ['GET', '/v7.0/users/current'],
+    ['GET', '/v7.0/vpses/10'], ['GET', '/v7.0/nodes/101'], ['GET', '/v7.0/locations/1'],
+    ['GET', '/v7.0/networks?network%5Blimit%5D=1000'],
+  ]);
+  assert.deepEqual(calls.at(-1).query, [['network[limit]', '1000']]);
+  assert.equal(JSON.stringify(inventory.unrelated), original);
+  assert.equal(inventory.pool.enabled, true);
+});
+
+test('only each singular resource input limit bounds its list, not flat or metadata aliases', async (t) => {
+  const inventory = fixture({ disabled: true });
+  const original = JSON.stringify(inventory.unrelated);
+  const calls = mockInventoryTransport(t, async (call) => {
+    if (call.resource === 'users/current') return { response: currentUser(call.login) };
+    assert.equal(call.login, 'test-admin');
+    assert.equal(call.method, 'GET');
+    return { response: await inventory.api(call.method, call.resource, call.body) };
+  });
+  await withInventoryConnection(recordedAccounts(), async (cluster) => {
+    const { adminApi } = await inventoryIdentity(cluster);
+    for (const [resource, namespace, total] of [
+      ['networks', 'network', 3], ['location_networks', 'location_network', 3], ['ip_addresses', 'ip_address', 4],
+    ]) {
+      const encoded = `${namespace}%5Blimit%5D=1`;
+      assert.equal((await adminApi('GET', `${resource}?${encoded}`))[resource].length, 1);
+      assert.deepEqual(calls.at(-1).query, [[`${namespace}[limit]`, '1']]);
+      assert.equal((await adminApi('GET', `${resource}?limit=1`))[resource].length, total);
+      assert.deepEqual(calls.at(-1).query, [['limit', '1']]);
+      assert.equal((await adminApi('GET', `${resource}?_meta%5Blimit%5D=1`))[resource].length, total);
+      assert.deepEqual(calls.at(-1).query, [['_meta[limit]', '1']]);
+    }
+  });
+  assert(calls.every((call) => call.method === 'GET'));
+  assert.equal(JSON.stringify(inventory.unrelated), original);
+  assert.equal(inventory.pool.enabled, false);
+});
