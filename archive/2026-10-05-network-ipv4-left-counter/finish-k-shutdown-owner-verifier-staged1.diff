+  def test_public_command_observer_expiry_keeps_native_exit_and_unknown_remote_cancellation
+    with_campaign do |campaign|
+      campaign.initialize_campaign
+      marker = campaign.file('work/drain-command-ready')
+      argv = [RbConfig.ruby, '-e', 'STDOUT.sync=true; STDERR.sync=true; STDOUT.puts("drain stdout"); STDERR.puts("drain stderr"); File.write(ARGV[0], Process.pid.to_s); STDIN.read; sleep 60', marker]
+      clock = Process.method(:clock_gettime)
+      expired = false
+      owner = error = nil
+      observed = lambda do |kind, *args|
+        clock.call(kind, *args) + ((kind == Process::CLOCK_MONOTONIC && Thread.current == owner && expired) ? 361 : 0)
+      end
+      Process.stub(:clock_gettime, observed) do
+        owner = Thread.new do
+          campaign.commands.call(argv, cwd: campaign.file('work'), caller_timeout: 360, stage: 'synthetic/historical-drain')
+        rescue KbVerify::Error => error
+          error
+        end
+        Timeout.timeout(5) { Thread.pass until File.exist?(marker) }
+        expired = true
+        error = Timeout.timeout(15) { owner.value }
+        assert_instance_of(KbVerify::Error, error)
+        assert_match(/observer expired; remote cancellation unknown/, error.message)
+      end
+      path = Dir.glob(campaign.file('diagnostics/*/command.json')).fetch(0)
+      record = JSON.parse(File.read(path))
+      assert_includes(error.message, path)
+      assert_equal(Integer(File.read(marker)), record['pid'])
+      assert(record['observer_expired'])
+      refute(record['accepted'])
+      assert(record['complete'])
+      assert_equal(Signal.list.fetch('TERM'), record['signal'])
+      assert_equal('spawned public command only', record['cleanup_scope'])
+      assert_equal('unknown', record['remote_cancellation'])
+      assert_equal(360, record['caller_timeout_seconds'])
+      assert_equal('synthetic/historical-drain', record['stage'])
+      assert_equal("drain stdout\n", File.read(File.join(File.dirname(path), 'stdout')))
+      assert_equal("drain stderr\n", File.read(File.join(File.dirname(path), 'stderr')))
+      refute(record.key?('environment'))
+    ensure
+      owner&.raise(Interrupt) if owner&.alive?
+      owner&.join
+    end
+  end
