+test('inventory HTTP 404 refuses before browser or mutation without leaking diagnostic values', async (t) => {
+  const accounts = recordedAccounts();
+  const secret = 'synthetic-raw-response-secret';
+  const calls = mockInventoryTransport(t, () => ({ statusCode: 404, denied: true,
+    failure: { response: { private: secret }, message: secret, errors: { authorization: secret } },
+  }));
+  await withInventoryConnection(accounts, async (cluster, _abort, root) => {
+    const page = {
+      locator() { assert.fail('HTTP refusal must precede browser work'); },
+      goto() { assert.fail('HTTP refusal must precede browser navigation'); },
+    };
+    const invocationRoot = path.join(root, 'invocation');
+    await assert.rejects(prepareFixtures({ cluster, page, language: 'en', required: ['ip-inventory'], invocationRoot }), (error) => {
+      assert.equal(error.message, 'Inventory resource action failed: GET /v7.0/users/current (HTTP 404)');
+      assert(error.message.length < 192);
+      for (const value of [secret, ...accounts.flatMap((account) => [account.login, account.password])]) {
+        assert(!error.message.includes(value), 'diagnostics contain no response or account values');
+      }
+      return true;
+    });
+    assert.equal(fs.existsSync(invocationRoot), false, 'refusal cannot publish fixture metadata');
+  });
+  assert.deepEqual(calls.map((call) => [call.login, call.method, call.wirePath]),
+    [['test-user1', 'GET', '/v7.0/users/current']], 'no fallback, second identity request or provisioning mutation follows refusal');
+});
