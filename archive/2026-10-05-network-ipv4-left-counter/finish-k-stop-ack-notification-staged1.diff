+        assert_includes(%w[puts flush], failure['operation'])
+        assert_equal(failure, JSON.parse(File.read(File.join(context[:record]['state_dir'], 'ack-native.json'))))
+        drain = Timeout.timeout(5) { drain_server.accept }
