+    {
+      'base_url' => 'http://127.0.0.1:12345', 'api_version' => '7.0',
+      'vps_id' => 1, 'dns_record_id' => 2, 'user_id' => 3
+    }
+  end
+
+  it 'accepts the source launcher loopback URL and integer fixture IDs' do
+    expect(described_class.fixture_url!(metadata)).to eq('http://127.0.0.1:12345')
+  end
+
+  {
+    'a production origin' => 'https://api.vpsfree.cz',
+    'a DNS hostname' => 'http://localhost:12345',
+    'a non-loopback address' => 'http://192.0.2.1:12345',
+    'a different protocol' => 'ftp://127.0.0.1:12345',
+    'a credential-bearing URL' => 'http://fixture:unused@127.0.0.1:12345',
+    'a URL with a path' => 'http://127.0.0.1:12345/v7.0/',
+    'a URL with a query' => 'http://127.0.0.1:12345?fixture=1',
+    'a URL with a fragment' => 'http://127.0.0.1:12345#fixture'
+  }.each do |description, url|
+    it "rejects #{description} before client execution" do
+      expect { described_class.fixture_url!(metadata.merge('base_url' => url)) }.to raise_error(RuntimeError)
+    end
+  end
+
+  %w[vps_id dns_record_id user_id].each do |field|
+    it "rejects missing or invalid #{field}" do
+      [nil, 0, -1, '1', false].each do |value|
+        expect { described_class.fixture_url!(metadata.merge(field => value)) }.to raise_error(RuntimeError)
+      end
+      expect { described_class.fixture_url!(metadata.except(field)) }.to raise_error(RuntimeError)
+    end
+  end
+
+  it 'rejects a fixture with a different API version' do
+    expect { described_class.fixture_url!(metadata.merge('api_version' => '1.0')) }.to raise_error(RuntimeError)
+  end
+
+  it 'rejects a readiness record without its URL' do
+    expect { described_class.fixture_url!(metadata.except('base_url')) }.to raise_error(RuntimeError)
+  end
+end
diff --git a/clients/rust/spec/integration/run.rb b/clients/rust/spec/integration/run.rb
new file mode 100644
index 0000000..0e04aaa
--- /dev/null
+++ b/clients/rust/spec/integration/run.rb
@@ -0,0 +1,120 @@
+# frozen_string_literal: true
+
+require 'fileutils'
+require 'json'
+require 'io/wait'
+require 'open3'
+require 'rbconfig'
+require 'tempfile'
+require 'tmpdir'
+require_relative '../../lib/haveapi/rust_client'
+
+module RustClientIntegration
+  ROOT = File.expand_path('../..', __dir__)
+  SERVER_GEMFILE = File.expand_path('../../servers/ruby/Gemfile', ROOT)
+  SERVER_GEM_HOME = File.expand_path('../../.gems', ROOT)
+
+  module_function
+
+  def with_server(mount)
+    log = Tempfile.create('rust-haveapi-fixture-log')
+    command = [
+      'bundle', 'exec', RbConfig.ruby,
+      File.join(__dir__, 'support/haveapi_server.rb'), '--mount', mount
+    ]
+    input, output, waiter = Open3.popen2(
+      { 'BUNDLE_GEMFILE' => SERVER_GEMFILE, 'GEM_HOME' => SERVER_GEM_HOME, 'GEM_PATH' => SERVER_GEM_HOME },
+      *command, err: log.path
+    )
+    input.close
+    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 30
+    url = nil
+    while Process.clock_gettime(Process::CLOCK_MONOTONIC) < deadline
+      raise "HaveAPI fixture exited before readiness; log #{log.path}" unless waiter.alive?
+      next unless output.wait_readable(0.1)
+
+      line = output.gets
+      break if line.nil?
+      next unless line.start_with?('HAVEAPI_TEST_SERVER_READY ')
+
+      url = line.split.fetch(1)
+      break
+    end
+    raise 'HaveAPI fixture readiness deadline exceeded' unless url
+
+    yield "#{url}#{mount}"
+  ensure
+    if waiter&.alive?
+      Process.kill('TERM', waiter.pid)
+      unless waiter.join(10)
+        Process.kill('KILL', waiter.pid)
+        waiter.join
+      end
+    end
+    output&.close
+    if log
+      log.close
+      if $!.nil?
+        File.unlink(log.path)
+      else
+        warn "HaveAPI fixture failure log: #{log.path}"
+      end
+    end
+  end
+
+  def write_crate(dir)
+    FileUtils.mkdir_p(File.join(dir, 'src'))
+    FileUtils.mkdir_p(File.join(dir, 'tests'))
+    File.write(File.join(dir, 'src/lib.rs'), "mod generated;\npub use generated::*;\n")
+    Dir[File.join(__dir__, 'rust/*.rs')].each do |source|
+      FileUtils.cp(source, File.join(dir, 'tests', File.basename(source)))
+    end
+  end
+
+  def run
+    # Explicit opt-in keeps ordinary generator specs lightweight.
+    abort 'Set HAVEAPI_RUST_INTEGRATION=1 to run server acceptance' unless ENV['HAVEAPI_RUST_INTEGRATION'] == '1'
+
+    Dir.mktmpdir('haveapi-rust-integration-') do |dir|
+      write_crate(dir)
+      ['/', '/mounted/api/'].each do |mount|
+        with_server(mount) do |url|
+          snapshot = HaveAPI::RustClient::Snapshot.fetch(
+            url: "#{url}v1.0/", api_version: '1.0', profile: 'local-rust-integration'
+          )
+          begin
+            HaveAPI::RustClient::Snapshot.fetch(
+              url: "#{url}v999.0/", api_version: '999.0', profile: 'unavailable-version'
+            )
+          rescue HaveAPI::RustClient::Error
+            # Explicit unknown versions must fail rather than select default.
+          else
+            raise 'Unavailable API version unexpectedly selected a description'
+          end
+          config = {
+            'crate_name' => 'haveapi-rust-fixture', 'crate_version' => '0.1.0',
+            'license' => 'MIT', 'edition' => '2024', 'rust_version' => '1.95',
+            'rustfmt_version' => IO.popen(%w[rustfmt --version], &:read).strip
+          }
+          generated = File.join(dir, 'src/generated')
+          generator = HaveAPI::RustClient::Generator.new(schema: snapshot, config: config)
+          manifest = generator.manifest_requirements.sub('[package]', "[package]\npublish = false")
+          File.write(File.join(dir, 'Cargo.toml'), manifest)
+          generator.generate(output: generated)
+          generator.generate(output: generated, check: true)
+
+          # Fresh server per mount, shared generated request/response assertions
+          # in both execution modes. Cargo's exit status is the acceptance gate.
+          ok = system(
+            { 'HAVEAPI_TEST_BASE_URL' => url },
+            'cargo', 'test', '--manifest-path', File.join(dir, 'Cargo.toml'),
+            '--all-features', '--', '--test-threads=1'
+          )
+          raise "Generated fixture acceptance failed at mount #{mount}" unless ok
+        end
+      end
+    end
+  end
+end
+
+RustClientIntegration.run if $0 == __FILE__
diff --git a/clients/rust/spec/integration/run_vpsadmin.rb b/clients/rust/spec/integration/run_vpsadmin.rb
new file mode 100644
index 0000000..667c87c
--- /dev/null
+++ b/clients/rust/spec/integration/run_vpsadmin.rb
@@ -0,0 +1,118 @@
+# frozen_string_literal: true
+
+require 'io/wait'
+require 'json'
+require 'open3'
+require 'optparse'
+require 'tmpdir'
+require 'uri'
+
+module RustClientVpsadminIntegration
+  module_function
+
+  def fixture_url!(metadata)
+    url = URI.parse(metadata.fetch('base_url'))
+    unless url.scheme == 'http' && url.host == '127.0.0.1' && url.port > 0 &&
+           url.userinfo.nil? && url.query.nil? && url.fragment.nil? && url.path.empty?
+      raise 'Fixture readiness contained an invalid loopback URL'
+    end
+
+    %w[vps_id dns_record_id user_id].each do |name|
+      value = metadata.fetch(name)
+      raise "Fixture readiness has invalid #{name}" unless value.is_a?(Integer) && value > 0
+    end
+    raise 'Fixture API version differs from 7.0' unless metadata.fetch('api_version') == '7.0'
+
+    url.to_s
+  rescue KeyError, URI::InvalidURIError, JSON::ParserError
+    raise 'Fixture readiness was malformed'
+  end
+
+  def readiness(output, waiter)
+    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 120
+    while Process.clock_gettime(Process::CLOCK_MONOTONIC) < deadline
+      raise 'vpsAdmin fixture exited before readiness; inspect private fixture.log' unless waiter.alive?
+      next unless output.wait_readable(0.1)
+
+      line = output.gets
+      break unless line
+      next unless line.start_with?('VPSADMIN_FIXTURE_READY ')
+
+      metadata = JSON.parse(line.delete_prefix('VPSADMIN_FIXTURE_READY '))
+      fixture_url!(metadata)
+      return metadata
+    end
+    raise 'vpsAdmin fixture readiness deadline exceeded; inspect private fixture.log'
+  end
+
+  def stop_fixture(waiter)
+    return unless waiter&.alive?
+
+    Process.kill('TERM', -waiter.pid)
+    return if waiter.join(15)
+
+    Process.kill('KILL', -waiter.pid)
+    waiter.join
+  rescue Errno::ESRCH
+    waiter&.join
+  end
+
+  def run(argv)
+    options = {}
+    OptionParser.new do |opts|
+      opts.on('--source-root PATH', 'vpsAdmin fixture source checkout') { |v| options[:source_root] = v }
+      opts.on('--client-root PATH', 'Generated client repository') { |v| options[:client_root] = v }
+      opts.on('--artifacts PATH', 'Parent directory for private logs') { |v| options[:artifacts] = v }
+    end.parse!(argv)
+    abort 'Set VPSADMIN_REAL_INTEGRATION=1 to run disposable server acceptance' unless ENV['VPSADMIN_REAL_INTEGRATION'] == '1'
+    abort 'Refusing inherited DATABASE_URL' if ENV['DATABASE_URL'] && !ENV['DATABASE_URL'].empty?
+    abort '--source-root, --client-root and --artifacts are required' unless options.values_at(
+      :source_root, :client_root, :artifacts
+    ).all?
+
+    source = File.realpath(options.fetch(:source_root))
+    client = File.realpath(options.fetch(:client_root))
+    evidence = Dir.mktmpdir('vpsadmin-client-acceptance-', File.realpath(options.fetch(:artifacts)))
+    File.chmod(0o700, evidence)
+    fixture_log = File.join(evidence, 'fixture.log')
+    command = [
+      'nix', 'develop', '.#api', '--command', 'bundle', 'exec', 'ruby',
+      File.join(__dir__, 'support/vpsadmin_server.rb'), '--source-root', source
+    ]
+    input, output, waiter = Open3.popen2(
+      { 'VPSADMIN_PLUGINS' => 'all' }, *command,
+      chdir: source, pgroup: true, err: fixture_log
+    )
+    input.close
+    metadata = readiness(output, waiter)
+    # Drain remaining stdout so a verbose source server cannot block. Store it
+    # privately: API diagnostics can contain request or response data.
+    drain = Thread.new do
+      File.open(File.join(evidence, 'fixture.stdout.log'), 'wb') { |file| IO.copy_stream(output, file) }
+    end
+    env = {
+      'VPSADMIN_REAL_INTEGRATION' => '1',
+      'VPSADMIN_TEST_BASE_URL' => fixture_url!(metadata),
+      'VPSADMIN_FIXTURE_JSON' => JSON.generate(metadata)
+    }
+    ok = system(
+      env, 'nix', 'develop', '--command', 'cargo', 'test', '--locked',
+      '--all-features', '--test', 'real_vpsadmin', '--', '--ignored', '--test-threads=1',
+      chdir: client
+    )
+    raise "Actual vpsAdmin generated-client acceptance failed; evidence #{evidence}" unless ok
+
+    receipt = {
+      'result' => 'passed', 'api_version' => '7.0',
+      'fixture_source' => source, 'client_source' => client
+    }
+    File.write(File.join(evidence, 'result.json'), JSON.pretty_generate(receipt))
+    warn "Actual vpsAdmin generated-client acceptance passed; evidence #{evidence}"
+  ensure
+    stop_fixture(waiter)
+    drain&.join
+    output&.close
+  end
+end
+
+RustClientVpsadminIntegration.run(ARGV) if $0 == __FILE__
diff --git a/clients/rust/spec/integration/rust/real_server.rs b/clients/rust/spec/integration/rust/real_server.rs
new file mode 100644
index 0000000..565d9aa
--- /dev/null
+++ b/clients/rust/spec/integration/rust/real_server.rs
@@ -0,0 +1,270 @@
+use haveapi_rust_fixture::{Client, Error};
+use serde_json::json;
+use std::time::Duration;
+
+fn base_url() -> String {
+    std::env::var("HAVEAPI_TEST_BASE_URL").expect("fixture runner must supply a local URL")
+}
+
+macro_rules! async_response {
+    ($request:expr) => {
+        $request.send().await
+    };
+}
+
+#[cfg(feature = "blocking")]
+macro_rules! blocking_response {
+    ($request:expr) => {
+        $request.send()
+    };
+}
+
+// Identical generated builders, inputs and assertions exercise both adapters.
+macro_rules! real_protocol_cases {
+    ($client:expr, $send:ident) => {{
+        let api = $client;
+        let omitted = $send!(api.test().echo_optional()).unwrap();
+        assert_eq!(omitted.output.dt_provided, Some(false));
+        let null = $send!(api.test().echo_optional().dt_null()).unwrap();
+        assert_eq!(null.output.dt_provided, Some(true));
+        assert_eq!(null.output.dt_nil, Some(true));
+        let query_null = $send!(api.test().echo_optional_get().dt_null()).unwrap();
+        assert_eq!(query_null.output.dt_provided, Some(true));
+        assert_eq!(query_null.output.dt_nil, Some(true));
+
+        let echo = $send!(api.test().echo()
+            .i(0).f(0.0).b(false).dt("2020-01-31T10:20Z")
+            .s("").t("line one\nline two")).unwrap();
+        assert_eq!(echo.output.i, Some(0));
+        assert_eq!(echo.output.b, Some(false));
+        assert_eq!(echo.output.s.as_deref(), Some(""));
+        assert_eq!(echo.output.t.as_deref(), Some("line one\nline two"));
+
+        let body = $send!(api.rust_fixture().echo().number(0).flag(false).text("")).unwrap();
+        assert_eq!(body.output.received, Some(json!({"number": 0, "flag": false, "text": ""})));
+        for response in [
+            $send!(api.rust_fixture().query().number_null().flag(false)),
+            $send!(api.rust_fixture().delete_query().number_null().flag(false)),
+        ] {
+            assert_eq!(response.unwrap().output.received, Some(json!({"number": null, "flag": false})));
+        }
+        let flat = $send!(api.rust_fixture().unnamespaced().number(0).flag(false)).unwrap();
+        assert_eq!(flat.output.received, Some(json!({"number": 0, "flag": false})));
+        let custom = json!({"nested": [0, false, null, {"text": "a&b + c"}]});
+        let result = $send!(api.rust_fixture().custom().value(custom.clone())).unwrap();
+        assert_eq!(result.output.value, Some(custom));
+        assert!($send!(api.rust_fixture().custom_query().value(json!({"nested": true})))
+            .err().unwrap().validation_errors().is_some());
+
+        let project = $send!(api.project().create().name("Rust fixture")).unwrap();
+        let id = project.output.id.unwrap();
+        let show = $send!(api.project().show(id)).unwrap();
+        assert_eq!(show.output.name.as_deref(), Some("Rust fixture"));
+        assert_eq!(show.meta.resolved, Some(true));
+        assert!(show.meta.path_params.is_some());
+        let task = $send!(api.project__task(id).create().label("child").done(true)).unwrap();
+        let task_id = task.output.id.unwrap();
+        let update = $send!(api.project__task(id).update(task_id).done(false)).unwrap();
+        assert_eq!(update.output.done, Some(false));
+        let child = $send!(api.project__task(id).show(task_id)).unwrap();
+        assert_eq!(child.output.label.as_deref(), Some("child"));
+        let submitted = $send!(api.project__task(id).run(task_id)).unwrap();
+        assert!(submitted.meta.action_state_id.is_some());
+        let list = $send!(api.project().index().global_meta(
+            json!({"count": true}).as_object().unwrap().clone()
+        )).unwrap();
+        assert!(list.output.iter().any(|p| p.id == Some(id)));
+        assert_eq!(list.http_status, 200);
+        assert!(list.meta.total_count.is_some());
+        assert!(list.output.iter().all(|p| p.object_meta.is_some()));
+        let public = $send!(api.project().public_show(id)).unwrap();
+        assert!(public.meta.path_params.is_none());
+        let associated = $send!(api.rust_fixture().association()).unwrap();
+        assert_eq!(associated.output.project.unwrap().as_map().get("id"), Some(&json!(1)));
+
+        use haveapi_rust_fixture::resources::rust_fixture::batch::Input as BatchInput;
+        use haveapi_rust_fixture::runtime::InputValue;
+        let batch = $send!(api.rust_fixture().batch().input(vec![
+            BatchInput { number: InputValue::Value(0), ..Default::default() },
+            BatchInput { number: InputValue::Value(42), ..Default::default() },
+        ])).unwrap();
+        assert_eq!(batch.output[0].number, Some(0));
+        assert_eq!(batch.output[1].number, Some(42));
+
+        let failure = $send!(api.test().fail()).err().expect("real failure envelope");
+        assert!(matches!(failure, Error::Api { .. }));
+        assert_eq!(failure.http_status(), Some(400));
+        let missing = $send!(api.project().show(999999)).err().expect("real 404 envelope");
+        assert_eq!(missing.http_status(), Some(404));
+        let invalid = $send!(api.test().echo().f(f64::NAN)).err().expect("local validation");
+        assert!(invalid.validation_errors().is_some());
+    }};
+}
+
+macro_rules! token_cases {
+    ($client_type:ty, $send:ident) => {{
+        use haveapi_rust_fixture::runtime::TokenStep;
+        let api = <$client_type>::builder(base_url())
+            .basic_auth("admin", "pass")
+            .build()
+            .unwrap();
+        let pending = $send!(
+            api.authentication__token__token()
+                .request()
+                .user("user")
+                .password("totp")
+                .lifetime("fixed")
+        )
+        .unwrap()
+        .output;
+        let TokenStep::Challenge { token, next_action } = pending.token_step().unwrap() else {
+            panic!("TOTP must be an explicit challenge");
+        };
+        assert_eq!(next_action, "totp");
+        let reset = $send!(
+            api.authentication__token__token()
+                .totp()
+                .token(token.expose_secret())
+                .code("123456")
+        )
+        .unwrap()
+        .output;
+        let TokenStep::Challenge { token, next_action } = reset.token_step().unwrap() else {
+            panic!("password reset must be an explicit challenge");
+        };
+        assert_eq!(next_action, "reset_password");
+        let done = $send!(
+            api.authentication__token__token()
+                .reset_password()
+                .token(token.expose_secret())
+                .new_password1("fixture-new-password")
+                .new_password2("fixture-new-password")
+        )
+        .unwrap()
+        .output;
+        let TokenStep::Complete { token } = done.token_step().unwrap() else {
+            panic!("expected a complete token step");
+        };
+        assert!(!format!("{token:?}").contains(token.expose_secret()));
+        let session = <$client_type>::builder(base_url())
+            .token(token.expose_secret())
+            .build()
+            .unwrap();
+        assert!(!$send!(session.project().index()).unwrap().output.is_empty());
+        $send!(session.authentication__token__token().renew()).unwrap();
+        // Real ok! response:{} regression (FROZEN clarification 2).
+        $send!(session.authentication__token__token().revoke()).unwrap();
+        assert_eq!(
+            $send!(session.project().index())
+                .err()
+                .unwrap()
+                .http_status(),
+            Some(401)
+        );
+        let unknown = $send!(
+            api.authentication__token__token()
+                .request()
+                .user("user")
+                .password("unknown")
+                .lifetime("fixed")
+        )
+        .unwrap()
+        .output;
+        assert!(matches!(
+            unknown.token_step(),
+            Err(Error::UnsupportedAuthStep { .. })
+        ));
+    }};
+}
+
+#[tokio::test]
+async fn real_haveapi_async() {
+    let client = Client::builder(base_url())
+        .basic_auth("admin", "pass")
+        .build()
+        .unwrap();
+    real_protocol_cases!(client, async_response);
+    token_cases!(Client, async_response);
+}
+
+#[cfg(feature = "blocking")]
+#[test]
+fn real_haveapi_blocking() {
+    let client = haveapi_rust_fixture::blocking::Client::builder(base_url())
+        .basic_auth("admin", "pass")
+        .build()
+        .unwrap();
+    real_protocol_cases!(client, blocking_response);
+    token_cases!(haveapi_rust_fixture::blocking::Client, blocking_response);
+}
+
+#[tokio::test]
+async fn existing_oauth2_token_and_deadline() {
+    let client = Client::builder(base_url())
+        .oauth2_token("oauth-user")
+        .build()
+        .unwrap();
+    assert!(
+        !client
+            .project()
+            .index()
+            .send()
+            .await
+            .unwrap()
+            .output
+            .is_empty()
+    );
+    let client = Client::builder(base_url())
+        .timeout(Duration::from_millis(25))
+        .build()
+        .unwrap();
+    assert!(matches!(
+        client.test().slow().send().await,
+        Err(Error::Transport { .. })
+    ));
+}
+
+// The entire blocking-client lifecycle stays in the worker, including Drop.
+#[cfg(feature = "blocking")]
+async fn blocking_bridge() {
+    tokio::task::spawn_blocking(|| {
+        let client = haveapi_rust_fixture::blocking::Client::builder(base_url())
+            .basic_auth("admin", "pass")
+            .build()
+            .unwrap();
+        assert_eq!(client.project().show(1).send().unwrap().output.id, Some(1));
+    })
+    .await
+    .unwrap();
+}
+
+#[cfg(feature = "blocking")]
+#[tokio::test(flavor = "current_thread")]
+async fn blocking_lifecycle_on_current_thread() {
+    blocking_bridge().await;
+}
+
+#[cfg(feature = "blocking")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn blocking_lifecycle_on_multiple_threads() {
+    blocking_bridge().await;
+}
+
+#[cfg(feature = "blocking")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn started_blocking_work_keeps_its_http_deadline_after_abort() {
+    let (started, running) = std::sync::mpsc::channel();
+    let task = tokio::task::spawn_blocking(move || {
+        let client = haveapi_rust_fixture::blocking::Client::builder(base_url())
+            .timeout(Duration::from_millis(100))
+            .build()
+            .unwrap();
+        started.send(()).unwrap();
+        client.test().slow().send().err().unwrap()
+    });
+    running.recv_timeout(Duration::from_secs(2)).unwrap();
+    task.abort();
+    // Tokio cannot abort an already-running blocking worker. Its own request
+    // deadline still ends the call; a mutation would not be rolled back.
+    assert!(task.await.unwrap().is_timeout());
+}
diff --git a/clients/rust/spec/integration/rust/scripted_http.rs b/clients/rust/spec/integration/rust/scripted_http.rs
