diff --git a/clients/rust/runtime/src/runtime/protocol.rs b/clients/rust/runtime/src/runtime/protocol.rs
new file mode 100644
index 0000000..cc1f2de
--- /dev/null
+++ b/clients/rust/runtime/src/runtime/protocol.rs
@@ -0,0 +1,421 @@
+use std::collections::{BTreeMap, BTreeSet};
+
+use reqwest::header::{CONTENT_TYPE, HeaderValue};
+use serde::de::DeserializeOwned;
+use serde_json::Value;
+use url::Url;
+
+use crate::runtime::validation::validate_map;
+use crate::runtime::{
+    ActionSpec, ClientConfig, Error, JsonMap, PreparedRequest, RawResponse, RequestParts, Response,
+    ValidationErrors,
+};
+
+pub fn prepare(
+    config: &ClientConfig,
+    spec: &ActionSpec,
+    parts: RequestParts,
+) -> Result<PreparedRequest, Error> {
+    let mut url = action_url(&config.base, spec.path, &parts.path_params)?;
+    let has_global_meta = parts.global_meta.is_some();
+    let has_object_meta = parts.object_meta.is_some();
+    let mut root = JsonMap::new();
+    match spec.input {
+        None => {
+            if parts.input.is_some() {
+                return Err(Error::validation("input", "action has no described input"));
+            }
+            if parts.object_meta.is_some() {
+                return Err(Error::validation(
+                    "object_meta",
+                    "requires a named object input",
+                ));
+            }
+        }
+        Some(input_spec) => {
+            let mut input = parts.input.unwrap_or_else(|| {
+                if input_spec.layout.list() {
+                    Value::Array(Vec::new())
+                } else {
+                    Value::Object(JsonMap::new())
+                }
+            });
+            if input_spec.layout.list() {
+                if input_spec.namespace.is_none() {
+                    return Err(Error::configuration("list input requires a namespace"));
+                }
+                if spec.method.query() {
+                    return Err(Error::validation(
+                        "input",
+                        "list input is unsupported in query parameters",
+                    ));
+                }
+                if parts.object_meta.is_some() {
+                    return Err(Error::validation(
+                        "object_meta",
+                        "per-item input metadata is unsupported",
+                    ));
+                }
+                let items = input
+                    .as_array()
+                    .ok_or_else(|| Error::validation("input", "expected an object list"))?;
+                for (index, item) in items.iter().enumerate() {
+                    let object = item.as_object().ok_or_else(|| {
+                        Error::validation(format!("input[{index}]"), "expected an object")
+                    })?;
+                    validate_map(object, input_spec.parameters, &format!("input[{index}]."))?;
+                }
+            } else {
+                let object = input
+                    .as_object_mut()
+                    .ok_or_else(|| Error::validation("input", "expected an object"))?;
+                validate_map(object, input_spec.parameters, "")?;
+                if let Some(object_meta) = parts.object_meta {
+                    let namespace = spec.meta_namespace.ok_or_else(|| {
+                        Error::validation("object_meta", "metadata namespace is not described")
+                    })?;
+                    if input_spec.namespace.is_none() {
+                        return Err(Error::validation(
+                            "object_meta",
+                            "requires a named object input",
+                        ));
+                    }
+                    validate_map(&object_meta, spec.object_meta, "object_meta.")?;
+                    insert(object, namespace, Value::Object(object_meta))?;
+                } else {
+                    validate_map(&JsonMap::new(), spec.object_meta, "object_meta.")?;
+                }
+            }
+            match input_spec.namespace {
+                Some(namespace) => {
+                    insert(&mut root, namespace, input)?;
+                }
+                None => {
+                    root = input.as_object().expect("validated object input").clone();
+                }
+            }
+        }
+    }
+    if let Some(global_meta) = parts.global_meta {
+        let namespace = spec.meta_namespace.ok_or_else(|| {
+            Error::validation("global_meta", "metadata namespace is not described")
+        })?;
+        validate_map(&global_meta, spec.global_meta, "global_meta.")?;
+        insert(&mut root, namespace, Value::Object(global_meta))?;
+    } else {
+        validate_map(&JsonMap::new(), spec.global_meta, "global_meta.")?;
+    }
+    let mut headers = config.request_headers(spec.auth);
+    let body = if spec.method.query() {
+        let mut pairs = Vec::new();
+        for (name, value) in &root {
+            let input_namespace = spec.input.and_then(|input| input.namespace);
+            if input_namespace == Some(name.as_str())
+                || (has_global_meta && spec.meta_namespace == Some(name.as_str()))
+            {
+                let object = value
+                    .as_object()
+                    .ok_or_else(|| Error::validation(name, "expected an object"))?;
+                for (field, value) in object {
+                    if has_object_meta
+                        && input_namespace == Some(name.as_str())
+                        && spec.meta_namespace == Some(field.as_str())
+                    {
+                        let metadata = value.as_object().ok_or_else(|| {
+                            Error::validation("object_meta", "expected an object")
+                        })?;
+                        for (key, value) in metadata {
+                            query_value(&mut pairs, &format!("{name}[{field}][{key}]"), value)?;
+                        }
+                    } else {
+                        query_value(&mut pairs, &format!("{name}[{field}]"), value)?;
+                    }
+                }
+            } else {
+                query_value(&mut pairs, name, value)?;
+            }
+        }
+        if !pairs.is_empty() {
+            url.query_pairs_mut().extend_pairs(pairs);
+        }
+        None
+    } else {
+        headers.insert(CONTENT_TYPE, HeaderValue::from_static("application/json"));
+        Some(serde_json::to_vec(&root).map_err(|_| Error::Encode)?)
+    };
+    Ok(PreparedRequest {
+        method: spec.method,
+        url,
+        headers,
+        body,
+    })
+}
+
+fn insert(map: &mut JsonMap, name: &str, value: Value) -> Result<(), Error> {
+    if map.insert(name.to_owned(), value).is_some() {
+        return Err(Error::configuration(
+            "input and metadata namespaces collide",
+        ));
+    }
+    Ok(())
+}
+
+fn query_value(pairs: &mut Vec<(String, String)>, name: &str, value: &Value) -> Result<(), Error> {
+    let text = match value {
+        Value::Null => String::new(),
+        Value::String(value) => value.clone(),
+        Value::Bool(value) => value.to_string(),
+        Value::Number(value) => value.to_string(),
+        Value::Array(_) | Value::Object(_) => {
+            return Err(Error::validation(
+                name,
+                "nested query values are unsupported",
+            ));
+        }
+    };
+    pairs.push((name.to_owned(), text));
+    Ok(())
+}
+
+pub fn decode<T: DeserializeOwned, M: DeserializeOwned>(
+    spec: &ActionSpec,
+    response: RawResponse,
+) -> Result<Response<T, M>, Error> {
+    let status = response.status;
+    let successful_http = (200..300).contains(&status);
+    let envelope = serde_json::from_slice::<Value>(&response.body).ok();
+    let object = envelope.as_ref().and_then(Value::as_object);
+    if !successful_http {
+        if let Some(object) = object
+            && object.get("status") == Some(&Value::Bool(false))
+            && let Some(error) = api_error(status, object)
+        {
+            return Err(error);
+        }
+        return Err(Error::Http { status });
+    }
+    let object =
+        object.ok_or_else(|| Error::protocol(Some(status), "expected a JSON envelope object"))?;
+    match object.get("status").and_then(Value::as_bool) {
+        Some(false) => {
+            return Err(api_error(status, object)
+                .unwrap_or_else(|| Error::protocol(Some(status), "invalid failure envelope")));
+        }
+        Some(true) => (),
+        None => {
+            return Err(Error::protocol(
+                Some(status),
+                "missing boolean envelope status",
+            ));
+        }
+    }
+    let response = object
+        .get("response")
+        .and_then(Value::as_object)
+        .ok_or_else(|| Error::protocol(Some(status), "missing response object"))?;
+    let output = if let Some(output) = spec.output {
+        let value = match response.get(output.namespace) {
+            Some(value) => value.clone(),
+            None if output.allow_empty_response && !output.layout.list() && response.is_empty() => {
+                Value::Object(JsonMap::new())
+            }
+            None => {
+                return Err(Error::protocol(
+                    Some(status),
+                    "missing declared output namespace",
+                ));
+            }
+        };
+        if output.layout.list() {
+            if !value
+                .as_array()
+                .is_some_and(|items| items.iter().all(Value::is_object))
+            {
+                return Err(Error::Decode { status });
+            }
+        } else if !value.is_object() {
+            return Err(Error::Decode { status });
+        }
+        value
+    } else {
+        if !response.is_empty() {
+            return Err(Error::protocol(
+                Some(status),
+                "unexpected output for no-output action",
+            ));
+        }
+        Value::Null
+    };
+    let metadata = match spec
+        .meta_namespace
+        .and_then(|namespace| response.get(namespace))
+    {
+        Some(Value::Object(map)) => Value::Object(map.clone()),
+        Some(_) => return Err(Error::Decode { status }),
+        None => Value::Object(JsonMap::new()),
+    };
+    Ok(Response {
+        output: serde_json::from_value(output).map_err(|_| Error::Decode { status })?,
+        meta: serde_json::from_value(metadata).map_err(|_| Error::Decode { status })?,
+        http_status: status,
+    })
+}
+
+fn api_error(status: u16, object: &JsonMap) -> Option<Error> {
+    let message = match object.get("message") {
+        None | Some(Value::Null) => None,
+        Some(Value::String(message)) => Some(message.clone()),
+        _ => return None,
+    };
+    let errors = match object.get("errors") {
+        None | Some(Value::Null) => ValidationErrors::new(),
+        Some(value) => serde_json::from_value::<ValidationErrors>(value.clone()).ok()?,
+    };
+    Some(Error::Api {
+        status,
+        message,
+        errors,
+    })
+}
+
+pub(crate) fn parse_base(base: &str) -> Result<Url, Error> {
+    if base
+        .bytes()
+        .any(|byte| byte.is_ascii_control() || byte.is_ascii_whitespace() || byte == b'\\')
+    {
+        return Err(Error::configuration("invalid server mount URL"));
+    }
+    let mut parsed =
+        Url::parse(base).map_err(|_| Error::configuration("invalid server mount URL"))?;
+    if !matches!(parsed.scheme(), "https" | "http")
+        || parsed.host_str().is_none()
+        || !parsed.username().is_empty()
+        || parsed.password().is_some()
+        || parsed.query().is_some()
+        || parsed.fragment().is_some()
+    {
+        return Err(Error::configuration(
+            "server mount must be an HTTP URL without credentials, query or fragment",
+        ));
+    }
+    // Inspect the original string before Url can normalize dot segments away.
+    let after_scheme = base
+        .split_once("://")
+        .ok_or_else(|| Error::configuration("invalid server mount URL"))?
+        .1;
+    let authority = after_scheme.split('/').next().unwrap_or_default();
+    if authority.is_empty() || authority.contains('@') {
+        return Err(Error::configuration("invalid server mount authority"));
+    }
+    if let Some(start) = after_scheme.find('/') {
+        for segment in after_scheme[start..]
+            .split('/')
+            .filter(|segment| !segment.is_empty())
+        {
+            safe_literal_segment(segment)?;
+        }
+    }
+    if !parsed.path().ends_with('/') {
+        let path = format!("{}/", parsed.path());
+        parsed.set_path(&path);
+    }
+    Ok(parsed)
+}
+
+fn action_url(base: &Url, path: &str, params: &BTreeMap<String, String>) -> Result<Url, Error> {
+    if path.is_empty()
+        || path.starts_with('/')
+        || path.contains(['?', '#', '\\'])
+        || path
+            .bytes()
+            .any(|byte| byte.is_ascii_control() || byte.is_ascii_whitespace())
+    {
+        return Err(Error::configuration(
+            "action path must be a safe mount-relative template",
+        ));
+    }
+    let mut used = BTreeSet::new();
+    let mut url = base.clone();
+    {
+        let mut segments = url
+            .path_segments_mut()
+            .map_err(|_| Error::configuration("server URL cannot hold path segments"))?;
+        segments.pop_if_empty();
+        for segment in path.split('/') {
+            if segment.is_empty() {
+                return Err(Error::configuration(
+                    "action path contains an empty segment",
+                ));
+            }
+            if let Some(name) = segment
+                .strip_prefix('{')
+                .and_then(|value| value.strip_suffix('}'))
+            {
+                if name.is_empty() || name.contains(['{', '}']) {
+                    return Err(Error::configuration("invalid path placeholder"));
+                }
+                let value = params
+                    .get(name)
+                    .ok_or_else(|| Error::validation(name, "path parameter is required"))?;
+                if value.is_empty()
+                    || value == "."
+                    || value == ".."
+                    || value.chars().any(char::is_control)
+                {
+                    return Err(Error::validation(name, "invalid path segment"));
+                }
+                used.insert(name);
+                segments.push(value);
+            } else {
+                if segment.contains(['{', '}', ':']) {
+                    return Err(Error::configuration("invalid action path template"));
+                }
+                segments.push(&safe_literal_segment(segment)?);
+            }
+        }
+    }
+    if params.keys().any(|name| !used.contains(name.as_str())) {
+        return Err(Error::validation("path", "unexpected path parameter"));
+    }
+    // Constructing individual segments never changes the origin or mount.
+    if url.origin() != base.origin() || !url.path().starts_with(base.path()) {
+        return Err(Error::configuration("action path escapes the server mount"));
+    }
+    Ok(url)
+}
+
+fn safe_literal_segment(segment: &str) -> Result<String, Error> {
+    let mut decoded = Vec::new();
+    let mut bytes = segment.bytes();
+    while let Some(byte) = bytes.next() {
+        if byte == b'%' {
+            let high = bytes.next().and_then(hex);
+            let low = bytes.next().and_then(hex);
+            match (high, low) {
+                (Some(high), Some(low)) => decoded.push(high * 16 + low),
+                _ => return Err(Error::configuration("invalid encoded path segment")),
+            }
+        } else {
+            decoded.push(byte);
+        }
+    }
+    let decoded = String::from_utf8(decoded)
+        .map_err(|_| Error::configuration("invalid UTF-8 path segment"))?;
+    if decoded == "."
+        || decoded == ".."
+        || decoded.contains(['/', '\\', '?', '#'])
+        || decoded.chars().any(char::is_control)
+    {
+        return Err(Error::configuration("unsafe path segment"));
+    }
+    Ok(decoded)
+}
+
+fn hex(byte: u8) -> Option<u8> {
+    match byte {
+        b'0'..=b'9' => Some(byte - b'0'),
+        b'a'..=b'f' => Some(byte - b'a' + 10),
+        b'A'..=b'F' => Some(byte - b'A' + 10),
+        _ => None,
+    }
+}
diff --git a/clients/rust/runtime/src/runtime/transport.rs b/clients/rust/runtime/src/runtime/transport.rs
new file mode 100644
index 0000000..4cf9425
--- /dev/null
+++ b/clients/rust/runtime/src/runtime/transport.rs
@@ -0,0 +1,152 @@
+use std::fmt;
+
+use crate::runtime::{ClientConfig, Error, PreparedRequest, RawResponse};
+
+mod private {
+    pub trait Sealed {}
+}
+
+pub trait Mode: private::Sealed {}
+
+#[derive(Clone)]
+pub struct AsyncTransport {
+    client: reqwest::Client,
+    max_response_bytes: usize,
+}
+
+impl private::Sealed for AsyncTransport {}
+impl Mode for AsyncTransport {}
+
+impl AsyncTransport {
+    pub fn new(config: &ClientConfig) -> Result<Self, Error> {
+        let client = reqwest::Client::builder()
+            .redirect(reqwest::redirect::Policy::none())
+            .retry(reqwest::retry::never())
+            .timeout(config.timeout)
+            .connect_timeout(config.connect_timeout)
+            .build()
+            .map_err(|_| Error::configuration("could not construct the HTTP client"))?;
+        Ok(Self {
+            client,
+            max_response_bytes: config.max_response_bytes,
+        })
+    }
+
+    pub async fn execute(&self, request: PreparedRequest) -> Result<RawResponse, Error> {
+        let mut builder = self
+            .client
+            .request(request.method.reqwest(), request.url)
+            .headers(request.headers);
+        if let Some(body) = request.body {
+            builder = builder.body(body);
+        }
+        let mut response = builder.send().await.map_err(Error::transport)?;
+        let status = response.status().as_u16();
+        if response
+            .content_length()
+            .is_some_and(|length| length > self.max_response_bytes as u64)
+        {
+            return Err(Error::ResponseTooLarge {
+                limit: self.max_response_bytes,
+            });
+        }
+        let mut body = Vec::new();
+        while let Some(chunk) = response.chunk().await.map_err(Error::transport)? {
+            if chunk.len() > self.max_response_bytes.saturating_sub(body.len()) {
+                return Err(Error::ResponseTooLarge {
+                    limit: self.max_response_bytes,
+                });
+            }
+            body.extend_from_slice(&chunk);
+        }
+        Ok(RawResponse { status, body })
+    }
+}
+
+#[cfg(feature = "blocking")]
+#[derive(Clone)]
+pub struct BlockingTransport {
+    client: reqwest::blocking::Client,
+    max_response_bytes: usize,
+}
+
+#[cfg(feature = "blocking")]
+impl private::Sealed for BlockingTransport {}
+#[cfg(feature = "blocking")]
+impl Mode for BlockingTransport {}
+
+#[cfg(feature = "blocking")]
+impl BlockingTransport {
+    pub fn new(config: &ClientConfig) -> Result<Self, Error> {
+        let client = reqwest::blocking::Client::builder()
+            .redirect(reqwest::redirect::Policy::none())
+            .retry(reqwest::retry::never())
+            .timeout(config.timeout)
+            .connect_timeout(config.connect_timeout)
+            .build()
+            .map_err(|_| Error::configuration("could not construct the blocking HTTP client"))?;
+        Ok(Self {
+            client,
+            max_response_bytes: config.max_response_bytes,
+        })
+    }
+
+    pub fn execute(&self, request: PreparedRequest) -> Result<RawResponse, Error> {
+        use std::io::Read;
+
+        let mut builder = self
+            .client
+            .request(request.method.reqwest(), request.url)
+            .headers(request.headers);
+        if let Some(body) = request.body {
+            builder = builder.body(body);
+        }
+        let mut response = builder.send().map_err(Error::transport)?;
+        let status = response.status().as_u16();
+        if response
+            .content_length()
+            .is_some_and(|length| length > self.max_response_bytes as u64)
+        {
+            return Err(Error::ResponseTooLarge {
+                limit: self.max_response_bytes,
+            });
+        }
+        let mut body = Vec::new();
+        let mut buffer = [0; 8192];
+        loop {
+            let remaining = self.max_response_bytes.saturating_sub(body.len());
+            let to_read = buffer.len().min(remaining.saturating_add(1));
+            let length = response.read(&mut buffer[..to_read]).map_err(|error| {
+                // reqwest wraps body failures in io::Error while preserving its source.
+                let timeout = error.kind() == std::io::ErrorKind::TimedOut
+                    || error
+                        .get_ref()
+                        .and_then(|source| source.downcast_ref::<reqwest::Error>())
+                        .is_some_and(reqwest::Error::is_timeout);
+                Error::Transport { timeout }
+            })?;
+            if length == 0 {
+                break;
+            }
+            if length > remaining {
+                return Err(Error::ResponseTooLarge {
+                    limit: self.max_response_bytes,
+                });
+            }
+            body.extend_from_slice(&buffer[..length]);
+        }
+        Ok(RawResponse { status, body })
+    }
+}
+
+impl fmt::Debug for AsyncTransport {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("AsyncTransport { [REDACTED] }")
+    }
+}
+#[cfg(feature = "blocking")]
+impl fmt::Debug for BlockingTransport {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("BlockingTransport { [REDACTED] }")
+    }
+}
diff --git a/clients/rust/runtime/src/runtime/types.rs b/clients/rust/runtime/src/runtime/types.rs
new file mode 100644
index 0000000..e69c36e
--- /dev/null
+++ b/clients/rust/runtime/src/runtime/types.rs
@@ -0,0 +1,218 @@
+use std::{collections::BTreeMap, fmt};
+
+use serde::{Deserialize, Deserializer, Serialize, Serializer};
+use serde_json::Value;
+
+pub type JsonMap = serde_json::Map<String, Value>;
+pub type ValidationErrors = BTreeMap<String, Vec<String>>;
+
+/// An omitted input, an explicit null, or an explicitly supplied value.
+#[derive(Clone, Default, PartialEq, Eq)]
+pub enum InputValue<T> {
+    #[default]
+    Unset,
+    Null,
+    Value(T),
+}
+
+pub type Input<T> = InputValue<T>;
+
+impl<T> InputValue<T> {
+    pub fn is_unset(&self) -> bool {
+        matches!(self, Self::Unset)
+    }
+}
+
+impl<T> fmt::Debug for InputValue<T> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::Unset => "Unset",
+            Self::Null => "Null",
+            Self::Value(_) => "Value([REDACTED])",
+        })
+    }
+}
+
+impl<T: Serialize> Serialize for InputValue<T> {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        match self {
+            Self::Unset | Self::Null => serializer.serialize_none(),
+            Self::Value(value) => value.serialize(serializer),
+        }
+    }
+}
+
+impl<'de, T: Deserialize<'de>> Deserialize<'de> for InputValue<T> {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        Ok(match Option::<T>::deserialize(deserializer)? {
+            None => Self::Null,
+            Some(value) => Self::Value(value),
+        })
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Method {
+    Get,
+    Delete,
+    Post,
+    Put,
+    Patch,
+}
+
+impl Method {
+    pub(crate) fn reqwest(self) -> reqwest::Method {
+        match self {
+            Self::Get => reqwest::Method::GET,
+            Self::Delete => reqwest::Method::DELETE,
+            Self::Post => reqwest::Method::POST,
+            Self::Put => reqwest::Method::PUT,
+            Self::Patch => reqwest::Method::PATCH,
+        }
+    }
+
+    pub(crate) fn query(self) -> bool {
+        matches!(self, Self::Get | Self::Delete)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Layout {
+    Object,
+    ObjectList,
+    Hash,
+    HashList,
+}
+
+impl Layout {
+    pub(crate) fn list(self) -> bool {
+        matches!(self, Self::ObjectList | Self::HashList)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ParameterKind {
+    String,
+    Text,
+    Integer,
+    Float,
+    Boolean,
+    Datetime,
+    Resource,
+    Custom,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RequestAuth {
+    Configured,
+    None,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct ParameterSpec {
+    pub name: &'static str,
+    pub kind: ParameterKind,
+    pub required: bool,
+    pub nullable: bool,
+    pub protected: bool,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct InputSpec {
+    pub layout: Layout,
+    pub namespace: Option<&'static str>,
+    pub parameters: &'static [ParameterSpec],
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct OutputSpec {
+    pub layout: Layout,
+    pub namespace: &'static str,
+    pub allow_empty_response: bool,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct ActionSpec {
+    pub name: &'static str,
+    pub method: Method,
+    pub path: &'static str,
+    pub input: Option<InputSpec>,
+    pub output: Option<OutputSpec>,
+    pub meta_namespace: Option<&'static str>,
+    pub global_meta: &'static [ParameterSpec],
+    pub object_meta: &'static [ParameterSpec],
+    pub auth: RequestAuth,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct ApiSpec {
+    pub api_version: &'static str,
+    pub protocol_major: u16,
+    pub schema_sha256: &'static str,
+    pub basic_auth: bool,
+    pub token_header: Option<&'static str>,
+    pub oauth2_header: Option<&'static str>,
+}
+
+#[derive(Default)]
+pub struct RequestParts {
+    pub path_params: BTreeMap<String, String>,
+    pub input: Option<Value>,
+    pub global_meta: Option<JsonMap>,
+    pub object_meta: Option<JsonMap>,
+}
+
+pub struct PreparedRequest {
+    pub method: Method,
+    pub url: url::Url,
+    pub headers: reqwest::header::HeaderMap,
+    pub body: Option<Vec<u8>>,
+}
+
+pub struct RawResponse {
+    pub status: u16,
+    pub body: Vec<u8>,
+}
+pub struct Response<T, M> {
+    pub output: T,
+    pub meta: M,
+    pub http_status: u16,
+}
+
+macro_rules! redacted_debug {
+    ($name:ty, $label:literal) => {
+        impl fmt::Debug for $name {
+            fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+                f.write_str(concat!($label, " { [REDACTED] }"))
+            }
+        }
+    };
+}
+redacted_debug!(RequestParts, "RequestParts");
+redacted_debug!(PreparedRequest, "PreparedRequest");
+redacted_debug!(RawResponse, "RawResponse");
+
+impl<T, M> fmt::Debug for Response<T, M> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Response")
+            .field("http_status", &self.http_status)
+            .finish_non_exhaustive()
+    }
+}
+
+/// A partial or expanded resource association, without implied network access.
+#[derive(Clone, Default, PartialEq, Serialize, Deserialize)]
+#[serde(transparent)]
+pub struct Association(JsonMap);
+
+impl Association {
+    pub fn as_map(&self) -> &JsonMap {
+        &self.0
+    }
+}
+
+impl From<JsonMap> for Association {
+    fn from(value: JsonMap) -> Self {
+        Self(value)
+    }
+}
+redacted_debug!(Association, "Association");
diff --git a/clients/rust/runtime/src/runtime/validation.rs b/clients/rust/runtime/src/runtime/validation.rs
new file mode 100644
index 0000000..9f466df
--- /dev/null
+++ b/clients/rust/runtime/src/runtime/validation.rs
@@ -0,0 +1,213 @@
+use serde_json::Value;
+
+use crate::runtime::{
+    Association, Error, InputValue, JsonMap, ParameterKind, ParameterSpec, ValidationErrors,
+};
+
+/// Validation must precede Serde conversion, which would turn nonfinite floats into null.
+pub trait Validate {
+    fn validate(&self) -> Result<(), Error>;
+}
+
+impl<T: Validate> Validate for InputValue<T> {
+    fn validate(&self) -> Result<(), Error> {
+        match self {
+            Self::Value(value) => value.validate(),
+            _ => Ok(()),
+        }
+    }
+}
+
+impl<T: Validate> Validate for Vec<T> {
+    fn validate(&self) -> Result<(), Error> {
+        self.iter().try_for_each(Validate::validate)
+    }
+}
+
+impl Validate for f64 {
+    fn validate(&self) -> Result<(), Error> {
+        if self.is_finite() {
+            Ok(())
+        } else {
+            Err(Error::validation("input", "not a valid finite float"))
+        }
+    }
+}
+
+macro_rules! valid_types {
+    ($($ty:ty),*) => { $(impl Validate for $ty { fn validate(&self) -> Result<(), Error> { Ok(()) } })* };
+}
+valid_types!((), String, i64, bool, Value, Association);
+
+pub(crate) fn validate_map(
+    map: &JsonMap,
+    specs: &[ParameterSpec],
+    prefix: &str,
+) -> Result<(), Error> {
+    let mut errors = ValidationErrors::new();
+    for spec in specs {
+        let problem = match map.get(spec.name) {
+            None if spec.required => Some("is required"),
+            None => None,
+            Some(Value::Null) if !spec.nullable || spec.required => Some("cannot be null"),
+            Some(Value::Null) => None,
+            Some(value) => validate_kind(value, spec.kind),
+        };
+        if let Some(message) = problem {
+            errors.insert(format!("{prefix}{}", spec.name), vec![message.to_owned()]);
+        }
+    }
+    for name in map.keys() {
+        if !specs.iter().any(|spec| spec.name == name) {
+            errors.insert(
+                format!("{prefix}{name}"),
+                vec!["is not a described parameter".to_owned()],
+            );
+        }
+    }
+    if errors.is_empty() {
+        Ok(())
+    } else {
+        Err(Error::Validation { errors })
+    }
+}
+
+fn validate_kind(value: &Value, kind: ParameterKind) -> Option<&'static str> {
+    let (valid, message) = match kind {
+        ParameterKind::String | ParameterKind::Text => (value.is_string(), "not a valid string"),
+        ParameterKind::Integer => (value.as_i64().is_some(), "not a valid integer"),
+        ParameterKind::Float => (
+            value.as_f64().is_some_and(f64::is_finite),
+            "not a valid finite float",
+        ),
+        ParameterKind::Boolean => (value.is_boolean(), "not a valid boolean"),
+        ParameterKind::Datetime => (
+            value.as_str().is_some_and(valid_datetime),
+            "not in ISO 8601 format",
+        ),
+        ParameterKind::Resource => (
+            value.as_i64().is_some_and(|id| id >= 0),
+            "not a valid resource ID",
+        ),
+        ParameterKind::Custom => (true, ""),
+    };
+    if valid { None } else { Some(message) }
+}
+
+// Match the documented HaveAPI wire grammar, including date-only values and
+// shortened times. A pure RFC3339 parser would reject supported values.
+fn valid_datetime(value: &str) -> bool {
+    let bytes = value.as_bytes();
+    if bytes.len() < 10 || bytes[4] != b'-' || bytes[7] != b'-' {
+        return false;
+    }
+    let (Some(year), Some(month), Some(day)) = (
+        digits(&bytes[0..4]),
+        digits(&bytes[5..7]),
+        digits(&bytes[8..10]),
+    ) else {
+        return false;
+    };
+    let leap = year.is_multiple_of(4) && (!year.is_multiple_of(100) || year.is_multiple_of(400));
+    let days = match month {
+        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
+        4 | 6 | 9 | 11 => 30,
+        2 if leap => 29,
+        2 => 28,
+        _ => return false,
+    };
+    if year == 0 || day == 0 || day > days {
+        return false;
+    }
+    if bytes.len() == 10 {
+        return true;
+    }
+    if bytes.len() < 17 || bytes[10] != b'T' || bytes[13] != b':' {
+        return false;
+    }
+    if !digits(&bytes[11..13]).is_some_and(|hour| hour <= 23)
+        || !digits(&bytes[14..16]).is_some_and(|minute| minute <= 59)
+    {
+        return false;
+    }
+    let mut cursor = 16;
+    if bytes.get(cursor) == Some(&b':') {
+        if bytes.len() < cursor + 3
+            || !digits(&bytes[cursor + 1..cursor + 3]).is_some_and(|second| second <= 59)
+        {
+            return false;
+        }
+        cursor += 3;
+        if bytes.get(cursor) == Some(&b'.') {
+            cursor += 1;
+            let start = cursor;
+            while bytes.get(cursor).is_some_and(u8::is_ascii_digit) {
+                cursor += 1;
+            }
+            if cursor == start {
+                return false;
+            }
+        }
+    }
+    let zone = &bytes[cursor..];
+    if zone == b"Z" {
+        return true;
+    }
+    if !matches!(zone.first(), Some(b'+' | b'-')) {
+        return false;
+    }
+    let (hour, minute) = match zone.len() {
+        5 => (digits(&zone[1..3]), digits(&zone[3..5])),
+        6 if zone[3] == b':' => (digits(&zone[1..3]), digits(&zone[4..6])),
+        _ => return false,
+    };
+    hour.is_some_and(|hour| hour <= 23) && minute.is_some_and(|minute| minute <= 59)
+}
+
+fn digits(bytes: &[u8]) -> Option<u32> {
+    bytes.iter().try_fold(0, |acc, digit| {
+        if digit.is_ascii_digit() {
+            Some(acc * 10 + u32::from(digit - b'0'))
+        } else {
+            None
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn datetime_grammar_and_calendar() {
+        for value in [
+            "2020-02-29",
+            "2020-01-31T10:20Z",
+            "2020-01-31T10:20+01:30",
+            "2020-01-31T10:20:30.123-0500",
+            "2000-02-29T23:59:59Z",
+        ] {
+            assert!(valid_datetime(value), "{value}");
+        }
+        for value in [
+            "",
+            "2020/01/31",
+            "1900-02-29",
+            "2020-02-30",
+            "0000-01-01",
+            "2020-00-01",
+            "2020-01-00",
+            "2020-01-31T10:20",
+            "2020-01-31T24:00Z",
+            "2020-01-31T10:60Z",
+            "2020-01-31T10:20:60Z",
+            "2020-01-31T10:20:30.Z",
+            "2020-01-31T10:20+2400",
+            "2020-01-31T10:20+0060",
+            "2020-01-31T10:20Zx",
+            "２０２０-01-31",
+        ] {
+            assert!(!valid_datetime(value), "{value}");
+        }
+    }
+}
