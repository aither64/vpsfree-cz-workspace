+mod error;
+mod protocol;
+mod transport;
+mod types;
+mod validation;
+
+pub use auth::{SecretString, TokenStep};
+pub use client::{Client, ClientBuilder, ClientConfig, Request};
+pub use error::Error;
+pub use protocol::{decode, prepare};
+#[cfg(feature = "blocking")]
+pub use transport::BlockingTransport;
