--- /dev/null
+++ b/clients/rust/lib/haveapi/rust_client/cli.rb
@@ -0,0 +1,55 @@
+require 'optparse'
+require 'tomlrb'
+require 'haveapi/rust_client'
+
+module HaveAPI::RustClient
+  class Cli
+    def self.run(argv = ARGV, out: $stdout, err: $stderr)
+      command = argv.shift
+      options = {}
+      parser = OptionParser.new do |opts|
+        opts.banner = 'Usage: haveapi-rust-client fetch URL | generate [options]'
+        opts.on('--api-version VERSION') { |value| options[:version] = value }
+        opts.on('--profile PROFILE') { |value| options[:profile] = value }
+        opts.on('--schema FILE') { |value| options[:schema] = value }
+        opts.on('--config FILE') { |value| options[:config] = value }
+        opts.on('--output PATH') { |value| options[:output] = value }
+        opts.on('--check', 'Check without modifying destination') { options[:check] = true }
+        opts.on('-h', '--help') do
+          out.puts(opts)
+          return 0
+        end
+      end
+      parser.parse!(argv)
+      Snapshot.version!(options[:version])
+      raise Error, '--output is required' unless options[:output]
+
+      case command
+      when 'fetch'
+        raise Error, 'fetch requires one explicit version URL and --profile' unless argv.length == 1 && options[:profile]
+        raise Error, '--check is supported only for generation' if options[:check]
+
+        diagnostics = []
+        snapshot = Snapshot.fetch(url: argv.first, api_version: options[:version], profile: options[:profile], diagnostics:)
+        diagnostics.each { |message| err.puts(message) }
+        File.write(options[:output], Snapshot.canonical(snapshot))
+      when 'generate'
+        unless argv.empty? && options[:schema] && options[:config]
+          raise Error, 'generate requires --schema and --config'
+        end
+
+        snapshot = Snapshot.load(options[:schema])
+        raise Error, 'requested API version differs from snapshot' unless options[:version] == snapshot.fetch('api_version')
+
+        config = Tomlrb.load_file(options[:config])
+        Generator.new(schema: snapshot, config:).generate(output: options[:output], check: options[:check])
+      else
+        raise Error, 'expected fetch or generate subcommand'
+      end
+      0
+    rescue Error, OptionParser::ParseError, Tomlrb::ParseError, SystemCallError => e
+      err.puts("haveapi-rust-client: #{e.message}")
+      1
+    end
+  end
+end
diff --git a/clients/rust/lib/haveapi/rust_client/generator.rb b/clients/rust/lib/haveapi/rust_client/generator.rb
new file mode 100644
index 0000000..4c837ea
--- /dev/null
+++ b/clients/rust/lib/haveapi/rust_client/generator.rb
@@ -0,0 +1,307 @@
+require 'erb'
+require 'fileutils'
+require 'tmpdir'
+require 'open3'
+require 'fiddle/import'
+require 'tomlrb'
+
+module HaveAPI::RustClient
+  class Generator
+    ROOT = File.expand_path('../../..', __dir__)
+    CONFIG_KEYS = %w[crate_name crate_version license edition rust_version rustfmt_version].freeze
+    OWNER_FILE = '.haveapi-generated.json'.freeze
+    attr_reader :schema, :config, :ir
+
+    def initialize(schema:, config:)
+      @schema = Snapshot.validate(schema)
+      @config = config
+      validate_config
+      @ir = IR.new(schema)
+    end
+
+    def generate(output:, check: false)
+      output = File.expand_path(output)
+      validate_destination(output)
+      validate_manifest(output)
+      formatter = ENV.fetch('RUSTFMT', 'rustfmt')
+      stdout, _stderr, status = Open3.capture3(formatter, '--version')
+      unless status.success? && stdout.strip == config.fetch('rustfmt_version')
+        raise Error, 'rustfmt version differs from generator configuration'
+      end
+
+      Dir.mktmpdir('haveapi-rust-') do |temp|
+        render_tree(temp)
+        generated = Dir.glob(File.join(temp, '**/*.rs')).reject { |path| path.start_with?(File.join(temp, 'runtime/')) }
+        _stdout, stderr, status = Open3.capture3(
+          formatter, '--edition', config.fetch('edition'), '--config', 'skip_children=true', *generated
+        )
+        raise Error, "rustfmt failed: #{stderr.lines.first&.strip}" unless status.success?
+
+        files = tree_files(temp)
+        manifest = {
+          'owner' => 'haveapi-rust-client', 'format' => 1,
+          'generator_version' => VERSION, 'generator_source_sha256' => generator_digest,
+          'schema_sha256' => Snapshot.sha256(schema), 'runtime_sha256' => runtime_digest,
+          'api_version' => schema.fetch('api_version'), 'protocol_version' => schema.fetch('protocol_version'),
+          'profile' => schema.fetch('profile'), 'config' => config,
+          'ruby_dependency_lock_sha256' => Digest::SHA256.file(File.join(ROOT, 'Gemfile.lock')).hexdigest,
+          'files' => files.to_h { |path| [path, Digest::SHA256.file(File.join(temp, path)).hexdigest] }
+        }
+        File.write(File.join(temp, OWNER_FILE), Snapshot.canonical(manifest))
+        return true if equal_trees?(temp, output)
+        raise Error, 'generated tree is stale; regenerate without --check' if check
+
+        install_tree(temp, output)
+      end
+      true
+    rescue Errno::ENOENT
+      raise Error, 'required generation file/tool is missing'
+    end
+
+    def runtime_digest
+      digest_files(runtime_files, File.join(ROOT, 'runtime/src/runtime'))
+    end
+
+    def manifest_requirements
+      render('Cargo.toml', {})
+    end
+
+    private
+
+    def validate_config
+      raise Error, 'generator config keys do not match supported contract' unless config.keys.sort == CONFIG_KEYS.sort
+      unless config['crate_name'].is_a?(String) && config['crate_name'].match?(/\A[a-z][a-z0-9_-]*\z/) &&
+             config['crate_version'].is_a?(String) && config['crate_version'].match?(/\A\d+\.\d+\.\d+(?:-[a-zA-Z0-9.-]+)?\z/)
+        raise Error, 'invalid crate name/version'
+      end
+      unless config['license'] == 'MIT' && config['edition'] == '2024' && config['rust_version'] == '1.95' &&
+             config['rustfmt_version'].is_a?(String) && !config['rustfmt_version'].empty?
+        raise Error, 'unsupported license, Rust edition/MSRV or formatter configuration'
+      end
+    end
+
+    def validate_manifest(output)
+      return unless File.basename(output) == 'generated' && File.basename(File.dirname(output)) == 'src'
+
+      path = File.join(File.dirname(output, 2), 'Cargo.toml')
+      return unless File.exist?(path)
+      raise Error, 'crate manifest must not be a symlink' if File.symlink?(path)
+
+      manifest = Tomlrb.load_file(path)
+      package = manifest.fetch('package')
+      %w[name version license edition rust-version].zip(%w[crate_name crate_version license edition rust_version]).each do |cargo, key|
+        raise Error, "Cargo.toml #{cargo} differs from generator config" unless package[cargo] == config[key]
+      end
+      deps = manifest.fetch('dependencies')
+      { 'serde' => '1', 'serde_json' => '1', 'url' => '2.5', 'reqwest' => '0.13.5' }.each do |name, version|
+        dependency = deps.fetch(name)
+        actual = dependency.is_a?(Hash) ? dependency['version'] : dependency
+        unless actual == version && (!dependency.is_a?(Hash) || !dependency.keys.intersect?(%w[path git]))
+          raise Error, "Cargo.toml dependency #{name} differs from runtime requirements"
+        end
+      end
+      unless deps['serde'].is_a?(Hash) && deps['serde'].fetch('features', []).include?('derive')
+        raise Error, 'Cargo.toml serde derive feature is required'
+      end
+
+      reqwest = deps.fetch('reqwest')
+      unless reqwest.is_a?(Hash) && reqwest['default-features'] == false &&
+             reqwest.fetch('features', []).sort == %w[json rustls] &&
+             manifest.dig('features', 'default') == [] &&
+             manifest.dig('features', 'blocking')&.include?('reqwest/blocking')
+        raise Error, 'Cargo.toml reqwest TLS/JSON/blocking requirements do not match runtime'
+      end
+    rescue KeyError, Tomlrb::ParseError
+      raise Error, 'crate manifest is incomplete or invalid TOML'
+    end
+
+    def render_tree(temp)
+      File.write(File.join(temp, 'mod.rs'), render('mod.rs', {}))
+      FileUtils.mkdir_p(File.join(temp, 'resources'))
+      File.write(File.join(temp, 'resources/mod.rs'), render('resources.rs', {}))
+      ir.resources.each do |resource|
+        dir = File.join(temp, 'resources', resource[:module])
+        FileUtils.mkdir_p(dir)
+        File.write(File.join(dir, 'mod.rs'), render('resource.rs', resource:))
+        resource[:actions].each do |action|
+          File.write(File.join(dir, "#{action[:method]}.rs"), render('action.rs', action:))
+        end
+      end
+      runtime_files.each do |relative|
+        target = File.join(temp, 'runtime', relative)
+        FileUtils.mkdir_p(File.dirname(target))
+        FileUtils.cp(File.join(ROOT, 'runtime/src/runtime', relative), target)
+      end
+    end
+
+    def render(template, locals)
+      ERB.new(File.read(File.join(ROOT, 'template', "#{template}.erb")), trim_mode: '-').result_with_hash(
+        { generator: self, schema:, config:, ir: }.merge(locals)
+      )
+    end
+
+    def runtime_files
+      root = File.join(ROOT, 'runtime/src/runtime')
+      raise Error, 'maintained runtime source is missing' unless File.file?(File.join(root, 'mod.rs'))
+
+      ensure_no_symlinks(root)
+      tree_files(root)
+    end
+
+    def generator_digest
+      paths = Dir.chdir(ROOT) { Dir['lib/**/*.rb', 'template/**/*'].select { |path| File.file?(path) }.sort }
+      digest_files(paths, ROOT)
+    end
+
+    def digest_files(paths, root)
+      digest = Digest::SHA256.new
+      paths.sort.each { |path| digest.update(path).update("\0").update(File.binread(File.join(root, path))).update("\0") }
+      digest.hexdigest
+    end
+
+    def validate_destination(output)
+      raise Error, 'refusing filesystem root output' if output == '/'
+
+      cursor = output
+      loop do
+        raise Error, 'generated destination contains a symlink' if File.symlink?(cursor)
+        break if cursor == File.dirname(cursor)
+
+        cursor = File.dirname(cursor)
+      end
+      return unless File.exist?(output)
+      raise Error, 'generated destination is not a directory' unless File.directory?(output)
+
+      ensure_no_symlinks(output)
+      entries = tree_files(output)
+      return if entries.empty?
+
+      marker = File.join(output, OWNER_FILE)
+      raise Error, 'nonempty destination has no generator ownership manifest' unless File.file?(marker)
+
+      owner = JSON.parse(File.read(marker))
+      unless owner['owner'] == 'haveapi-rust-client' && owner['format'] == 1 && owner['files'].is_a?(Hash)
+        raise Error, 'invalid generator ownership manifest'
+      end
+
+      owner.fetch('files').each_key do |path|
+        unless path.is_a?(String) && !path.start_with?('/') && Snapshot.safe_segments?(path)
+          raise Error, 'unsafe owned path in manifest'
+        end
+      end
+      unknown = entries - owner.fetch('files').keys - [OWNER_FILE]
+      raise Error, 'destination contains files not owned by generator' unless unknown.empty?
+    rescue JSON::ParserError
+      raise Error, 'invalid generator ownership JSON'
+    end
+
+    def ensure_no_symlinks(root)
+      return unless Dir.glob(File.join(root, '**/*'), File::FNM_DOTMATCH).any? { |path| File.symlink?(path) }
+
+      raise Error, 'symlink in generator-owned source/destination'
+    end
+
+    def tree_files(root)
+      return [] unless File.directory?(root)
+
+      Dir.chdir(root) { Dir.glob('**/*', File::FNM_DOTMATCH).select { |path| File.file?(path) }.sort }
+    end
+
+    def equal_trees?(left, right)
+      files = tree_files(left)
+      files == tree_files(right) && files.all? do |path|
+        File.binread(File.join(left, path)) == File.binread(File.join(right, path))
+      end
+    end
+
+    def install_tree(temp, output)
+      FileUtils.mkdir_p(File.dirname(output))
+      Dir.mktmpdir('.haveapi-rust-', File.dirname(output)) do |staging|
+        replacement = File.join(staging, 'generated')
+        FileUtils.cp_r(temp, replacement)
+        if File.exist?(output)
+          # Directory exchange is atomic even for a nonempty destination. Refuse
+          # unsupported hosts instead of exposing a half-replaced generated tree.
+          AtomicRename.exchange(replacement, output)
+        else
+          File.rename(replacement, output)
+        end
+      end
+    end
+
+    module AtomicRename
+      extend Fiddle::Importer
+
+      dlload Fiddle.dlopen(nil)
+
+      def self.exchange(left, right)
+        function = Fiddle::Function.new(handler['renameat2'], [Fiddle::TYPE_INT, Fiddle::TYPE_VOIDP,
+                                                               Fiddle::TYPE_INT, Fiddle::TYPE_VOIDP,
+                                                               Fiddle::TYPE_INT], Fiddle::TYPE_INT)
+        return if function.call(-100, left, -100, right, 2) == 0
+
+        raise Error, 'atomic generated-directory exchange failed'
+      rescue Fiddle::DLError
+        raise Error, 'atomic replacement requires renameat2 support on this host'
+      end
+    end
+
+    public
+
+    def literal(value)
+      Naming.literal(value)
+    end
+
+    def option(value)
+      value.nil? ? 'None' : "Some(#{literal(value)})"
+    end
+
+    def layout(value)
+      value.split('_').map(&:capitalize).join
+    end
+
+    def rust_type(parameter, output: false)
+      case parameter[:desc].fetch('type')
+      when 'String', 'Text', 'Datetime' then 'String'
+      when 'Integer', 'Resource' then output && parameter[:desc]['type'] == 'Resource' ? 'runtime::Association' : 'i64'
+      when 'Float' then 'f64'
+      when 'Boolean' then 'bool'
+      when 'Custom' then 'serde_json::Value'
+      end
+    end
+
+    def input_type(action)
+      return '()' unless action[:input]
+
+      action[:input][:layout].end_with?('_list') ? 'Vec<Input>' : 'Input'
+    end
+
+    def output_type(action)
+      return '()' unless action[:output]
+
+      action[:output][:layout].end_with?('_list') ? 'Vec<Output>' : 'Output'
+    end
+
+    def meta_parameters(action)
+      values = [action[:global_output]]
+      values << action[:object_output] if action[:output] && !action[:output][:layout].end_with?('_list')
+      fields = values.compact.flat_map { |io| io[:parameters] }
+      fields.group_by { |field| field[:name] }.map do |name, matches|
+        raise Error, "inconsistent metadata field #{name}" if matches.map { |field| field[:desc] }.uniq.length > 1
+
+        matches.first
+      end.sort_by { |field| field[:name] }
+    end
+
+    def parameter_specs(io)
+      return '&[]' unless io
+
+      parameters = io[:parameters].map do |parameter|
+        desc = parameter[:desc]
+        "runtime::ParameterSpec { name: #{literal(parameter[:name])}, kind: runtime::ParameterKind::#{desc.fetch('type')}, " \
+          "required: #{desc['required'] == true}, nullable: #{desc['nullable'] == true}, protected: #{desc['protected'] == true} }"
+      end.join(',')
+      "&[#{parameters}]"
+    end
+  end
+end
diff --git a/clients/rust/lib/haveapi/rust_client/ir.rb b/clients/rust/lib/haveapi/rust_client/ir.rb
new file mode 100644
index 0000000..e706081
--- /dev/null
+++ b/clients/rust/lib/haveapi/rust_client/ir.rb
@@ -0,0 +1,195 @@
+module HaveAPI::RustClient
+  class IR
+    TYPES = %w[String Text Integer Float Boolean Datetime Resource Custom].freeze
+    LAYOUTS = %w[object object_list hash hash_list].freeze
+    METHODS = %w[GET DELETE POST PUT PATCH].freeze
+    attr_reader :snapshot, :resources, :actions
+
+    def initialize(snapshot)
+      @snapshot = Snapshot.validate(snapshot)
+      @resources = []
+      @actions = []
+      @module_scope = Naming::Scope.new(%w[runtime resources API_SPEC API_VERSION SCHEMA_SHA256])
+      description = snapshot.fetch('description')
+      walk(description.fetch('resources'), [])
+      description.fetch('authentication').each do |provider, auth|
+        next unless auth['resources']
+
+        walk(auth.fetch('resources'), ['authentication', provider], auth_provider: provider)
+      end
+      bind_ancestors
+      validate_auth(description.fetch('authentication'))
+    end
+
+    def inventory
+      {
+        'api_version' => snapshot.fetch('api_version'), 'schema_sha256' => Snapshot.sha256(snapshot),
+        'profile' => snapshot.fetch('profile'), 'coverage' => 'captured description only; plugin coverage unknown',
+        'resource_count' => resources.length, 'action_count' => actions.length,
+        'parameter_count' => actions.sum { |action| all_parameters(action).length },
+        'resources' => resources.map { |resource| resource[:path] },
+        'actions' => actions.map do |action|
+          { 'name' => action[:path], 'method' => action[:desc].fetch('method'),
+            'path' => action[:desc].fetch('path'),
+            'parameters' => all_parameters(action).map { |parameter| parameter[:path] } }
+        end
+      }
+    end
+
+    def all_parameters(action)
+      %i[input output global_input global_output object_input object_output].flat_map do |key|
+        action[key] ? action[key][:parameters] : []
+      end
+    end
+
+    private
+
+    def walk(map, parents, auth_provider: nil)
+      raise Error, "resources must be an object at #{parents.join('/')}" unless map.is_a?(Hash)
+
+      map.sort.each do |name, desc|
+        path = parents + [name]
+        module_name = path.map { |item| Naming.snake(item) }.join('__')
+        @module_scope.add(module_name, path.join('/'))
+        resource = { name:, path:, module: module_name, desc:, actions: [], parent: parents }
+        resources << resource
+        scope = Naming::Scope.new
+        desc.fetch('actions').sort.each do |action_name, action_desc|
+          action_path = path + [action_name]
+          method_name = Naming.snake(action_name)
+          scope.add(method_name, action_path.join('/'))
+          aliases = action_desc.fetch('aliases', []).map do |item|
+            alias_name = Naming.snake(item)
+            next if alias_name == method_name
+
+            scope.add(alias_name, (action_path + [item]).join('/'))
+          end.compact
+          action = {
+            name: action_name, method: method_name, aliases:, path: action_path, resource:,
+            desc: action_desc, auth_provider:, route: route(action_desc.fetch('path'), auth_provider),
+            input: io(action_desc['input'], :input, action_path + ['input']),
+            output: io(action_desc['output'], :output, action_path + ['output'])
+          }
+          raise Error, "unsupported HTTP method at #{action_path.join('/')}" unless METHODS.include?(action_desc['method'])
+
+          %w[global object].each do |role|
+            %w[input output].each do |direction|
+              action[:"#{role}_#{direction}"] = io(
+                action_desc.dig('meta', role, direction), :metadata, action_path + ['meta', role, direction]
+              )
+            end
+          end
+          action[:placeholders] = action[:route].scan(/\{([^}]+)\}/).flatten.uniq
+          argument_scope = Naming::Scope.new(%w[self])
+          action[:arguments] = action[:placeholders].to_h do |placeholder|
+            [placeholder, argument_scope.add(Naming.snake(placeholder), action_path.join('/') + "/#{placeholder}")]
+          end
+          resource[:actions] << action
+          actions << action
+        end
+        walk(desc.fetch('resources'), path, auth_provider:)
+      end
+    rescue KeyError => e
+      raise Error, "incomplete resource description at #{parents.join('/')}: #{e.key}"
+    end
+
+    def io(desc, direction, path)
+      return nil if desc.nil? || desc == { 'parameters' => {} }
+      raise Error, "invalid IO at #{path.join('/')}" unless desc.is_a?(Hash)
+      raise Error, "unsupported layout at #{path.join('/')}" unless LAYOUTS.include?(desc['layout'])
+
+      namespace = desc['namespace']
+      unless namespace == false || (namespace.is_a?(String) && !namespace.empty?)
+        raise Error, "missing/invalid namespace at #{path.join('/')}"
+      end
+      if direction == :output && namespace == false
+        raise Error, "ordinary output namespace=false unsupported at #{path.join('/')}"
+      end
+      if direction == :input && namespace == false && desc['layout'].end_with?('_list')
+        raise Error, "unnamespaced list input unsupported at #{path.join('/')}"
+      end
+
+      parameters = desc.fetch('parameters')
+      raise Error, "parameters must be an object at #{path.join('/')}" unless parameters.is_a?(Hash)
+      raise Error, "custom IO format unsupported at #{path.join('/')}" if desc.has_key?('format')
+
+      scope = Naming::Scope.new(direction == :input ? %w[input global_meta object_meta send input_mut] : %w[extra object_meta])
+      fields = parameters.sort.map do |name, parameter|
+        unless parameter.is_a?(Hash) && TYPES.include?(parameter['type'])
+          raise Error, "unknown parameter type at #{(path + [name]).join('/')}"
+        end
+
+        field = scope.add(Naming.snake(name), (path + [name]).join('/'))
+        { name:, field:, desc: parameter, path: path + [name] }
+      end
+      if direction == :input
+        fields.select { |parameter| parameter[:desc]['nullable'] == true }.each do |parameter|
+          scope.add("#{parameter[:field]}_null", (parameter[:path] + ['null setter']).join('/'))
+        end
+      end
+      { desc:, parameters: fields, layout: desc.fetch('layout'), namespace: namespace == false ? nil : namespace }
+    end
+
+    def route(path, provider)
+      unless path.is_a?(String) && path.start_with?('/') && !path.match?(/[?#]/) && Snapshot.safe_segments?(path)
+        raise Error, 'unsafe action path in schema'
+      end
+
+      mount = snapshot.fetch('mount_path')
+      raise Error, 'action path escapes capture mount' unless path.start_with?(mount)
+
+      relative = path.delete_prefix(mount)
+      unless provider || relative.start_with?("v#{snapshot.fetch('api_version')}/")
+        raise Error, 'action path does not match selected API version'
+      end
+      unless relative.gsub(/\{[a-zA-Z0-9_-]+\}/, '').match?(%r{\A[a-zA-Z0-9_/.%~-]*\z})
+        raise Error, 'invalid action path/template'
+      end
+
+      relative
+    end
+
+    def bind_ancestors
+      resources.each do |resource|
+        parent = resources.find { |item| item[:path] == resource[:parent] }
+        resource[:bound] = []
+        next unless parent
+
+        parent_routes = parent[:actions].map { |action| action[:route] }
+        ancestors = resource[:actions].map do |action|
+          matches = parent_routes.filter_map do |route|
+            next unless action[:route].start_with?("#{route}/")
+
+            route.scan(/\{([^}]+)\}/).flatten.uniq
+          end
+          matches.max_by(&:length) || []
+        end
+        unique = ancestors.uniq
+        if unique.length > 1
+          raise Error, "ambiguous ancestor placeholders at #{resource[:path].join('/')}"
+        end
+
+        resource[:bound] = unique.first || []
+        resource[:actions].each do |action|
+          next if action[:placeholders].take(resource[:bound].length) == resource[:bound]
+
+          raise Error, "ancestor template mismatch at #{action[:path].join('/')}"
+        end
+      end
+    end
+
+    def validate_auth(auth)
+      auth.each do |provider, config|
+        next unless config.is_a?(Hash)
+
+        config.each do |key, value|
+          Snapshot.endpoint!(value) if key.end_with?('_url') && value
+          next unless key.end_with?('_path') && value
+          next if value.start_with?('/') && !value.match?(/[?#]/) && Snapshot.safe_segments?(value)
+
+          raise Error, "unsafe authentication endpoint for #{provider}"
+        end
+      end
+    end
+  end
+end
diff --git a/clients/rust/lib/haveapi/rust_client/naming.rb b/clients/rust/lib/haveapi/rust_client/naming.rb
new file mode 100644
index 0000000..973dadf
--- /dev/null
+++ b/clients/rust/lib/haveapi/rust_client/naming.rb
@@ -0,0 +1,46 @@
+module HaveAPI::RustClient
+  module Naming
+    RESERVED = %w[
+      as async await break const continue crate dyn else enum extern false fn for if impl in let loop
+      match mod move mut pub ref return self Self static struct super trait true type union unsafe use
+      where while abstract become box do final macro override priv typeof unsized virtual yield try gen
+    ].freeze
+
+    def self.snake(value)
+      result = value.to_s.gsub(/([A-Z]+)([A-Z][a-z])/, '\1_\2')
+                    .gsub(/([a-z\d])([A-Z])/, '\1_\2').gsub(/[^a-zA-Z0-9_]/, '_').downcase
+      result = "field_#{result}" if result.empty? || result == '_' || result.match?(/\A\d/)
+      RESERVED.include?(result) ? "#{result}_" : result
+    end
+
+    def self.literal(value)
+      escaped = value.to_s.codepoints.map do |char|
+        case char
+        when 34 then '\"'
+        when 92 then '\\\\'
+        when 10 then '\n'
+        when 13 then '\r'
+        when 9 then '\t'
+        when 0..31, 127 then "\\u{#{char.to_s(16)}}"
+        else char.chr(Encoding::UTF_8)
+        end
+      end.join
+      "\"#{escaped}\""
+    end
+
+    class Scope
+      def initialize(reserved = [])
+        @names = reserved.to_h { |name| [name, "reserved member #{name}"] }
+      end
+
+      def add(name, path)
+        if @names.has_key?(name)
+          raise Error, "Rust name collision #{name}: #{@names[name]} and #{path}"
+        end
+
+        @names[name] = path
+        name
+      end
+    end
+  end
+end
diff --git a/clients/rust/lib/haveapi/rust_client/snapshot.rb b/clients/rust/lib/haveapi/rust_client/snapshot.rb
new file mode 100644
index 0000000..5940e03
--- /dev/null
+++ b/clients/rust/lib/haveapi/rust_client/snapshot.rb
@@ -0,0 +1,207 @@
+require 'json'
+require 'digest'
+require 'uri'
+
+module HaveAPI::RustClient
+  module Snapshot
+    KEYS = %w[schema_format api_version protocol_version source_url profile mount_path description].freeze
+    PROSE = %w[description label examples message comment title].freeze
+
+    def self.canonical(value)
+      normalized = case value
+                   when Hash
+                     value.keys.map(&:to_s).sort.to_h do |key|
+                       [key, canonical_value(value.fetch(key))]
+                     end
+                   else
+                     canonical_value(value)
+                   end
+      "#{JSON.pretty_generate(normalized)}\n"
+    end
+
+    def self.canonical_value(value)
+      case value
+      when Hash
+        value.keys.sort.to_h { |key| [key, canonical_value(value.fetch(key))] }
+      when Array
+        value.map { |item| canonical_value(item) }
+      else
+        value
+      end
+    end
+
+    def self.sha256(snapshot)
+      Digest::SHA256.hexdigest(canonical(snapshot))
+    end
+
+    def self.load(path)
+      validate(JSON.parse(File.read(path)))
+    rescue JSON::ParserError
+      raise Error, 'snapshot is not valid JSON'
+    end
+
+    def self.fetch(url:, api_version:, profile:, diagnostics: [])
+      require 'haveapi/client'
+      version!(api_version)
+      endpoint = endpoint!(url)
+      suffix = "/v#{api_version}/"
+      raise Error, 'fetch URL must select the exact requested version' unless endpoint.path.end_with?(suffix)
+
+      mount = endpoint.path.delete_suffix("v#{api_version}/")
+      # The shared metadata client owns parsing/protocol compatibility. Keep the
+      # explicit version request at the supplied mount and disable redirects.
+      root = endpoint.dup
+      root.path = mount
+      communicator = HaveAPI::Client::Communicator.new(root.to_s)
+      communicator.instance_variable_set(
+        :@rest,
+        RestClient::Resource.new(root.to_s, max_redirects: 0, open_timeout: 10, read_timeout: 30)
+      )
+      description = communicator.describe_api(api_version)
+      from_description(
+        description: JSON.parse(JSON.generate(description)),
+        api_version:, protocol_version: communicator.instance_variable_get(:@proto_version),
+        source_url: url, profile:, mount_path: mount, diagnostics:
+      )
+    rescue HaveAPI::Client::ProtocolError
+      raise Error, 'incompatible HaveAPI protocol version'
+    rescue RestClient::Exception, URI::InvalidURIError
+      raise Error, 'metadata acquisition failed (HTTP, redirect or URL error)'
+    end
+
+    def self.from_envelope(envelope, api_version:, source_url:, profile:, mount_path: '/', diagnostics: [])
+      raise Error, 'metadata envelope is not successful' unless envelope['status'] == true
+
+      from_description(
+        description: envelope.fetch('response'), protocol_version: envelope.fetch('version'),
+        api_version:, source_url:, profile:, mount_path:, diagnostics:
+      )
+    rescue KeyError
+      raise Error, 'metadata envelope is incomplete'
+    end
+
+    def self.from_description(description:, api_version:, protocol_version:, source_url:, profile:, mount_path: '/', diagnostics: [])
+      snapshot = {
+        'schema_format' => 1, 'api_version' => api_version, 'protocol_version' => protocol_version,
+        'source_url' => source_url, 'profile' => profile, 'mount_path' => mount_path,
+        'description' => sanitize(description, diagnostics:)
+      }
+      validate(snapshot)
+    end
+
+    # Prose is removed only from structural description objects. Parameter names,
+    # validator choice keys and Custom/default JSON are data, never filter keys.
+    def self.sanitize(value, context = :description, diagnostics: [], path: [])
+      return value.map { |item| sanitize(item, context, diagnostics:, path:) } if value.is_a?(Array)
+      return value unless value.is_a?(Hash)
+
+      value.each_with_object({}) do |(key, item), result|
+        next if PROSE.include?(key) && !%i[map data choices].include?(context)
+
+        if context == :description && key == 'default' && value['protected'] == true && !item.nil?
+          diagnostics << "removed protected default: #{path.join('/')}"
+          next
+        end
+
+        validate_machine_endpoint(key, item) if context == :description
+        child_context = sanitization_context(context, key, item)
+        result[key] = if context == :validators && key == 'custom'
+                        true
+                      elsif context == :choices
+                        nil
+                      else
+                        sanitize(item, child_context, diagnostics:, path: path + [key])
+                      end
+      end
+    end
+
+    def self.validate_machine_endpoint(key, value)
+      return if value.nil?
+      return endpoint!(value) if key.end_with?('_url')
+      return unless %w[path help].include?(key) || key.end_with?('_path')
+
+      path, query = value.is_a?(String) ? value.split('?', 2) : [nil, nil]
+      unless path && path.start_with?('/') && !path.include?('#') && safe_segments?(path) &&
+             (query.nil? || (key == 'help' && query.match?(/\Amethod=(?:GET|POST|PUT|PATCH|DELETE|OPTIONS)\z/)))
+        raise Error, 'unsafe machine endpoint in API description'
+      end
+    end
+
+    def self.sanitization_context(context, key, item)
+      return :data if %i[data choices].include?(context)
+      return :description if context == :map
+      return :map if %w[resources actions parameters authentication].include?(key)
+      return :data if %w[default format].include?(key) && context != :validator
+      return item.is_a?(Hash) ? :choices : :data if key == 'values'
+      return :validators if key == 'validators'
+      return :validator if context == :validators
+
+      :description
+    end
+
+    def self.validate(snapshot)
+      raise Error, 'snapshot must be an object' unless snapshot.is_a?(Hash)
+      raise Error, 'unsupported snapshot envelope keys' unless snapshot.keys.sort == KEYS.sort
+      raise Error, 'unsupported snapshot format' unless snapshot['schema_format'] == 1
+
+      version!(snapshot['api_version'])
+      protocol = snapshot['protocol_version']
+      raise Error, 'unsupported HaveAPI protocol major' unless protocol.is_a?(String) && protocol.match?(/\A2\.\d+\z/)
+      raise Error, 'profile must be a nonempty label' unless snapshot['profile'].is_a?(String) && !snapshot['profile'].empty?
+
+      endpoint = endpoint!(snapshot['source_url'])
+      mount = snapshot['mount_path']
+      unless mount.is_a?(String) && mount.start_with?('/') && mount.end_with?('/') && safe_segments?(mount)
+        raise Error, 'invalid capture mount path'
+      end
+
+      expected = "#{mount}v#{snapshot['api_version']}/"
+      raise Error, 'snapshot source URL/version mismatch' unless endpoint.path == expected
+
+      description = snapshot['description']
+      unless description.is_a?(Hash) && description['resources'].is_a?(Hash) &&
+             description['authentication'].is_a?(Hash) && description['meta'].is_a?(Hash)
+        raise Error, 'invalid API description structure'
+      end
+      raise Error, 'snapshot description/version mismatch' unless description['help'] == expected
+
+      description.fetch('authentication').each do |provider, config|
+        raise Error, "invalid authentication description for #{provider}" unless config.is_a?(Hash)
+
+        config.each do |key, value|
+          endpoint!(value) if key.end_with?('_url') && value
+          next unless key.end_with?('_path') && value
+          next if value.is_a?(String) && value.start_with?('/') && !value.match?(/[?#]/) && safe_segments?(value)
+
+          raise Error, "unsafe authentication path for #{provider}"
+        end
+      end
+      snapshot
+    end
+
+    def self.version!(version)
+      return if version.is_a?(String) && version.match?(/\A\d+(?:\.\d+)*\z/)
+
+      raise Error, 'an explicit numeric API version is required'
+    end
+
+    def self.endpoint!(url)
+      endpoint = URI.parse(url)
+      unless %w[http https].include?(endpoint.scheme) && endpoint.host &&
+             endpoint.userinfo.nil? && endpoint.query.nil? && endpoint.fragment.nil? && safe_segments?(endpoint.path)
+        raise Error, 'endpoint must be an HTTP URL without credentials, query or fragment'
+      end
+
+      endpoint
+    rescue URI::InvalidURIError, TypeError
+      raise Error, 'invalid endpoint URL'
+    end
+
+    def self.safe_segments?(path)
+      !path.include?('\\') && !path.start_with?('//') && path.split('/').none? do |segment|
+        decoded = URI::DEFAULT_PARSER.unescape(segment)
+        %w[. ..].include?(decoded) || decoded.match?(%r{[/\\\x00-\x1f\x7f]})
+      end
+    end
+  end
+end
