+prove_full_applied_boot() {
+  local slug="$1" config="$2" machine top names
+  root_applied_source "$slug" "$config" || return
+  names="$(jq -r '.machines | keys[]' "$config")" || return
+  [ -n "$names" ] || die "full boot proof requires every configured machine"
+  while IFS= read -r machine; do
+    top="$(jq -r --arg machine "$machine" '.machines[$machine].toplevel' "$config")" || return
+    prove_machine_selection "$slug" "$machine" "$top" "$(jq -r --arg machine "$machine" '.machines[$machine].spin' "$config")" || return
+  done <<<"$names"
+  maintenance_state "$slug" applied-finish-boot "$config" "public full boot proved all current systems and rooted closures after refresh"
+}
