+maintenance_recover_config() {
+  local slug="$1" evidence prepared next source sources
+  shift
+  [ "$#" -eq 2 ] && [ "$1" = --residency-evidence ] && [ -n "$2" ] || die "recovery requires exactly residency evidence"
+  evidence="$2"
+  devcluster_validate_cluster_directory "$slug" false || die "recovery requires existing owned state"
+  maintenance_require_stopped "$slug" || return
+  prepared="$(maintenance_state "$slug" recover-prepare "$evidence")" || return
+  if [ "$(jq -r '.already_recorded' <<<"$prepared")" = true ]; then
+    printf 'identical recovery already recorded; maintenance remains pending\n'
+    return
+  fi
+  sources="$(jq -r '.sources[]' <<<"$prepared")" || return
+  [ -n "$sources" ] || die "recovery requires rooted machine source evidence"
+  while IFS= read -r source; do
+    root_applied_source "$slug" "$source" || return
