+
+prove_machine_selection() {
+  local slug="$1" machine="$2" top="$3" spin="$4" opts host init_check=""
+  host="$(machine_host "$slug" "$machine")" || return
+  opts="$(ssh_opts "$slug" "$machine")" || return
+  # Fixed provider store paths, never arbitrary code or caller kernel options.
+  [[ "$top" =~ ^/nix/store/[A-Za-z0-9+._-]+$ ]] || die "invalid candidate system path"
+  [ "$spin" != nixos ] || init_check="test -x '$top/init';"
+  # shellcheck disable=SC2086
+  timeout --kill-after=5s 120s ssh $opts "root@$host" "set -eu; test \"\$(readlink -e /run/current-system)\" = '$top'; $init_check requisites=\"\$(nix-store --query --requisites '$top')\" || exit \$?; test -n \"\$requisites\"; printf '%s\\n' \"\$requisites\" | xargs -r nix-store --check-validity; nix-store --add-root '/nix/var/nix/gcroots/vpsadmin-devcluster-applied-$slug-$machine' --indirect --realise '$top' >/dev/null"
