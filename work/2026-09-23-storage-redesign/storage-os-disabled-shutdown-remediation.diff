+            StringIO.new
+          end
+        end
+        patch.call(File, :chmod) do |mode, path|
+          raise 'unexpected chmod effect' unless path == '/etc/runit/kexec' && mode == 0o100
+          events << [:kexec_chmod, mode]
+          1
+        end
