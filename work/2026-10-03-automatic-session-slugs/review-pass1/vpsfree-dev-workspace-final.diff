+    active=\$(systemctl list-units --no-legend --plain --no-pager --state=active,activating --type=service,timer)
+    ! printf '%s\\n' \"\$active\" | grep -Eq '(^|[[:space:]])(vpsadmin[^[:space:]]*\\.(service|timer)|container@(webui|newadmin|mailer)\\.service|[^[:space:]]*\\.timer)[[:space:]]'
+    processes=\$(ps -eo args=)
+    ! printf '%s\\n' \"\$processes\" | grep -Eq '[b]undle exec rake|[r]uby[^[:space:]]* .*vpsadmin'
+  "
+}
+
+launch_recorded_config() {
+  local slug="$1" config="$2" mode="$3"
+  local vpsadmin_path vpsadminos_input_value vpsf_status_path vpsadmin_webui_path
+  vpsadmin_path="$(slug_vpsadmin_path "$slug")" || return
+  vpsadminos_input_value="$(vpsadminos_input "$slug")" || return
+  vpsf_status_path="$(slug_optional_path "$slug" vpsf-status || true)"
+  vpsadmin_webui_path="$(slug_optional_path "$slug" vpsadmin-webui || true)"
+  local -a overrides=()
+  while IFS= read -r -d '' item; do overrides+=("$item"); done \
+    < <(nix_overrides "$slug" "$vpsadmin_path" "$vpsadminos_input_value" "$vpsf_status_path" "$vpsadmin_webui_path")
+  local dir log ready sock pid_path
+  dir="$(cluster_dir "$slug")"
+  log="$dir/runner.log"
+  ready="$(ready_file "$slug")"
+  sock="$(socket_dir "$slug")"
+  pid_path="$(pid_file "$slug")"
+  rm -f "$ready" "$pid_path" || return
+  mkdir -p "$sock" || return
+  local -a command=(nix run --impure "${overrides[@]}" "path:$CLUSTER_DIR#runner" -- start
+    --config "$config" --state-dir "$dir/state" --sock-dir "$sock" --pid-file "$pid_path" --ready-file "$ready")
+  case "$mode" in
+    maintenance) command+=(--maintenance) ;;
+    copied) command+=(--copied-config) ;;
+    *) die "unsupported recorded boot mode" ;;
+  esac
+  (
+    cd "$WORKSPACE" || exit
+    devcluster_exec_without_lifecycle_lock nohup setsid "${command[@]}"
+  ) >>"$log" 2>&1 &
+  local launcher_pid=$!
+  for _ in $(seq 1 900); do
+    if [ -f "$ready" ]; then return 0; fi
+    if [ -f "$pid_path" ] && ! runner_process_matches "$slug" "$(cat "$pid_path")"; then
+      die "recorded runner exited before readiness; private runner log retained"
+    fi
+    if [ ! -f "$pid_path" ] && ! is_running "$launcher_pid"; then
+      die "recorded launcher exited before readiness; private runner log retained"
+    fi
+    sleep 1
+  done
+  die "recorded runner readiness timed out; maintenance hold retained"
+}
+
+maintenance_start() {
+  local slug="$1" resident="" expected="" evidence=""
+  shift
+  while [ "$#" -gt 0 ]; do
+    case "$1" in
+      --resident-config) [ -z "$resident" ] && [ -n "${2:-}" ] || die "invalid resident-config argument"; resident="$2"; shift 2 ;;
+      --expect-services-toplevel) [ -z "$expected" ] && [ -n "${2:-}" ] || die "invalid expected-toplevel argument"; expected="$2"; shift 2 ;;
+      --residency-evidence) [ -z "$evidence" ] && [ -n "${2:-}" ] || die "invalid residency-evidence argument"; evidence="$2"; shift 2 ;;
+      *) die "unsupported maintenance-start argument" ;;
+    esac
+  done
+  [ -n "$resident" ] && [ -n "$expected" ] && [ -n "$evidence" ] || die "maintenance-start requires resident config, expected toplevel and residency evidence"
+  devcluster_validate_cluster_directory "$slug" false || die "maintenance requires existing owned cluster state"
+  maintenance_require_stopped "$slug" || return
+  maintenance_state "$slug" prepare "$resident" "$expected" "$evidence" || return
+  maintenance_state "$slug" inspect || return
+  maintenance_root_config "$slug" resident "$resident" || return
+  launch_recorded_config "$slug" "$resident" maintenance || return
+  wait_for_machine_ssh "$slug" services || return
+  maintenance_check_hold "$slug" || return
+  local -a identity=()
+  read -r -a identity <<<"$(maintenance_identity "$slug")" || return
+  [ "${#identity[@]}" -eq 3 ] || die "maintenance boot identity is incomplete"
+  maintenance_state "$slug" ready "${identity[@]}" || return
+  printf 'maintenance hold ready; application writers remain unavailable\n'
+}
+
+maintenance_copy_only() {
+  local slug="$1" status config top host opts next
+  status="$(maintenance_state "$slug" status)" || return
+  [ "$(jq -r '.pending // false' <<<"$status")" = true ] || die "copy-only requires a maintenance hold"
+  maintenance_check_hold "$slug" || return
+  local -a identity=() after=()
+  read -r -a identity <<<"$(maintenance_identity "$slug")" || return
+  [ "${#identity[@]}" -eq 3 ] || die "maintenance boot identity is incomplete"
+  devcluster_with_lock "$DEVCLUSTER_KIND-credentials" \
+    build_config_with_credentials "$slug" "$(cluster_topology "$slug")" "$(cluster_network "$slug")" || return
+  config="$(config_path "$slug")" || return
+  maintenance_state "$slug" begin-copy "$config" "${identity[@]}" || return
+  top="$(maintenance_state "$slug" candidate-toplevel)" || return
+  host="$(machine_host "$slug" services)" || return
+  opts="$(ssh_opts "$slug" services)" || return
+  NIX_SSHOPTS="$opts" nix copy --to "ssh://root@$host" "$top" || return
+  maintenance_remote "$slug" "set -euo pipefail; test -x '$top/init'; nix-store --query --requisites '$top' | xargs -r nix-store --check-validity; nix-store --add-root '/nix/var/nix/gcroots/vpsadmin-devcluster-maintenance-$slug' --indirect --realise '$top' >/dev/null" || return
+  maintenance_check_hold "$slug" || return
+  read -r -a after <<<"$(maintenance_identity "$slug")" || return
+  [ "${identity[*]}" = "${after[*]}" ] || die "maintenance runner or boot changed during copy"
+  maintenance_state "$slug" build-next "$(cluster_dir "$slug")/maintenance-next.json" || return
+  next="$(nix-store --add "$(cluster_dir "$slug")/maintenance-next.json")" || return
+  maintenance_root_config "$slug" next "$next" || return
+  maintenance_root_config "$slug" candidate "$config" || return
+  maintenance_state "$slug" finish-copy "$next" "${after[@]}" || return
+  printf 'services closure copied; running generation remains held\n'
+}
+
+start_copied_config() {
+  local slug="$1" config
+  maintenance_require_stopped "$slug" || return
+  config="$(maintenance_state "$slug" copied)" || return
+  launch_recorded_config "$slug" "$config" copied || return
+  wait_for_machine_ssh "$slug" services || return
+  maintenance_remote "$slug" 'set -eu
+    for _ in $(seq 1 180); do
+      started=$(systemctl show vpsadmin-devcluster-seed.service --property=ExecMainStartTimestampMonotonic --value)
+      case "$started" in ""|*[!0-9]*) exit 1 ;; esac
+      if [ "$started" -gt 0 ] \
+        && [ "$(systemctl show vpsadmin-devcluster-seed.service --property=Result --value)" = success ] \
+        && [ "$(systemctl show vpsadmin-devcluster-seed.service --property=ExecMainStatus --value)" = 0 ] \
+        && systemctl is-active --quiet vpsadmin-api.service \
+        && systemctl is-active --quiet vpsadmin-supervisor.service; then exit 0; fi
+      sleep 1
+    done
+    exit 1' 190 || return
+  refresh_nodes_after_seed "$slug" || return
+  local -a identity=()
+  read -r -a identity <<<"$(maintenance_identity "$slug")" || return
+  [ "${#identity[@]}" -eq 3 ] || die "copied boot identity is incomplete"
+  maintenance_state "$slug" release "${identity[@]}" || return
+  printf 'copied services configuration ready; maintenance hold released\n'
+}
+
+start_dispatch() {
+  local slug="$1"
+  shift
+  if [ "${1:-}" = --copied-config ]; then
+    [ "$#" -eq 1 ] || die "copied-config accepts no other arguments"
+    start_copied_config "$slug"
+  else
+    ordinary_cluster_operation "$slug" start_cluster "$@"
+  fi
+}
+
+update_dispatch() {
+  local slug="$1"
+  shift
+  local argument copy_only=false
+  for argument in "$@"; do
+    [ "$argument" != --copy-only ] || copy_only=true
+  done
+  if [ "$copy_only" = true ]; then
+    [ "$#" -eq 2 ] && [ "$1" = services ] && [ "$2" = --copy-only ] || die "copy-only requires exactly services"
+    maintenance_copy_only "$slug"
+  else
+    ordinary_cluster_operation "$slug" update_cluster "$@"
+  fi
+}
+
+# Pool::Create can adopt a named ZFS root. Refuse unexpected physical roots
+# before staging missing Pools through the ordinary API chain.
+storage_profile_cluster() {
+  local slug="$1" operation="${2:-}"
+  [ "$#" -eq 2 ] && [[ "$operation" = provision || "$operation" = retire ]] || die "storage-profile requires provision or retire"
+  [ "$(config_get "$slug" '.storageProfile.enable // false')" = true ] || die "storage profile is not enabled"
+  local desired_enrollment
+  desired_enrollment="$(config_get "$slug" '.storageProfile | if has("enrollment") then .enrollment else true end')" || return
+  [[ "$desired_enrollment" = true || "$desired_enrollment" = false ]] || die "storage profile enrollment must be a boolean"
+  if [ "$operation" = provision ]; then
+    [ "$desired_enrollment" = true ] || die "storage profile provisioning requires enrollment enabled"
+  else
+    [ "$desired_enrollment" = false ] || die "storage profile retirement requires enrollment disabled"
+  fi
+  [ "$(cluster_topology "$slug")" = storage ] || die "storage profile requires storage topology"
+  local profile_pid_file
+  profile_pid_file="$(pid_file "$slug")"
+  [ -f "$profile_pid_file" ] && runner_process_matches "$slug" "$(cat "$profile_pid_file")" || die "storage profile requires the owned running cluster"
+  wait_for_machine_ssh "$slug" services || return
+  ssh_cmd "$slug" services 'systemctl is-active --quiet vpsadmin-api.service vpsadmin-supervisor.service' || return
+
+  local profile_dir report cfg node root present machine roots pool_name
+  profile_dir="$(mktemp -d "$(cluster_dir "$slug")/.profile-check.XXXXXXXX")" || return
+  chmod 0700 "$profile_dir" || return
+  report="$profile_dir/inspection.json"
+  cfg="$(config_json_for_slug "$slug")" || return
+  if ! ssh_cmd "$slug" services 'timeout --kill-after=1 60 /run/current-system/sw/bin/vpsadmin-storage-profile inspect' | head -c 8193 >"$report"; then
+    die "storage profile inspection failed; private evidence: $profile_dir"
+  fi
+  [ "$(wc -c <"$report")" -le 8192 ] || die "storage profile inspection exceeded its bound"
+  jq -e '.version == 1 and (.enrollment | type == "boolean") and (.pools | length >= 1 and length <= 10) and
+    all(.pools[]; (.node_id | type == "number" and . == floor and . > 0) and
+      (.filesystem | type == "string" and test("^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$")) and
+      (.present | type == "boolean"))' "$report" >/dev/null || die "invalid storage profile inspection"
+  [ "$(jq -r '.enrollment' "$report")" = "$desired_enrollment" ] || die "storage profile desired and deployed enrollment differ; complete the services replacement first"
+  while IFS=$'\t' read -r node root present; do
+    [[ "$root" != */. && "$root" != */.. && "$root" != ./* && "$root" != ../* ]] || die "invalid storage profile root"
+    machine="$(jq -r --argjson node "$node" '.nodes | to_entries | map(select(.value.id == $node)) | if length == 1 then .[0].key else empty end' "$cfg")" || return
+    [[ "$machine" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "storage profile node is outside owned configuration"
+    wait_for_machine_ssh "$slug" "$machine" || return
+    roots="$profile_dir/node-$node.txt"
+    pool_name="${root%%/*}"
+    ssh_cmd "$slug" "$machine" "timeout --kill-after=1 45 bash -o pipefail -c \"zfs list -H -r -t filesystem -o name '$pool_name' | awk 'NR <= 4096 {print} NR == 4097 {exit 2}'\"" >"$roots" || die "storage profile root inspection failed"
+    [ -s "$roots" ] && [ "$(wc -c <"$roots")" -le 524288 ] || die "storage profile root inspection is incomplete"
+    if grep -Fx -- "$root" "$roots" >/dev/null; then
+      [ "$present" = true ] || die "uncatalogued storage profile root exists; refusing adoption"
+    else
+      [ "$present" = false ] || die "catalogued storage profile root is physically absent"
+    fi
+  done < <(jq -r '.pools[] | [.node_id, .filesystem, .present] | @tsv' "$report")
+
+  # Failure leaves scheduling stopped and admitted work available for diagnosis.
+  ssh_cmd "$slug" services 'systemctl stop vpsadmin-scheduler.service' || return
+  if ! ssh_cmd "$slug" services "timeout --kill-after=5 1800 /run/current-system/sw/bin/vpsadmin-storage-profile '$operation'"; then
+    die "storage profile operation failed; scheduling remains stopped, inspect admitted chains before retry"
+  fi
+  ssh_cmd "$slug" services 'systemctl start vpsadmin-scheduler.service' || return
+  rm -f -- "$profile_dir"/* || return
+  rmdir -- "$profile_dir"
+}
