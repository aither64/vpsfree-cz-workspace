+func (h *ephemeralIntegrationHarness) control(t *testing.T) {
+	h.trustControlHooks(t)
+	h.mu.Lock()
+	h.controlMode = true
+	h.requests = nil
+	h.failure = ""
+	h.mu.Unlock()
+	h.ordinary = NewWithOptions(h.socket, ClientOptions{DeveloperInstructions: "TEAM_POLICY_SENTINEL", RuntimeWorkspaceRoots: []string{h.project}})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	id, err := h.ordinary.StartThreadWithSettings(ctx, filepath.Join(h.project, "work/session"), nil, ThreadSettings{Model: "gpt-6-luna", ReasoningEffort: "low"})
+	if err != nil {
+		t.Fatal("control thread prerequisite unavailable")
+	}
+	h.controlThread = id
+	var turn any
+	if err := h.ordinary.Request(ctx, "turn/start", map[string]any{"threadId": id, "model": "gpt-6-luna", "effort": "low", "input": []any{map[string]any{"type": "text", "text": "ordinary synthetic control"}}}, &turn); err != nil {
+		t.Fatal("control inference prerequisite unavailable")
+	}
+	for ctx.Err() == nil {
+		h.mu.Lock()
+		received := len(h.requests) > 0
+		h.mu.Unlock()
+		if received {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	h.mu.Lock()
+	controlRequests := append([]map[string]any(nil), h.requests...)
+	h.controlMode = false
+	h.mu.Unlock()
+	if len(controlRequests) == 0 {
+		t.Fatal("representative builtin OpenAI provider path did not reach mock")
+	}
+	encoded, _ := json.Marshal(controlRequests)
+	for _, sentinel := range []string{"GLOBAL_POLICY_SENTINEL", "PROJECT_POLICY_SENTINEL", "WORKSPACE_POLICY_SENTINEL", "TEAM_POLICY_SENTINEL", "SKILL_POLICY_SENTINEL", "PLUGIN_SKILL_SENTINEL", "INHERITED_FILE_POLICY_SENTINEL", "HOST_HOOK_SENTINEL"} {
+		if !bytes.Contains(encoded, []byte(sentinel)) {
+			t.Fatalf("control did not prove %s eligibility; fixture cannot claim its exclusion", sentinel)
+		}
+	}
+	if !bytes.Contains(encoded, []byte("exec_command")) || !bytes.Contains(encoded, []byte("curr_time")) || !bytes.Contains(encoded, []byte("request_user_input_async")) {
+		t.Fatal("control has reduced tool/model metadata")
+	}
+	// Wait for ordinary completion before taking the persistent-state baseline.
+	for ctx.Err() == nil {
+		var result struct {
+			Thread struct {
+				Turns []struct {
+					Status string `json:"status"`
+				} `json:"turns"`
+			} `json:"thread"`
+		}
+		if h.ordinary.Request(ctx, "thread/read", map[string]any{"threadId": id, "includeTurns": true}, &result) != nil {
+			t.Fatal("control read failed")
+		}
+		if len(result.Thread.Turns) > 0 && result.Thread.Turns[len(result.Thread.Turns)-1].Status == "completed" {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if ctx.Err() != nil {
+		t.Fatal("control did not complete")
+	}
+	h.seedSensitiveStores(t)
+	h.baseline = h.snapshot(t)
+	h.egressDrops = h.droppedPackets(t)
+}
