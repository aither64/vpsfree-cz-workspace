+				t.Fatal(err)
+			}
+		}},
+		{"whitespace", func(t *testing.T, path string) {
+			if err := os.WriteFile(path, []byte(strings.Repeat(" ", len(EphemeralInstructionFileContent))), 0600); err != nil {
