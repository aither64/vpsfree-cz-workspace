+type managedSmokeOutput struct {
+	data     []byte
+	overflow bool
+}
+
+func (output *managedSmokeOutput) Write(data []byte) (int, error) {
+	count := len(data)
+	remaining := 64*1024 - len(output.data)
+	if len(data) > remaining {
+		output.overflow = true
+		data = data[:remaining]
+	}
+	output.data = append(output.data, data...)
+	return count, nil
+}
