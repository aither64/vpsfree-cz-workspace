+    def refresh_systemd_instance_links(units, packaged_units)
+      names = packaged_units.map { |source| File.basename(source) }
+      links = Dir[File.join(units, 'workspace-*')]
+      links.concat(Dir[File.join(units, '*.wants/workspace-*')])
+      links.concat(Dir[File.join(units, '*.requires/workspace-*')])
+      links.each do |link|
+        next unless File.symlink?(link)
+
+        name = File.basename(link)
+        template = name.include?('@') ? "#{name.split('@', 2).first}@#{File.extname(name)}" : name
+        next unless names.include?(template)
+
+        # systemctl can retain a canonical store target for both the instance
+        # alias and its enablement link. It can already be dangling after GC.
+        target = File.expand_path(File.readlink(link), File.dirname(link))
+        next unless target.match?(%r{\A/nix/store/[^/]+-dev-workspace-[^/]+/share/systemd/user/#{Regexp.escape(template)}\z})
+
+        source = if File.dirname(link) == units
+                   File.join(@profile, 'share/systemd/user', template)
+                 else
+                   File.join(units, template)
+                 end
+        atomic_symlink(source, link)
+      end
+    end
