+      clock[:monotonic] = 110
+      plugin.flush_summary
+
+      expect(messages).to eq(["1 new security advisory in vpsAdmin: #{list_url}"])
+    end
+
+    it 'skips empty windows and still advances their deadlines' do
+      clock[:monotonic] = 110
+      plugin.flush_summary
+      poll(plugin, new: [advisory(1)])
+      clock[:monotonic] = 119
+      plugin.flush_summary
