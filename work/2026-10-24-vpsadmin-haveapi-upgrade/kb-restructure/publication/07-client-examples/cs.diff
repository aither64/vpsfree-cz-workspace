-Klienta vytvoř pomocí ''%%client.New("https://api.vpsfree.cz")%%'' a existující token
-nastav metodou ''SetExistingTokenAuth''. Použij základní adresu API bez prefixu
-verze, který už je součástí generovaných cest akcí. Úplný příklad výpisu VPS a další
-volání najdeš v [[https://github.com/vpsfreecz/vpsadmin-go-client#usage|README klienta]].
+Ukázku ulož jako ''main.go'' a spusť příkazem ''go run .'':
+
+<code go>
+package main
+
+import (
+	"fmt"
+	"log"
+
+	"github.com/vpsfreecz/vpsadmin-go-client/client"
+)
+
+func main() {
+	api := client.New("https://api.vpsfree.cz")
+	api.SetExistingTokenAuth("TOKEN")
+
+	action := api.Vps.Index.Prepare()
+	action.NewInput().SetLimit(10)
+	response, err := action.Call()
+	if err != nil {
+		log.Fatal(err)
+	}
+	if !response.Status {
+		log.Fatalf("%s: %v", response.Message, response.Errors)
+	}
+
+	for _, vps := range response.Output {
+		fmt.Println(vps.Id, vps.Hostname)
+	}
+}
+</code>
+
+Další akce a parametry najdeš v
+[[https://github.com/vpsfreecz/vpsadmin-go-client#usage|README klienta]].
 
