+Save this example as ''src/main.rs'' and run it with ''cargo run'':
+
+<code rust>
+use vpsadmin_client::blocking::Client;
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let api = Client::builder("https://api.vpsfree.cz")
+        .token("TOKEN")
+        .build()?;
+    let response = api.vps().index().limit(10).send()?;
+    for vps in response.output {
+        if let (Some(id), Some(hostname)) = (vps.id, vps.hostname) {
+            println!("{} {}", id, hostname);
+        }
+    }
+    Ok(())
+}
+</code>
+
+See the [[https://github.com/vpsfreecz/vpsadmin-rust-client#readme|client README]]
+for other actions, asynchronous calls and Rust requirements.
