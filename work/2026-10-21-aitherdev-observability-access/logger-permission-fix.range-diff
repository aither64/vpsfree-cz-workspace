1:  f5f0edbd ! 1:  bd54b28c int.log: add unprivileged SSH log reader
    @@ cluster/cz.vpsfree/containers/prg/int.log/config.nix: in
        services.rsyslogd = {
          enable = true;
          defaultConfig = mkForce ''
    -+      # Apply to both dynamic remote logs and the local messages action. The
    -+      # exporter pipe retains its separately managed ownership and permissions.
    ++      # Legacy defaults apply to the local messages selector. The RainerScript
    ++      # omfile action below needs its own creation properties. The exporter pipe
    ++      # retains its separately managed ownership and permissions.
     +      $FileOwner root
     +      $FileGroup log-readers
     +      $FileCreateMode 0640
    @@ cluster/cz.vpsfree/containers/prg/int.log/config.nix: in
            template(name="remote-log-file" type="string" string="/var/log/remote/%HOSTNAME%/log")
      
            ruleset(name="remote-file"){
    +-        action(type="omfile" dynaFile="remote-log-file")
    ++        action(type="omfile" dynaFile="remote-log-file"
    ++          fileOwner="root" fileGroup="log-readers" fileCreateMode="0640"
    ++          dirOwner="root" dirGroup="log-readers" dirCreateMode="0750")
    +         call remote-pipe
    +       }
    + 
     @@ cluster/cz.vpsfree/containers/prg/int.log/config.nix: in
              dateext = true;
              notifempty = true;
    @@ docs/operations/log-reader-access.md (new)
     +
     +The account belongs only to `log-readers`. Remote log directories are owned by
     +`root:log-readers` with mode `0750`; regular logs and messages archives use
    -+`0640`. Rsyslog applies that policy when creating new files and host directories.
    ++`0640`. The remote RainerScript `omfile` action sets its creation policy explicitly;
    ++legacy defaults apply to the local messages selector. These settings apply to
    ++newly created files and directories and leave existing metadata unchanged.
     +Logrotate creates replacements as `0640 root log-readers`, retaining the existing
     +daily/monthly schedules, retention, date suffixes, uncompressed files and rsyslog
     +HUP. The exporter pipe retains its own group and mode.
    @@ tests/log-reader-access.nix (new)
     +  ];
     +  syntaxConfig = pkgs.writeText "log-reader-rsyslog.conf" (
     +    lib.replaceStrings
    -+      [ "$FileGroup log-readers" "$DirGroup log-readers" ]
    -+      [ "$FileGroup root" "$DirGroup root" ]
    ++      [
    ++        "$FileGroup log-readers"
    ++        "$DirGroup log-readers"
    ++        ''fileGroup="log-readers"''
    ++        ''dirGroup="log-readers"''
    ++      ]
    ++      [
    ++        "$FileGroup root"
    ++        "$DirGroup root"
    ++        ''fileGroup="root"''
    ++        ''dirGroup="root"''
    ++      ]
     +      cfg.services.rsyslogd.defaultConfig
     +  );
     +in
    @@ tests/log-reader-access.nix (new)
     +assert lib.hasInfix "$FileCreateMode 0640" cfg.services.rsyslogd.defaultConfig;
     +assert lib.hasInfix "$DirCreateMode 0750" cfg.services.rsyslogd.defaultConfig;
     +assert lib.hasInfix "$Umask 0027" cfg.services.rsyslogd.defaultConfig;
    ++assert builtins.all (property: lib.hasInfix property cfg.services.rsyslogd.defaultConfig) [
    ++  ''fileOwner="root"''
    ++  ''fileGroup="log-readers"''
    ++  ''fileCreateMode="0640"''
    ++  ''dirOwner="root"''
    ++  ''dirGroup="log-readers"''
    ++  ''dirCreateMode="0750"''
    ++];
     +assert lib.hasInfix "call remote-pipe" cfg.services.rsyslogd.defaultConfig;
     +pkgs.runCommand "log-reader-policy"
     +  {
