+    private function xpath(string $html): DOMXPath
+    {
+        $doc = new DOMDocument();
+        $doc->loadHTML('<html><body>' . $html . '</body></html>', LIBXML_NOERROR | LIBXML_NOWARNING);
+        return new DOMXPath($doc);
+    }
