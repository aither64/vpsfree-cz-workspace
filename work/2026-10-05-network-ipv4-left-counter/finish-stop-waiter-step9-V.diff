+        false,
+        2
+    );
+    $xtpl->table_tr();
+    $xtpl->form_add_checkbox(_('Confirm') . ':', 'confirm', '1', false);
+    $xtpl->form_out($enabled ? _('Disable this network') : _('Enable this network'));
 }
 
